{
  "name": "nano-ai-backend",
  "version": "1.0.0",
  "description": "Nano AI backend on Aliyun FC 3.0",
  "main": "index.js",
  "scripts": {
    "start:backend": "node scripts/local-dev.js",
    "start:admin": "node scripts/local-admin.js",
    "start:user": "cd src/web/user-app && npm run dev",
    "build:user": "cd src/web/user-app && npm run build",
    "deploy:user": "./scripts/deploy-user-app.sh",
    "deploy:user:prod": "./scripts/deploy-user-app-prod.sh",
    "deploy:worker": "./scripts/s.sh worker deploy -y",
    "deploy:mcp": "./scripts/s.sh mcp deploy -y",
    "mcp:local": "node src/functions/mcp/local.js",
    "deploy:dispatcher": "./scripts/s.sh dispatcher deploy -y",
    "deploy:agent": "./scripts/s.sh agent deploy -y",
    "deploy:lab": "./scripts/s.sh lab deploy -y",
    "deploy:s": "./scripts/s.sh deploy -y",
    "deploy:worker:prod": "./scripts/s.sh worker deploy -t s-prod.yaml -y",
    "deploy:dispatcher:prod": "./scripts/s.sh dispatcher deploy -t s-prod.yaml -y",
    "deploy:agent:prod": "./scripts/s.sh agent deploy -t s-prod.yaml -y",
    "deploy:lab:prod": "./scripts/s.sh lab deploy -t s-prod.yaml -y",
    "deploy:s-prod": "./scripts/s.sh deploy -t s-prod.yaml -y",
    "deploy:admin:prod": "./scripts/deploy-admin-prod.sh",
    "deploy:all": "./scripts/deploy-all.sh",
    "deploy:admin": "./scripts/deploy-admin.sh",
    "deploy:kino": "./scripts/s.sh kino deploy -y",
    "deploy:kino:prod": "./scripts/s.sh kino deploy -t s-prod.yaml -y",
    "deploy:media": "./scripts/s.sh media deploy -y",
    "deploy:media:prod": "./scripts/s.sh media deploy -t s-prod.yaml -y",
    "deploy:chat": "./scripts/deploy-chat.sh",
    "deploy:coach": "./scripts/deploy-coach.sh",
    "migrate:dev": "node scripts/migrate.js --env dev",
    "migrate:prod": "node scripts/migrate.js --env prod",
    "migrate:status:dev": "node scripts/migrate.js --env dev --status",
    "migrate:status:prod": "node scripts/migrate.js --env prod --status",
    "migrate:baseline:dev": "node scripts/migrate.js --env dev --baseline",
    "migrate:baseline:prod": "node scripts/migrate.js --env prod --baseline",
    "test": "node --test tests/*.test.js",
    "import:academy-library": "node scripts/import-academy-library.js",
    "import:academy-library:prod": "node scripts/import-academy-library.js --env prod",
    "backup:dev": "./tools/backup-dev-db.sh",
    "backup:prod": "./tools/backup-prod-db.sh",
    "miniapp:channel": "./scripts/switch-miniapp-channel.sh",
    "upload:waven": "node scripts/upload-miniapp.js waven",
    "upload:aeviva": "node scripts/upload-miniapp.js aeviva",
    "upload:fusion": "node scripts/upload-miniapp.js fusion",
    "update:changelog": "node scripts/update-changelog.js",
    "check:i18n": "node src/web/user-app/scripts/sync-i18n-from-miniapp.mjs",
    "sync:i18n": "node src/web/user-app/scripts/sync-i18n-from-miniapp.mjs --write",
    "sync:theme": "node src/web/user-app/scripts/sync-theme-from-miniapp.mjs",
    "sync:css": "node src/web/user-app/scripts/sync-css-from-miniapp.mjs",
    "sync:health": "node src/web/user-app/scripts/sync-health-helpers-from-miniapp.mjs",
    "pretest": "node scripts/sync-twin-shared.js",
    "deploy:twin": "./scripts/s.sh twin deploy -y"
  },
  "dependencies": {
    "@alicloud/eventbridge": "^1.3.2",
    "@alicloud/eventbridge20200401": "^6.0.7",
    "@alicloud/openapi-client": "^0.4.15",
    "@alicloud/tea-util": "^1.4.11",
    "@serverless-devs/s": "^3.1.10",
    "ali-oss": "^6.23.0",
    "axios": "^1.15.0",
    "body-parser": "^1.20.4",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "luxon": "^3.7.2",
    "mammoth": "^1.8.0",
    "miniprogram-ci": "^2.1.31",
    "openai": "^4.104.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.20.0",
    "uuid": "^8.3.2"
  }
}
