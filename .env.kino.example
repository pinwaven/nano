# Kino FC3.0 function environment sample.
# Do not put real production secrets in this file.

# Database
# DATABASE_URL takes precedence over DB_HOST/DB_NAME/DB_USER/DB_PASS when set.
# DATABASE_URL=postgresql://nano_admin:password@localhost:5432/nano_db_dev
DB_HOST=amclbdsyqvfq.rwlb.rds.aliyuncs.com
DB_NAME=nano_db_dev
DB_USER=nano_admin
DB_PASS=replace-with-database-password
DB_SSL=false

# Admin-facing Kino machine APIs:
#   POST /kino-machines/batch
#   GET /kino-machines
#   PUT /kino-machines/:machine_no
API_BEARER_TOKEN=replace-with-admin-api-bearer-token

# Device activation:
#   POST /activate
KINO_ACTIVATION_TOKEN=replace-with-fixed-device-activation-token

# Root-token encryption key.
# Must be 32 bytes encoded as either 64 hex chars or base64.
# Generate hex with:
#   openssl rand -hex 32
KINO_ROOT_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-character-key

# Communication-token lifecycle.
KINO_COMM_TOKEN_TTL_DAYS=7
KINO_TOKEN_BYTES=32

# Runtime timezone used by FC and local scripts.
TZ=Asia/Shanghai
