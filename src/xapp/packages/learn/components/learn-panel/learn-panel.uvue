<template>
  <view class="learn-panel" :class="theme == 'light' ? 'theme-light' : ''">
        <view class="inner-tab-bar">
          <view class="inner-tab" :class="learnSubTab == 'academy' ? 'inner-tab-active' : ''" v-on:click="switchLearnSubTab('academy')"><text class="inner-tab-text" :class="learnSubTab == 'academy' ? 'inner-tab-text-on' : ''">{{ tr('learnAcademyTab') }}</text></view>
          <view class="inner-tab" :class="learnSubTab == 'wellness' ? 'inner-tab-active' : ''" v-on:click="switchLearnSubTab('wellness')"><text class="inner-tab-text" :class="learnSubTab == 'wellness' ? 'inner-tab-text-on' : ''">{{ tr('learnBoxTab') }}</text></view>
        </view>

        <scroll-view v-if="learnSubTab == 'academy'" direction="vertical" class="academy-subtab-scroll">
          <view class="training-tab">
            <view v-if="trainingLoading" class="loading-row"><text class="loading-text">{{ tr('loading') }}</text></view>

            <view v-else-if="trainingView == 'list'">
              <view v-if="trainingDashboard != null" class="academy-status-card">
                <view class="academy-card-glow-tl"></view>
                <view class="academy-card-glow-br"></view>
                <view class="academy-card-header">
                  <text class="academy-card-header-label">{{ lang == 'zh' ? '学院状态' : 'ACADEMY STATUS' }}</text>
                  <view class="academy-card-tier-badge"><text class="academy-card-tier-text">{{ trainingDashboard != null ? trainingDashboard!.getString('_tierLabel') : '' }}</text></view>
                </view>
                <view class="academy-card-hero">
                  <text class="academy-card-credits-num">{{ trainingDashboard != null ? trainingDashboard!.getNumber('total_credits') : 0 }}</text>
                  <text class="academy-card-credits-label">{{ lang == 'zh' ? '学分' : 'CREDITS' }}</text>
                </view>
                <view class="academy-card-divider"></view>
                <view class="academy-card-stats">
                  <view class="academy-card-stat">
                    <text class="academy-card-stat-num">{{ trainingDashboard != null ? trainingDashboard!.getNumber('completed_lessons') : 0 }}</text>
                    <text class="academy-card-stat-label">{{ lang == 'zh' ? '完成课程' : 'LESSONS' }}</text>
                  </view>
                  <view class="academy-card-stat-sep"></view>
                  <view class="academy-card-stat">
                    <text class="academy-card-stat-num">{{ trainingDashboard != null ? trainingDashboard!.getNumber('certifications_count') : 0 }}</text>
                    <text class="academy-card-stat-label">{{ lang == 'zh' ? '证书' : 'CERTS' }}</text>
                  </view>
                </view>
              </view>

              <view v-if="trainingPaths.length > 0" class="training-section-header">
                <text class="training-section-title">{{ lang == 'zh' ? '学习路径' : 'Learning Paths' }}</text>
              </view>
              <view v-for="(tp, tpi) in trainingPaths" :key="tpi" class="training-path-card" v-on:click="trainingOpenCourse(tpi, true)">
                <view class="training-path-header">
                  <text class="training-path-title">{{ tp.getString('title') }}</text>
                  <text class="training-path-tier">{{ tp.getString('_tierLabel') }}</text>
                </view>
                <view v-if="tp.getString('description') != null" class="training-path-desc"><text>{{ tp.getString('description') }}</text></view>
                <view class="training-path-progress-bar">
                  <view class="training-path-progress-fill" :style="'width:' + pathPct(tp) + '%'"></view>
                </view>
                <text class="training-path-progress-label">{{ tp.getNumber('_done') }}/{{ tp.getNumber('_total') }} {{ lang == 'zh' ? '课程' : 'courses' }}</text>
              </view>

              <view class="training-section-header"><text class="training-section-title">{{ tr('training.courses') }}</text></view>
              <view v-if="trainingCourses.length == 0" class="empty-state"><text class="empty-text">{{ tr('training.noTraining') }}</text></view>
              <view v-for="(c, ci) in trainingCourses" :key="ci" class="training-course-card" :class="c.getBoolean('_locked') == true ? ' training-course-card-locked' : ''" v-on:click="trainingOpenCourse(ci, false)">
                <view class="training-course-cover">
                  <text class="training-course-cover-text">{{ c.getString('title') }}</text>
                  <view class="training-lesson-badge"><text class="training-lesson-badge-text">{{ c.getString('_lessonCountLabel') }}</text></view>
                  <view v-if="c.getBoolean('_locked') == true" class="training-course-lock-badge"><text class="training-course-lock-icon">🔒</text></view>
                </view>
                <view class="training-course-body">
                  <view class="training-course-meta">
                    <text class="training-course-title">{{ c.getString('title') }}</text>
                    <text v-if="c.getString('description') != null" class="training-course-desc">{{ c.getString('description') }}</text>
                    <view class="training-course-meta-row">
                      <text class="training-course-level">{{ c.getString('_levelLabel') }}</text>
                      <text class="training-course-credits">+{{ c.getNumber('credit_value') }} {{ lang == 'zh' ? '学分' : 'cr' }}</text>
                    </view>
                    <text v-if="c.getBoolean('_locked') == true && c.getString('prerequisite_title') != null" class="training-course-prereq-hint">
                      {{ lang == 'zh' ? '前置：' : 'Requires: ' }}{{ c.getString('prerequisite_title') }}
                    </text>
                  </view>
                </view>
              </view>

              <view v-if="trainingCertifications.length > 0" class="training-section-header">
                <text class="training-section-title">{{ lang == 'zh' ? '我的证书' : 'My Certifications' }}</text>
              </view>
              <view v-for="(cert, cti) in trainingCertifications" :key="cti" class="training-cert-card" v-on:click="showCertDetail(cti)">
                <text class="training-cert-icon">🏅</text>
                <view class="training-cert-info">
                  <text class="training-cert-title">{{ cert.getString('title') }}</text>
                  <text v-if="cert.getString('tier') != null" class="training-cert-tier">{{ cert.getString('_tierLabel') }}</text>
                </view>
                <text class="training-cert-chevron">›</text>
              </view>

              <!-- Certificate detail overlay -->
              <view v-if="certDetailOpen" class="cert-overlay" v-on:click="hideCertDetail">
                <view class="cert-detail-card" v-on:click.stop="noop">
                  <view class="cert-detail-header">
                    <view class="cert-status-badge">
                      <text class="cert-status-check">✓</text>
                      <text class="cert-status-text">{{ lang == 'zh' ? '证书有效' : 'Certificate Valid' }}</text>
                    </view>
                    <view class="cert-close-btn" v-on:click="hideCertDetail"><text>✕</text></view>
                  </view>
                  <view v-if="certDetailItem != null && (`${certDetailItem!.getString('templateImageUrl')}`.length) > 0" class="cert-bg-wrap">
                    <image :src="`${certDetailItem!.getString('templateImageUrl')}`" class="cert-bg-preview" mode="widthFix" />
                  </view>
                  <view class="cert-field-list">
                    <view class="cert-field"><text class="cert-label">{{ lang == 'zh' ? '姓名' : 'Name' }}</text><text class="cert-value">{{ certName }}</text></view>
                    <view class="cert-field"><text class="cert-label">{{ lang == 'zh' ? '学员编号' : 'Student ID' }}</text><text class="cert-value cert-mono">{{ certDetailItem != null ? certDetailItem!.getString('user_id') : '—' }}</text></view>
                    <view v-if="certDetailItem != null && certDetailItem!.getString('course_display_name') != null" class="cert-field"><text class="cert-label">{{ lang == 'zh' ? '课程名称' : 'Course' }}</text><text class="cert-value">{{ certDetailItem!.getString('course_display_name') }}</text></view>
                    <view class="cert-field"><text class="cert-label">{{ lang == 'zh' ? '证书名称' : 'Certificate' }}</text><text class="cert-value">{{ certDetailItem != null ? certDetailItem!.getString('title') : '' }}</text></view>
                    <view v-if="certDetailItem != null && certDetailItem!.getString('certificate_number') != null" class="cert-field"><text class="cert-label">{{ lang == 'zh' ? '证书编号' : 'Cert No.' }}</text><text class="cert-value cert-mono cert-number">{{ certDetailItem!.getString('certificate_number') }}</text></view>
                    <view v-if="certDetailItem != null && certDetailItem!.getString('assessment_period') != null" class="cert-field"><text class="cert-label">{{ lang == 'zh' ? '考核时间' : 'Assessment' }}</text><text class="cert-value">{{ certDetailItem!.getString('assessment_period') }}</text></view>
                    <view v-if="certDetailItem != null && certDetailItem!.getNumber('score') != null" class="cert-field"><text class="cert-label">{{ lang == 'zh' ? '考试分数' : 'Score' }}</text><text class="cert-value">{{ certDetailItem!.getNumber('score') }}</text></view>
                    <view class="cert-field"><text class="cert-label">{{ lang == 'zh' ? '证书状态' : 'Status' }}</text><text class="cert-value cert-valid">{{ lang == 'zh' ? '有效' : 'Valid' }}</text></view>
                    <view v-if="certDetailItem != null && certDetailItem!.getString('issuing_org') != null" class="cert-field"><text class="cert-label">{{ lang == 'zh' ? '颁发机构' : 'Issuing Org' }}</text><text class="cert-value">{{ certDetailItem!.getString('issuing_org') }}</text></view>
                    <view v-if="certDetailItem != null && certDetailItem!.getString('school_org') != null" class="cert-field"><text class="cert-label">{{ lang == 'zh' ? '办学机构' : 'Institute' }}</text><text class="cert-value">{{ certDetailItem!.getString('school_org') }}</text></view>
                    <view v-if="certDetailItem != null && (`${certDetailItem!.getString('issueDateDisplay')}`.length) > 0" class="cert-field"><text class="cert-label">{{ lang == 'zh' ? '颁发时间' : 'Issue Date' }}</text><text class="cert-value">{{ certDetailItem!.getString('issueDateDisplay') }}</text></view>
                    <view v-if="certDetailItem != null && (`${certDetailItem!.getString('expiryDateDisplay')}`.length) > 0" class="cert-field"><text class="cert-label">{{ lang == 'zh' ? '有效期至' : 'Expires' }}</text><text class="cert-value">{{ certDetailItem!.getString('expiryDateDisplay') }}</text></view>
                  </view>
                  <view v-if="certDetailItem != null && certDetailItem!.getString('cert_oss_key') != null" class="cert-download-btn" v-on:click="downloadCert(`${certDetailItem!.getString('cert_oss_key')}`)">
                    <text class="cert-download-label">↓ {{ lang == 'zh' ? '下载电子证书' : 'Download Certificate' }}</text>
                  </view>
                </view>
              </view>

              <view class="training-section-header"><text class="training-section-title">{{ tr('training.library') }}</text></view>
              <view v-if="trainingLibrary.length == 0" class="empty-state"><text class="empty-text">{{ tr('training.noLibrary') }}</text></view>
              <view v-for="(lib, li) in trainingLibrary" :key="li" class="training-library-row" v-on:click="trainingOpenLibraryItem(li)">
                <text class="training-library-icon">📄</text>
                <text class="training-library-title">{{ lib.getString('title') }}</text>
                <text class="training-library-chevron">›</text>
              </view>
            </view>

            <view v-else-if="trainingView == 'lessons'">
              <view class="training-back-row" v-on:click="trainingBackToList"><text class="training-back-text">{{ tr('training.backToCourses') }}</text></view>
              <view class="training-course-header">
                <text class="training-course-header-title">{{ trainingCurrentCourse != null ? trainingCurrentCourse!.getString('title') : '' }}</text>
                <text v-if="trainingCurrentCourse != null && trainingCurrentCourse!.getString('description') != null" class="training-course-header-desc">{{ trainingCurrentCourse!.getString('description') }}</text>
                <view class="training-course-meta-row">
                  <text class="training-course-level">{{ trainingCurrentCourse != null ? trainingCurrentCourse!.getString('_levelLabel') : '' }}</text>
                  <text class="training-course-credits">+{{ trainingCurrentCourse != null ? trainingCurrentCourse!.getNumber('credit_value') : 0 }} {{ lang == 'zh' ? '学分' : 'cr' }}</text>
                </view>
              </view>
              <view v-if="trainingLessons.length == 0" class="empty-state"><text class="empty-text">{{ tr('training.noLessons') }}</text></view>
              <view v-for="(lsn, lni) in trainingLessons" :key="lni" class="training-lesson-row" v-on:click="trainingOpenLesson(lni)">
                <view class="training-lesson-num"><text class="training-lesson-num-text">{{ lni + 1 }}</text></view>
                <view class="training-lesson-info">
                  <text class="training-lesson-title">{{ lsn.getString('title') }}</text>
                  <text v-if="lsn.getString('description') != null" class="training-lesson-desc">{{ lsn.getString('description') }}</text>
                  <view class="training-lesson-meta-row">
                    <text class="training-lesson-type-badge">{{ lsn.getString('content_type') == 'video' ? '🎬' : (lsn.getString('content_type') == 'text' ? '📄' : '🧩') }}</text>
                    <text class="training-lesson-credits-label">+{{ lsn.getNumber('credit_value') }} {{ lang == 'zh' ? '学分' : 'cr' }}</text>
                    <text v-if="lsn.getBoolean('has_quiz') == true" class="training-lesson-quiz-badge">📝 {{ lang == 'zh' ? '含测验' : 'Quiz' }}</text>
                  </view>
                </view>
                <view v-if="isLessonCompleted(lni)" class="training-lesson-done"><text class="training-lesson-done-text">✓</text></view>
                <text v-else class="training-lesson-chevron">›</text>
              </view>
            </view>

            <view v-else-if="trainingView == 'player'">
              <view class="training-back-row" v-on:click="trainingBackToLessons"><text class="training-back-text">{{ tr('training.backToLessons') }}</text></view>
              <view v-if="trainingCurrentLesson != null && (trainingCurrentLesson!.getString('content_type') == 'video' || trainingCurrentLesson!.getString('content_type') == null)">
                <view class="training-video-container">
                  <video v-if="trainingVideoUrl.length > 0" class="training-video" :src="trainingVideoUrl" :controls="true" object-fit="contain" />
                  <view v-else class="training-video-loading"><text class="training-video-loading-text">{{ tr('loading') }}</text></view>
                </view>
              </view>
              <view v-else-if="trainingCurrentLesson != null && (trainingCurrentLesson!.getString('content_type') == 'text' || trainingCurrentLesson!.getString('content_type') == 'interactive')">
                <view class="training-text-content">
                  <text class="training-text-body">{{ trainingTextContent.length > 0 ? trainingTextContent : tr('loading') }}</text>
                </view>
              </view>
              <view class="training-lesson-detail">
                <text class="training-lesson-detail-title">{{ trainingCurrentLesson != null ? trainingCurrentLesson!.getString('title') : '' }}</text>
                <text v-if="trainingCurrentLesson != null && trainingCurrentLesson!.getString('description') != null" class="training-lesson-detail-desc">{{ trainingCurrentLesson!.getString('description') }}</text>

                <view v-if="trainingQuizQuestions.length > 0" class="training-quiz-section">
                  <text class="training-quiz-title">{{ lang == 'zh' ? '📝 课后测验' : '📝 Quiz' }}</text>
                  <view v-if="trainingQuizResult != null" class="training-quiz-result" :class="trainingQuizResult!.getBoolean('passed') == true ? 'training-quiz-passed' : 'training-quiz-failed'">
                    <text class="training-quiz-result-score">{{ trainingQuizResult!.getNumber('score') }}%</text>
                    <text class="training-quiz-result-label">{{ trainingQuizResult!.getBoolean('passed') == true ? (lang == 'zh' ? '通过！' : 'Passed!') : (lang == 'zh' ? '未通过，请重试' : 'Not passed, try again') }}</text>
                    <text v-if="(trainingQuizResult!.getNumber('credits_earned') ?? 0) > 0" class="training-quiz-result-credits">+{{ trainingQuizResult!.getNumber('credits_earned') }} {{ lang == 'zh' ? '学分' : 'credits' }}</text>
                    <view v-if="trainingQuizReview.length > 0" class="training-quiz-review">
                      <view v-for="(rv, rvi) in trainingQuizReview" :key="rvi" class="training-quiz-review-item" :class="rv.getBoolean('is_correct') == true ? ' training-quiz-review-correct' : ' training-quiz-review-wrong'">
                        <text class="training-quiz-review-icon">{{ rv.getBoolean('is_correct') == true ? '✓' : '✗' }}</text>
                        <view class="training-quiz-review-body">
                          <text class="training-quiz-review-q">{{ rv.getString('question') }}</text>
                          <text v-if="rv.getBoolean('is_correct') != true" class="training-quiz-review-your-ans">{{ lang == 'zh' ? '你的答案：' : 'Your answer: ' }}{{ rv.getString('user_answer') }}</text>
                          <text class="training-quiz-review-correct-ans">{{ lang == 'zh' ? '正确答案：' : 'Correct: ' }}{{ rv.getString('correct_answer') }}</text>
                          <text v-if="(`${rv.getString('explanation')}`.length) > 0" class="training-quiz-review-explanation">{{ rv.getString('explanation') }}</text>
                        </view>
                      </view>
                    </view>
                  </view>

                  <view v-if="trainingQuizResult == null || trainingQuizResult!.getBoolean('passed') != true">
                    <view v-for="(q, qi) in trainingQuizQuestions" :key="qi" class="training-quiz-question">
                      <text v-if="q.getString('scenario') != null" class="training-quiz-scenario">{{ q.getString('scenario') }}</text>
                      <text class="training-quiz-q-text">{{ qi + 1 }}. {{ q.getString('question') }}</text>
                      <view v-for="(opt, oi2) in arrOf(q, 'options')" :key="oi2" class="training-quiz-option" :class="quizAnswerFor(q) == oi2 ? 'training-quiz-option-selected' : ''" v-on:click="trainingSelectAnswer(idStr(q, 'id'), oi2)">
                        <view class="training-quiz-option-radio" :class="quizAnswerFor(q) == oi2 ? 'training-quiz-option-radio-checked' : ''"></view>
                        <text class="training-quiz-option-text">{{ opt.getString('text') }}</text>
                      </view>
                    </view>
                    <view class="training-quiz-submit-btn" :class="trainingQuizSubmitting ? 'training-mark-btn-busy' : ''" v-on:click="trainingSubmitQuiz">
                      <text class="training-mark-btn-text">{{ trainingQuizSubmitting ? tr('loading') : (lang == 'zh' ? '提交答案' : 'Submit Answers') }}</text>
                    </view>
                  </view>
                </view>

                <view v-if="currentLessonCompleted" class="training-completed-badge">
                  <text class="training-completed-badge-text">{{ tr('training.markedComplete') }}</text>
                </view>
                <view v-else-if="trainingQuizQuestions.length == 0" class="training-mark-btn" :class="trainingMarkingComplete ? 'training-mark-btn-busy' : ''" v-on:click="trainingMarkComplete">
                  <text class="training-mark-btn-text">{{ trainingMarkingComplete ? tr('loading') : tr('training.markComplete') }}</text>
                </view>
                <view v-else-if="trainingQuizResult != null && trainingQuizResult!.getBoolean('passed') == true" class="training-mark-btn" :class="trainingMarkingComplete ? 'training-mark-btn-busy' : ''" v-on:click="trainingMarkComplete">
                  <text class="training-mark-btn-text">{{ trainingMarkingComplete ? tr('loading') : tr('training.markComplete') }}</text>
                </view>
              </view>
            </view>

            <view v-else-if="trainingView == 'library-viewer'">
              <view class="training-back-row" v-on:click="trainingBackToList"><text class="training-back-text">{{ tr('training.backToCourses') }}</text></view>
              <view class="training-library-header">
                <text class="training-library-header-title">{{ trainingCurrentLibraryItem != null ? trainingCurrentLibraryItem!.getString('title') : '' }}</text>
              </view>
              <view class="training-library-content-scroll">
                <text class="training-library-content-text">{{ trainingLibraryContent.length > 0 ? trainingLibraryContent : tr('loading') }}</text>
              </view>
            </view>
          </view>
        </scroll-view>

        <scroll-view v-else direction="vertical" class="wellness-subtab-scroll">
          <view v-if="wellnessLoading" class="wellness-loading"><text class="loading-dots">···</text></view>
          <view v-else>
            <view v-if="wellnessAssets.length == 0 && deviceApkUrl.length == 0" class="wellness-empty">
              <text class="wellness-empty-text">{{ tr('wellnessEmpty') }}</text>
            </view>
            <view v-for="(a, ai) in wellnessAssets" :key="ai" class="wellness-section">
              <view v-if="a.getString('mediaType') == 'audio'" class="sleep-track-card" v-on:click="playAudioAsset(ai)">
                <view class="sleep-track-icon"><text class="sleep-icon-glyph">{{ trackPlaying(a) ? '⏸' : '▶' }}</text></view>
                <view class="sleep-track-info">
                  <text class="sleep-track-name">{{ a.getString('title_zh') != null ? a.getString('title_zh') : a.getString('title') }}</text>
                  <text v-if="a.getNumber('duration_seconds') != null" class="sleep-track-dur">{{ durLabel(a.getNumber('duration_seconds')) }}</text>
                </view>
                <view v-if="trackActive(a)" class="sleep-track-active-dot"></view>
              </view>
              <view v-else-if="a.getString('mediaType') == 'video'" class="media-asset-card" v-on:click="openMediaAsset(ai)">
                <view class="media-asset-icon media-asset-icon--video"><text class="media-asset-glyph">▶</text></view>
                <view class="media-asset-info">
                  <text class="media-asset-name">{{ a.getString('title_zh') != null ? a.getString('title_zh') : a.getString('title') }}</text>
                  <text v-if="a.getNumber('duration_seconds') != null" class="media-asset-sub">{{ durLabel(a.getNumber('duration_seconds')) }}</text>
                </view>
                <view class="media-asset-btn"><text class="media-asset-btn-text">{{ tr('wellnessOpenLink') }}</text></view>
              </view>
              <view v-else class="media-asset-card" v-on:click="openMediaAsset(ai)">
                <view class="media-asset-icon media-asset-icon--doc"><text class="media-asset-glyph">↓</text></view>
                <view class="media-asset-info">
                  <text class="media-asset-name">{{ a.getString('title_zh') != null ? a.getString('title_zh') : a.getString('title') }}</text>
                </view>
                <view class="media-asset-btn"><text class="media-asset-btn-text">{{ tr('wellnessOpenLink') }}</text></view>
              </view>
            </view>

            <!-- #ifdef WEB -->
            <!-- The web user-app's Kino APK card (LearnTab) — copy the download link. -->
            <view v-if="deviceApkUrl.length > 0" class="wellness-section" style="padding-bottom: 0">
              <view class="media-asset-card" v-on:click="copyApkUrl">
                <view class="media-asset-icon media-asset-icon--doc"><text class="media-asset-glyph">↓</text></view>
                <view class="media-asset-info"><text class="media-asset-name">Kino APK {{ deviceApkVersion }}</text></view>
                <view class="media-asset-btn"><text class="media-asset-btn-text">{{ tr('wellnessOpenLink') }}</text></view>
              </view>
            </view>
            <!-- #endif -->

            <view v-if="sleepCurrentTrack != null" class="sleep-now-playing">
              <view class="sleep-np-info">
                <text class="sleep-np-label">{{ tr('nowPlaying') }}</text>
                <text class="sleep-np-title">{{ sleepCurrentTrack!.getString('title_zh') != null ? sleepCurrentTrack!.getString('title_zh') : sleepCurrentTrack!.getString('title') }}</text>
              </view>
              <view class="sleep-np-controls">
                <view class="sleep-np-btn" v-on:click="stopAudioAsset"><text class="sleep-np-btn-icon">⏹</text></view>
              </view>
            </view>

          </view>
        </scroll-view>
  </view>
</template>

<script lang="uts">
import { BASE } from '../../../../utils/config.uts'
import { state } from '../../../../utils/state.uts'
import { idOf } from '../../../../utils/json-id.uts'
import { RespEnvelope } from '../../../../utils/tool-actions.uts'
import { checkAuthStatus } from '../../../../utils/session.uts'
import { T_MAIN_ZH, T_MAIN_EN, tMainTr, lessonCount } from '../../../../utils/main-t.uts'
const MONTH_EN : string[] = ['January','February','March','April','May','June','July','August','September','October','November','December']
function _parseMs(v : any | null) : number {
  if (v == null) return NaN
  try {
    const s = `${v}`
    const ms = parseFloat(s)
    if (!isNaN(ms) && s.indexOf('-') == -1 && s.indexOf(':') == -1) return ms
    return new Date(s).getTime()
  } catch (e : any) { return NaN }
}
async function _envelopeRun(url : string, method : RequestMethod, data : UTSJSONObject | null, timeoutMs : number) : Promise<RespEnvelope> {
  const header = { 'Content-Type': 'application/json', 'Authorization': `Bearer ${state.apiToken}` } as UTSJSONObject
  let res : RequestSuccess<UTSJSONObject> | null = null
  await new Promise<boolean>((resolve : (v : boolean) => void, _reject : (e : any | null) => void) => {
    uni.request<UTSJSONObject>({
      url: url, method: method, header: header, data: data, timeout: timeoutMs,
      success: (r) => { res = r; resolve(true) },
      fail: (err) => { resolve(false) },
    })
  })
  if (res == null) return new RespEnvelope(0, null)
  checkAuthStatus(res!.statusCode)
  return new RespEnvelope(res!.statusCode, res!.data)
}
export default {
  props: {
    user: { type: Object as PropType<UTSJSONObject>, default: null },
    lang: { type: String, default: 'zh' },
    theme: { type: String, default: 'dark' },
    active: { type: Boolean, default: true },
    completedLessonId: { type: Number, default: 0 },
  },
  emits: ['packageready'],
  data() {
    return {
      learnSubTab: 'academy',
      // Magic Box (wellness) tab
      wellnessLoading: false,
      wellnessAssets: [] as UTSJSONObject[],
      sleepPlaying: false,
      sleepCurrentTrack: null as UTSJSONObject | null,
      sleepPosition: 0,
      sleepDuration: 0,
      deviceApkVersion: '',
      deviceApkUrl: '',

      // Academy tab
      trainingCourses: [] as UTSJSONObject[],
      trainingLibrary: [] as UTSJSONObject[],
      trainingCompletedIds: [] as number[],
      trainingLessons: [] as UTSJSONObject[],
      trainingView: 'list',
      trainingCurrentCourse: null as UTSJSONObject | null,
      trainingCurrentLesson: null as UTSJSONObject | null,
      trainingVideoUrl: '',
      trainingTextContent: '',
      trainingLibraryContent: '',
      trainingCurrentLibraryItem: null as UTSJSONObject | null,
      trainingLoading: false,
      trainingMarkingComplete: false,
      trainingDashboard: null as UTSJSONObject | null,
      trainingPaths: [] as UTSJSONObject[],
      trainingCertifications: [] as UTSJSONObject[],
      certDetailOpen: false,   // renamed from miniapp data key `showCertDetail` — the method of that name collides with it
      certDetailItem: null as UTSJSONObject | null,
      trainingQuizQuestions: [] as UTSJSONObject[],
      trainingQuizAnswers: {} as UTSJSONObject,
      trainingQuizResult: null as UTSJSONObject | null,
      trainingQuizReview: [] as UTSJSONObject[],
      trainingQuizSubmitting: false,

      _audio: null as InnerAudioContext | null,
      _bgm: null as any | null,
    }
  },
  computed: {
    currentLessonCompleted() : boolean {
      const l = this.trainingCurrentLesson
      if (l == null) return false
      const id = l!.getNumber('id')
      if (id == null) return false
      return this.trainingCompletedIds.indexOf(id!) >= 0
    },
    certName() : string {
      const c = this.certDetailItem
      if (c != null) {
        const un = c!.getString('_userName')
        if (un != null && un!.length > 0) return un!
      }
      const u = this.user
      return u != null ? (u!.getString('nickname') ?? '—') : '—'
    },
  },
  mounted() {
    this.$emit('packageready')
    this._loadAcademy()
  },
  beforeUnmount() {
    this.stopAudioAsset()
    if (this._audio != null) this._audio!.destroy()
  },
  watch: {
    completedLessonId(lessonId : number) {
      if (lessonId > 0 && this.trainingCompletedIds.indexOf(lessonId) < 0) {
        this.trainingCompletedIds = this.trainingCompletedIds.concat([lessonId])
      }
    },
    active(value : boolean) {
      if (value) this.switchLearnSubTab(this.learnSubTab)
    },
  },
  methods: {
    switchLearnSubTab(subTab : string) {
      this.learnSubTab = subTab
      if (subTab == 'academy' && this.trainingCourses.length == 0) this._loadAcademy()
      if (subTab == 'wellness' && this.wellnessAssets.length == 0) this._loadWellness()
    },
    trackActive(a : UTSJSONObject) : boolean {
      const cur = this.sleepCurrentTrack
      return cur != null && cur!.getNumber('id') == a.getNumber('id')
    },
    trackPlaying(a : UTSJSONObject) : boolean {
      return this.trackActive(a) && this.sleepPlaying
    },
    durLabel(seconds : number | null) : string {
      const s = seconds ?? 0
      if (s >= 60) return `${Math.floor(s / 60)} 分钟`
      return `${s} 秒`
    },
    // ── Wellness tab ──
    // xapp-mini plays through wx.getBackgroundAudioManager, as the miniapp. TODO(port): native has
    // no equivalent yet — uni.createInnerAudioContext keeps playing only while foregrounded. Wiring kept
    // identical in shape (onPlay/onPause/onStop/onEnded/onTimeUpdate).
    async _loadWellness() {
      this.wellnessLoading = true
      try {
        const user = this.user
        const cid = user != null ? user!.getNumber('channel_id') : null
        const assetsRes = await this._req(`${BASE}/api/digital-assets${cid != null ? `?channel_id=${cid}` : ''}`, 'GET', null, 0)
        const raw = assetsRes.data != null ? (assetsRes.data!.getArray<UTSJSONObject>('assets') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        const assets : UTSJSONObject[] = []
        for (const a of raw) {
          const ct = a.getString('content_type') ?? ''
          let mediaType = 'other'
          if (ct.startsWith('audio/')) mediaType = 'audio'
          else if (ct.startsWith('video/')) mediaType = 'video'
          const row = this._copyRow(a)
          row['mediaType'] = mediaType
          assets.push(row)
        }
        const apkRes = await this._req(`${BASE}/api/kino-upgrade`, 'GET', null, 0)
        const apk = apkRes.data
        this.wellnessAssets = assets
        this.deviceApkVersion = apk != null ? (apk!.getString('version') ?? '') : ''
        this.deviceApkUrl = apk != null ? (apk!.getString('url') ?? '') : ''
        this.wellnessLoading = false
      } catch (err : any) {
        this.wellnessLoading = false
      }
    },

    _initBgAudio() {
      // #ifdef MP-WEIXIN
      // xapp-mini: WeChat's background audio manager, as the miniapp — playback carries on with
      // the screen off or the app in the background (requiredBackgroundModes: audio).
      if (this._bgm != null) return
      const bgm = wx.getBackgroundAudioManager()
      bgm.onPlay(() => { this.sleepPlaying = true })
      bgm.onPause(() => { this.sleepPlaying = false })
      bgm.onStop(() => { this.sleepPlaying = false; this.sleepPosition = 0 })
      bgm.onEnded(() => { this.sleepPlaying = false; this.sleepPosition = 0 })
      bgm.onTimeUpdate(() => {
        this.sleepPosition = Math.floor(bgm.currentTime as number)
        const dur = Math.floor(bgm.duration as number)
        if (dur > 0) this.sleepDuration = dur
      })
      this._bgm = bgm
      return
      // #endif
      if (this._audio != null) return
      const ctx = uni.createInnerAudioContext()
      ctx.onPlay(() => { this.sleepPlaying = true })
      ctx.onPause(() => { this.sleepPlaying = false })
      ctx.onStop(() => { this.sleepPlaying = false; this.sleepPosition = 0 })
      ctx.onEnded(() => { this.sleepPlaying = false; this.sleepPosition = 0 })
      ctx.onTimeUpdate(() => {
        this.sleepPosition = Math.floor(ctx.currentTime)
        const dur = Math.floor(ctx.duration)
        if (dur > 0) this.sleepDuration = dur
      })
      this._audio = ctx
    },

    playAudioAsset(index : number) {
      const track = index < this.wellnessAssets.length ? this.wellnessAssets[index] : null
      if (track == null) return
      const cur = this.sleepCurrentTrack
      this._initBgAudio()
      // #ifdef MP-WEIXIN
      const bgm = this._bgm
      if (bgm == null) return
      if (cur != null && cur!.getNumber('id') == track!.getNumber('id') && this.sleepPlaying) {
        bgm.pause()
        return
      }
      const src = track!.getString('url')
      if (src == null) return
      // title is required by the background manager (it shows on the lock screen); src starts it.
      bgm.title = track!.getString('title_zh') ?? (track!.getString('title') ?? '')
      bgm.coverImgUrl = ''
      bgm.src = src!
      this.sleepCurrentTrack = track
      this.sleepPosition = 0
      this.sleepDuration = track!.getNumber('duration_seconds') ?? 0
      return
      // #endif
      const ctx = this._audio
      if (ctx == null) return
      if (cur != null && cur!.getNumber('id') == track!.getNumber('id') && this.sleepPlaying) {
        ctx.pause()
        return
      }
      const url = track!.getString('url')
      if (url == null) return
      ctx.src = url!
      // InnerAudioContext has no title field on uni-app x (WeChat-era metadata) — skipped.
      this.sleepCurrentTrack = track
      this.sleepPosition = 0
      this.sleepDuration = track!.getNumber('duration_seconds') ?? 0
    },

    stopAudioAsset() {
      // #ifdef MP-WEIXIN
      if (this._bgm != null) this._bgm.stop()
      // #endif
      const ctx = this._audio
      if (ctx != null) ctx.stop()
      this.sleepCurrentTrack = null
      this.sleepPlaying = false
      this.sleepPosition = 0
    },

    // The miniapp copied the asset URL for a browser (media-asset-btn = 复制链接); same native.
    openMediaAsset(index : number) {
      const asset = index < this.wellnessAssets.length ? this.wellnessAssets[index] : null
      if (asset == null) return
      const url = asset!.getString('url')
      if (url == null || url!.length == 0) return
      uni.setClipboardData({
        data: url!,
        success: () => { uni.showToast({ title: '链接已复制，请在浏览器打开', icon: 'none', duration: 2500 }) },
      })
    },

    copyApkUrl() {
      if (this.deviceApkUrl.length == 0) return
      uni.setClipboardData({
        data: this.deviceApkUrl,
        success: () => { uni.showToast({ title: '链接已复制，请在浏览器打开', icon: 'none', duration: 2500 }) },
      })
    },

    // ── Academy tab ──
    async _loadAcademy() {
      const user = this.user
      const userId = user != null ? (user!.getString('user_id') ?? '') : ''
      if (userId.length == 0) return
      this.trainingLoading = true
      try {
        // Promise.allSettled in the source → sequential awaits with per-call try/catch; same
        // partial-failure semantics (each list defaults to empty when its fetch fails).
        let rawCourses : UTSJSONObject[] = []
        let library : UTSJSONObject[] = []
        let progressRows : UTSJSONObject[] = []
        let rawDashboard : UTSJSONObject | null = null
        let paths : UTSJSONObject[] = []
        let certs : UTSJSONObject[] = []
        try {
          const r = await this._req(`${BASE}/api/academy/courses`, 'GET', null, 0)
          rawCourses = r.data != null ? (r.data!.getArray<UTSJSONObject>('courses') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        } catch (e : any) {}
        try {
          const r = await this._req(`${BASE}/api/academy/library`, 'GET', null, 0)
          library = r.data != null ? (r.data!.getArray<UTSJSONObject>('items') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        } catch (e : any) {}
        try {
          const r = await this._req(`${BASE}/api/academy/progress?user_id=${userId}`, 'GET', null, 0)
          progressRows = r.data != null ? (r.data!.getArray<UTSJSONObject>('progress') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        } catch (e : any) {}
        try {
          const r = await this._req(`${BASE}/api/academy/coach-dashboard?user_id=${userId}`, 'GET', null, 0)
          rawDashboard = r.data
        } catch (e : any) {}
        try {
          const r = await this._req(`${BASE}/api/academy/learning-paths`, 'GET', null, 0)
          paths = r.data != null ? (r.data!.getArray<UTSJSONObject>('paths') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        } catch (e : any) {}
        try {
          const r = await this._req(`${BASE}/api/academy/coach-certifications?user_id=${userId}`, 'GET', null, 0)
          certs = r.data != null ? (r.data!.getArray<UTSJSONObject>('certifications') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        } catch (e : any) {}

        const t = this.lang == 'zh' ? T_MAIN_ZH : T_MAIN_EN
        const tl = t.getJSON('training')!
        const tierLabels = tl!.getJSON('tierLabels')!
        const publishedCourses = rawCourses.filter((c : UTSJSONObject) : boolean => c.getString('status') == 'published')
        const completedIds : number[] = []
        for (const p of progressRows) {
          const lid = p.getNumber('lesson_id')
          if (lid != null) completedIds.push(lid!)
        }
        // Per-course completion counts; a course is fully completed when ALL its lessons are done.
        const completedByCourse = new Map<number, number>()
        for (const p of progressRows) {
          const cid = p.getNumber('course_id')
          if (cid != null) completedByCourse.set(cid!, (completedByCourse.get(cid!) ?? 0) + 1)
        }
        const completedCourseIds = new Set<number>()
        for (const c of publishedCourses) {
          const lc = c.getNumber('lesson_count') ?? 0
          const cid = c.getNumber('id')
          if (cid != null && lc > 0 && (completedByCourse.get(cid!) ?? 0) >= lc) completedCourseIds.add(cid!)
        }
        const courses : UTSJSONObject[] = []
        for (const c of publishedCourses) {
          const row = this._copyRow(c)
          const lc = c.getNumber('lesson_count') ?? 0
          row['_lessonCountLabel'] = lessonCount(this.lang, lc!)
          const level = c.getString('level') ?? ''
          const tierLabel = tierLabels.getString(level)
          row['_levelLabel'] = tierLabel != null && tierLabel!.length > 0 ? tierLabel : level
          const prereq = c.getNumber('prerequisite_course_id')
          row['_locked'] = prereq != null && !completedCourseIds.has(prereq!)
          courses.push(row)
        }
        let dashboard : UTSJSONObject | null = null
        if (rawDashboard != null) {
          dashboard = this._copyRow(rawDashboard!)
          const tier = `${rawDashboard!.getString('tier') ?? ''}`
          const tl2 = tierLabels.getString(tier)
          dashboard!['_tierLabel'] = tl2 != null && tl2!.length > 0 ? tl2 : tier
        }
        const certifications : UTSJSONObject[] = []
        for (const c of certs) {
          const row = this._copyRow(c)
          const tier = c.getString('tier') ?? ''
          const tl3 = tierLabels.getString(tier)
          row['_tierLabel'] = tl3 != null && tl3!.length > 0 ? tl3 : tier
          certifications.push(row)
        }
        const enrichedPaths : UTSJSONObject[] = []
        for (const p of paths) {
          const pCourses = p.getArray<UTSJSONObject>('courses') ?? ([] as UTSJSONObject[])
          let done = 0
          for (const pc of pCourses) {
            const cid = pc.getNumber('course_id')
            if (cid != null && completedCourseIds.has(cid!)) done++
          }
          const row = this._copyRow(p)
          row['_total'] = pCourses.length
          row['_done'] = done
          const tier = p.getString('tier') ?? ''
          const tl4 = tierLabels.getString(tier)
          row['_tierLabel'] = tl4 != null && tl4!.length > 0 ? tl4 : tier
          enrichedPaths.push(row)
        }
        this.trainingCourses = courses
        this.trainingLibrary = library
        this.trainingCompletedIds = completedIds
        this.trainingDashboard = dashboard
        this.trainingPaths = enrichedPaths
        this.trainingCertifications = certifications
      } catch (e : any) {
        uni.showToast({ title: this.tr('training.loadError'), icon: 'none' })
      } finally {
        this.trainingLoading = false
      }
    },

    pathPct(p : UTSJSONObject) : number {
      const total = p.getNumber('_total') ?? 0
      const done = p.getNumber('_done') ?? 0
      return total > 0 ? Math.round(done / total * 100) : 0
    },
    isLessonCompleted(index : number) : boolean {
      const lsn = index < this.trainingLessons.length ? this.trainingLessons[index] : null
      if (lsn == null) return false
      const id = lsn!.getNumber('id')
      if (id == null) return false
      return this.trainingCompletedIds.indexOf(id!) >= 0
    },
    quizAnswerFor(q : UTSJSONObject) : number {
      const v = this.trainingQuizAnswers.getNumber(idOf(q, 'id'))
      return v != null ? v! : -1
    },

    async trainingOpenCourse(index : number, isPath : boolean) {
      const source = isPath ? this.trainingPaths : this.trainingCourses
      const course = index < source.length ? source[index] : null
      if (course == null) return
      if (course!.getBoolean('_locked') == true) {
        const prereq = course!.getString('prerequisite_title') ?? (this.lang == 'zh' ? '前置课程' : 'prerequisite course')
        uni.showToast({ title: this.lang == 'zh' ? `请先完成：${prereq}` : `Complete first: ${prereq}`, icon: 'none', duration: 2500 })
        return
      }
      this.trainingCurrentCourse = course
      this.trainingLessons = [] as UTSJSONObject[]
      this.trainingView = 'lessons'
      try {
        const cid = course!.getNumber('id') ?? ''
        const res = await this._req(`${BASE}/api/academy/lessons?course_id=${cid}`, 'GET', null, 0)
        this.trainingLessons = res.data != null ? (res.data!.getArray<UTSJSONObject>('lessons') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
      } catch (e : any) {
        uni.showToast({ title: this.tr('training.loadError'), icon: 'none' })
      }
    },

    async trainingOpenLesson(index : number) {
      const lesson = index < this.trainingLessons.length ? this.trainingLessons[index] : null
      if (lesson == null) return
      this.trainingCurrentLesson = lesson
      this.trainingVideoUrl = ''
      this.trainingTextContent = ''
      this.trainingQuizQuestions = [] as UTSJSONObject[]
      this.trainingQuizAnswers = {} as UTSJSONObject
      this.trainingQuizResult = null
      this.trainingQuizReview = [] as UTSJSONObject[]
      this.trainingView = 'player'
      try {
        const lid = lesson!.getNumber('id') ?? ''
        const detailRes = await this._req(`${BASE}/api/academy/lessons/${lid}`, 'GET', null, 0)
        const detail = detailRes.data
        const quizQuestions = detail != null ? (detail!.getArray<UTSJSONObject>('quiz_questions') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        const contentType = lesson!.getString('content_type') ?? ''
        if (contentType == 'text' || contentType == 'interactive') {
          const inner = detail != null ? detail!.getJSON('lesson') : null
          this.trainingTextContent = inner != null ? (inner!.getString('text_content') ?? '') : ''
          this.trainingQuizQuestions = quizQuestions
          return
        }
        const ossKey = lesson!.getString('oss_key')
        if (ossKey != null && ossKey!.length > 0) {
          const presignRes = await this._req(`${BASE}/api/oss/presign?action=get&key=${encodeURIComponent(ossKey!)}`, 'GET', null, 0)
          this.trainingVideoUrl = presignRes.data != null ? (presignRes.data!.getString('url') ?? '') : ''
          this.trainingQuizQuestions = quizQuestions
        }
      } catch (e : any) {
        uni.showToast({ title: this.tr('training.loadError'), icon: 'none' })
      }
    },

    trainingSelectAnswer(questionId : string, optionIndex : number) {
      const answers = this._copyRow(this.trainingQuizAnswers)
      answers[questionId] = optionIndex
      this.trainingQuizAnswers = answers
    },

    async trainingSubmitQuiz() {
      const lesson = this.trainingCurrentLesson
      const user = this.user
      if (lesson == null || user == null) return
      if (this.trainingQuizAnswers.toMap().size == 0) { uni.showToast({ title: '请先回答问题', icon: 'none' }); return }
      this.trainingQuizSubmitting = true
      try {
        const answerObj = new UTSJSONObject()
        this.trainingQuizAnswers.toMap().forEach((v : any | null, k : string) => { answerObj[k] = v })
        const res = await this._req(`${BASE}/api/academy/quiz-attempts`, 'POST', {
          user_id: user!.getString('user_id'), lesson_id: lesson!.getNumber('id'), answers: answerObj,
        } as UTSJSONObject, 0)
        const result = res.data
        const correctAnswers = result != null ? (result!.getArray<UTSJSONObject>('correct_answers') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        const review : UTSJSONObject[] = []
        for (const q of this.trainingQuizQuestions) {
          const qid = q.getNumber('id')
          let ca : UTSJSONObject | null = null
          for (const x of correctAnswers) { if (x.getNumber('question_id') == qid) { ca = x; break } }
          const options = q.getArray<UTSJSONObject>('options') ?? ([] as UTSJSONObject[])
          const ansIdx = qid != null ? this.trainingQuizAnswers.getNumber(`${qid}`) : null
          let userAnswer = '—'
          if (ca != null && ansIdx != null && ansIdx! >= 0 && ansIdx! < options.length) {
            userAnswer = options[ansIdx!].getString('text') ?? '—'
          }
          let correctAnswer = ''
          if (ca != null) {
            const ci = ca!.getNumber('correct_index')
            if (ci != null && ci! >= 0 && ci! < options.length) correctAnswer = options[ci!].getString('text') ?? ''
          }
          review.push({
            question: q.getString('question'),
            user_answer: userAnswer,
            correct_answer: correctAnswer,
            explanation: ca != null ? (ca!.getString('explanation') ?? '') : '',
            is_correct: ca != null && ca!.getBoolean('is_correct') == true,
          } as UTSJSONObject)
        }
        this.trainingQuizResult = result != null ? result : new UTSJSONObject()
        this.trainingQuizReview = review
        if (result != null && result!.getBoolean('passed') == true) {
          const lid = lesson!.getNumber('id')
          if (lid != null) { await this._doMarkComplete(lid!); this._loadAcademy() }
        }
      } catch (e : any) {
        uni.showToast({ title: this.tr('training.loadError'), icon: 'none' })
      } finally {
        this.trainingQuizSubmitting = false
      }
    },

    async _doMarkComplete(lessonId : number) {
      const user = this.user
      if (user == null) return
      if (this.trainingCompletedIds.indexOf(lessonId) >= 0) return
      try {
        await this._req(`${BASE}/api/academy/progress`, 'POST', { user_id: user!.getString('user_id'), lesson_id: lessonId } as UTSJSONObject, 0)
        this.trainingCompletedIds = [...this.trainingCompletedIds, lessonId]
      } catch (e : any) { /* silent */ }
    },

    async trainingMarkComplete() {
      const lesson = this.trainingCurrentLesson
      if (lesson == null) return
      if (lesson!.getBoolean('has_quiz') == true && this.trainingQuizQuestions.length > 0 && (this.trainingQuizResult == null || this.trainingQuizResult!.getBoolean('passed') != true)) {
        uni.showToast({ title: '请先完成测验', icon: 'none' }); return
      }
      const lid = lesson!.getNumber('id')
      if (lid != null && this.trainingCompletedIds.indexOf(lid!) >= 0) return
      this.trainingMarkingComplete = true
      try {
        if (lid != null) await this._doMarkComplete(lid!)
        uni.showToast({ title: this.tr('training.markedComplete'), icon: 'success' })
        this._loadAcademy()
      } catch (e : any) {
        uni.showToast({ title: this.tr('training.loadError'), icon: 'none' })
      } finally {
        this.trainingMarkingComplete = false
      }
    },

    async trainingOpenLibraryItem(index : number) {
      const item = index < this.trainingLibrary.length ? this.trainingLibrary[index] : null
      if (item == null) return
      this.trainingCurrentLibraryItem = item
      this.trainingLibraryContent = ''
      this.trainingView = 'library-viewer'
      try {
        const res = await this._req(`${BASE}/api/academy/library/${item!.getNumber('id')}/content`, 'GET', null, 0)
        this.trainingLibraryContent = res.data != null ? (res.data!.getString('content') ?? JSON.stringify(res.data)) : ''
      } catch (e : any) {
        uni.showToast({ title: this.tr('training.loadError'), icon: 'none' })
      }
    },

    trainingBackToList() {
      this.trainingView = 'list'
      this.trainingCurrentCourse = null
      this.trainingCurrentLesson = null
      this.trainingVideoUrl = ''
      this.trainingQuizQuestions = [] as UTSJSONObject[]
      this.trainingQuizAnswers = {} as UTSJSONObject
      this.trainingQuizResult = null
      this.trainingQuizReview = [] as UTSJSONObject[]
    },

    // API responses serialize DATE columns as full ISO datetimes parsed in the backend's
    // Asia/Shanghai process timezone — e.g. "2026-07-05T16:00:00.000Z" for a stored 2026-07-06.
    // Shift by the fixed +8h (no DST in China) before reading fields, so the day comes out right
    // on any device timezone.
    _formatCertDate(dateStr : string | null) : string {
      if (dateStr == null || dateStr!.length == 0) return ''
      const t = _parseMs(dateStr)
      if (isNaN(t)) return dateStr!
      const shanghai = new Date(t + 8 * 60 * 60 * 1000)
      const y = shanghai.getUTCFullYear()
      const day = shanghai.getUTCDate()
      if (this.lang == 'zh') return `${y}年${shanghai.getUTCMonth() + 1}月${day}日`
      return `${MONTH_EN[shanghai.getUTCMonth()]} ${day}, ${y}`
    },

    async showCertDetail(index : number) {
      const cert = index < this.trainingCertifications.length ? this.trainingCertifications[index] : null
      if (cert == null) return
      // cert_oss_key is the backend-composited image (name/dates burned in) — prefer it;
      // template_image_oss_key is the blank template, only a fallback when generation hasn't run.
      const certKey = cert!.getString('cert_oss_key') ?? ''
      const tmplKey = cert!.getString('template_image_oss_key') ?? ''
      const displayKey = certKey.length > 0 ? certKey : tmplKey
      let templateImageUrl = ''
      if (displayKey.length > 0) {
        try {
          const res = await this._req(`${BASE}/api/oss/presign?action=get&key=${encodeURIComponent(displayKey)}`, 'GET', null, 0)
          templateImageUrl = res.data != null ? (res.data!.getString('url') ?? '') : ''
        } catch (e : any) {}
      }
      const row = this._copyRow(cert!)
      row['templateImageUrl'] = templateImageUrl
      row['issueDateDisplay'] = this._formatCertDate(cert!.getString('issue_date'))
      row['expiryDateDisplay'] = this._formatCertDate(cert!.getString('expiry_date'))
      this.certDetailOpen = true
      this.certDetailItem = row
    },

    hideCertDetail() {
      this.certDetailOpen = false
      this.certDetailItem = null
    },

    async downloadCert(key : string) {
      if (key.length == 0) return
      uni.showLoading({ title: this.lang == 'zh' ? '准备中…' : 'Loading…' })
      try {
        const res = await this._req(`${BASE}/api/oss/presign?action=get&key=${encodeURIComponent(key)}`, 'GET', null, 0)
        const url = res.data != null ? res.data!.getString('url') : null
        if (url == null || url!.length == 0) throw new Error('No URL')
        uni.hideLoading()
        // #ifdef MP-WEIXIN
        // xapp-mini: download and hand to WeChat's document viewer, as the miniapp.
        const filePath = await new Promise<string>((resolve, reject) => {
          uni.downloadFile({ url: url!, success: (r) => { if (r.statusCode == 200) resolve(r.tempFilePath); else reject(new Error(`http ${r.statusCode}`)) }, fail: (e) => { reject(e) } })
        })
        wx.openDocument({ filePath: filePath, showMenu: true } as any)
        return
        // #endif
        // TODO(port): no in-app PDF viewer is wired on the native side yet; pay-qr's
        // save-to-album precedent doesn't fit a PDF. Copy link for now.
        uni.setClipboardData({ data: url!, success: () => { uni.showToast({ title: '链接已复制，请在浏览器打开', icon: 'none', duration: 2500 }) } })
      } catch (e : any) {
        uni.hideLoading()
        uni.showToast({ title: this.lang == 'zh' ? '下载失败' : 'Download failed', icon: 'none' })
      }
    },

    trainingBackToLessons() {
      this.trainingView = 'lessons'
      this.trainingCurrentLesson = null
      this.trainingVideoUrl = ''
      this.trainingCurrentLibraryItem = null
      this.trainingLibraryContent = ''
      this.trainingQuizQuestions = [] as UTSJSONObject[]
      this.trainingQuizAnswers = {} as UTSJSONObject
      this.trainingQuizResult = null
      this.trainingQuizReview = [] as UTSJSONObject[]
    },

    arrOf(obj : UTSJSONObject, key : string) : UTSJSONObject[] {
      const a = obj.getArray<UTSJSONObject>(key)
      return a != null ? a : ([] as UTSJSONObject[])
    },
    idStr(o : UTSJSONObject, key : string) : string {
      const raw = o[key]
      return raw != null ? `${raw}` : ''
    },
    noop() {},
    _copyRow(x : UTSJSONObject) : UTSJSONObject {
      const row = new UTSJSONObject()
      x.toMap().forEach((v : any | null, k : string) => { row[k] = v })
      return row
    },
    async _req(url : string, method : string, data : UTSJSONObject | null, timeoutMs : number) : Promise<RespEnvelope> {
      let body = data
      if (state.sandboxMode && method != 'GET') {
        const injected = new UTSJSONObject()
        if (data != null) data!.toMap().forEach((v : any | null, k : string) => { injected[k] = v })
        injected['sandbox'] = true
        body = injected
      }
      const to = timeoutMs > 0 ? timeoutMs : 60000
      if (method == 'POST') return _envelopeRun(url, 'POST', body, to)
      if (method == 'PUT') return _envelopeRun(url, 'PUT', body, to)
      if (method == 'DELETE') return _envelopeRun(url, 'DELETE', body, to)
      if (method == 'PATCH') return _envelopeRun(url, 'PATCH', body, to)
      return _envelopeRun(url, 'GET', body, to)
    },
    tr(path : string) : string { return tMainTr(this.lang == 'zh' ? T_MAIN_ZH : T_MAIN_EN, path) },
  },
}
</script>
