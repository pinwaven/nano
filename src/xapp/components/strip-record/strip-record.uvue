  close: '关闭',
  loading: '正在读取记录…',
  delete: '删除这条记录',
  deleteConfirm: '删除后无法恢复，确定删除这条记录？',
  deleteFailed: '删除失败，请稍后重试。',
  failLoadTitle: '无法读取记录',
  failLoadBody: '网络异常或记录已被删除。',
  failBleTitle: '无法连接设备',
  failBleBody: '请确认设备在附近且蓝牙已开启，然后重试。',
  failUploadTitle: '保存失败',
