<template>
  <!-- 心电节律 / 脉搏波 记录 overlay — ported from components/strip-record/strip-record.wxml.
       The miniapp's catchtouchmove="noop" (scroll-through guard) has no uvue equivalent; the
       fixed full-screen overlay swallows touches itself. -->
  <view v-if="open" class="strip-overlay">
    <scroll-view direction="vertical" :class="theme == 'light' ? 'strip-sheet strip-sheet-light' : 'strip-sheet'">
      <view class="strip-head">
        <text class="strip-title">{{ tt('title') }}</text>
        <view class="strip-close" v-on:click="handleClose()"><text class="strip-close-text">✕</text></view>
      </view>

      <!-- idle: instructions -->
      <view v-if="stage == 'idle'" class="strip-block">
        <view class="strip-guide">
          <text class="strip-guide-glyph">{{ tt('guideGlyph') }}</text>
          <text class="strip-guide-line">{{ tt('guide1') }}</text>
          <text class="strip-guide-line">{{ tt('guide2') }}</text>
          <text class="strip-guide-line strip-guide-muted">{{ tt('guide3') }}</text>
        </view>
        <view class="strip-btn strip-btn-primary" v-on:click="handleStart()"><text class="strip-btn-text">{{ tt('start') }}</text></view>
        <text class="strip-footnote">{{ tt('notDiagnosis') }}</text>
      </view>

      <!-- connecting / measuring / saving -->
      <view v-if="stage == 'connecting' || stage == 'measuring' || stage == 'saving'" class="strip-block">
        <view class="strip-status-row">
          <text class="strip-status">{{ statusText() }}</text>
          <text v-if="stage == 'measuring'" class="strip-countdown">{{ remaining }}s</text>
        </view>
        <view class="strip-canvas-wrap">
          <!-- uvue canvas uses `id` (the miniapp's legacy canvas-id does not exist here) -->
          <canvas id="strip-live" class="strip-canvas"></canvas>
        </view>
        <view class="strip-meta-row">
          <text class="strip-meta">{{ tt('packets') }} {{ packetCount }}</text>
          <text class="strip-meta">{{ tt('beatsLive') }} {{ liveBeats }}</text>
        </view>
        <view v-if="stage == 'measuring'" class="strip-btn strip-btn-ghost" v-on:click="handleStop()"><text class="strip-btn-text">{{ tt('stopEarly') }}</text></view>
      </view>

      <!-- loading a stored strip -->
      <view v-if="stage == 'loading'" class="strip-block">
        <view class="strip-guide"><text class="strip-guide-line strip-guide-muted">{{ tt('loading') }}</text></view>
      </view>

      <!-- result (just recorded) / view (a stored strip): same layout, whole strip stacked in rows -->
      <view v-if="stage == 'result' || stage == 'view'" class="strip-block">
        <text v-if="stage == 'view'" class="strip-when">{{ viewWhen }}</text>
        <view class="strip-result-hero">
          <text class="strip-bpm">{{ resBpm }}</text>
          <text class="strip-bpm-unit">bpm</text>
        </view>
        <view class="strip-result-grid">
          <view class="strip-cell"><text class="strip-cell-v">{{ resAcceptedBeats }}</text><text class="strip-cell-k">{{ tt('beats') }}</text></view>
          <view class="strip-cell"><text class="strip-cell-v">{{ resRrMedian }}</text><text class="strip-cell-k">{{ tt('rrMedian') }}</text></view>
          <view class="strip-cell"><text class="strip-cell-v">{{ resRrSd }}</text><text class="strip-cell-k">{{ tt('rrSd') }}</text></view>
          <view class="strip-cell"><text class="strip-cell-v">{{ resDuration }}</text><text class="strip-cell-k">{{ tt('duration') }}</text></view>
        </view>
        <view class="strip-canvas-wrap" :style="'height:' + stripHeightPx + 'px;'">
          <canvas id="strip-strip" class="strip-canvas strip-strip-canvas" :style="'height:' + stripHeightPx + 'px;'"></canvas>
        </view>
        <text class="strip-footnote">{{ tt('notDiagnosis') }}</text>
        <view class="strip-btn strip-btn-primary" v-on:click="handleClose()"><text class="strip-btn-text">{{ tt('done') }}</text></view>
        <view v-if="stage == 'view' && !readOnly" class="strip-btn strip-btn-ghost strip-btn-danger" v-on:click="handleDelete()"><text class="strip-btn-text">{{ tt('delete') }}</text></view>
      </view>

      <!-- refused / failed -->
      <view v-if="stage == 'failed'" class="strip-block">
        <view class="strip-guide">
          <text class="strip-guide-glyph">⚠</text>
          <text class="strip-guide-line">{{ failTitle }}</text>
          <text class="strip-guide-line strip-guide-muted">{{ failBody }}</text>
        </view>
        <view class="strip-btn strip-btn-primary" v-on:click="handleRetry()"><text class="strip-btn-text">{{ tt('retry') }}</text></view>
        <view class="strip-btn strip-btn-ghost" v-on:click="handleClose()"><text class="strip-btn-text">{{ tt('close') }}</text></view>
      </view>
    </scroll-view>
  </view>
</template>

<script>
// 心电节律 / 脉搏波 记录 — one overlay that records a raw strip from a bound wearable, uploads it
// for analysis and shows the result, and that reads a stored strip back. `kind` picks which:
//   kind="ecg"  single-lead ECG from the V8 band (§18/§45 心电节律; V8 only), 35 s capture with
//               the first 5 s discarded, leaving a 30 s strip at ≈255 Hz, needs a finger from the
//               other hand on the electrode — POST /api/ecg;
//   kind="ppg"  the raw optical pulse wave from the V8 band or the Halo ring, 35 s capture with
//               the first 5 s discarded, leaving a 30 s strip at 50 Hz — POST /api/ppg.
// Both are twin layer 2 data (§34). Self view only for recording; the host (user-health) renders
// it only when the bound wearable supports the kind. Device behaviour was established live
// (2026-09-19 ECG, 2026-09-20 PPG) — tools/halo/README.md "ECG"/"PPG", docs/architecture/
// v8-smart-band.md §6, docs/architecture/halo-smart-ring.md §3.12:
//   - ECG: contact owns the measurement (wrist + finger, or the band aborts within ~3 s); the
//     band ends it at the requested duration; a start that produces no packets is explained as
//     "lift the finger and place it again";
//   - PPG: the pulse is a few percent of the light level and the device re-ranges gain on motion,
//     so a loose strap or moving hand is refused by the server as poor_contact and explained as
//     "snug and still", never as a device error.
// Nothing here is a diagnosis: the devices give dimensionless counts, the server derives rhythm.
//
// Contract preserved from the miniapp component:
//   properties → props: kind, open, userId, brand, deviceId, deviceName, lang, theme, viewId,
//             coachId, readOnly (same names/defaults).
//   events:   'close' (no detail), 'deleted' {id, kind}, 'saved' {kind, ecg|ppg: row}.
// Deviations (trial port): BLE runs over the installed transport, which only xapp-mini has so far
// (utils/wearable/transport-mp.uts); elsewhere a default BleTransport rejects with 'BLE transport
// not installed', which lands in the same failBle branch as a real connect failure; canvas drawing
// marked TODO(port); the per-request 20s timeout of the miniapp's own _req is not carried (the
// shared request.uts helpers do not expose one).

import { BASE } from '../../utils/config.uts'
import { getBody, postBody, deleteBody } from '../../utils/request.uts'
import { tr } from '../../utils/i18n.uts'
import { createWearable, getInstalledBleTransport } from '../../utils/wearable/index.uts'
import { BleTransport } from '../../utils/wearable/transport.uts'
import { HaloRing, PpgPacketRecord, RecordPpgOpts } from '../../utils/wearable/halo/index.uts'
import { V8Band, V8StreamPacket, V8RecordOpts } from '../../utils/wearable/v8/index.uts'

const NO_SIGNAL_AFTER_MS = 5000
const CONNECT_TIMEOUT_MS = 15000
const LIVE_WINDOW_SEC = 4
const STRIP_ROW_SEC = 5   // a printed strip: 5 s per row
const STRIP_ROW_PX = 64
const STRIP_SETTLE_MS = 5000

class KindInfo {
  durationSec : number
  method : string        // 'recordEcg' | 'recordPpg'
  path : string          // 'ecg' | 'ppg'
  brands : string[]
  rateHz : number
  liveSd : number
  liveRefractoryS : number
  liveHighPassS : number
  constructor(durationSec : number, method : string, path : string, brands : string[],
    rateHz : number, liveSd : number, liveRefractoryS : number, liveHighPassS : number) {
    this.durationSec = durationSec
    this.method = method
    this.path = path
    this.brands = brands
    this.rateHz = rateHz
    this.liveSd = liveSd
    this.liveRefractoryS = liveRefractoryS
    this.liveHighPassS = liveHighPassS
  }
}

// Per-kind facts: capture length, the adapter method, the endpoint, the nominal sample rate the
// live drawing assumes, and the live beat detector's threshold (sd multiples) / refractory (s).
const KINDS = new Map<string, KindInfo>()
KINDS.set('ecg', new KindInfo(35, 'recordEcg', 'ecg', ['v8'], 256, 3, 0.3, 0.5))
KINDS.set('ppg', new KindInfo(35, 'recordPpg', 'ppg', ['v8', 'halo'], 50, 0.5, 0.4, 0.5))

// Shared copy first, then each kind's own. Every tt.* the template uses must exist in both
// languages for both kinds. The source spread COMMON into each per-kind table; the flattened
// copies below carry the same keys verbatim (COMMON first, per-kind keys after).
const ECG_ZH : UTSJSONObject = {
  connecting: '正在连接设备…',
  saving: '正在分析…',
  stopEarly: '提前结束',
  packets: '数据包',
  beatsLive: '心搏',
  beats: '有效心搏',
  rrMedian: '间期中位 ms',
  rrSd: '间期波动 ms',
  duration: '时长',
  done: '完成',
  retry: '重新记录',
