  failTooShortBody: 'The device stopped sending data. Check it is worn properly and retry.',
} as UTSJSONObject

// Holder for the record's early-stop callback (a function value kept off the reactive data tree).
class StopHandle {
  fn : (() => void) | null = null
}

// 'x3' is the pre-rename Halo brand value still in old bindings (§18).
function _normalizeBrand(b : string) : string {
  const v = b.toLowerCase()
  return v == 'x3' ? 'halo' : v
}

// The sheet is full-width with 32rpx side padding, so the canvas is windowWidth − 64rpx in px.
// Used when the layout query returns nothing (the canvas draws in CSS px, phones differ).
function _sheetInnerWidth() : number {
  try {
    const w = uni.getWindowInfo().windowWidth
    return Math.round(w - 64 * w / 750)
  } catch (e : any) { return 340 }
}

function _stripHeight(nSamples : number, rateHz : number) : number {
  const r = rateHz > 0 ? rateHz : 256
  return Math.max(1, Math.ceil(nSamples / Math.round(r * STRIP_ROW_SEC))) * STRIP_ROW_PX
}

// Each notification is timestamped on arrival, after its samples were collected. Trim the
// packet that crosses the five-second boundary too, so none of its settling samples are saved.
// Packets cross into this component as {packetId, samples, receivedAt} UTSJSONObjects.
function _trimSettlingPackets(packets : UTSJSONObject[], startedAt : number, rateHz : number) : UTSJSONObject[] {
  const cutoff = startedAt + STRIP_SETTLE_MS
  const sampleMs = 1000 / rateHz
  const kept : UTSJSONObject[] = []
  for (const p of packets) {
    const arr = p.getArray<number>('samples')
    if (arr == null) continue
    const samples = arr!
    const receivedAt = p.getNumber('receivedAt') ?? 0
    const packetStart = receivedAt - samples.length * sampleMs
    const drop = Math.max(0, Math.min(samples.length, Math.ceil((cutoff - packetStart) / sampleMs)))
    if (drop < samples.length) {
      if (drop > 0) {
        kept.push({ packetId: p.getNumber('packetId'), samples: samples.slice(drop), receivedAt: receivedAt } as UTSJSONObject)
      } else {
        kept.push(p)
      }
    }
  }
  return kept
}

function _pad2(n : number) : string {
  return n < 10 ? `0${n}` : `${n}`
}

function _whenLabel(iso : string) : string {
  if (iso.length == 0) return ''
  const d = new Date(iso)
  if (isNaN(d.getTime())) return ''
  return `${d.getFullYear()}-${_pad2(d.getMonth() + 1)}-${_pad2(d.getDate())} ${_pad2(d.getHours())}:${_pad2(d.getMinutes())}`
}

// Moving-average high-pass: v - mean(last w). The same baseline removal the strip page uses.
// (The source used q.push/q.shift; expressed here as a window start index — same result.)
function _highPass(a : number[], w : number) : number[] {
  const out : number[] = []
  let sum = 0.0
  for (let i = 0; i < a.length; i++) {
    sum += a[i]
    if (i >= w) sum -= a[i - w]
    const win = i + 1 < w ? i + 1 : w
    out.push(a[i] - sum / win)
  }
  return out
}

function _tail(a : number[], n : number) : number[] {
  if (a.length <= n) return a
  return a.slice(a.length - n)
}

function _v8PacketsToJSON(packets : V8StreamPacket[]) : UTSJSONObject[] {
  const out : UTSJSONObject[] = []
  for (const p of packets) out.push({ packetId: p.packetId, samples: p.samples, receivedAt: p.receivedAt } as UTSJSONObject)
  return out
}

function _haloPacketsToJSON(packets : PpgPacketRecord[]) : UTSJSONObject[] {
  const out : UTSJSONObject[] = []
  for (const p of packets) out.push({ packetId: p.packetId, samples: p.samples, receivedAt: p.receivedAt } as UTSJSONObject)
  return out
}

function _disconnectRing(ring : HaloRing | V8Band, brand : string) : void {
  // Fire-and-forget, like the miniapp's ring.disconnect().catch((): void => {}).
  if (brand == 'v8') {
    const band = ring as V8Band
    band!.disconnect().catch((e : any | null) => {})
  } else {
    const halo = ring as HaloRing
    halo!.disconnect().catch((e : any | null) => {})
  }
}

export default {
  name: 'StripRecord',
  props: {
    kind: { type: String, default: 'ecg' },
    open: { type: Boolean, default: false },
    userId: { type: String, default: '' },
    brand: { type: String, default: '' },
    deviceId: { type: String, default: '' },
    deviceName: { type: String, default: '' },
    lang: { type: String, default: 'zh' },
    theme: { type: String, default: 'dark' },
    // Viewing a stored strip: the host passes the health_events id and, in coach view, its
    // coach id (the server re-checks users.coach_id). readOnly hides delete.
    viewId: { type: Number, default: 0 },
    coachId: { type: String, default: '' },
    readOnly: { type: Boolean, default: false },
  },
  data() {
    return {
      t: ECG_ZH as UTSJSONObject,
      stage: 'idle' as string,        // idle | connecting | measuring | saving | result | failed | loading | view
      stripHeightPx: 160 as number,   // the stacked full-strip canvas grows with the recording length
      viewWhen: '' as string,
      remaining: 35 as number,
      packetCount: 0 as number,
      liveBeats: 0 as number,
      noSignal: false as boolean,
      result: null as UTSJSONObject | null,
      failTitle: '' as string,
      failBody: '' as string,
      // Result-block display strings (precomputed; the template cannot index UTSJSONObject):
      resBpm: '—' as string,
      resAcceptedBeats: '—' as string,
      resRrMedian: '—' as string,
      resRrSd: '—' as string,
      resDuration: '—' as string,
      // Non-reactive internals (same _-prefix data() idiom as coach.uvue):
      _samples: [] as number[],
      _packets: [] as UTSJSONObject[],   // {packetId, samples, receivedAt} rows
      _lastPacketAt: 0 as number,
      _countdown: 0 as number,
      _ring: null as HaloRing | V8Band | null,
      _ringBrand: '' as string,
      _stop: new StopHandle(),
    }
  },
  watch: {
    // The miniapp's observers were compound ('kind, lang' / 'open, viewId'); per-prop watchers
    // calling the same methods give the same outcome.
    kind(_nv : string) { this._applyLocale() },
    lang(_nv : string) { this._applyLocale() },
    open(_nv : boolean) { this._onOpenOrViewId() },
    viewId(_nv : number) { this._onOpenOrViewId() },
  },
  created() {
    // WeChat observers fire once at init with the current values — reproduce that here.
    this._applyLocale()
    this._onOpenOrViewId()
  },
  beforeUnmount() {
    this._teardown()
  },
  methods: {
    tt(key : string) : string { return tr(this.t, key) },

    statusText() : string {
      if (this.stage == 'connecting') return this.tt('connecting')
      if (this.stage == 'saving') return this.tt('saving')
      return this.noSignal ? this.tt('noSignal') : this.tt('measuring')
    },

    _kind() : KindInfo {
      const k = KINDS.get(this.kind)
      return k != null ? k! : (KINDS.get('ecg') as KindInfo)
    },

    _applyLocale() {
      const k = KINDS.has(this.kind) ? this.kind : 'ecg'
      this.t = (k == 'ecg' ? (this.lang == 'en' ? ECG_EN : ECG_ZH) : (this.lang == 'en' ? PPG_EN : PPG_ZH)) as UTSJSONObject
      this.remaining = this._kind().durationSec
    },

    _onOpenOrViewId() {
      if (!this.open) return
      const K = this._kind()
      this.stage = 'idle'
      this.result = null
      this.noSignal = false
      this.packetCount = 0
      this.liveBeats = 0
      this.remaining = K.durationSec
      if (this.viewId > 0) this._loadView(this.viewId)
    },

    handleClose() {
      if (this.stage == 'measuring') {
        const fn = this._stop.fn
        if (fn != null) fn!()
      }
      this._teardown()
      this.$emit('close')
    },

    handleStop() {
      const fn = this._stop.fn
      if (fn != null) fn!()
    },

    handleRetry() {
      if (this.viewId > 0) this._loadView(this.viewId)
      else this.handleStart()
    },

    async handleStart() {
      const K = this._kind()
      const brand = _normalizeBrand(this.brand)
      if (!K.brands.includes(brand) || this.deviceId.length == 0) {
        this.stage = 'failed'
        this.failTitle = this.tt('failUnsupported')
        this.failBody = ''
        return
      }
      this._samples = [] as number[]
      this._packets = [] as UTSJSONObject[]
      this._lastPacketAt = 0
      this.stage = 'connecting'
      this.packetCount = 0
      this.liveBeats = 0
      this.noSignal = false
      this.remaining = K.durationSec
      this.result = null

      // The installed transport (xapp-mini: WeChat's). Where none is installed (native, web), a
      // default one rejects with 'BLE transport not installed' → the failBle branch below.
      const installed = getInstalledBleTransport()
      const ring = createWearable(brand, installed != null ? installed! : new BleTransport())
      this._ring = ring
      this._ringBrand = brand
      try {
        // The BLE stack can sit in "connecting" indefinitely with the adapter off or the device
        // out of range (seen in the simulator: no adapter, no rejection). Cap it.
        // TODO(port): Promise.race typing in UTS — verify at compile; the settled-flag pattern
        // in utils/wearable/v8 recordPpg is the fallback.
        const connectP : Promise<void> = brand == 'v8'
          ? (ring as V8Band)!.connect(this.deviceId)
          : (ring as HaloRing)!.connect(this.deviceId)
        await new Promise<boolean>((resolve : (v : boolean) => void, reject : (e : any | null) => void) => {
          let settled = false
          setTimeout(() => {
            if (!settled) { settled = true; reject(new Error('connect timeout')) }
          }, CONNECT_TIMEOUT_MS)
          ;(async () : Promise<void> => {
            await connectP
            if (!settled) { settled = true; resolve(true) }
          })()
        })
      } catch (err : any) {
        console.log(JSON.stringify({ level: 'WARN', msg: `${this.kind} connect failed`, error: `${err}` } as UTSJSONObject))
        this._teardown()
        this.stage = 'failed'
        this.failTitle = this.tt('failBleTitle')
        this.failBody = this.tt('failBleBody')
        return
      }

      const startedAt = Date.now()
      this.stage = 'measuring'
      this._countdown = setInterval(() => {
        const left = Math.max(0, K.durationSec - Math.round((Date.now() - startedAt) / 1000))
        this.remaining = left
        this.noSignal = this._packets.length == 0 && Date.now() - startedAt > NO_SIGNAL_AFTER_MS
      }, 500)

      let capturePackets : UTSJSONObject[] = []
      let captureStartedAt = 0
      try {
        if (K.method == 'recordEcg') {
          const band = ring as V8Band
          const opts = new V8RecordOpts()
          opts.durationSec = K.durationSec
          opts.onPacket = (rec : V8StreamPacket) => { this._onPacket(rec.packetId, rec.samples, rec.receivedAt) }
          opts.onStopSignal = (fn : () => void) => { this._stop.fn = fn }
          const cap = await band!.recordEcg(opts)
          capturePackets = _v8PacketsToJSON(cap.packets)
          captureStartedAt = cap.startedAt
        } else if (brand == 'v8') {
          const band = ring as V8Band
          const opts = new V8RecordOpts()
          opts.durationSec = K.durationSec
          opts.onPacket = (rec : V8StreamPacket) => { this._onPacket(rec.packetId, rec.samples, rec.receivedAt) }
          opts.onStopSignal = (fn : () => void) => { this._stop.fn = fn }
          const cap = await band!.recordPpg(opts)
          capturePackets = _v8PacketsToJSON(cap.packets)
          captureStartedAt = cap.startedAt
        } else {
          const halo = ring as HaloRing
          const opts = new RecordPpgOpts()
          opts.durationSec = K.durationSec
          opts.onPacket = (rec : PpgPacketRecord) => { this._onPacket(rec.packetId, rec.samples, rec.receivedAt) }
          opts.onStopSignal = (fn : () => void) => { this._stop.fn = fn }
          const cap = await halo!.recordPpg(opts)
          capturePackets = _haloPacketsToJSON(cap.packets)
          captureStartedAt = cap.startedAt
        }
      } catch (err : any) {
        console.log(JSON.stringify({ level: 'WARN', msg: `${this.kind} record failed`, error: `${err}` } as UTSJSONObject))
        capturePackets = this._packets
        captureStartedAt = startedAt
      }
      if (this._countdown != 0) { clearInterval(this._countdown); this._countdown = 0 }
      this._stop.fn = null
      _disconnectRing(ring, brand)
      this._ring = null
      this._ringBrand = ''

      // Keep the live preview, but exclude the first five seconds from the saved waveform and
      // the server's analysis for both ECG and PPG.
      const startedForSave = captureStartedAt != 0 ? captureStartedAt : startedAt
      const savedPackets = _trimSettlingPackets(capturePackets, startedForSave, K.rateHz)
      if (savedPackets.length == 0) {
        this.stage = 'failed'
        this.failTitle = this.tt('failTooShortTitle')
        this.failBody = this.tt('failTooShortBody')
        return
      }
      this.stage = 'saving'
      await this._upload(savedPackets, startedForSave + STRIP_SETTLE_MS, brand)
    },

    _onPacket(packetId : number, samples : number[], receivedAt : number) {
      const rate = this._kind().rateHz
      this._packets.push({ packetId: packetId, samples: samples, receivedAt: receivedAt } as UTSJSONObject)
      for (const v of samples) this._samples.push(v)
      const keep = rate * (LIVE_WINDOW_SEC + 2)
      if (this._samples.length > keep) this._samples.splice(0, this._samples.length - keep)
      const now = Date.now()
      if (now - this._lastPacketAt > 300) {
        this._lastPacketAt = now
        this.packetCount = this._packets.length
        this.liveBeats = this._countLiveBeats()
        this.noSignal = false
        this._drawLive()
      }
    },

    // A cheap running beat count for the live meta line only: local maxima of the
    // baseline-removed signal above K.liveSd sd, K.liveRefractoryS apart. The server's detector
    // is the real one.
    _countLiveBeats() : number {
      const K = this._kind()
      const x = this._samples
      if (x.length < K.rateHz * 2) return 0
      const hp = _highPass(x, Math.round(K.rateHz * K.liveHighPassS))
      if (hp.length == 0) return 0
      let mean = 0.0
      for (const v of hp) mean += v
      mean /= hp.length
      let sd = 0.0
      for (const v of hp) sd += (v - mean) * (v - mean)
      sd = Math.sqrt(sd / hp.length)
      if (sd == 0) sd = 1
      const refractory = Math.round(K.rateHz * K.liveRefractoryS)
      let n = 0
      let last = -refractory
      for (let i = 1; i < hp.length - 1; i++) {
        if (hp[i] > mean + K.liveSd * sd && hp[i] >= hp[i - 1] && hp[i] > hp[i + 1] && i - last > refractory) {
          n++
          last = i
        }
      }
      return n
    },

    // uni-app x canvas: web-standard UniCanvasElement via uni.getElementById (App-Android 3.91+),
    // then getContext('2d'). The miniapp's legacy wx.createCanvasContext + ctx.draw() flush is
    // gone — uni-app x paints immediately.
    _getCtx(id : string, cb : (ctx : CanvasRenderingContext2D) => void) {
      const el = uni.getElementById(id)
      if (el == null) return
      const ctx = (el as UniCanvasElement).getContext('2d')
      if (ctx == null) return
      cb(ctx!)
    },

    _drawLive() {
      const K = this._kind()
      const x = this._samples
      if (x.length == 0) return
      const W = _sheetInnerWidth()
      const H = 160
      this._getCtx('strip-live', (ctx : CanvasRenderingContext2D) => {
        // Paper grid: 0.2 s squares over a 4 s window.
        ctx.fillStyle = '#fbf5f4'
        ctx.fillRect(0, 0, W, H)
        ctx.strokeStyle = '#f0cfcc'
        ctx.lineWidth = 1
        for (let gx = 0; gx <= W; gx += W / 20) {
          ctx.beginPath(); ctx.moveTo(gx, 0); ctx.lineTo(gx, H); ctx.stroke()
        }
        for (let gy = 0; gy <= H; gy += H / 8) {
          ctx.beginPath(); ctx.moveTo(0, gy); ctx.lineTo(W, gy); ctx.stroke()
        }
        const win = _tail(x, Math.round(K.rateHz * LIVE_WINDOW_SEC))
        const hp = _highPass(win, Math.round(K.rateHz * K.liveHighPassS))
        const sorted = hp.slice()
        sorted.sort((a : number, b : number) : number => a - b)
        const lo = sorted[Math.floor(sorted.length * 0.02)]
        const hi = sorted[Math.floor(sorted.length * 0.98)]
        const rng = (hi - lo) != 0 ? (hi - lo) : 1
        ctx.strokeStyle = '#1a1d21'
        ctx.lineWidth = 1.5
        ctx.beginPath()
        for (let i = 0; i < hp.length; i++) {
          const px = i / (K.rateHz * LIVE_WINDOW_SEC) * W
          const py = H - 8 - (Math.min(hi, Math.max(lo, hp[i])) - lo) / rng * (H - 16)
          if (i == 0) ctx.moveTo(px, py); else ctx.lineTo(px, py)
        }
        ctx.stroke()
      })
    },

    // A stored strip: summary from the row, waveform + peaks from OSS via the worker.
    async _loadView(id : number) {
      const K = this._kind()
      this.stage = 'loading'
      try {
        const coach = this.coachId.length > 0 ? `&coach_id=${encodeURIComponent(this.coachId)}` : ''
        const res = await getBody(`${BASE}/api/${K.path}/${id}/waveform?openid=${encodeURIComponent(this.userId)}${coach}`)
        const ok = res != null && res!.getBoolean('success') == true
        let row : UTSJSONObject | null = null
        if (ok) {
          row = res!.getJSON(K.path)
          if (row == null) row = res!.getJSON('ecg')
        }
        const samples = res != null ? res!.getArray<number>('samples') : null
        if (row == null || samples == null) {
          throw new Error(res != null ? (res!.getString('error') ?? 'load failed') : 'load failed')
        }
        if (this.viewId != id || !this.open) return
        const peaks = res!.getArray<number>('peaks') ?? ([] as number[])
        const rateNum = row!.getNumber('sample_rate_hz')
        const rate = rateNum != null && rateNum! > 0 ? rateNum! : K.rateHz
        this.stage = 'view'
        this.result = row
        this.viewWhen = _whenLabel(row!.getString('recorded_at') ?? '')
        this.stripHeightPx = _stripHeight(samples!.length, rate)
        this._fillResultFields(row!)
        this.$nextTick(() => { this._drawStrip(samples!, peaks, rate) })
      } catch (e : any) {
        this.stage = 'failed'
        this.failTitle = this.tt('failLoadTitle')
        this.failBody = this.tt('failLoadBody')
      }
    },

    // Template cannot read result.* directly (UTSJSONObject) — mirror the four grid cells + the
    // hero bpm into plain strings when a result/view row arrives.
    _fillResultFields(row : UTSJSONObject) {
      const bpm = row.getNumber('bpm')
      const acc = row.getNumber('accepted_beats')
      const rrMed = row.getNumber('rr_median_ms')
      const rrSd = row.getNumber('rr_sd_ms')
      const dur = row.getNumber('duration_seconds')
      this.resBpm = bpm != null ? `${bpm!}` : '—'
      this.resAcceptedBeats = acc != null ? `${acc!}` : '—'
      this.resRrMedian = rrMed != null ? `${rrMed!}` : '—'
      this.resRrSd = rrSd != null ? `${rrSd!}` : '—'
      this.resDuration = dur != null ? `${dur!}s` : '—'
    },

    handleDelete() {
      const id = this.viewId
      if (id <= 0 || this.readOnly) return
      const K = this._kind()
      uni.showModal({
        title: '', content: this.tt('deleteConfirm'), confirmColor: '#e0565b',
        success: (r : ShowModalSuccess) => {
          if (!r.confirm) return
          deleteBody(`${BASE}/api/${K.path}/${id}?openid=${encodeURIComponent(this.userId)}`, null)
            .then((res : UTSJSONObject | null) => {
              const ok = res != null && res!.getBoolean('success') == true
              if (!ok) throw new Error('delete failed')
              this.$emit('deleted', { id: id, kind: this.kind } as UTSJSONObject)
              this.handleClose()
            })
            .catch((e : any | null) => {
              uni.showToast({ title: this.tt('deleteFailed'), icon: 'none' })
            })
        },
      })
    },

    // The whole strip on paper, printed-ECG style: rows of STRIP_ROW_SEC each, one scale for
    // every row, server-detected peaks ticked along the top of each row. Width is measured
    // from the layout because the canvas draws in CSS px and phones differ.
    _drawStrip(samples : number[], peaks : number[], rateHz : number) {
      if (samples.length == 0) return
      const rate = Math.round(rateHz > 0 ? rateHz : this._kind().rateHz)
      const perRow = Math.round(rate * STRIP_ROW_SEC)
      const nRows = Math.max(1, Math.ceil(samples.length / perRow))
      const H = nRows * STRIP_ROW_PX
      this._getCtx('strip-strip', (ctx : CanvasRenderingContext2D) => {
          // The canvas element's own width replaces the miniapp's measured boundingClientRect.
          const el = uni.getElementById('strip-strip')
          const measured = el != null ? (el as UniCanvasElement).width : 0
          const W = measured > 0 ? measured : _sheetInnerWidth()
          ctx.fillStyle = '#fbf5f4'
          ctx.fillRect(0, 0, W, H)
          ctx.lineWidth = 1
          ctx.strokeStyle = '#f0cfcc'
          const gxStep = W / (STRIP_ROW_SEC * 5) // 0.2 s squares
          for (let x = 0; x <= W; x += gxStep) {
            ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke()
          }
          for (let y = 0; y <= H; y += STRIP_ROW_PX / 4) {
            ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke()
          }
          ctx.strokeStyle = '#e3b3af'
          for (let r = 1; r < nRows; r++) {
            ctx.beginPath(); ctx.moveTo(0, r * STRIP_ROW_PX); ctx.lineTo(W, r * STRIP_ROW_PX); ctx.stroke()
          }
          const hp = _highPass(samples, Math.round(rate / 2))
          const sorted = hp.slice()
          sorted.sort((a : number, b : number) : number => a - b)
          const lo = sorted[Math.floor(sorted.length * 0.02)]
          const hi = sorted[Math.floor(sorted.length * 0.98)]
          const rng = (hi - lo) != 0 ? (hi - lo) : 1
          ctx.strokeStyle = '#1a1d21'
          ctx.lineWidth = 1.2
          ctx.beginPath()
          let lastRow = -1
          for (let i = 0; i < hp.length; i++) {
            const row = Math.floor(i / perRow)
            const px = (i % perRow) / perRow * W
            const py = row * STRIP_ROW_PX + STRIP_ROW_PX - 6 - (Math.min(hi, Math.max(lo, hp[i])) - lo) / rng * (STRIP_ROW_PX - 14)
            if (row != lastRow) { ctx.moveTo(px, py); lastRow = row } else { ctx.lineTo(px, py) }
          }
          ctx.stroke()
          if (peaks.length > 0) {
            ctx.fillStyle = '#1fb7a6'
            for (const p of peaks) {
              if (!(p >= 0 && p < hp.length)) continue
              const row = Math.floor(p / perRow)
              const px = (p % perRow) / perRow * W
              ctx.fillRect(px - 1, row * STRIP_ROW_PX + 2, 2, 6)
            }
          }
        })
    },

    async _upload(packets : UTSJSONObject[], startedAt : number, brand : string) {
      const K = this._kind()
      const body = {
        openid: this.userId,
        brand: brand,
        device_name: this.deviceName.length > 0 ? this.deviceName : null,
        duration_seconds: K.durationSec - STRIP_SETTLE_MS / 1000,
        started_at: startedAt,
        packets: packets,   // already {packetId, samples, receivedAt} rows — the source's map() shape
      } as UTSJSONObject
      let res : UTSJSONObject | null = null
      try {
        res = await postBody(`${BASE}/api/${K.path}`, body)
      } catch (err : any) {
        this.stage = 'failed'
        this.failTitle = this.tt('failUploadTitle')
        this.failBody = this.tt('failUploadBody')
        return
      }
      if (res == null) {
        // network failure — the miniapp's _req rejected here
        this.stage = 'failed'
        this.failTitle = this.tt('failUploadTitle')
        this.failBody = this.tt('failUploadBody')
        return
      }
      const ok = res!.getBoolean('success') == true
      const row = ok ? res!.getJSON(K.path) : null
      if (row != null) {
        // The result block mounts its own <canvas>; draw once it has rendered,
        // not synchronously — the node does not exist yet at this line.
        const all : number[] = []
        for (const p of packets) {
          const s = p.getArray<number>('samples')
          if (s != null) for (const v of s!) all.push(v)
        }
        const rateNum = row!.getNumber('sample_rate_hz')
        const rate = rateNum != null && rateNum! > 0 ? rateNum! : K.rateHz
        this.stage = 'result'
        this.result = row
        this.stripHeightPx = _stripHeight(all.length, rate)
        this._fillResultFields(row!)
        this.$nextTick(() => { this._drawStrip(all, [] as number[], rate) })
        const payload = new UTSJSONObject()
        payload['kind'] = this.kind
        payload[K.path] = row   // {kind, ecg|ppg: row} — same dynamic detail key as the source
        this.$emit('saved', payload)
        return
      }
      const reason = res!.getString('reason')
      if (reason == 'poor_contact') {
        this.stage = 'failed'; this.failTitle = this.tt('failPoorContactTitle'); this.failBody = this.tt('failPoorContactBody')
      } else if (reason == 'too_short') {
        this.stage = 'failed'; this.failTitle = this.tt('failTooShortTitle'); this.failBody = this.tt('failTooShortBody')
      } else if (reason == 'unsupported_brand') {
        this.stage = 'failed'; this.failTitle = this.tt('failUnsupported'); this.failBody = ''
      } else {
        this.stage = 'failed'
        this.failTitle = this.tt('failUploadTitle')
        const err = res!.getString('error')
        this.failBody = err != null ? err : this.tt('failUploadBody')
      }
    },

    _teardown() {
      if (this._countdown != 0) { clearInterval(this._countdown); this._countdown = 0 }
      const ring = this._ring
      if (ring != null) {
        _disconnectRing(ring!, this._ringBrand)
        this._ring = null
        this._ringBrand = ''
      }
      this._stop.fn = null
    },
  }
}
</script>

<style>
/* Structural port of strip-record.wxss — dark by default like the health tab; the light theme
   is applied on this component's own root because the host page's theme class does not cross
   the component boundary. Palette per the xapp port rules (#0B1C2E bg, #12283F sheet,
   #2E7CF6 accent); the ECG-paper and trace colors are functional and kept from the source
   drawing code. uni-app x CSS has no grid/env() — the result grid is a flex row and the
   safe-area bottom padding is dropped. */
.strip-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(4, 12, 24, 0.82);
  justify-content: flex-end;
  align-items: center;
  z-index: 900;
}
.strip-sheet {
  width: 100%;
  max-height: 700px;
  background-color: #12283F;
  border-top-left-radius: 16px;
  border-top-right-radius: 16px;
  padding: 14px 16px 20px 16px;
}
.strip-sheet-light {
  background-color: #FFFFFF;
}
.strip-head {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
}
.strip-title {
  font-size: 16px;
  font-weight: bold;
  color: #EAF2FB;
}
.strip-close {
  width: 28px;
  height: 28px;
  border-radius: 14px;
  background-color: rgba(255, 255, 255, 0.08);
  align-items: center;
  justify-content: center;
}
.strip-close-text {
  font-size: 13px;
  color: #EAF2FB;
}
.strip-block {
  flex-direction: column;
}
.strip-guide {
  flex-direction: column;
  align-items: center;
  padding: 12px 6px 16px 6px;
}
.strip-guide-glyph {
  font-size: 36px;
  line-height: 1;
  margin-bottom: 4px;
  color: #EAF2FB;
}
.strip-guide-line {
  font-size: 14px;
  line-height: 1.5;
  color: #EAF2FB;
  margin-bottom: 6px;
  text-align: center;
}
.strip-guide-muted {
  font-size: 12px;
  opacity: 0.6;
}
.strip-btn {
  margin-top: 8px;
  padding-top: 11px;
  padding-bottom: 11px;
  border-radius: 24px;
  align-items: center;
}
.strip-btn-primary {
  background-color: #2E7CF6;
}
.strip-btn-ghost {
  background-color: rgba(0, 0, 0, 0);
  border: 1px solid rgba(255, 255, 255, 0.22);
}
.strip-btn-text {
  font-size: 14px;
  font-weight: 600;
  color: #EAF2FB;
}
.strip-btn-danger {
  border-color: rgba(224, 86, 91, 0.45);
}
.strip-footnote {
  margin-top: 9px;
  font-size: 11px;
  line-height: 1.5;
  opacity: 0.55;
  text-align: center;
  color: #EAF2FB;
}
.strip-status-row {
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 4px;
  margin-bottom: 8px;
}
.strip-status {
  font-size: 14px;
  font-weight: 600;
  color: #EAF2FB;
}
.strip-countdown {
  font-size: 18px;
  font-weight: bold;
  color: #2E7CF6;
}
.strip-canvas-wrap {
  width: 100%;
  height: 160px;
  border-radius: 8px;
  overflow: hidden;
  background-color: #fbf5f4;
}
.strip-canvas {
  width: 100%;
  height: 160px;
}
.strip-strip-canvas {
  height: auto;
}
.strip-meta-row {
  flex-direction: row;
  margin-top: 6px;
}
.strip-meta {
  font-size: 11px;
  opacity: 0.65;
  color: #EAF2FB;
  margin-right: 16px;
}
.strip-result-hero {
  flex-direction: row;
  align-items: flex-end;
  justify-content: center;
  margin-top: 4px;
  margin-bottom: 10px;
}
.strip-bpm {
  font-size: 48px;
  font-weight: bold;
  line-height: 1;
  color: #2E7CF6;
}
.strip-bpm-unit {
