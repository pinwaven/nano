.ag-empty-hint { font-size: var(--fs-22, 22rpx); line-height: 1.6; }
.ag-doc-name { font-size: var(--fs-26, 26rpx); }
.ag-doc-badge { font-size: var(--fs-20, 20rpx); }
.ag-doc-sub { font-size: var(--fs-21, 21rpx); }
.ag-doc-del { font-size: var(--fs-23, 23rpx); }
.ag-chip, .ag-chip-txt { font-size: var(--fs-23, 23rpx); }
.ag-input { font-size: var(--fs-25, 25rpx); line-height: 1.6; }
.ag-submit, .ag-submit-txt { font-size: var(--fs-27, 27rpx); }
.ag-note { font-size: var(--fs-21, 21rpx); }
.ag-pill { font-size: var(--fs-20, 20rpx); }
.ag-job-date { font-size: var(--fs-21, 21rpx); }
.ag-job-cmd { font-size: var(--fs-25, 25rpx); }
.ag-job-note { font-size: var(--fs-22, 22rpx); line-height: 1.5; }
.ag-sheet-close { font-size: var(--fs-30, 30rpx); }
.ag-sheet-date { font-size: var(--fs-21, 21rpx); }
.ag-sheet-cmd { font-size: var(--fs-26, 26rpx); }
.ag-sheet-body { font-size: var(--fs-25, 25rpx); line-height: 1.75; }
.ag-sheet-btn, .ag-sheet-btn-txt { font-size: var(--fs-26, 26rpx); }
.ag-file-ext { font-size: var(--fs-18, 18rpx); }
