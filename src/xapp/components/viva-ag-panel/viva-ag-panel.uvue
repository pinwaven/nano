.theme-light .ag-chip-on { background: rgba(var(--blue-rgb), 0.18); border-color: rgba(var(--blue-rgb), 0.5); }
.theme-light .ag-input { background: rgba(var(--blue-rgb), 0.07); color: var(--wave, #A6C4E5); }
.theme-light .ag-input-ph { color: rgba(var(--wave-rgb), 0.35); }
.theme-light .ag-submit { background: rgba(var(--blue-rgb), 0.85); }
