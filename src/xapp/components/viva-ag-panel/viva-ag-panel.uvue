.theme-light .ag-sheet-btn { background: rgba(var(--blue-rgb), 0.85); }
.theme-light .ag-sheet-btn-ghost { border: 1rpx solid rgba(var(--wave-rgb), 0.2); color: rgba(var(--wave-rgb), 0.6); }
.theme-light .ag-file-chip { background: rgba(var(--blue-rgb), 0.14); }
.theme-light .ag-file-name { color: rgba(var(--wave-rgb), 0.7); }
.theme-light .ag-filelist-title { color: rgba(var(--wave-rgb), 0.45); }
.theme-light .ag-file-row { background: rgba(var(--blue-rgb), 0.1); }
.theme-light .ag-file-row-name { color: var(--wave, #A6C4E5); }
.theme-light .ag-file-row-size { color: rgba(var(--wave-rgb), 0.4); }
.theme-light .ag-viewer-head { border-bottom: 1rpx solid rgba(var(--blue-rgb), 0.12); }
.theme-light .ag-viewer-title { color: var(--wave, #A6C4E5); }
.theme-light .ag-viewer-close { color: rgba(var(--wave-rgb), 0.5); }
.theme-light .ag-viewer-body { color: var(--steel); }
.theme-light .ag-viewer-trunc { color: rgba(var(--wave-rgb), 0.4); }
.theme-light .ag-ask { background: rgba(var(--wave-rgb), 0.10); border-left: 6rpx solid var(--gold); }
.theme-light .ag-ask-title { color: var(--text); }
.theme-light .ag-ask-body { color: var(--text-muted); }
.theme-light .ag-ask-deadline { color: var(--text-muted); }
.theme-light .ag-ask-cta { background: rgba(var(--blue-rgb), 0.85); }
