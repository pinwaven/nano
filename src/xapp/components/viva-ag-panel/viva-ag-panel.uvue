.theme-light .ag-job { border-bottom: 1rpx solid rgba(var(--blue-rgb), 0.06); }
.theme-light .ag-pill { background: rgba(var(--blue-rgb), 0.14); }
.theme-light .ag-pill-cancelled { background: rgba(var(--wave-rgb), 0.12); color: rgba(var(--wave-rgb), 0.5); }
.theme-light .ag-pill-awaiting_input { background: rgba(var(--wave-rgb), 0.18); color: var(--gold); }
.theme-light .ag-job-date { color: rgba(var(--wave-rgb), 0.4); }
.theme-light .ag-job-cmd { color: var(--wave, #A6C4E5); }
.theme-light .ag-job-note { color: rgba(var(--wave-rgb), 0.45); }
.theme-light .ag-sheet-close { color: rgba(var(--wave-rgb), 0.5); }
