.theme-light .ag-pill-processing, .theme-light .ag-pill-claimed { color: #B45309; }
.theme-light .ag-pill-completed { color: #0A7350; }
.theme-light .ag-pill-failed { color: #C0392B; }
.theme-light .ag-file-chip,
.theme-light .ag-file-row { background: rgba(41, 66, 229, 0.08); }
.theme-light .ag-file-ext,
.theme-light .ag-file-row-go { color: #2942E5; }
.theme-light .ag-file-name,
.theme-light .ag-file-row-name { color: #14243D; }
.theme-light .ag-viewer { background: #FBF8F2; }
.theme-light .ag-viewer-title { color: #14243D; }
.theme-light .ag-viewer-body { color: #35485F; }
.theme-light .ag-ask { background: rgba(var(--wave-rgb), 0.08); border-left-color: var(--gold); }
.theme-light .ag-fm { background: rgba(0, 0, 0, 0.03); border-left-color: rgba(0, 0, 0, 0.15); }
.theme-light .ag-fm-rationale { border-top-color: rgba(0, 0, 0, 0.08); }
.theme-light .ag-fm-valid { border-left-color: var(--gold); }
.theme-light .ag-fm-approved { border-left-color: var(--success); }
.theme-light .ag-fm-committed { border-left-color: var(--success); }
.theme-light .ag-fm-invalid { border-left-color: var(--danger); }
.theme-light .ag-fm-rejected { border-left-color: var(--danger); }
/* Text the miniapp colours by inheritance (xapp's <text> inherits nothing): tools/xapp-mini/style-gen/lightinherit.js */
.theme-light .ag-sheet-btn-txt-ghost { color: rgba(var(--wave-rgb), 0.6); }
/* Modifiers and variable colours the first lightvars.js pass left out (they sit after the base rules they refine): */
.theme-light .ag-doc-del { color: #E05C5C; }
.theme-light .ag-sheet-btn-ghost { background: transparent; border: 1rpx solid rgba(var(--wave-rgb), 0.2); color: rgba(var(--wave-rgb), 0.6); }
.theme-light .ag-ask-cta { background: rgba(var(--blue-rgb), 0.85); color: #fff; }
/* #endif */
/* #ifdef MP-WEIXIN */
/* Text size (菜单 › 字体大小), from the miniapp's stylesheet: every rule of its whose font-size reads
   var(--fs-N), with the line-height it declares. The variables come from App.uvue's copy of app.wxss,
   rescaled under the page's .fs-1/.fs-2/.fs-3, and inherit into components; this file's own px sizes
   never would. Regenerate (tools/xapp-mini/style-gen: fsvars.js, then fsinherit.js) when the miniapp's sizes change. */
.ag-hero-badge text { font-size: var(--fs-20, 20rpx); }
.ag-hero-desc { font-size: var(--fs-25, 25rpx); line-height: 1.6; }
.ag-hero-expiry { font-size: var(--fs-22, 22rpx); }
