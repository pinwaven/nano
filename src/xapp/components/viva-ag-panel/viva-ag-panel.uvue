.ag-viewer-close { font-size: var(--fs-30, 30rpx); }
.ag-viewer-body { font-size: var(--fs-26, 26rpx); line-height: 1.75; }
.ag-viewer-trunc { font-size: var(--fs-21, 21rpx); line-height: 1.6; }
.ag-ask-title { font-size: var(--fs-27, 27rpx); }
