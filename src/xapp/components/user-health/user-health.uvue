// The four Digital Twin layers (AGENTS §34). Deliberately NOT the five health_events
// categories — those are all wearable-derived and know nothing about Kino or the profile.
const TWIN_LAYER_KEYS : string[] = ['precision', 'daily', 'medical', 'profile']
const TWIN_LAYER_LABELS_ZH : UTSJSONObject = { precision: '精准检测', daily: '日常监测', medical: '医疗记录', profile: '个人档案' } as UTSJSONObject
const TWIN_LAYER_LABELS_EN : UTSJSONObject = { precision: 'Precision Testing', daily: 'Daily Monitoring', medical: 'Medical Records', profile: 'Personal Profile' } as UTSJSONObject

// ── module helpers ──────────────────────────────────────────────────────────

function tOf(lang : string | null) : UTSJSONObject {
  return (lang != null && lang! == 'en') ? T_EN : T_ZH
}
function tk(t : UTSJSONObject, section : string, key : string | null) : string {
  if (key == null) return ''
  const m = t.getJSON(section)
  if (m == null) return key!
  const v = m!.getString(key!)
  return v != null ? v : key!
}
function tnum(t : UTSJSONObject, key : string) : string {
  const v = t.getString(key)
  return v != null ? v : key
}
function tarr(t : UTSJSONObject, section : string, idx : number) : string {
  const a = t.getArray<string>(section)
  if (a == null || idx < 0 || idx >= a!.length) return ''
  return a![idx]
}

function _pad2n(n : number) : string { return n < 10 ? `0${n}` : `${n}` }
function _pad3n(n : number) : string {
  if (n < 10) return `00${n}`
  if (n < 100) return `0${n}`
  return `${n}`
}

// Thousands separator (UTS Number has no toLocaleString; miniapp used
// avg_daily_steps.toLocaleString()).
function toLocaleInt(n : number) : string {
  const s = `${Math.round(n)}`
  const neg = s.startsWith('-')
  const digits = neg ? s.substring(1) : s
  let out = ''
  for (let i = 0; i < digits.length; i++) {
    if (i > 0 && (digits.length - i) % 3 == 0) out += ','
    out += digits.charAt(i)
  }
  return (neg ? '-' : '') + out
}

// epoch ms → 'YYYY-MM-DD' on the +08:00 calendar (civil_from_days, same as utils/wearable/sync.uts)
function _civilFromDays(z0 : number) : number[] {
  const z = z0 + 719468
  const era = Math.floor((z >= 0 ? z : z - 146096) / 146097)
  const doe = z - era * 146097
  const yoe = Math.floor((doe - Math.floor(doe / 1460) + Math.floor(doe / 36524) - Math.floor(doe / 146096)) / 365)
  const y = yoe + era * 400
  const doy = doe - (365 * yoe + Math.floor(yoe / 4) - Math.floor(yoe / 100))
  const mp = Math.floor((5 * doy + 2) / 153)
  const d = doy - Math.floor((153 * mp + 2) / 5) + 1
  const m = mp < 10 ? mp + 3 : mp - 9
  return [m <= 2 ? y + 1 : y, m, d]
}

const CST_MS = 8 * 60 * 60 * 1000

function _shanghaiDateStr(ms : number) : string {
  const days = Math.floor((ms + CST_MS) / 86400000)
  const ymd = _civilFromDays(days)
  return `${ymd[0]}-${_pad2n(ymd[1])}-${_pad2n(ymd[2])}`
}

// Converts any timestamp to epoch millis. 'YYYY-MM-DD HH:MM:SS' strings are ring CST times →
// treated as +08:00 (the miniapp relied on JS Date's CST-only parsing for these); ISO strings
// with a timezone go through Date as-is; numbers pass through.
function _toMs(v : any | null) : number {
  if (v == null) return NaN
  if (typeof v == 'number') return v as number
  const s = `${v}`
  if (s.length == 0) return NaN
  const asNum = parseFloat(s)
  if (!isNaN(asNum) && s.indexOf('-') == -1 && s.indexOf(':') == -1) return asNum
  try {
    if (s.indexOf(' ') != -1 && s.indexOf('T') == -1) {
      // bare CST datetime string — append the offset before parsing
      const ms = new Date(s.replace(' ', 'T') + '+08:00').getTime()
      if (ms > 0) return ms
    }
    return new Date(s).getTime()
  } catch (e : any) {
    return NaN
  }
}

// epoch millis → true-UTC ISO 'YYYY-MM-DDTHH:mm:ss.sssZ' (UTS Date.toISOString unverified)
function _isoUtcFromMs(ms : number) : string {
  const days = Math.floor(ms / 86400000)
  const rem = ms - days * 86400000
  const h = Math.floor(rem / 3600000)
  const mi = Math.floor((rem % 3600000) / 60000)
  const s = Math.floor((rem % 60000) / 1000)
  const mss = rem % 1000
  const ymd = _civilFromDays(days)
  return `${ymd[0]}-${_pad2n(ymd[1])}-${_pad2n(ymd[2])}T${_pad2n(h)}:${_pad2n(mi)}:${_pad2n(s)}.${_pad3n(mss)}Z`
}

// Converts any timestamp (Unix ms or ISO string) to Shanghai (UTC+8) HH:MM string
function _shanghaiTimeStr(t : any | null) : string {
  const ms = _toMs(t)
  const base = isNaN(ms) ? Date.now() : ms
  const shifted = base + CST_MS
  const h = Math.floor((shifted % 86400000) / 3600000)
  const mi = Math.floor((shifted % 3600000) / 60000)
  return `${_pad2n(h)}:${_pad2n(mi)}`
}

// Returns the Shanghai (UTC+8) hour (0–23) from any timestamp or ISO string
function _shanghaiHour(t : any | null) : number {
  const ms = _toMs(t)
  const shifted = (isNaN(ms) ? Date.now() : ms) + CST_MS
  return Math.floor((shifted % 86400000) / 3600000)
}

function _fmtMinOfDay(mins : number) : string {
  const a = ((mins % 1440) + 1440) % 1440
  return `${_pad2n(Math.floor(a / 60))}:${_pad2n(a % 60)}`
}

function _mds(dateStr : string | null) : string {
  if (dateStr == null) return ''
  return dateStr!.substring(5).replace('-', '/')
}

function _maxOf(arr : number[]) : number {
  let m = arr.length > 0 ? arr[0] : 0
  for (const v of arr) if (v > m) m = v
  return m
}
function _minOf(arr : number[]) : number {
  let m = arr.length > 0 ? arr[0] : 0
  for (const v of arr) if (v < m) m = v
  return m
}

function _hex(n : number) : string {
  const digits = '0123456789abcdef'
  const hi = Math.floor(n / 16) % 16
  const lo = n % 16
  return `${digits[hi]}${digits[lo]}`
}

// #rrggbb → [r,g,b] without bitwise ops
function _hexRgb(hex : string | null) : number[] {
  if (hex == null || !hex!.startsWith('#')) return [99, 117, 236]
  const n = parseInt(hex!.replace('#', ''), 16)
  if (isNaN(n)) return [99, 117, 236]
  return [Math.floor(n / 65536) % 256, Math.floor(n / 256) % 256, n % 256]
}

// --- Sleep session helpers (shared by BLE-live sync, server hydration, and display prep) ---
// A "night" session starts in the 20:00–05:59 window; anything starting 06:00–19:59
// is a daytime nap. onset is a "YYYY-MM-DD HH:MM:SS" string.
function _isNightSession(onset : string) : boolean {
  const hour = parseInt(onset.substring(11, 13))
  return hour >= 20 || hour < 6
}

// Minutes since the most recent noon (0 = noon, 720 = midnight, 1439 = 11:59am next day).
// Matches the noon-to-noon "night" bucket used by halo/index.uts's _nightKey.
function _minutesSinceNoon(onset : string) : number {
  const hour = parseInt(onset.substring(11, 13))
  const min = parseInt(onset.substring(14, 16))
  let mins = hour * 60 + min - 12 * 60
  if (mins < 0) mins += 1440
  return mins
}

// A long wake-up in the middle of the night splits one night's sleep into multiple discrete
// session records (see SPLIT_GAP_MINS in halo/index.uts). Merges them into a single aggregate
// for the "Last Night" card, inserting a synthetic awake slot for the gap so the stage bar
// shows the time spent awake between segments instead of silently skipping it. (§9 invariant)
function _mergeNightSessions(sessions : UTSJSONObject[]) : UTSJSONObject {
  const ordered = sessions.slice(0).sort((a, b) : number => (sget(a, 'onset') < sget(b, 'onset') ? -1 : 1))
  const first = ordered[0]
  const last = ordered[ordered.length - 1]
  let totalMinutes = 0, deep = 0, light = 0, rem = 0, awake = 0
  const slots : UTSJSONObject[] = []
  let prevEndMins : number | null = null
  for (const s of ordered) {
    totalMinutes += s.getNumber('totalMinutes') ?? 0
    deep += s.getNumber('deep') ?? 0
    light += s.getNumber('light') ?? 0
    rem += s.getNumber('rem') ?? 0
    awake += s.getNumber('awake') ?? 0
    const onset = s.getString('onset')
    if (onset != null) {
      const startMins = _minutesSinceNoon(onset!)
      if (prevEndMins != null && startMins > prevEndMins!) {
        slots.push({ type: 'awake', min: startMins - prevEndMins! } as UTSJSONObject)
      }
      prevEndMins = startMins + (s.getNumber('totalMinutes') ?? 0)
    }
    const sSlots = s.getArray<UTSJSONObject>('slots')
    if (sSlots != null && sSlots!.length > 0) {
      for (const sl of sSlots!) slots.push(sl)
    }
  }
  const out = {
    date: first.getString('date'), onset: first.getString('onset'),
    totalMinutes: totalMinutes, deep: deep, light: light, rem: rem, awake: awake,
    sleepStart: first.getNumber('sleepStart'), sleepEnd: last.getNumber('sleepEnd'),
    slots: slots.length > 0 ? slots : null,
  } as UTSJSONObject
  return out
}

// Picks the most recent night's session(s) from a sleepHistory array (oldest first, each with
// a `date` = noon-to-noon night bucket) and merges them so a wake-interrupted night is one
// session. `_isNightSession` only picks WHICH date bucket is "last night" (so a trailing
// daytime nap doesn't take it over) — once chosen, every session sharing that bucket merges
// in, since a segment resumed after 6am still classifies as a "nap" by the hour heuristic
// though it continues the same night (noon-to-noon bucketing, halo/index.uts _nightKey).
// Falls back to the single most recent session if no night session exists yet.
function _selectLastNight(sleepHistory : UTSJSONObject[]) : UTSJSONObject | null {
  if (sleepHistory.length == 0) return null
  const nightSessions = sleepHistory.filter((s) : boolean => {
    const onset = s.getString('onset')
    return onset != null && _isNightSession(onset!)
  })
  if (nightSessions.length == 0) return sleepHistory[sleepHistory.length - 1]
  let lastDate = sget(nightSessions[0], 'date')
  for (const s of nightSessions) {
    if (sget(s, 'date') > lastDate) lastDate = sget(s, 'date')
  }
  const group = sleepHistory.filter((s) : boolean => sget(s, 'date') == lastDate)
  return group.length > 1 ? _mergeNightSessions(group) : group[0]
}

function _dayQualityColor(totalMinutes : number) : string {
  return totalMinutes >= 420 ? '#10b981' : totalMinutes >= 360 ? '#0ea5e9' : totalMinutes >= 300 ? '#f97316' : '#ef4444'
}

function _fmtHM(totalMinutes : number, isZh : boolean) : string {
  const h = Math.floor(totalMinutes / 60)
  const m = totalMinutes % 60
  if (isZh) return m > 0 ? `${h}时${m}分` : `${h}时`
  return m > 0 ? `${h}h ${m}m` : `${h}h`
}

// Reconstructs per-session sleep blocks from one health_events sleep row. Prefers the
// `sessions` array (added so distinct naps/night segments survive the per-date merge in
// sync.uts); falls back to synthesizing a single session from the older aggregate-only shape
// for rows synced before that change.
function _sessionsFromEventData(date : string, d : UTSJSONObject | null) : UTSJSONObject[] {
  if (d == null) return [] as UTSJSONObject[]
  const sess = d.getArray<UTSJSONObject>('sessions')
  if (sess != null && sess!.length > 0) {
    return sess!.map((s) : UTSJSONObject => {
      const c = { } as UTSJSONObject
      s.toMap().forEach((v : any | null, k : string) => { c[k] = v })
      c['date'] = date
      return c
    })
  }
  const duration = d.getNumber('duration_minutes')
  if (duration == null || duration! == 0) return [] as UTSJSONObject[]
  let onset : string | null = null
  const sleepStartMin = d.getNumber('sleep_start_min')
  if (sleepStartMin != null) {
    const mins = ((sleepStartMin! % 1440) + 1440) % 1440
    onset = `${date} ${_pad2n(Math.floor(mins / 60))}:${_pad2n(mins % 60)}:00`
  }
  const slotArr = d.get('slots')
  return [{
    date: date, onset: onset,
    totalMinutes: duration,
    deep: d.get('deep_minutes'), light: d.get('light_minutes'), rem: d.get('rem_minutes'), awake: d.get('awake_minutes'),
    sleepStart: d.get('sleep_start_min'), sleepEnd: d.get('sleep_end_min'),
    slots: slotArr,
  } as UTSJSONObject] as UTSJSONObject[]
}

function _scoreSleep(h : number) : number {
  if (h >= 7 && h <= 9) return Math.min(100, Math.round(80 + (h - 7) / 2 * 20))
  if (h > 9) return Math.max(50, Math.round(100 - (h - 9) * 25))
  if (h >= 6) return Math.round(50 + (h - 6) * 30)
  return Math.max(10, Math.round(h / 6 * 50))
}
function _scoreHrv(ms : number) : number {
  if (ms >= 80) return 100
  if (ms >= 50) return Math.round(75 + (ms - 50) / 30 * 25)
  if (ms >= 30) return Math.round(45 + (ms - 30) / 20 * 30)
  return Math.max(10, Math.round(ms / 30 * 45))
}
function _scoreRestHr(bpm : number) : number {
  if (bpm <= 52) return 100
  if (bpm <= 65) return Math.round(100 - (bpm - 52) / 13 * 20)
  if (bpm <= 75) return Math.round(80 - (bpm - 65) / 10 * 20)
  if (bpm <= 90) return Math.round(60 - (bpm - 75) / 15 * 30)
  return Math.max(5, Math.round(30 - (bpm - 90) / 30 * 25))
}
function _scoreSpo2(pct : number) : number {
  if (pct >= 98) return 100
  if (pct >= 95) return Math.round(70 + (pct - 95) / 3 * 30)
  return Math.max(10, Math.round(30 + (pct - 90) / 5 * 40))
}
function _scoreSteps(steps : number) : number {
  if (steps >= 10000) return 100
  if (steps >= 7500) return Math.round(75 + (steps - 7500) / 2500 * 25)
  if (steps >= 5000) return Math.round(50 + (steps - 5000) / 2500 * 25)
  return Math.max(5, Math.round(steps / 5000 * 50))
}
function _scoreBmi(bmi : number) : number {
  if (bmi >= 18.5 && bmi <= 24.9) return 100
  if (bmi >= 25 && bmi <= 27.5) return Math.round(100 - (bmi - 24.9) / 2.6 * 30)
  if (bmi >= 17 && bmi < 18.5) return Math.round(70 + (bmi - 17) / 1.5 * 30)
  if (bmi > 27.5) return Math.max(10, Math.round(70 - (bmi - 27.5) / 10 * 60))
  return Math.max(10, Math.round(bmi / 17 * 70))
}
function _scoreBp(sys : number | null, dia : number | null) : number | null {
  if (sys == null || dia == null) return null
  if (sys! >= 140 || dia! >= 90) return 20
  if (sys! >= 130 || dia! >= 85) return 50
  if (sys! >= 120 || dia! >= 80) return 75
  if (sys! < 85 || dia! < 55) return 60  // hypotension
  return 100
}

// 'x3' is a legacy brand value from before the X3→Halo rename — still present in local
// storage / server rows for anyone bound before the rename shipped (AGENTS §18).
function _normalizeBrand(brand : string | null) : string {
  return brand == 'x3' ? 'halo' : (brand ?? '')
}

// Halo and V8 share the same auto-monitoring config surface (0x2A/0x2B, confirmed identical)
// and the same single-phase "all historical, no realtime measurement" sync shape. Colmi and
// Aizo don't have either (and are not ported to xapp, §18).
function _hasIntervalSettings(brand : string | null) : boolean {
  return brand == 'halo' || brand == 'v8'
}

function _strOf(o : UTSJSONObject, key : string) : string {
  const v = o.getString(key)
  return v != null ? v : ''
}
function _numOf(o : UTSJSONObject, key : string) : number {
  const v = o.getNumber(key)
  return v != null ? v : 0
}
function _numOrNull(o : UTSJSONObject, key : string) : number | null {
  return o.getNumber(key)
}

function _buildRingDisplayData(raw : UTSJSONObject, isZh : boolean) : UTSJSONObject {
  const syncedAtMs = raw.getNumber('syncedAt') ?? Date.now()
  const syncLabel = isZh ? `已同步 ${_shanghaiTimeStr(syncedAtMs)}` : `Synced ${_shanghaiTimeStr(syncedAtMs)}`

  const sleepMinutes = raw.getNumber('sleepMinutes')
  let sleepStr = ''
  let sleepDeepPct = 0, sleepLightPct = 0, sleepRemPct = 0, sleepAwakePct = 0
  if (sleepMinutes != null && sleepMinutes! > 0) {
    const h = Math.floor((sleepMinutes!) / 60)
    const m = sleepMinutes! % 60
    sleepStr = isZh ? `${h}时${m}分` : `${h}h ${m}m`
    const total = sleepMinutes!
    sleepDeepPct = Math.round((raw.getNumber('sleepDeep') ?? 0) / total * 100)
    sleepRemPct = Math.round((raw.getNumber('sleepRem') ?? 0) / total * 100)
    sleepLightPct = Math.round((raw.getNumber('sleepLight') ?? 0) / total * 100)
    sleepAwakePct = Math.max(0, 100 - sleepDeepPct - sleepRemPct - sleepLightPct)
  }

  const stepsVal = raw.getNumber('steps')
  let stepsStr = ''
  let stepsPct = 0
  if (stepsVal != null) {
    const s = stepsVal!
    stepsStr = s >= 10000 ? `${(s / 1000).toFixed(1)}k`
      : s >= 1000 ? `${Math.floor(s / 1000)},${_pad3n(s % 1000)}`
      : `${s}`
    stepsPct = Math.min(100, Math.round(s / 10000 * 100))
  }

  // HRV color by quality zone (ms)
  const hrvVal = raw.getNumber('hrv')
  let hrvColor = '#A6C4E5'
  if (hrvVal != null) {
    if (hrvVal! >= 80) hrvColor = '#0ea5e9'
    else if (hrvVal! >= 50) hrvColor = '#10b981'
    else if (hrvVal! >= 30) hrvColor = '#f97316'
    else hrvColor = '#ef4444'
  }
  const hrvPct = hrvVal != null ? Math.min(100, Math.max(2, Math.round((hrvVal! - 20) / 80 * 100))) : 0

  // Stress color + label (0-100 scale)
  const stressVal = raw.getNumber('stress')
  let stressLabel = ''
  let stressColor = '#A6C4E5'
  if (stressVal != null) {
    const levels = isZh ? ['放松', '正常', '中等', '偏高'] : ['Relaxed', 'Normal', 'Moderate', 'High']
    const colors = ['#10b981', '#6375EC', '#f97316', '#ef4444']
    const idx = stressVal! <= 25 ? 0 : stressVal! <= 50 ? 1 : stressVal! <= 75 ? 2 : 3
    stressLabel = levels[idx]
    stressColor = colors[idx]
  }

  // SpO2 color
  const spo2Val = raw.getNumber('spo2')
  let spo2Color = '#A6C4E5'
  if (spo2Val != null) {
    spo2Color = spo2Val! >= 98 ? '#0ea5e9' : spo2Val! >= 95 ? '#10b981' : spo2Val! >= 90 ? '#f97316' : '#ef4444'
  }
  const spo2Pct = spo2Val != null ? Math.min(100, Math.max(2, Math.round((spo2Val! - 90) / 10 * 100))) : 0

  // Blood pressure (Halo HRV measurement) + breath rate
  const sysVal = raw.getNumber('systolicBP')
  const diaVal = raw.getNumber('diastolicBP')
  let bpStr = ''
  let bpColor = '#A6C4E5'
  if (sysVal != null && diaVal != null) {
    bpStr = `${sysVal}/${diaVal}`
    bpColor = sysVal! >= 140 ? '#ef4444' : sysVal! >= 130 ? '#f97316' : sysVal! >= 120 ? '#f97316' : '#10b981'
  }
  const breathVal = raw.getNumber('breathRate')
  const breathRateStr = breathVal != null ? `${breathVal}` : ''

  // ── Body temperature ──
  const tempVal = raw.getNumber('bodyTempC')
  let tempColor = '#A6C4E5'
  let tempPct = 0
  let bodyTempCStr = ''
  if (tempVal != null) {
    tempColor = tempVal! >= 38 ? '#ef4444' : tempVal! >= 37.2 ? '#f97316' : '#10b981'
    tempPct = Math.min(100, Math.max(2, Math.round((tempVal! - 35.5) / 3 * 100)))
    bodyTempCStr = tempVal!.toFixed(1)
  }

  // ── Slot charts ──
  const CHART_H = 72  // rpx height of bar chart area

  // Steps: aggregate 15-min slots → 24 hourly bars
  const stepsBars : UTSJSONObject[] = []
  const stepSlots = raw.getArray<UTSJSONObject>('stepSlots')
  if (stepSlots != null && stepSlots!.length > 0) {
    const hrSteps : number[] = []
    for (let i = 0; i < 24; i++) hrSteps.push(0)
    for (const s of stepSlots!) {
      hrSteps[_shanghaiHour(s.get('t'))] += s.getNumber('steps') ?? 0
    }
    const maxS = Math.max(_maxOf(hrSteps), 1)
    for (let h = 0; h < 24; h++) {
      stepsBars.push({
        h: h % 6 == 0 ? `${h}` : '',
        heightRpx: Math.round(hrSteps[h] / maxS * CHART_H),
        active: hrSteps[h] > 0,
      } as UTSJSONObject)
    }
  }

  // HR: aggregate 5-min slots → 24 hourly avg bars
  const hrBars : UTSJSONObject[] = []
  const hrSlots = raw.getArray<UTSJSONObject>('hrSlots')
  if (hrSlots != null && hrSlots!.length > 0) {
    const hrMap = new Map<number, number[]>()
    for (const r of hrSlots!) {
      const h = _shanghaiHour(r.get('t'))
      if (!hrMap.has(h)) hrMap.set(h, [] as number[])
      hrMap.get(h)!.push(r.getNumber('bpm') ?? 0)
    }
    for (let h = 0; h < 24; h++) {
      const arr = hrMap.get(h)
      if (arr == null) {
        hrBars.push({ h: h % 6 == 0 ? `${h}` : '', heightRpx: 3, color: 'rgba(99,117,236,0.08)', bpm: 0 } as UTSJSONObject)
        continue
      }
      let sum = 0
      for (const v of arr!) sum += v
      const bpm = Math.round(sum / arr!.length)
      const color = bpm < 60 ? '#0ea5e9' : bpm < 75 ? '#10b981' : bpm < 90 ? '#f97316' : '#ef4444'
      const heightRpx = Math.round(Math.max(6, Math.min(CHART_H, (bpm - 40) / 80 * CHART_H)))
      hrBars.push({ h: h % 6 == 0 ? `${h}` : '', heightRpx: heightRpx, color: color, bpm: bpm } as UTSJSONObject)
    }
  }

  // Sleep: consecutive stage segments as % widths
  const sleepSegs : UTSJSONObject[] = []
  let sleepTimeRange = ''
  const sleepSlots = raw.getArray<UTSJSONObject>('sleepSlots')
  if (sleepSlots != null && sleepSlots!.length > 0) {
    let totalMin = 0
    for (const p of sleepSlots!) totalMin += p.getNumber('min') ?? 0
    for (const p of sleepSlots!) {
      const type = sget(p, 'type')
      const color = type == 'deep' ? '#6375EC' : type == 'rem' ? '#a855f7' : type == 'light' ? '#0ea5e9' : type == 'awake' ? 'rgba(166,196,229,0.18)' : '#6375EC'
      sleepSegs.push({ widthPct: Math.round((p.getNumber('min') ?? 0) / (totalMin == 0 ? 1 : totalMin) * 100), color: color } as UTSJSONObject)
    }
    const sleepStart = raw.getNumber('sleepStart')
    const sleepEnd = raw.getNumber('sleepEnd')
    if (sleepStart != null && sleepEnd != null) {
      sleepTimeRange = `${_fmtMinOfDay(sleepStart!)} → ${_fmtMinOfDay(sleepEnd!)}`
    }
  }

  // HRV daily trend bars (last 7 days)
  const hrvDayBars : UTSJSONObject[] = []
  const hrvSlots = raw.getArray<UTSJSONObject>('hrvSlots')
  if (hrvSlots != null && hrvSlots!.length > 0) {
    const byDay = new Map<string, number[]>()
    const dayOrder : string[] = []
    for (const s of hrvSlots!) {
      const ts = sget(s, 'timestamp')
      const d = ts.substring(0, 10)
      if (!byDay.has(d)) { byDay.set(d, [] as number[]); dayOrder.push(d) }
      const v = s.getNumber('hrv')
      if (v != null) byDay.get(d)!.push(v!)
    }
    const days = dayOrder.slice().sort()
    const recent = days.length > 7 ? days.slice(days.length - 7) : days
    const avgs : number[] = []
    for (const d of recent) {
      const arr = byDay.get(d)!
      if (arr.length == 0) { avgs.push(0); continue }
      let sum = 0
      for (const v of arr) sum += v
      avgs.push(Math.round(sum / arr.length))
    }
    const maxHrv = Math.max(_maxOf(avgs), 1)
    for (let i = 0; i < recent.length; i++) {
      hrvDayBars.push({
        label: _mds(recent[i]),
        heightRpx: Math.round(Math.max(4, avgs[i] / maxHrv * CHART_H)),
        color: avgs[i] >= 80 ? '#0ea5e9' : avgs[i] >= 50 ? '#10b981' : avgs[i] >= 30 ? '#f97316' : '#ef4444',
        avg: avgs[i],
      } as UTSJSONObject)
    }
  }

  // SpO₂ daily trend bars (last 7 days)
  const spo2DayBars : UTSJSONObject[] = []
  const spo2Slots = raw.getArray<UTSJSONObject>('spo2Slots')
  if (spo2Slots != null && spo2Slots!.length > 0) {
    const byDay = new Map<string, number[]>()
    const dayOrder : string[] = []
    for (const s of spo2Slots!) {
      const ts = sget(s, 'timestamp')
      const d = ts.substring(0, 10)
      if (!byDay.has(d)) { byDay.set(d, [] as number[]); dayOrder.push(d) }
      const v = s.getNumber('spo2')
      if (v != null) byDay.get(d)!.push(v!)
    }
    const days = dayOrder.slice().sort()
    const recent = days.length > 7 ? days.slice(days.length - 7) : days
    const avgs : number[] = []
    for (const d of recent) {
      const arr = byDay.get(d)!
      if (arr.length == 0) { avgs.push(0); continue }
      let sum = 0
      for (const v of arr) sum += v
      avgs.push(Math.round(sum / arr.length * 10) / 10)
    }
    const minSpo2 = 90, maxSpo2 = 100
    for (let i = 0; i < recent.length; i++) {
      spo2DayBars.push({
        label: _mds(recent[i]),
        heightRpx: Math.round(Math.max(4, (avgs[i] - minSpo2) / (maxSpo2 - minSpo2) * CHART_H)),
        color: avgs[i] >= 98 ? '#0ea5e9' : avgs[i] >= 95 ? '#10b981' : avgs[i] >= 90 ? '#f97316' : '#ef4444',
        avg: avgs[i],
      } as UTSJSONObject)
    }
  }

  // Weekly sleep timeline: every discrete block (naps kept separate from night sleep, and a
  // night interrupted by a long wake-up kept as separate segments) positioned on a noon→noon
  // 24h axis, up to the last 7 nights.
  const SLEEP_AXIS_H = 480 // rpx — represents the full 24h noon-to-noon window
  const sleepWeek : UTSJSONObject[] = []
  const sleepHistory = raw.getArray<UTSJSONObject>('sleepHistory')
  if (sleepHistory != null && sleepHistory!.length > 0) {
    const byDate = new Map<string, UTSJSONObject[]>()
    const dateOrder : string[] = []
    for (const s of sleepHistory!) {
      if ((s.getNumber('totalMinutes') ?? 0) == 0) continue
      const onset = s.getString('onset')
      if (onset == null) continue
      const d = sget(s, 'date')
      if (!byDate.has(d)) { byDate.set(d, [] as UTSJSONObject[]); dateOrder.push(d) }
      byDate.get(d)!.push(s)
    }
    const dates = dateOrder.slice().sort()
    const recent = dates.length > 7 ? dates.slice(dates.length - 7) : dates
    for (const date of recent) {
      const sessions = byDate.get(date)!.slice(0).sort((a, b) : number => (sget(a, 'onset') < sget(b, 'onset') ? -1 : 1))
      let nightMins = 0, napMins = 0
      for (const s of sessions) {
        if (_isNightSession(sget(s, 'onset'))) nightMins += s.getNumber('totalMinutes') ?? 0
        else napMins += s.getNumber('totalMinutes') ?? 0
      }
      // Color reflects the day's COMBINED sleep total, not each segment's own duration — a
      // night interrupted into several short segments (or one resuming after 6am and bucketed
      // as a "nap", see _selectLastNight) previously colored red/orange per-piece even when
      // the day's actual total sleep was good.
      const dayColor = _dayQualityColor(nightMins + napMins)
      const blocks : UTSJSONObject[] = []
      for (let i = 0; i < sessions.length; i++) {
        const s = sessions[i]
        const onset = sget(s, 'onset')
        const mins = _minutesSinceNoon(onset)
        blocks.push({
          key: `${date}-${i}`,
          topRpx: Math.round(mins / 1440 * SLEEP_AXIS_H),
          heightRpx: Math.max(6, Math.round((s.getNumber('totalMinutes') ?? 0) / 1440 * SLEEP_AXIS_H)),
          color: dayColor,
          isNap: !_isNightSession(onset),
          timeLabel: onset.substring(11, 16),
          durLabel: _fmtHM(s.getNumber('totalMinutes') ?? 0, isZh),
        } as UTSJSONObject)
      }
      sleepWeek.push({
        date: date,
        label: _mds(date),
        totalLabel: (nightMins + napMins) > 0 ? _fmtHM(nightMins + napMins, isZh) : '—',
        hasNap: napMins > 0,
        blocks: blocks,
      } as UTSJSONObject)
    }
  }

  const sleepDate = raw.getString('sleepDate')
  const sleepDateLabel = sleepDate != null ? _mds(sleepDate!) : ''

  const restingHrVal = raw.getNumber('restingHr')

  // Merge raw fields into the result (miniapp `{ ...raw, ... }`)
  const out = { } as UTSJSONObject
  raw.toMap().forEach((v : any | null, k : string) => { out[k] = v })
  out['sleepStr'] = sleepStr
  out['sleepDeepPct'] = sleepDeepPct
  out['sleepLightPct'] = sleepLightPct
  out['sleepRemPct'] = sleepRemPct
  out['sleepAwakePct'] = sleepAwakePct
  out['stepsStr'] = stepsStr
  out['stepsPct'] = stepsPct
  out['syncLabel'] = syncLabel
  out['hasSteps'] = stepsVal != null
  out['hasSleep'] = sleepMinutes != null && sleepMinutes! > 0
  out['hasHr'] = restingHrVal != null
  out['hasHrv'] = hrvVal != null
  out['hasStress'] = stressVal != null
  out['hasSpo2'] = spo2Val != null
  out['hasBp'] = sysVal != null && diaVal != null
  out['hasBreathRate'] = breathVal != null
  out['hasBodyTemp'] = tempVal != null
  out['hrvColor'] = hrvColor
  out['hrvPct'] = hrvPct
  out['stressLabel'] = stressLabel
  out['stressColor'] = stressColor
  out['spo2Color'] = spo2Color
  out['spo2Pct'] = spo2Pct
  out['bpStr'] = bpStr
  out['bpColor'] = bpColor
  out['breathRateStr'] = breathRateStr
  out['stepsBars'] = stepsBars.length > 0 ? stepsBars : null
  out['hrBars'] = hrBars.length > 0 ? hrBars : null
  out['sleepSegs'] = sleepSegs.length > 0 ? sleepSegs : null
  out['sleepTimeRange'] = sleepTimeRange
  out['sleepDateLabel'] = sleepDateLabel
  out['hrvDayBars'] = hrvDayBars.length > 0 ? hrvDayBars : null
  out['spo2DayBars'] = spo2DayBars.length > 0 ? spo2DayBars : null
  out['sleepWeek'] = sleepWeek.length > 0 ? sleepWeek : null
  out['sleepAxisHeightRpx'] = SLEEP_AXIS_H
  out['bodyTempC'] = bodyTempCStr
  out['tempPct'] = tempPct
  out['tempColor'] = tempColor
  out['hasSlotCharts'] = stepsBars.length > 0 || hrBars.length > 0 || sleepSegs.length > 0 || hrvDayBars.length > 0 || spo2DayBars.length > 0 || sleepWeek.length > 0
  return out
}

// Wearable insights card — turns lib/wearableAnalysis.js's codes-and-numbers object into
// display strings and bar geometry. Everything user-facing is looked up in `t`, so a lang
// switch simply rebuilds it. Returns null when the server had too little data to analyse.
const INSIGHT_LEVEL_COLOR = new Map<string, string>()
INSIGHT_LEVEL_COLOR.set('ready', '#10b981')
INSIGHT_LEVEL_COLOR.set('moderate', '#f59e0b')
INSIGHT_LEVEL_COLOR.set('low', '#ef4444')
const INSIGHT_BALANCE_COLOR = new Map<string, string>()
INSIGHT_BALANCE_COLOR.set('recovering', '#10b981')
INSIGHT_BALANCE_COLOR.set('balanced', '#0ea5e9')
INSIGHT_BALANCE_COLOR.set('accumulating', '#f59e0b')

function _signed(v : number | null, unit : string = '') : string {
  if (v == null) return '—'
  return `${v! > 0 ? '+' : ''}${v}${unit}`
}

function _buildInsightsView(ins : UTSJSONObject | null, t : UTSJSONObject) : UTSJSONObject | null {
  if (ins == null) return null
  const rd = ins!.getJSON('readiness')
  const sl = ins!.getJSON('sleep')
  if (rd == null && sl == null) return null
  const td = ins!.getJSON('today')
  const b = ins!.getJSON('baseline')
  const view = { drivers: [] as UTSJSONObject[], flags: [] as UTSJSONObject[] } as UTSJSONObject

  if (rd != null && td != null) {
    const score = rd.getNumber('score')
    if (score != null) view['score'] = score
    const level = rd.getString('level') ?? ''
    view['level'] = level
    const levelLabel = t.getString('insightLevel_' + level)
    view['levelLabel'] = levelLabel != null ? levelLabel : level
    const lc = INSIGHT_LEVEL_COLOR.get(level)
    view['levelColor'] = lc != null ? lc : '#0ea5e9'
    view['refDate'] = _mds(td.getString('date'))
    view['isToday'] = td.getBoolean('is_today') == true
    const driverCodes = rd.getArray<string>('drivers')
    const drivers : UTSJSONObject[] = []
    if (driverCodes != null) {
      for (const code of driverCodes!) {
        const lbl = t.getString('insightDriver_' + code)
        drivers.push({ code: code, label: lbl != null ? lbl : code } as UTSJSONObject)
      }
    }
    view['drivers'] = drivers
    const bandLow = b != null ? b!.getNumber('band_low') : null
    const bandHigh = b != null ? b!.getNumber('band_high') : null
    const hrvMs = td.getNumber('hrv_ms')
    if (bandLow != null && hrvMs != null && bandHigh != null) {
      const lo = Math.min(bandLow!, hrvMs! * 0.95)
      const hi = Math.max(bandHigh!, hrvMs! * 1.05)
      const pct = (v : number) : number => Math.round(Math.max(0, Math.min(100, (v - lo) / (hi - lo) * 100)))
      const pos = td.getString('hrv_band_position') ?? ''
      const vsBase = _signed(td.getNumber('hrv_vs_baseline_pct'), '%')
      view['band'] = {
        low: bandLow, high: bandHigh, hrv: hrvMs,
        rangeLeftPct: pct(bandLow!), rangeWidthPct: Math.max(2, pct(bandHigh!) - pct(bandLow!)),
        markerPct: pct(hrvMs!),
        vsBaseline: vsBase,
        color: pos == 'below' ? '#f59e0b' : pos == 'above' ? '#10b981' : '#0ea5e9',
      } as UTSJSONObject
    }
  }

  if (sl != null) {
    const ln = sl!.getJSON('last_night')
    if (ln != null) {
      view['sleep'] = {
        date: _mds(ln!.getString('date')), hours: ln!.get('hours'), vsWeek: _signed(ln!.getNumber('vs_7d_hours'), 'h'),
        restorative: ln!.get('restorative_pct'), avg7: sl!.get('avg_7d_hours'), debt: sl!.get('debt_7d_hours'),
        regular: sl!.get('regular'),
        regularLabel: sl!.getBoolean('regular') == null ? '' : (sl!.getBoolean('regular') == true ? tnum(t, 'insightRegular') : tnum(t, 'insightIrregular')),
      } as UTSJSONObject
    }
  }

  const st = ins!.getJSON('stress')
  if (st != null) {
    const balance = st!.getString('balance') ?? ''
    const balLabel = t.getString('insightBalance_' + balance)
    const bc = INSIGHT_BALANCE_COLOR.get(balance)
    view['stress'] = {
      balance: balance, balanceLabel: balLabel != null ? balLabel : balance,
      balanceColor: bc != null ? bc : '#0ea5e9',
      loadToday: st!.get('load_today'), load7d: st!.get('load_7d'), nightDay: st!.get('night_day_hrv_ratio'),
    } as UTSJSONObject
  }

  const anomaly = ins!.getJSON('anomaly')
  const rawFlags = anomaly != null ? anomaly!.getArray<UTSJSONObject>('flags') : null
  const flags : UTSJSONObject[] = []
  if (rawFlags != null) {
    for (const f of rawFlags!) {
      const code = sget(f, 'code')
      const lbl = t.getString('insightFlag_' + code)
      flags.push({ code: code, label: lbl != null ? lbl : code, since: _mds(f.getString('since')) } as UTSJSONObject)
    }
  }
  view['flags'] = flags
  const dq = ins!.getJSON('data_quality')
  if (dq != null && dq!.getBoolean('provisional') == true) {
    const days = dq!.getNumber('days_until_baseline')
    view['provisional'] = tnum(t, 'insightProvisional').replace('{n}', `${days ?? 0}`)
  }
  return view
}

// Merge Halo HRV+SpO2 slot arrays into the same reading shape _fmtRealtimeReadings expects.
// Ring timestamps ('2026-06-20 14:30:12') are CST, so append +08:00 before parsing.
function _slotsToReadings(hrvSlots : UTSJSONObject[] | null, spo2Slots : UTSJSONObject[] | null) : UTSJSONObject[] {
  const byTs = new Map<string, UTSJSONObject>()
  const tsOrder : string[] = []
  for (const s of (spo2Slots ?? [] as UTSJSONObject[])) {
    const ts = sget(s, 'timestamp')
    if (!byTs.has(ts)) { byTs.set(ts, { } as UTSJSONObject); tsOrder.push(ts) }
    byTs.get(ts)!['spo2'] = s.get('spo2')
  }
  for (const s of (hrvSlots ?? [] as UTSJSONObject[])) {
    const ts = sget(s, 'timestamp')
    if (!byTs.has(ts)) { byTs.set(ts, { } as UTSJSONObject); tsOrder.push(ts) }
    const o = byTs.get(ts)!
    o['hrv'] = s.get('hrv')
    o['stress'] = s.get('stress')
    o['breathRate'] = s.get('breath')
    o['systolicBP'] = s.get('highBP')
    o['diastolicBP'] = s.get('lowBP')
  }
  const keys = tsOrder.slice().sort().reverse()
  const out : UTSJSONObject[] = []
  for (const ts of keys) {
    const o = byTs.get(ts)!
    const norm = ts.indexOf(' ') != -1 ? ts.replace(' ', 'T') + '+08:00' : ts
    let t = NaN
    try { t = new Date(norm).getTime() } catch (e : any) { t = NaN }
    const reading = { } as UTSJSONObject
    reading['t'] = isNaN(t) ? 0 : t
    o.toMap().forEach((v : any | null, k : string) => { reading[k] = v })
    out.push(reading)
  }
  return out
}

// --- Incremental Halo/V8 sync: cursor derivation + merge (see
// docs/architecture/halo-smart-ring.md §9) ---
//
// The ring's own history commands support "since date" (protocol mode 0x01), but
// handleSyncWearable() otherwise re-fetches full history every sync. Rather than a dedicated
// "last sync" storage key, each type's cursor is derived from the max key field already
// present in the previously stored `wearable_ring_data` slot array — its lifecycle then
// automatically matches the data's own (cleared on unbind, advanced only on a successful
// commit), instead of needing separate upkeep.
//
// IMPORTANT — confirmed live against a real V8 band 2026-07-30 (see
// docs/architecture/v8-smart-band.md): mode 0x01 requires the `since` date to EXACTLY match
// one of the device's own stored record timestamps (inclusive — that exact record is included
// in the result). Any other value, even one second off, makes the device silently fall back to
// returning its FULL history instead of an empty/partial result. There is no safety margin
// here — subtracting any offset from the last-known timestamp would almost always miss the
// exact match and defeat the whole optimization. The cursor must be exactly the last-known
// timestamp, which is safe to reuse as-is (it's a real value the ring itself produced, not an
// independently-derived "now" subject to clock drift), and the inclusive boundary means it
// always returns at least that one (harmless, deduped by the merge step) record plus anything
// genuinely new.
const RING_CURSOR_STALE_MS = 4 * 24 * 60 * 60 * 1000  // heuristic only (see _deriveSinceDate) — not a correctness bound
const RING_SLOT_RETENTION_DAYS = 7                    // local retention window after merging

// Returns the max `keyField` value across `slots` as a comparable string, or '' if empty.
// `keyField` values are 'YYYY-MM-DD HH:MM:SS' or ISO strings — both lexicographically sortable.
function _lastSlotTimestamp(slots : UTSJSONObject[] | null, keyField : string) : string | null {
  if (slots == null || slots!.length == 0) return null
  let max : string | null = null
  for (const s of slots!) {
    const v = s.getString(keyField)
    if (v != null && (max == null || v! > max!)) max = v
  }
  return max
}

// Derives a `sinceDate` (Date|null) to request incrementally from the ring, given the previous
// sync's slot array — exactly the last-known timestamp, no margin (see the block comment
// above for why). Returns null (→ full mode-0x00 fetch) when there's no previous data.
// RING_CURSOR_STALE_MS is purely a "don't bother attempting" heuristic to skip a fetch that's
// likely past the ring's actual retention and would just fall back to full history anyway —
// not a correctness requirement, since an exact-but-purged timestamp degrades gracefully to
// that same full-history fallback rather than losing or corrupting data.
function _deriveSinceDate(prevSlots : UTSJSONObject[] | null, keyField : string) : Date | null {
  const lastTs = _lastSlotTimestamp(prevSlots, keyField)
  if (lastTs == null) return null
  const norm = lastTs!.indexOf('T') != -1 ? lastTs : lastTs!.replace(' ', 'T') + '+08:00'
  let lastMs = NaN
  try { lastMs = new Date(norm).getTime() } catch (e : any) { lastMs = NaN }
  if (isNaN(lastMs) || Date.now() - lastMs > RING_CURSOR_STALE_MS) return null
  return new Date(lastMs)
}

// Upserts `newSlots` over `prevSlots` keyed by `keyField` (new wins on collision), sorted
// ascending, trimmed to `retentionDays`. Runs even when `newSlots` is empty (incremental fetch
// found nothing new, or the fetch failed) — in that case this returns `prevSlots` trimmed,
// which is what keeps a single failed/empty per-type fetch from wiping out the
// previously-synced data that _commitRingData would otherwise overwrite. (§9)
function _mergeRingSlots(prevSlots : UTSJSONObject[] | null, newSlots : UTSJSONObject[] | null, keyField : string, retentionDays : number | null) : UTSJSONObject[] {
  const byKey = new Map<string, UTSJSONObject>()
  const order : string[] = []
  for (const s of (prevSlots ?? [] as UTSJSONObject[])) {
    const k = sget(s, keyField)
    if (!byKey.has(k)) order.push(k)
    byKey.set(k, s)
  }
  for (const s of (newSlots ?? [] as UTSJSONObject[])) {
    const k = sget(s, keyField)
    if (!byKey.has(k)) order.push(k)
    byKey.set(k, s)
  }
  const merged = order.slice().sort((a, b) : number => a < b ? -1 : (a > b ? 1 : 0)).map((k) : UTSJSONObject => byKey.get(k)!)
  if (retentionDays == null || merged.length == 0) return merged
  const cutoffStr = _shanghaiDateStr(Date.now() - retentionDays! * 24 * 60 * 60 * 1000)
  return merged.filter((s) : boolean => sget(s, keyField) >= cutoffStr)
}

function _fmtRealtimeReadings(readings : UTSJSONObject[]) : UTSJSONObject[] {
  const todayStr = _shanghaiDateStr(Date.now())
  const yesterStr = _shanghaiDateStr(Date.now() - 86400000)
  const sectionMap = new Map<string, UTSJSONObject>()
  const sectionOrder : string[] = []
  for (const r of readings) {
    const dateStr = _shanghaiDateStr(_numOf(r, 't'))
    const sectionLabel = dateStr == todayStr ? '今天' : dateStr == yesterStr ? '昨天' : _mds(dateStr)
    if (!sectionMap.has(dateStr)) {
      sectionMap.set(dateStr, { dateLabel: sectionLabel, readings: [] as UTSJSONObject[] } as UTSJSONObject)
      sectionOrder.push(dateStr)
    }
    const section = sectionMap.get(dateStr)!
    const list = section.getArray<UTSJSONObject>('readings')!
    const hrv = r.getNumber('hrv')
    const spo2 = r.getNumber('spo2')
    const stress = r.getNumber('stress')
    const sys = r.getNumber('systolicBP')
    const dia = r.getNumber('diastolicBP')
    const hrvColor = hrv == null ? null : hrv! >= 80 ? '#0ea5e9' : hrv! >= 50 ? '#10b981' : hrv! >= 30 ? '#f97316' : '#ef4444'
    const spo2Color = spo2 == null ? null : spo2! >= 98 ? '#0ea5e9' : spo2! >= 95 ? '#10b981' : spo2! >= 90 ? '#f97316' : '#ef4444'
    const stressColor = stress == null ? null : stress! <= 25 ? '#10b981' : stress! <= 50 ? '#6375EC' : stress! <= 75 ? '#f97316' : '#ef4444'
    const bpStr = sys != null && dia != null ? `${sys}/${dia}` : null
    const bpColor = sys == null ? null : sys! >= 140 ? '#ef4444' : sys! >= 130 ? '#f97316' : sys! >= 120 ? '#f97316' : '#10b981'
    list.push({
      time: _shanghaiTimeStr(r.get('t')),
      hrv: r.get('hrv'), stress: r.get('stress'), spo2: r.get('spo2'),
      hrvColor: hrvColor, spo2Color: spo2Color, stressColor: stressColor,
      bpStr: bpStr, bpColor: bpColor, breathRate: r.get('breathRate'),
    } as UTSJSONObject)
    section['readings'] = list
  }
  return sectionOrder.map((d) : UTSJSONObject => sectionMap.get(d)!)
}

// Bounds/MAD-multiplier per metric for signal-smoothing.flagOutliers — see
// utils/wearable/signal-smoothing.uts and docs on _buildReadingLineCharts.
const SMOOTHING_HRV : OutlierConfig = new OutlierConfig(2, 220, 2.5, 7, 2)
const SMOOTHING_SPO2 : OutlierConfig = new OutlierConfig(70, 100, 2.5, 7, 0.8)
const SMOOTHING_STRESS : OutlierConfig = new OutlierConfig(0, 100, 2.5, 7, 3)

function _hrvColorFn(v : number) : string { return v >= 80 ? '#0ea5e9' : v >= 50 ? '#10b981' : v >= 30 ? '#f97316' : '#ef4444' }
function _spo2ColorFn(v : number) : string { return v >= 98 ? '#0ea5e9' : v >= 95 ? '#10b981' : v >= 90 ? '#f97316' : '#ef4444' }
function _stressColorFn(v : number) : string { return v <= 25 ? '#10b981' : v <= 50 ? '#6375EC' : v <= 75 ? '#f97316' : '#ef4444' }

function _buildReadingLineCharts(readings : UTSJSONObject[]) : UTSJSONObject {
  const pts = readings.slice(0).reverse()  // oldest → newest

  // Detects likely sensor errors (ring off-wrist, poor contact, byte glitch) and replaces
  // them with an interpolated estimate for chart display only — raw vals/readings are
  // untouched, this never feeds back into stored data.
  function _smooth(vals : number[], cfg : OutlierConfig) : UTSJSONObject {
    const flags = flagOutliers(vals, cfg)
    const corrected = interpolateFlagged(vals, flags)
    let validCount = 0
    for (const f of flags) if (!f) validCount++
    return { corrected: corrected, validCount: validCount } as UTSJSONObject
  }

  const CHART_H = 72, MAX_BARS = 48

  function _toBars(corrected : SeriesPoint[], colorFn : (v : number) => string) : UTSJSONObject[] | null {
    if (corrected.length < 2) return null
    const N = Math.min(corrected.length, MAX_BARS)
    const binned : UTSJSONObject[] = []
    for (let i = 0; i < N; i++) {
      const s = Math.floor(i / N * corrected.length)
      const e = Math.floor((i + 1) / N * corrected.length)
      const slice = corrected.slice(s, e)
      let sum = 0
      let est = false
      for (const b of slice) { sum += b.value; if (b.estimated) est = true }
      binned.push({ value: sum / slice.length, estimated: est } as UTSJSONObject)
    }
    const vals = binned.map((b) : number => b.getNumber('value')!)
    const min = _minOf(vals), max = _maxOf(vals)
    const range = (max - min) == 0 ? 1 : max - min
    return binned.map((b) : UTSJSONObject => {
      const value = b.getNumber('value')!
      return {
        heightRpx: Math.round(Math.max(4, (value - min) / range * CHART_H)),
        color: colorFn(value),
        estimated: b.getBoolean('estimated') == true,
      } as UTSJSONObject
    })
  }

  function _extract(key : string) : number[] {
    const out : number[] = []
    for (const r of pts) {
      const v = r.getNumber(key)
      if (v != null) out.push(v!)
    }
    return out
  }

  function _chart(vals : number[], colorFn : (v : number) => string, cfg : OutlierConfig) : UTSJSONObject {
    const sm = _smooth(vals, cfg)
    const corrected = sm.get('corrected') as SeriesPoint[]
    const validCount = sm.getNumber('validCount')!
    const correctedVals = corrected.map((c) : number => c.value)
    const latestRaw : number | null = vals.length > 0 ? vals[vals.length - 1] : null
    const latestEntry : SeriesPoint | null = corrected.length > 0 ? corrected[corrected.length - 1] : null
    let estimatedCount = 0
    for (const c of corrected) if (c.estimated) estimatedCount++
    const chart = {
      hasData: validCount >= 2,
      bars: _toBars(corrected, colorFn),
      latestVal: latestRaw,
      latestColor: latestRaw != null ? colorFn(latestRaw!) : 'rgba(166,196,229,0.5)',
      latestEstimated: latestEntry != null && latestEntry!.estimated,
      minVal: correctedVals.length > 0 ? Math.round(_minOf(correctedVals) * 10) / 10 : null,
      maxVal: correctedVals.length > 0 ? Math.round(_maxOf(correctedVals) * 10) / 10 : null,
      count: vals.length,
      estimatedCount: estimatedCount,
    } as UTSJSONObject
    return chart
  }

  return {
    hrvChart: _chart(_extract('hrv'), (v : number) : string => _hrvColorFn(v), SMOOTHING_HRV),
    spo2Chart: _chart(_extract('spo2'), (v : number) : string => _spo2ColorFn(v), SMOOTHING_SPO2),
    stressChart: _chart(_extract('stress'), (v : number) : string => _stressColorFn(v), SMOOTHING_STRESS),
  } as UTSJSONObject
}

function _getRealtimeReadings(syncedAt : number | null) : UTSJSONObject[] {
  try {
    const todayStr = _shanghaiDateStr(syncedAt ?? Date.now())
    const stored = _storageObj('wearable_realtime_today')
    if (stored == null || sget(stored!, 'date') != todayStr) return [] as UTSJSONObject[]
    const arr = stored!.getArray<UTSJSONObject>('readings') ?? ([] as UTSJSONObject[])
    return arr!.slice(0).reverse()
  } catch (e : any) { return [] as UTSJSONObject[] }
}

function chronoAge(birthDate : string | null) : number | null {
  if (birthDate == null || birthDate!.length == 0) return null
  const ms = _toMs(birthDate)
  if (isNaN(ms)) return null
  return Math.floor((Date.now() - ms) / (1000 * 60 * 60 * 24 * 365.25))
}

function fmtDate(d : any | null, lang : string) : string {
  if (d == null || `${d}`.length == 0) return '—'
  const ms = _toMs(d)
  if (isNaN(ms)) return `${d}`
  const date = new Date(ms)
  const y = date.getFullYear()
  const m = date.getMonth() + 1
  const day = date.getDate()
  if (lang == 'zh') return `${y}年${m}月${day}日`
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
  return `${months[date.getMonth()]} ${day}, ${y}`
}

function bioAgeColor(bio : string | null, chrono : number | null) : string {
  if (bio == null || bio!.length == 0 || chrono == null) return '#A6C4E5'
  return parseFloat(bio!) <= chrono! ? '#10b981' : '#ef4444'
}

// ref ranges: [low, high, higherIsBetter]
class RefRow {
  lo : number | null
  hi : number | null
  higherBetter : boolean
  constructor(lo : number | null, hi : number | null, higherBetter : boolean) {
    this.lo = lo; this.hi = hi; this.higherBetter = higherBetter
  }
}
const BIO_REF = new Map<string, RefRow>()
BIO_REF.set('hsCRP', new RefRow(null, 1.0, false))
BIO_REF.set('IL6', new RefRow(null, 3.0, false))
BIO_REF.set('GDF15', new RefRow(null, 750, false))
BIO_REF.set('GA', new RefRow(11.0, 15.0, false))
BIO_REF.set('CystatinC', new RefRow(0.51, 0.95, false))
BIO_REF.set('HbA1c', new RefRow(null, 5.7, false))
BIO_REF.set('FPG', new RefRow(3.9, 6.1, false))
BIO_REF.set('Triglycerides', new RefRow(null, 1.7, false))
BIO_REF.set('ALT', new RefRow(null, 40, false))
BIO_REF.set('AST', new RefRow(null, 40, false))
BIO_REF.set('GGT', new RefRow(null, 50, false))
BIO_REF.set('TSH', new RefRow(0.35, 4.5, false))
BIO_REF.set('TotalCholesterol', new RefRow(null, 5.2, false))
BIO_REF.set('LDL', new RefRow(null, 3.4, false))
BIO_REF.set('HDL', new RefRow(1.0, null, true))
BIO_REF.set('Creatinine', new RefRow(53, 115, false))
BIO_REF.set('eGFR', new RefRow(90, null, true))
BIO_REF.set('BUN', new RefRow(1.7, 8.3, false))
BIO_REF.set('UricAcid', new RefRow(null, 416, false))
BIO_REF.set('CRP', new RefRow(null, 10, false))
BIO_REF.set('VitaminD', new RefRow(50, 150, false))
BIO_REF.set('WBC', new RefRow(4.0, 10.0, false))
BIO_REF.set('Ferritin', new RefRow(13, 150, false))
BIO_REF.set('Hemoglobin', new RefRow(115, 175, false))

const REF_DISPLAY = new Map<string, string>()
REF_DISPLAY.set('hsCRP', '< 1.0 mg/L')
REF_DISPLAY.set('IL6', '< 3.0 pg/mL')
REF_DISPLAY.set('GDF15', '< 750 pg/mL')
REF_DISPLAY.set('GA', '11–15 %')
REF_DISPLAY.set('CystatinC', '0.51–0.95 mg/L')
REF_DISPLAY.set('HbA1c', '< 5.7 %')
REF_DISPLAY.set('FPG', '3.9–6.1 mmol/L')
REF_DISPLAY.set('Triglycerides', '< 1.7 mmol/L')
REF_DISPLAY.set('ALT', '< 40 U/L')
REF_DISPLAY.set('AST', '< 40 U/L')
REF_DISPLAY.set('GGT', '< 50 U/L')
REF_DISPLAY.set('TSH', '0.35–4.5 mIU/L')
REF_DISPLAY.set('TotalCholesterol', '< 5.2 mmol/L')
REF_DISPLAY.set('LDL', '< 3.4 mmol/L')
REF_DISPLAY.set('HDL', '> 1.0 mmol/L')
REF_DISPLAY.set('Creatinine', '53–115 μmol/L')
REF_DISPLAY.set('eGFR', '> 90')
REF_DISPLAY.set('BUN', '1.7–8.3 mmol/L')
REF_DISPLAY.set('UricAcid', '< 416 μmol/L')
REF_DISPLAY.set('CRP', '< 10 mg/L')
REF_DISPLAY.set('VitaminD', '50–150 nmol/L')
REF_DISPLAY.set('WBC', '4–10 ×10⁹/L')
REF_DISPLAY.set('Ferritin', '13–150 μg/L')
REF_DISPLAY.set('Hemoglobin', '115–175 g/L')

function _bioStatus(keyName : string, value : number | null) : string {
  if (value == null || keyName.length == 0) return 'normal'
  const ref = BIO_REF.get(keyName)
  if (ref == null) return 'normal'
  const v = value!
  if (ref!.higherBetter) {
    if (ref!.lo != null && v < ref!.lo!) return 'low'
    return 'normal'
  }
  if (ref!.hi != null && v > ref!.hi!) return 'high'
  if (ref!.lo != null && v < ref!.lo!) return 'low'
  return 'normal'
}

function _refText(keyName : string) : string {
  const v = REF_DISPLAY.get(keyName)
  return v != null ? v : ''
}

// Maps legacy (US-unit, snake_case) lab keys → catalog key_name for status lookup
const LEGACY_KEY_MAP = new Map<string, string>()
LEGACY_KEY_MAP.set('ldl', 'LDL')
LEGACY_KEY_MAP.set('hdl', 'HDL')
LEGACY_KEY_MAP.set('alt', 'ALT')
LEGACY_KEY_MAP.set('ast', 'AST')
LEGACY_KEY_MAP.set('tsh', 'TSH')
LEGACY_KEY_MAP.set('hba1c', 'HbA1c')
LEGACY_KEY_MAP.set('ferritin', 'Ferritin')
LEGACY_KEY_MAP.set('uric_acid', 'UricAcid')
LEGACY_KEY_MAP.set('vitamin_d', 'VitaminD')
LEGACY_KEY_MAP.set('creatinine', 'Creatinine')
LEGACY_KEY_MAP.set('triglycerides', 'Triglycerides')
LEGACY_KEY_MAP.set('glucose_fasting', 'FPG')
LEGACY_KEY_MAP.set('total_cholesterol', 'TotalCholesterol')
LEGACY_KEY_MAP.set('hsCRP', 'hsCRP')
LEGACY_KEY_MAP.set('il6', 'IL6')

// Display label overrides for compact rendering
const LAB_DISPLAY_NAME = new Map<string, string>()
LAB_DISPLAY_NAME.set('TotalCholesterol', 'Chol')
LAB_DISPLAY_NAME.set('MicroVascularAge', 'µVasc')
LAB_DISPLAY_NAME.set('total_cholesterol', 'Chol')
LAB_DISPLAY_NAME.set('uric_acid', 'UA')
LAB_DISPLAY_NAME.set('glucose_fasting', 'Gluc')
LAB_DISPLAY_NAME.set('vitamin_d', 'VitD')
LAB_DISPLAY_NAME.set('vitamin_b12', 'B12')

// Status from the SERVER's ranges when a marker carries them (every per-marker value does since
// 2026-09-15), else the client table — which only ever covered the original 25 keys. Kept as the
// fallback for the legacy `results` shape and for a twin written before the ranges shipped.
function _statusFor(key : string, v : number | null, refLow : number | null, refHigh : number | null) : string {
  if (v == null || isNaN(v!)) return 'normal'
  if (refLow != null || refHigh != null) {
    if (refHigh != null && v! > refHigh!) return 'high'
    if (refLow != null && v! < refLow!) return 'low'
    return 'normal'
  }
  return _bioStatus(key, v)
}

function _refTextFor(key : string, refLow : number | null, refHigh : number | null, unit : string) : string {
  if (refLow != null && refHigh != null) return `${refLow}–${refHigh} ${unit}`.replace(/\s+$/, '')
  if (refHigh != null) return `< ${refHigh} ${unit}`.replace(/\s+$/, '')
  if (refLow != null) return `> ${refLow} ${unit}`.replace(/\s+$/, '')
  return _refText(key)
}

// The panel is the latest value PER MARKER across every lab report (lib/labHistory.js), each
// marker with its own date; the header says how many reports it spans. `series` (from
// /api/lab-history?series=1) marks which tiles have more than one point to chart.
function _buildLabPanel(twin : UTSJSONObject, lang : string | null, series : UTSJSONObject) : UTSJSONObject {
  const labData = twin.getJSON('latest_lab_data')
  const labDate = twin.getJSON('latest_lab_date') ?? twin.getString('latest_lab_date')
  const empty = { labPanel: [] as UTSJSONObject[], labPanelDate: '', labPanelAbnormal: 0, labPanelMeta: '' } as UTSJSONObject
  if (labData == null || labDate == null) return empty
  const isZh = (lang ?? 'zh') != 'en'
  const t = isZh ? T_ZH : T_EN

  const panelDate = `${labDate}`.substring(0, 10)
  const labPanelDate = fmtDate(labDate, lang ?? 'zh')
  const items : UTSJSONObject[] = []
  const pointsOf = (key : string) : UTSJSONObject[] => {
    const s = series.getJSON(key)
    if (s == null) return [] as UTSJSONObject[]
    return s!.getArray<UTSJSONObject>('points') ?? ([] as UTSJSONObject[])
  }

  const markers = labData!.getJSON('markers')
  if (markers != null) {
    // { markers: { LDL: { value, unit, data_date?, display_name_zh?, ref_low?, ref_high?, category? } } }
    markers!.toMap().forEach((v : any | null, key : string) => {
      const info = v as UTSJSONObject
      const valStr = sget(info, 'value')
      const vNum = valStr.length > 0 ? parseFloat(valStr) : (_numOrNull(info, 'value'))
      const status = _statusFor(key, vNum, info.getNumber('ref_low'), info.getNumber('ref_high'))
      const statusColor = status == 'high' ? '#ef4444' : status == 'low' ? '#60a5fa' : '#10b981'
      const dateOpt = info.getString('data_date')
      const date = dateOpt != null ? `${dateOpt}`.substring(0, 10) : panelDate
      const dnZh = info.getString('display_name_zh')
      const dnEn = info.getString('display_name')
      const mapV = LAB_DISPLAY_NAME.get(key)
      const displayName = isZh
        ? (dnZh != null && dnZh!.length > 0 ? dnZh! : (mapV != null ? mapV! : key))
        : (mapV != null ? mapV! : (dnEn != null && dnEn!.length > 0 ? dnEn! : key))
      items.push({
        key: key, displayName: displayName, value: `${vNum}`, unit: sget(info, 'unit'), status: status, statusColor: statusColor,
        category: sget(info, 'category'),
        date: date,
        dateShort: date != panelDate ? date.substring(5) : '',
        hasTrend: pointsOf(key).length > 1,
      } as UTSJSONObject)
    })
  } else {
    // Legacy format: { results: { ldl: { value, unit, ref_high, ref_low }, ... } }
    const results = labData!.getJSON('results')
    if (results != null) {
      results!.toMap().forEach((v : any | null, legacyKey : string) => {
        const info = v as UTSJSONObject
        const catalogKeyOpt = LEGACY_KEY_MAP.get(legacyKey)
        const catalogKey = catalogKeyOpt != null ? catalogKeyOpt : legacyKey
        const valStr = sget(info, 'value')
        const vNum = valStr.length > 0 ? parseFloat(valStr) : _numOrNull(info, 'value')
        let status = 'normal'
        const refHi = info.getNumber('ref_high')
        const refLo = info.getNumber('ref_low')
        if (refHi != null && vNum != null && vNum! > refHi!) status = 'high'
        else if (refLo != null && vNum != null && vNum! < refLo!) status = 'low'
        const statusColor = status == 'high' ? '#ef4444' : status == 'low' ? '#60a5fa' : '#10b981'
        const mapV = LAB_DISPLAY_NAME.get(legacyKey)
        const displayName = mapV != null ? mapV : legacyKey.replace(/_/g, ' ')
        items.push({
          key: catalogKey, displayName: displayName, value: `${vNum}`, unit: sget(info, 'unit'), status: status, statusColor: statusColor,
          category: '', date: panelDate, dateShort: '', hasTrend: pointsOf(catalogKey).length > 1,
        } as UTSJSONObject)
      })
    }
  }

  // Abnormal first, then by category so a CBC block reads together, then by key.
  // (Deviation: plain lexicographic compare instead of localeCompare — UTS string support.)
  items.sort((a, b) : number => {
    const aAbn = sget(a, 'status') != 'normal' ? 0 : 1
    const bAbn = sget(b, 'status') != 'normal' ? 0 : 1
    if (aAbn != bAbn) return aAbn - bAbn
    const ac = sget(a, 'category'), bc = sget(b, 'category')
    if (ac != bc) return ac < bc ? -1 : 1
    return sget(a, 'key') < sget(b, 'key') ? -1 : 1
  })

  let abnCount = 0
  for (const i of items) if (sget(i, 'status') != 'normal') abnCount++
  const datesArr = labData!.getArray<string>('dates')
  let dateCount = 0
  if (datesArr != null && datesArr!.length > 0) {
    dateCount = datesArr!.length
  } else {
    const uniq = new Set<string>()
    for (const i of items) uniq.add(sget(i, 'date'))
    dateCount = uniq.size
  }
  const labPanelMeta = tnum(t, 'labPanelMeta')
    .replace('{d}', labPanelDate).replace('{n}', `${items.length}`).replace('{m}', `${dateCount}`)
  return { labPanel: items, labPanelDate: labPanelDate, labPanelAbnormal: abnCount, labPanelMeta: labPanelMeta } as UTSJSONObject
}

// Medical Records layer — one accent per food-sensitivity class. Class 0 never renders (it is
// not a restriction), so the map starts at 1.
function _foodClassColor(cls : number) : string {
  if (cls == 3) return '#ef4444'
  if (cls == 2) return '#f97316'
  if (cls == 1) return '#eab308'
  return 'rgba(166,196,229,0.55)'
}

// Personal Profile layer — one accent per user_memory_facts category.
function _factCategoryColor(cat : string) : string {
  if (cat == 'allergy') return '#ef4444'
  if (cat == 'dietary_restriction') return '#f97316'
  if (cat == 'preference') return '#6375EC'
  if (cat == 'goal') return '#10b981'
  return 'rgba(166,196,229,0.55)'
}

function _reportTypeColor(type : string) : string {
  if (type == 'annual_checkup') return '#a855f7'
  if (type == 'lab_panel') return '#0ea5e9'
  if (type == 'imaging') return '#14b8a6'
  if (type == 'functional') return '#f59e0b'
  if (type == 'genetic') return '#ec4899'
  if (type == 'microbiome') return '#84cc16'
  return '#6375EC'
}

// "6.9 MB" / "820 KB" for the 综合报告 card meta line.
function _sizeLabel(bytes : number | null) : string {
  const n = bytes ?? 0
  if (n >= 1024 * 1024) return `${(n / 1024 / 1024).toFixed(1)} MB`
  if (n >= 1024) return `${Math.round(n / 1024)} KB`
  return `${n} B`
}

// Storage helpers — the miniapp used wx.getStorageSync with object values; uni.storage returns
// `any`, everything is normalized to UTSJSONObject or null here.
function _storageObj(key : string) : UTSJSONObject | null {
  try {
    const v : any | null = uni.getStorageSync(key)
    if (v == null) return null
    if (v instanceof UTSJSONObject) return v as UTSJSONObject
    return null
  } catch (e : any) {
    return null
  }
}

function _isPrivacyError(e : any | null) : boolean {
  if (e == null) return false
  const msg = `${e}`
  return msg.indexOf('privacy api banned') != -1 || msg.indexOf('privacy') != -1
}

// ── UTSJSONObject accessors used from the template ──────────────────────────

function jget(o : UTSJSONObject | null, k : string) : UTSJSONObject | null {
  if (o == null) return null
  return o!.getJSON(k)
}
function sget(o : UTSJSONObject | null, k : string) : string {
  if (o == null) return ''
  const v = o!.getString(k)
  return v != null ? v : ''
}
function snum(o : UTSJSONObject | null, k : string) : string {
  if (o == null) return ''
  const v = o!.getNumber(k)
  return v != null ? `${v}` : ''
}
function nget(o : UTSJSONObject | null, k : string) : number {
  if (o == null) return 0
  const v = o!.getNumber(k)
  return v != null ? v : 0
}
function bget(o : UTSJSONObject | null, k : string) : boolean {
  if (o == null) return false
  return o!.getBoolean(k) == true
}
function aget(o : UTSJSONObject | null, k : string) : UTSJSONObject[] {
  if (o == null) return [] as UTSJSONObject[]
  const a = o!.getArray<UTSJSONObject>(k)
  return a != null ? a : [] as UTSJSONObject[]
}
function ags(o : UTSJSONObject | null, k : string) : string[] {
  if (o == null) return [] as string[]
  const a = o!.getArray<string>(k)
  return a != null ? a : [] as string[]
}
function an(o : UTSJSONObject | null, k : string) : number {
  return nget(o, k)
}
function al(o : UTSJSONObject | null, k : string) : string {
  return sget(o, k)
}
function aln(o : UTSJSONObject | null, k : string) : string {
  // color field of a crosshair label line — already a css color string
  return sget(o, k)
}
function hasKey(o : UTSJSONObject | null, k : string) : boolean {
  if (o == null) return false
  return o!.get(k) != null
}
// Template-facing aliases: the Vue template resolves identifiers against the component
// instance only, so the module helpers above are re-exposed as methods below with these
// internal call targets.
function g_sget(o : UTSJSONObject | null, k : string) : string { return sget(o, k) }
function g_nget(o : UTSJSONObject | null, k : string) : number { return nget(o, k) }
function g_bget(o : UTSJSONObject | null, k : string) : boolean { return bget(o, k) }
function g_aget(o : UTSJSONObject | null, k : string) : UTSJSONObject[] { return aget(o, k) }
function g_ags(o : UTSJSONObject | null, k : string) : string[] { return ags(o, k) }
function g_jget(o : UTSJSONObject | null, k : string) : UTSJSONObject | null { return jget(o, k) }
function g_snum(o : UTSJSONObject | null, k : string) : string { return snum(o, k) }
function g_hasKey(o : UTSJSONObject | null, k : string) : boolean { return hasKey(o, k) }

// Canvas-layout bookkeeping for the view-based charts (mirrors the miniapp's _chartLayouts /
// _lastCrosshairIdx). target: 'bioage' | 'line' | 'bp'; canvas: the miniapp canvas-id the
// layout was registered under (crosshair is only enabled for dt-bioage-chart,
// uh-subage-chart, uh-lab-chart — same as the miniapp's catchtouch* bindings).
class ChartLayout {
  pL : number = 0
  plotW : number = 0
  len : number = 0
  target : string = 'line'
  canvas : string = ''
  xLeft : number = 0
}

// WeChat's onNeedPrivacyAuthorization plumbing (app._privacyResolve / _privacyDone in the
// miniapp). TODO(port): no WeChat privacy framework on native; kept as module holders so
// onPrivacyAgree/onPrivacyCancel retain their exact shapes if anything re-arms the popup.
let _privacyResolve : ((detail : UTSJSONObject) => void) | null = null
let _privacyDone : ((ok : boolean) => void) | null = null

// ── ring accessor helpers (HaloRing | V8Band have identically-named methods with slightly
//    different return classes; every call site narrows here, keeping the sync flow itself a
//    single code path exactly like the miniapp) ──────────────────────────────────────────

function _hrvHaloToJson(r : HrvRecord) : UTSJSONObject {
  return { timestamp: r.timestamp, hrv: r.hrv, stress: r.stress, breath: r.breath, heartRate: r.heartRate, highBP: r.highBP, lowBP: r.lowBP } as UTSJSONObject
}
function _hrvV8ToJson(r : V8HrvHistoryItem) : UTSJSONObject {
  // V8's byte-10 is vascularAging, not Halo's breath rate (v8-smart-band.md §6-7) — no
  // breath/heart-rate mapping; fields the sync shape doesn't carry stay null.
  return { timestamp: r.timestamp, hrv: r.hrv, stress: r.stress, breath: null, heartRate: r.heartRate, highBP: r.highBP, lowBP: r.lowBP } as UTSJSONObject
}
function _spo2HaloToJson(r : Spo2Record) : UTSJSONObject {
  return { timestamp: r.timestamp, spo2: r.spo2 } as UTSJSONObject
}
function _spo2V8ToJson(r : V8Spo2Item) : UTSJSONObject {
  return { timestamp: r.timestamp, spo2: r.spo2 } as UTSJSONObject
}
function _tempHaloToJson(r : TempLogItem) : UTSJSONObject {
  return { date: r.date, estimatedBodyTemp: r.estimatedBodyTemp, skinTemp: r.skinTemp, status: r.status } as UTSJSONObject
}
function _tempV8ToJson(r : V8TempItem) : UTSJSONObject {
  return { date: r.date, estimatedBodyTemp: r.estimatedBodyTemp, skinTemp: r.skinTemp, status: r.status } as UTSJSONObject
}
function _hrLogToJson(r : HrLogItem) : UTSJSONObject {
  return { value: r.value, timestamp: r.timestamp } as UTSJSONObject
}
function _sleepBlockToJson(b : SleepBlock) : UTSJSONObject {
  return { dateStr: b.dateStr, unitMin: b.unitMin, stages: b.stages } as UTSJSONObject
}
function _sleepNightHaloToJson(n : SleepNight) : UTSJSONObject {
  const slots : UTSJSONObject[] = n.periods.map((p) : UTSJSONObject => ({ type: p.typeName, min: p.minutes } as UTSJSONObject))
  return {
    date: n.date, onset: n.onset, totalMinutes: n.totalMinutes,
    deep: n.deep, light: n.light, rem: n.rem, awake: n.awake,
    sleepStart: n.sleepStart, sleepEnd: n.sleepEnd,
    slots: slots.length > 0 ? slots : null,
  } as UTSJSONObject
}
function _sleepNightV8ToJson(n : V8SleepNight) : UTSJSONObject {
  // deep/light/rem/awake deliberately null on V8 (§18 — stage enum unconfirmed); mislabeling
  // would be worse than a gap.
  return {
    date: n.date, onset: n.onset, totalMinutes: n.totalMinutes,
    deep: n.deep, light: n.light, rem: n.rem, awake: n.awake,
    sleepStart: n.sleepStart, sleepEnd: n.sleepEnd,
    slots: null,
  } as UTSJSONObject
}
function _stepSlotHaloToJson(s : StepSlot) : UTSJSONObject {
  return { t: s.t, steps: s.steps, cal: s.cal, dist: s.dist } as UTSJSONObject
}
function _stepSlotV8ToJson(r : DetailActivityRecord) : UTSJSONObject {
  // mirrors miniapp v8/index.js getSteps(): slot t is the CST datetime as ISO+08:00
  return { t: r.date.replace(' ', 'T') + '+08:00', steps: r.step, cal: r.calories, dist: r.distance * 1000 } as UTSJSONObject
}

async function _ro_connect(ring : HaloRing | V8Band, deviceId : string, syncTime : boolean) : Promise<void> {
  if (ring instanceof HaloRing) { await (ring as HaloRing).connect(deviceId, syncTime); return }
  await (ring as V8Band).connect(deviceId, syncTime)
}
async function _ro_disconnect(ring : HaloRing | V8Band) : Promise<void> {
  if (ring instanceof HaloRing) { await (ring as HaloRing).disconnect(); return }
  await (ring as V8Band).disconnect()
}
async function _ro_getBatteryLevel(ring : HaloRing | V8Band) : Promise<number> {
  if (ring instanceof HaloRing) { return (await (ring as HaloRing).getBattery()).level }
  return (await (ring as V8Band).getBattery()).level
}
async function _ro_getMac(ring : HaloRing | V8Band) : Promise<string> {
  if (ring instanceof HaloRing) { return await (ring as HaloRing).getMac() }
  return await (ring as V8Band).getMac()
}
async function _ro_setAutoMonitoring(ring : HaloRing | V8Band, s : AutoMonitoringSettings) : Promise<void> {
  if (ring instanceof HaloRing) { await (ring as HaloRing).setAutoMonitoring(s); return }
  await (ring as V8Band).setAutoMonitoring(s)
}
async function _ro_getAutoMonitoring(ring : HaloRing | V8Band, type : number) : Promise<UTSJSONObject> {
  if (ring instanceof HaloRing) {
    const r = await (ring as HaloRing).getAutoMonitoring(type)
    return { workMode: r.workMode, intervalMinutes: r.intervalMinutes } as UTSJSONObject
  }
  const r2 = await (ring as V8Band).getAutoMonitoring(type)
  return { workMode: r2.workMode, intervalMinutes: r2.intervalMinutes } as UTSJSONObject
}
async function _ro_getDeviceTime(ring : HaloRing | V8Band) : Promise<number | null> {
  if (ring instanceof HaloRing) { return await (ring as HaloRing).getDeviceTime() }
  return await (ring as V8Band).getDeviceTime()
}
async function _ro_setTime(ring : HaloRing | V8Band, d : Date) : Promise<void> {
  if (ring instanceof HaloRing) { await (ring as HaloRing).setTime(d); return }
  await (ring as V8Band).setTime(d)
}
async function _ro_getSteps(ring : HaloRing | V8Band, since : Date | null) : Promise<UTSJSONObject | null> {
  if (ring instanceof HaloRing) {
    const s = await (ring as HaloRing).getSteps(null, since)
    return { steps: s.steps, calories: s.calories, distance: s.distance, slots: s.slots.map((x) : UTSJSONObject => _stepSlotHaloToJson(x)) } as UTSJSONObject
  }
  const s2 = await (ring as V8Band).getSteps(null, since)
  return { steps: s2.steps, calories: s2.calories, distance: s2.distance, slots: s2.slots.map((x : DetailActivityRecord) : UTSJSONObject => _stepSlotV8ToJson(x)) } as UTSJSONObject
}
async function _ro_getHeartRateLog(ring : HaloRing | V8Band, since : Date | null) : Promise<UTSJSONObject[]> {
  if (ring instanceof HaloRing) {
    const l = await (ring as HaloRing).getHeartRateLog(null, since)
    return l.map((r) : UTSJSONObject => _hrLogToJson(r))
  }
  const l2 = await (ring as V8Band).getHeartRateLog(null, since)
  return l2.map((r) : UTSJSONObject => _hrLogToJson(r))
}
async function _ro_getHrvHistory(ring : HaloRing | V8Band, since : Date | null) : Promise<UTSJSONObject[]> {
  if (ring instanceof HaloRing) {
    const l = await (ring as HaloRing).getHrvHistory(since)
    return l.map((r) : UTSJSONObject => _hrvHaloToJson(r))
  }
  const l2 = await (ring as V8Band).getHrvHistory(since)
  return l2.map((r) : UTSJSONObject => _hrvV8ToJson(r))
}
async function _ro_getSpo2History(ring : HaloRing | V8Band, since : Date | null) : Promise<UTSJSONObject[]> {
  if (ring instanceof HaloRing) {
    const l = await (ring as HaloRing).getAutoSpo2History(since)
    return l.map((r) : UTSJSONObject => _spo2HaloToJson(r))
  }
  const l2 = await (ring as V8Band).getAutoSpo2History(since)
  return l2.map((r) : UTSJSONObject => _spo2V8ToJson(r))
}
async function _ro_getTemperatureHistory(ring : HaloRing | V8Band, since : Date | null) : Promise<UTSJSONObject[]> {
  if (ring instanceof HaloRing) {
    const l = await (ring as HaloRing).getTemperatureHistory(since)
    return l.map((r) : UTSJSONObject => _tempHaloToJson(r))
  }
  const l2 = await (ring as V8Band).getTemperatureHistory(since)
  return l2.map((r) : UTSJSONObject => _tempV8ToJson(r))
}
async function _ro_getSleepBlocks(ring : HaloRing | V8Band, since : Date | null) : Promise<UTSJSONObject[]> {
  if (ring instanceof HaloRing) {
    const l = await (ring as HaloRing).getSleepBlocks(since)
    return l.map((b) : UTSJSONObject => _sleepBlockToJson(b))
  }
  const l2 = await (ring as V8Band).getSleepBlocks(since)
  return l2.map((b) : UTSJSONObject => _sleepBlockToJson(b))
}
async function _ro_getSleepHistory(ring : HaloRing | V8Band) : Promise<UTSJSONObject[]> {
  if (ring instanceof HaloRing) {
    const l = await (ring as HaloRing).getSleepHistory()
    return l.map((n) : UTSJSONObject => _sleepNightHaloToJson(n))
  }
  const l2 = await (ring as V8Band).getSleepHistory()
  return l2.map((n) : UTSJSONObject => _sleepNightV8ToJson(n))
}
// Re-derive nights from merged raw blocks; Halo and V8 expose the summarizer from different
// modules with the same input shape (only which module to pull it from differs — verbatim
// from the miniapp comment).
function _summariseSleep(brand : string, blocksJson : UTSJSONObject[]) : UTSJSONObject[] {
  const blocks : SleepBlock[] = blocksJson.map((j) : SleepBlock => new SleepBlock(
    sget(j, 'dateStr'), nget(j, 'unitMin'), j.getArray<number>('stages') ?? ([] as number[])))
  if (brand == 'halo') {
    return summariseSleepBlocks(blocks).map((n) : UTSJSONObject => _sleepNightHaloToJson(n))
  }
  return summariseV8SleepBlocks(blocks).map((n) : UTSJSONObject => _sleepNightV8ToJson(n))
}

// uni.request's awaitable overload only resolves in module scope with a RequestMethod-TYPED
// parameter (mirrors utils/request.uts's _run); inside component methods the same call shape
// silently selects the RequestTask overload (full-build Kotlin error).
async function _envelopeRun(url : string, method : RequestMethod, data : UTSJSONObject | null) : Promise<RespEnvelope> {
  const header = { 'Content-Type': 'application/json', 'Authorization': `Bearer ${state.apiToken}` } as UTSJSONObject
  let res : RequestSuccess<UTSJSONObject> | null = null
  await new Promise<boolean>((resolve : (v : boolean) => void, _reject : (e : any | null) => void) => {
    uni.request<UTSJSONObject>({
      url: url, method: method, header: header, data: data,
      success: (r) => { res = r; resolve(true) },
      fail: (err) => { resolve(false) },
    })
  })
  if (res == null) return new RespEnvelope(0, null)
  checkAuthStatus(res!.statusCode)
  return new RespEnvelope(res!.statusCode, res!.data)
}


export default {
  name: 'UserHealth',
  components: { AvatarPicker, HealthDocuments, StripRecord, VivaAgPanel },

  // properties → props, same names/types/defaults as user-health.js
  props: {
    userId: { type: String, default: '' },
    user: { type: Object, default: null },
    lang: { type: String, default: 'zh' },
    mode: { type: String, default: 'self' },
    isGuest: { type: Boolean, default: false },
    theme: { type: String, default: 'dark' },
    // Accessibility text-size level (0-3). The .fs-N class that resizes text lives on the
    // HOST page's root view (custom properties are inherited) — this prop exists only so the
    // watcher below can react (invalidates the BioAge chart's page-relative rect fallback).
    textScale: { type: Number, default: 0 },
    // Whether this user holds an active Viva AG add-on. Cosmetic only — it decides whether
    // the subtab strip renders; every AG endpoint re-checks entitlement server-side. Never
    // passed by the coach view, so a coach viewing a client defaults to false.
    vivaAgEnabled: { type: Boolean, default: false },
    // Set only by the coach view. Forwarded to <health-documents>/<strip-record> so the
    // server can verify the client belongs to this coach; empty in the user's own view.
    coachId: { type: String, default: '' },
  },

  data() {
    return {
      t: T_ZH as UTSJSONObject,
      isZh: true,
      healthSubTab: 'twin',
      showAgTab: false,
      bioLoading: true,
      bAge: '',
      cAge: null as number | null,
      bAgeColor: '#A6C4E5',
      subAgeList: [] as UTSJSONObject[],
      subAgeZ: { } as UTSJSONObject,
      bmList: [] as UTSJSONObject[],
      trendList: [] as UTSJSONObject[],
      recordCount: 0,
      hasBm: false,
      profileInfoVisible: [] as UTSJSONObject[],
      profileInfoExtra: [] as UTSJSONObject[],
      profileExpanded: false,
      weightHistory: [] as UTSJSONObject[],
      weightChartOpen: false,
      weightChartW: 300,
      bmiHistory: [] as UTSJSONObject[],
      bmiChartOpen: false,
      bmiChartW: 300,
      stepsHistory: [] as UTSJSONObject[],
      stepsChartOpen: false,
      stepsChartW: 300,
      insights: null as UTSJSONObject | null, // raw GET /api/wearable-insights object
      // 心电节律 (V8 only) and 脉搏波 (V8 + Halo): GET /api/ecg + /api/ppg summaries, newest
      // first; the overlay is <strip-record> (TODO(port)).
      ecgList: [] as UTSJSONObject[],
      ecgLatest: null as UTSJSONObject | null,
      ecgSupported: false, // self view, bound wearable is a V8 — recomputed with the binding
      ppgList: [] as UTSJSONObject[],
      ppgLatest: null as UTSJSONObject | null,
      ppgSupported: false,
      stripKind: 'ecg', // which kind the single <strip-record> instance is showing
      stripViewId: 0,   // a stored strip being viewed in it; 0 = recording mode
      ecgRecordOpen: false,
      insightsView: null as UTSJSONObject | null, // _buildInsightsView() of the above, rebuilt on lang change
      hrvHistory: [] as UTSJSONObject[],
      hrvChartOpen: false,
      hrvChartW: 300,
      stressHistory: [] as UTSJSONObject[],
      stressChartOpen: false,
      stressChartW: 300,
      bpHistory: [] as UTSJSONObject[],
      bpChartOpen: false,
      bpChartW: 300,
      latestBp: null as UTSJSONObject | null,
      glucoseHistory: [] as UTSJSONObject[],
      glucoseChartOpen: false,
      glucoseChartW: 300,
      latestGlucose: null as UTSJSONObject | null,
      bioAgeHistory: [] as UTSJSONObject[],
      bioAgeChartW: 0,
      bioAgeTrendOpen: false,
      // Map, not UTSJSONObject: getArray<UTSJSONObject> on a stored Kotlin List fails the
      // generic check at runtime (returned null) — chevrons/trend charts read empty.
      subAgeHistory: new Map<string, UTSJSONObject[]>(),
      subAgeChartOpen: false,
      subAgeChartKey: '',
      subAgeChartW: 300,
      flashSubAge: '',
      healthConditionsList: [] as UTSJSONObject[],
      hasConditionsData: false,
      avatarUpdating: false,
      avatarLetter: 'U',
      avatarPillsVisible: false,
      avatarPickerVisible: false,
      avatarDisplayUrl: '',
      mood: DEFAULT_MOOD as string,
      rawHeight: null as number | null,
      rawWeight: null as number | null,
      rawBmi: '',
      editing: false,
      editSaving: false,
      editOtherSelected: false,
      // miniapp editForm object, flattened to plain v-model-able fields for uvue
      editNickname: '',
      editGenderSel: '',
      editBirthDate: '',
      editHeightStr: '',
      editWeightStr: '',
      editCondOtherStr: '',
      editConditions: [] as string[],
      editConditionOptions: [] as UTSJSONObject[],
      // Health reports
      healthReports: [] as UTSJSONObject[],
      reportsLoading: false,
      activeReport: null as UTSJSONObject | null,
      activeReportEvents: [] as UTSJSONObject[],
      activeReportOtherItems: [] as UTSJSONObject[],
      activeReportDiag: [] as string[],
      activeReportAdvice: [] as string[],
      activeReportDoctorNotes: null as UTSJSONObject | null,
      reportDetailLoading: false,
      // Health tags (populated from /api/health-twin response)
      healthTags: [] as UTSJSONObject[],
      // Lab panel (from digital twin)
      labPanel: [] as UTSJSONObject[],
      labPanelDate: '',
      labPanelAbnormal: 0,
      labPanelMeta: '',
      labSeries: { } as UTSJSONObject,
      labChartOpen: false,
      labChartKey: '',
      labChartTitle: '',
      labChartUnit: '',
      labChartW: 0,
      // Digital twin
      twinLoading: true,
      hasTwinData: false,
      twinMetrics: [] as UTSJSONObject[],
      twinBody: '',
      twinLayers: [] as UTSJSONObject[],
      twinLayersDone: 0,
      twinRaw: null as UTSJSONObject | null,
      userFacts: [] as UTSJSONObject[],
      userFactsLoaded: false,
      // 综合报告 card (completed AG artifacts, /api/twin-reports)
      twinReports: [] as UTSJSONObject[],
      twinReportLatest: null as UTSJSONObject | null,
      twinReportOpening: false,
      foodPanel: null as UTSJSONObject | null,
      foodPositives: [] as UTSJSONObject[],
      foodSummary: '',
      healthScore: null as number | null,
      healthScoreColor: '#A6C4E5',
      healthScoreGrade: '',
      healthDomains: [] as UTSJSONObject[],
      vitalGauges: [] as UTSJSONObject[],
      twinBodyBar: null as UTSJSONObject | null,
      // Wearable device
      wearableId: '',
      wearableName: '',
      wearableBrand: '', // 'halo' | 'v8' (legacy stored value: 'x3')
      wearableConnected: false,
      wearableBattery: 0,
      wearableBusy: false,
      wearableServerHint: null as UTSJSONObject | null, // { brand, mac, name, boundAt }
      ringMeasuring: false,
      showPrivacyPopup: false,
      ringSettingsOpen: false,
      ringSettingsBusy: false,
      ringData: null as UTSJSONObject | null,
      // Halo background-measurement intervals (minutes per metric type)
      haloIntervals: { hr: 30, spo2: 60, temp: 60, hrv: 120 } as UTSJSONObject,
      haloIntervalOpts: { hr: [5, 10, 15, 30], spo2: [5, 15, 30, 60], temp: [15, 30, 60], hrv: [30, 60, 120] } as UTSJSONObject,
      haloWorkModes: { hr: 2, spo2: 2, temp: 2, hrv: 2 } as UTSJSONObject,
      haloIntervalsChanged: false,
      haloRingTime: '',
      // docCount / latestDocDate are reported by <health-documents> (§34 layer 3); they stay
      // at 0/'' until that component is ported (TODO(port)).
      docCount: 0,
      latestDocDate: '',
      // View-based chart layouts replacing the canvases (see header)
      bioAgeChart: null as UTSJSONObject | null,
      bioAgeCross: -1,
      lineChart: null as UTSJSONObject | null,
      lcCrossIdx: -1,
      crossInfo: null as UTSJSONObject | null,
      bpChartLayout: null as UTSJSONObject | null,
      // internal bookkeeping (miniapp instance fields)
      _twinLoadedAt: 0,
      _avatarPillTimer: 0,
      _flashTimer: 0,
      rpxRatio: 0.5,
      _chartLayouts: new Map<string, ChartLayout>(),
      _lastCrosshairIdx: new Map<string, number>(),
      _pinch: null as PinchStepper | null,
    }
  },

  computed: {
    // the miniapp's wx:if="{{index > 0 && index < 5}}" rows of the strip history lists
    ecgListTail() : UTSJSONObject[] {
      return this.ecgList.length > 1 ? this.ecgList.slice(1, Math.min(5, this.ecgList.length)) : ([] as UTSJSONObject[])
    },
    ppgListTail() : UTSJSONObject[] {
      return this.ppgList.length > 1 ? this.ppgList.slice(1, Math.min(5, this.ppgList.length)) : ([] as UTSJSONObject[])
    },
    anyChartModalOpen() : boolean {
      return this.weightChartOpen || this.bmiChartOpen || this.stepsChartOpen || this.hrvChartOpen
        || this.stressChartOpen || this.glucoseChartOpen || this.subAgeChartOpen || this.labChartOpen
    },
    chartModalW() : number {
      if (this.weightChartOpen) return this.weightChartW
      if (this.bmiChartOpen) return this.bmiChartW
      if (this.stepsChartOpen) return this.stepsChartW
      if (this.hrvChartOpen) return this.hrvChartW
      if (this.stressChartOpen) return this.stressChartW
      if (this.glucoseChartOpen) return this.glucoseChartW
      if (this.subAgeChartOpen) return this.subAgeChartW
      if (this.labChartOpen) return this.labChartW
      return 0
    },
    chartModalCanvasId() : string {
      if (this.weightChartOpen) return 'uh-weight-chart-full'
      if (this.bmiChartOpen) return 'uh-bmi-chart'
      if (this.stepsChartOpen) return 'uh-steps-chart'
      if (this.hrvChartOpen) return 'uh-hrv-chart'
      if (this.stressChartOpen) return 'uh-stress-chart'
      if (this.glucoseChartOpen) return 'uh-glucose-chart'
      if (this.subAgeChartOpen) return 'uh-subage-chart'
      if (this.labChartOpen) return 'uh-lab-chart'
      return ''
    },
    chartModalTitle() : string {
      if (this.weightChartOpen) return this.tt('weightTrend')
      if (this.bmiChartOpen) return 'BMI'
      if (this.stepsChartOpen) return this.tt('ringSteps')
      if (this.hrvChartOpen) return 'HRV'
      if (this.stressChartOpen) return this.tt('ringStress')
      if (this.glucoseChartOpen) return this.tt('metricGlucose')
      if (this.subAgeChartOpen) return this.ttk('subAgeLabels', this.subAgeChartKey)
      if (this.labChartOpen) return this.labChartUnit.length > 0 ? `${this.labChartTitle} (${this.labChartUnit})` : this.labChartTitle
      return ''
    },
  },

  // observers → watch. Composite observers split into per-key watchers that recompute the
  // same derived state; behaviour matches the miniapp's observers.
  watch: {
    'wearableId'(_v : string) { this._recomputeEcgSupported() },
    'wearableBrand'(_v : string) { this._recomputeEcgSupported() },
    'mode'(_v : string) { this._recomputeEcgSupported(); this._recomputeShowAgTab() },
    'userId'(newId : string) {
      if (newId.length == 0) return
      this._loadHealth()
      // attached() calls _loadWearableFromStorage()/_loadRingDataFromServer() unconditionally,
      // but their server-dependent paths need userId, which may not have been bound yet at
      // that exact synchronous tick (a race with the parent page's own async user-fetch/login).
      // Retry once it's actually available — safe to re-run, it just re-reads current state.
      if (this.mode == 'coach') {
        this._loadRingDataFromServer()
      } else {
        this._loadWearableFromStorage()
      }
    },
    'lang'(newLang : string) {
      const isZh = newLang != 'en'
      const t = tOf(newLang)
      this.t = t
      this.isZh = isZh
      this.insightsView = _buildInsightsView(this.insights, t)
      if (this.userId.length > 0 && !this.bioLoading) this._loadHealth()
    },
    'user'(newUser : any | null) {
      if (newUser != null) {
        const u = this.userObj()
        if (u != null) {
          const nickname = u!.getString('nickname')
          const src = nickname != null && nickname!.length > 0 ? nickname : 'U'
          const last = src!.substring(src!.length - 1)
          this.avatarLetter = last.toUpperCase()
        }
      }
      this._refreshAvatarDisplay()
    },
    'mood'(_v : string) {
      this._refreshAvatarDisplay()
    },
    // Self view only: a coach has no upload story and no notification channel for results,
    // and these are the most sensitive documents in the system.
    'vivaAgEnabled'(_v : boolean) { this._recomputeShowAgTab() },
    'isGuest'(_v : boolean) { this._recomputeShowAgTab() },
    // Changing text size reflows everything below it, which invalidates the page-relative
    // rect the crosshair falls back to. uh-subage-chart re-caches on every modal open, so
    // only the inline BioAge chart needs this.
    'textScale'(_v : number) {
      if (this.bioAgeTrendOpen) this._cacheChartRect('dt-bioage-chart')
    },
  },

  // The miniapp's `lifetimes.attached` has no uvue equivalent inside a `lifetimes` block —
  // uni-app x components run mounted()/unmounted() as top-level options, so the old block
  // never fired (health tab server-hydration silently dead). Converted 2026-10-01.
  mounted() {
    const lang = this.lang.length > 0 ? this.lang : 'zh'
    this.t = tOf(lang)
    this.isZh = lang != 'en'
    const u = this.userObj()
    if (u != null) {
      const nickname = u!.getString('nickname')
      const src = nickname != null && nickname!.length > 0 ? nickname : 'U'
      const last = src!.substring(src!.length - 1)
      this.avatarLetter = last.toUpperCase()
    }
    try {
      const win = uni.getWindowInfo()
      this.rpxRatio = win.windowWidth / 750
    } catch (e : any) {}
    if (this.userId.length > 0) this._loadHealth()
    if (this.mode == 'coach') {
      this._loadRingDataFromServer()
    } else {
      this._loadWearableFromStorage()
    }
    // TODO(port): the miniapp registers with app._onPrivacyRequest so WeChat's
    // onNeedPrivacyAuthorization can pop this component's consent card. Native apps get OS
    // permission prompts instead — nothing registers here.
  },
  unmounted() {
    if (_privacyResolve != null) { /* miniapp cleared app._onPrivacyRequest */ }
  },

  methods: {
    // ── template accessors (delegate to the module helpers) ──
    sget(o : UTSJSONObject | null, k : string) : string { return g_sget(o, k) },
    nget(o : UTSJSONObject | null, k : string) : number { return g_nget(o, k) },
    bget(o : UTSJSONObject | null, k : string) : boolean { return g_bget(o, k) },
    aget(o : UTSJSONObject | null, k : string) : UTSJSONObject[] { return g_aget(o, k) },
    ags(o : UTSJSONObject | null, k : string) : string[] { return g_ags(o, k) },
    jget(o : UTSJSONObject | null, k : string) : UTSJSONObject | null { return g_jget(o, k) },
    snum(o : UTSJSONObject | null, k : string) : string { return g_snum(o, k) },
    hasKey(o : UTSJSONObject | null, k : string) : boolean { return g_hasKey(o, k) },
    an(o : UTSJSONObject | null, k : string) : number { return nget(o, k) },
    al(o : UTSJSONObject | null, k : string) : string { return sget(o, k) },
    aln(o : UTSJSONObject | null, k : string) : string { return sget(o, k) },
    tt(path : string) : string { return tnum(this.t, path) },
    ttk(section : string, key : string) : string { return tk(this.t, section, key) },
    tta(section : string, idx : number) : string { return tarr(this.t, section, idx) },
    adviceIdx(i : number) : number { return i + 1 },
    rpx(n : number) : number { return Math.round(n * this.rpxRatio) },
    rp(n : number) : string { return `${Math.round(n * this.rpxRatio)}` },

    // Status colours in light theme map to darker same-hue variants (mirrors the wxs `tc`
    // module of user-health.wxml verbatim, including the comment: an inline style beats the
    // .theme-light WXSS overrides). Chart fills/bars keep the original bright hexes.
    tc(hex : string | null) : string {
      if (this.theme != 'light' || hex == null || hex!.length == 0) return hex ?? ''
      const LIGHT = new Map<string, string>()
      LIGHT.set('#0ea5e9', '#0369A1'); LIGHT.set('#10b981', '#0A7350'); LIGHT.set('#f97316', '#B45309')
      LIGHT.set('#ef4444', '#C0392B'); LIGHT.set('#f472b6', '#BE185D'); LIGHT.set('#c084d4', '#8B3FA8')
      LIGHT.set('#6375ec', '#4F46E5'); LIGHT.set('#a855f7', '#7E22CE'); LIGHT.set('#34d399', '#0F7A52')
      LIGHT.set('#f59e0b', '#8A5A06'); LIGHT.set('#a6c4e5', '#556F8A')
      LIGHT.set('rgba(166,196,229,0.55)', '#556F8A')
      const v = LIGHT.get(hex!.toLowerCase())
      return v != null ? v : hex!
    },

    // tc() + a hex-alpha suffix ('#f97316' + '55') is NOT parseable by Android's color parser
    // (#RRGGBBAA is rejected; it expects #AARRGGBB) — the whole declaration was dropped and the
    // border rendered invisible. Compose rgba() instead.
    tcA(hex : string | null, alpha : number) : string {
      const rgb = _hexRgb(this.tc(hex))
      return 'rgba(' + rgb[0] + ',' + rgb[1] + ',' + rgb[2] + ',' + alpha + ')'
    },

    userObj() : UTSJSONObject | null {
      const u : any | null = this.user
      if (u == null) return null
      if (u instanceof UTSJSONObject) return u as UTSJSONObject
      return null
    },

    szZ(key : string) : UTSJSONObject | null { return jget(this.subAgeZ, key) },
    szS(key : string, field : string) : string { return sget(this.szZ(key), field) },
    szB(key : string, field : string) : boolean { return bget(this.szZ(key), field) },

    subAgeArr(key : string) : UTSJSONObject[] { return this.subAgeHistory.get(key) ?? ([] as UTSJSONObject[]) },
    subAgeHasTrend(key : string) : boolean { return this.subAgeArr(key).length > 1 },

    iv(k : string) : number { return nget(this.insightsView, k) - (hasKey(this.insightsView, k) ? 0 : 1000000) },
    bandObj() : UTSJSONObject | null { return jget(this.insightsView, 'band') },
    slObj() : UTSJSONObject | null { return jget(this.insightsView, 'sleep') },
    stObj() : UTSJSONObject | null { return jget(this.insightsView, 'stress') },

    wmLabel(type : string) : string {
      const wm = nget(this.haloWorkModes, type)
      return wm == 0 ? this.tt('haloWorkModeOff') : (wm == 2 ? this.tt('haloWorkModeSched') : this.tt('haloWorkModeAuto'))
    },
    hopt(type : string) : number[] {
      const a = this.haloIntervalOpts.getArray<number>(type)
      return a != null ? a : ([] as number[])
    },

    chartBool(section : string, k : string) : boolean { return bget(jget(this.ringData, section), k) },
    chartStr(section : string, k : string) : string { return sget(jget(this.ringData, section), k) },
    chartNum(section : string, k : string) : number { return nget(jget(this.ringData, section), k) },
    chartNumStr(section : string, k : string) : string { return snum(jget(this.ringData, section), k) },
    chartBars(section : string) : UTSJSONObject[] {
      const c = jget(this.ringData, section)
      if (c == null) return [] as UTSJSONObject[]
      const arr = c!.get('bars')
      if (arr == null) return [] as UTSJSONObject[]
      if (arr instanceof Array) {
        const out : UTSJSONObject[] = []
        for (const it of (arr as Array<any>)) { if (it instanceof UTSJSONObject) out.push(it as UTSJSONObject) }
        return out
      }
      return [] as UTSJSONObject[]
    },
    barH(item : UTSJSONObject) : number {
      const h = nget(item, 'heightRpx')
      return h > 0 ? h : 3
    },
    hrBarPct() : number {
      const hr = nget(this.ringData, 'restingHr')
      return hr < 65 ? 90 : (hr < 80 ? 65 : 40)
    },

    abioGet() : UTSJSONObject | null { return this.bioAgeChart },
    abioArr(k : string) : UTSJSONObject[] { return aget(this.bioAgeChart, k) },
    abioN(k : string) : number { return nget(this.bioAgeChart, k) },
    abioS(k : string) : string { return sget(this.bioAgeChart, k) },
    abioPt(_which : string) : UTSJSONObject | null {
      const pts = this.abioArr('pts')
      if (this.bioAgeCross < 0 || this.bioAgeCross >= pts.length) return null
      return pts[this.bioAgeCross]
    },
    bioAgeCrossBoxStyle() : string {
      const box = jget(this.bioAgeChart, 'crossBox')
      if (box == null) return ''
      return `left:${an(box, 'x')}px;top:${an(box, 'y')}px;width:${an(box, 'w')}px;height:${an(box, 'h')}px;`
    },
    lcN(k : string) : number { return nget(this.lineChart, k) },
    lcS(k : string) : string { return sget(this.lineChart, k) },
    crossPt() : UTSJSONObject | null {
      const pts = aget(this.lineChart, 'pts')
      if (this.lcCrossIdx < 0 || this.lcCrossIdx >= pts.length) return null
      return pts[this.lcCrossIdx]
    },
    crossBoxStyle() : string {
      if (this.crossInfo == null) return ''
      const box = jget(this.crossInfo, 'box')
      if (box == null) return ''
      return `left:${an(box, 'x')}px;top:${an(box, 'y')}px;width:${an(box, 'w')}px;height:${an(box, 'h')}px;`
    },
    bpN(k : string) : number { return nget(this.bpChartLayout, k) },

    noop() { },
    // user-health's _req resolves with the whole response envelope {statusCode, data}
    // (miniapp parity: callers read res.data.success / res.data.error directly).
    async _req(url : string, method : string, data : UTSJSONObject | null) : Promise<RespEnvelope> {
      if (method == 'POST') return _envelopeRun(url, 'POST', data)
      if (method == 'PUT') return _envelopeRun(url, 'PUT', data)
      if (method == 'DELETE') return _envelopeRun(url, 'DELETE', data)
      if (method == 'PATCH') return _envelopeRun(url, 'PATCH', data)
      return _envelopeRun(url, 'GET', data)
    },

    // observers['vivaAgEnabled, mode, isGuest'] — losing entitlement while parked on the AG
    // tab would otherwise leave a blank pane.
    _recomputeShowAgTab() {
      const showAgTab = this.vivaAgEnabled && this.mode == 'self' && !this.isGuest
      this.showAgTab = showAgTab
      if (!showAgTab && this.healthSubTab != 'twin') this.healthSubTab = 'twin'
    },

    // ECG is V8-only (the ring has no electrode); the pulse wave streams from both (§18, §45).
    _recomputeEcgSupported() {
      const brand = _normalizeBrand(this.wearableBrand)
      // '__server__' is the placeholder for a binding known only from the server (no local BLE id).
      const bound = this.mode == 'self' && this.wearableId.length > 0 && this.wearableId != '__server__'
      const ecg = bound && brand == 'v8'
      const ppg = bound && (brand == 'v8' || brand == 'halo')
      if (ecg != this.ecgSupported) this.ecgSupported = ecg
      if (ppg != this.ppgSupported) this.ppgSupported = ppg
    },

    refresh() {
      this._loadHealth()
    },

    /**
     * Re-reads every Digital Twin layer from the server if the last load is stale.
     *
     * The health tab is the Twin, but the component only loaded on `attached()` and on a
     * `userId`/`lang` change — so anything written after that (a fact the AI extracted from
     * chat, a weight recorded in conversation, a lab report just uploaded) stayed invisible
     * until the app was restarted. Confirmed live: stating "我对海鲜过敏" in chat wrote
     * `user_memory_facts` within seconds, but the Personal Profile section still showed the
     * old list after switching back to the health tab.
     *
     * Mirrors the staleness pattern pages/main's switchTab already uses for the plans/dots
     * tabs, rather than refetching on every tab tap.
     */
    refreshIfStale(maxAgeMs : number = 30000) {
      if (this.userId.length == 0) return
      if (this.bioLoading) return
      if (this._twinLoadedAt > 0 && Date.now() - this._twinLoadedAt < maxAgeMs) return
      this._loadHealth()
    },

    async _loadHealth() {
      this._twinLoadedAt = Date.now()
      const userId = this.userId
      const user = this.userObj()
      const lang = this.lang
      const mode = this.mode
      if (userId.length == 0) return
      const rawT = tOf(lang)
      // channel sub-age display-name overrides (§11 key_name rule; state replaces globalData)
      let channelOverrides : UTSJSONObject | null = null
      const ch = state.channel
      if (ch != null) {
        const o = ch!.get('sub_age_display_names')
        if (o instanceof UTSJSONObject) channelOverrides = o as UTSJSONObject
      }
      const t = { } as UTSJSONObject
      rawT.toMap().forEach((v : any | null, k : string) => { t[k] = v })
      t['subAgeLabels'] = buildSubAgeLabels(rawT.getJSON('subAgeLabels')!, channelOverrides, lang)
      this.t = t
      this.bioLoading = true
      this._loadHealthTwin()
      this._loadHealthReports()
      this._loadUserFacts()
      this._loadFoodSensitivity()
      this._loadTwinReports()
      this._loadMetricHistory()
      this._loadWearableInsights()
      this._loadEcg()
      try {
        const res = await this._req(`${BASE}/api/biomarkers?openid=${encodeURIComponent(userId)}`, 'GET', null)
        const body = res.data
        const records = body != null ? (body!.getArray<UTSJSONObject>('records') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        const kinoRecords = records.filter((r) : boolean => r.getString('test_type') == 'kino_chip')
        let latestAnalyzed : UTSJSONObject | null = null
        for (let i = kinoRecords.length - 1; i >= 0; i--) {
          const r = kinoRecords[i]
          const d = r.getJSON('data')
          if (d != null && d!.getJSON('validated') != null) { latestAnalyzed = r; break }
        }
        const latestBm = latestAnalyzed != null ? latestAnalyzed!.getJSON('data')!.getJSON('validated') : null

        const bmList : UTSJSONObject[] = BM_META.map((m) : UTSJSONObject => {
          const key = sget(m, 'key')
          return { key: key, label: tk(t, 'bmLabels', key), unit: sget(m, 'unit'), color: sget(m, 'color'), value: latestBm != null ? latestBm!.get(key) : null } as UTSJSONObject
        })

        const trendList : UTSJSONObject[] = BM_META.map((m) : UTSJSONObject => {
          const key = sget(m, 'key')
          const color = sget(m, 'color')
          const win = kinoRecords.length > 10 ? kinoRecords.slice(kinoRecords.length - 10) : kinoRecords
          const allVals : (number | null)[] = win.map((r) : number | null => {
            const d = r.getJSON('data')
            if (d == null) return null
            const v = d!.getJSON('validated')
            if (v == null) return null
            return v!.getNumber(key)
          })
        const defined : number[] = []
          for (const v of allVals) { if (v != null) defined.push(v!) }
          const min = defined.length > 0 ? _minOf(defined) : 0
          const max = defined.length > 0 ? _maxOf(defined) : 1
          const range = (max - min) == 0 ? 1 : max - min
          const sparkBars : UTSJSONObject[] = allVals.map((v : number | null) : UTSJSONObject => v != null
            ? { h: Math.round(6 + ((v! - min) / range) * 26), color: color, empty: false } as UTSJSONObject
            : { h: 6, color: color, empty: true } as UTSJSONObject
          )
          const lastVal : number | null = defined.length > 0 ? defined[defined.length - 1] : null
          return {
            key: key, label: tk(t, 'bmLabels', key), unit: sget(m, 'unit'), color: color,
            lastVal: lastVal, lastValStr: lastVal != null ? `${lastVal}` : '', sparkBars: sparkBars,
          } as UTSJSONObject
        })

        const cAge = user != null ? chronoAge(user!.getString('birth_date')) : null

        let subAgesRaw : UTSJSONObject | null = null
        if (latestAnalyzed != null) {
          const prof = latestAnalyzed!.getJSON('data')!.getJSON('bioage_profile')
          if (prof != null) subAgesRaw = prof!.getJSON('SubAges')
        }
        const subAgeList : UTSJSONObject[] = subAgesRaw != null
          ? SUB_AGE_META.map((m) : UTSJSONObject => {
              const key = sget(m, 'key')
              const rawVal = subAgesRaw!.getNumber(key)
              const valStr = rawVal != null ? rawVal!.toFixed(1) : '—'
              const score = rawVal != null && cAge != null
                ? Math.max(5, Math.min(95, Math.round((cAge! + 15 - rawVal!) / 30 * 100)))
                : 50
              return { key: key, label: tk(t, 'subAgeLabels', key), color: sget(m, 'color'), value: valStr, score: score } as UTSJSONObject
            })
          : ([] as UTSJSONObject[])

        const baDateMap = new Map<string, UTSJSONObject>()
        for (const r of kinoRecords) {
          if (r.getNumber('bio_age') != null) {
            const d = sget(r, 'tested_at').substring(0, 10)
            baDateMap.set(d, r)
          }
        }
        const mapVals : UTSJSONObject[] = []
        baDateMap.forEach((v : UTSJSONObject, _k : string) => { mapVals.push(v) })
        const sortedRecords = mapVals.slice().sort((a, b) : number => (sget(a, 'tested_at') < sget(b, 'tested_at') ? -1 : 1))
        const bioAgeHistory : UTSJSONObject[] = sortedRecords.map((r) : UTSJSONObject => {
          const prof = r.getJSON('data')!.getJSON('bioage_profile')
          return {
            date: sget(r, 'tested_at').substring(0, 10),
            bioAge: r.getNumber('bio_age'),
            chronoAge: prof != null ? prof!.get('ChronoAge') : null,
          } as UTSJSONObject
        })
        let winW = 375
        try { winW = uni.getWindowInfo().windowWidth } catch (e : any) {}
        const bioAgeChartW = Math.round(winW * 330 / 750)

        const subAgeHistory = new Map<string, UTSJSONObject[]>()
        for (const key of SUB_AGE_KEYS) {
          const rows = sortedRecords.filter((r) : boolean => {
            const prof = r.getJSON('data')
            if (prof == null) return false
            // SubAges lives under data.bioage_profile (the miniapp filter reads the same path) —
            // reading data.SubAges here matched nothing and silently killed the trend chevrons.
            const bp = prof!.getJSON('bioage_profile')
            if (bp == null) return false
            const sa = bp!.getJSON('SubAges')
            if (sa == null) return false
            return sa!.getNumber(key) != null
          })
          subAgeHistory.set(key, rows.map((r) : UTSJSONObject => {
            const sa = r.getJSON('data')!.getJSON('bioage_profile')!.getJSON('SubAges')!
            return { date: sget(r, 'tested_at').substring(0, 10), value: sa.getNumber(key) } as UTSJSONObject
          }))
        }

        let rawBioAge : string | null = null
        // bio_age is a JSON NUMBER — sget (getString) yields '' for it and parseFloat('') is NaN.
        if (latestAnalyzed != null && latestAnalyzed!.getNumber('bio_age') != null) {
          rawBioAge = `${latestAnalyzed!['bio_age']}`
        } else if (kinoRecords.length > 0) {
          const lastVal = kinoRecords[kinoRecords.length - 1].getNumber('bio_age')
          if (lastVal != null) rawBioAge = `${kinoRecords[kinoRecords.length - 1]['bio_age']}`
        }
        if (rawBioAge == null && user != null && user!.getNumber('bio_age') != null) {
          rawBioAge = `${user!['bio_age']}`
        }
        const bAge = rawBioAge != null ? (parseFloat(rawBioAge!).toFixed(1)) : ''

        const slMap = new Map<string, UTSJSONObject>()
        for (const s of subAgeList) slMap.set(sget(s, 'key'), s)
        const subAgeZ = { } as UTSJSONObject
        for (const m of SUB_AGE_META) {
          const key = sget(m, 'key')
          const sa = slMap.get(key)
          const score = sa != null ? nget(sa, 'score') : 50
          const color = sa == null ? '#2a3550' : score >= 60 ? '#10b981' : score >= 35 ? '#6375EC' : '#f97316'
          const alpha = sa == null ? 0.2 : score >= 60 ? 0.16 : score >= 35 ? 0.22 : 0.35
          const rgbArr = _hexRgb(color)
          subAgeZ[key] = {
            color: color, fill: `rgba(${rgbArr[0]},${rgbArr[1]},${rgbArr[2]},${alpha})`,
            glow: score < 35 ? 14 : 6, pulse: sa != null,
          } as UTSJSONObject
        }

        this.bAge = bAge
        this.cAge = cAge
        this.bAgeColor = bioAgeColor(rawBioAge, cAge)
        this.subAgeList = subAgeList
        this.subAgeZ = subAgeZ
        this.bmList = bmList
        this.trendList = trendList
        this.recordCount = kinoRecords.length
        this.hasBm = latestBm != null
        this.bioAgeHistory = bioAgeHistory
        this.bioAgeChartW = bioAgeChartW
        this.subAgeHistory = subAgeHistory
        this.bioLoading = false

        if ((mode == 'self' || mode == 'coach') && user != null) {
          const bodyRecords = records.filter((r) : boolean => r.getString('test_type') == 'body_composition').slice().reverse()
          let heightVal : number | null = null
          let weightVal : number | null = null
          for (const r of bodyRecords) {
            const d = r.getJSON('data')
            if (d == null) continue
            const actual = d!.getJSON('actual')
            if (actual == null) continue
            if (heightVal == null && actual!.getNumber('height') != null) heightVal = actual!.getNumber('height')
            if (weightVal == null && actual!.getNumber('weight') != null) weightVal = actual!.getNumber('weight')
          }
          const bioData = user!.getJSON('bio_data')
          if (heightVal == null && bioData != null) heightVal = bioData!.getNumber('height')
          if (weightVal == null && bioData != null) weightVal = bioData!.getNumber('weight')

          const weightHistory : UTSJSONObject[] = []
          for (const r of records) {
            if (r.getString('test_type') != 'body_composition') continue
            const d = r.getJSON('data')
            if (d == null) continue
            const actual = d!.getJSON('actual')
            if (actual == null) continue
            const w = actual!.getNumber('weight')
            if (w != null) weightHistory.push({ date: sget(r, 'tested_at').substring(0, 10), weight: w } as UTSJSONObject)
          }

          const bmiVal = (heightVal != null && weightVal != null && heightVal! > 0)
            ? ((weightVal!) / Math.pow((heightVal!) / 100, 2)).toFixed(1)
            : ''

          const bmiHistory : UTSJSONObject[] = (heightVal != null && heightVal! > 0)
            ? weightHistory.map((r) : UTSJSONObject => ({
                date: sget(r, 'date'),
                bmi: parseFloat((nget(r, 'weight') / Math.pow((heightVal!) / 100, 2)).toFixed(1)),
              } as UTSJSONObject))
            : ([] as UTSJSONObject[])

          const profileInfoVisible : UTSJSONObject[] = [
            { label: sget(t, 'weight'), val: weightVal != null ? `${weightVal} ${sget(t, 'bsKg')}` : '—', hasSparkline: true } as UTSJSONObject,
            { label: sget(t, 'bmi'), val: bmiVal.length > 0 ? bmiVal : '—' } as UTSJSONObject,
          ]
          const profileInfoExtra : UTSJSONObject[] = [
            { label: sget(t, 'gender'), val: tk(t, 'genderMap', user!.getString('gender')).length > 0 ? (user!.getString('gender') != null ? tk(t, 'genderMap', user!.getString('gender')) : '') : (user!.getString('gender') != null && user!.getString('gender')!.length > 0 ? user!.getString('gender') : '—') } as UTSJSONObject,
            { label: sget(t, 'born'), val: fmtDate(user!.get('birth_date'), lang) } as UTSJSONObject,
            { label: sget(t, 'height'), val: heightVal != null ? `${heightVal} ${sget(t, 'bsCm')}` : '—' } as UTSJSONObject,
            { label: sget(t, 'language'), val: tk(t, 'langMap', user!.getString('language')) } as UTSJSONObject,
            { label: sget(t, 'coach'), val: user!.getString('coach_name') != null && user!.getString('coach_name')!.length > 0 ? user!.getString('coach_name') : '—' } as UTSJSONObject,
            { label: sget(t, 'joined'), val: fmtDate(user!.get('created_at'), lang) } as UTSJSONObject,
            { label: sget(t, 'phone'), val: user!.getString('phone') != null && user!.getString('phone')!.length > 0 ? user!.getString('phone') : '—' } as UTSJSONObject,
            { label: sget(t, 'email'), val: user!.getString('email') != null && user!.getString('email')!.length > 0 ? user!.getString('email') : '—' } as UTSJSONObject,
          ]

          const condKeys = bioData != null ? bioData!.getArray<string>('health_conditions') : null
          const otherText = bioData != null ? (bioData!.getString('health_conditions_other') ?? '') : ''
          const healthConditionsList : UTSJSONObject[] = condKeys != null
            ? condKeys!.map((key : string) : UTSJSONObject => ({
                key: key,
                label: key == 'other' && otherText.length > 0
                  ? `${tk(t, 'conditionLabels', key)}（${otherText}）`
                  : (tk(t, 'conditionLabels', key).length > 0 ? tk(t, 'conditionLabels', key) : key),
              } as UTSJSONObject))
            : ([] as UTSJSONObject[])

          this.weightHistory = weightHistory
          this.bmiHistory = bmiHistory
          this.profileInfoVisible = profileInfoVisible
          this.profileInfoExtra = profileInfoExtra
          this.healthConditionsList = healthConditionsList
          this.hasConditionsData = condKeys != null
          this.rawHeight = heightVal
          this.rawWeight = weightVal
          this.rawBmi = bmiVal
        }

        if (mode == 'self' && this.weightHistory.length > 1) {
          this._drawWeightSparkline()
        }
        this._recomputeTwinLayers()
      } catch (e : any) {
        this.bioLoading = false
      }
    },

    // wx.createCanvasContext paints literal colors — CSS custom properties that theme the
    // rest of this component don't reach canvas draw calls, so every chart needs its own
    // light/dark palette read from this.theme. Kept for the layout builders' accents.
    _chartPalette() : UTSJSONObject {
      const isLight = this.theme == 'light'
      return isLight ? {
        bg: '#FFFFFF', accent: '#C9956A', accentRgb: '201,149,106', textPrimary: '#2C2C2C',
        textMuted55: 'rgba(139,110,78,0.65)', textMuted75: 'rgba(139,110,78,0.8)', textMuted45: 'rgba(139,110,78,0.5)',
        textMuted50: 'rgba(139,110,78,0.55)', textMuted28: 'rgba(139,110,78,0.35)', gridLine: 'rgba(201,149,106,0.15)',
        fillLight: 'rgba(201,149,106,0.12)', fillMed: 'rgba(201,149,106,0.22)', dotRing: 'rgba(255,255,255,0.9)',
        glow10: 'rgba(201,149,106,0.12)', glow22: 'rgba(201,149,106,0.28)', glow60: 'rgba(201,149,106,0.7)',
        line85: 'rgba(201,149,106,0.85)',
      } as UTSJSONObject : {
        bg: '#0a1228', accent: '#6375EC', accentRgb: '99,117,236', textPrimary: '#EEF2FF',
        textMuted55: 'rgba(166,196,229,0.55)', textMuted75: 'rgba(166,196,229,0.75)', textMuted45: 'rgba(166,196,229,0.45)',
        textMuted50: 'rgba(166,196,229,0.5)', textMuted28: 'rgba(166,196,229,0.28)', gridLine: 'rgba(99,117,236,0.12)',
        fillLight: 'rgba(99,117,236,0.1)', fillMed: 'rgba(99,117,236,0.22)', dotRing: 'rgba(10,15,30,0.9)',
        glow10: 'rgba(99,117,236,0.10)', glow22: 'rgba(99,117,236,0.22)', glow60: 'rgba(99,117,236,0.60)',
        line85: 'rgba(99,117,236,0.85)',
      } as UTSJSONObject
    },

    // The sparkline canvas (60×22) target no longer exists in this template — the miniapp's
    // profile-info block that rendered it was dropped from user-health.wxml, but the draw
    // call stayed live. The point math is kept verbatim; rendering is a TODO(port) if the
    // profile strip returns.
    _drawWeightSparkline() {
      const history = this.weightHistory
      if (history.length < 2) return
      const W = 60, H = 22, pad = 2
      const weights = history.map((r) : number => nget(r, 'weight'))
      const minW = _minOf(weights), maxW = _maxOf(weights)
      const range = (maxW - minW) == 0 ? 1 : maxW - minW
      const pts : UTSJSONObject[] = []
      for (let i = 0; i < weights.length; i++) {
        pts.push({
          x: pad + (i / (weights.length - 1)) * (W - pad * 2),
          y: pad + ((maxW - weights[i]) / range) * (H - pad * 2),
        } as UTSJSONObject)
      }
      // TODO(port): no canvas — sparkline geometry computed, not drawn.
    },

    // Analysis over the last 30 days of ring data (lib/wearableAnalysis.js), computed fresh
    // on the server. Self and coach view alike; the coach's own id rides along so the server
    // can run the same ownership check it runs for facts/documents. Never gated on
    // subAgeList (§34).
    async _loadWearableInsights() {
      const userId = this.userId
      if (userId.length == 0) return
      try {
        const coach = this.mode == 'coach' && this.coachId.length > 0 ? `&coach_id=${encodeURIComponent(this.coachId)}` : ''
        const res = await this._req(`${BASE}/api/wearable-insights?openid=${encodeURIComponent(userId)}${coach}`, 'GET', null)
        if (res.statusCode != 200 || (res.data != null && res.data!.getBoolean('success') == false)) {
          if (IS_DEV) console.error('[wearable][insights]', res.statusCode, res.data)
          return
        }
        const insights = res.data != null ? res.data!.getJSON('insights') : null
        // tOf directly, as _loadRingDataFromServer does — data.t may still be {} on first load
        this.insights = insights
        this.insightsView = _buildInsightsView(insights, tOf((this.lang.length > 0 ? this.lang : 'zh') != 'en' ? 'zh' : 'en'))
        this._applyBandToHrvBars()
      } catch (e : any) {
        if (IS_DEV) console.error('[wearable][insights]', e)
      }
    },

    // The 7-day HRV bars are coloured against the user's own band once it exists (in band =
    // neutral, below = amber, above = green) instead of the absolute cut _buildRingDisplayData
    // falls back to — a vendor HRV index has no meaningful absolute "good". Called after the
    // insights load and after every ringData rebuild, so a fresh sync never reverts colours.
    _applyBandToHrvBars() {
      const barsArr = this.ringData != null ? this.ringData!.getArray<UTSJSONObject>('hrvDayBars') : null
      const b = this.insights != null ? this.insights!.getJSON('baseline') : null
      if (barsArr == null || barsArr!.length == 0 || b == null) return
      const bandLow = b!.getNumber('band_low')
      const bandHigh = b!.getNumber('band_high')
      if (bandLow == null || bandHigh == null) return
      const recoloured : UTSJSONObject[] = barsArr!.map((bar : UTSJSONObject) : UTSJSONObject => {
        const avg = nget(bar, 'avg')
        const color = avg < bandLow! ? '#f59e0b' : (avg > bandHigh! ? '#10b981' : '#0ea5e9')
        const c = { } as UTSJSONObject
        bar.toMap().forEach((v : any | null, k : string) => { c[k] = v })
        c['color'] = color
        return c
      })
      if (this.ringData != null) {
        const rd = { } as UTSJSONObject
        this.ringData!.toMap().forEach((v : any | null, k : string) => { rd[k] = v })
        rd['hrvDayBars'] = recoloured
        this.ringData = rd
      }
    },

    // 心电节律 / 脉搏波 summaries — both kinds, same shape (GET /api/ecg, GET /api/ppg). Coach
    // view passes coach_id and the server re-checks users.coach_id.
    async _loadEcg() {
      await this._loadStrips('ecg')
      await this._loadStrips('ppg')
    },

    async _loadStrips(kind : string) {
      const userId = this.userId
      if (userId.length == 0 || this.isGuest) return
      try {
        const coach = this.mode == 'coach' && this.coachId.length > 0 ? `&coach_id=${encodeURIComponent(this.coachId)}` : ''
        const res = await this._req(`${BASE}/api/${kind}?openid=${encodeURIComponent(userId)}&limit=10${coach}`, 'GET', null)
        const body = res.data
        const ok = body != null && body!.getBoolean('success') == true
        const rawItems = ok ? (body!.getArray<UTSJSONObject>('items') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        const list : UTSJSONObject[] = rawItems.map((it : UTSJSONObject) : UTSJSONObject => {
          const c = { } as UTSJSONObject
          it.toMap().forEach((v : any | null, k : string) => { c[k] = v })
          c['whenLabel'] = this._ecgWhenLabel(it.getString('recorded_at'))
          return c
        })
        if (kind == 'ecg') { this.ecgList = list; this.ecgLatest = list.length > 0 ? list[0] : null }
        else { this.ppgList = list; this.ppgLatest = list.length > 0 ? list[0] : null }
      } catch (e : any) { /* the card simply shows its empty state */ }
      this._recomputeEcgSupported()
    },

    _ecgWhenLabel(iso : string | null) : string {
      const t = this.t
      if (iso == null) return ''
      const ms = _toMs(iso)
      if (isNaN(ms)) return ''
      const d = new Date(ms)
      const now = new Date()
      const sameDay = (a : Date, b : Date) : boolean => a.getFullYear() == b.getFullYear() && a.getMonth() == b.getMonth() && a.getDate() == b.getDate()
      const hm = `${_pad2n(d.getHours())}:${_pad2n(d.getMinutes())}`
      if (now.getTime() - ms < 5 * 60 * 1000) return tnum(t, 'ecgJustNow')
      if (sameDay(d, now)) return `${tnum(t, 'ecgToday')} ${hm}`
      const y = new Date(now.getTime() - 86400000)
      if (sameDay(d, y)) return `${tnum(t, 'ecgYesterday')} ${hm}`
      return `${d.getMonth() + 1}/${d.getDate()} ${hm}`
    },

    // One <strip-record> instance serves both kinds; the tap target's data-kind picks which.
    openEcgRecord(kind : string) {
      this._recomputeEcgSupported()
      const supported = kind == 'ppg' ? this.ppgSupported : this.ecgSupported
      if (!supported) return
      this.stripKind = kind
      this.stripViewId = 0
      this.ecgRecordOpen = true
      // TODO(port): strip-record overlay not yet ported; state wiring is complete.
    },
    // Tap a stored strip (hero or history row) → the same overlay, read-back from OSS. Self
    // and coach view alike; only self can delete (the component's read-only prop).
    openEcgView(kind : string, id : number) {
      if (id == 0) return
      this.stripKind = kind.length > 0 ? kind : 'ecg'
      this.stripViewId = id
      this.ecgRecordOpen = true
    },
    closeEcgRecord() { this.ecgRecordOpen = false; this.stripViewId = 0 },
    onEcgSaved(detail : UTSJSONObject | null) { this._loadStrips(sget(detail, 'kind').length > 0 ? sget(detail, 'kind') : 'ecg') },
    onEcgDeleted(detail : UTSJSONObject | null) { this._loadStrips(sget(detail, 'kind').length > 0 ? sget(detail, 'kind') : 'ecg') },

    async _loadMetricHistory() {
      const userId = this.userId
      if (userId.length == 0) return
      try {
        const res = await this._req(`${BASE}/api/health-events?openid=${encodeURIComponent(userId)}&limit=60`, 'GET', null)
        const body = res.data
        const events = body != null ? (body!.getArray<UTSJSONObject>('events') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        const seenSteps = new Set<string>()
        const seenHrv = new Set<string>()
        const seenStress = new Set<string>()
        const seenBp = new Set<string>()
        const seenGlucose = new Set<string>()
        const stepsHistory : UTSJSONObject[] = []
        const hrvHistory : UTSJSONObject[] = []
        const stressHistory : UTSJSONObject[] = []
        const bpHistory : UTSJSONObject[] = []
        const glucoseHistory : UTSJSONObject[] = []
        for (const ev of events) {
          const date = sget(ev, 'data_date').substring(0, 10)
          if (date.length == 0) continue
          const d = this._pd(ev.get('data'))
          if (d == null) continue
          if (sget(ev, 'category') == 'activity' && !seenSteps.has(date) && d!.getNumber('steps') != null) {
            stepsHistory.push({ date: date, steps: d!.get('steps') } as UTSJSONObject)
            seenSteps.add(date)
          } else if (sget(ev, 'category') == 'vitals') {
            if (!seenHrv.has(date) && d!.getNumber('hrv_ms') != null) {
              hrvHistory.push({ date: date, hrv: d!.get('hrv_ms') } as UTSJSONObject); seenHrv.add(date)
            }
            if (!seenStress.has(date) && d!.getNumber('stress') != null) {
              stressHistory.push({ date: date, stress: d!.get('stress') } as UTSJSONObject); seenStress.add(date)
            }
            // Ring-derived BP (source 'smart_ring') is inferred from HRV pulse-wave data, not a
            // real cuff reading, and is unreliable until calibrated against an actual BP device
            // — only surface BP the user uploaded themselves (e.g. a cuff photo).
            if (!seenBp.has(date) && USER_UPLOADED_BP_SOURCES.has(sget(ev, 'source'))
              && d!.getNumber('bp_systolic') != null && d!.getNumber('bp_diastolic') != null) {
              bpHistory.push({ date: date, systolic: d!.get('bp_systolic'), diastolic: d!.get('bp_diastolic'), pulse: d!.getNumber('bp_pulse') ?? null } as UTSJSONObject)
              seenBp.add(date)
            }
            if (!seenGlucose.has(date) && d!.getNumber('glucose_mmol') != null) {
              glucoseHistory.push({ date: date, glucose: d!.get('glucose_mmol') } as UTSJSONObject); seenGlucose.add(date)
            }
          }
        }
        const bpHistoryRev = bpHistory.slice().reverse()
        const glucoseHistoryRev = glucoseHistory.slice().reverse()
        this.stepsHistory = stepsHistory.slice().reverse()
        this.hrvHistory = hrvHistory.slice().reverse()
        this.stressHistory = stressHistory.slice().reverse()
        this.bpHistory = bpHistoryRev
        this.latestBp = bpHistoryRev.length > 0 ? bpHistoryRev[bpHistoryRev.length - 1] : null
        this.glucoseHistory = glucoseHistoryRev
        this.latestGlucose = glucoseHistoryRev.length > 0 ? glucoseHistoryRev[glucoseHistoryRev.length - 1] : null
      } catch (e : any) { /* non-critical */ }
    },

    // health_events.data arrives either as a JSON string or as an object.
    _pd(data : any | null) : UTSJSONObject | null {
      if (data == null) return null
      if (data instanceof UTSJSONObject) return data as UTSJSONObject
      try {
        const parsed : any | null = JSON.parse(`${data}`)
        if (parsed instanceof UTSJSONObject) return parsed as UTSJSONObject
        return null
      } catch (e : any) {
        return null
      }
    },

    async _loadHealthTwin() {
      const userId = this.userId
      if (userId.length == 0) return
      const lang = this.lang
      const isZh = (lang.length > 0 ? lang : 'zh') != 'en'
      const t = isZh ? T_ZH : T_EN
      try {
        const res = await this._req(`${BASE}/api/health-twin?openid=${encodeURIComponent(userId)}`, 'GET', null)
        const body = res.data
        const twin = body != null ? body!.getJSON('twin') : null
        if (twin == null) { this.hasTwinData = false; this.twinLoading = false; return }

        const trendIcon = (v : string) : string => v == 'improving' ? '↑' : v == 'declining' ? '↓' : v == 'stable' ? '→' : ''
        const trendColor = (v : string) : string => v == 'improving' ? '#10b981' : v == 'declining' ? '#ef4444' : 'rgba(166,196,229,0.35)'

        const metrics : UTSJSONObject[] = []
        const td = twin!.getJSON('trend_data') ?? ({ } as UTSJSONObject)

        const avgSleep = twin!.getNumber('avg_sleep_hours')
        if (avgSleep != null) {
          const avgScore = twin!.getNumber('avg_sleep_score')
          const score = avgScore != null ? `${tnum(t, 'dtSleepScore')} ${Math.round(avgScore!)}` : tnum(t, 'dtSevenDay')
          metrics.push({
            key: 'sleep', label: isZh ? '睡眠' : 'Sleep',
            val: avgSleep!.toFixed(1), unit: 'h', sub: score,
            deepPct: twin!.getNumber('avg_deep_sleep_pct') != null ? Math.round(twin!.getNumber('avg_deep_sleep_pct')!) : null,
            trend: trendIcon(sget(td, 'sleep_trend')), trendColor: trendColor(sget(td, 'sleep_trend')),
            color: '#6375EC',
          } as UTSJSONObject)
        }

        const avgHrv = twin!.getNumber('avg_hrv_ms')
        if (avgHrv != null) {
          metrics.push({
            key: 'hrv', label: 'HRV',
            val: `${Math.round(avgHrv!)}`, unit: 'ms', sub: tnum(t, 'dtSevenDay'),
            trend: trendIcon(sget(td, 'hrv_trend')), trendColor: trendColor(sget(td, 'hrv_trend')),
            color: '#10b981',
          } as UTSJSONObject)
        }

        const avgSteps = twin!.getNumber('avg_daily_steps')
        if (avgSteps != null) {
          metrics.push({
            key: 'steps', label: isZh ? '步数' : 'Steps',
            val: toLocaleInt(avgSteps!), unit: '', sub: tnum(t, 'dtSevenDay'),
            trend: '', trendColor: '', color: '#0ea5e9',
          } as UTSJSONObject)
        }

        const avgRhr = twin!.getNumber('avg_resting_hr')
        if (avgRhr != null) {
          metrics.push({
            key: 'hr', label: isZh ? '心率' : 'Resting HR',
            val: `${Math.round(avgRhr!)}`, unit: 'bpm', sub: tnum(t, 'dtResting'),
            trend: '', trendColor: '', color: '#f97316',
          } as UTSJSONObject)
        }

        const avgSpo2 = twin!.getNumber('avg_spo2')
        if (avgSpo2 != null && metrics.length < 4) {
          metrics.push({
            key: 'spo2', label: 'SpO₂',
            val: avgSpo2!.toFixed(1), unit: '%', sub: tnum(t, 'dtSevenDay'),
            trend: '', trendColor: '', color: '#a855f7',
          } as UTSJSONObject)
        }

        const bodyParts : string[] = []
        if (twin!.getNumber('latest_weight_kg') != null) bodyParts.push(`${twin!.get('latest_weight_kg')} kg`)
        const latestBmi = twin!.getNumber('latest_bmi')
        if (latestBmi != null) bodyParts.push(`BMI ${latestBmi!.toFixed(1)}`)
        const latestFat = twin!.getNumber('latest_body_fat_pct')
        if (latestFat != null) bodyParts.push(`${tnum(t, 'dtFat')} ${latestFat!.toFixed(1)}%`)
        const twinBody = bodyParts.length > 0 ? bodyParts.join('  ·  ') : ''

        // Build lab panel from latest_lab_data. The per-marker series rides in the same load
        // so a tile knows whether it has a trend to open; a failed series fetch costs only that.
        let labSeries = { } as UTSJSONObject
        try {
          const coachQ = this.coachId.length > 0 ? `&coach_id=${encodeURIComponent(this.coachId)}` : ''
          const sres = await this._req(`${BASE}/api/lab-history?openid=${encodeURIComponent(userId)}&series=1${coachQ}`, 'GET', null)
          const sb = sres.data
          const s = sb != null ? sb!.getJSON('series') : null
          if (s != null) labSeries = s!
        } catch (e : any) { labSeries = { } as UTSJSONObject }
        const panel = _buildLabPanel(twin!, lang, labSeries)

        // Tags generated server-side; pick label by language
        const rawTags = twin!.getArray<UTSJSONObject>('tags') ?? ([] as UTSJSONObject[])
        const healthTags : UTSJSONObject[] = rawTags.map((tag : UTSJSONObject) : UTSJSONObject => {
          const c = { } as UTSJSONObject
          tag.toMap().forEach((v : any | null, k : string) => { c[k] = v })
          c['label'] = isZh ? sget(tag, 'labelZh') : sget(tag, 'labelEn')
          return c
        })

        // Only use server twin for gauge visuals when no ring data exists. If ring data is
        // present it already populated the gauges with today's readings — overwriting them
        // with server 7-day averages would show stale/mock data.
        const ringExists = this.ringData != null
        let serverVisuals : UTSJSONObject | null = ringExists ? null : this._buildTwinVisuals(twin!, t, isZh)

        this.twinLoading = false
        // The miniapp keeps `!ringData ? … : prev` here, which makes the twin section's visibility
        // a race between the twin fetch and the (parallel) ring hydration — the phone build reliably
        // lost it and showed "暂无日常监测数据" forever. hasTwinData only gates the twin METRICS list
        // (the ring gauges stay gated by ringExists above), so derive it from the data itself.
        this.hasTwinData = metrics.length > 0 || (twinBody != null && twinBody!.length > 0) || aget(panel, 'labPanel').length > 0
        this.twinMetrics = metrics
        this.twinBody = twinBody
        this.twinRaw = twin
        this.labSeries = labSeries
        this.labPanelMeta = sget(panel, 'labPanelMeta')
        this.labPanel = aget(panel, 'labPanel')
        this.labPanelDate = sget(panel, 'labPanelDate')
        this.labPanelAbnormal = nget(panel, 'labPanelAbnormal')
        this.healthTags = healthTags
        if (serverVisuals != null) {
          this.healthScore = serverVisuals!.getNumber('healthScore')
          this.healthScoreColor = sget(serverVisuals!, 'healthScoreColor')
          this.healthScoreGrade = sget(serverVisuals!, 'healthScoreGrade')
          this.healthDomains = aget(serverVisuals!, 'healthDomains')
          this.vitalGauges = aget(serverVisuals!, 'vitalGauges')
          const bar = jget(serverVisuals!, 'twinBodyBar')
          this.twinBodyBar = bar
        }
        this._recomputeTwinLayers()
      } catch (e : any) {
        this.hasTwinData = false
        this.twinLoading = false
        this._recomputeTwinLayers()
      }
    },

    _buildTwinVisuals(twin : UTSJSONObject, t : UTSJSONObject, isZh : boolean) : UTSJSONObject {
      const td = twin.getJSON('trend_data') ?? ({ } as UTSJSONObject)
      const trendIcon = (v : string) : string => v == 'improving' ? '↑' : v == 'declining' ? '↓' : v == 'stable' ? '→' : ''
      const trendColor = (v : string) : string => v == 'improving' ? '#10b981' : v == 'declining' ? '#ef4444' : 'rgba(166,196,229,0.35)'

      const domainScores = new Map<string, number | null>()
      const vitalGauges : UTSJSONObject[] = []

      const avgSleep = twin.getNumber('avg_sleep_hours')
      if (avgSleep != null) {
        const h = avgSleep!
        const sc = _scoreSleep(h)
        domainScores.set('sleep', sc)
        vitalGauges.push({
          key: 'sleep',
          label: isZh ? '睡眠时长' : 'Sleep',
          val: h.toFixed(1), unit: 'h',
          score: sc, color: '#6375EC',
          trend: trendIcon(sget(td, 'sleep_trend')), trendColor: trendColor(sget(td, 'sleep_trend')),
          markerPct: Math.min(97, Math.max(2, Math.round(h / 12 * 100))),
          zones: [
            { width: 50, color: '#ef4444' } as UTSJSONObject,
            { width: 8, color: '#f97316' } as UTSJSONObject,
            { width: 17, color: '#10b981' } as UTSJSONObject,
            { width: 8, color: '#f97316' } as UTSJSONObject,
            { width: 17, color: '#ef4444' } as UTSJSONObject,
          ],
          sublabel: isZh ? '最优: 7–9h' : 'Optimal: 7–9h',
        } as UTSJSONObject)
      }

      const avgHrv = twin.getNumber('avg_hrv_ms')
      if (avgHrv != null) {
        const ms = avgHrv!
        const sc = _scoreHrv(ms)
        domainScores.set('hrv', sc)
        vitalGauges.push({
          key: 'hrv', label: 'HRV',
          val: `${Math.round(ms)}`, unit: 'ms',
          score: sc, color: '#10b981',
          trend: trendIcon(sget(td, 'hrv_trend')), trendColor: trendColor(sget(td, 'hrv_trend')),
          markerPct: Math.min(97, Math.max(2, Math.round(ms))),
          zones: [
            { width: 20, color: '#ef4444' } as UTSJSONObject,
            { width: 20, color: '#f97316' } as UTSJSONObject,
            { width: 30, color: '#10b981' } as UTSJSONObject,
            { width: 30, color: '#0ea5e9' } as UTSJSONObject,
          ],
          sublabel: isZh ? '越高越好' : 'Higher is better',
        } as UTSJSONObject)
      }

      const avgRhr = twin.getNumber('avg_resting_hr')
      if (avgRhr != null) {
        const bpm = avgRhr!
        const sc = _scoreRestHr(bpm)
        domainScores.set('hr', sc)
        vitalGauges.push({
          key: 'hr', label: isZh ? '静息心率' : 'Resting HR',
          val: `${Math.round(bpm)}`, unit: 'bpm',
          score: sc, color: '#f97316',
          trend: '', trendColor: '',
          markerPct: Math.min(97, Math.max(2, Math.round((bpm - 40) / 80 * 100))),
          zones: [
            { width: 15, color: '#0ea5e9' } as UTSJSONObject,
            { width: 16, color: '#10b981' } as UTSJSONObject,
            { width: 13, color: '#10b981' } as UTSJSONObject,
            { width: 19, color: '#f97316' } as UTSJSONObject,
            { width: 37, color: '#ef4444' } as UTSJSONObject,
          ],
          sublabel: isZh ? '最优: 50–65 bpm' : 'Optimal: 50–65 bpm',
        } as UTSJSONObject)
      }

      const avgSys = twin.getNumber('avg_systolic_bp')
      const avgDia = twin.getNumber('avg_diastolic_bp')
      if (avgSys != null && avgDia != null) {
        const sys = Math.round(avgSys!)
        const dia = Math.round(avgDia!)
        const sc = _scoreBp(sys, dia)!
        domainScores.set('bp', sc)
        vitalGauges.push({
          key: 'bp', label: isZh ? '血压' : 'Blood Pressure',
          val: `${sys}/${dia}`, unit: 'mmHg',
          score: sc, color: '#ef4444',
          trend: '', trendColor: '',
          markerPct: Math.min(97, Math.max(2, Math.round((sys - 80) / 80 * 100))),
          zones: [
            { width: 12, color: '#0ea5e9' } as UTSJSONObject,
            { width: 38, color: '#10b981' } as UTSJSONObject,
            { width: 12, color: '#f97316' } as UTSJSONObject,
            { width: 13, color: '#ef4444' } as UTSJSONObject,
            { width: 25, color: '#7f1d1d' } as UTSJSONObject,
          ],
          sublabel: isZh ? '最优: <120/80' : 'Optimal: <120/80',
        } as UTSJSONObject)
      }

      const avgSpo2 = twin.getNumber('avg_spo2')
      if (avgSpo2 != null) {
        const pct = avgSpo2!
        const sc = _scoreSpo2(pct)
        domainScores.set('spo2', sc)
        vitalGauges.push({
          key: 'spo2', label: 'SpO₂',
          val: pct.toFixed(1), unit: '%',
          score: sc, color: '#a855f7',
          trend: '', trendColor: '',
          markerPct: Math.min(97, Math.max(2, Math.round((pct - 90) / 10 * 100))),
          zones: [
            { width: 50, color: '#ef4444' } as UTSJSONObject,
            { width: 20, color: '#f97316' } as UTSJSONObject,
            { width: 10, color: '#10b981' } as UTSJSONObject,
            { width: 20, color: '#0ea5e9' } as UTSJSONObject,
          ],
          sublabel: isZh ? '最优: ≥98%' : 'Optimal: ≥98%',
        } as UTSJSONObject)
      }

      const avgSteps = twin.getNumber('avg_daily_steps')
      if (avgSteps != null) {
        const steps = avgSteps!
        const sc = _scoreSteps(steps)
        domainScores.set('steps', sc)
        vitalGauges.push({
          key: 'steps', label: isZh ? '日均步数' : 'Daily Steps',
          val: steps >= 10000 ? `${(steps / 1000).toFixed(1)}k` : toLocaleInt(steps), unit: '',
          score: sc, color: '#0ea5e9',
          trend: '', trendColor: '',
          markerPct: Math.min(97, Math.max(2, Math.round(steps / 12000 * 100))),
          zones: [
            { width: 42, color: '#ef4444' } as UTSJSONObject,
            { width: 21, color: '#f97316' } as UTSJSONObject,
            { width: 21, color: '#10b981' } as UTSJSONObject,
            { width: 16, color: '#0ea5e9' } as UTSJSONObject,
          ],
          sublabel: isZh ? '目标: 7,500+ 步' : 'Goal: 7,500+ steps',
        } as UTSJSONObject)
      }

      const latestBmi = twin.getNumber('latest_bmi')
      if (latestBmi != null) {
        domainScores.set('bmi', _scoreBmi(latestBmi!))
      }

      // Domain aggregate scores
      const avg = (arr : (number | null)[]) : number | null => {
        const vals : number[] = []
        for (const v of arr) if (v != null) vals.push(v!)
        if (vals.length == 0) return null
        let sum = 0
        for (const v of vals) sum += v
        return Math.round(sum / vals.length)
      }
      const ds = (k : string) : number | null => { const v = domainScores.get(k); return v != null ? v : null }
      const healthDomains : UTSJSONObject[] = []
      const recoveryS = avg([ds('sleep'), ds('hrv')])
      const cardioS = avg([ds('hr'), ds('spo2'), ds('bp')])
      const activityS = avg([ds('steps')])
      const bodyS = avg([ds('bmi')])

      if (recoveryS != null) healthDomains.push({ key: 'recovery', label: tnum(t, 'dtRecovery'), score: recoveryS, color: '#6375EC' } as UTSJSONObject)
      if (cardioS != null) healthDomains.push({ key: 'cardio', label: tnum(t, 'dtCardio'), score: cardioS, color: '#f97316' } as UTSJSONObject)
      if (activityS != null) healthDomains.push({ key: 'activity', label: tnum(t, 'dtActivity'), score: activityS, color: '#0ea5e9' } as UTSJSONObject)
      if (bodyS != null) healthDomains.push({ key: 'body', label: tnum(t, 'dtBodyDomain'), score: bodyS, color: '#a855f7' } as UTSJSONObject)

      const allScores : (number | null)[] = [recoveryS, cardioS, activityS, bodyS]
      const healthScore = avg(allScores)
      const healthScoreColor = healthScore == null ? '#A6C4E5'
        : healthScore! >= 80 ? '#10b981'
        : healthScore! >= 65 ? '#6375EC'
        : healthScore! >= 50 ? '#f97316'
        : '#ef4444'
      const grades = t.getJSON('healthScoreGrades')!
      const healthScoreGrade = healthScore == null ? ''
        : healthScore! >= 80 ? sget(grades, 'optimal')
        : healthScore! >= 65 ? sget(grades, 'good')
        : healthScore! >= 50 ? sget(grades, 'fair')
        : sget(grades, 'low')

      // Body composition visual bar
      let twinBodyBar : UTSJSONObject | null = null
      const fat = twin.getNumber('latest_body_fat_pct')
      if (fat != null) {
        const fatPct = Math.min(60, Math.max(5, Math.round(fat!)))
        twinBodyBar = { fatPct: fatPct, leanPct: 100 - fatPct } as UTSJSONObject
      }

      return {
        healthScore: healthScore, healthScoreColor: healthScoreColor, healthScoreGrade: healthScoreGrade,
        healthDomains: healthDomains, vitalGauges: vitalGauges, twinBodyBar: twinBodyBar,
      } as UTSJSONObject
    },

    /**
     * Derives the Digital Twin completeness strip — one chip per layer (AGENTS §34).
     *
     * Deliberately re-derived from current state rather than fetched: every input is already
     * loaded by _loadHealth / _loadHealthTwin / _loadHealthReports / _loadUserFacts, and each
     * of those updates independently, so whichever finishes last produces the final strip.
     * `twin.data_coverage` alone can't back this — its five keys are all health_events-derived,
     * so it knows nothing about the Kino scan or the self-reported profile.
     */
    // <health-documents> reports what it loaded. An uploaded record IS Medical Records (twin
    // layer 3), extracted or not, so the completeness strip counts it — before this a user
    // with twenty PDFs and no extraction saw the layer as empty.
    _onDocsLoaded(detail : UTSJSONObject | null) {
      this.docCount = nget(detail, 'count')
      this.latestDocDate = sget(detail, 'latestDate')
      this._recomputeTwinLayers()
    },

    _recomputeTwinLayers() {
      const isZh = (this.lang.length > 0 ? this.lang : 'zh') != 'en'
      const t = isZh ? T_ZH : T_EN
      const labels = isZh ? TWIN_LAYER_LABELS_ZH : TWIN_LAYER_LABELS_EN
      const twin = this.twinRaw ?? ({ } as UTSJSONObject)
      const cov = twin.getJSON('data_coverage') ?? ({ } as UTSJSONObject)
      const short = (d : string | null) : string => d != null && d!.length > 0 ? d!.substring(0, 10).substring(5) : ''
      const newest = (ds : (string | null)[]) : string | null => {
        const vals : string[] = []
        for (const d of ds) if (d != null && d!.length > 0) vals.push(`${d}`.substring(0, 10))
        if (vals.length == 0) return null
        vals.sort()
        return vals[vals.length - 1]
      }

      const reports = this.healthReports

      const lastBa = this.bioAgeHistory.length > 0 ? this.bioAgeHistory[this.bioAgeHistory.length - 1] : null

      const hasPrecision = this.bAge.length > 0
      const datePrecision = newest([sget(twin, 'latest_kino_scan_at'), lastBa != null ? sget(lastBa, 'date') : null])

      // data_coverage values are date strings, not booleans
      const covHasAny = cov.getString('sleep') != null || cov.getString('activity') != null
        || cov.getString('vitals') != null || cov.getString('body_composition') != null
      const hasDailyFinal = covHasAny || this.ringData != null
      const dateDaily = newest([cov.getString('sleep'), cov.getString('activity'), cov.getString('vitals'), cov.getString('body_composition')])

      // `epigenetic_result` is a real 6th health_events category (confirmed live on dev) that
      // predates this taxonomy and isn't in the five documented ones — it's an externally-run
      // test, so it belongs to Medical Records. Without it, a user whose only outside test is
      // an epigenetic panel would show this layer as empty.
      const hasMedical = reports.length > 0 || cov.getString('lab_result') != null || cov.getString('epigenetic_result') != null
        || twin.getString('latest_lab_date') != null
        || this.docCount > 0
      const dateMedical = newest([
        sget(twin, 'latest_lab_date'), cov.getString('lab_result'), cov.getString('epigenetic_result'),
        reports.length > 0 ? sget(reports[0], 'report_date_raw') : null,
        this.latestDocDate.length > 0 ? this.latestDocDate : null,
      ])

      const hasProfile = this.rawHeight != null && this.rawWeight != null

      const states : UTSJSONObject[] = [
        { key: 'precision', has: hasPrecision, date: datePrecision } as UTSJSONObject,
        { key: 'daily', has: hasDailyFinal, date: dateDaily } as UTSJSONObject,
        { key: 'medical', has: hasMedical, date: dateMedical } as UTSJSONObject,
        { key: 'profile', has: hasProfile, date: null } as UTSJSONObject,
      ]
      const stateMap = new Map<string, UTSJSONObject>()
      for (const s of states) stateMap.set(sget(s, 'key'), s)

      const twinLayers : UTSJSONObject[] = TWIN_LAYER_KEYS.map((key : string) : UTSJSONObject => {
        const s = stateMap.get(key)!
        return {
          key: key,
          label: sget(labels, key),
          hasData: bget(s, 'has'),
          lastDate: bget(s, 'has') ? short(sget(s, 'date')) : '',
          emptyLabel: tnum(t, 'twinLayerEmpty'),
        } as UTSJSONObject
      })

      let done = 0
      for (const l of twinLayers) if (bget(l, 'hasData')) done++
      this.twinLayers = twinLayers
      this.twinLayersDone = done
    },

    async _loadHealthReports() {
      const userId = this.userId
      if (userId.length == 0) return
      this.reportsLoading = true
      try {
        const res = await this._req(`${BASE}/api/health-reports?openid=${encodeURIComponent(userId)}`, 'GET', null)
        const body = res.data
        const raw = body != null ? (body!.getArray<UTSJSONObject>('reports') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        const lang = this.lang.length > 0 ? this.lang : 'zh'
        const t = tOf(lang)
        const reports : UTSJSONObject[] = raw.map((r : UTSJSONObject) : UTSJSONObject => ({
          id: r.get('id'),
          institution: r.getString('institution') != null && r.getString('institution')!.length > 0 ? r.getString('institution') : '—',
          report_date: fmtDate(r.get('report_date'), lang),
          report_date_raw: r.getString('report_date'),
          report_type: tk(t, 'reportTypeLabels', r.getString('report_type')),
          source_label: tk(t, 'reportSourceLabels', r.getString('source')),
          type_color: _reportTypeColor(sget(r, 'report_type')),
          image_url: r.getString('image_url') != null ? r.getString('image_url') : '',
          // Printed rows kept under the report (mapped and unmapped). A NAD+ or organic-acid
          // report has no catalogued marker and would otherwise read as an empty card.
          item_count: r.getNumber('item_count') ?? 0,
          items_label: (r.getNumber('item_count') ?? 0) > 0 ? tnum(t, 'rptItemsCount').replace('{n}', `${r.getNumber('item_count')}`) : '',
        } as UTSJSONObject))
        this.healthReports = reports
        this.reportsLoading = false
        this._recomputeTwinLayers()
      } catch (e : any) {
        this.reportsLoading = false
      }
    },

    /**
     * Personal Profile layer — the read-only view of `user_memory_facts` (dietary
     * restrictions, allergies, preferences, goals the AI picked up in conversation).
     * Until now these existed only in the admin panel and the coach app, so the user could
     * never see what the system believed about them. Read-only by design this pass: who owns
     * an AI-extracted fact is a product question, not a labeling one.
     *
     * Self view only — the coach app already has its own Facts tab on the client sheet.
     */
    async _loadUserFacts() {
      const userId = this.userId
      if (userId.length == 0 || this.mode != 'self') return
      try {
        const res = await this._req(`${BASE}/api/user-facts?openid=${encodeURIComponent(userId)}`, 'GET', null)
        const body = res.data
        const isZh = (this.lang.length > 0 ? this.lang : 'zh') != 'en'
        const t = isZh ? T_ZH : T_EN
        const raw = body != null ? (body!.getArray<UTSJSONObject>('facts') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        const facts : UTSJSONObject[] = raw
          .filter((f : UTSJSONObject) : boolean => f.getString('status') == 'active')
          .map((f : UTSJSONObject) : UTSJSONObject => {
            const cat = sget(f, 'category')
            // tk() echoes the key back when it has no label ('condition' has none) — the miniapp's
            // `t.factCategories[cat] || t.factCategories.other` falls through to 其他 instead.
            const catLabel = tk(t, 'factCategories', cat) != cat ? tk(t, 'factCategories', cat) : ''
            return {
              id: f.get('id'),
              fact: f.getString('fact_zh'),
              category: cat,
              categoryLabel: catLabel.length > 0 ? catLabel : tk(t, 'factCategories', 'other'),
              color: _factCategoryColor(cat),
            } as UTSJSONObject
          })
        this.userFacts = facts
        this.userFactsLoaded = true
      } catch (e : any) {
        this.userFactsLoaded = true
      }
    },

    /**
     * Medical Records layer — the user's chronic food-sensitivity (IgG) panel (§40).
     *
     * Read-only. The panel is a lab result, not something a user edits, and its derived
     * restrictions are ordinary user_memory_facts shown in the Personal Profile layer. A wrong
     * panel is corrected by re-running or deleting the extraction on the document itself, which
     * clears the panel, its results and its facts together.
     *
     * Only the positives are listed. This report tested 120 foods and 117 came back clear; a
     * 120-row list would bury the three that matter, so the total is stated instead.
     */
    async _loadFoodSensitivity() {
      const userId = this.userId
      if (userId.length == 0) return
      try {
        const q = `openid=${encodeURIComponent(userId)}`
          + (this.mode == 'coach' && this.coachId.length > 0 ? `&coach_id=${encodeURIComponent(this.coachId)}` : '')
        const res = await this._req(`${BASE}/api/food-sensitivity?${q}`, 'GET', null)
        const body = res.data
        const panel = body != null ? body!.getJSON('panel') : null
        if (panel == null) { this.foodPanel = null; this.foodPositives = [] as UTSJSONObject[]; this.foodSummary = ''; return }
        const isZh = (this.lang.length > 0 ? this.lang : 'zh') != 'en'
        const t = isZh ? T_ZH : T_EN
        const today = new Date().toISOString().substring(0, 10)
        const rawFoods = body!.getArray<UTSJSONObject>('foods') ?? ([] as UTSJSONObject[])
        const positives : UTSJSONObject[] = []
        for (const f of rawFoods) {
          if ((f.getNumber('class') ?? 0) < 1) continue
          const avoidUntil = f.getString('avoid_until')
          const passed = avoidUntil != null && avoidUntil!.length > 0 && avoidUntil! < today
          const cls = f.getNumber('class') ?? 0
          const val = f.get('value')
          const positives1 = {
            food_key: f.getString('food_key'),
            name: isZh ? sget(f, 'name_zh') : (sget(f, 'name_en').length > 0 ? sget(f, 'name_en') : sget(f, 'name_zh')),
            classLabel: tarr(t, 'foodClass', cls),
            color: _foodClassColor(cls),
            // The lab declined to measure below its detection limit, so there is no figure to
            // show — the marker is the fact, not a number nobody produced.
            valueText: f.getBoolean('below_detection') == true ? tnum(t, 'foodBelowDetection')
              : (val == null ? '' : `${val} ${sget(panel, 'unit')}`),
            windowText: avoidUntil == null || avoidUntil!.length == 0 ? ''
              : (passed ? tnum(t, 'foodWindowPassed').replace('{d}', avoidUntil!)
                : tnum(t, 'foodAvoidUntil').replace('{d}', avoidUntil!)),
            substitutes: (f.getArray<string>('substitutes_zh') ?? ([] as string[])).join('、'),
          } as UTSJSONObject
          positives.push(positives1)
        }
        const foodsTested = `${panel.getNumber('foods_tested') ?? 0}`
        const summary = positives.length == 0
          ? tnum(t, 'foodSummaryNone').replace('{n}', foodsTested)
          : tnum(t, 'foodSummarySome').replace('{n}', foodsTested).replace('{k}', `${positives.length}`)
        this.foodPanel = panel
        this.foodPositives = positives
        this.foodSummary = summary
      } catch (e : any) {
        // A twin section that cannot load is a missing section, never a broken tab.
        this.foodPanel = null
        this.foodPositives = [] as UTSJSONObject[]
        this.foodSummary = ''
      }
    },

    // ── 综合报告 ──────────────────────────────────────────────────────────
    // Completed AG artifacts for this user. Coach view passes coach-id so the server runs the
    // same coarse users.coach_id check every other per-user read uses. Failure leaves the card
    // hidden (twinReportLatest stays null) rather than showing an error — it is an optional
    // surface above the layers, not the twin itself.
    async _loadTwinReports() {
      const userId = this.userId
      if (userId.length == 0) return
      try {
        const coach = this.coachId.length > 0 ? `&coach_id=${encodeURIComponent(this.coachId)}` : ''
        const res = await this._req(`${BASE}/api/twin-reports?openid=${encodeURIComponent(userId)}${coach}`, 'GET', null)
        const body = res.data
        if (body == null || body!.getBoolean('success') != true) return
        const raw = body!.getArray<UTSJSONObject>('reports') ?? ([] as UTSJSONObject[])
        const reports : UTSJSONObject[] = raw.map((r : UTSJSONObject) : UTSJSONObject => {
          const files = r.getArray<UTSJSONObject>('files') ?? ([] as UTSJSONObject[])
          let pdf : UTSJSONObject | null = null
          for (const f of files) { if (sget(f, 'ext') == 'pdf') { pdf = f; break } }
          const parts : string[] = []
          const completedDate = sget(r, 'completed_date')
          if (completedDate.length > 0) parts.push(completedDate)
          if (pdf != null && (pdf!.getNumber('size_bytes') ?? 0) > 0) parts.push(_sizeLabel(pdf!.getNumber('size_bytes')))
          if (pdf != null) parts.push('PDF')
          else if (files.length > 0) parts.push(sget(files[0], 'ext').toUpperCase())
          const c = { } as UTSJSONObject
          r.toMap().forEach((v : any | null, k : string) => { c[k] = v })
          c['metaLine'] = parts.join(' · ')
          // attribution (lib/reportAttribution.js) — the AG panel shows it too (§48)
          const attr = r.getJSON('attribution')
          c['attributionText'] = attr != null ? sget(attr, 'text') : ''
          return c
        })
        this.twinReports = reports
        this.twinReportLatest = reports.length > 0 ? reports[0] : null
      } catch (e : any) { /* card simply stays hidden */ }
    },

    onTwinReportListTap() {
      const reports = this.twinReports
      if (reports.length == 0) return
      const items : string[] = []
      const head = reports.slice(0, 6)
      for (const r of head) items.push(`${sget(r, 'completed_date')} · ${sget(r, 'title')}`)
      uni.showActionSheet({
        itemList: items,
        success: (res) => {
          const idx = res.tapIndex
          const r = idx >= 0 && idx < head.length ? head[idx] : null
          if (r != null) this._openTwinReport(sget(r, 'job_uid'), nget(r, 'primary_index'))
        },
        fail: (_ : any) => {}
      })
    },

    onTwinReportTap(uid : string, index : number) {
      this._openTwinReport(uid, index)
    },

    // Same flow as viva-ag-panel.openResultFile: mint a 300s URL per tap (the client never
    // sees an oss_key), download, and hand the PDF to the system viewer. Non-PDF artifacts
    // (.md/.txt) are the AG panel's job — it has the in-app renderer.
    // TODO(port): wx.openDocument → uni.openDocument field/temp-path names differ on app;
    // downloadFile resolves for any HTTP status — the statusCode check below is load-bearing.
    async _openTwinReport(jobUid : string, index : number) {
      if (this.twinReportOpening || jobUid.length == 0) return
      const userId = this.userId
      const t = tOf(this.lang == 'en' ? 'en' : 'zh')
      const coach = this.coachId.length > 0 ? `&coach_id=${encodeURIComponent(this.coachId)}` : ''
      this.twinReportOpening = true
      try {
        const res = await this._req(`${BASE}/api/twin-reports/file?openid=${encodeURIComponent(userId)}&job_uid=${encodeURIComponent(jobUid)}&index=${index}${coach}`, 'GET', null)
        const body = res.data
        if (body == null || body!.getBoolean('success') != true) {
          throw new Error(body != null && body!.getString('reason') != null ? body!.getString('reason')! : 'no url')
        }
        const url = sget(body, 'url')
        const ft = sget(body, 'file_type')
        const dl = await new Promise<string>((resolve : (p : string) => void, reject : (e : any | null) => void) => {
          uni.downloadFile({
            url: url,
            success: (r) => {
              const code = r.statusCode
              if (code == 200) {
                const p = r.tempFilePath
                if (p.length > 0) resolve(p)
                else reject(new Error('no file path'))
              } else {
                reject(new Error(`http ${code}`))
              }
            },
            fail: (err) => { reject(err) },
          })
        })
        this.twinReportOpening = false
        const knownTypes = ['pdf', 'doc', 'docx', 'xls', 'xlsx', 'ppt', 'pptx']
        uni.openDocument({
          filePath: dl,
          fileType: knownTypes.indexOf(ft) != -1 ? ft : 'pdf',
          fail: (_) => { uni.showToast({ title: tnum(t, 'reportsErrOpen'), icon: 'none' }) },
        })
      } catch (e : any) {
        this.twinReportOpening = false
        uni.showToast({ title: tnum(t, 'reportsErrOpen'), icon: 'none' })
      }
    },

    async onReportTap(id : number) {
      if (id == 0) return
      const userId = this.userId
      const lang = this.lang.length > 0 ? this.lang : 'zh'
      const t = tOf(lang)
      const isZh = lang != 'en'
      this.activeReport = { id: id, loading: true, institution: '—', report_date: '', report_type: '', type_color: '#6375EC', image_url: '', hasDiag: false, hasAdvice: false, hasDoctorNotes: false } as UTSJSONObject
      this.activeReportEvents = [] as UTSJSONObject[]
      this.activeReportOtherItems = [] as UTSJSONObject[]
      this.activeReportDiag = [] as string[]
      this.activeReportAdvice = [] as string[]
      this.activeReportDoctorNotes = null
      this.reportDetailLoading = true
      try {
        const res = await this._req(`${BASE}/api/health-reports/${id}?openid=${encodeURIComponent(userId)}`, 'GET', null)
        const body = res.data
        const report = body != null ? (body!.getJSON('report') ?? ({ } as UTSJSONObject)) : ({ } as UTSJSONObject)
        const events = body != null ? (body!.getArray<UTSJSONObject>('events') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        const items = body != null ? (body!.getArray<UTSJSONObject>('items') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        const raw = report.getJSON('raw_data') ?? ({ } as UTSJSONObject)
        const statusRow = (status : string) : UTSJSONObject => ({
          status: status,
          statusLabel: status == 'high' ? tnum(t, 'rptHigh') : status == 'low' ? tnum(t, 'rptLow') : tnum(t, 'rptNormal'),
          statusColor: status == 'high' ? '#ef4444' : status == 'low' ? '#0ea5e9' : '#10b981',
        } as UTSJSONObject)
        // Catalogued markers: from health_report_items when the report has them (every
        // extracted document since 2026-09-15), else from the events as before. Names and
        // ranges come with the row from the server; the client tables are only a fallback.
        const mappedItems = items.filter((i : UTSJSONObject) : boolean => { const k = i.getString('key_name'); return k != null && k!.length > 0 })
        const rows = mappedItems.length > 0 ? mappedItems : events
        const enriched : UTSJSONObject[] = rows.map((row : UTSJSONObject) : UTSJSONObject => {
          const d = row.getJSON('data') ?? row
          const key = sget(d, 'key_name')
          const vNumOpt = d.getNumber('value_num')
          const v = vNumOpt != null ? vNumOpt : (d.get('value') != null ? parseFloat(sget(d, 'value')) : null)
          const statusOpt = sget(row, 'flag')
          const status = (statusOpt == 'high' || statusOpt == 'low') ? statusOpt : _statusFor(key, v != null && !isNaN(v!) ? v : null, row.getNumber('ref_low'), row.getNumber('ref_high'))
          const labelZh = d.getString('label')
          const name = isZh
            ? (row.getString('display_name_zh') ?? (labelZh != null ? labelZh : key))
            : (row.getString('display_name') ?? (labelZh != null ? labelZh : key))
          const merged = statusRow(status)
          const out = { } as UTSJSONObject
          merged.toMap().forEach((vv : any | null, kk : string) => { out[kk] = vv })
          out['key_name'] = (name != null && name!.length > 0) ? name : '—'
          const valueOpt = d.get('value')
          out['value'] = v != null ? `${v}` : (valueOpt != null ? `${valueOpt}` : (sget(d, 'value_text').length > 0 ? sget(d, 'value_text') : '—'))
          out['unit'] = sget(d, 'unit')
          const refTextOpt = row.getString('ref_text')
          out['refText'] = refTextOpt != null && refTextOpt!.length > 0 ? refTextOpt : _refTextFor(key, row.getNumber('ref_low'), row.getNumber('ref_high'), sget(d, 'unit'))
          return out
        })
        // Everything else the report printed, kept by name — organic acids, hair elements, a
        // NAD+ grade. No catalog range, so the only verdict is the report's own flag.
        const otherItems : UTSJSONObject[] = items
          .filter((i : UTSJSONObject) : boolean => { const k = i.getString('key_name'); return k == null || k!.length == 0 })
          .map((i : UTSJSONObject) : UTSJSONObject => {
            const flag = sget(i, 'flag')
            const flagged = flag == 'high' || flag == 'low'
            const merged = statusRow(flagged ? flag : 'normal')
            const out = { } as UTSJSONObject
            merged.toMap().forEach((vv : any | null, kk : string) => { out[kk] = vv })
            const section = i.getString('section')
            out['key_name'] = section != null && section!.length > 0 ? `${section} · ${sget(i, 'label')}` : sget(i, 'label')
            const vNumOpt = i.getNumber('value_num')
            out['value'] = vNumOpt != null ? `${Math.round(vNumOpt! * 1000000) / 1000000}` : (sget(i, 'value_text').length > 0 ? sget(i, 'value_text') : '—')
            out['unit'] = sget(i, 'unit')
            out['flagged'] = flagged
            const refTextOpt = i.getString('ref_text')
            out['refText'] = refTextOpt != null ? refTextOpt : ''
            // The agent's guess at a catalog key (contract 3): shown as a hint beside the
            // printed label, never as the marker's name — a guess is not a mapping.
            const sug = i.getString('suggested_key')
            out['suggested'] = sug != null && sug!.length > 0
              ? `${tnum(t, 'rptMaybe')} ${lang == 'en' ? (sget(i, 'suggested_name').length > 0 ? sget(i, 'suggested_name') : (sget(i, 'suggested_name_zh').length > 0 ? sget(i, 'suggested_name_zh') : sug)) : (sget(i, 'suggested_name_zh').length > 0 ? sget(i, 'suggested_name_zh') : (sget(i, 'suggested_name').length > 0 ? sget(i, 'suggested_name') : sug))}`
              : ''
            return out
          })
        // Parse doctor_notes format (admin panel / liangkang reports)
        const dnRaw = raw.getJSON('doctor_notes')
        let doctorNotes : UTSJSONObject | null = null
        if (dnRaw != null) {
          const vitals : UTSJSONObject[] = []
          const vs = dnRaw!.getJSON('vital_summary')
          if (vs != null) {
            vs!.toMap().forEach((v : any | null, k : string) => { vitals.push({ key: k, value: `${v}` } as UTSJSONObject) })
          }
          doctorNotes = {
            physician: sget(dnRaw!, 'physician'),
            department: sget(dnRaw!, 'department'),
            vitals: vitals,
            clinical_summary: sget(dnRaw!, 'clinical_summary'),
            recommendations: dnRaw!.getArray<string>('recommendations') ?? ([] as string[]),
            follow_up: sget(dnRaw!, 'follow_up'),
          } as UTSJSONObject
        }
        const diagArr = raw.getArray<string>('diagnostics')
        const adviceArr = raw.getArray<string>('doctor_advice')
        this.activeReport = {
          id: id,
          institution: report.getString('institution') != null && report.getString('institution')!.length > 0 ? report.getString('institution') : '—',
          report_date: fmtDate(report.get('report_date'), lang),
          report_type: tk(t, 'reportTypeLabels', report.getString('report_type')),
          type_color: _reportTypeColor(sget(report, 'report_type')),
          image_url: sget(raw, 'image_url'),
          hasDiag: diagArr != null && diagArr!.length > 0,
          hasAdvice: adviceArr != null && adviceArr!.length > 0,
          hasDoctorNotes: doctorNotes != null,
          loading: false,
        } as UTSJSONObject
        this.activeReportEvents = enriched
        this.activeReportOtherItems = otherItems
        this.activeReportDiag = diagArr ?? ([] as string[])
        this.activeReportAdvice = adviceArr ?? ([] as string[])
        this.activeReportDoctorNotes = doctorNotes
        this.reportDetailLoading = false
      } catch (e : any) {
        this.reportDetailLoading = false
      }
    },

    onCloseReport() {
      this.activeReport = null
      this.activeReportEvents = [] as UTSJSONObject[]
      this.activeReportOtherItems = [] as UTSJSONObject[]
      this.activeReportDiag = [] as string[]
      this.activeReportAdvice = [] as string[]
      this.activeReportDoctorNotes = null
    },

    // Public: called by the chat page after a lab report is saved, to refresh the list.
    refreshHealthReports() {
      this._loadHealthReports()
    },

    previewReportImage(url : string) {
      if (url.length == 0) return
      uni.previewImage({ urls: [url], current: url })
    },

    // ── profile edit ──────────────────────────────────────────────────────
    startEdit() {
      const user = this.userObj()
      const lang = this.lang.length > 0 ? this.lang : 'zh'
      const t = tOf(lang)
      const bioData = user != null ? (user!.getJSON('bio_data') ?? ({ } as UTSJSONObject)) : ({ } as UTSJSONObject)
      const currentConditions = bioData.getArray<string>('health_conditions') ?? ([] as string[])
      const birthDateRaw = user != null ? user!.getString('birth_date') : null
      const birthDate = birthDateRaw != null && birthDateRaw!.length > 0 ? birthDateRaw!.substring(0, 10) : ''
      const rawH = this.rawHeight != null ? this.rawHeight : bioData.getNumber('height')
      const rawW = this.rawWeight != null ? this.rawWeight : bioData.getNumber('weight')
      const options : UTSJSONObject[] = CONDITION_KEYS.map((key : string) : UTSJSONObject => ({
        key: key,
        label: tk(t, 'conditionLabels', key).length > 0 ? tk(t, 'conditionLabels', key) : key,
        checked: currentConditions.indexOf(key) != -1,
      } as UTSJSONObject))
      this.editing = true
      this.editOtherSelected = currentConditions.indexOf('other') != -1
      this.editConditionOptions = options
      this.editConditions = currentConditions.slice(0)
      this.editNickname = user != null && user!.getString('nickname') != null ? user!.getString('nickname')! : ''
      this.editGenderSel = user != null && user!.getString('gender') != null ? user!.getString('gender')! : ''
      this.editBirthDate = birthDate
      this.editHeightStr = rawH != null ? `${rawH}` : ''
      this.editWeightStr = rawW != null ? `${rawW}` : ''
      this.editCondOtherStr = bioData.getString('health_conditions_other') != null ? bioData.getString('health_conditions_other')! : ''
    },

    cancelEdit() {
      this.editing = false
    },

    onBirthDateChange(e : UniPickerChangeEvent) {
      this.editBirthDate = e.detail.value as string
    },

    onGenderSelect(value : string) {
      this.editGenderSel = value
    },

    onConditionToggle(key : string) {
      const newOptions : UTSJSONObject[] = this.editConditionOptions.map((o : UTSJSONObject) : UTSJSONObject => {
        if (sget(o, 'key') != key) return o
        return { key: sget(o, 'key'), label: sget(o, 'label'), checked: !bget(o, 'checked') } as UTSJSONObject
      })
      const newConditions : string[] = []
      for (const o of newOptions) if (bget(o, 'checked')) newConditions.push(sget(o, 'key'))
      this.editConditionOptions = newOptions
      this.editConditions = newConditions
      this.editOtherSelected = newConditions.indexOf('other') != -1
    },

    async saveEdit() {
      if (this.editSaving) return
      const lang = this.lang.length > 0 ? this.lang : 'zh'
      const t = tOf(lang)
      const user = this.userObj()
      if (user == null) return
      this.editSaving = true
      try {
        const nickname = this.editNickname
        const gender = this.editGenderSel
        const birthDate = this.editBirthDate
        const height = this.editHeightStr
        const weight = this.editWeightStr
        const healthConditions = this.editConditions
        const healthConditionsOther = this.editCondOtherStr
        const bioDataUpdate = {
          health_conditions: healthConditions,
          health_conditions_other: healthConditionsOther.length > 0 ? healthConditionsOther : '',
        } as UTSJSONObject
        if (height.length > 0) bioDataUpdate['height'] = parseFloat(height)
        if (weight.length > 0) bioDataUpdate['weight'] = parseFloat(weight)

        // Deliberately omits phone/email/language/coach_id — this form never edits them, and
        // the backend (handlePutUser) treats an omitted key as "leave untouched," not as
        // "clear it." Do not add them here just to "be complete": sourcing them from `user`
        // risks resending a stale/stripped cached value and silently wiping a verified phone —
        // this is exactly how a real incident happened (saving an unrelated health-profile
        // edit nulled phone).
        const userId = sget(user, 'user_id')
        await this._req(`${BASE}/api/users/${userId}`, 'PUT', {
          nickname: nickname, gender: gender, birth_date: birthDate, bio_data: bioDataUpdate,
        } as UTSJSONObject)

        const newBioData = { } as UTSJSONObject
        const oldBio = user!.getJSON('bio_data')
        if (oldBio != null) oldBio!.toMap().forEach((v : any | null, k : string) => { newBioData[k] = v })
        bioDataUpdate.toMap().forEach((v : any | null, k : string) => { newBioData[k] = v })
        const updatedUser = { } as UTSJSONObject
        user!.toMap().forEach((v : any | null, k : string) => { updatedUser[k] = v })
        updatedUser['nickname'] = nickname
        updatedUser['gender'] = gender
        updatedUser['birth_date'] = birthDate
        updatedUser['bio_data'] = newBioData

        const hVal : number | null = height.length > 0 ? parseFloat(height) : newBioData.getNumber('height')
        const wVal : number | null = weight.length > 0 ? parseFloat(weight) : newBioData.getNumber('weight')

        const profileInfoExtra : UTSJSONObject[] = [
          { label: tnum(t, 'gender'), val: tk(t, 'genderMap', gender).length > 0 ? tk(t, 'genderMap', gender) : (gender.length > 0 ? gender : '—') } as UTSJSONObject,
          { label: tnum(t, 'born'), val: fmtDate(birthDate, lang) } as UTSJSONObject,
          { label: tnum(t, 'height'), val: hVal != null ? `${hVal} ${tnum(t, 'bsCm')}` : '—' } as UTSJSONObject,
          { label: tnum(t, 'language'), val: tk(t, 'langMap', user!.getString('language')) } as UTSJSONObject,
          { label: tnum(t, 'coach'), val: user!.getString('coach_name') != null && user!.getString('coach_name')!.length > 0 ? user!.getString('coach_name') : '—' } as UTSJSONObject,
          { label: tnum(t, 'joined'), val: fmtDate(user!.get('created_at'), lang) } as UTSJSONObject,
          { label: tnum(t, 'phone'), val: user!.getString('phone') != null && user!.getString('phone')!.length > 0 ? user!.getString('phone') : '—' } as UTSJSONObject,
          { label: tnum(t, 'email'), val: user!.getString('email') != null && user!.getString('email')!.length > 0 ? user!.getString('email') : '—' } as UTSJSONObject,
        ]
        const healthConditionsList : UTSJSONObject[] = healthConditions.map((key : string) : UTSJSONObject => ({
          key: key,
          label: key == 'other' && healthConditionsOther.length > 0
            ? `${tk(t, 'conditionLabels', key)}（${healthConditionsOther}）`
            : (tk(t, 'conditionLabels', key).length > 0 ? tk(t, 'conditionLabels', key) : key),
        } as UTSJSONObject))
        const cAge = chronoAge(birthDate.length > 0 ? birthDate : null)

        this.editing = false
        this.editSaving = false
        this.profileInfoExtra = profileInfoExtra
        this.healthConditionsList = healthConditionsList
        this.hasConditionsData = true
        this.cAge = cAge
        this.bAgeColor = bioAgeColor(this.bAge.length > 0 ? this.bAge : null, cAge)
        this.avatarLetter = (nickname.length > 0 ? nickname.substring(nickname.length - 1) : 'U').toUpperCase()
        this.rawHeight = hVal
        this.rawWeight = wVal
        this.rawBmi = (hVal != null && wVal != null && hVal! > 0) ? `${((wVal!) / Math.pow((hVal!) / 100, 2)).toFixed(1)}` : ''
        this.$emit('profileUpdated', updatedUser)
        uni.showToast({ title: tnum(t, 'saveOk'), icon: 'success', duration: 1500 })
      } catch (e : any) {
        this.editSaving = false
        uni.showToast({ title: tnum(t, 'saveFail'), icon: 'error', duration: 2000 })
      }
    },

    // ── avatar (§20 gallery + mood) ───────────────────────────────────────
    onAvatarTap() {
      if (this._avatarPillTimer != 0) clearTimeout(this._avatarPillTimer)
      this.avatarPillsVisible = true
      this._avatarPillTimer = setTimeout(() => {
        this.avatarPillsVisible = false
        this._avatarPillTimer = 0
      }, 5000)
    },

    onEditProfilePill() {
      if (this._avatarPillTimer != 0) { clearTimeout(this._avatarPillTimer); this._avatarPillTimer = 0 }
      this.avatarPillsVisible = false
      this.startEdit()
    },

    onOpenAvatarPicker() {
      if (this._avatarPillTimer != 0) { clearTimeout(this._avatarPillTimer); this._avatarPillTimer = 0 }
      this.avatarPillsVisible = false
      this.avatarPickerVisible = true
    },

    onAvatarPickerClose() {
      this.avatarPickerVisible = false
    },

    onAvatarSelect(e : UTSJSONObject) {
      const avatarId = sget(e, 'avatarId')
      if (avatarId.length == 0) return
      this.avatarPickerVisible = false
      this.avatarUpdating = true
      this.$emit('chooseavatar', { avatarId: avatarId } as UTSJSONObject)
    },

    // The picker already applied a generated set server-side; the page only needs to refresh
    // its copy of the user so avatar_character/avatar_moods resolve from here on.
    onCustomAvatarApplied(detail : UTSJSONObject | null) {
      this.avatarPickerVisible = false
      this.$emit('customavatar', detail ?? ({ } as UTSJSONObject))
    },

    // Resolves the currently-displayed avatar image from the selected character + live mood.
    // Runs for both self and coach mode: self view computes mood from local BLE-synced ring
    // data (_loadWearableFromStorage), coach view computes it from that client's server-synced
    // health-events (_loadRingDataFromServer) — same computeMood()/resolveAvatarUrl() path
    // either way (§20).
    _refreshAvatarDisplay() {
      const user = this.userObj()
      const character = user != null ? user!.getString('avatar_character') : null
      if (character == null || character!.length == 0) { this.avatarDisplayUrl = ''; return }
      const moods = user != null ? user!.getJSON('avatar_moods') : null
      const url = resolveAvatarUrl(character, `${this.mood}`, moods)
      this.avatarDisplayUrl = url != null ? url : ''
    },

    onGuestTap() {
      this.$emit('guesttap', { } as UTSJSONObject)
    },

    // The AG panel needs the chat tab (that is where the questionnaire renderer lives) and
    // this component sits between it and the page, so the event is forwarded rather than
    // handled.
    onAgGoToChat(detail : UTSJSONObject | null) {
      this.$emit('gotochat', detail ?? ({ } as UTSJSONObject))
    },

    switchHealthSubTab(tab : string) {
      this.healthSubTab = tab
    },

    // ── two-finger pinch → text-size step ────────────────────────────────
    // Logic lives in utils/pinch.uts because the chat tab needs the identical gesture and two
    // copies would drift. The miniapp bound it with `bind` (not `catch`) so the host pages'
    // edge-swipe handlers still see the stream; the two crosshair canvases own catchtouch* —
    // a pinch starting on one never reaches here (correct: those are drag surfaces).
    _pinchStep() : PinchStepper {
      if (this._pinch == null) {
        this._pinch = new PinchStepper((dir : number) => {
          this.$emit('textscalestep', { dir: dir } as UTSJSONObject)
        })
      }
      return this._pinch!
    },

    onUhTouchStart(e : UniTouchEvent) {
      const t = e.touches
      const count = t.length
      if (count >= 2) {
        this._pinchStep().start(2, t[0]!.clientX, t[0]!.clientY, t[1]!.clientX, t[1]!.clientY)
      } else {
        this._pinchStep().start(count, 0, 0, 0, 0)
      }
    },
    onUhTouchMove(e : UniTouchEvent) {
      const t = e.touches
      const count = t.length
      if (count >= 2) {
        this._pinchStep().move(2, t[0]!.clientX, t[0]!.clientY, t[1]!.clientX, t[1]!.clientY)
      } else {
        this._pinchStep().move(count, 0, 0, 0, 0)
      }
    },
    onUhTouchEnd() { this._pinchStep().end() },

    toggleProfile() {
      this.profileExpanded = !this.profileExpanded
    },

    onZoneTap(key : string) {
      if (key.length == 0 || this.bioAgeTrendOpen) return
      this.flashSubAge = key
      if (this._flashTimer != 0) clearTimeout(this._flashTimer)
      this._flashTimer = setTimeout(() => {
        this.flashSubAge = ''
        this._flashTimer = 0
      }, 1400)
    },

    // ── Charts ────────────────────────────────────────────────────────────
    // TODO(port): wx.createCanvasContext has no uni-app x equivalent in this tree; every
    // draw below keeps the miniapp geometry EXACTLY and stores it as a layout the template
    // renders (grid lines + dots + labels + crosshair). Polylines are drawn as dots; fill
    // areas, dashed ChronoAge segments and the rounded glow border are structural-only.

    _winWidth() : number {
      try { return uni.getWindowInfo().windowWidth } catch (e : any) { return 375 }
    },

    // Shared by the BioAge chart and the generic charts: per-char width estimate (no
    // ctx.measureText — untested on legacy canvas in the miniapp either); CJK glyphs run
    // roughly font-size-wide vs ~0.55x for Latin/digits, so labels mixing Chinese sub-age
    // names with numbers size correctly too.
    _textWidth(s : string) : number {
      let w = 0
      for (let i = 0; i < s.length; i++) {
        w += (s.charCodeAt(i) ?? 0) > 255 ? 11 : 6.2
      }
      return w
    },

    // Crosshair overlay geometry (mirrors _drawCrosshairOverlay): vertical line, highlighted
    // dots and a label bubble that flips left of the line near the right edge so it never
    // clips off-canvas.
    _buildCrossInfo(opts : UTSJSONObject) : UTSJSONObject {
      const W = nget(opts, 'W')
      const pT = nget(opts, 'pT')
      const plotH = nget(opts, 'plotH')
      const x = nget(opts, 'x')
      const labelLines = aget(opts, 'labelLines')
      const lineH = 14
      let maxLineW = 0
      const widths : number[] = []
      for (const ln of labelLines) { const w = this._textWidth(sget(ln, 'text')); widths.push(w); if (w > maxLineW) maxLineW = w }
      const boxH = labelLines.length * lineH + 10
      const boxW = maxLineW + 16
      const flip = x > W * 0.7
      let boxX = flip ? x - boxW - 8 : x + 8
      boxX = Math.max(4, Math.min(W - boxW - 4, boxX))
      const boxY = Math.max(pT, 4)
      const c = this._chartPalette()
      const linesOut : UTSJSONObject[] = []
      for (let i = 0; i < labelLines.length; i++) {
        linesOut.push({
          text: sget(labelLines[i], 'text'),
          color: i == 0 ? sget(c, 'textMuted55') : sget(c, 'textPrimary'),
        } as UTSJSONObject)
      }
      return {
        x: x,
        box: { x: boxX, y: boxY, w: boxW, h: boxH } as UTSJSONObject,
        labelLines: linesOut,
      } as UTSJSONObject
    },

    // geometry of _drawGenericChart (grid at quarters, 5 x-labels max, ceil/floor bounds)
    _buildLineChartLayout(history : UTSJSONObject[], valKey : string, unit : string, color : string) : UTSJSONObject {
      const W = this._winWidth() - 72
      const H = 200, pL = 44, pR = 16, pT = 20, pB = 44
      const plotW = W - pL - pR, plotH = H - pT - pB
      const vals : number[] = history.map((r : UTSJSONObject) : number => nget(r, valKey))
      let minV = 0, maxV = 0
      if (vals.length > 0) { minV = Math.floor(_minOf(vals)); maxV = Math.ceil(_maxOf(vals)) }
      const range = (maxV - minV) == 0 ? 1 : maxV - minV
      const pts : UTSJSONObject[] = []
      for (let i = 0; i < history.length; i++) {
        const x = pL + (i / Math.max(history.length - 1, 1)) * plotW
        const y = pT + ((maxV - vals[i]) / range) * plotH
        pts.push({ x: x, y: y } as UTSJSONObject)
      }
      const c = this._chartPalette()
      const grid : UTSJSONObject[] = []
      for (let i = 0; i <= 4; i++) {
        const y = pT + (i / 4) * plotH
        const v = maxV - (i / 4) * range
        const isInt = Math.floor(v) == v
        grid.push({ y: y, text: isInt ? `${Math.round(v)}` : v.toFixed(1), color: sget(c, 'textMuted45') } as UTSJSONObject)
      }
      const labels : UTSJSONObject[] = []
      const labelStep = Math.max(1, Math.floor(history.length / 5))
      for (let i = 0; i < history.length; i++) {
        if (i % labelStep == 0 || i == history.length - 1) {
          labels.push({ x: pts[i].x, text: sget(history[i], 'date').substring(5) } as UTSJSONObject)
        }
      }
      return {
        W: W, H: H, pL: pL, pR: pR, pT: pT, pB: pB, plotW: plotW, plotH: plotH,
        pts: pts, grid: grid, labels: labels, accent: color, unit: unit,
      } as UTSJSONObject
    },

    _registerLayout(canvasId : string, layout : UTSJSONObject, target : string) {
      const cl = new ChartLayout()
      cl.pL = nget(layout, 'pL')
      cl.plotW = nget(layout, 'plotW')
      cl.len = aget(layout, 'pts').length
      cl.target = target
      cl.canvas = canvasId
      cl.xLeft = (this._winWidth() - nget(layout, 'W')) / 2
      this._chartLayouts.set(canvasId, cl)
    },

    openWeightChart() {
      const W = this._winWidth() - 72
      this.weightChartOpen = true
      this.weightChartW = W
      // _drawWeightFullChart geometry (grid labels keep one decimal, no crosshair)
      const layout = this._buildLineChartLayout(this.weightHistory, 'weight', '', sget(this._chartPalette(), 'accent'))
      const gridFixed : UTSJSONObject[] = []
      const H = 200, pL = 44, pR = 16, pT = 20, pB = 44
      const plotH = H - pT - pB
      const weights = this.weightHistory.map((r : UTSJSONObject) : number => nget(r, 'weight'))
      if (weights.length > 0) {
        const minW = Math.floor(_minOf(weights)) - 2
        const maxW = Math.ceil(_maxOf(weights)) + 2
        const range = maxW - minW
        for (let i = 0; i <= 4; i++) {
          const y = pT + (i / 4) * plotH
          const v = maxW - (i / 4) * range
          gridFixed.push({ y: y, text: v.toFixed(1) } as UTSJSONObject)
        }
      }
      layout['grid'] = gridFixed
      this.lineChart = layout
    },
    closeWeightChart() { this.weightChartOpen = false },

    openBmiChart() {
      const W = this._winWidth() - 72
      this.bmiChartOpen = true
      this.bmiChartW = W
      this.lineChart = this._buildLineChartLayout(this.bmiHistory, 'bmi', '', '#6375EC')
    },
    closeBmiChart() { this.bmiChartOpen = false },

    openStepsChart() {
      const W = this._winWidth() - 72
      this.stepsChartOpen = true
      this.stepsChartW = W
      this.lineChart = this._buildLineChartLayout(this.stepsHistory, 'steps', '', '#0ea5e9')
    },
    closeStepsChart() { this.stepsChartOpen = false },

    openHrvChart() {
      const W = this._winWidth() - 72
      this.hrvChartOpen = true
      this.hrvChartW = W
      this.lineChart = this._buildLineChartLayout(this.hrvHistory, 'hrv', 'ms', '#10b981')
    },
    closeHrvChart() { this.hrvChartOpen = false },

    openStressChart() {
      const W = this._winWidth() - 72
      this.stressChartOpen = true
      this.stressChartW = W
      this.lineChart = this._buildLineChartLayout(this.stressHistory, 'stress', '', '#f97316')
    },
    closeStressChart() { this.stressChartOpen = false },

    openGlucoseChart() {
      const W = this._winWidth() - 72
      this.glucoseChartOpen = true
      this.glucoseChartW = W
      this.lineChart = this._buildLineChartLayout(this.glucoseHistory, 'glucose', 'mmol/L', '#a855f7')
    },
    closeGlucoseChart() { this.glucoseChartOpen = false },

    openBpChart() {
      const W = this._winWidth() - 72
      this.bpChartOpen = true
      this.bpChartW = W
      const history = this.bpHistory
      if (history.length < 1) { this.bpChartLayout = null; return }
      // _drawBpChart geometry: two series (SYS/DIA), min-5/max+5 bounds
      const H = 200, pL = 44, pR = 16, pT = 20, pB = 44
      const plotW = W - pL - pR, plotH = H - pT - pB
      const allVals : number[] = []
      for (const r of history) { allVals.push(nget(r, 'systolic')); allVals.push(nget(r, 'diastolic')) }
      const minV = Math.floor(_minOf(allVals)) - 5
      const maxV = Math.ceil(_maxOf(allVals)) + 5
      const range = (maxV - minV) == 0 ? 1 : maxV - minV
      const sysPts : UTSJSONObject[] = []
      const diaPts : UTSJSONObject[] = []
      for (let i = 0; i < history.length; i++) {
        const x = pL + (i / Math.max(history.length - 1, 1)) * plotW
        sysPts.push({ x: x, y: pT + ((maxV - nget(history[i], 'systolic')) / range) * plotH } as UTSJSONObject)
        diaPts.push({ x: x, y: pT + ((maxV - nget(history[i], 'diastolic')) / range) * plotH } as UTSJSONObject)
      }
      const grid : UTSJSONObject[] = []
      for (let i = 0; i <= 4; i++) {
        const y = pT + (i / 4) * plotH
        const v = maxV - (i / 4) * range
        grid.push({ y: y, text: `${Math.round(v)}` } as UTSJSONObject)
      }
      const labels : UTSJSONObject[] = []
      const labelStep = Math.max(1, Math.floor(history.length / 5))
      for (let i = 0; i < history.length; i++) {
        if (i % labelStep == 0 || i == history.length - 1) {
          labels.push({ x: sysPts[i].x, text: sget(history[i], 'date').substring(5) } as UTSJSONObject)
        }
      }
      this.bpChartLayout = { W: W, H: H, pL: pL, plotW: plotW, sysPts: sysPts, diaPts: diaPts, grid: grid, labels: labels } as UTSJSONObject
    },
    closeBpChart() { this.bpChartOpen = false; this.bpChartLayout = null },

    openSubAgeChart(key : string) {
      const history = this.subAgeArr(key)
      if (key.length == 0 || history.length < 2) return
      this._lastCrosshairIdx.delete('uh-subage-chart')
      let color = '#6375EC'
      for (const m of SUB_AGE_META) { if (sget(m, 'key') == key) color = sget(m, 'color') }
      const W = this._winWidth() - 72
      this.subAgeChartOpen = true
      this.subAgeChartKey = key
      this.subAgeChartW = W
      const layout = this._buildLineChartLayout(history, 'value', '', color)
      this.lineChart = layout
      this._registerLayout('uh-subage-chart', layout, 'line')
      // (miniapp: _cacheChartRect('uh-subage-chart') after open — xLeft is computed in _registerLayout)
    },
    closeSubAgeChart() {
      this.subAgeChartOpen = false
      this.lineChart = null
      this.lcCrossIdx = -1
      this.crossInfo = null
      this._chartLayouts.delete('uh-subage-chart')
      this._lastCrosshairIdx.delete('uh-subage-chart')
    },

    // A lab tile with more than one point opens its history — the same generic chart the
    // sub-ages use, fed by /api/lab-history?series=1 (points are {date, value}, oldest first).
    openLabChart(key : string) {
      const series = jget(this.labSeries, key)
      const points = series != null ? (series!.getArray<UTSJSONObject>('points') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
      if (key.length == 0 || points.length < 2) return
      this._lastCrosshairIdx.delete('uh-lab-chart')
      const isZh = (this.lang.length > 0 ? this.lang : 'zh') != 'en'
      const nameZh = series != null ? series!.getString('display_name_zh') : null
      const nameEn = series != null ? series!.getString('display_name') : null
      const title = isZh ? (nameZh != null && nameZh!.length > 0 ? nameZh! : key) : (nameEn != null && nameEn!.length > 0 ? nameEn! : key)
      const unit = series != null ? sget(series, 'unit') : ''
      const W = this._winWidth() - 72
      this.labChartOpen = true
      this.labChartKey = key
      this.labChartTitle = title
      this.labChartUnit = unit
      this.labChartW = W
      const layout = this._buildLineChartLayout(points, 'value', unit, '#0ea5e9')
      this.lineChart = layout
      this._registerLayout('uh-lab-chart', layout, 'line')
    },
    closeLabChart() {
      this.labChartOpen = false
      this.lineChart = null
      this.lcCrossIdx = -1
      this.crossInfo = null
      this._chartLayouts.delete('uh-lab-chart')
      this._lastCrosshairIdx.delete('uh-lab-chart')
    },

    closeAnyChart() {
      if (this.weightChartOpen) { this.weightChartOpen = false }
      if (this.bmiChartOpen) { this.bmiChartOpen = false; this._chartLayouts.delete('uh-bmi-chart') }
      if (this.stepsChartOpen) { this.stepsChartOpen = false }
      if (this.hrvChartOpen) { this.hrvChartOpen = false }
      if (this.stressChartOpen) { this.stressChartOpen = false }
      if (this.glucoseChartOpen) { this.glucoseChartOpen = false }
      if (this.subAgeChartOpen) { this.closeSubAgeChart(); return }
      if (this.labChartOpen) { this.closeLabChart(); return }
      this.lineChart = null
      this.lcCrossIdx = -1
      this.crossInfo = null
    },

    onWeightTileTap() { if (this.mode == 'self' && this.weightHistory.length > 1) this.openWeightChart() },
    onBmiTileTap() { if (this.bmiHistory.length > 1) this.openBmiChart() },
    onStepsTileTap() { if (this.stepsHistory.length > 1) this.openStepsChart() },
    onHrvTileTap() { if (this.hrvHistory.length > 1) this.openHrvChart() },
    onStressTileTap() { if (this.stressHistory.length > 1) this.openStressChart() },
    onBpTileTap() { if (this.bpHistory.length > 1) this.openBpChart() },
    onGlucoseTileTap() { if (this.glucoseHistory.length > 1) this.openGlucoseChart() },
    onLabTileTap(key : string) { this.openLabChart(key) },
    onSubAgeRowTap(key : string) {
      if (this.bioAgeTrendOpen) return
      if (this.subAgeHasTrend(key)) this.openSubAgeChart(key)
    },

    // BioAge trend: geometry of _drawBioAgeChart — headerH=62, plot below it, ceil/floor+2
    // bounds, x labels every len/4, crosshair incl. the ChronoAge dot + line when present.
    _buildBioAgeLayout() {
      const history = this.bioAgeHistory
      const W = this.bioAgeChartW
      if (W == 0) return
      const H = 200
      const headerH = 62
      const pL = 28, pR = 10, pT = headerH + 12, pB = 24
      const plotW = W - pL - pR, plotH = H - pT - pB
      if (history.length < 2) {
        this._chartLayouts.delete('dt-bioage-chart')
        this.bioAgeChart = { W: W, H: H, pL: pL, pT: pT, plotW: plotW, plotH: plotH, pts: [] as UTSJSONObject[], chronoPts: [] as UTSJSONObject[], grid: [] as UTSJSONObject[], xLabels: [] as UTSJSONObject[], crossBox: null, accent: sget(this._chartPalette(), 'accent') } as UTSJSONObject
        return
      }
      const allVals : number[] = []
      const bioAges : number[] = []
      for (const r of history) {
        bioAges.push(nget(r, 'bioAge'))
        const c = r.getNumber('chronoAge')
        if (c != null) allVals.push(c!)
      }
      const combined = bioAges.slice(0)
      for (const v of allVals) combined.push(v)
      const minV = Math.floor(_minOf(combined)) - 2
      const maxV = Math.ceil(_maxOf(combined)) + 2
      const range = (maxV - minV) == 0 ? 1 : maxV - minV
      const pts : UTSJSONObject[] = []
      const chronoPts : UTSJSONObject[] = []
      for (let i = 0; i < history.length; i++) {
        const x = pL + (i / Math.max(history.length - 1, 1)) * plotW
        pts.push({ x: x, y: pT + ((maxV - bioAges[i]) / range) * plotH } as UTSJSONObject)
        const c = history[i].getNumber('chronoAge')
        if (c != null) chronoPts.push({ x: x, y: pT + ((maxV - c!) / range) * plotH } as UTSJSONObject)
      }
      const step = Math.max(1, Math.floor(history.length / 4))
      const xLabels : UTSJSONObject[] = []
      for (let i = 0; i < history.length; i++) {
        if (i % step == 0 || i == history.length - 1) {
          xLabels.push({ x: pts[i].x, text: sget(history[i], 'date').substring(5) } as UTSJSONObject)
        }
      }
      const c = this._chartPalette()
      this.bioAgeChart = {
        W: W, H: H, pL: pL, pT: pT, pB: pB, plotW: plotW, plotH: plotH,
        pts: pts, chronoPts: chronoPts, xLabels: xLabels, grid: [] as UTSJSONObject[],
        maxLabel: `${maxV}`, minLabel: `${minV}`,
        accent: sget(c, 'accent'),
        minV: minV, maxV: maxV, range: range,
        crossBox: null,
      } as UTSJSONObject
      const cl = new ChartLayout()
      cl.pL = pL; cl.plotW = plotW; cl.len = history.length; cl.target = 'bioage'; cl.canvas = 'dt-bioage-chart'
      // xLeft unknown precisely for the inline chip (no createSelectorQuery on uvue here):
      // approximate from the hero card's padding — the crosshair is best-effort on this one.
      // TODO(port): exact rect via selector query is unavailable.
      cl.xLeft = (this._winWidth() - W) / 2 + 40
      this._chartLayouts.set('dt-bioage-chart', cl)
    },

    toggleBioAgeTrend() {
      const open = !this.bioAgeTrendOpen
      this._lastCrosshairIdx.delete('dt-bioage-chart')
      if (!open) {
        this.bioAgeChart = null
        this.bioAgeCross = -1
        this._chartLayouts.delete('dt-bioage-chart')
      }
      this.bioAgeTrendOpen = open
      if (open && this.bioAgeHistory.length > 1) {
        this._buildBioAgeLayout()
      }
    },

    closeBioAgeTrend() {
      if (this.bioAgeTrendOpen) {
        this._lastCrosshairIdx.delete('dt-bioage-chart')
        this.bioAgeChart = null
        this.bioAgeCross = -1
        this._chartLayouts.delete('dt-bioage-chart')
        this.bioAgeTrendOpen = false
      }
    },

    // Shared touch handlers for the crosshair — any chart that wants the drag-to-inspect
    // line registers its layout; the miniapp's canvas `x` was canvas-relative, with the
    // cached bounding rect as fallback. uvue gives window-relative clientX, so x is
    // clientX − layout.xLeft (see TODO(port) about _cacheChartRect).
    onChartTouch(canvasId : string, e : any | null) {
      if (canvasId != 'dt-bioage-chart' && canvasId != 'uh-subage-chart' && canvasId != 'uh-lab-chart') return
      const ev = e as UniTouchEvent
      const layout = this._chartLayouts.get(canvasId)
      const t = ev.touches
      if (layout == null || t.length == 0) return
      const touch = t[0]!
      let x = touch.clientX - layout.xLeft
      x = Math.max(layout.pL, Math.min(layout.pL + layout.plotW, x))
      const idx = Math.round((x - layout.pL) / layout.plotW * Math.max(layout.len - 1, 1))
      const prev = this._lastCrosshairIdx.get(canvasId)
      if (prev != null && prev == idx) return
      this._lastCrosshairIdx.set(canvasId, idx)
      this._redrawCrosshair(canvasId, idx)
    },

    _redrawCrosshair(canvasId : string, idx : number) {
      if (canvasId == 'dt-bioage-chart') {
        const layout = this.bioAgeChart
        if (layout == null) return
        const history = this.bioAgeHistory
        const pts = aget(layout, 'pts')
        if (idx < 0 || idx >= history.length || idx >= pts.length) return
        const clamped = Math.max(0, Math.min(history.length - 1, idx))
        const r = history[clamped]
        const minV = nget(layout, 'minV'), maxV = nget(layout, 'maxV'), range = nget(layout, 'range'), pT = nget(layout, 'pT'), plotH = nget(layout, 'plotH')
        const p = pts[clamped]
        const labelLines : UTSJSONObject[] = []
        labelLines.push({ text: sget(r, 'date') } as UTSJSONObject)
        const t = this.t
        const bio = nget(r, 'bioAge')
        labelLines.push({ text: `${tnum(t, 'bioAge')}: ${bio.toFixed(1)}` } as UTSJSONObject)
        const chrono = r.getNumber('chronoAge')
        if (chrono != null) {
          labelLines.push({ text: `${tnum(t, 'chronoAge')}: ${chrono!.toFixed(1)}` } as UTSJSONObject)
        }
        const cross = this._buildCrossInfo({
          W: nget(layout, 'W'), pT: pT, plotH: plotH, x: nget(p, 'x'), labelLines: labelLines,
        } as UTSJSONObject)
        const merged = { } as UTSJSONObject
        layout.toMap().forEach((v : any | null, k : string) => { merged[k] = v })
        merged['crossBox'] = jget(cross, 'box')
        merged['crossLines'] = aget(cross, 'labelLines')
        this.bioAgeChart = merged
        this.bioAgeCross = clamped
        return
      }
      // line chart (sub-age / lab)
      const layout2 = this.lineChart
      if (layout2 == null) return
      const pts2 = aget(layout2, 'pts')
      if (idx < 0 || idx >= pts2.length) return
      let history : UTSJSONObject[] = []
      let valKey = 'value'
      let unit = sget(layout2, 'unit')
      if (this.subAgeChartOpen) { history = this.subAgeArr(this.subAgeChartKey); valKey = 'value' }
      else if (this.labChartOpen) {
        const series = jget(this.labSeries, this.labChartKey)
        history = series != null ? (series!.getArray<UTSJSONObject>('points') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        valKey = 'value'
      }
      if (idx >= history.length) return
      const p = pts2[idx]
      const v = nget(history[idx], valKey)
      const valStr = Math.floor(v) == v ? `${v}` : v.toFixed(1)
      const labelLines : UTSJSONObject[] = []
      labelLines.push({ text: sget(history[idx], 'date') } as UTSJSONObject)
      labelLines.push({ text: unit.length > 0 ? `${valStr} ${unit}` : valStr } as UTSJSONObject)
      this.lcCrossIdx = idx
      this.crossInfo = this._buildCrossInfo({
        W: nget(layout2, 'W'), pT: nget(layout2, 'pT'), plotH: nget(layout2, 'plotH'), x: nget(p, 'x'), labelLines: labelLines,
      } as UTSJSONObject)
    },

    onChartTouchEnd(canvasId : string) {
      this._lastCrosshairIdx.delete(canvasId)
      if (canvasId == 'dt-bioage-chart') {
        this.bioAgeCross = -1
        if (this.bioAgeChart != null) {
          const merged = { } as UTSJSONObject
          this.bioAgeChart!.toMap().forEach((v : any | null, k : string) => { merged[k] = v })
          merged['crossBox'] = null
          merged['crossLines'] = [] as UTSJSONObject[]
          this.bioAgeChart = merged
        }
        return
      }
      this.lcCrossIdx = -1
      this.crossInfo = null
    },

    // Caches the canvas's page-relative bounding rect as a fallback for touch coordinates.
    // TODO(port): wx.createSelectorQuery().boundingClientRect is unavailable; xLeft is
    // approximated from the modal width at layout time instead. This hook is kept so the
    // textScale watcher has something to call.
    _cacheChartRect(_canvasId : string) { },

    // ── Wearable (Smart Ring / Band) ──────────────────────────────────────

    // Public bridge used by pages/main/main.uvue ($refs → HealthCompApi):
    // refresh(), refreshIfStale(ms), refreshHealthReports(), setAvatarUpdating(v),
    // maybeAutoSync().
    // TODO(port): main.uvue's HealthCompApi declares maybeAutoSync(): Promise<any>|null;
    // this returns Promise<void>|null — the same shape the miniapp's main.js awaited (it only
    // awaits "did a sync start"). Resolve the interface typing at the first HBuilderX compile.
    setAvatarUpdating(v : boolean) {
      this.avatarUpdating = v
    },

    maybeAutoSync() : Promise<void> | null {
      return this._maybeAutoSync()
    },

    // Returns the handleSyncWearable() promise when a sync is actually kicked off (so callers
    // like onShow() can await it before establishing heartbeat eligibility), or null when no
    // sync is due/possible.
    _maybeAutoSync() : Promise<void> | null {
      // A server-only binding ('__server__') has nothing local to connect to, and handleSyncWearable
      // turns it into the bind flow — fine behind a tap, but opening the tab must not pop a picker.
      if (this.wearableBusy || this.wearableId.length == 0 || this.wearableId == '__server__') return null
      try {
        const raw = _storageObj('wearable_ring_data')
        const lastSync = raw != null ? (raw!.getNumber('syncedAt') ?? 0) : 0
        if (Date.now() - lastSync > 30 * 60 * 1000) {
          return this.handleSyncWearable()
        }
      } catch (e : any) {}
      return null
    },

    _loadWearableFromStorage() {
      try {
        const saved = _storageObj('wearable_device')
        const hasLocalDevice = saved != null && sget(saved, 'deviceId').length > 0
        if (hasLocalDevice) {
          const brand = _normalizeBrand(sget(saved, 'brand'))
          // TODO(port): colmi/aizo are not ported to xapp (§18); the legacy default brand
          // 'colmi' would only ever reach the not-ported error path, so treat a missing brand
          // as unknown here.
          const effectiveBrand = brand.length > 0 ? brand : 'halo'
          const fallbackName = effectiveBrand == 'halo' ? 'Halo Ring' : (effectiveBrand == 'v8' ? 'V8 Band' : 'Ring')
          const haloSaved = _storageObj('halo_interval_settings') ?? _storageObj('x3_interval_settings')
          const haloIntervals = { } as UTSJSONObject
          this.haloIntervals.toMap().forEach((v : any | null, k : string) => { haloIntervals[k] = v })
          if (haloSaved != null) haloSaved!.toMap().forEach((v : any | null, k : string) => { haloIntervals[k] = v })
          const haloWmSaved = _storageObj('halo_work_mode_settings') ?? _storageObj('x3_work_mode_settings')
          const haloWorkModes = { } as UTSJSONObject
          this.haloWorkModes.toMap().forEach((v : any | null, k : string) => { haloWorkModes[k] = v })
          if (haloWmSaved != null) haloWmSaved!.toMap().forEach((v : any | null, k : string) => { haloWorkModes[k] = v })
          const nameOpt = saved!.getString('name')
          this.wearableId = sget(saved, 'deviceId')
          this.wearableName = nameOpt != null && nameOpt!.length > 0 ? nameOpt : fallbackName
          this.wearableConnected = false
          this.wearableBrand = effectiveBrand
          this.haloIntervals = haloIntervals
          this.haloWorkModes = haloWorkModes
          // Delay auto-sync to let the BLE stack initialize on cold launch
          setTimeout(() => { this._maybeAutoSync() }, 2000)
          this._ensureWearableBindingSynced(effectiveBrand, saved!.getString('mac'), this.wearableName)
        } else {
          // No local binding on this device/install — check if the account already has a ring
          // registered from another client app (Android/iOS builds of this same codebase, or a
          // previous install) so we can hint the user instead of them thinking they've never
          // paired a ring.
          this._loadWearableHintFromServer()
        }
        // Chart/reading data always comes from the server (single source of truth — a local
        // wearable_ring_data snapshot can silently drift from it, e.g. after a server-side
        // data correction, with nothing to invalidate the stale cache). Binding state above
        // stays local since BLE pairing is inherently device-specific.
        this._loadRingDataFromServer()
      } catch (e : any) {}
    },

    // Persists (or clears, when `wearable` is null) the wearable binding on the user's
    // account so other client apps built from this codebase can discover it. Best-effort —
    // failures here shouldn't block the local bind/unbind flow.
    async _syncWearableBindingToServer(wearable : UTSJSONObject | null) {
      const userId = this.userId
      if (userId.length == 0) return
      try {
        await this._req(`${BASE}/api/users/${userId}`, 'PATCH', { wearable: wearable } as UTSJSONObject)
      } catch (e : any) {
        if (IS_DEV) console.error('[wearable][server-sync]', e)
      }
    },

    // Called when this device/install DOES have a local wearable_device — the initial
    // bind-time push to the server can silently fail, or the binding may predate that push
    // existing at all (confirmed: a real account synced ring data for months with
    // wearable_brand still NULL server-side). Self-heals by comparing against the server
    // record and only PATCHing when it's actually out of sync — avoids bumping
    // wearable_bound_at on every load once it matches.
    async _ensureWearableBindingSynced(brand : string, mac : string | null, name : string) {
      const userId = this.userId
      if (userId.length == 0 || brand.length == 0) return
      try {
        const res = await this._req(`${BASE}/api/users/${userId}`, 'GET', null)
        const body = res.data
        const user = body != null ? body!.getJSON('user') : null
        if (user == null) return
        if (sget(user, 'wearable_brand') != brand || sget(user, 'wearable_name') != name) {
          this._syncWearableBindingToServer({ brand: brand, mac: mac, name: name } as UTSJSONObject)
        }
      } catch (e : any) {
        if (IS_DEV) console.error('[wearable][binding-selfheal]', e)
      }
    },

    // Called when this device/install has no local wearable_device — checks whether the
    // account already has a ring bound (from another client app or a previous install) so
    // the UI can hint "you already have a ring, tap Scan to reconnect" instead of looking
    // like the user has never paired one.
    async _loadWearableHintFromServer() {
      const userId = this.userId
      if (userId.length == 0) return
      try {
        const res = await this._req(`${BASE}/api/users/${userId}`, 'GET', null)
        const body = res.data
        const user = body != null ? body!.getJSON('user') : null
        if (user != null && sget(user, 'wearable_brand').length > 0) {
          this.wearableServerHint = {
            brand: sget(user, 'wearable_brand'),
            mac: user.getString('wearable_mac'),
            name: user.getString('wearable_name'),
            boundAt: user.getString('wearable_bound_at'),
          } as UTSJSONObject
        }
      } catch (e : any) {
        if (IS_DEV) console.error('[wearable][server-hint]', e)
      }
    },

    async _loadRingDataFromServer() {
      const userId = this.userId
      const lang = this.lang
      if (userId.length == 0) return
      const isZh = (lang.length > 0 ? lang : 'zh') != 'en'
      try {
        // 'vitals' bundles temp/hrv/spo2/resting_hr/realtime sub-streams sharing one budget —
        // temp samples more frequently than hrv on Halo, so 200 silently crowded hrv/spo2 out
        // of the "most recent N" window (confirmed: a 135-record hrv sync only left 32 visible
        // after reload). Matches the server's own raised cap.
        const enc = encodeURIComponent(userId)
        const vitalsP = this._req(`${BASE}/api/health-events?openid=${enc}&category=vitals&limit=1000`, 'GET', null)
        const activityP = this._req(`${BASE}/api/health-events?openid=${enc}&category=activity&limit=14`, 'GET', null)
        const sleepP = this._req(`${BASE}/api/health-events?openid=${enc}&category=sleep&limit=14`, 'GET', null)
        const results : RespEnvelope[] = await Promise.all([vitalsP, activityP, sleepP])
        const vitalsRes = results[0]
        const activityRes = results[1]
        const sleepRes = results[2]
        // uni.request resolves for ANY completed HTTP response (2xx, 4xx, 5xx alike) — only a
        // network-level failure rejects. So an auth error or 5xx here would otherwise silently
        // look like "no events yet" (data?.events defaults to []) instead of surfacing as a
        // real error.
        const labels : string[] = ['vitals', 'activity', 'sleep']
        for (let i = 0; i < results.length; i++) {
          const r = results[i]
          if (r.statusCode != 200 || (r.data != null && r.data!.getBoolean('success') == false)) {
            if (IS_DEV) console.error('[wearable][server-data]', labels[i], r.statusCode, r.data)
          }
        }
        const vitalsEvents = vitalsRes.data != null ? (vitalsRes.data!.getArray<UTSJSONObject>('events') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        const activityEvents = activityRes.data != null ? (activityRes.data!.getArray<UTSJSONObject>('events') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        const sleepEvents = sleepRes.data != null ? (sleepRes.data!.getArray<UTSJSONObject>('events') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        if (vitalsEvents.length == 0 && activityEvents.length == 0 && sleepEvents.length == 0) return

        const _tsFromExtId = (extId : string) : string | null => {
          const parts = extId.split('_')
          const ts = parts[parts.length - 1]
          if (ts.length != 14) return null
          let digits = true
          for (let i = 0; i < ts.length; i++) {
            const c = ts.charCodeAt(i) ?? 0
            if (c < 48 || c > 57) { digits = false; break }
          }
          if (!digits) return null
          return `${ts.substring(0, 4)}-${ts.substring(4, 6)}-${ts.substring(6, 8)} ${ts.substring(8, 10)}:${ts.substring(10, 12)}:${ts.substring(12, 14)}`
        }

        // Derive syncedAt from most recent ingested_at across all events
        let latestIngestedMs = 0
        const allEvents : UTSJSONObject[] = []
        for (const e of vitalsEvents) allEvents.push(e)
        for (const e of activityEvents) allEvents.push(e)
        for (const e of sleepEvents) allEvents.push(e)
        for (const ev of allEvents) {
          const ia = ev.getString('ingested_at')
          const t = ia != null ? _toMs(ia) : 0
          if (!isNaN(t) && t > latestIngestedMs) latestIngestedMs = t
        }
        const rawRing = { } as UTSJSONObject
        rawRing['syncedAt'] = latestIngestedMs > 0 ? latestIngestedMs : Date.now()

        // Activity
        if (activityEvents.length > 0) {
          const d = this._pd(activityEvents[0].get('data'))
          if (d != null) {
            rawRing['steps'] = d!.get('steps')
            rawRing['calories'] = d!.get('calories')
            rawRing['distance'] = d!.get('distance_m')
            rawRing['stepSlots'] = d!.get('slots')
          }
        }

        // Sleep: flatten every date's event into its individual sessions (naps kept distinct
        // from night sleep — see _sessionsFromEventData) for the weekly multi-block timeline,
        // then merge every session belonging to the most recent night (see _selectLastNight)
        // for the "Last Night" quick-glance card.
        const sleepHistoryAll : UTSJSONObject[] = []
        for (const ev of sleepEvents) {
          const date = sget(ev, 'data_date').substring(0, 10)
          for (const s of _sessionsFromEventData(date, this._pd(ev.get('data')))) {
            if ((s.getNumber('totalMinutes') ?? 0) > 0) sleepHistoryAll.push(s)
          }
        }
        sleepHistoryAll.sort((a, b) : number => {
          const ak = sget(a, 'onset').length > 0 ? sget(a, 'onset') : sget(a, 'date')
          const bk = sget(b, 'onset').length > 0 ? sget(b, 'onset') : sget(b, 'date')
          return ak < bk ? -1 : 1
        })
        rawRing['sleepHistory'] = sleepHistoryAll

        const lastNight = _selectLastNight(sleepHistoryAll)
        if (lastNight != null) {
          rawRing['sleepMinutes'] = lastNight!.get('totalMinutes')
          rawRing['sleepDeep'] = lastNight!.get('deep')
          rawRing['sleepLight'] = lastNight!.get('light')
          rawRing['sleepRem'] = lastNight!.get('rem')
          rawRing['sleepAwake'] = lastNight!.get('awake')
          rawRing['sleepStart'] = lastNight!.get('sleepStart')
          rawRing['sleepEnd'] = lastNight!.get('sleepEnd')
          rawRing['sleepSlots'] = lastNight!.get('slots')
          rawRing['sleepOnset'] = lastNight!.get('onset')
          rawRing['sleepDate'] = lastNight!.get('date')
        }

        // Vitals: split into resting-HR, HRV slots, SpO2 slots, temp, realtime
        const hrvSlots : UTSJSONObject[] = []
        const spo2Slots : UTSJSONObject[] = []
        let latestHrv : UTSJSONObject | null = null
        let latestSpo2 : UTSJSONObject | null = null

        for (const ev of vitalsEvents) {
          const d = this._pd(ev.get('data'))
          if (d == null) continue
          const extId = sget(ev, 'external_id')

          if (extId.indexOf('_resting_hr_') != -1) {
            if (rawRing.get('restingHr') == null) {
              rawRing['restingHr'] = d!.get('resting_hr')
              if (d!.get('hr_slots') != null) rawRing['hrSlots'] = d!.get('hr_slots')
            }
          } else if (extId.indexOf('_hrv_') != -1) {
            const ts = _tsFromExtId(extId)
            if (ts != null) {
              hrvSlots.push({
                timestamp: ts,
                hrv: d!.get('hrv_ms'),
                stress: d!.get('stress'),
                breath: d!.get('breath_rate'),
                heartRate: d!.get('heart_rate_hrv'),
                highBP: d!.get('bp_systolic'),
                lowBP: d!.get('bp_diastolic'),
              } as UTSJSONObject)
            }
            if (latestHrv == null) latestHrv = d
          } else if (extId.indexOf('_spo2_') != -1) {
            const ts = _tsFromExtId(extId)
            if (ts != null) spo2Slots.push({ timestamp: ts, spo2: d!.get('spo2') } as UTSJSONObject)
            if (latestSpo2 == null && d!.getNumber('spo2') != null) latestSpo2 = d
          } else if (extId.indexOf('_temp_') != -1) {
            if (rawRing.get('bodyTempC') == null && d!.getNumber('body_temp_c') != null) rawRing['bodyTempC'] = d!.get('body_temp_c')
          } else if (extId.indexOf('_realtime_') != -1) {
            if (latestHrv == null) latestHrv = d
            if (latestSpo2 == null && d!.getNumber('spo2') != null) latestSpo2 = d
          }
        }

        if (hrvSlots.length > 0) {
          hrvSlots.sort((a, b) : number => sget(a, 'timestamp') < sget(b, 'timestamp') ? 1 : -1)
          rawRing['hrvSlots'] = hrvSlots
        }
        if (spo2Slots.length > 0) {
          spo2Slots.sort((a, b) : number => sget(a, 'timestamp') < sget(b, 'timestamp') ? 1 : -1)
          rawRing['spo2Slots'] = spo2Slots
        }

        if (latestHrv != null) {
          rawRing['hrv'] = latestHrv!.get('hrv_ms')
          rawRing['stress'] = latestHrv!.get('stress')
          rawRing['breathRate'] = latestHrv!.get('breath_rate')
          rawRing['systolicBP'] = latestHrv!.get('bp_systolic')
          rawRing['diastolicBP'] = latestHrv!.get('bp_diastolic')
        }
        if (latestSpo2 != null) rawRing['spo2'] = latestSpo2!.get('spo2')

        // Same display pipeline as _loadWearableFromStorage
        const rawHrvSlotsArr = rawRing.getArray<UTSJSONObject>('hrvSlots')
        const rawReads = (rawHrvSlotsArr != null && rawHrvSlotsArr!.length > 0)
          ? _slotsToReadings(rawHrvSlotsArr, rawRing.getArray<UTSJSONObject>('spo2Slots'))
          : ([] as UTSJSONObject[])
        const realtimeReadings = _fmtRealtimeReadings(rawReads)
        const charts = _buildReadingLineCharts(rawReads)
        const base = _buildRingDisplayData(rawRing, isZh)
        const ringData = { } as UTSJSONObject
        base.toMap().forEach((v : any | null, k : string) => { ringData[k] = v })
        ringData['realtimeReadings'] = realtimeReadings
        ringData['hasRealtimeReadings'] = realtimeReadings.length > 0
        const hrvChart = jget(charts, 'hrvChart')
        const spo2Chart = jget(charts, 'spo2Chart')
        const stressChart = jget(charts, 'stressChart')
        ringData['hrvChart'] = hrvChart
        ringData['spo2Chart'] = spo2Chart
        ringData['stressChart'] = stressChart
        ringData['hasSlotCharts'] = bget(base, 'hasSlotCharts') || bget(hrvChart, 'hasData') || bget(spo2Chart, 'hasData') || bget(stressChart, 'hasData')
        const syncedMs = nget(rawRing, 'syncedAt')
        const recentSync = (Date.now() - syncedMs) < 24 * 60 * 60 * 1000
        // A real local BLE binding (set by _loadWearableFromStorage, self-view only) must win
        // here — overwriting it with the server-hydration sentinel would break "Sync Now" for
        // a device that's actually paired.
        const hasRealBinding = this.wearableId.length > 0 && this.wearableId != '__server__'
        if (!hasRealBinding) this.wearableId = '__server__'
        this.wearableConnected = recentSync
        this.ringData = ringData
        this.mood = computeMood(this._moodRaw(ringData))
        this.twinLoading = false
        this._applyBandToHrvBars()
      } catch (e : any) {
        if (IS_DEV) console.error('[wearable][server-data]', e)
      }
    },

    // mood/§20: the ring snapshot feeds computeMood through the same MoodRaw shape
    // utils/mood.uts documents ("same raw ring-data shape the health tab already builds").
    _moodRaw(rd : UTSJSONObject) : MoodRaw {
      const m = new MoodRaw()
      m.stress = rd.getNumber('stress')
      m.sleepMinutes = rd.getNumber('sleepMinutes')
      m.hrv = rd.getNumber('hrv')
      m.steps = rd.getNumber('steps')
      m.restingHr = rd.getNumber('restingHr')
      m.spo2 = rd.getNumber('spo2')
      m.systolicBP = rd.getNumber('systolicBP')
      m.diastolicBP = rd.getNumber('diastolicBP')
      return m
    },

    onPrivacyAgree() {
      // TODO(port): WeChat's privacy-authorization plumbing (app._privacyResolve with
      // {event:'agree', buttonId}) has no native equivalent; kept for shape parity.
      if (_privacyResolve != null) {
        _privacyResolve!({ event: 'agree', buttonId: 'privacy-agree-btn' } as UTSJSONObject)
        _privacyResolve = null
      }
      this.showPrivacyPopup = false
      if (_privacyDone != null) { _privacyDone!(true); _privacyDone = null }
    },

    onPrivacyCancel() {
      if (_privacyResolve != null) {
        _privacyResolve!({ } as UTSJSONObject)
        _privacyResolve = null
      }
      this.showPrivacyPopup = false
      if (_privacyDone != null) { _privacyDone!(false); _privacyDone = null }
    },

    async handleBindWearable() {
      if (this.wearableBusy) return
      const t = this.t
      this.wearableBusy = true
      try {
        // Discovery runs over the installed BleTransport (utils/wearable/transport.uts:
        // transport-android.uts on Android, transport-mp.uts on xapp-mini; App.uvue installs it).
        // Without one (iOS, web) the bind flow reports a connection failure instead of silently
        // scanning nothing.
        // Colmi/Aizo name prefixes and the Aizo service-UUID advertisement check are NOT
        // ported (§18): xapp binds Halo + V8 only.
        const transport = getInstalledBleTransport()
        if (transport == null || !hasBleTransport()) {
          uni.showToast({ title: tnum(t, 'wearableConnectFail'), icon: 'none', duration: 2500 })
          this.wearableBusy = false
          return
        }
        // Open BLE adapter — the transport/OS prompts to enable Bluetooth if off
        const mgr = new BLEManager(transport)
        await mgr.openAdapter()

        // Scan with live updates so the user sees progress (6s window, same as the miniapp)
        uni.showLoading({ title: tnum(t, 'wearableScanning'), mask: false })
        const prefixes : string[] = []
        for (const p of HALO_NAME_PREFIXES) prefixes.push(p)
        for (const p of V8_NAME_PREFIXES) prefixes.push(p)
        const devices = await mgr.scan(prefixes, 6000)
        uni.hideLoading()

        if (devices.length == 0) {
          uni.showToast({ title: tnum(t, 'wearableNoDevices'), icon: 'none', duration: 3000 })
          this.wearableBusy = false
          return
        }

        // Show device picker (action sheet)
        const names : string[] = devices.map((d : BleScanDevice) : string => `${d.name}  (RSSI ${d.rssi})`)
        const chosen : BleScanDevice = await new Promise<BleScanDevice>((resolve : (d : BleScanDevice) => void, reject : (e : any | null) => void) => {
          uni.showActionSheet({
            itemList: names,
            success: (res) => {
              const idx = res.tapIndex
              if (idx >= 0 && idx < devices.length) resolve(devices[idx])
              else reject(new Error('cancelled'))
            },
            fail: (err : any) => { reject(err) },
          })
        })

        uni.showLoading({ title: tnum(t, 'wearableConnecting'), mask: true })
        const lowerName = chosen.name.toLowerCase()
        let brand = 'v8'
        let isHalo = false
        for (const p of HALO_NAME_PREFIXES) { if (lowerName.startsWith(p.toLowerCase())) { isHalo = true } }
        if (isHalo) brand = 'halo'
        const ring = createWearable(brand)
        // Halo/V8: apply default scheduled monitoring immediately on first bind
        const defaultIvals = { hr: 30, spo2: 60, temp: 60, hrv: 120 } as UTSJSONObject
        const defaultWms = { hr: 2, spo2: 2, temp: 2, hrv: 2 } as UTSJSONObject
        let batteryLevel = 0
        let mac : string | null = null
        try {
          await _ro_connect(ring, chosen.deviceId, true)
          batteryLevel = await _ro_getBatteryLevel(ring)
          // MAC is the ring's stable hardware identifier (unlike deviceId, which is a
          // per-OS/per-scan BLE handle) — both Halo and V8 expose it.
          mac = await _ro_getMac(ring).catch((e : any | null) : string | null => null)

          if (_hasIntervalSettings(brand)) {
            // weekdays bitmask 0x7F = 127 = all days (no bitwise ops in UTS)
            const mkSettings = (intervalMinutes : number, type : number, wm : number) : AutoMonitoringSettings => {
              const s = new AutoMonitoringSettings()
              s.workMode = wm; s.startHour = 0; s.startMinute = 0; s.endHour = 23; s.endMinute = 59
              s.weekdays = 127; s.intervalMinutes = intervalMinutes; s.type = type
              return s
            }
            await _ro_setAutoMonitoring(ring, mkSettings(nget(defaultIvals, 'hr'), 1, 2)).catch((e : any | null) => {})
            await _ro_setAutoMonitoring(ring, mkSettings(nget(defaultIvals, 'spo2'), 2, 2)).catch((e : any | null) => {})
            await _ro_setAutoMonitoring(ring, mkSettings(nget(defaultIvals, 'temp'), 3, 2)).catch((e : any | null) => {})
            await _ro_setAutoMonitoring(ring, mkSettings(nget(defaultIvals, 'hrv'), 4, 2)).catch((e : any | null) => {})
            uni.setStorageSync('halo_interval_settings', defaultIvals)
            uni.setStorageSync('halo_work_mode_settings', defaultWms)
          }
        } finally {
          // Always tear down the connection, even if connect/getBattery/etc. threw — a leaked
          // connection blocks the ring's single connection slot until it times out on its own
          // (see halo-smart-ring.md §BLE).
          await _ro_disconnect(ring).catch((e : any | null) => {})
        }
        uni.hideLoading()

        const saved = { deviceId: chosen.deviceId, name: chosen.name, brand: brand } as UTSJSONObject
        uni.setStorageSync('wearable_device', saved)
        this.wearableId = chosen.deviceId
        this.wearableName = chosen.name
        this.wearableBrand = brand
        this.wearableConnected = true
        this.wearableBattery = batteryLevel
        this.wearableBusy = false
        this.wearableServerHint = null
        if (_hasIntervalSettings(brand)) {
          this.haloIntervals = defaultIvals
          this.haloWorkModes = defaultWms
        }
        // Best-effort — so other client apps (Android/iOS builds of this same codebase, or a
        // miniapp reinstall) can discover the same ring later.
        this._syncWearableBindingToServer({ brand: brand, mac: mac, name: chosen.name } as UTSJSONObject)
      } catch (e : any) {
        uni.hideLoading()
        console.error('[BLE][bind]', e)
        if (!_isPrivacyError(e)) uni.showToast({ title: tnum(this.t, 'wearableConnectFail'), icon: 'none', duration: 2500 })
        this.wearableBusy = false
      }
    },

    async handleSyncWearable() {
      if (this.wearableBusy || this.wearableId.length == 0) return
      // A binding known only from the server ('__server__': bound on another phone or in
      // xapp-mini) has no local device id or brand to connect to. Pair it here first — the bind
      // flow scans, saves wearable_device and re-syncs. (The miniapp has the same dead end:
      // its Sync Now falls through to a failed connect.)
      if (this.wearableId == '__server__' || _storageObj('wearable_device') == null) {
        this.handleBindWearable()
        return
      }
      const t = this.t
      const lang = this.lang.length > 0 ? this.lang : 'zh'
      const isZh = lang != 'en'
      this.wearableBusy = true
      this.ringMeasuring = false
      const savedDev = _storageObj('wearable_device') ?? ({ } as UTSJSONObject)
      const brand = _normalizeBrand(sget(savedDev, 'brand'))
      // TODO(port): Colmi/Aizo sync branches (two-phase realtime measurement / 0xCC history)
      // are deliberately NOT ported to xapp — Halo/V8 only per AGENTS §18; createWearable
      // throws for those brands and the error toast below is the intended UX.
      if (brand != 'halo' && brand != 'v8') {
        uni.showToast({ title: tnum(t, 'wearableSyncFail'), icon: 'none' })
        this.wearableBusy = false
        return
      }
      const ring = createWearable(brand)

      // ── Halo / V8: single-phase sync — all data is historical, no real-time measurement needed ──
      try {
        // Incremental sync: derive a per-type "since" cursor from the previous snapshot
        // instead of re-fetching full history every time (see docs/architecture/
        // halo-smart-ring.md §9). Validated live on both brands: HRV (0x56), SpO2 (0x66),
        // temperature (0x62), steps detail (0x52) and sleep (0x53) all correctly honor mode
        // 0x01 on both brands — but ONLY when `since` exactly matches one of the device's
        // own stored record timestamps (inclusive boundary); any other value, even one
        // second off, silently falls back to returning full history. _deriveSinceDate above
        // always passes the exact last-known timestamp for this reason. Static HR (0x55) is
        // enabled for Halo only — V8's 0x55 was NOT retested (§6-7), so V8 stays on the full
        // fetch; the same applies to V8 sleep-block since-date support being unconfirmed at
        // the protocol layer, which is why INCREMENTAL_SUPPORT.hr is false for v8.
        const incrementalHr = brand == 'halo'
        const _prevRing = _storageObj('wearable_ring_data') ?? ({ } as UTSJSONObject)
        const prevSyncedAt = _prevRing.getNumber('syncedAt')
        const _prevIsToday = prevSyncedAt != null && prevSyncedAt! > 0 && _shanghaiDateStr(prevSyncedAt!) == _shanghaiDateStr(Date.now())
        const _sinceHr = incrementalHr && _prevIsToday ? _deriveSinceDate(_prevRing.getArray<UTSJSONObject>('hrSlots'), 't') : null
        const _sinceHrv = _deriveSinceDate(_prevRing.getArray<UTSJSONObject>('hrvSlots'), 'timestamp')
        const _sinceSpo2 = _deriveSinceDate(_prevRing.getArray<UTSJSONObject>('spo2Slots'), 'timestamp')
        const _sinceTemp = _deriveSinceDate(_prevRing.getArray<UTSJSONObject>('tempSlots'), 'date')
        const _sinceSteps = _prevIsToday ? _deriveSinceDate(_prevRing.getArray<UTSJSONObject>('stepSlots'), 't') : null
        const _sinceSleep = _deriveSinceDate(_prevRing.getArray<UTSJSONObject>('sleepBlocks'), 'dateStr')

        await _ro_connect(ring, this.wearableId, true)
        // Apply background measurement intervals. Track failures so we can detect if the
        // ring's schedule was wiped (e.g. after a full battery drain).
        const _ivals = this.haloIntervals
        const _wms = this.haloWorkModes
        const mkSettings = (intervalMinutes : number, type : number, wm : number) : AutoMonitoringSettings => {
          const s = new AutoMonitoringSettings()
          s.workMode = wm; s.startHour = 0; s.startMinute = 0; s.endHour = 23; s.endMinute = 59
          s.weekdays = 127; s.intervalMinutes = intervalMinutes; s.type = type
          return s
        }
        let _monitorFailed = 0
        const typeIv : number[] = [nget(_ivals, 'hr'), nget(_ivals, 'spo2'), nget(_ivals, 'temp'), nget(_ivals, 'hrv')]
        const typeWm : number[] = [nget(_wms, 'hr'), nget(_wms, 'spo2'), nget(_wms, 'temp'), nget(_wms, 'hrv')]
        for (let i = 0; i < 4; i++) {
          try { await _ro_setAutoMonitoring(ring, mkSettings(typeIv[i], i + 1, typeWm[i])) }
          catch (e : any) { _monitorFailed++ }
        }
        // Read back HRV (type 4) to verify the ring accepted the schedule.
        try {
          const _s4 = await _ro_getAutoMonitoring(ring, 4)
          if (IS_DEV) console.log(JSON.stringify({ level: 'DEBUG', msg: 'HRV monitor readback', brand: brand, config: _s4 } as UTSJSONObject))
          if (nget(_s4, 'workMode') == 0 || nget(_s4, 'intervalMinutes') == 0) {
            console.log(JSON.stringify({ level: 'WARN', msg: 'HRV auto-monitor not active after sync', brand: brand, config: _s4 } as UTSJSONObject))
          }
        } catch (e : any) {}
        if (_monitorFailed > 0) {
          console.log(JSON.stringify({ level: 'WARN', msg: 'setAutoMonitoring partial failure', brand: brand, failed: _monitorFailed } as UTSJSONObject))
        }
        const batteryLevel = await _ro_getBatteryLevel(ring)
        const steps = await _ro_getSteps(ring, _sinceSteps).catch((e : any | null) : UTSJSONObject | null => null)

        // Sleep: incremental path fetches raw blocks and merges them with the previous sync's
        // raw blocks before re-deriving night summaries — the night/session-grouping algorithm
        // needs the full set of a night's blocks, not just this sync's new slice. Both brands
        // expose getSleepBlocks(sinceDate)/a summarize function with the same shape (Halo:
        // summariseSleepBlocks in halo/parsers; V8: summariseV8SleepBlocks) — only which module
        // to pull the summarizer from differs. Non-incremental path (stale/no cursor) is the
        // original full-fetch-then-summarize call, unchanged.
        let mergedSleepBlocks : UTSJSONObject[] | null = null
        let sleepHist : UTSJSONObject[]
        // Sleep incremental is enabled for both brands (live-validated 2026-07-31 — see the
        // block comment above and v8-smart-band.md).
        const newSleepBlocks = await _ro_getSleepBlocks(ring, _sinceSleep).catch((e : any | null) : UTSJSONObject[] => [] as UTSJSONObject[])
        mergedSleepBlocks = _mergeRingSlots(_prevRing.getArray<UTSJSONObject>('sleepBlocks') ?? ([] as UTSJSONObject[]), newSleepBlocks, 'dateStr', RING_SLOT_RETENTION_DAYS)
        sleepHist = _summariseSleep(brand, mergedSleepBlocks!)
        const sleepHistoryNorm : UTSJSONObject[] = sleepHist
          .filter((n : UTSJSONObject) : boolean => (n.getNumber('totalMinutes') ?? 0) > 0)
          .map((n : UTSJSONObject) : UTSJSONObject => ({
            date: n.get('date'),
            onset: n.get('onset'),
            totalMinutes: n.get('totalMinutes'),
            deep: n.get('deep'),
            light: n.get('light'),
            rem: n.get('rem'),
            awake: n.get('awake'),
            sleepStart: n.get('sleepStart'),
            sleepEnd: n.get('sleepEnd'),
            slots: n.get('slots'),
          } as UTSJSONObject))
        // Merge every session belonging to the most recent night (see _selectLastNight) so
        // "Last Night" reflects the whole night rather than only its most recent
        // wake-interrupted segment.
        const sleep = _selectLastNight(sleepHistoryNorm)
        const hrLog = await _ro_getHeartRateLog(ring, _sinceHr).catch((e : any | null) : UTSJSONObject[] | null => null)
        const hrvLog = await _ro_getHrvHistory(ring, _sinceHrv).catch((e : any | null) : UTSJSONObject[] => [] as UTSJSONObject[])   // new/incremental records only
        const spo2Log = await _ro_getSpo2History(ring, _sinceSpo2).catch((e : any | null) : UTSJSONObject[] => [] as UTSJSONObject[]) // new/incremental records only
        const tempLog = await _ro_getTemperatureHistory(ring, _sinceTemp).catch((e : any | null) : UTSJSONObject[] => [] as UTSJSONObject[]) // new/incremental records only
        await _ro_disconnect(ring)

        // Merge each type's newly-fetched records into the previous snapshot (see
        // _mergeRingSlots above) so an incremental fetch — which may legitimately return few
        // or zero new records — never regresses the stored/displayed history back down to
        // just this sync's slice, and so a per-type fetch failure (.catch above) can't wipe
        // out previously-synced data the way an unconditional overwrite would.
        const hrEntries : UTSJSONObject[] = (hrLog ?? [] as UTSJSONObject[]).filter((r : UTSJSONObject) : boolean => (r.getNumber('value') ?? 0) > 0)
        const newHrSlots : UTSJSONObject[] = hrEntries.map((r : UTSJSONObject) : UTSJSONObject => {
          const ts = sget(r, 'timestamp')
          const iso = ts.indexOf(' ') != -1 ? _isoUtcFromMs(cstDateStrToMillis(ts)) : ts
          return { t: iso, bpm: r.get('value') } as UTSJSONObject
        })
        const newTempRecords : UTSJSONObject[] = (tempLog ?? [] as UTSJSONObject[]).filter((r : UTSJSONObject) : boolean => {
          const ebt = r.getNumber('estimatedBodyTemp')
          return ebt != null && ebt! > 34
        })
        const newStepSlots : UTSJSONObject[] = steps != null ? (steps!.getArray<UTSJSONObject>('slots') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        const mergedHrSlots = _mergeRingSlots(_prevIsToday ? (_prevRing.getArray<UTSJSONObject>('hrSlots') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[]), newHrSlots, 't', null)
        const mergedHrvSlots = _mergeRingSlots(_prevRing.getArray<UTSJSONObject>('hrvSlots') ?? ([] as UTSJSONObject[]), hrvLog, 'timestamp', RING_SLOT_RETENTION_DAYS)
        const mergedSpo2Slots = _mergeRingSlots(_prevRing.getArray<UTSJSONObject>('spo2Slots') ?? ([] as UTSJSONObject[]), spo2Log, 'timestamp', RING_SLOT_RETENTION_DAYS)
        const mergedTempSlots = _mergeRingSlots(_prevRing.getArray<UTSJSONObject>('tempSlots') ?? ([] as UTSJSONObject[]), newTempRecords, 'date', RING_SLOT_RETENTION_DAYS)
        const mergedStepSlots = _mergeRingSlots(_prevIsToday ? (_prevRing.getArray<UTSJSONObject>('stepSlots') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[]), newStepSlots, 't', null)

        let restingHr : number | null = null
        if (mergedHrSlots.length > 0) {
          const bpms : number[] = mergedHrSlots.map((r : UTSJSONObject) : number => nget(r, 'bpm'))
          restingHr = _minOf(bpms)
        }
        const latestHrv = mergedHrvSlots.length > 0 ? mergedHrvSlots[mergedHrvSlots.length - 1] : ({ } as UTSJSONObject)
        const latestSpo2 = mergedSpo2Slots.length > 0 ? mergedSpo2Slots[mergedSpo2Slots.length - 1] : ({ } as UTSJSONObject)
        const latestTemp = mergedTempSlots.length > 0 ? mergedTempSlots[mergedTempSlots.length - 1] : ({ } as UTSJSONObject)
        const raw = {
          steps: steps != null ? steps!.get('steps') : null,
          calories: steps != null ? steps!.get('calories') : null,
          distance: steps != null ? steps!.get('distance') : null,
          stepSlots: mergedStepSlots.length > 0 ? mergedStepSlots : null,
          sleepMinutes: (sleep != null && (sleep!.getNumber('totalMinutes') ?? 0) > 0) ? sleep!.get('totalMinutes') : null,
          sleepDeep: sleep != null ? sleep!.get('deep') : null,
          sleepLight: sleep != null ? sleep!.get('light') : null,
          sleepRem: sleep != null ? sleep!.get('rem') : null,
          sleepAwake: sleep != null ? sleep!.get('awake') : null,
          sleepStart: sleep != null ? sleep!.get('sleepStart') : null,
          sleepEnd: sleep != null ? sleep!.get('sleepEnd') : null,
          sleepSlots: sleep != null ? sleep!.get('slots') : null,
          sleepOnset: sleep != null ? sleep!.get('onset') : null,
          sleepDate: sleep != null ? sleep!.get('date') : null,
          sleepHistory: sleepHistoryNorm,
          // Raw sleep blocks, kept so the next sync can merge new blocks with these before
          // re-deriving night summaries. Not sent to the server (sync.uts only reads the
          // fields above); local-only.
          sleepBlocks: mergedSleepBlocks,
          hrSlots: mergedHrSlots,
          restingHr: restingHr,
          hrv: latestHrv.get('hrv'),
          stress: latestHrv.get('stress'),
          spo2: latestSpo2.get('spo2'),
          breathRate: latestHrv.get('breath'),
          heartRateFromHrv: latestHrv.get('heartRate'),
          systolicBP: latestHrv.get('highBP'),
          diastolicBP: latestHrv.get('lowBP'),
          hrvMeasuredAt: latestHrv.get('timestamp'),
          hrvSlots: mergedHrvSlots.length > 0 ? mergedHrvSlots : null,
          spo2Slots: mergedSpo2Slots.length > 0 ? mergedSpo2Slots : null,
          tempSlots: mergedTempSlots.length > 0 ? mergedTempSlots : null,
          bodyTempC: latestTemp.get('estimatedBodyTemp'),
          syncedAt: Date.now(),
        } as UTSJSONObject
        if (IS_DEV) {
          console.log(JSON.stringify({
            level: 'DEBUG', msg: 'incremental sync', brand: brand,
            hr: { fetched: newHrSlots.length, merged: mergedHrSlots.length },
            hrv: { fetched: hrvLog.length, merged: mergedHrvSlots.length },
            spo2: { fetched: spo2Log.length, merged: mergedSpo2Slots.length },
            temp: { fetched: newTempRecords.length, merged: mergedTempSlots.length },
            steps: { fetched: newStepSlots.length, merged: mergedStepSlots.length },
            sleep: { mergedBlocks: mergedSleepBlocks != null ? mergedSleepBlocks!.length : null, nights: sleepHistoryNorm.length },
          } as UTSJSONObject))
        }
        // Awaited (Halo/V8 only) so handleSyncWearable() doesn't resolve until health_twin is
        // actually updated — onShow() relies on this to sequence the check-in-eligibility
        // heartbeat after a due sync completes.
        await this._commitRingData(raw, batteryLevel, isZh, false)
      } catch (e : any) {
        await _ro_disconnect(ring).catch((err : any | null) => {})
        if (IS_DEV) console.error(`[BLE][sync:${brand}]`, e)
        if (!_isPrivacyError(e)) uni.showToast({ title: tnum(t, 'wearableSyncFail'), icon: 'none' })
        this.wearableConnected = false
        this.wearableBusy = false
      } finally {
        this.wearableBusy = false
        this.ringMeasuring = false
      }
    },

    // Returns the server-sync promise (resolves once health_twin's UPSERT has landed) so
    // callers that need the round trip to actually finish — e.g. onShow()'s pre-heartbeat
    // wait — can await it. UI state below is applied synchronously as before, independent of
    // this promise's timing.
    _commitRingData(raw : UTSJSONObject, batteryLevel : number, isZh : boolean, isPartial : boolean) : Promise<void> {
      uni.setStorageSync('wearable_ring_data', raw)
      const snapshot = new WearableSnapshot()
      snapshot.source = 'smart_ring'
      snapshot.wearableName = this.wearableName.length > 0 ? this.wearableName : null
      snapshot.steps = raw.getNumber('steps')
      snapshot.calories = raw.getNumber('calories')
      snapshot.distance = raw.getNumber('distance')
      snapshot.stepSlots = raw.getArray<UTSJSONObject>('stepSlots') ?? ([] as UTSJSONObject[])
      snapshot.sleepMinutes = raw.getNumber('sleepMinutes')
      snapshot.sleepDeep = raw.getNumber('sleepDeep')
      snapshot.sleepLight = raw.getNumber('sleepLight')
      snapshot.sleepRem = raw.getNumber('sleepRem')
      snapshot.sleepAwake = raw.getNumber('sleepAwake')
      snapshot.sleepStart = raw.getNumber('sleepStart')
      snapshot.sleepEnd = raw.getNumber('sleepEnd')
      snapshot.sleepSlots = raw.getArray<UTSJSONObject>('sleepSlots') ?? ([] as UTSJSONObject[])
      snapshot.sleepHistory = raw.getArray<UTSJSONObject>('sleepHistory') ?? ([] as UTSJSONObject[])
      snapshot.hrSlots = raw.getArray<UTSJSONObject>('hrSlots') ?? ([] as UTSJSONObject[])
      snapshot.restingHr = raw.getNumber('restingHr')
      snapshot.hrv = raw.getNumber('hrv')
      snapshot.stress = raw.getNumber('stress')
      snapshot.spo2 = raw.getNumber('spo2')
      snapshot.breathRate = raw.getNumber('breathRate')
      snapshot.heartRateFromHrv = raw.getNumber('heartRateFromHrv')
      snapshot.systolicBP = raw.getNumber('systolicBP')
      snapshot.diastolicBP = raw.getNumber('diastolicBP')
      snapshot.hrvMeasuredAt = raw.getString('hrvMeasuredAt')
      snapshot.hrvSlots = raw.getArray<UTSJSONObject>('hrvSlots') ?? ([] as UTSJSONObject[])
      snapshot.spo2Slots = raw.getArray<UTSJSONObject>('spo2Slots') ?? ([] as UTSJSONObject[])
      snapshot.tempSlots = raw.getArray<UTSJSONObject>('tempSlots') ?? ([] as UTSJSONObject[])
      snapshot.syncedAt = nget(raw, 'syncedAt')
      // syncWearableData() never rejects (its request `fail` handler resolves with
      // {success:false, error} instead of throwing), so a bare .catch() can never fire and
      // any real failure (domain block, auth, 5xx) would be discarded silently. Inspect the
      // resolved result instead.
      const syncPromise = syncWearableData(this.userId, snapshot, state.apiToken)
        .then((res : SyncResult) => {
          if (!res.success && IS_DEV) {
            console.error(JSON.stringify({ level: 'ERROR', msg: 'wearable server sync failed', error: res.error } as UTSJSONObject))
          }
        })
        .catch((e : any | null) => { if (IS_DEV) console.error(JSON.stringify({ level: 'ERROR', msg: 'wearable server sync threw', error: `${e}` } as UTSJSONObject)) })

      // Accumulate today's realtime readings for on-demand measurements (the colmi-style
      // phase-2 path). Halo/V8 keep their hrvSlots/spo2Slots auto-monitoring buffers — skip
      // accumulation so repeated syncs don't push the same latest ring reading every time.
      if (!isPartial && raw.get('hrvSlots') == null && (raw.get('hrv') != null || raw.get('stress') != null || raw.get('spo2') != null || raw.get('systolicBP') != null)) {
        const todayStr = _shanghaiDateStr(nget(raw, 'syncedAt'))
        let stored = _storageObj('wearable_realtime_today')
        if (stored == null || sget(stored!, 'date') != todayStr) {
          stored = { date: todayStr, readings: [] as UTSJSONObject[] } as UTSJSONObject
        }
        const list = stored!.getArray<UTSJSONObject>('readings') ?? ([] as UTSJSONObject[])
        list.push({
          t: raw.get('syncedAt'), hrv: raw.get('hrv'), stress: raw.get('stress'), spo2: raw.get('spo2'),
          systolicBP: raw.get('systolicBP'), diastolicBP: raw.get('diastolicBP'), breathRate: raw.get('breathRate'),
        } as UTSJSONObject)
        stored!['readings'] = list
        uni.setStorageSync('wearable_realtime_today', stored)
      }

      const rawHrvSlots = raw.getArray<UTSJSONObject>('hrvSlots')
      const rawReadings = rawHrvSlots != null
        ? _slotsToReadings(rawHrvSlots, raw.getArray<UTSJSONObject>('spo2Slots'))
        : _getRealtimeReadings(raw.getNumber('syncedAt'))
      const realtimeReadings = _fmtRealtimeReadings(rawReadings)
      const charts = _buildReadingLineCharts(rawReadings)
      const base = _buildRingDisplayData(raw, isZh)
      const ringData = { } as UTSJSONObject
      base.toMap().forEach((v : any | null, k : string) => { ringData[k] = v })
      ringData['realtimeReadings'] = realtimeReadings
      ringData['hasRealtimeReadings'] = realtimeReadings.length > 0
      const hrvChart = jget(charts, 'hrvChart')
      const spo2Chart = jget(charts, 'spo2Chart')
      const stressChart = jget(charts, 'stressChart')
      ringData['hrvChart'] = hrvChart
      ringData['spo2Chart'] = spo2Chart
      ringData['stressChart'] = stressChart
      ringData['hasSlotCharts'] = bget(base, 'hasSlotCharts') || bget(hrvChart, 'hasData') || bget(spo2Chart, 'hasData') || bget(stressChart, 'hasData')
      const sleepMin = raw.getNumber('sleepMinutes')
      const virtualTwin = {
        avg_daily_steps: raw.get('steps'),
        avg_sleep_hours: sleepMin != null ? (sleepMin!) / 60 : null,
        avg_resting_hr: raw.get('restingHr'),
        avg_hrv_ms: raw.get('hrv'),
        avg_spo2: raw.get('spo2'),
        latest_bmi: null,
        trend_data: { } as UTSJSONObject,
      } as UTSJSONObject
      const visuals = this._buildTwinVisuals(virtualTwin, tOf(isZh ? 'zh' : 'en'), isZh)
      this.wearableConnected = true
      this.wearableBattery = batteryLevel
      this.ringData = ringData
      this.mood = computeMood(this._moodRaw(ringData))
      this.hasTwinData = aget(visuals, 'vitalGauges').length > 0
      this.twinLoading = false
      this.healthScore = visuals.getNumber('healthScore')
      this.healthScoreColor = sget(visuals, 'healthScoreColor')
      this.healthScoreGrade = sget(visuals, 'healthScoreGrade')
      this.healthDomains = aget(visuals, 'healthDomains')
      this.vitalGauges = aget(visuals, 'vitalGauges')
      this.twinBodyBar = jget(visuals, 'twinBodyBar')
      this._applyBandToHrvBars()
      return syncPromise
    },

    async toggleRingSettings() {
      if (this.ringSettingsOpen) {
        this.ringSettingsOpen = false
        this.haloIntervalsChanged = false
        this.haloRingTime = ''
        return
      }
      if (this.wearableBusy || this.ringSettingsBusy) return

      // Brands without interval settings — just open the panel
      if (!_hasIntervalSettings(this.wearableBrand)) {
        this.ringSettingsOpen = true
        return
      }

      this.ringSettingsOpen = true
      this.ringSettingsBusy = true
      const ring = createWearable(this.wearableBrand)
      try {
        await _ro_connect(ring, this.wearableId, false)
        const s1 = await _ro_getAutoMonitoring(ring, 1)
        const s2 = await _ro_getAutoMonitoring(ring, 2)
        const s3 = await _ro_getAutoMonitoring(ring, 3)
        const s4 = await _ro_getAutoMonitoring(ring, 4)
        const ringTimeMs = await _ro_getDeviceTime(ring).catch((e : any | null) : number | null => null)
        let ringTimeStr = ''
        if (ringTimeMs != null) {
          const shifted = ringTimeMs! + CST_MS
          const hh = _pad2n(Math.floor((shifted % 86400000) / 3600000))
          const mm = _pad2n(Math.floor((shifted % 3600000) / 60000))
          const ss = _pad2n(Math.floor((shifted % 60000) / 1000))
          ringTimeStr = `${hh}:${mm}:${ss}`
        }
        this.haloIntervals = { hr: nget(s1, 'intervalMinutes'), spo2: nget(s2, 'intervalMinutes'), temp: nget(s3, 'intervalMinutes'), hrv: nget(s4, 'intervalMinutes') } as UTSJSONObject
        this.haloWorkModes = { hr: nget(s1, 'workMode'), spo2: nget(s2, 'workMode'), temp: nget(s3, 'workMode'), hrv: nget(s4, 'workMode') } as UTSJSONObject
        this.haloRingTime = ringTimeStr
        this.haloIntervalsChanged = false
      } catch (e : any) {
        // fall back to locally cached values silently
      } finally {
        _ro_disconnect(ring).catch((e : any | null) => {})
        this.ringSettingsBusy = false
      }
    },

    handleIntervalChange(type : string, min : number) {
      const next = { } as UTSJSONObject
      this.haloIntervals.toMap().forEach((v : any | null, k : string) => { next[k] = v })
      next[type] = min
      this.haloIntervals = next
      this.haloIntervalsChanged = true
    },

    handleWorkModeChange(type : string) {
      const modes = this.haloWorkModes
      // 0 → 1 → 2 → 0 cycle (workMode off/auto/scheduled)
      const cur = nget(modes, type)
      const nextWm = cur == 0 ? 1 : (cur == 1 ? 2 : 0)
      const next = { } as UTSJSONObject
      modes.toMap().forEach((v : any | null, k : string) => { next[k] = v })
      next[type] = nextWm
      this.haloWorkModes = next
      this.haloIntervalsChanged = true
    },

    async saveRingIntervals() {
      if (this.ringSettingsBusy || this.wearableBusy) return
      this.ringSettingsBusy = true
      const ivals = this.haloIntervals
      const wms = this.haloWorkModes
      const mkSettings = (intervalMinutes : number, type : number, wm : number) : AutoMonitoringSettings => {
        const s = new AutoMonitoringSettings()
        s.workMode = wm; s.startHour = 0; s.startMinute = 0; s.endHour = 23; s.endMinute = 59
        s.weekdays = 127; s.intervalMinutes = intervalMinutes; s.type = type
        return s
      }
      const ring = createWearable(this.wearableBrand)
      try {
        await _ro_connect(ring, this.wearableId, false)
        // Sync ring clock if it drifts more than 1 minute from host time
        try {
          const ringTimeMs = await _ro_getDeviceTime(ring)
          if (ringTimeMs == null || Math.abs(Date.now() - ringTimeMs!) > 60000) {
            await _ro_setTime(ring, new Date())
          }
        } catch (e : any) {}
        await _ro_setAutoMonitoring(ring, mkSettings(nget(ivals, 'hr'), 1, nget(wms, 'hr')))
        await _ro_setAutoMonitoring(ring, mkSettings(nget(ivals, 'spo2'), 2, nget(wms, 'spo2')))
        await _ro_setAutoMonitoring(ring, mkSettings(nget(ivals, 'temp'), 3, nget(wms, 'temp')))
        await _ro_setAutoMonitoring(ring, mkSettings(nget(ivals, 'hrv'), 4, nget(wms, 'hrv')))
        uni.setStorageSync('halo_interval_settings', ivals)
        uni.setStorageSync('halo_work_mode_settings', wms)
        this.haloIntervalsChanged = false
      } catch (e : any) {
        console.log(JSON.stringify({ level: 'ERROR', msg: 'saveRingIntervals failed', err: `${e}` } as UTSJSONObject))
        uni.showToast({ title: tnum(this.t, 'wearableSyncFail'), icon: 'none' })
      } finally {
        _ro_disconnect(ring).catch((e : any | null) => {})
        this.ringSettingsBusy = false
      }
    },

    handleUnbindWearable() {
      this.ringSettingsOpen = false
      const t = this.t
      uni.showModal({
        title: tnum(t, 'wearableUnbind'),
        content: this.wearableName,
        confirmColor: '#ef4444',
        success: (res) => {
          if (res.confirm) {
            uni.removeStorageSync('wearable_device')
            uni.removeStorageSync('wearable_ring_data')
            uni.removeStorageSync('halo_interval_settings')
            uni.removeStorageSync('halo_work_mode_settings')
            uni.removeStorageSync('x3_interval_settings')
            uni.removeStorageSync('x3_work_mode_settings')
            this.wearableId = ''
            this.wearableName = ''
            this.wearableBrand = ''
            this.wearableConnected = false
            this.wearableBattery = 0
            this.ringData = null
            this.mood = DEFAULT_MOOD
            this.wearableServerHint = null
            this._syncWearableBindingToServer(null)
          }
        },
      })
    },
  }
}
</script>

<style>
/* Native only — the web build is styled by static/web/ (the web user-app's own CSS). */
/* #ifndef WEB */
/* Structural port of user-health.wxss (3620 lines → the rules that carry layout and the
