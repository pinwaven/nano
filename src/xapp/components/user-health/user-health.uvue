.ins-band-track { height: 8px; background-color: rgba(99, 117, 236, 0.08); border-radius: 3px; position: relative; margin: 6px 0px 2px 0px; }
.ins-band-range { position: absolute; top: 0; height: 8px; background-color: rgba(14, 165, 233, 0.28); border-radius: 3px; }
.ins-band-marker { position: absolute; top: -2px; width: 13px; height: 12px; border-radius: 6.5px; box-shadow: rgba(0, 0, 0, 0.25) 0px 0px 5px 0px; margin: 0px 0px 0px -6px; border-style: solid; border-width: 1px; border-color: rgb(15, 37, 64); }
.ins-flag { flex-direction: row; align-items: center; margin-top: 4px; }
.ins-flag-txt { color: #f59e0b; font-size: 11px; }
.ins-flag-since { color: rgba(166, 196, 229, 0.5); font-size: 10px; margin-left: 6px; }
.ins-provisional { color: rgba(166, 196, 229, 0.55); font-size: 10px; margin-top: 6px; }

.ring-summary-card { background-color: rgba(15, 37, 64, 0.35); border-style: solid; border-width: 1px; border-color: rgba(99, 117, 236, 0.14); border-radius: 10px; padding: 12px 10px 9px; margin: 10px 0px 10px 0px; }
.ring-sum-metrics { flex-direction: row; flex-wrap: wrap; margin: 0px 0px 7px 0px; }
.ring-sum-item { width: 33%; margin-bottom: 10px; padding: 0px 2px 0px 2px; align-items: center; }
.ring-sum-val-row { flex-direction: row; align-items: baseline; }
.ring-sum-val { color: #EAF2FB; font-size: 17px; font-weight: bold; }
.ring-sum-na { color: rgba(166, 196, 229, 0.4); font-size: 16px; }
.ring-sum-unit { color: rgba(166, 196, 229, 0.55); font-size: 8px; margin-left: 2px; }
.ring-sum-sub { color: rgba(166, 196, 229, 0.45); font-size: 9px; margin-top: 2px; }
.ring-sum-bar { height: 4px; background-color: rgba(166, 196, 229, 0.12); border-radius: 1px; flex-direction: row; margin: 3px 0px 0px 0px; }
.ring-sum-bar-fill { height: 4px; border-radius: 1px; }
.ring-steps-fill { background-color: #0ea5e9; border-radius: 1px; }
.ring-hr-fill { background-color: #f97316; border-radius: 1px; }
.ring-sleep-segs { border-radius: 1px; background-color: rgba(99, 117, 236, 0.08); margin: 3px 0px 0px 0px; }
.ring-sum-bar-seg { height: 4px; }
.ring-deep-seg { background-color: #6375EC; }
.ring-rem-seg { background-color: #a855f7; }
.ring-light-seg { background-color: #0ea5e9; }
.ring-awake-seg { background-color: rgba(166, 196, 229, 0.18); }
.ring-sum-stress-label { font-size: 8px; font-weight: bold; margin: 1px 0px 0px 0px; }
.ring-sum-footer { color: rgba(166, 196, 229, 0.3); font-size: 9px; margin-top: 4px; text-align: right; }

.ring-detail-card { background-color: rgba(15, 37, 64, 0.3); border-style: solid; border-width: 1px; border-color: rgba(99, 117, 236, 0.12); border-radius: 10px; padding: 12px 10px 10px 10px; margin: 10px 0px 10px 0px; }
.ring-chart-block { margin-bottom: 14px; }
.ring-chart-header { flex-direction: row; justify-content: space-between; align-items: center; }
.ring-chart-header-right { flex-direction: row; align-items: center; }
.ring-chart-label { color: rgba(166, 196, 229, 0.4); font-size: 9px; margin-bottom: 6px; font-weight: bold; letter-spacing: 1px; }
/* #ifdef MP-WEIXIN */
.ring-chart-label { text-transform: uppercase; }
/* #endif */
.ring-chart-date { color: rgba(166, 196, 229, 0.5); font-size: 10px; margin-right: 6px; }
.ring-chart-time { color: rgba(166, 196, 229, 0.5); font-size: 10px; }
.ring-chart-bars { flex-direction: row; align-items: flex-end; height: 41px; }
.ring-chart-col { flex: 1; align-items: center; justify-content: flex-end; height: 41px; }
.ring-chart-bar { width: 60%; border-radius: 2px; }
.ring-chart-bar-empty { opacity: 0.35; }
.ring-chart-hlabel { color: rgba(166, 196, 229, 0.3); font-size: 7px; margin-top: 2px; }
.ring-chart-day-col { flex: 1; align-items: center; justify-content: flex-end; height: 41px; margin-left: 2px; margin-right: 2px; }
.ring-chart-day-avg { color: rgba(166, 196, 229, 0.55); font-size: 8px; font-weight: bold; }
.ring-chart-day-label { color: rgba(166, 196, 229, 0.35); font-size: 7px; margin-top: 2px; }

.ring-sleepweek-wrap { flex-direction: row; margin-top: 4px; }
.ring-sleepweek-axis { width: 17px; position: relative; color: rgb(238, 242, 255); padding: 0px 0px 16px 0px; justify-content: space-between; }
.ring-sleepweek-axis-lbl { position: absolute; left: 0; color: rgba(166, 196, 229, 0.3); font-size: 7px; }
.ring-sleepweek-days { flex: 1; flex-direction: row; }
.ring-sleepweek-daycol { flex: 1; align-items: center; }
.ring-sleepweek-track { width: 100%; position: relative; background-color: rgba(99, 117, 236, 0.06); border-radius: 4px; }
.ring-sleepweek-gridline { position: absolute; left: 0; right: 0; height: 1px; background-color: rgba(166, 196, 229, 0.1); }
.ring-sleepweek-block { position: absolute; left: 15%; width: 70%; border-radius: 2px; }
.ring-sleepweek-block-nap { opacity: 0.75; }
.ring-sleepweek-total { color: rgba(166, 196, 229, 0.55); font-size: 7px; margin-top: 3px; font-weight: bold; }
.ring-sleepweek-daylabel { color: rgba(166, 196, 229, 0.3); font-size: 7px; }
.ring-sleep-legend { flex-direction: row; flex-wrap: wrap; margin-top: 6px; }
.ring-sleep-leg-item { flex-direction: row; align-items: center; margin-right: 10px; }
.ring-sleep-leg-dot { width: 8px; height: 8px; border-radius: 3px; margin-right: 4px; }
.ring-sleep-leg-txt { color: rgba(166, 196, 229, 0.5); font-size: 9px; }

.ring-linechart-header { flex-direction: row; justify-content: space-between; align-items: center; margin: 0px 0px 6px 0px; }
.ring-linechart-latest-row { flex-direction: row; align-items: baseline; }
.ring-linechart-latest { font-size: 17px; font-weight: bold; }
.ring-linechart-unit { color: rgba(166, 196, 229, 0.45); font-size: 9px; margin-left: 2px; }
.ring-lc-estimated-marker { color: rgb(249, 115, 22); font-size: 10px; font-weight: bold; margin: 0px 0px 0px 1px; }
.ring-lc-bars { flex-direction: row; align-items: flex-end; height: 37px; margin: 4px 1px 0px 1px; }
.ring-lc-col { flex: 1; align-items: stretch; height: 37px; justify-content: flex-end; }
.ring-lc-bar { border-radius: 1px; opacity: 0.4; }
.ring-lc-bar-estimated { opacity: 0.55; }
.ring-linechart-range { flex-direction: row; justify-content: space-between; margin: 4px 0px 0px 0px; align-items: center; }
.ring-linechart-bound { color: rgba(166, 196, 229, 0.35); font-size: 9px; }
.ring-linechart-count { color: rgba(166, 196, 229, 0.25); font-size: 9px; }
.ring-lc-smoothed-note { color: rgba(245, 158, 11, 0.7); font-size: 9px; margin: 3px 0px 0px 0px; }
.ring-sleep-timeline { flex-direction: row; height: 12px; border-radius: 6px; overflow: hidden; background-color: rgba(99, 117, 236, 0.08); }
.ring-sleep-tl-seg { height: 12px; }

.ht-body-card { background-color: rgba(15, 37, 64, 0.35); border-style: solid; border-width: 1px; border-color: rgba(99, 117, 236, 0.14); border-radius: 10px; padding: 10px; margin-top: 10px; }
.ht-body-header { flex-direction: row; justify-content: space-between; }
.ht-body-title { color: #A6C4E5; font-size: 12px; }
.ht-body-vals { color: rgba(166, 196, 229, 0.6); font-size: 10px; }
.ht-body-bar { flex-direction: row; height: 10px; border-radius: 5px; overflow: hidden; margin-top: 6px; }
.ht-body-lean { height: 10px; background-color: #10b981; }
.ht-body-fat-fill { height: 10px; background-color: #f97316; }
.ht-body-legend { flex-direction: row; margin-top: 4px; }
.ht-body-legend-item { flex-direction: row; align-items: center; margin-right: 12px; }
.ht-body-dot { width: 8px; height: 8px; border-radius: 4px; margin-right: 4px; }
.ht-lean-dot { background-color: #10b981; }
.ht-fat-dot { background-color: #f97316; }
.ht-body-lbl { color: rgba(166, 196, 229, 0.6); font-size: 10px; }

.ecg-card { margin-top: 10px; background-color: rgba(15, 37, 64, 0.5); border-radius: 12px; color: rgb(238, 242, 255); padding: 9px 10px 9px 10px; border-style: solid; border-width: 1px; border-color: rgba(99, 117, 236, 0.18); }
.ecg-card-row { flex-direction: row; align-items: center; justify-content: space-between; }
.ecg-card-main { flex: 1; }
.ecg-card-title { color: rgb(238, 242, 255); font-size: 12px; font-weight: bold; }
.ecg-card-hero { flex-direction: row; align-items: baseline; margin-top: 4px; }
.ecg-card-bpm { color: rgb(31, 183, 166); font-size: 22px; font-weight: bold; }
.ecg-card-unit { color: rgba(166, 196, 229, 0.4); font-size: 11px; margin-left: 3px; }
.ecg-card-meta { color: rgba(166, 196, 229, 0.4); font-size: 11px; margin-left: 8px; }
.ecg-card-empty { color: rgba(166, 196, 229, 0.5); font-size: 11px; margin-top: 4px; }
.ecg-card-list { margin-top: 6px; border-top-width: 1px; border-top-color: rgba(99, 117, 236, 0.12); color: rgb(238, 242, 255); border-right-width: 0px; border-bottom-width: 0px; border-left-width: 0px; padding: 4px 0px 0px 0px; border-style: solid; }
.ecg-card-list-row { flex-direction: row; justify-content: space-between; padding: 0px 0px 0px 0px; }
.ecg-card-list-when { color: rgba(166, 196, 229, 0.4); font-size: 11px; }
.ecg-card-list-val { color: rgba(166, 196, 229, 0.4); font-size: 11px; }
.ecg-card-foot { color: rgba(166, 196, 229, 0.45); font-size: 10px; margin-top: 6px; }

.trend-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.trend-card { width: 48.5%; background-color: rgb(15, 37, 64); border-radius: 14px; margin-bottom: 8px; padding: 12px 12px 10px 12px; border-style: solid; border-width: 1px; border-color: rgba(99, 117, 236, 0.18); }
.trend-label { color: rgba(166, 196, 229, 0.4); font-size: 9px; font-weight: bold; letter-spacing: 1px; margin: 0px 0px 4px 0px; }
/* #ifdef MP-WEIXIN */
.trend-label { text-transform: uppercase; }
/* #endif */
.trend-val-row { flex-direction: row; align-items: baseline; margin-top: 2px; }
.trend-val { font-size: 16px; font-weight: bold; }
.trend-unit { color: rgba(166, 196, 229, 0.4); font-size: 9px; margin-left: 2px; }
.spark-row { flex-direction: row; align-items: flex-end; height: 18px; margin: 7px 0px 0px 0px; }
.spark-bar { width: 13px; border-radius: 2px; margin-right: 2px; opacity: 0.55; }
.spark-bar-empty { opacity: 0.2; }

.ht-lab-alert { margin-left: 8px; background-color: rgba(239, 68, 68, 0.14); border-radius: 8px; padding: 2px 8px; }
.ht-lab-alert-text { color: #ef4444; font-size: 10px; }
.ht-lab-ok { margin-left: 8px; background-color: rgba(16, 185, 129, 0.1); border-radius: 7px; padding: 2px 8px; color: rgb(238, 242, 255); border-style: solid; border-width: 1px; border-color: rgba(16, 185, 129, 0.25); }
.ht-lab-ok-text { color: #10b981; font-size: 10px; font-weight: bold; }
.ht-lab-snapshot-wrap { margin-bottom: 12px; padding-bottom: 12px; border-bottom-width: 1px; border-bottom-color: rgba(99, 117, 236, 0.1); border-top-width: 0px; border-right-width: 0px; border-left-width: 0px; border-style: solid; }
.ht-lab-snapshot-header { flex-direction: row; justify-content: space-between; align-items: center; margin: 0px 0px 8px 0px; }
.ht-lab-snapshot-title { color: rgba(166, 196, 229, 0.45); font-size: 10px; font-weight: bold; letter-spacing: 1px; }
.ht-lab-date { color: rgba(166, 196, 229, 0.45); font-size: 11px; }
.ht-lab-grid { flex-direction: row; flex-wrap: wrap; }
.ht-lab-item { width: 31.8%; background-color: rgba(99, 117, 236, 0.06); border-style: solid; border-width: 1px; border-color: transparent; border-radius: 9px; margin-right: 1.5%; margin-bottom: 6px; padding: 8px 7px 7px 7px; }
.ht-lab-item-abn { }
.ht-lab-item-trend { }
.ht-lab-name { color: rgba(166, 196, 229, 0.7); font-size: 9px; font-weight: bold; letter-spacing: 1px; }
.ht-lab-val { font-size: 15px; font-weight: bold; }
.ht-lab-unit { color: rgba(166, 196, 229, 0.35); font-size: 8px; }
.ht-lab-sub { color: rgba(166, 196, 229, 0.5); font-size: 8px; margin: 1px 0px 0px 0px; }
.ht-lab-hint { color: rgba(166, 196, 229, 0.35); font-size: 9px; margin: 6px 0px 0px 0px; }

.rpt-list { }
.rpt-card { flex-direction: row; align-items: center; background-color: rgb(15, 37, 64); border-style: solid; border-width: 1px; border-color: rgba(99, 117, 236, 0.18); border-radius: 12px; margin-bottom: 8px; padding: 12px 14px 12px 14px; }
.rpt-thumb { width: 40px; height: 40px; border-radius: 8px; margin-right: 10px; }
.rpt-card-left { flex: 1; border-left-style: solid; border-left-width: 2px; border-left-color: #6375EC; padding: 0px 0px 0px 10px; }
.rpt-institution { color: rgb(232, 244, 255); font-size: 14px; font-weight: bold; margin: 0px 0px 3px 0px; }
.rpt-date { color: rgba(166, 196, 229, 0.5); font-size: 11px; margin-top: 2px; }
.rpt-type-badge { border-style: solid; border-width: 1px; border-radius: 7px; margin-right: 6px; padding: 3px 9px 3px 9px; }
.rpt-type-text { font-size: 10px; font-weight: bold; letter-spacing: 1px; }
.rpt-arrow { color: rgba(166, 196, 229, 0.3); font-size: 18px; }

.fs-block { margin-top: 12px; padding-top: 10px; border-top-style: solid; border-top-width: 1px; border-top-color: rgba(99, 117, 236, 0.08); }
.fs-summary { color: #A6C4E5; font-size: 12px; margin-bottom: 6px; }
.fs-list { }
.fs-row { background-color: rgba(15, 37, 64, 0.4); border-style: solid; border-width: 1px; border-color: transparent; border-radius: 8px; padding: 8px; margin-bottom: 6px; }
.fs-row-head { flex-direction: row; align-items: center; }
.fs-food { color: #EAF2FB; font-size: 13px; flex: 1; }
.fs-class { font-size: 11px; font-weight: bold; margin-right: 8px; }
.fs-val { color: rgba(166, 196, 229, 0.6); font-size: 11px; }
.fs-window { color: rgba(166, 196, 229, 0.55); font-size: 10px; margin-top: 2px; }
.fs-subs { color: rgba(166, 196, 229, 0.55); font-size: 10px; margin-top: 2px; }
.fs-footnote { color: rgba(166, 196, 229, 0.45); font-size: 10px; margin-top: 6px; }

.fact-list { flex-direction: row; flex-wrap: wrap; }
.fact-chip { border-style: solid; border-width: 1px; border-color: transparent; border-radius: 6px; margin-right: 8px; margin-bottom: 8px; flex-direction: row; align-items: center; background-color: rgba(166, 196, 229, 0.03); padding: 6px 10px 6px 10px; }
.fact-cat { font-size: 9px; margin-right: 6px; font-weight: bold; letter-spacing: 1px; }
.fact-text { color: rgba(166, 196, 229, 0.82); font-size: 12px; }
.fact-footnote { color: rgba(166, 196, 229, 0.35); font-size: 10px; margin: 6px 0px 0px 0px; }

.tr-count { flex: 1; text-align: right; color: rgba(99, 117, 236, 0.85); font-size: 11.5px; margin-left: 8px; }
.tr-card { flex-direction: row; align-items: center; background-color: rgb(15, 37, 64); border-radius: 10px; padding: 11px 12px 11px 12px; border-style: solid; border-width: 1px; border-color: rgba(99, 117, 236, 0.28); }
.tr-icon { width: 36px; height: 36px; margin-right: 10px; font-size: 18px; color: rgb(238, 242, 255); border-radius: 8px; background-color: rgba(99, 117, 236, 0.12); flex-direction: row; align-items: center; justify-content: center; }
.tr-icon-txt { font-size: 20px; }
.tr-body { flex: 1; }
.tr-title { color: rgb(166, 196, 229); font-size: 14px; font-weight: bold; }
.tr-origin { color: rgba(166, 196, 229, 0.55); font-size: 10px; margin-top: 2px; }
.tr-meta { color: rgba(166, 196, 229, 0.55); font-size: 11px; margin-top: 2px; }
.tr-summary { color: rgba(166, 196, 229, 0.75); font-size: 11.5px; line-height: 16.5px; margin-top: 3px; lines: 2; text-overflow: ellipsis; }
/* #ifdef MP-WEIXIN */
.tr-summary { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
/* #endif */
.tr-open { background-color: #6375EC; border-radius: 519px; font-size: 11px; color: rgb(255, 255, 255); font-weight: bold; padding: 5px 10px 5px 10px; }
.tr-open-txt { color: #FFFFFF; font-size: 11px; }

.edit-form { }
.edit-row { flex-direction: row; align-items: center; margin-bottom: 10px; }
.edit-label { width: 70px; color: #A6C4E5; font-size: 12px; }
.edit-input { flex: 1; height: 36px; background-color: rgba(166, 196, 229, 0.08); color: #EAF2FB; border-radius: 8px; padding-left: 8px; font-size: 13px; }
.edit-input-text { color: #EAF2FB; font-size: 12px; }
.gender-btns { flex-direction: row; }
.gender-btn { background-color: rgba(166, 196, 229, 0.08); border-radius: 8px; padding: 6px 14px; margin-right: 8px; }
.gender-btn-active { background-color: #6375EC; }
.edit-picker { flex: 1; flex-direction: row; justify-content: space-between; align-items: center; background-color: rgba(166, 196, 229, 0.08); border-radius: 8px; padding: 8px; }
.edit-picker-val { color: #EAF2FB; font-size: 13px; }
.edit-picker-arrow { color: rgba(166, 196, 229, 0.5); }
.edit-input-unit { flex: 1; flex-direction: row; align-items: center; }
.edit-unit-text { color: rgba(166, 196, 229, 0.55); font-size: 11px; margin-left: 6px; }
.edit-section-label { color: #A6C4E5; font-size: 12px; margin-top: 6px; margin-bottom: 6px; }
.edit-cond-list { }
.edit-cond-item { flex-direction: row; align-items: center; margin-bottom: 8px; }
.edit-cond-box { width: 18px; height: 18px; border-radius: 4px; border-style: solid; border-width: 1px; border-color: rgba(166, 196, 229, 0.4); align-items: center; justify-content: center; margin-right: 8px; }
.edit-cond-box-checked { background-color: #6375EC; border-color: #6375EC; }
.edit-cond-tick { color: #FFFFFF; font-size: 12px; }
.edit-cond-text { color: #EAF2FB; font-size: 13px; }
.edit-other-row { margin-bottom: 10px; }
.edit-actions { flex-direction: row; justify-content: flex-end; margin-top: 8px; }
.edit-cancel-btn { padding: 8px 16px; margin-right: 8px; }
.edit-cancel-text { color: #A6C4E5; font-size: 13px; }
.edit-save-btn { background-color: #6375EC; border-radius: 10px; padding: 8px 20px; }
.edit-save-text { color: #FFFFFF; font-size: 13px; }

.rpt-overlay { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(5, 14, 28, 0.72); justify-content: flex-end; z-index: 200; }
.rpt-sheet { background-color: #0F2235; border-top-left-radius: 16px; border-top-right-radius: 16px; width: 100%; padding: 10px 14px; }
