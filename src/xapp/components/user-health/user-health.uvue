.avatar-side-pill { background-color: rgba(99, 117, 236, 0.1); border-radius: 20px; opacity: 0; padding: 5px 0px 5px 0px; margin: 0px 12px 0px 12px; border-style: solid; border-width: 1px; border-color: rgba(99, 117, 236, 0.3); flex-direction: row; align-items: center; justify-content: center; }
