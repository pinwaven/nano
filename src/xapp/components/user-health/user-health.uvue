<template>
  <view class="uh-root" :class="theme == 'light' ? 'uh-root-light' : ''"
        v-on:touchstart="onUhTouchStart" v-on:touchmove="onUhTouchMove"
        v-on:touchend="onUhTouchEnd" v-on:touchcancel="onUhTouchEnd">

    <!-- Health-tab subtab strip. Only rendered for a self view holding an active Viva AG
         add-on (kept verbatim from the miniapp; see _recomputeShowAgTab). -->
    <view v-if="showAgTab" class="uh-tab-bar">
      <view class="uh-tab" :class="healthSubTab == 'twin' ? 'uh-tab-active' : ''" v-on:click="switchHealthSubTab('twin')">
        <text class="uh-tab-text">{{ tt('agTabTwin') }}</text>
      </view>
      <view class="uh-tab" :class="healthSubTab == 'ag' ? 'uh-tab-active' : ''" v-on:click="switchHealthSubTab('ag')">
        <text class="uh-tab-text">{{ tt('agTabAg') }}</text>
      </view>
    </view>

    <scroll-view direction="vertical" class="health-scroll" v-if="!showAgTab || healthSubTab == 'twin'">

      <!-- Guest lock -->
      <view v-if="isGuest" class="guest-lock-card" v-on:click="onGuestTap">
        <text class="guest-lock-icon">🔬</text>
        <text class="guest-lock-title">{{ tt('guestHealthCta') }}</text>
        <view class="guest-lock-btn"><text class="guest-lock-btn-text">{{ tt('guestJoinBtn') }}</text></view>
      </view>

      <view v-else-if="bioLoading" class="center-wrap">
        <view class="pulse-dot"></view><view class="pulse-dot"></view><view class="pulse-dot"></view>
      </view>

      <view v-else class="uh-body">

        <!-- Hero -->
        <view class="health-hero">
          <view class="avatar-area">
            <view v-if="mode == 'self' && !editing" class="avatar-side-pill" :class="avatarPillsVisible ? 'avatar-pill-show' : ''"
                  v-on:click.stop="onOpenAvatarPicker">
              <text class="avatar-pill-text">{{ tt('changeAvatar') }}</text>
            </view>
            <view class="health-avatar-container" v-on:click="onAvatarTap">
              <view class="health-avatar-wrap">
                <image v-if="avatarDisplayUrl.length > 0 || sget(userObj(), 'avatar_url').length > 0"
                       class="health-avatar-img"
                       :src="avatarDisplayUrl.length > 0 ? avatarDisplayUrl : sget(userObj(), 'avatar_url')" mode="aspectFill" />
                <view v-else class="health-avatar-placeholder">
                  <text class="health-avatar-letter">{{ avatarLetter }}</text>
                </view>
              </view>
              <view v-if="avatarUpdating" class="health-avatar-ring"></view>
            </view>
            <view v-if="mode == 'self' && !editing" class="avatar-side-pill" :class="avatarPillsVisible ? 'avatar-pill-show' : ''"
                  v-on:click.stop="onEditProfilePill">
              <text class="avatar-pill-text">✎ {{ tt('editProfile') }}</text>
            </view>
          </view>
        </view>

        <!-- avatar-picker: the xapp port is gallery-only (visible + select/close); the
             miniapp also passes selected-id/lang/theme/allow-upload/user-id/custom-moods and
             binds customapplied. -->
        <!-- TODO(port): custom-avatar upload flow (§20) lives in the miniapp avatar-picker;
             the xapp component renders the gallery only. onCustomAvatarApplied is kept wired
             for when it lands. -->
        <avatar-picker :visible="avatarPickerVisible" v-on:select="onAvatarSelect" v-on:close="onAvatarPickerClose" />

        <!-- Edit form -->
        <view v-if="(mode == 'self' || mode == 'coach') && editing" class="health-section">
          <view class="edit-form">
            <view class="edit-row">
              <text class="edit-label">{{ tt('name') }}</text>
              <input class="edit-input" v-model="editNickname" placeholder="—" />
            </view>
            <view class="edit-row">
              <text class="edit-label">{{ tt('gender') }}</text>
              <view class="gender-btns">
                <view class="gender-btn" :class="editGenderSel == 'male' ? 'gender-btn-active' : ''" v-on:click="onGenderSelect('male')">
                  <text class="edit-input-text">{{ ttk('genderMap', 'male') }}</text>
                </view>
                <view class="gender-btn" :class="editGenderSel == 'female' ? 'gender-btn-active' : ''" v-on:click="onGenderSelect('female')">
                  <text class="edit-input-text">{{ ttk('genderMap', 'female') }}</text>
                </view>
              </view>
            </view>
            <view class="edit-row">
              <text class="edit-label">{{ tt('born') }}</text>
              <picker mode="date" v-on:change="onBirthDateChange">
                <view class="edit-picker">
                  <text class="edit-picker-val">{{ editBirthDate.length > 0 ? editBirthDate : '—' }}</text>
                  <text class="edit-picker-arrow">›</text>
                </view>
              </picker>
            </view>
            <view class="edit-row">
              <text class="edit-label">{{ tt('height') }}</text>
              <view class="edit-input-unit">
                <input class="edit-input" type="digit" v-model="editHeightStr" placeholder="—" />
                <text class="edit-unit-text">cm</text>
              </view>
            </view>
            <view class="edit-row">
              <text class="edit-label">{{ tt('weight') }}</text>
              <view class="edit-input-unit">
                <input class="edit-input" type="digit" v-model="editWeightStr" placeholder="—" />
                <text class="edit-unit-text">kg</text>
              </view>
            </view>
            <text class="edit-section-label">{{ tt('healthConditions') }}</text>
            <view class="edit-cond-list">
              <view v-for="(item, i) in editConditionOptions" :key="i" class="edit-cond-item"
                    v-on:click="onConditionToggle(sget(item, 'key'))">
                <view class="edit-cond-box" :class="bget(item, 'checked') ? 'edit-cond-box-checked' : ''">
                  <text v-if="bget(item, 'checked')" class="edit-cond-tick">✓</text>
                </view>
                <text class="edit-cond-text">{{ sget(item, 'label') }}</text>
              </view>
            </view>
            <view v-if="editOtherSelected" class="edit-other-row">
              <input class="edit-input" v-model="editCondOtherStr" :placeholder="tt('otherPlaceholder')" />
            </view>
            <view class="edit-actions">
              <view class="edit-cancel-btn" v-on:click="cancelEdit"><text class="edit-cancel-text">{{ tt('cancel') }}</text></view>
              <view class="edit-save-btn" v-on:click="saveEdit">
                <text class="edit-save-text">{{ editSaving ? '…' : tt('save') }}</text>
              </view>
            </view>
          </view>
        </view>

        <!-- Digital Twin umbrella — one chip per layer (§34) -->
        <view class="twin-umbrella">
          <view class="twin-umbrella-row">
            <text class="twin-umbrella-title">{{ tt('digitalTwin') }}</text>
            <text class="twin-umbrella-count">{{ tt('twinComplete') }} {{ twinLayersDone }}/4</text>
          </view>
          <view class="twin-layer-strip">
            <view v-for="(item, i) in twinLayers" :key="i" class="twin-layer" :class="bget(item, 'hasData') ? 'twin-layer-active' : ''">
              <view class="twin-layer-dot"></view>
              <text class="twin-layer-label">{{ sget(item, 'label') }}</text>
              <text class="twin-layer-date">{{ bget(item, 'hasData') ? (sget(item, 'lastDate').length > 0 ? sget(item, 'lastDate') : '✓') : sget(item, 'emptyLabel') }}</text>
            </view>
          </view>
        </view>

        <!-- Twin summary card — Precision Testing figure (Kino-gated) -->
        <view v-if="subAgeList.length > 0" class="dt-hero-card" v-on:click="closeBioAgeTrend">
          <view class="dt-body-row">
            <!-- Left: enlarged body figure; zones colored per sub-age (subAgeZ) -->
            <view class="dt-fig-col">
              <view class="dt-body-fig">
                <view class="dt-fig-head" :class="szB('ResilienceAge', 'pulse') ? 'dt-fig-pulse' : ''"
                      :style="'background:' + szS('ResilienceAge', 'fill') + ';border:1px solid ' + tcA(szS('ResilienceAge', 'color'), 0.53) + ';'"
                      v-on:click.stop="onZoneTap('ResilienceAge')"></view>
                <view class="dt-fig-neck" :style="'background:' + szS('ResilienceAge', 'fill') + ';'"></view>
                <view class="dt-fig-mid-row">
                  <view class="dt-fig-arm" :class="szB('MicroVascularAge', 'pulse') ? 'dt-fig-pulse' : ''"
                        :style="'background:' + szS('MicroVascularAge', 'fill') + ';'"
                        v-on:click.stop="onZoneTap('MicroVascularAge')"></view>
                  <view class="dt-fig-chest" :class="szB('CellularAge', 'pulse') ? 'dt-fig-pulse' : ''"
                        :style="'background:' + szS('CellularAge', 'fill') + ';border:1px solid ' + tcA(szS('CellularAge', 'color'), 0.53) + ';'"
                        v-on:click.stop="onZoneTap('CellularAge')">
                    <view class="dt-fig-heart" :style="'background:' + szS('CellularAge', 'color') + ';'"></view>
                  </view>
                  <view class="dt-fig-arm" :class="szB('MicroVascularAge', 'pulse') ? 'dt-fig-pulse' : ''"
                        :style="'background:' + szS('MicroVascularAge', 'fill') + ';'"
                        v-on:click.stop="onZoneTap('MicroVascularAge')"></view>
                </view>
                <view class="dt-fig-abdomen" :class="szB('MetabolicAge', 'pulse') ? 'dt-fig-pulse' : ''"
                      :style="'background:' + szS('MetabolicAge', 'fill') + ';border:1px solid ' + tcA(szS('MetabolicAge', 'color'), 0.53) + ';'"
                      v-on:click.stop="onZoneTap('MetabolicAge')"></view>
                <view class="dt-fig-hips" :style="'background:' + szS('MetabolicAge', 'fill') + ';'"></view>
                <view class="dt-fig-leg-row">
                  <view class="dt-fig-leg" :class="szB('MicroVascularAge', 'pulse') ? 'dt-fig-pulse' : ''"
                        :style="'background:' + szS('MicroVascularAge', 'fill') + ';'"
                        v-on:click.stop="onZoneTap('MicroVascularAge')"></view>
                  <view class="dt-fig-leg" :class="szB('MicroVascularAge', 'pulse') ? 'dt-fig-pulse' : ''"
                        :style="'background:' + szS('MicroVascularAge', 'fill') + ';'"
                        v-on:click.stop="onZoneTap('MicroVascularAge')"></view>
                </view>
              </view>
            </view>
            <!-- Right: BioAge + sub-ages -->
            <view class="dt-sa-col">
              <view v-if="bAge.length > 0 || cAge != null">
                <!-- Collapsed: side-by-side chips, tap BioAge to expand -->
                <view v-if="!bioAgeTrendOpen" class="dt-age-chips">
                  <view class="bio-chip bio-chip-dim">
                    <text class="bio-num bio-num-chrono">{{ cAge != null ? cAge : '—' }}</text>
                    <text class="bio-unit">{{ tt('chronoAge') }}</text>
                  </view>
                  <view class="bio-chip bio-chip-primary" v-on:click.stop="toggleBioAgeTrend">
                    <text class="bio-num bio-num-primary" :style="'color:' + tc(bAgeColor)">{{ bAge.length > 0 ? bAge : '—' }}</text>
                    <text class="bio-unit">{{ tt('bioAge') }}</text>
                  </view>
                </view>
                <!-- Expanded: view-rendered BioAge chart (canvas math preserved in _buildBioAgeLayout;
                     see TODO(port) in the script header). -->
                <view v-if="bioAgeTrendOpen" class="dt-bioage-open" v-on:click.stop="toggleBioAgeTrend"
                      v-on:touchstart="onChartTouch('dt-bioage-chart', $event)"
                      v-on:touchmove="onChartTouch('dt-bioage-chart', $event)"
                      v-on:touchend="onChartTouchEnd('dt-bioage-chart')">
                  <view class="chart-box" :style="'width:' + bioAgeChartW + 'px;height:200px;'">
                    <view v-for="(g, i) in abioArr('grid')" :key="'g' + i" class="chart-grid-line"
                          :style="'top:' + an(g, 'y') + 'px;left:' + abioN('pL') + 'px;width:' + abioN('plotW') + 'px;'"></view>
                    <text class="chart-y-label" :style="'top:' + (abioN('pT') + 2) + 'px;'">{{ abioS('maxLabel') }}</text>
                    <text class="chart-y-label chart-y-label-low" :style="'top:' + (abioN('pT') + abioN('plotH') - 8) + 'px;'">{{ abioS('minLabel') }}</text>
                    <view v-for="(p, i) in abioArr('chronoPts')" :key="'c' + i" class="chart-dot chart-dot-chrono"
                          :style="'left:' + (an(p, 'x') - 1) + 'px;top:' + (an(p, 'y') - 1) + 'px;'"></view>
                    <view v-for="(p, i) in abioArr('pts')" :key="'p' + i" class="chart-dot"
                          :style="'left:' + (an(p, 'x') - 3) + 'px;top:' + (an(p, 'y') - 3) + 'px;background:' + abioS('accent') + ';'"></view>
                    <view v-for="(l, i) in abioArr('xLabels')" :key="'l' + i" class="chart-x-label"
                          :style="'left:' + (an(l, 'x') - 16) + 'px;top:' + (abioN('H') - abioN('pB') + 6) + 'px;'">
                      <text class="chart-x-label-text">{{ al(l, 'text') }}</text>
                    </view>
                    <view v-if="bioAgeCross >= 0" class="chart-cross-line"
                          :style="'left:' + an(abioPt('bioAgeCross'), 'x') + 'px;top:' + abioN('pT') + 'px;height:' + abioN('plotH') + 'px;'"></view>
                    <view v-if="bioAgeCross >= 0" class="chart-cross-box" :style="bioAgeCrossBoxStyle()">
                      <text v-for="(ln, i) in abioArr('crossLines')" :key="'cl' + i" class="chart-cross-line-txt"
                            :style="'color:' + aln(ln, 'color') + ';'">{{ al(ln, 'text') }}</text>
                    </view>
                  </view>
                </view>
              </view>
              <view v-if="!bioAgeTrendOpen">
                <view v-for="(item, i) in subAgeList" :key="i" class="dt-sa-row"
                      :class="flashSubAge == sget(item, 'key') ? 'dt-sa-row-flash' : ''"
                      v-on:click.stop="onSubAgeRowTap(sget(item, 'key'))">
                  <view class="dt-sa-accent" :class="szB(sget(item, 'key'), 'pulse') ? 'dt-fig-pulse' : ''"
                        :style="'background:' + sget(item, 'color') + ';'"></view>
                  <view class="dt-sa-info">
                    <view class="dt-sa-top">
                      <text class="dt-sa-label">{{ sget(item, 'label') }}</text>
                      <text class="dt-sa-val" :style="'color:' + tc(sget(item, 'color'))">{{ sget(item, 'value') }}</text>
                    </view>
                    <view class="dt-sa-bar">
                      <view class="dt-sa-bar-fill" :style="'width:' + an(item, 'score') + '%;background:' + sget(item, 'color') + ';'"></view>
                    </view>
                  </view>
                  <text v-if="subAgeHasTrend(sget(item, 'key'))" class="dt-sa-trend-hint">›</text>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- Cross-layer strips — deliberately ungated (§34: a ring-only user still has tags,
             weight/BMI/steps/HRV and photo-captured BP/glucose worth showing) -->
        <view class="dt-hero-card dt-hero-card-strips">
          <view class="dt-tags-strip">
            <view v-for="(item, i) in healthTags" :key="i" class="dt-htag"
                  :style="'border: 1px solid ' + tcA(sget(item, 'color'), 0.33) + ';'">
              <view class="dt-htag-dot" :style="'background:' + sget(item, 'color') + ';'"></view>
              <text class="dt-htag-label" :style="'color:' + tc(sget(item, 'color'))">{{ sget(item, 'label') }}</text>
            </view>
            <view v-if="healthTags.length == 0" class="dt-htag dt-htag-empty">
              <text class="dt-htag-label">{{ tt('noHealthSignals') }}</text>
            </view>
          </view>

          <!-- Metric strip: weight / BMI / steps / HRV / stress -->
          <view class="dt-metrics-strip">
            <view class="dt-metric" :class="weightHistory.length > 1 ? 'dt-metric-tappable' : ''" v-on:click="onWeightTileTap()">
              <view class="dt-metric-val-row">
                <text class="dt-metric-val">{{ rawWeight != null ? rawWeight : '—' }}</text>
                <text v-if="rawWeight != null" class="dt-metric-unit">kg</text>
              </view>
              <text class="dt-metric-label">{{ tt('weight') }}</text>
              <text v-if="weightHistory.length > 1" class="dt-metric-trend-hint">›</text>
            </view>
            <view class="dt-metric-divider"></view>
            <view class="dt-metric" :class="bmiHistory.length > 1 ? 'dt-metric-tappable' : ''" v-on:click="onBmiTileTap()">
              <text class="dt-metric-val">{{ rawBmi.length > 0 ? rawBmi : '—' }}</text>
              <text class="dt-metric-label">BMI</text>
              <text v-if="bmiHistory.length > 1" class="dt-metric-trend-hint">›</text>
            </view>
            <view class="dt-metric-divider"></view>
            <view class="dt-metric" :class="stepsHistory.length > 1 ? 'dt-metric-tappable' : ''" v-on:click="onStepsTileTap()">
              <text class="dt-metric-val">{{ ringData != null && bget(ringData, 'hasSteps') ? sget(ringData, 'stepsStr') : '—' }}</text>
              <text class="dt-metric-label">{{ tt('ringSteps') }}</text>
              <text v-if="stepsHistory.length > 1" class="dt-metric-trend-hint">›</text>
            </view>
            <view class="dt-metric-divider"></view>
            <view class="dt-metric" :class="hrvHistory.length > 1 ? 'dt-metric-tappable' : ''" v-on:click="onHrvTileTap()">
              <view class="dt-metric-val-row">
                <text class="dt-metric-val" :style="ringData != null && bget(ringData, 'hasHrv') ? 'color:' + sget(ringData, 'hrvColor') : ''">{{ ringData != null && bget(ringData, 'hasHrv') ? snum(ringData, 'hrv') : '—' }}</text>
                <text v-if="ringData != null && bget(ringData, 'hasHrv')" class="dt-metric-unit">ms</text>
              </view>
              <text class="dt-metric-label">{{ tt('ringHrv') }}</text>
              <text v-if="hrvHistory.length > 1" class="dt-metric-trend-hint">›</text>
            </view>
            <view class="dt-metric-divider"></view>
            <view class="dt-metric" :class="stressHistory.length > 1 ? 'dt-metric-tappable' : ''" v-on:click="onStressTileTap()">
              <text class="dt-metric-val" :style="ringData != null && bget(ringData, 'hasStress') ? 'color:' + sget(ringData, 'stressColor') : ''">{{ ringData != null && bget(ringData, 'hasStress') ? snum(ringData, 'stress') : '—' }}</text>
              <text class="dt-metric-label">{{ tt('ringStress') }}</text>
              <text v-if="stressHistory.length > 1" class="dt-metric-trend-hint">›</text>
            </view>
          </view>

          <!-- BP / Glucose row — only shown when photo data is available -->
          <view v-if="latestBp != null || latestGlucose != null" class="dt-metrics-strip dt-metrics-strip-secondary">
            <view v-if="latestBp != null" class="dt-metric" :class="bpHistory.length > 1 ? 'dt-metric-tappable' : ''" v-on:click="onBpTileTap()">
              <view class="dt-metric-val-row">
                <text class="dt-metric-val">{{ an(latestBp, 'systolic') }}/{{ an(latestBp, 'diastolic') }}</text>
                <text class="dt-metric-unit">mmHg</text>
              </view>
              <text class="dt-metric-label">{{ tt('metricBp') }}</text>
              <text v-if="bpHistory.length > 1" class="dt-metric-trend-hint">›</text>
            </view>
            <view v-if="latestBp != null && latestGlucose != null" class="dt-metric-divider"></view>
            <view v-if="latestGlucose != null" class="dt-metric" :class="glucoseHistory.length > 1 ? 'dt-metric-tappable' : ''" v-on:click="onGlucoseTileTap()">
              <view class="dt-metric-val-row">
                <text class="dt-metric-val">{{ snum(latestGlucose, 'glucose') }}</text>
                <text class="dt-metric-unit">mmol/L</text>
              </view>
              <text class="dt-metric-label">{{ tt('metricGlucose') }}</text>
              <text v-if="glucoseHistory.length > 1" class="dt-metric-trend-hint">›</text>
            </view>
          </view>
        </view>

        <!-- Twin layer: Daily Monitoring -->
        <view class="health-section">
          <text class="section-title">{{ tt('layerDaily') }}</text>

          <!-- Wearable Device (always visible — ring is the data source) -->
          <view class="wd-inner">
            <view v-if="wearableId.length == 0" class="wd-empty-card" v-on:click="handleBindWearable">
              <text class="wd-ring-icon">◉</text>
              <view class="wd-empty-text-wrap">
                <text class="wd-bind-label">{{ tt('bindSmartRing') }}</text>
                <text v-if="wearableServerHint != null" class="wd-server-hint">{{ tt('wearableAlreadyBound') }} {{ sget(wearableServerHint, 'name').length > 0 ? sget(wearableServerHint, 'name') : sget(wearableServerHint, 'brand') }}</text>
              </view>
              <text class="wd-chevron">›</text>
            </view>
            <view v-else class="wd-card">
              <view class="wd-card-row">
                <view class="wd-info">
                  <view class="wd-name-row">
                    <view class="wd-dot" :class="wearableConnected ? 'wd-dot-on' : ''"></view>
                    <text class="wd-device-name">{{ wearableName }}</text>
                    <text v-if="wearableBattery > 0" class="wd-battery-inline">{{ wearableBattery }}%</text>
                  </view>
                  <text class="wd-status-text">{{ wearableConnected ? tt('wearableConnected') : tt('wearableDisconnected') }}</text>
                </view>
                <view class="wd-card-actions">
                  <view v-if="wearableBusy" class="wd-sync-spinner"></view>
                  <view v-else class="wd-sync-btn" v-on:click="handleSyncWearable">
                    <text class="wd-sync-btn-text">{{ tt('wearableSyncNow') }}</text>
                  </view>
                  <view class="wd-gear-btn" :class="ringSettingsOpen ? 'wd-gear-btn-active' : ''" v-on:click.stop="toggleRingSettings">
                    <text class="wd-gear-glyph">⚙</text>
                  </view>
                </view>
              </view>
              <view v-if="ringSettingsOpen" class="wd-settings-panel">
                <view v-if="wearableBrand == 'halo' || wearableBrand == 'v8'" class="wd-interval-section">
                  <view v-if="ringSettingsBusy" class="wd-settings-loading-row">
                    <text class="wd-settings-loading-txt">{{ tt('haloIntervalLoading') }}</text>
                  </view>
                  <view v-else>
                    <view class="wd-ring-time-row">
                      <text class="wd-ring-time-label">{{ tt('haloRingTimeLabel') }}</text>
                      <text class="wd-ring-time-val">{{ haloRingTime.length > 0 ? haloRingTime : '—' }}</text>
                    </view>
                    <text class="wd-interval-title">{{ tt('haloIntervalTitle') }}</text>
                    <view class="wd-interval-row">
                      <view class="wd-interval-label-col">
                        <text class="wd-interval-label">{{ tt('metricHr') }}</text>
                        <text class="wd-wm-badge" :class="nget(haloWorkModes, 'hr') == 0 ? 'wd-wm-off' : 'wd-wm-on'" v-on:click="handleWorkModeChange('hr')">{{ wmLabel('hr') }}</text>
                      </view>
                      <view class="wd-interval-opts">
                        <text v-for="(m, i) in hopt('hr')" :key="i" class="wd-int-btn"
                              :class="nget(haloIntervals, 'hr') == m ? 'wd-int-btn-on' : ''"
                              v-on:click="handleIntervalChange('hr', m)">{{ m }}{{ tt('haloIntervalUnit') }}</text>
                      </view>
                    </view>
                    <view class="wd-interval-row">
                      <view class="wd-interval-label-col">
                        <text class="wd-interval-label">{{ tt('metricSpo2') }}</text>
                        <text class="wd-wm-badge" :class="nget(haloWorkModes, 'spo2') == 0 ? 'wd-wm-off' : 'wd-wm-on'" v-on:click="handleWorkModeChange('spo2')">{{ wmLabel('spo2') }}</text>
                      </view>
                      <view class="wd-interval-opts">
                        <text v-for="(m, i) in hopt('spo2')" :key="i" class="wd-int-btn"
                              :class="nget(haloIntervals, 'spo2') == m ? 'wd-int-btn-on' : ''"
                              v-on:click="handleIntervalChange('spo2', m)">{{ m }}{{ tt('haloIntervalUnit') }}</text>
                      </view>
                    </view>
                    <view class="wd-interval-row">
                      <view class="wd-interval-label-col">
                        <text class="wd-interval-label">{{ tt('metricTemp') }}</text>
                        <text class="wd-wm-badge" :class="nget(haloWorkModes, 'temp') == 0 ? 'wd-wm-off' : 'wd-wm-on'" v-on:click="handleWorkModeChange('temp')">{{ wmLabel('temp') }}</text>
                      </view>
                      <view class="wd-interval-opts">
                        <text v-for="(m, i) in hopt('temp')" :key="i" class="wd-int-btn"
                              :class="nget(haloIntervals, 'temp') == m ? 'wd-int-btn-on' : ''"
                              v-on:click="handleIntervalChange('temp', m)">{{ m }}{{ tt('haloIntervalUnit') }}</text>
                      </view>
                    </view>
                    <view class="wd-interval-row">
                      <view class="wd-interval-label-col">
                        <text class="wd-interval-label">{{ tt('metricHrv') }}</text>
                        <text class="wd-wm-badge" :class="nget(haloWorkModes, 'hrv') == 0 ? 'wd-wm-off' : 'wd-wm-on'" v-on:click="handleWorkModeChange('hrv')">{{ wmLabel('hrv') }}</text>
                      </view>
                      <view class="wd-interval-opts">
                        <text v-for="(m, i) in hopt('hrv')" :key="i" class="wd-int-btn"
                              :class="nget(haloIntervals, 'hrv') == m ? 'wd-int-btn-on' : ''"
                              v-on:click="handleIntervalChange('hrv', m)">{{ m }}{{ tt('haloIntervalUnit') }}</text>
                      </view>
                    </view>
                  </view>
                </view>
                <view class="wd-settings-footer">
                  <view v-if="haloIntervalsChanged" class="wd-save-btn" :class="ringSettingsBusy ? 'wd-btn-disabled' : ''" v-on:click="saveRingIntervals">
                    <text class="wd-save-txt">{{ tt('haloSaveIntervals') }}</text>
                  </view>
                  <view class="wd-unbind-btn" v-on:click="handleUnbindWearable">
                    <text class="wd-unbind-txt">{{ tt('wearableUnbind') }}</text>
                  </view>
                </view>
              </view>
              <view v-if="ringMeasuring" class="wd-measuring-row">
                <view class="wd-measuring-dot"></view>
                <text class="wd-measuring-txt">{{ tt('wearableMeasuringBg') }}</text>
              </view>
            </view>
          </view>

          <!-- On-demand recordings: V8 has ECG + PPG; Halo has PPG only (§18, §45). The
               recorder overlay is <strip-record> in the miniapp — TODO(port): component not
               yet ported; the open/close/save/delete wiring below is kept ready. -->
          <view v-if="mode == 'self' && (ecgSupported || ppgSupported)" class="wd-measure-actions">
            <view v-if="ecgSupported" class="wd-measure-btn" v-on:click.stop="openEcgRecord('ecg')">
              <text class="wd-measure-btn-text">{{ tt('ecgRecord') }}</text>
            </view>
            <view v-if="ppgSupported" class="wd-measure-btn" v-on:click.stop="openEcgRecord('ppg')">
              <text class="wd-measure-btn-text">{{ tt('ppgRecord') }}</text>
            </view>
          </view>

          <!-- Wearable insights (GET /api/wearable-insights → _buildInsightsView) -->
          <view v-if="insightsView != null" class="ins-card">
            <view class="ins-head">
              <text class="ins-title">{{ tt('insightTitle') }}</text>
              <text class="ins-sub">{{ tt('insightNotDiagnosis') }}</text>
            </view>

            <view v-if="iv('score') >= 0" class="ins-readiness">
              <view class="ins-score-wrap" :style="'border-color:' + sget(insightsView, 'levelColor') + ';'">
                <text class="ins-score" :style="'color:' + tc(sget(insightsView, 'levelColor'))">{{ iv('score') }}</text>
                <text class="ins-score-of">/100</text>
              </view>
              <view class="ins-readiness-body">
                <view class="ins-readiness-row">
                  <text class="ins-readiness-label">{{ tt('insightReadiness') }}</text>
                  <text class="ins-level" :style="'color:' + tc(sget(insightsView, 'levelColor'))">{{ sget(insightsView, 'levelLabel') }}</text>
                  <text class="ins-date">{{ bget(insightsView, 'isToday') ? tt('insightToday') : tt('insightLatest') }} {{ sget(insightsView, 'refDate') }}</text>
                </view>
                <view class="ins-chips">
                  <text v-for="(d, i) in aget(insightsView, 'drivers')" :key="i" class="ins-chip">{{ sget(d, 'label') }}</text>
                </view>
              </view>
            </view>

            <view v-if="jget(insightsView, 'band') != null" class="ins-block">
              <view class="ins-row">
                <text class="ins-row-label">{{ tt('insightBand') }}</text>
                <text class="ins-row-val">{{ an(bandObj(), 'low') }}–{{ an(bandObj(), 'high') }} ms</text>
              </view>
              <view class="ins-band-track">
                <view class="ins-band-range" :style="'left:' + an(bandObj(), 'rangeLeftPct') + '%;width:' + an(bandObj(), 'rangeWidthPct') + '%;'"></view>
                <view class="ins-band-marker" :style="'left:' + an(bandObj(), 'markerPct') + '%;background:' + sget(bandObj(), 'color') + ';'"></view>
              </view>
              <view class="ins-row ins-row-dim">
                <text class="ins-row-label">{{ (bget(insightsView, 'isToday') ? tt('insightToday') : tt('insightLatest')) + ' ' + an(bandObj(), 'hrv') + ' ms' }}</text>
                <text class="ins-row-val" :style="'color:' + tc(sget(bandObj(), 'color'))">{{ sget(bandObj(), 'vsBaseline') + ' ' + tt('insightVsBaseline') }}</text>
              </view>
            </view>

            <view v-if="jget(insightsView, 'sleep') != null" class="ins-block">
              <view class="ins-row">
                <text class="ins-row-label">{{ tt('insightSleep') }} · {{ tt('insightLastNight') }} {{ al(slObj(), 'date') }}</text>
                <text class="ins-row-val">{{ an(slObj(), 'hours') }}h <text class="ins-row-delta">{{ sget(slObj(), 'vsWeek') + ' ' + tt('insightVsWeek') }}</text></text>
              </view>
              <view class="ins-chips ins-chips-tight">
                <text v-if="hasKey(slObj(), 'restorative')" class="ins-chip ins-chip-dim">{{ tt('insightRestorative') }} {{ an(slObj(), 'restorative') }}%</text>
                <text v-if="hasKey(slObj(), 'avg7')" class="ins-chip ins-chip-dim">{{ tt('insightAvg7') }} {{ an(slObj(), 'avg7') }}h</text>
                <text v-if="hasKey(slObj(), 'debt')" class="ins-chip" :class="an(slObj(), 'debt') >= 3 ? 'ins-chip-warn' : 'ins-chip-dim'">{{ tt('insightDebt') }} {{ an(slObj(), 'debt') }}h</text>
                <text v-if="sget(slObj(), 'regularLabel').length > 0" class="ins-chip" :class="bget(slObj(), 'regular') ? 'ins-chip-dim' : 'ins-chip-warn'">{{ sget(slObj(), 'regularLabel') }}</text>
              </view>
            </view>

            <view v-if="jget(insightsView, 'stress') != null" class="ins-block">
              <view class="ins-row">
                <text class="ins-row-label">{{ tt('insightStress') }}</text>
                <text class="ins-row-val" :style="'color:' + tc(sget(stObj(), 'balanceColor'))">{{ sget(stObj(), 'balanceLabel') }}</text>
              </view>
              <view class="ins-chips ins-chips-tight">
                <text v-if="hasKey(stObj(), 'loadToday')" class="ins-chip ins-chip-dim">{{ (bget(insightsView, 'isToday') ? tt('insightLoadToday') : tt('insightLoadLatest')) + ' ' + an(stObj(), 'loadToday') + '%' }}</text>
                <text v-if="hasKey(stObj(), 'load7d')" class="ins-chip ins-chip-dim">{{ tt('insightLoad7d') }} {{ an(stObj(), 'load7d') }}%</text>
                <text v-if="hasKey(stObj(), 'nightDay')" class="ins-chip ins-chip-dim">{{ tt('insightNightDay') }} {{ an(stObj(), 'nightDay') }}</text>
              </view>
            </view>

            <view v-for="(f, i) in aget(insightsView, 'flags')" :key="i" class="ins-flag">
              <text class="ins-flag-txt">{{ sget(f, 'label') }}</text>
              <text class="ins-flag-since">{{ tt('insightSince') }} {{ sget(f, 'since') }}</text>
            </view>
            <text v-if="sget(insightsView, 'provisional').length > 0" class="ins-provisional">{{ sget(insightsView, 'provisional') }}</text>
          </view>

          <!-- Ring sync summary (shown after first sync) -->
          <view v-if="wearableId.length > 0 && ringData != null" class="ring-summary-card">
            <view class="ring-sum-metrics">
              <view class="ring-sum-item">
                <view v-if="bget(ringData, 'hasSteps')" class="ring-sum-val-row">
                  <text class="ring-sum-val">{{ sget(ringData, 'stepsStr') }}</text>
                </view>
                <text v-else class="ring-sum-na">—</text>
                <text class="ring-sum-sub">{{ tt('ringSteps') }}</text>
                <view v-if="bget(ringData, 'hasSteps')" class="ring-sum-bar">
                  <view class="ring-sum-bar-fill ring-steps-fill" :style="'width:' + an(ringData, 'stepsPct') + '%;'"></view>
                </view>
              </view>
              <view class="ring-sum-item">
                <view v-if="bget(ringData, 'hasSleep')" class="ring-sum-val-row">
                  <text class="ring-sum-val">{{ sget(ringData, 'sleepStr') }}</text>
                </view>
                <text v-else class="ring-sum-na">—</text>
                <text class="ring-sum-sub">{{ tt('ringSleep') }}</text>
                <view v-if="bget(ringData, 'hasSleep')" class="ring-sum-bar ring-sleep-segs">
                  <view class="ring-sum-bar-seg ring-deep-seg" :style="'width:' + an(ringData, 'sleepDeepPct') + '%;'"></view>
                  <view class="ring-sum-bar-seg ring-rem-seg" :style="'width:' + an(ringData, 'sleepRemPct') + '%;'"></view>
                  <view class="ring-sum-bar-seg ring-light-seg" :style="'width:' + an(ringData, 'sleepLightPct') + '%;'"></view>
                  <view class="ring-sum-bar-seg ring-awake-seg" :style="'width:' + an(ringData, 'sleepAwakePct') + '%;'"></view>
                </view>
              </view>
              <view class="ring-sum-item">
                <view v-if="bget(ringData, 'hasHr')" class="ring-sum-val-row">
                  <text class="ring-sum-val">{{ an(ringData, 'restingHr') }}</text>
                  <text class="ring-sum-unit">bpm</text>
                </view>
                <text v-else class="ring-sum-na">—</text>
                <text class="ring-sum-sub">{{ tt('ringHr') }}</text>
                <view v-if="bget(ringData, 'hasHr')" class="ring-sum-bar">
                  <view class="ring-sum-bar-fill ring-hr-fill" :style="'width:' + hrBarPct() + '%;'"></view>
                </view>
              </view>
              <view class="ring-sum-item">
                <view v-if="bget(ringData, 'hasHrv')" class="ring-sum-val-row">
                  <text class="ring-sum-val" :style="'color:' + tc(sget(ringData, 'hrvColor'))">{{ an(ringData, 'hrv') }}</text>
                  <text class="ring-sum-unit">ms</text>
                </view>
                <text v-else class="ring-sum-na">—</text>
                <text class="ring-sum-sub">{{ tt('ringHrv') }}</text>
                <view v-if="bget(ringData, 'hasHrv')" class="ring-sum-bar">
                  <view class="ring-sum-bar-fill" :style="'width:' + an(ringData, 'hrvPct') + '%;background:' + sget(ringData, 'hrvColor') + ';'"></view>
                </view>
              </view>
              <view class="ring-sum-item">
                <view v-if="bget(ringData, 'hasStress')" class="ring-sum-val-row">
                  <text class="ring-sum-val" :style="'color:' + tc(sget(ringData, 'stressColor'))">{{ an(ringData, 'stress') }}</text>
                </view>
                <text v-else class="ring-sum-na">—</text>
                <text class="ring-sum-sub">{{ tt('ringStress') }}</text>
                <view v-if="bget(ringData, 'hasStress')" class="ring-sum-bar">
                  <view class="ring-sum-bar-fill" :style="'width:' + an(ringData, 'stress') + '%;background:' + sget(ringData, 'stressColor') + ';'"></view>
                </view>
                <text v-if="bget(ringData, 'hasStress')" class="ring-sum-stress-label" :style="'color:' + tc(sget(ringData, 'stressColor'))">{{ sget(ringData, 'stressLabel') }}</text>
              </view>
              <view class="ring-sum-item">
                <view v-if="bget(ringData, 'hasSpo2')" class="ring-sum-val-row">
                  <text class="ring-sum-val" :style="'color:' + tc(sget(ringData, 'spo2Color'))">{{ an(ringData, 'spo2') }}</text>
                  <text class="ring-sum-unit">%</text>
                </view>
                <text v-else class="ring-sum-na">—</text>
                <text class="ring-sum-sub">SpO₂</text>
                <view v-if="bget(ringData, 'hasSpo2')" class="ring-sum-bar">
                  <view class="ring-sum-bar-fill" :style="'width:' + an(ringData, 'spo2Pct') + '%;background:' + sget(ringData, 'spo2Color') + ';'"></view>
                </view>
              </view>
              <view v-if="bget(ringData, 'hasBodyTemp')" class="ring-sum-item">
                <view class="ring-sum-val-row">
                  <text class="ring-sum-val" :style="'color:' + tc(sget(ringData, 'tempColor'))">{{ sget(ringData, 'bodyTempC') }}</text>
                  <text class="ring-sum-unit">°C</text>
                </view>
                <text class="ring-sum-sub">{{ tt('ringBodyTemp') }}</text>
                <view class="ring-sum-bar">
                  <view class="ring-sum-bar-fill" :style="'width:' + an(ringData, 'tempPct') + '%;background:' + sget(ringData, 'tempColor') + ';'"></view>
                </view>
              </view>
            </view>
            <text class="ring-sum-footer">{{ sget(ringData, 'syncLabel') }}</text>
          </view>

          <!-- Slot detail charts (steps / HR / sleep / trends) -->
          <view v-if="wearableId.length > 0 && ringData != null && bget(ringData, 'hasSlotCharts')" class="ring-detail-card">

            <view v-if="aget(ringData, 'stepsBars').length > 0" class="ring-chart-block">
              <text class="ring-chart-label">{{ tt('ringStepsChart') }}</text>
              <view class="ring-chart-bars">
                <view v-for="(item, i) in aget(ringData, 'stepsBars')" :key="i" class="ring-chart-col">
                  <view class="ring-chart-bar" :class="bget(item, 'active') ? '' : 'ring-chart-bar-empty'"
                        :style="'height:' + rp(barH(item)) + 'px;background:' + (bget(item, 'active') ? '#0ea5e9' : 'rgba(99,117,236,0.1)') + ';'"></view>
                  <text class="ring-chart-hlabel">{{ sget(item, 'h') }}</text>
                </view>
              </view>
            </view>

            <view v-if="aget(ringData, 'hrBars').length > 0" class="ring-chart-block">
              <text class="ring-chart-label">{{ tt('ringHrChart') }}</text>
              <view class="ring-chart-bars">
                <view v-for="(item, i) in aget(ringData, 'hrBars')" :key="i" class="ring-chart-col">
                  <view class="ring-chart-bar" :style="'height:' + rp(an(item, 'heightRpx')) + 'px;background:' + sget(item, 'color') + ';'"></view>
                  <text class="ring-chart-hlabel">{{ sget(item, 'h') }}</text>
                </view>
              </view>
            </view>

            <view v-if="aget(ringData, 'hrvDayBars').length > 0" class="ring-chart-block">
              <text class="ring-chart-label">{{ tt('ringHrvTrend') }}</text>
              <view class="ring-chart-bars">
                <view v-for="(item, i) in aget(ringData, 'hrvDayBars')" :key="i" class="ring-chart-day-col">
                  <text class="ring-chart-day-avg">{{ an(item, 'avg') }}</text>
                  <view class="ring-chart-bar" :style="'height:' + rp(an(item, 'heightRpx')) + 'px;background:' + sget(item, 'color') + ';width:100%;'"></view>
                  <text class="ring-chart-day-label">{{ sget(item, 'label') }}</text>
                </view>
              </view>
            </view>

            <view v-if="aget(ringData, 'spo2DayBars').length > 0" class="ring-chart-block">
              <text class="ring-chart-label">{{ tt('ringSpo2Trend') }}</text>
              <view class="ring-chart-bars">
                <view v-for="(item, i) in aget(ringData, 'spo2DayBars')" :key="i" class="ring-chart-day-col">
                  <text class="ring-chart-day-avg">{{ an(item, 'avg') }}%</text>
                  <view class="ring-chart-bar" :style="'height:' + rp(an(item, 'heightRpx')) + 'px;background:' + sget(item, 'color') + ';width:100%;'"></view>
                  <text class="ring-chart-day-label">{{ sget(item, 'label') }}</text>
                </view>
              </view>
            </view>

            <!-- Weekly sleep timeline: every night + nap as a distinct block on a
                 noon-to-noon 24h axis (merge §9 invariants preserved in _buildRingDisplayData) -->
            <view v-if="aget(ringData, 'sleepWeek').length > 0" class="ring-chart-block">
              <text class="ring-chart-label">{{ tt('ringSleepWeek') }}</text>
              <view class="ring-sleepweek-wrap">
                <view class="ring-sleepweek-axis" :style="'height:' + rp(nget(ringData, 'sleepAxisHeightRpx')) + 'px;'">
                  <text class="ring-sleepweek-axis-lbl">12</text>
                  <text class="ring-sleepweek-axis-lbl">18</text>
                  <text class="ring-sleepweek-axis-lbl">24</text>
                  <text class="ring-sleepweek-axis-lbl">06</text>
                  <text class="ring-sleepweek-axis-lbl">12</text>
                </view>
                <view class="ring-sleepweek-days">
                  <view v-for="(day, i) in aget(ringData, 'sleepWeek')" :key="i" class="ring-sleepweek-daycol">
                    <view class="ring-sleepweek-track" :style="'height:' + rp(nget(ringData, 'sleepAxisHeightRpx')) + 'px;'">
                      <view class="ring-sleepweek-gridline" style="top:0%;"></view>
                      <view class="ring-sleepweek-gridline" style="top:25%;"></view>
                      <view class="ring-sleepweek-gridline" style="top:50%;"></view>
                      <view class="ring-sleepweek-gridline" style="top:75%;"></view>
                      <view v-for="(blk, j) in aget(day, 'blocks')" :key="j" class="ring-sleepweek-block"
                            :class="bget(blk, 'isNap') ? 'ring-sleepweek-block-nap' : ''"
                            :style="'top:' + rp(an(blk, 'topRpx')) + 'px;height:' + rp(an(blk, 'heightRpx')) + 'px;background:' + sget(blk, 'color') + ';'"></view>
                    </view>
                    <text class="ring-sleepweek-total">{{ sget(day, 'totalLabel') }}</text>
                    <text class="ring-sleepweek-daylabel">{{ sget(day, 'label') }}</text>
                  </view>
                </view>
              </view>
              <view class="ring-sleep-legend">
                <view class="ring-sleep-leg-item">
                  <view class="ring-sleep-leg-dot" style="background:#10b981;"></view>
                  <text class="ring-sleep-leg-txt">{{ tt('ringNightSleep') }}</text>
                </view>
                <view class="ring-sleep-leg-item">
                  <view class="ring-sleep-leg-dot" style="background:#f59e0b;"></view>
                  <text class="ring-sleep-leg-txt">{{ tt('ringNap') }}</text>
                </view>
              </view>
            </view>

            <!-- HRV / SpO₂ / stress smoothed line charts (§44 display-only smoothing) -->
            <view v-if="chartBool('hrvChart', 'hasData')" class="ring-chart-block">
              <view class="ring-linechart-header">
                <text class="ring-chart-label">{{ tt('ringHrv') }}</text>
                <view class="ring-linechart-latest-row">
                  <text class="ring-linechart-latest" :style="'color:' + tc(chartStr('hrvChart', 'latestColor'))">{{ chartNumStr('hrvChart', 'latestVal') }}</text>
                  <text class="ring-linechart-unit">ms</text>
                  <text v-if="chartBool('hrvChart', 'latestEstimated')" class="ring-lc-estimated-marker">~</text>
                </view>
              </view>
              <view class="ring-lc-bars">
                <view v-for="(item, i) in chartBars('hrvChart')" :key="i" class="ring-lc-col">
                  <view class="ring-lc-bar" :class="bget(item, 'estimated') ? 'ring-lc-bar-estimated' : ''"
                        :style="'height:' + rp(an(item, 'heightRpx')) + 'px;background:' + sget(item, 'color') + ';width:100%;'"></view>
                </view>
              </view>
              <view class="ring-linechart-range">
                <text class="ring-linechart-bound">{{ chartNumStr('hrvChart', 'minVal') }} ms</text>
                <text class="ring-linechart-count">{{ chartNumStr('hrvChart', 'count') }} 次</text>
                <text class="ring-linechart-bound">{{ chartNumStr('hrvChart', 'maxVal') }} ms</text>
              </view>
              <text v-if="chartNum('hrvChart', 'estimatedCount') > 0" class="ring-lc-smoothed-note">{{ chartNum('hrvChart', 'estimatedCount') }}{{ tt('ringSmoothedNote') }}</text>
            </view>

            <view v-if="chartBool('spo2Chart', 'hasData')" class="ring-chart-block">
              <view class="ring-linechart-header">
                <text class="ring-chart-label">SpO₂</text>
                <view class="ring-linechart-latest-row">
                  <text class="ring-linechart-latest" :style="'color:' + tc(chartStr('spo2Chart', 'latestColor'))">{{ chartNumStr('spo2Chart', 'latestVal') }}</text>
                  <text class="ring-linechart-unit">%</text>
                  <text v-if="chartBool('spo2Chart', 'latestEstimated')" class="ring-lc-estimated-marker">~</text>
                </view>
              </view>
              <view class="ring-lc-bars">
                <view v-for="(item, i) in chartBars('spo2Chart')" :key="i" class="ring-lc-col">
                  <view class="ring-lc-bar" :class="bget(item, 'estimated') ? 'ring-lc-bar-estimated' : ''"
                        :style="'height:' + rp(an(item, 'heightRpx')) + 'px;background:' + sget(item, 'color') + ';width:100%;'"></view>
                </view>
              </view>
              <view class="ring-linechart-range">
                <text class="ring-linechart-bound">{{ chartNumStr('spo2Chart', 'minVal') }}%</text>
                <text class="ring-linechart-count">{{ chartNumStr('spo2Chart', 'count') }} 次</text>
                <text class="ring-linechart-bound">{{ chartNumStr('spo2Chart', 'maxVal') }}%</text>
              </view>
              <text v-if="chartNum('spo2Chart', 'estimatedCount') > 0" class="ring-lc-smoothed-note">{{ chartNum('spo2Chart', 'estimatedCount') }}{{ tt('ringSmoothedNote') }}</text>
            </view>

            <view v-if="chartBool('stressChart', 'hasData')" class="ring-chart-block">
              <view class="ring-linechart-header">
                <text class="ring-chart-label">{{ tt('ringStress') }}</text>
                <view class="ring-linechart-latest-row">
                  <text class="ring-linechart-latest" :style="'color:' + tc(chartStr('stressChart', 'latestColor'))">{{ chartNumStr('stressChart', 'latestVal') }}</text>
                  <text v-if="chartBool('stressChart', 'latestEstimated')" class="ring-lc-estimated-marker">~</text>
                </view>
              </view>
              <view class="ring-lc-bars">
                <view v-for="(item, i) in chartBars('stressChart')" :key="i" class="ring-lc-col">
                  <view class="ring-lc-bar" :class="bget(item, 'estimated') ? 'ring-lc-bar-estimated' : ''"
                        :style="'height:' + rp(an(item, 'heightRpx')) + 'px;background:' + sget(item, 'color') + ';width:100%;'"></view>
                </view>
              </view>
              <view class="ring-linechart-range">
                <text class="ring-linechart-bound">{{ chartNumStr('stressChart', 'minVal') }}</text>
                <text class="ring-linechart-count">{{ chartNumStr('stressChart', 'count') }} 次</text>
                <text class="ring-linechart-bound">{{ chartNumStr('stressChart', 'maxVal') }}</text>
              </view>
              <text v-if="chartNum('stressChart', 'estimatedCount') > 0" class="ring-lc-smoothed-note">{{ chartNum('stressChart', 'estimatedCount') }}{{ tt('ringSmoothedNote') }}</text>
            </view>

            <!-- Sleep stage timeline (most recent night, detailed) -->
            <view v-if="aget(ringData, 'sleepSegs').length > 0" class="ring-chart-block">
              <view class="ring-chart-header">
                <text class="ring-chart-label">{{ tt('ringSleepChart') }}</text>
                <view class="ring-chart-header-right">
                  <text v-if="sget(ringData, 'sleepDateLabel').length > 0" class="ring-chart-date">{{ sget(ringData, 'sleepDateLabel') }}</text>
                  <text v-if="sget(ringData, 'sleepTimeRange').length > 0" class="ring-chart-time">{{ sget(ringData, 'sleepTimeRange') }}</text>
                </view>
              </view>
              <view class="ring-sleep-timeline">
                <view v-for="(item, i) in aget(ringData, 'sleepSegs')" :key="i" class="ring-sleep-tl-seg"
                      :style="'width:' + an(item, 'widthPct') + '%;background:' + sget(item, 'color') + ';'"></view>
              </view>
              <view class="ring-sleep-legend">
                <view class="ring-sleep-leg-item">
                  <view class="ring-sleep-leg-dot" style="background:#6375EC;"></view>
                  <text class="ring-sleep-leg-txt">{{ tt('ringDeep') }} {{ an(ringData, 'sleepDeep') }}m</text>
                </view>
                <view class="ring-sleep-leg-item">
                  <view class="ring-sleep-leg-dot" style="background:#a855f7;"></view>
                  <text class="ring-sleep-leg-txt">{{ tt('ringRem') }} {{ an(ringData, 'sleepRem') }}m</text>
                </view>
                <view class="ring-sleep-leg-item">
                  <view class="ring-sleep-leg-dot" style="background:#0ea5e9;"></view>
                  <text class="ring-sleep-leg-txt">{{ tt('ringLight') }} {{ an(ringData, 'sleepLight') }}m</text>
                </view>
                <view class="ring-sleep-leg-item">
                  <view class="ring-sleep-leg-dot" style="background:rgba(166,196,229,0.4);"></view>
                  <text class="ring-sleep-leg-txt">{{ tt('ringAwake') }} {{ an(ringData, 'sleepAwake') }}m</text>
                </view>
              </view>
            </view>
          </view>

          <view v-if="hasTwinData">
            <!-- Body Composition -->
            <view v-if="twinBodyBar != null" class="ht-body-card">
              <view class="ht-body-header">
                <text class="ht-body-title">{{ tt('dtBody') }}</text>
                <text v-if="twinBody.length > 0" class="ht-body-vals">{{ twinBody }}</text>
              </view>
              <view class="ht-body-bar">
                <view class="ht-body-lean" :style="'width:' + an(twinBodyBar, 'leanPct') + '%;'"></view>
                <view class="ht-body-fat-fill" :style="'width:' + an(twinBodyBar, 'fatPct') + '%;'"></view>
              </view>
              <view class="ht-body-legend">
                <view class="ht-body-legend-item">
                  <view class="ht-body-dot ht-lean-dot"></view>
                  <text class="ht-body-lbl">{{ tt('dtLean') }} {{ an(twinBodyBar, 'leanPct') }}%</text>
                </view>
                <view class="ht-body-legend-item">
                  <view class="ht-body-dot ht-fat-dot"></view>
                  <text class="ht-body-lbl">{{ tt('dtFat') }} {{ an(twinBodyBar, 'fatPct') }}%</text>
                </view>
              </view>
            </view>
          </view>
          <text v-else-if="!twinLoading" class="health-empty">{{ tt('noTwinData') }}</text>

          <!-- 心电节律 (ECG, V8 only) and 脉搏波 (PPG, V8 + Halo) strip cards (§45). Copy says
               "rhythm strip"/"pulse wave", never "diagnosis". -->
          <view v-if="ecgSupported || ecgLatest != null" class="ecg-card">
            <view class="ecg-card-row">
              <view class="ecg-card-main">
                <text class="ecg-card-title">{{ tt('ecgTitle') }}</text>
                <view v-if="ecgLatest != null" class="ecg-card-hero" v-on:click.stop="openEcgView('ecg', an(ecgLatest, 'id'))">
                  <text class="ecg-card-bpm">{{ an(ecgLatest, 'bpm') }}</text>
                  <text class="ecg-card-unit">bpm</text>
                  <text class="ecg-card-meta">{{ sget(ecgLatest, 'whenLabel') }} · {{ an(ecgLatest, 'accepted_beats') }} {{ tt('ecgBeats') }} · RR±{{ an(ecgLatest, 'rr_sd_ms') }}ms</text>
                </view>
                <text v-else class="ecg-card-empty">{{ mode == 'self' ? tt('ecgEmptySelf') : tt('ecgEmptyOther') }}</text>
              </view>
            </view>
            <view v-if="ecgList.length > 1" class="ecg-card-list">
              <view v-for="(item, i) in ecgListTail" :key="i" class="ecg-card-list-row" v-on:click.stop="openEcgView('ecg', an(item, 'id'))">
                <text class="ecg-card-list-when">{{ sget(item, 'whenLabel') }}</text>
                <text class="ecg-card-list-val">{{ an(item, 'bpm') }} bpm · RR±{{ an(item, 'rr_sd_ms') }}ms</text>
              </view>
            </view>
            <text class="ecg-card-foot">{{ tt('ecgNotDiagnosis') }}</text>
          </view>
          <view v-if="ppgSupported || ppgLatest != null" class="ecg-card">
            <view class="ecg-card-row">
              <view class="ecg-card-main">
                <text class="ecg-card-title">{{ tt('ppgTitle') }}</text>
                <view v-if="ppgLatest != null" class="ecg-card-hero" v-on:click.stop="openEcgView('ppg', an(ppgLatest, 'id'))">
                  <text class="ecg-card-bpm">{{ an(ppgLatest, 'bpm') }}</text>
                  <text class="ecg-card-unit">bpm</text>
                  <text class="ecg-card-meta">{{ sget(ppgLatest, 'whenLabel') }} · {{ an(ppgLatest, 'accepted_beats') }} {{ tt('ecgBeats') }} · PP±{{ an(ppgLatest, 'rr_sd_ms') }}ms</text>
                </view>
                <text v-else class="ecg-card-empty">{{ mode == 'self' ? tt('ppgEmptySelf') : tt('ppgEmptyOther') }}</text>
              </view>
            </view>
            <view v-if="ppgList.length > 1" class="ecg-card-list">
              <view v-for="(item, i) in ppgListTail" :key="i" class="ecg-card-list-row" v-on:click.stop="openEcgView('ppg', an(item, 'id'))">
                <text class="ecg-card-list-when">{{ sget(item, 'whenLabel') }}</text>
                <text class="ecg-card-list-val">{{ an(item, 'bpm') }} bpm · PP±{{ an(item, 'rr_sd_ms') }}ms</text>
              </view>
            </view>
            <text class="ecg-card-foot">{{ tt('ppgNotDiagnosis') }}</text>
          </view>
        </view>

        <!-- Twin layer: Precision Testing -->
        <view class="health-section">
          <view class="section-title-row">
            <text class="section-title">{{ tt('layerPrecision') }}</text>
            <view v-if="recordCount > 0" class="section-badge">
              <text class="section-badge-text">{{ recordCount }} {{ tt('tests') }}</text>
            </view>
          </view>
          <view v-if="recordCount > 0" class="trend-grid">
            <view v-for="(item, i) in trendList" :key="i" class="trend-card">
              <text class="trend-label">{{ sget(item, 'label') }}</text>
              <view class="trend-val-row">
                <text class="trend-val" :style="'color:' + tc(sget(item, 'color'))">{{ sget(item, 'lastValStr').length > 0 ? sget(item, 'lastValStr') : '—' }}</text>
                <text class="trend-unit">{{ sget(item, 'unit') }}</text>
              </view>
              <view v-if="aget(item, 'sparkBars').length > 1" class="spark-row">
                <view v-for="(bar, j) in aget(item, 'sparkBars')" :key="j" class="spark-bar"
                      :class="bget(bar, 'empty') ? 'spark-bar-empty' : ''"
                      :style="'height:' + rp(an(bar, 'h')) + 'px;background:' + sget(bar, 'color') + ';'"></view>
              </view>
            </view>
          </view>
          <text v-else class="health-empty">{{ tt('noHistory') }}</text>
        </view>

        <!-- Twin layer: Medical Records (snapshot + reports + food sensitivity) -->
        <view class="health-section">
          <view class="section-title-row">
            <text class="section-title">{{ tt('layerMedical') }}</text>
            <view v-if="labPanelAbnormal > 0" class="ht-lab-alert">
              <text class="ht-lab-alert-text">{{ labPanelAbnormal }} {{ tt('labAbnormal') }}</text>
            </view>
            <view v-else-if="labPanelAbnormal == 0 && labPanel.length > 0" class="ht-lab-ok">
              <text class="ht-lab-ok-text">{{ tt('labAllNormal') }}</text>
            </view>
          </view>
          <view v-if="labPanel.length > 0" class="ht-lab-snapshot-wrap">
            <view class="ht-lab-snapshot-header">
              <text class="ht-lab-snapshot-title">{{ tt('labPanel') }}</text>
              <text class="ht-lab-date">{{ labPanelMeta.length > 0 ? labPanelMeta : labPanelDate }}</text>
            </view>
            <view class="ht-lab-grid">
              <view v-for="(item, i) in labPanel" :key="i" class="ht-lab-item"
                    :class="(sget(item, 'status') != 'normal' ? 'ht-lab-item-abn' : '') + ' ' + (bget(item, 'hasTrend') ? 'ht-lab-item-trend' : '')"
                    :style="'border-color:' + tcA(sget(item, 'statusColor'), 0.13) + ';'"
                    v-on:click="onLabTileTap(sget(item, 'key'))">
                <text class="ht-lab-name" :style="'color:' + tc(sget(item, 'status') != 'normal' ? sget(item, 'statusColor') : 'rgba(166,196,229,0.55)')">{{ sget(item, 'displayName') }}</text>
                <text class="ht-lab-val" :style="'color:' + tc(sget(item, 'statusColor'))">{{ sget(item, 'value') }}</text>
                <text class="ht-lab-unit">{{ sget(item, 'unit') }}</text>
                <text v-if="sget(item, 'dateShort').length > 0 || bget(item, 'hasTrend')" class="ht-lab-sub">{{ sget(item, 'dateShort') }}{{ sget(item, 'dateShort').length > 0 && bget(item, 'hasTrend') ? ' · ' : '' }}{{ bget(item, 'hasTrend') ? '↗' : '' }}</text>
              </view>
            </view>
            <text class="ht-lab-hint">{{ tt('labPanelHint') }}</text>
          </view>
          <view v-if="reportsLoading" class="center-wrap">
            <view class="pulse-dot"></view><view class="pulse-dot"></view><view class="pulse-dot"></view>
          </view>
          <view v-else-if="healthReports.length > 0" class="rpt-list">
            <view v-for="(item, i) in healthReports" :key="i" class="rpt-card" v-on:click="onReportTap(an(item, 'id'))">
              <image v-if="sget(item, 'image_url').length > 0" class="rpt-thumb" :src="sget(item, 'image_url')" mode="aspectFill"
                     v-on:click.stop="previewReportImage(sget(item, 'image_url'))" />
              <view class="rpt-card-left" :style="'border-left-color:' + tc(sget(item, 'type_color')) + ';'">
                <text class="rpt-institution">{{ sget(item, 'institution') }}</text>
                <text class="rpt-date">{{ sget(item, 'report_date') }}{{ sget(item, 'items_label').length > 0 ? ' · ' + sget(item, 'items_label') : '' }}</text>
              </view>
              <view class="rpt-type-badge" :style="'border-color:' + tcA(sget(item, 'type_color'), 0.27) + ';'">
                <text class="rpt-type-text" :style="'color:' + tc(sget(item, 'type_color'))">{{ sget(item, 'report_type') }}</text>
              </view>
              <text class="rpt-arrow">›</text>
            </view>
          </view>
          <text v-else-if="!reportsLoading && labPanel.length == 0 && foodPanel == null" class="health-empty">{{ tt('noReports') }}</text>

          <!-- Chronic food sensitivity (食物特异性 IgG, §40) — its own block inside Medical
               Records; a food is not a biomarker_catalog marker. -->
          <view v-if="foodPanel != null" class="fs-block">
            <view class="ht-lab-snapshot-header">
              <text class="ht-lab-snapshot-title">{{ tt('foodPanelTitle') }}</text>
              <text class="ht-lab-date">{{ sget(foodPanel, 'report_date') }}</text>
            </view>
            <text class="fs-summary">{{ foodSummary }}</text>
            <view v-if="foodPositives.length > 0" class="fs-list">
              <view v-for="(item, i) in foodPositives" :key="i" class="fs-row" :style="'border-color:' + tcA(sget(item, 'color'), 0.27) + ';'">
                <view class="fs-row-head">
                  <text class="fs-food">{{ sget(item, 'name') }}</text>
                  <text class="fs-class" :style="'color:' + tc(sget(item, 'color'))">{{ sget(item, 'classLabel') }}</text>
                  <text class="fs-val">{{ sget(item, 'valueText') }}</text>
                </view>
                <text v-if="sget(item, 'windowText').length > 0" class="fs-window">{{ sget(item, 'windowText') }}</text>
                <text v-if="sget(item, 'substitutes').length > 0" class="fs-subs">{{ tt('foodSubstitutes') }}{{ sget(item, 'substitutes') }}</text>
              </view>
            </view>
            <text class="fs-footnote">{{ tt('foodPanelNote') }}</text>
          </view>
        </view>

        <!-- Twin layer: Personal Profile — read-only AI-recorded facts (self view only) -->
        <view v-if="mode == 'self' && userFactsLoaded" class="health-section">
          <text class="section-title">{{ tt('layerProfile') }}</text>
          <view v-if="userFacts.length > 0" class="fact-list">
            <view v-for="(item, i) in userFacts" :key="i" class="fact-chip" :style="'border-color:' + tcA(sget(item, 'color'), 0.27) + ';'">
              <text class="fact-cat" :style="'color:' + tc(sget(item, 'color'))">{{ sget(item, 'categoryLabel') }}</text>
              <text class="fact-text">{{ sget(item, 'fact') }}</text>
            </view>
            <text class="fact-footnote">{{ tt('factsFootnote') }}</text>
          </view>
          <text v-else class="health-empty">{{ tt('noFactsSelf') }}</text>
        </view>

        <!-- <health-documents> (§38): upload + extraction list; reports docCount/latestDate
             back via :loaded for the twin-layer strip (§34 layer 3). -->
        <health-documents v-if="!isGuest" :userId="userId" :lang="lang" :theme="theme"
          :collapsible="true" :canUpload="mode == 'self'" :coachId="coachId" v-on:loaded="_onDocsLoaded" />

        <!-- 综合报告 card — completed AG artifacts (GET /api/twin-reports) -->
        <view v-if="twinReportLatest != null" class="health-section">
          <view class="section-title-row">
            <text class="section-title">{{ tt('reportsTitle') }}</text>
            <text v-if="twinReports.length > 1" class="tr-count" v-on:click="onTwinReportListTap">{{ tt('reportsCount') }} {{ twinReports.length }} ›</text>
          </view>
          <view class="tr-card" v-on:click="onTwinReportTap(sget(twinReportLatest, 'job_uid'), nget(twinReportLatest, 'primary_index'))">
            <view class="tr-icon"><text class="tr-icon-txt">📄</text></view>
            <view class="tr-body">
              <text class="tr-title">{{ sget(twinReportLatest, 'title') }}</text>
              <text v-if="sget(twinReportLatest, 'attributionText').length > 0" class="tr-origin">{{ sget(twinReportLatest, 'attributionText') }}</text>
              <text class="tr-meta">{{ sget(twinReportLatest, 'metaLine') }}</text>
              <text v-if="sget(twinReportLatest, 'summary').length > 0" class="tr-summary">{{ sget(twinReportLatest, 'summary') }}</text>
            </view>
            <view class="tr-open"><text class="tr-open-txt">{{ twinReportOpening ? tt('reportsOpening') : tt('reportsOpen') }}</text></view>
          </view>
        </view>

        <view style="height: 32px;"></view>
      </view>
    </scroll-view>

    <!-- <strip-record> (ECG+PPG recorder overlay, §45): one instance serves both kinds;
         the tap target sets stripKind/stripViewId before opening. <viva-ag-panel> (§35)
         mounts only while its subtab is active; the host page's onHide/onShow drives its
         pausePolling()/resumePolling() through the $refs bridge. -->
    <strip-record :kind="stripKind" :open="ecgRecordOpen" :userId="userId" :brand="wearableBrand"
      :deviceId="wearableId" :deviceName="wearableName" :lang="lang" :theme="theme"
      :viewId="stripViewId" :coachId="coachId" :readOnly="mode != 'self'"
      v-on:close="closeEcgRecord" v-on:saved="onEcgSaved" v-on:deleted="onEcgDeleted" />
    <viva-ag-panel v-if="showAgTab && healthSubTab == 'ag'" :userId="userId" :lang="lang" :theme="theme"
      v-on:gotochat="onAgGoToChat" />

    <!-- Health Report Detail Sheet -->
    <view v-if="activeReport != null" class="rpt-overlay" v-on:click="onCloseReport">
      <view class="rpt-sheet" v-on:click.stop="noop()">
        <view class="rpt-sheet-handle"></view>
        <view class="rpt-sheet-header">
          <view class="rpt-sheet-title-group">
            <text class="rpt-sheet-institution">{{ sget(activeReport, 'institution') }}</text>
            <text class="rpt-sheet-date">{{ sget(activeReport, 'report_date') }}</text>
          </view>
          <view class="rpt-sheet-type-badge" :style="'border-color:' + tcA(sget(activeReport, 'type_color'), 0.27) + ';'">
            <text class="rpt-sheet-type-text" :style="'color:' + tc(sget(activeReport, 'type_color'))">{{ sget(activeReport, 'report_type') }}</text>
          </view>
          <view class="rpt-close-btn" v-on:click="onCloseReport"><text class="rpt-close-x">✕</text></view>
        </view>

        <scroll-view direction="vertical" class="rpt-events-scroll">
          <view v-if="reportDetailLoading" class="center-wrap">
            <view class="pulse-dot"></view><view class="pulse-dot"></view><view class="pulse-dot"></view>
          </view>
          <view v-else>
            <view v-if="sget(activeReport, 'image_url').length > 0" class="rpt-section">
              <image class="rpt-photo" :src="sget(activeReport, 'image_url')" mode="widthFix"
                     v-on:click="previewReportImage(sget(activeReport, 'image_url'))" />
            </view>

            <view v-if="bget(activeReport, 'hasDoctorNotes')" class="rpt-section">
              <view class="rpt-section-header">
                <text class="rpt-section-icon">🩺</text>
                <text class="rpt-section-title">{{ tt('rptDoctorTitle') }}</text>
              </view>
              <view v-if="sget(activeReportDoctorNotes, 'physician').length > 0" class="rpt-dn-meta">
                <text class="rpt-dn-key">{{ tt('rptPhysician') }}</text>
                <text class="rpt-dn-val">{{ sget(activeReportDoctorNotes, 'physician') }}{{ sget(activeReportDoctorNotes, 'department').length > 0 ? ' · ' + sget(activeReportDoctorNotes, 'department') : '' }}</text>
              </view>
              <view v-if="aget(activeReportDoctorNotes, 'vitals').length > 0" class="rpt-vitals-grid">
                <view v-for="(item, i) in aget(activeReportDoctorNotes, 'vitals')" :key="i" class="rpt-vital-item">
                  <text class="rpt-vital-key">{{ sget(item, 'key') }}</text>
                  <text class="rpt-vital-val">{{ sget(item, 'value') }}</text>
                </view>
              </view>
              <view v-if="sget(activeReportDoctorNotes, 'clinical_summary').length > 0" class="rpt-clinical">
                <text class="rpt-clinical-label">{{ tt('rptClinicalSummary') }}</text>
                <text class="rpt-clinical-text">{{ sget(activeReportDoctorNotes, 'clinical_summary') }}</text>
              </view>
              <view v-if="ags(activeReportDoctorNotes, 'recommendations').length > 0" class="rpt-dn-subsection">
                <view class="rpt-section-header">
                  <text class="rpt-section-icon">💊</text>
                  <text class="rpt-section-title">{{ tt('rptRecommendations') }}</text>
                </view>
                <view class="rpt-advice-list">
                  <view v-for="(item, i) in ags(activeReportDoctorNotes, 'recommendations')" :key="i" class="rpt-advice-item">
                    <text class="rpt-advice-num">{{ adviceIdx(i) }}</text>
                    <text class="rpt-advice-text">{{ item }}</text>
                  </view>
                </view>
              </view>
              <view v-if="sget(activeReportDoctorNotes, 'follow_up').length > 0" class="rpt-followup">
                <text class="rpt-followup-label">{{ tt('rptFollowUp') }}</text>
                <text class="rpt-followup-text">{{ sget(activeReportDoctorNotes, 'follow_up') }}</text>
              </view>
            </view>

            <view v-if="bget(activeReport, 'hasDiag')" class="rpt-section">
              <view class="rpt-section-header">
                <text class="rpt-section-icon">🔬</text>
                <text class="rpt-section-title">{{ tt('rptDiagTitle') }}</text>
              </view>
              <view class="rpt-diag-list">
                <view v-for="(item, i) in activeReportDiag" :key="i" class="rpt-diag-item">
                  <view class="rpt-diag-bullet"></view>
                  <text class="rpt-diag-text">{{ item }}</text>
                </view>
              </view>
            </view>

            <view v-if="bget(activeReport, 'hasAdvice')" class="rpt-section">
              <view class="rpt-section-header">
                <text class="rpt-section-icon">💊</text>
                <text class="rpt-section-title">{{ tt('rptAdviceTitle') }}</text>
              </view>
              <view class="rpt-advice-list">
                <view v-for="(item, i) in activeReportAdvice" :key="i" class="rpt-advice-item">
                  <text class="rpt-advice-num">{{ i + 1 }}</text>
                  <text class="rpt-advice-text">{{ item }}</text>
                </view>
              </view>
            </view>

            <view v-if="activeReportEvents.length > 0" class="rpt-section">
              <view v-if="bget(activeReport, 'hasDiag') || bget(activeReport, 'hasAdvice') || activeReportOtherItems.length > 0" class="rpt-section-header">
                <text class="rpt-section-icon">📊</text>
                <text class="rpt-section-title">{{ tt('rptMarkersTitle') }}</text>
              </view>
              <view class="rpt-events-list">
                <view v-for="(item, i) in activeReportEvents" :key="i" class="rpt-ev-row">
                  <view class="rpt-ev-left">
                    <view class="rpt-ev-dot" :style="'background:' + sget(item, 'statusColor') + ';'"></view>
                    <view class="rpt-ev-info">
                      <text class="rpt-ev-name">{{ sget(item, 'key_name') }}</text>
                      <text v-if="sget(item, 'refText').length > 0" class="rpt-ev-ref">{{ tt('rptRefRange') }} {{ sget(item, 'refText') }}</text>
                    </view>
                  </view>
                  <view class="rpt-ev-right">
                    <text class="rpt-ev-val">{{ sget(item, 'value') }}</text>
                    <text class="rpt-ev-unit">{{ sget(item, 'unit') }}</text>
                    <view class="rpt-ev-status" :style="'border-color:' + tcA(sget(item, 'statusColor'), 0.27) + ';'">
                      <text class="rpt-ev-status-text" :style="'color:' + tc(sget(item, 'statusColor'))">{{ sget(item, 'statusLabel') }}</text>
                    </view>
                  </view>
                </view>
              </view>
            </view>

            <view v-if="activeReportOtherItems.length > 0" class="rpt-section">
              <view class="rpt-section-header">
                <text class="rpt-section-icon">📄</text>
                <text class="rpt-section-title">{{ tt('rptOtherItemsTitle') }}</text>
              </view>
              <view class="rpt-events-list">
                <view v-for="(item, i) in activeReportOtherItems" :key="i" class="rpt-ev-row">
                  <view class="rpt-ev-left">
                    <view class="rpt-ev-dot" :style="'background:' + (bget(item, 'flagged') ? sget(item, 'statusColor') : 'rgba(166,196,229,0.25)') + ';'"></view>
                    <view class="rpt-ev-info">
                      <text class="rpt-ev-name">{{ sget(item, 'key_name') }}</text>
                      <text v-if="sget(item, 'refText').length > 0" class="rpt-ev-ref">{{ tt('rptRefRange') }} {{ sget(item, 'refText') }}</text>
                      <text v-if="sget(item, 'suggested').length > 0" class="rpt-ev-ref">{{ sget(item, 'suggested') }}</text>
                    </view>
                  </view>
                  <view class="rpt-ev-right">
                    <text class="rpt-ev-val">{{ sget(item, 'value') }}</text>
                    <text class="rpt-ev-unit">{{ sget(item, 'unit') }}</text>
                    <view v-if="bget(item, 'flagged')" class="rpt-ev-status" :style="'border-color:' + tcA(sget(item, 'statusColor'), 0.27) + ';'">
                      <text class="rpt-ev-status-text" :style="'color:' + tc(sget(item, 'statusColor'))">{{ sget(item, 'statusLabel') }}</text>
                    </view>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>

    <!-- Chart modals. Deviation: the miniapp has one canvas modal per metric; uni-app x has
         no legacy canvas API, so each modal renders the same view-based line layout built by
         _buildGenericChartLayout (all geometry math preserved). Only one modal is ever open,
         so they share the `lineChart` layout object; the BP modal keeps two series. -->
    <view v-if="anyChartModalOpen" class="wchart-overlay" v-on:click="closeAnyChart">
      <view class="wchart-sheet" v-on:click.stop="noop()">
        <view class="wchart-handle"></view>
        <view class="wchart-header">
          <text class="wchart-title">{{ chartModalTitle }}</text>
          <view class="wchart-close" v-on:click="closeAnyChart"><text class="wchart-close-x">✕</text></view>
        </view>
        <view class="chart-box" :style="'width:' + chartModalW + 'px;height:200px;'"
              v-on:touchstart="onChartTouch(chartModalCanvasId, $event)"
              v-on:touchmove="onChartTouch(chartModalCanvasId, $event)"
              v-on:touchend="onChartTouchEnd(chartModalCanvasId)">
          <view v-for="(g, i) in aget(lineChart, 'grid')" :key="'g' + i" class="chart-grid-line"
                :style="'top:' + an(g, 'y') + 'px;left:' + lcN('pL') + 'px;width:' + lcN('plotW') + 'px;'"></view>
          <text v-for="(g, i) in aget(lineChart, 'grid')" :key="'gl' + i" class="chart-grid-label"
                :style="'top:' + (an(g, 'y') - 6) + 'px;'">{{ al(g, 'text') }}</text>
          <view v-for="(p, i) in aget(lineChart, 'pts')" :key="'p' + i" class="chart-dot"
                :style="'left:' + (an(p, 'x') - 3) + 'px;top:' + (an(p, 'y') - 3) + 'px;background:' + lcS('accent') + ';'"></view>
          <view v-for="(l, i) in aget(lineChart, 'labels')" :key="'l' + i" class="chart-x-label"
                :style="'left:' + (an(l, 'x') - 16) + 'px;top:172px;'">
            <text class="chart-x-label-text">{{ al(l, 'text') }}</text>
          </view>
          <view v-if="lcCrossIdx >= 0 && crossInfo != null" class="chart-cross-line"
                :style="'left:' + an(crossPt(), 'x') + 'px;top:' + lcN('pT') + 'px;height:' + lcN('plotH') + 'px;'"></view>
          <view v-if="lcCrossIdx >= 0 && crossInfo != null" class="chart-cross-dot"
                :style="'left:' + (an(crossPt(), 'x') - 4) + 'px;top:' + (an(crossPt(), 'y') - 4) + 'px;background:' + lcS('accent') + ';'"></view>
          <view v-if="lcCrossIdx >= 0 && crossInfo != null" class="chart-cross-box" :style="crossBoxStyle()">
            <text v-for="(ln, i) in aget(crossInfo, 'labelLines')" :key="'cl' + i" class="chart-cross-line-txt"
                  :style="'color:' + aln(ln, 'color') + ';'">{{ al(ln, 'text') }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Blood Pressure Chart Modal (two series: SYS red / DIA blue) -->
    <view v-if="bpChartOpen" class="wchart-overlay" v-on:click="closeBpChart">
      <view class="wchart-sheet" v-on:click.stop="noop()">
        <view class="wchart-handle"></view>
        <view class="wchart-header">
          <text class="wchart-title">{{ tt('metricBp') }}</text>
          <view class="wchart-close" v-on:click="closeBpChart"><text class="wchart-close-x">✕</text></view>
        </view>
        <view class="bp-chart-legend">
          <view class="bp-legend-item"><view class="bp-legend-dot bp-legend-sys"></view><text class="bp-legend-label">SYS</text></view>
          <view class="bp-legend-item"><view class="bp-legend-dot bp-legend-dia"></view><text class="bp-legend-label">DIA</text></view>
        </view>
        <view class="chart-box" :style="'width:' + bpChartW + 'px;height:200px;'">
          <view v-for="(g, i) in aget(bpChartLayout, 'grid')" :key="'g' + i" class="chart-grid-line"
                :style="'top:' + an(g, 'y') + 'px;left:' + bpN('pL') + 'px;width:' + bpN('plotW') + 'px;'"></view>
          <text v-for="(g, i) in aget(bpChartLayout, 'grid')" :key="'gl' + i" class="chart-grid-label"
                :style="'top:' + (an(g, 'y') - 6) + 'px;'">{{ al(g, 'text') }}</text>
          <view v-for="(p, i) in aget(bpChartLayout, 'sysPts')" :key="'s' + i" class="chart-dot"
                :style="'left:' + (an(p, 'x') - 3) + 'px;top:' + (an(p, 'y') - 3) + 'px;background:#ef4444;'"></view>
          <view v-for="(p, i) in aget(bpChartLayout, 'diaPts')" :key="'d' + i" class="chart-dot"
                :style="'left:' + (an(p, 'x') - 3) + 'px;top:' + (an(p, 'y') - 3) + 'px;background:#6375EC;'"></view>
          <view v-for="(l, i) in aget(bpChartLayout, 'labels')" :key="'l' + i" class="chart-x-label"
                :style="'left:' + (an(l, 'x') - 16) + 'px;top:172px;'">
            <text class="chart-x-label-text">{{ al(l, 'text') }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Privacy consent popup — WeChat's onNeedPrivacyAuthorization path; the native app gets
         OS permission prompts instead. Kept guarded so it never renders in xapp unless a
         caller sets showPrivacyPopup. On Android the waven-ble plugin asks for the Bluetooth
         permissions itself when the adapter opens. -->
    <view v-if="showPrivacyPopup" class="privacy-mask" v-on:click.stop="noop()">
      <view class="privacy-box">
        <text class="privacy-title">{{ isZh ? '隐私保护提示' : 'Privacy Notice' }}</text>
        <text class="privacy-body">{{ isZh ? '为连接您的健康戒指并读取健康数据，需要使用蓝牙权限。请阅读并同意我们的隐私保护指引后继续。' : 'To connect your smart ring and read health data, we need Bluetooth access. Please agree to our privacy policy to continue.' }}</text>
        <view class="privacy-agree-btn" v-on:click="onPrivacyAgree">
          <text class="privacy-agree-txt">{{ isZh ? '同意并继续' : 'Agree & Continue' }}</text>
        </view>
        <view class="privacy-cancel-btn" v-on:click="onPrivacyCancel">
          <text class="privacy-cancel-txt">{{ isZh ? '拒绝' : 'Decline' }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script>
// Ported from miniapp components/user-health/ (user-health.js 4354 lines + wxml + wxss).
// Full logic pass — every method, fetch, formula and comment-documented invariant is kept
// (§34 twin layers, §11 sub-ages, halo-smart-ring.md §9 incremental sleep-block merge,
// §44 insights, §45 ECG/PPG cards, §40 food sensitivity, §17 validated-only data, §20 mood
// avatar, §49 coach view). Deliberate deviations, all marked TODO(port) where they bite:
//
//  - Canvas charts: uni-app x has no wx.createCanvasContext. Every canvas here (BioAge trend,
//    the metric modals, BP chart, weight sparkline) becomes a view-rendered layout computed by
//    the SAME math (toX/toY, min/max+floor/ceil, label steps, crosshair box geometry with the
//    per-char textWidth estimate). Polyline segments/fill areas/dashed glow borders are NOT
//    redrawn — the series renders as dots on a grid. The crosshair drag survives (touch x is
//    clientX minus the modal's known 36px inset because createSelectorQuery().boundingClientRect
//    is unavailable; _cacheChartRect keeps that assumption).
//  - Child components health-documents / strip-record / viva-ag-panel are not ported yet: the
//    mount points render placeholder notes, all props/events/wiring the miniapp passed are kept
//    in comments + the handler methods (closeEcgRecord/onEcgSaved/onEcgDeleted/_onDocsLoaded/
//    onAgGoToChat) exist and are exercised by the preserved state fields.
//  - avatar-picker is the gallery-only xapp port: visible/select/close survive; the miniapp's
//    selected-id/lang/theme/allow-upload/user-id/custom-moods props and customapplied event are
//    TODO(port).
//  - BLE: created via the installed transport (installBleTransport/hasBleTransport,
//    createWearable(brand, transport?=null)). wx.onNeedPrivacyAuthorization is dropped (OS
//    prompts); the privacy popup methods stay, guarded and unreachable unless something sets
//    showPrivacyPopup. Colmi/Aizo sync branches (§18 — not ported to xapp) short-circuit with a
//    fail toast; the Halo/V8 incremental-sync branch is ported 1:1.
//  - WeChat-only surfaces mapped: wx.request→uni.request (RespEnvelope like coach.uvue),
//    wx.storage→uni.storage, show*→uni.*, previewImage/downloadFile/openDocument→uni.*,
//    showActionSheet→uni.showActionSheet (bind picker + 综合报告 list), <picker mode=date>→
//    uni.showDatePicker, setData path-keys→direct field assignment.
//  - `user` prop arrives as a raw object → read through UTSJSONObject helpers.
//  - toLocaleString → a local thousands helper (UTS Number has none).

import { BASE, IS_DEV } from '../../utils/config.uts'
import { state } from '../../utils/state.uts'
import { checkAuthStatus } from '../../utils/session.uts'
import { computeMood, resolveAvatarUrl, DEFAULT_MOOD, MoodRaw } from '../../utils/mood.uts'
import { PinchStepper } from '../../utils/pinch.uts'
import { RespEnvelope } from '../../utils/tool-actions.uts'
import { createWearable, hasBleTransport, getInstalledBleTransport } from '../../utils/wearable/index.uts'
import { HaloRing } from '../../utils/wearable/halo/index.uts'
import { V8Band, V8HrvHistoryItem, V8Spo2Item, V8TempItem, V8StepsSummary } from '../../utils/wearable/v8/index.uts'
import { BleTransport, BleScanDevice } from '../../utils/wearable/transport.uts'
import { BLEManager } from '../../utils/wearable/ble-manager.uts'
import { AutoMonitoringSettings, HALO_NAME_PREFIXES } from '../../utils/wearable/halo/protocol.uts'
import { V8_NAME_PREFIXES } from '../../utils/wearable/v8/protocol.uts'
import { HrLogItem, HrvRecord, Spo2Record, TempLogItem, SleepBlock, SleepNight, StepsSummary, StepSlot, summariseSleepBlocks, cstDateStrToMillis } from '../../utils/wearable/halo/parsers.uts'
import { V8SleepNight, DetailActivityRecord, summariseV8SleepBlocks } from '../../utils/wearable/v8/parsers.uts'
import { WearableSnapshot, syncWearableData, SyncResult } from '../../utils/wearable/sync.uts'
import { flagOutliers, interpolateFlagged, OutlierConfig, SeriesPoint } from '../../utils/wearable/signal-smoothing.uts'
import AvatarPicker from '../avatar-picker/avatar-picker.uvue'
import HealthDocuments from '../health-documents/health-documents.uvue'
import StripRecord from '../strip-record/strip-record.uvue'
import VivaAgPanel from '../viva-ag-panel/viva-ag-panel.uvue'

const BM_META : UTSJSONObject[] = [
  { key: 'hsCRP', unit: 'mg/L', color: '#f472b6' } as UTSJSONObject,
  { key: 'GDF15', unit: 'pg/mL', color: '#fb7185' } as UTSJSONObject,
  { key: 'IL6', unit: 'pg/mL', color: '#a855f7' } as UTSJSONObject,
  { key: 'GA', unit: '%', color: '#6375EC' } as UTSJSONObject,
  { key: 'CystatinC', unit: 'mg/L', color: '#0ea5e9' } as UTSJSONObject,
  { key: 'CD38', unit: 'xBaseline', color: '#e879f9' } as UTSJSONObject,
]

const SUB_AGE_META : UTSJSONObject[] = [
  { key: 'ResilienceAge', color: '#c084d4' } as UTSJSONObject,
  { key: 'CellularAge', color: '#10b981' } as UTSJSONObject,
  { key: 'MetabolicAge', color: '#6375EC' } as UTSJSONObject,
  { key: 'MicroVascularAge', color: '#0ea5e9' } as UTSJSONObject,
]

const SUB_AGE_KEYS : string[] = SUB_AGE_META.map((m) : string => m.getString('key')!)

// health_events.source values that represent a real BP-device reading the user supplied
// themselves. Ring-derived sources ('smart_ring') are excluded — the Halo ring estimates BP
// from HRV pulse-wave data, not a cuff, and is not accurate until calibrated.
const USER_UPLOADED_BP_SOURCES : Set<string> = new Set(['manual_photo'])

function buildSubAgeLabels(base : UTSJSONObject, overrides : UTSJSONObject | null, lang : string) : UTSJSONObject {
  if (overrides == null) return base
  const result = { } as UTSJSONObject
  base.toMap().forEach((v : any | null, k : string) => { result[k] = v })
  for (const key of SUB_AGE_KEYS) {
    const o = overrides!.getJSON(key)
    if (o == null) continue
    const override = o!.getString(lang)
    if (override != null && override!.trim().length > 0) result[key] = override!.trim()
  }
  return result
}

const CONDITION_KEYS : string[] = [
  'blood_sugar_high', 'blood_pressure_high', 'blood_lipids_high',
  'cholesterol_high', 'heart_issues', 'gout_uric_acid',
  'kidney_disease', 'sleep_deficiency', 'other',
]

