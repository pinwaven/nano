.ins-card { background-color: rgba(15, 37, 64, 0.35); border-style: solid; border-width: 1px; border-color: rgba(99, 117, 236, 0.14); border-radius: 10px; padding: 11px 10px 9px; margin: 10px 0px 10px 0px; }
.ins-head { flex-direction: column; align-items: stretch; justify-content: flex-start; margin: 0px 0px 8px 0px; }
.ins-title { color: rgb(238, 242, 255); font-size: 14px; font-weight: bold; }
