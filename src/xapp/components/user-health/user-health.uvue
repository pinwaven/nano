.ins-readiness { flex-direction: row; align-items: center; color: rgb(238, 242, 255); margin: 0px 0px 9px 0px; }
.ins-score-wrap { width: 62px; height: 62px; border-radius: 31px; border-style: solid; border-width: 2px; align-items: baseline; justify-content: center; flex-direction: row; padding: 17px 0px 0px 0px; }
