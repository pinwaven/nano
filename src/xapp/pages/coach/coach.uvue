<template>
  <!-- #ifdef WEB -->
  <!-- Web: the miniapp's pages/coach markup (the web user-app's generated coach View), styled by
       the shared stylesheet in static/web/ (.web-coach scope). Native keeps its layout below. -->
  <view class="web-coach">
  <view class="coach-page" :class="['fs-' + textScale, theme == 'light' ? 'theme-light' : '']">
    <view class="status-bar-spacer"></view>

    <view class="app-header" v-on:click="openUserPanel">
      <view class="header-logo-btn">
        <image class="header-logo-img" :src="channelLogo" mode="aspectFit" />
        <text class="header-title">{{ channelName }}</text>
      </view>
      <view class="header-divider"></view>
      <text class="header-user">{{ nickname }} ({{ tr('coachLabel') }})</text>
    </view>

    <view v-if="sandboxMode" class="sandbox-banner" v-on:click.stop="exitSandbox">
      <text class="sandbox-banner-text">{{ sandboxBannerText }}</text>
      <text class="sandbox-banner-exit">{{ tr('exitSandbox') }}</text>
    </view>

    <scroll-view direction="vertical" class="coach-content" :refresher-enabled="tab == 'clients'" v-on:refresherrefresh="onClientsRefresh">

      <view v-if="loading" class="loading-row"><text class="loading-text">{{ tr('loading') }}</text></view>

      <view v-else-if="tab == 'clients'" class="client-list">
        <view v-if="mcEnabled" class="invite-generate-btn" v-on:click="openManagedForm('')">
          <text class="invite-generate-text">{{ tr('mc.add') }}</text>
        </view>
        <view class="clients-search-wrap">
          <view class="clients-search-bar">
            <text class="search-icon-txt">🔍</text>
            <input class="clients-search-input" :placeholder="tr('searchPlaceholder')" v-model="clientSearch" confirm-type="search" />
            <view v-if="clientSearch.length > 0" class="search-clear-btn" v-on:click.stop="clientSearch = ''">
              <text class="search-clear-icon">✕</text>
            </view>
          </view>
        </view>
        <scroll-view v-if="clientFilterStages.length > 0" direction="horizontal" class="stage-filter-scroll">
          <view class="stage-filter-inner">
            <view class="stage-chip" :class="clientStageFilter == '' ? 'stage-chip-active' : ''" v-on:click.stop="setStageFilter('')">
              <text class="stage-chip-text">{{ tr('filterAll') }}</text>
            </view>
            <view v-for="(st, si) in clientFilterStages" :key="si" class="stage-chip"
                  :class="clientStageFilter == st.getString('stage') ? 'stage-chip-colored' : ''"
                  :style="clientStageFilter == st.getString('stage') ? ('border-color:' + st.getString('color') + '; background:' + st.getString('color') + '22;') : ''"
                  v-on:click.stop="setStageFilter(`${st.getString('stage')}`)">
              <text class="stage-chip-text" :style="clientStageFilter == st.getString('stage') ? ('color:' + st.getString('color') + ';') : ''">{{ st.getString('label') }}</text>
              <text class="stage-chip-count">{{ st['count'] }}</text>
            </view>
          </view>
        </scroll-view>
        <view v-if="clientSearch.length > 0 || clientStageFilter.length > 0" class="search-result-row">
          <text class="search-result-txt">{{ filteredClients.length }} / {{ clients.length }}</text>
        </view>

        <view v-if="filteredClients.length == 0" class="empty-state">
          <text v-if="clientsLoadState == 'no_coach'" class="empty-text">{{ tr('noCoachSession') }}</text>
          <text v-else-if="clientsLoadState == 'failed'" class="empty-text">{{ tr('clientsLoadFailed') }}</text>
          <text v-else-if="clients.length == 0" class="empty-text">{{ tr('noClients') }}</text>
          <text v-else class="empty-text">{{ tr('noMatchClients') }}</text>
          <view v-if="clientsLoadState.length > 0" class="empty-retry" v-on:click.stop="handleRefresh">
            <text class="empty-retry-txt">{{ tr('retryLoad') }}</text>
          </view>
          <text v-if="diagText.length > 0" class="empty-diag">{{ diagText }}</text>
        </view>
        <view v-for="(item, ci) in filteredClients" :key="ci" class="client-card">
          <view class="client-row" v-on:click="openClientDetailFor(item, 'health')">
            <view class="client-avatar" :style="(item.getString('avatar_url') ?? '').length > 0 ? '' : 'background: #1E3A5F;'">
              <image v-if="(item.getString('avatar_url') ?? '').length > 0" class="client-avatar-img" :src="item.getString('avatar_url')" mode="aspectFill" />
              <text v-else class="avatar-letter">{{ item.getString('_avatar') }}</text>
            </view>
            <view class="client-info">
              <view class="client-name-row">
                <text class="client-name">{{ item.getString('nickname') ?? '—' }}</text>
                <view v-if="item.getString('account_type') == 'managed'" class="mc-badge"><text class="mc-badge-text">{{ tr('mc.badge') }}</text></view>
              </view>
              <view class="client-ages">
                <view v-if="item.getNumber('_cAge') != null" class="age-chip">
                  <text class="age-chip-text">{{ tr('chronoAge') }} {{ item.getNumber('_cAge') }}</text>
                </view>
                <view v-if="item['bio_age'] != null" class="age-chip" :style="'background: ' + item.getString('_bioAgeColor') + '20; border-color: ' + item.getString('_bioAgeColor') + ';'">
                  <text class="age-chip-text" :style="'color: ' + item.getString('_bioAgeColor') + ';'">{{ tr('bioAge') }} {{ item['bio_age'] }}</text>
                </view>
              </view>
              <text v-if="item.getBoolean('_hasScan') == true" class="client-meta client-meta-dim">{{ tr('lastScan') }}: {{ item.getString('_lastScanFmt') }}</text>
              <text v-else class="client-meta client-meta-dim">{{ tr('joined') }}: {{ item.getString('_joinedFmt') }}</text>
            </view>
          </view>

          <view v-if="item.getJSON('_crmStagePill') != null || (item.getArray<UTSJSONObject>('_crmTags') ?? []).length > 0" class="crm-meta-row">
            <view v-if="item.getJSON('_crmStagePill') != null" class="stage-pill" :style="'background: ' + item.getJSON('_crmStagePill')!.getString('color') + '22; border-color: ' + item.getJSON('_crmStagePill')!.getString('color') + ';'">
              <text class="stage-pill-text" :style="'color: ' + item.getJSON('_crmStagePill')!.getString('color') + ';'">{{ item.getJSON('_crmStagePill')!.getString('label') }}</text>
            </view>
            <view v-for="(tg, ti) in (item.getArray<UTSJSONObject>('_crmTags') ?? [])" :key="ti" class="tag-chip" :style="'background: ' + tg.getString('color_hex') + '22; border-color: ' + tg.getString('color_hex') + ';'">
              <text class="tag-chip-text" :style="'color: ' + tg.getString('color_hex') + ';'">{{ tg.getString('name') }}</text>
            </view>
          </view>

          <view v-if="item.getString('_lastUserMsg') != null" class="last-msg-strip">
            <text v-if="item.getString('_lastMsgTimeFmt') != null" class="last-msg-time">{{ item.getString('_lastMsgTimeFmt') }}</text>
            <text class="last-msg-text">{{ item.getString('_lastUserMsg') }}</text>
          </view>

          <view class="client-actions">
            <view class="action-btn msg-btn" v-on:click.stop="openClientDetailFor(item, 'chat')"><text class="action-btn-text">{{ tr('openMessages') }}</text></view>
            <view class="action-btn remind-icon-btn" v-on:click.stop="openQResponsesFor(item)"><text class="action-btn-text">📋</text></view>
            <view class="action-btn remind-icon-btn" v-on:click.stop="openReminderFor(item)"><text class="action-btn-text">⏰</text></view>
          </view>
        </view>
      </view>

      <view v-else-if="tab == 'invites'" class="client-list">
        <view class="invite-generate-btn" v-on:click="generateInvite"><text class="invite-generate-text">+ {{ tr('invite.generate') }}</text></view>
        <view v-if="invites.length == 0" class="empty-state"><text class="empty-text">{{ tr('invite.noInvites') }}</text></view>
        <view v-for="(iv, ii) in invites" :key="ii" class="client-card">
          <view class="invite-code-row">
            <text class="invite-code">{{ iv.getString('code') }}</text>
            <view class="invite-status" :class="iv.getBoolean('is_active') == true ? 'invite-active' : 'invite-inactive'">
              <text class="invite-status-text">{{ iv.getBoolean('is_active') == true ? tr('invite.active') : tr('invite.inactive') }}</text>
            </view>
          </view>
          <view class="invite-note-row" v-on:click.stop="editInviteNote(ii)">
            <text class="invite-note" :class="(iv.getString('note') ?? '').length > 0 ? '' : 'invite-note-empty'">{{ (iv.getString('note') ?? '').length > 0 ? iv.getString('note') : tr('invite.noNote') }}</text>
            <text class="invite-note-edit">✎</text>
          </view>
          <text class="invite-uses">{{ tr('invite.uses') }}: {{ iv['use_count'] ?? 0 }}</text>
          <view class="client-actions" style="margin-top: 12px;">
            <view class="action-btn msg-btn" v-on:click.stop="copyInvite(ii)"><text class="action-btn-text">{{ tr('invite.copy') }}</text></view>
            <view v-if="iv.getBoolean('is_active') == true" class="action-btn deact-btn" v-on:click.stop="deactivateInvite(ii)"><text class="action-btn-text deact-text">{{ tr('invite.deactivate') }}</text></view>
          </view>
        </view>
      </view>

      <view v-else-if="tab == 'earnings'" class="client-list">
        <view v-if="earningsLoading" class="loading-row"><text class="loading-text">{{ tr('loading') }}</text></view>
        <view v-else>
          <view class="earnings-cards">
            <view class="earnings-card">
              <text class="earnings-card-label">{{ tr('earnings.thisMonth') }}</text>
              <text class="earnings-card-value">{{ earningsThisMonth == '—' ? '¥0.00' : earningsThisMonth }}</text>
            </view>
            <view class="earnings-card earnings-card-green">
              <text class="earnings-card-label">{{ tr('earnings.available') }}</text>
              <text class="earnings-card-value">{{ earningsAvailable == '—' ? '¥0.00' : earningsAvailable }}</text>
            </view>
          </view>
          <text class="section-label" style="margin: 16px 16px 8px;">{{ tr('earnings.payoutHistory') }}</text>
          <view v-if="earningsPayouts.length == 0" class="empty-state"><text class="empty-text">{{ tr('earnings.noPayouts') }}</text></view>
          <view v-for="(po, pi) in earningsPayouts" :key="pi" class="client-card">
            <view class="invite-code-row">
              <text class="invite-code">{{ po.getString('period') ?? po.getString('period_start') }}</text>
              <view class="invite-status" :class="po.getString('status') == 'transferred' ? 'invite-active' : 'invite-inactive'">
                <text class="invite-status-text">{{ po.getString('_statusFmt') }}</text>
              </view>
            </view>
            <text class="invite-uses">{{ tr('earnings.amount') }}: {{ po.getString('_amountFmt') }}</text>
          </view>
        </view>
      </view>

      <view v-else-if="tab == 'questionnaires'" class="client-list">
        <view v-if="questionnairesLoading" class="loading-row"><text class="loading-text">{{ tr('loading') }}</text></view>
        <view v-else-if="questionnaires.length == 0" class="empty-state"><text class="empty-text">{{ tr('questionnaires.noQuestionnaires') }}</text></view>
        <view v-else>
          <view v-for="(qn, qi) in questionnaires" :key="qi" class="client-card">
            <view class="q-card-header">
              <view class="q-card-info">
                <text class="q-card-name">{{ lang == 'zh' ? (qn.getString('name_zh') ?? qn.getString('name')) : qn.getString('name') }}</text>
                <text v-if="(qn.getString('description_zh') ?? qn.getString('description') ?? '').length > 0" class="q-card-desc">{{ lang == 'zh' ? (qn.getString('description_zh') ?? qn.getString('description')) : (qn.getString('description') ?? qn.getString('description_zh')) }}</text>
                <view class="invite-status invite-active q-type-badge">
                  <text class="invite-status-text">{{ qn.getString('type') == 'onboarding' ? (lang == 'zh' ? '入门' : 'Onboarding') : (lang == 'zh' ? '自定义' : 'Custom') }}</text>
                </view>
              </view>
              <view class="action-btn msg-btn q-assign-btn" v-on:click="openQAssign(qi)"><text class="action-btn-text">{{ tr('questionnaires.assign') }}</text></view>
            </view>
          </view>
        </view>
      </view>

      <view v-else-if="tab == 'crm'" class="crm-tab">
        <view v-if="crmLoading" class="panel-center"><text class="loading-text">{{ tr('loading') }}</text></view>
        <view v-else>
          <view class="crm-section-header"><text class="crm-section-title">{{ tr('crmPipeline') }}</text></view>
          <scroll-view direction="horizontal" class="pipeline-kanban">
            <view v-for="(col, coi) in crmPipelineColumns" :key="coi" class="pipeline-col">
              <view class="pipeline-col-header" :style="'border-color: ' + col.getString('color') + ';'">
                <text class="pipeline-col-title" :style="'color: ' + col.getString('color') + ';'">{{ col.getString('label') }}</text>
                <view class="pipeline-col-badge" :style="'background: ' + col.getString('color') + '33;'">
                  <text class="pipeline-col-count" :style="'color: ' + col.getString('color') + ';'">{{ (col.getArray<UTSJSONObject>('clients') ?? []).length }}</text>
                </view>
              </view>
              <view v-for="(cl, cli) in (col.getArray<UTSJSONObject>('clients') ?? [])" :key="cli" class="pipeline-card"
                    v-on:click.stop="openClientDetailFor(cl, 'health')" v-on:longpress="openStagePicker(cl)">
                <text class="pipeline-card-name">{{ cl.getString('nickname') ?? '—' }}</text>
                <text v-if="cl.getNumber('bio_age') != null && cl.getNumber('_cAge') != null" class="pipeline-card-delta" :class="cl.getNumber('bio_age')! <= cl.getNumber('_cAge')! ? 'delta-good' : 'delta-bad'">{{ cl.getNumber('bio_age')! <= cl.getNumber('_cAge')! ? '-' : '+' }}{{ Math.abs(cl.getNumber('bio_age')! - cl.getNumber('_cAge')!).toFixed(1) }}yr</text>
              </view>
            </view>
          </scroll-view>

          <view class="crm-section-header">
            <text class="crm-section-title">{{ tr('crmAppointments') }}</text>
            <view class="crm-section-btn" v-on:click.stop="openApptForm(null)"><text class="crm-section-btn-text">{{ tr('newAppt') }}</text></view>
          </view>
          <view v-if="crmUpcomingAppts.length == 0" class="panel-center-sm"><text class="empty-text-sm">{{ tr('noAppointments') }}</text></view>
          <view v-for="(ap, api) in crmUpcomingAppts" :key="api" class="appt-card">
            <view class="appt-format-badge"><text class="appt-format-text">{{ tr('apptFormats.' + (ap.getString('format') ?? '')) }}</text></view>
            <view class="appt-info">
              <text class="appt-title">{{ ap.getString('title') }}</text>
              <text class="appt-client">{{ ap.getString('nickname') }}</text>
              <text class="appt-time">{{ ap.getString('_timeFmt') }}</text>
            </view>
          </view>

          <view class="crm-section-header"><text class="crm-section-title">{{ tr('crmActivity') }}</text></view>
          <view v-if="crmActivityFeed.length == 0" class="panel-center-sm"><text class="empty-text-sm">{{ tr('noActivity') }}</text></view>
          <view v-for="(af, afi) in crmActivityFeed" :key="afi" class="activity-item">
            <view class="activity-dot"></view>
            <view class="activity-content">
              <text class="activity-label">{{ af.getString('nickname') ?? af.getString('client_name') }} · {{ af.getString('_label') }}</text>
              <text class="activity-time">{{ af.getString('_timeFmt') }}</text>
            </view>
          </view>

          <view class="crm-section-header" style="margin-top: 12px;"><text class="crm-section-title">{{ tr('kpiTitle') }}</text></view>
          <view v-if="kpiLoading" class="panel-center-sm"><text class="loading-text">{{ tr('loading') }}</text></view>
          <view v-else-if="kpiData != null">
            <view class="kpi-grid">
              <view class="kpi-card"><text class="kpi-value">{{ kpiField('total_clients') }}</text><text class="kpi-label">{{ tr('kpiClients') }}</text></view>
              <view class="kpi-card kpi-card-green"><text class="kpi-value">{{ kpiField('active_clients') }}</text><text class="kpi-label">{{ tr('kpiActive') }}</text></view>
              <view class="kpi-card kpi-card-orange"><text class="kpi-value">{{ kpiField('at_risk_count') }}</text><text class="kpi-label">{{ tr('kpiAtRisk') }}</text></view>
              <view class="kpi-card"><text class="kpi-value">¥{{ kpiField('commission_cny') }}</text><text class="kpi-label">{{ tr('kpiCommission') }}</text></view>
              <view class="kpi-card"><text class="kpi-value">{{ kpiField('scans_facilitated') }}</text><text class="kpi-label">{{ tr('kpiScans') }}</text></view>
              <view class="kpi-card kpi-card-blue"><text class="kpi-value">{{ kpiField('avg_nps_score') }}</text><text class="kpi-label">{{ tr('kpiNps') }}</text></view>
            </view>
            <view class="crm-section-header"><text class="crm-section-title">{{ tr('topImprovers') }}</text></view>
            <view v-if="topImprovers.length == 0" class="panel-center-sm"><text class="empty-text-sm">—</text></view>
            <view v-for="(im, imi) in topImprovers" :key="imi" class="improver-row">
              <view class="improver-avatar"><text class="avatar-letter">{{ im.getString('_avatar') }}</text></view>
              <text class="improver-name">{{ im.getString('nickname') }}</text>
              <text class="improver-delta" :class="(im.getNumber('delta') ?? 0) <= 0 ? 'delta-good' : 'delta-bad'">{{ (im.getNumber('delta') ?? 0) > 0 ? '+' : '' }}{{ im.getNumber('delta') }}yr</text>
            </view>
          </view>
        </view>
      </view>

    </scroll-view>

    <!-- Bottom tab bar -->
    <view class="tab-bar">
      <view v-for="(tk, tki) in tabKeys" :key="tki" class="tab-btn" :class="tab == tk ? 'tab-active' : ''" v-on:click="switchTab(tk)">
        <view v-if="tab == tk" class="tab-line"></view>
        <image class="tab-icon-img" :src="'/static/icons/' + tk + '.svg'" mode="aspectFit" />
        <text class="tab-label">{{ tr('tabs.' + tk) }}</text>
      </view>
    </view>

    <!-- Managed customer form (create / edit) -->
    <view v-if="mcFormOpen" class="overlay-mask mc-mask">
      <view class="overlay-panel mc-form-panel" v-on:click.stop="noop">
        <view class="overlay-header">
          <text class="overlay-title">{{ mcEditId.length > 0 ? tr('mc.titleEdit') : tr('mc.titleNew') }}</text>
          <view class="overlay-close" v-on:click="closeManagedForm"><text class="close-x">✕</text></view>
        </view>
        <scroll-view direction="vertical" class="overlay-scroll mc-form-scroll">
          <view class="mc-form-body">
            <view class="mc-note"><text class="mc-note-text">{{ tr('mc.note') }}</text></view>
            <view class="mc-name-row">
              <view class="form-row"><text class="form-label">{{ tr('mc.lastName') }}</text><input class="form-input" v-model="mcLast" /></view>
              <view class="form-row"><text class="form-label">{{ tr('mc.firstName') }}</text><input class="form-input" v-model="mcFirst" /></view>
            </view>
            <view class="form-row"><text class="form-label">{{ tr('mc.nickname') }}</text><input class="form-input" :placeholder="tr('mc.nicknameHint')" v-model="mcNickname" /></view>
            <picker mode="date" :value="mcBirthDate.length > 0 ? mcBirthDate : '1970-01-01'" v-on:change="onMcBirthDateChange">
              <view class="form-row">
                <text class="form-label">{{ tr('mc.birthDate') }} *</text>
                <view class="mc-picker-control"><text class="form-value">{{ mcBirthDate.length > 0 ? mcBirthDate : tr('mc.selectDate') }}</text><text class="mc-picker-arrow">⌄</text></view>
              </view>
            </picker>
            <view class="form-row" v-on:click="pickMcGender">
              <text class="form-label">{{ tr('mc.gender') }} *</text>
              <view class="mc-picker-control"><text class="form-value">{{ mcGender == 'male' ? tr('mc.genders0') : (mcGender == 'female' ? tr('mc.genders1') : tr('mc.selectGender')) }}</text><text class="mc-picker-arrow">⌄</text></view>
            </view>
            <view class="form-row"><text class="form-label">{{ tr('mc.phone') }}</text><input class="form-input" type="number" :maxlength="11" v-model="mcPhone" /></view>
            <view class="form-row"><text class="form-label">{{ tr('mc.ref') }}</text><input class="form-input" :placeholder="tr('mc.refHint')" v-model="mcRef" /></view>
          </view>
        </scroll-view>
        <view class="overlay-footer">
          <view class="overlay-cancel-btn" v-on:click="closeManagedForm"><text>{{ tr('mc.cancel') }}</text></view>
          <view class="overlay-confirm-btn" :class="mcBusy ? 'btn-busy' : ''" v-on:click="submitManagedForm"><text>{{ mcBusy ? '…' : tr('mc.save') }}</text></view>
        </view>
      </view>
    </view>

    <!-- Managed customer: order with a redeem code -->
    <view v-if="redeemOpen" class="overlay-mask mc-mask">
      <view class="overlay-panel" v-on:click.stop="noop">
        <view class="overlay-header">
          <text class="overlay-title">{{ tr('mc.redeemTitle') }}</text>
          <view class="overlay-close" v-on:click="closeRedeemForm"><text class="close-x">✕</text></view>
        </view>
        <scroll-view direction="vertical" class="overlay-scroll">
          <view class="mc-note"><text class="mc-note-text">{{ tr('mc.redeemHint') }}</text></view>
          <view class="form-row"><text class="form-label">{{ tr('mc.redeemCode') }}</text><input class="form-input" v-model="redeemCode" /></view>
          <view class="form-row"><text class="form-label">{{ tr('mc.redeemName') }}</text><input class="form-input" v-model="redeemName" /></view>
          <view class="form-row"><text class="form-label">{{ tr('mc.redeemPhone') }}</text><input class="form-input" type="number" :maxlength="11" v-model="redeemPhone" /></view>
          <view class="form-row"><text class="form-label">{{ tr('mc.redeemAddress') }}</text><input class="form-input" v-model="redeemAddress" /></view>
        </scroll-view>
        <view class="overlay-footer">
          <view class="overlay-cancel-btn" v-on:click="closeRedeemForm"><text>{{ tr('mc.cancel') }}</text></view>
          <view class="overlay-confirm-btn" :class="redeemBusy ? 'btn-busy' : ''" v-on:click="submitRedeem"><text>{{ redeemBusy ? '…' : tr('mc.redeemSubmit') }}</text></view>
        </view>
      </view>
    </view>

    <!-- Client detail sheet -->
    <view v-if="detailOpen && detailClient != null" class="overlay-mask">
      <view class="overlay-panel" v-on:click.stop="noop">
        <view class="overlay-header">
          <text class="overlay-title">{{ detailClient!.getString('nickname') ?? tr('detailTitle') }}</text>
          <view v-if="detailIsManaged" class="mc-edit-btn" v-on:click="openManagedFormEdit"><text class="mc-edit-text">{{ tr('mc.edit') }}</text></view>
          <view class="overlay-close" v-on:click="closeClientDetail"><text class="close-x">✕</text></view>
        </view>

        <view class="detail-tabs">
          <view v-for="(dt, dti) in detailTabOrder" :key="dti" class="detail-tab" :class="detailTab == dt ? 'detail-tab-active' : ''" v-on:click="switchDetailTab(dt)">
            <text class="detail-tab-text">{{ detailTabLabel(dt) }}</text>
          </view>
        </view>

        <view v-if="detailTab == 'health'" class="overlay-scroll">
          <user-health :userId="detailClient!.getString('user_id') ?? ''" :user="detailClient" :lang="lang" mode="coach"
            :coachId="coachId" :theme="theme" :textScale="textScale" v-on:profileUpdated="onClientProfileUpdated" />
        </view>

        <scroll-view v-if="detailTab == 'plans'" direction="vertical" class="overlay-scroll">
          <view v-if="detailPlansLoading" class="panel-center"><text class="loading-text">{{ tr('loading') }}</text></view>
          <view v-else>
            <view class="plans-coach-header"><text class="plans-coach-title">{{ tr('clientPlans') }}</text></view>
            <view v-if="detailPlans.length == 0" class="panel-center"><text class="empty-text">{{ tr('noClientPlans') }}</text></view>
            <view v-for="(pl, pli) in detailPlans" :key="pli" class="coach-plan-card">
              <view class="coach-plan-badge" :class="'coach-plan-' + (pl.getString('plan_type') ?? '')">
                <text>{{ pl.getString('plan_type') == 'primary' ? tr('planPrimary') : tr('planSecondary') }}</text>
              </view>
              <text class="coach-plan-name">{{ lang == 'zh' ? (pl.getString('name_zh') ?? pl.getString('custom_name_zh')) : (pl.getString('name_en') ?? pl.getString('custom_name_en')) }}</text>
              <text class="coach-plan-meta">{{ pl['checkin_count'] ?? 0 }} {{ tr('planCheckins') }} · {{ pl['duration_weeks'] }}{{ tr('planWeeks') }}</text>
            </view>

            <view class="plans-coach-header"><text class="plans-coach-title">{{ tr('clientPrograms') }}</text></view>
            <view v-if="detailPrograms.length == 0" class="panel-center"><text class="empty-text">{{ tr('noClientPrograms') }}</text></view>
            <view v-for="(pg, pgi) in detailPrograms" :key="pgi" class="coach-plan-card coach-program-card">
              <view class="coach-program-main">
                <view class="coach-plan-badge" :class="'coach-program-' + (pg.getString('status') ?? '')"><text>{{ pg.getString('statusLabel') }}</text></view>
                <text class="coach-plan-name">{{ lang == 'zh' ? pg.getString('title_zh') : (pg.getString('title_en') ?? pg.getString('title_zh')) }}</text>
                <text class="coach-plan-meta" :class="pg.getBoolean('stalled') == true ? 'coach-program-stalled' : ''">{{ pg['duration_days'] }} {{ tr('programDays') }}{{ (pg.getString('progressLabel') ?? '').length > 0 ? ' · ' + pg.getString('progressLabel') : '' }}</text>
              </view>
              <view v-if="(pg.getString('action') ?? '').length > 0" class="coach-program-btn" :class="pg.getString('action') == 'pause' ? 'secondary' : ''" v-on:click="handleProgramAction(pg.getNumber('id'), `${pg.getString('action')}`)">
                <text>{{ programActionBusy ? tr('loading') : pg.getString('actionLabel') }}</text>
              </view>
            </view>

            <view class="plans-coach-actions">
              <view class="coach-action-btn" v-on:click="openPlanRecommend"><text>{{ tr('recommendPlan') }}</text></view>
              <view class="coach-action-btn secondary" v-on:click="openPlanCustom"><text>{{ tr('createCustomPlan') }}</text></view>
            </view>

            <view v-if="planRecommendOpen" class="plans-recommend-sheet">
              <view class="plans-recommend-header">
                <text class="plans-recommend-title">{{ tr('recommendPlan') }}</text>
                <view v-on:click="closePlanRecommend" class="close-x-btn"><text>✕</text></view>
              </view>
              <view v-for="(tpl, tpi) in planTemplates" :key="tpi" class="recommend-tpl-card" v-on:click="handleRecommendPlan(tpl.getNumber('id'))">
                <text class="recommend-tpl-name">{{ lang == 'zh' ? tpl.getString('name_zh') : tpl.getString('name_en') }}</text>
                <text class="recommend-tpl-meta">{{ tpl['duration_weeks'] }}{{ tr('planWeeks') }} · {{ tpl.getString('sub_ages_display') }}</text>
              </view>
            </view>

            <view v-if="planCustomOpen" class="plans-custom-form">
              <view class="plans-recommend-header">
                <text class="plans-recommend-title">{{ tr('createCustomPlan') }}</text>
                <view v-on:click="closePlanCustom" class="close-x-btn"><text>✕</text></view>
              </view>
              <view class="form-field"><text class="form-label">{{ tr('customPlanName') }}</text><input class="form-input" v-model="planCustomName" :placeholder="tr('customPlanName')" /></view>
              <view class="form-field"><text class="form-label">{{ tr('customPlanGoal') }}</text><input class="form-input" v-model="planCustomGoal" :placeholder="tr('customPlanGoal')" /></view>
              <view class="coach-action-btn" v-on:click="handleCreateCustomPlan"><text>{{ planActionBusy ? tr('loading') : tr('createCustomPlan') }}</text></view>
            </view>
          </view>
        </scroll-view>

        <!-- Chat: the web user-app's coach mode of its ChatTab — the main chat's markup and
             cards (display-only: a coach can't order for the client), the coach actions as
             pills and the main input bar. -->
        <view v-if="detailTab == 'chat'" class="chat-panel">
          <view class="coach-chat-mount">
            <view class="chat-tab coach-client-chat">
              <scroll-view direction="vertical" class="chat-messages chat-scroll" :scroll-top="chatScrollTop" :scroll-with-animation="true">
                <view class="chat-inner">
                  <view v-if="chatLoading" class="chat-history-load chat-history-loading"><text class="chat-history-text">{{ tr('loading') }}</text></view>
                  <view v-else-if="chatMessages.length > 0" class="chat-history-start"><text class="chat-history-start-text">{{ mt('chatHistoryStart') }}</text></view>
                  <view v-else class="chat-history-start"><text class="chat-history-start-text">{{ tr('noChatData') }}</text></view>
                  <view v-for="(cm, cmi) in chatMessages" :key="cmi">
                    <view class="msg-row" :class="cm.getString('role') == 'user' ? 'msg-row-user' : 'msg-row-ai'">
                      <view v-if="cm.getString('role') == 'coach'" class="message-bubble message-coach">
                        <text class="msg-coach-label">Coach</text>
                        <text class="msg-text">{{ cm.getString('content') }}</text>
                      </view>
                      <view v-else class="message-bubble" :class="cm.getString('role') == 'user' ? 'message-user' : 'message-ai'">
                        <image v-if="(cm.getString('imageUrl') ?? cm.getString('image_url') ?? '').length > 0" class="msg-image msg-image-inset" :src="cm.getString('imageUrl') ?? cm.getString('image_url')" mode="widthFix" />
                        <text v-if="cm.getString('role') == 'user' && (cm.getString('content') ?? '').length > 0" class="msg-text">{{ cm.getString('content') }}</text>
                        <text v-if="cm.getString('source') == 'viva_ag'" class="msg-ag-label">Viva AG</text>
                        <view v-if="cm.getString('role') != 'user'" v-for="(seg, si) in segsOf(cm)" :key="si" class="msg-seg">
                          <rich-text v-if="seg.t == 'html'" class="msg-html" :nodes="sh(seg.h)" />
                          <view v-else-if="seg.t == 'rule'" class="msg-rule"></view>
                          <view v-else-if="seg.t == 'metric'" class="mcard">
                            <view v-for="(item, mj) in seg.metricItems" :key="mj" class="mcard-tile" :class="'mcard-' + item.s">
                              <text class="mcard-label">{{ item.label }}</text>
                              <view class="mcard-valrow">
                                <text class="mcard-val">{{ item.value }}</text>
                                <text v-if="item.unit.length > 0" class="mcard-unit">{{ item.unit }}</text>
                              </view>
                              <view v-if="item.sl.length > 0" class="mcard-footrow"><text class="mcard-pill">{{ item.sl }}</text></view>
                            </view>
                          </view>
                          <view v-else-if="seg.t == 'takeaway'" class="tcard">
                            <text class="tcard-title">{{ seg.takeaway != null && seg.takeaway!.title.length > 0 ? seg.takeaway!.title : mt('mdTakeaway') }}</text>
                            <rich-text class="msg-html tcard-body" :nodes="sh(seg.takeaway != null ? seg.takeaway!.h : '')" />
                          </view>
                          <view v-else-if="seg.t == 'dots'" class="dcard">
                            <view v-for="(di, dj) in seg.dotItems" :key="dj" class="dcard-chip">
                              <text class="dcard-id">{{ di.id }}</text>
                              <text v-if="di.name.length > 0" class="dcard-name">{{ di.name }}</text>
                              <text v-if="di.note.length > 0" class="dcard-note">{{ di.note }}</text>
                            </view>
                          </view>
                          <view v-else-if="seg.t == 'formula'" class="fcard">
                            <view class="fcard-head">
                              <text class="fcard-title">{{ mt('formulaCardTitle') }}</text>
                              <text class="fcard-note">{{ mt('formulaEvalNote') }}</text>
                            </view>
                            <view v-for="(ft, fti) in seg.formulaTiers" :key="fti" class="fcard-tier" :class="ft.open ? 'fcard-tier-open' : ''">
                              <view v-if="ft.label.length > 0" class="fcard-tier-head" v-on:click="toggleFormulaTier(ft)">
                                <view class="fcard-tier-name">
                                  <text class="fcard-tier-label">{{ ft.label }}</text>
                                  <text v-if="ft.recommended" class="fcard-tier-rec">{{ mt('formulaTierRecommended') }}</text>
                                </view>
                                <text class="fcard-tier-chev">{{ ft.open ? '⌃' : '⌄' }}</text>
                              </view>
                              <view v-if="ft.note.length > 0" class="fcard-tier-note" v-on:click="toggleFormulaTier(ft)"><text>{{ ft.note }}</text></view>
                              <view v-if="!ft.open" class="fcard-legend fcard-tier-dots" v-on:click="toggleFormulaTier(ft)">
                                <view v-for="(fd, fdk) in ft.dots" :key="fdk" class="fcard-leg">
                                  <view class="fcard-swatch" :style="'background:' + fd.color"></view>
                                  <text class="fcard-leg-name">{{ fd.name }}</text>
                                </view>
                              </view>
                              <view v-if="ft.open">
                                <view v-for="(fg, fgi) in ft.groups" :key="fgi" class="fcard-group">
                                  <view v-if="fg.days.length > 0" class="fcard-days">
                                    <text class="fcard-daylabel">{{ mt('formulaDayWord') }} {{ fg.days }}</text>
                                    <text v-if="fg.kind == 'n7'" class="fcard-daytag">{{ mt('formulaResetDay') }}</text>
                                  </view>
                                  <view class="fcard-row">
                                    <text class="fcard-slot">{{ mt('formulaAm') }}</text>
                                    <view class="fcard-track"><view v-for="(fi, fk) in fg.items" :key="fk" class="fcard-seg" :style="'width:' + fi.amPct + '%;background:' + fi.color"></view></view>
                                    <text class="fcard-num">{{ fg.am }}</text>
                                  </view>
                                  <view class="fcard-row">
                                    <text class="fcard-slot">{{ mt('formulaPm') }}</text>
                                    <view class="fcard-track"><view v-for="(fi, fk) in fg.items" :key="fk" class="fcard-seg" :style="'width:' + fi.pmPct + '%;background:' + fi.color"></view></view>
                                    <text class="fcard-num">{{ fg.pm }}</text>
                                  </view>
                                  <view class="fcard-legend">
                                    <view v-for="(fi, fk) in fg.items" :key="fk" class="fcard-leg">
                                      <view class="fcard-swatch" :style="'background:' + fi.color"></view>
                                      <text class="fcard-leg-name">{{ fi.name }}</text>
                                      <text class="fcard-leg-num">{{ fi.am }}·{{ fi.pm }}</text>
                                    </view>
                                  </view>
                                  <text class="fcard-foot">{{ mt('formulaTotalLabel') }} {{ fg.total }}</text>
                                </view>
                                <text v-if="ft.pitch.length > 0" class="fcard-tier-pitch">{{ ft.pitch }}</text>
                              </view>
                            </view>
                            <text v-if="seg.cycleDays > 0" class="fcard-cycle">{{ seg.cycleDays }}{{ mt('formulaDaysUnit') }} · {{ seg.cycleCapsules }}{{ mt('formulaCapsulesUnit') }}</text>
                          </view>
                          <view v-else-if="seg.t == 'product'" class="pcard">
                            <text class="pcard-title">{{ mt('productCardTitle') }}</text>
                            <view v-for="(pi, pk) in seg.productItems" :key="pk" class="pcard-row">
                              <view class="pcard-main">
                                <text class="pcard-name">{{ pi.name }}</text>
                                <text v-if="pi.reason.length > 0" class="pcard-reason">{{ pi.reason }}</text>
                              </view>
                              <text class="pcard-price">{{ pi.price }}</text>
                            </view>
                          </view>
                          <view v-else-if="seg.t == 'grocery'" class="gcard">
                            <text class="gcard-title">{{ mt('groceryCardTitle') }}</text>
                            <view v-for="(gi, gk) in seg.groceryItems" :key="gk" class="gcard-row">
                              <image v-if="gi.image.length > 0" class="gcard-img" :src="gi.image" mode="aspectFill" />
                              <view v-else class="gcard-img gcard-img-empty"></view>
                              <view class="gcard-main">
                                <text class="gcard-name">{{ gi.name }}</text>
                                <text v-if="gi.reason.length > 0" class="gcard-reason">{{ gi.reason }}</text>
                                <text class="gcard-supplier">{{ gi.supplierName }}</text>
                              </view>
                              <text v-if="gi.price.length > 0" class="gcard-price">{{ gi.price }}</text>
                            </view>
                            <text v-if="seg.groceryNote.length > 0" class="gcard-note">{{ seg.groceryNote }}</text>
                          </view>
                          <view v-else-if="seg.t == 'lesson'" class="lcard">
                            <view class="lcard-meta"><text class="lcard-title">{{ seg.lessonTitle }}</text></view>
                          </view>
                          <view v-else-if="seg.t == 'checkin'" class="ccard">
                            <view class="ccard-cta ccard-cta-off"><text>{{ seg.checkinLabel.length > 0 ? seg.checkinLabel : mt('programCheckinCta') }}</text></view>
                          </view>
                        </view>
                      </view>
                    </view>
                  </view>
                  <view v-if="vivaThinking || chatToolBusy" class="msg-row msg-row-ai">
                    <view class="message-bubble message-ai typing-indicator">
                      <view class="typing-dot"></view><view class="typing-dot"></view><view class="typing-dot"></view>
                      <text v-if="vivaThinking" class="typing-status-text">{{ tr('mc.thinking') }}</text>
                    </view>
                  </view>
                  <view style="height: 8px"></view>
                </view>
              </scroll-view>

              <view class="ai-disclaimer"><text class="ai-disclaimer-text">{{ mt('aiDisclaimer') }}</text></view>
              <view class="coach-chat-actions">
                <view class="coach-chat-action" v-on:click="openReminderComposer"><text>{{ tr('setReminder') }}</text></view>
                <view v-if="detailIsManaged" class="coach-chat-action" v-on:click="openRedeemForm"><text>{{ tr('mc.redeem') }}</text></view>
                <view v-if="detailIsManaged" class="coach-chat-action" v-on:click="scanBoxForCustomer"><text>{{ tr('mc.boxScan') }}</text></view>
              </view>
              <view class="input-container">
                <toolbox v-if="chatToolboxOpen" :tools="chatToolList" :disabled="chatToolBusy" v-on:toolaction="handleChatToolAction" />
                <view class="input-area">
                  <view class="plus-btn" :class="chatToolboxOpen ? 'plus-btn-open' : ''" v-on:click="toggleChatToolbox"><text class="plus-icon">+</text></view>
                  <textarea class="chat-textarea" :placeholder="detailIsManaged ? tr('mc.askPh') : tr('msgPh')" v-model="msgText" :maxlength="500" />
                  <view class="send-btn" :class="msgText.length > 0 ? 'send-active' : ''" v-on:click="sendMessage"><text class="send-icon">↑</text></view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <view v-if="detailTab == 'notes'" class="overlay-scroll-full">
          <view v-if="clientNotesLoading" class="panel-center"><text class="loading-text">{{ tr('loading') }}</text></view>
          <view v-else>
            <view v-if="clientNotes.length == 0" class="panel-center"><text class="empty-text">{{ tr('noNotes') }}</text></view>
            <view v-for="(nt, nti) in clientNotes" :key="nti" class="note-item" :class="nt.getBoolean('is_pinned') == true ? 'note-pinned' : ''">
              <text class="note-content">{{ nt.getString('content') }}</text>
              <view class="note-footer">
                <text class="note-date">{{ nt.getString('created_at') }}</text>
                <view class="note-actions">
                  <text class="note-action-btn" v-on:click.stop="toggleNotePin(nti)">{{ nt.getBoolean('is_pinned') == true ? tr('noteUnpin') : tr('notePin') }}</text>
                  <text class="note-action-btn note-delete-btn" v-on:click.stop="deleteNote(nti)">{{ tr('noteDelete') }}</text>
                </view>
              </view>
            </view>
          </view>
          <view class="note-compose">
            <textarea class="note-input" :placeholder="tr('addNotePh')" v-model="noteText" :maxlength="1000" :auto-height="true" />
            <view class="note-save-btn" :class="notesBusy ? 'btn-busy' : ''" v-on:click="saveNote"><text class="note-save-text">{{ notesBusy ? '…' : tr('saveNote') }}</text></view>
          </view>
        </view>

        <view v-if="detailTab == 'facts'" class="overlay-scroll-full">
          <view v-if="clientFactsLoading" class="panel-center"><text class="loading-text">{{ tr('loading') }}</text></view>
          <view v-else>
            <view v-if="clientFacts.length == 0" class="panel-center"><text class="empty-text">{{ tr('noFacts') }}</text></view>
            <view v-for="(fc, fci) in clientFacts" :key="fci" class="note-item">
              <text class="note-content">[{{ factCatLabel(fc.getString('category')) }}] {{ fc.getString('fact_zh') }}</text>
              <view class="note-footer">
                <text class="note-date">{{ fc.getString('last_mentioned_at') }}</text>
                <view class="note-actions"><text class="note-action-btn note-delete-btn" v-on:click.stop="deleteFact(fci)">{{ tr('factDelete') }}</text></view>
              </view>
            </view>
          </view>
          <view class="note-compose">
            <view class="note-action-btn" style="display:inline-block;margin-bottom:8px;" v-on:click="pickFactCategory">{{ factCategoryLabel(factCategoryIndex) }} ▾</view>
            <textarea class="note-input" :placeholder="tr('addFactPh')" v-model="factText" :maxlength="500" :auto-height="true" />
            <view class="note-save-btn" :class="factsBusy ? 'btn-busy' : ''" v-on:click="saveFact"><text class="note-save-text">{{ factsBusy ? '…' : tr('saveFact') }}</text></view>
          </view>
        </view>

        <view v-if="detailTab == 'goals'" class="overlay-scroll-full">
          <view v-if="clientGoalsLoading" class="panel-center"><text class="loading-text">{{ tr('loading') }}</text></view>
          <view v-else>
            <view class="goals-header"><view class="set-goal-btn" v-on:click="openGoalSheet"><text class="set-goal-text">{{ tr('setGoal') }}</text></view></view>
            <view v-if="clientGoals.length == 0" class="panel-center"><text class="empty-text">{{ tr('noGoals') }}</text></view>
            <view v-for="(gl, gli) in clientGoals" :key="gli" class="goal-item" :class="'goal-' + (gl.getString('status') ?? '')">
              <view class="goal-header-row">
                <text class="goal-title">{{ gl.getString('title_zh') }}</text>
                <text class="goal-status-badge" :class="'goal-status-' + (gl.getString('status') ?? '')">{{ gl.getString('status') == 'achieved' ? tr('goalAchieved') : (gl.getString('status') == 'missed' ? tr('goalMissed') : tr('goalActive')) }}</text>
              </view>
              <view v-if="gl['baseline_value'] != null && gl['target_value'] != null" class="goal-progress-row">
                <text class="goal-baseline">{{ gl['baseline_value'] }}</text>
                <view class="goal-bar-bg"><view class="goal-bar-fill" :style="'width: ' + (gl['_pct'] ?? 0) + '%;'"></view></view>
                <text class="goal-target">{{ gl['target_value'] }}</text>
              </view>
              <view class="goal-meta-row">
                <text v-if="gl['current_value'] != null" class="goal-current">{{ lang == 'zh' ? '当前' : 'Current' }}: {{ gl['current_value'] }}</text>
                <text v-if="(gl.getString('target_date') ?? '').length > 0" class="goal-date">{{ lang == 'zh' ? '截止' : 'Due' }}: {{ gl.getString('target_date') }}</text>
              </view>
            </view>
          </view>
          <view v-if="goalFormOpen" class="goal-form-overlay">
            <view class="goal-form-card">
              <view class="goal-form-row" v-on:click="pickGoalType">
                <text class="goal-form-label">{{ tr('goalTypeLabel') }}</text>
                <text class="goal-form-value">{{ tr('goalTypes.' + goalType) }}</text>
              </view>
              <view class="goal-form-row">
                <text class="goal-form-label">{{ tr('goalTargetLabel') }}</text>
                <input class="goal-form-input" type="digit" placeholder="0" v-model="goalTargetValue" />
              </view>
              <picker mode="date" :value="goalTargetDate" v-on:change="onGoalDateChange">
                <view class="goal-form-row">
                  <text class="goal-form-label">{{ tr('goalDateLabel') }}</text>
                  <text class="goal-form-value">{{ goalTargetDate.length > 0 ? goalTargetDate : '—' }}</text>
                </view>
              </picker>
              <view class="goal-form-btns">
                <view class="goal-cancel-btn" v-on:click="closeGoalForm"><text>{{ lang == 'zh' ? '取消' : 'Cancel' }}</text></view>
                <view class="goal-submit-btn" :class="goalBusy ? 'btn-busy' : ''" v-on:click="submitGoal"><text>{{ goalBusy ? '…' : (lang == 'zh' ? '保存' : 'Save') }}</text></view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- Assign questionnaire -->
    <view v-if="qAssignOpen" class="overlay-mask">
      <view class="overlay-panel" v-on:click.stop="noop">
        <view class="overlay-header">
          <text class="overlay-title">{{ tr('questionnaires.assignTitle') }}</text>
          <view class="overlay-close" v-on:click="closeQAssign"><text class="close-x">✕</text></view>
        </view>
        <view v-if="qAssignQuestionnaire != null" class="q-assign-quest-banner">
          <text class="q-assign-quest-text">{{ lang == 'zh' ? (qAssignQuestionnaire!.getString('name_zh') ?? qAssignQuestionnaire!.getString('name')) : qAssignQuestionnaire!.getString('name') }}</text>
        </view>
        <scroll-view direction="vertical" class="overlay-scroll">
          <view v-if="clients.length == 0" class="panel-center"><text class="empty-text">{{ tr('questionnaires.noClients') }}</text></view>
          <view v-else class="q-assign-list">
            <view v-for="(qc, qci) in clients" :key="qci" class="q-assign-row" v-on:click="toggleQUser(qc.getString('user_id'))">
              <view class="q-check" :class="qAssignSelectedIds.indexOf(qc.getString('user_id') ?? '') >= 0 ? 'q-check-on' : ''">
                <text v-if="qAssignSelectedIds.indexOf(qc.getString('user_id') ?? '') >= 0" class="q-check-mark">✓</text>
              </view>
              <text class="q-assign-name">{{ qc.getString('nickname') ?? qc.getString('user_id') }}</text>
            </view>
          </view>
        </scroll-view>
        <view class="q-assign-footer">
          <view class="instr-send-btn" :class="qAssignBusy ? 'btn-busy' : ''" v-on:click="submitQAssign"><text class="instr-send-text">{{ qAssignBusy ? tr('loading') : tr('questionnaires.assign') }}</text></view>
        </view>
      </view>
    </view>

    <!-- Questionnaire responses (per client) -->
    <view v-if="qResponsesOpen" class="overlay-mask">
      <view class="overlay-panel" v-on:click.stop="noop">
        <view class="overlay-header">
          <text class="overlay-title">{{ qResponsesUser != null ? (qResponsesUser!.getString('nickname') ?? '') + ' · ' : '' }}{{ tr('questionnaires.responsesTitle') }}</text>
          <view class="overlay-close" v-on:click="closeQResponses"><text class="close-x">✕</text></view>
        </view>
        <scroll-view direction="vertical" class="overlay-scroll">
          <view v-if="qResponsesLoading" class="panel-center"><text class="loading-text">{{ tr('loading') }}</text></view>
          <view v-else-if="qResponsesList.length == 0" class="panel-center"><text class="empty-text">{{ tr('questionnaires.noResponses') }}</text></view>
          <view v-else class="q-resp-list">
            <view v-for="(grp, gri) in qResponsesList" :key="gri" class="q-resp-group">
              <text class="section-label">{{ grp.getString('name') }}</text>
              <view v-for="(rsp, rsi) in (grp.getArray<UTSJSONObject>('items') ?? [])" :key="rsi" class="q-resp-item">
                <text class="q-resp-prompt">{{ rsp.getString('prompt') }}</text>
                <text class="q-resp-answer">{{ rsp.getString('answer_fmt') }}</text>
                <text class="q-resp-time">{{ rsp.getString('answered_at') }}</text>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>

    <!-- Reminder composer -->
    <view v-if="reminderOpen" class="overlay-mask">
      <view class="overlay-panel" v-on:click.stop="noop">
        <view class="overlay-header">
          <text class="overlay-title">{{ tr('reminderTitle') }}</text>
          <view class="overlay-close" v-on:click="closeReminderComposer"><text class="close-x">✕</text></view>
        </view>
        <scroll-view direction="vertical" class="overlay-scroll">
          <view class="reminder-body">
            <textarea class="instr-textarea" :placeholder="tr('reminderContentPh')" v-model="reminderText" :maxlength="300" :auto-height="true" />
            <view class="picker-row">
              <text class="picker-label">{{ tr('reminderDate') }}</text>
              <picker mode="date" :value="reminderDate" v-on:change="onReminderDateChange">
                <view class="picker-value"><text class="picker-value-text">{{ reminderDate.length > 0 ? reminderDate : tr('selectDate') }}</text></view>
              </picker>
            </view>
            <view class="picker-row">
              <text class="picker-label">{{ tr('reminderTime') }}</text>
              <picker mode="time" :value="reminderTime" v-on:change="onReminderTimeChange">
                <view class="picker-value"><text class="picker-value-text">{{ reminderTime.length > 0 ? reminderTime : tr('selectTime') }}</text></view>
              </picker>
            </view>
            <view class="picker-row">
              <text class="picker-label">{{ tr('recurrence') }}</text>
              <view class="recurrence-opts">
                <view class="recurrence-opt" :class="reminderRecurrence == 'none' ? 'recurrence-active' : ''" v-on:click="setRecurrence('none')"><text class="recurrence-opt-text">{{ tr('recurrenceNone') }}</text></view>
                <view class="recurrence-opt" :class="reminderRecurrence == 'daily' ? 'recurrence-active' : ''" v-on:click="setRecurrence('daily')"><text class="recurrence-opt-text">{{ tr('recurrenceDaily') }}</text></view>
                <view class="recurrence-opt" :class="reminderRecurrence == 'weekly' ? 'recurrence-active' : ''" v-on:click="setRecurrence('weekly')"><text class="recurrence-opt-text">{{ tr('recurrenceWeekly') }}</text></view>
              </view>
            </view>
            <view class="instr-send-btn" :class="reminderBusy ? 'btn-busy' : ''" v-on:click="submitReminder"><text class="instr-send-text">{{ reminderBusy ? tr('sending') : tr('send') }}</text></view>
          </view>
        </scroll-view>
      </view>
    </view>
  </view>

  <view class="coach-refresh" v-on:click="handleRefresh"><text>↻</text></view>

  <!-- Appointment form — the web user-app's CoachPanel AppointmentForm -->
  <view v-if="apptFormOpen" class="coach-appointment overlay-mask" :class="theme == 'light' ? 'theme-light' : ''">
    <view class="overlay-panel" v-on:click.stop="noop">
      <view class="overlay-header">
        <text class="overlay-title">{{ tr('newAppt') }}</text>
        <view class="overlay-close" v-on:click="closeApptForm"><text class="close-x">✕</text></view>
      </view>
      <view class="overlay-scroll coach-appointment-body">
        <view class="form-row" v-on:click="pickApptClient"><text>{{ tr('tabs.clients') }}</text><view class="form-input"><text>{{ apptClientName.length > 0 ? apptClientName : '—' }}</text></view></view>
        <view class="form-row"><text>{{ tr('apptTitle') }}</text><input class="form-input" v-model="apptTitleText" /></view>
        <picker mode="date" :value="apptDate" v-on:change="onApptDateChange"><view class="form-row"><text>{{ tr('apptDate') }}</text><view class="form-input"><text>{{ apptDate }}</text></view></view></picker>
        <picker mode="time" :value="apptTime" v-on:change="onApptTimeChange"><view class="form-row"><text>{{ tr('apptTime') }}</text><view class="form-input"><text>{{ apptTime }}</text></view></view></picker>
        <view class="form-row"><text>{{ lang == 'zh' ? '链接' : 'Link' }}</text><input class="form-input" v-model="apptLink" /></view>
        <view class="form-input" v-on:click="pickApptFormat"><text>{{ tr('apptFormats.' + apptFormat) }}</text></view>
      </view>
      <view class="overlay-footer">
        <view class="overlay-cancel-btn" v-on:click="closeApptForm"><text>{{ tr('apptCancel') }}</text></view>
        <view class="overlay-confirm-btn" :class="apptBusy || apptClientId.length == 0 || apptTitleText.trim().length == 0 ? 'btn-busy' : ''" v-on:click="submitAppt"><text>{{ apptBusy ? tr('loading') : tr('apptCreate') }}</text></view>
      </view>
    </view>
  </view>
  </view>
  <!-- #endif -->
  <!-- #ifndef WEB -->
  <view class="co-screen">
    <view class="co-header" :style="'padding-top:' + statusBarHeight + 'px'">
      <view class="co-back" v-on:click="handleBack"><text class="co-back-text">‹ {{ tr('back') }}</text></view>
      <text class="co-title">{{ tr('title') }}</text>
      <view class="co-menu-btn" v-on:click="toggleMenu"><text class="co-menu-text">☰</text></view>
    </view>

    <view v-if="menuOpen" class="co-menu">
      <text class="co-menu-item" v-on:click="toggleLang">{{ lang == 'zh' ? 'English' : '中文' }}</text>
      <text class="co-menu-item" v-on:click="toggleTheme">{{ tr(theme == 'dark' ? 'lightMode' : 'darkMode') }}</text>
      <text class="co-menu-item" v-on:click="openUserPanel">{{ tr('userPanelMenu') }}</text>
      <text v-if="sandboxMode" class="co-menu-item" v-on:click="exitSandbox">{{ tr('exitSandbox') }}</text>
      <text class="co-menu-item co-menu-danger" v-on:click="handleLogout">{{ tr('logout') }}</text>
    </view>

    <view v-if="sandboxMode" class="co-sandbox-banner">
      <text class="co-sandbox-text">{{ sandboxBannerText }}</text>
    </view>

    <view class="co-tabs">
      <text v-for="(tk, i) in tabKeys" :key="i" class="co-tab" :class="tab == tk ? 'co-tab-on' : ''" v-on:click="switchTab(tk)">{{ tr('tabs.' + tk) }}</text>
    </view>

    <scroll-view direction="vertical" class="co-body" :refresher-enabled="tab == 'clients'" v-on:refresherrefresh="onClientsRefresh">
      <view v-if="tab == 'clients'">
        <view class="co-search-row">
          <input class="co-search" v-model="clientSearch" :placeholder="tr('searchPlaceholder')" />
        </view>
        <view class="co-chips">
          <text class="co-chip" :class="clientStageFilter.length == 0 ? 'co-chip-on' : ''" v-on:click="setStageFilter('')">{{ tr('filterAll') }}</text>
          <text v-for="(s, i) in clientFilterStages" :key="i" class="co-chip" :class="clientStageFilter == s.getString('stage') ? 'co-chip-on' : ''" v-on:click="setStageFilter(`${s.getString('stage')}`)">{{ s.getString('label') }} ({{ s.getNumber('count') }})</text>
        </view>
        <text v-if="mcEnabled" class="co-mc-add" v-on:click="openManagedForm('')">{{ tr('mc.add') }}</text>

        <text v-if="clientsLoadState == 'no_coach'" class="co-empty">{{ tr('noCoachSession') }} {{ diagText }}</text>
        <text v-else-if="clientsLoadState == 'failed'" class="co-empty">{{ tr('clientsLoadFailed') }} {{ diagText }}</text>
        <text v-else-if="filteredClients.length == 0" class="co-empty">{{ clients.length == 0 ? tr('noClients') : tr('noMatchClients') }}</text>

        <view v-for="(c, i) in filteredClients" :key="i" class="co-client" v-on:click="openClientDetail(i, 'health')">
          <view class="co-client-top">
            <text class="co-client-name">{{ c.getString('nickname') }}</text>
            <text v-if="c.getString('account_type') == 'managed'" class="co-badge">{{ tr('mc.badge') }}</text>
            <text v-if="c.getJSON('_crmStagePill') != null" class="co-badge" :style="'color:' + c.getJSON('_crmStagePill')!.getString('color')">{{ c.getJSON('_crmStagePill')!.getString('label') }}</text>
          </view>
          <view class="co-client-row">
            <text class="co-kv">{{ tr('bioAge') }}: </text><text class="co-v" :style="'color:' + c.getString('_bioAgeColor')">{{ c.getString('_bioAgeStr') }}</text>
            <text class="co-kv">  {{ tr('chronoAge') }}: </text><text class="co-v">{{ c.getNumber('_cAge') }}</text>
          </view>
          <view class="co-subages">
            <text v-for="(sa, j) in c.getArray<UTSJSONObject>('_subAges')" :key="j" class="co-subage" :style="'color:' + sa.getString('color')">{{ sa.getString('label') }} {{ sa.getString('value') }}</text>
          </view>
          <view class="co-client-foot">
            <text class="co-kv">{{ tr('lastScan') }}: </text><text class="co-v">{{ c.getString('_lastScanFmt') }}</text>
          </view>
          <text v-if="c.getString('_lastUserMsg') != null" class="co-msgprev">{{ c.getString('_lastUserMsg') }}</text>
        </view>
      </view>

      <view v-else-if="tab == 'invites'">
        <view class="co-btn" v-on:click="generateInvite"><text class="btn-text">{{ tr('invite.generate') }}</text></view>
        <text v-if="invites.length == 0" class="co-empty">{{ tr('invite.noInvites') }}</text>
        <view v-for="(v, i) in invites" :key="i" class="co-invite">
          <view class="co-client-top">
            <text class="co-code">{{ v.getString('code') }}</text>
            <text class="co-badge">{{ v.getBoolean('is_active') == true ? tr('invite.active') : tr('invite.inactive') }}</text>
          </view>
          <text class="co-kv">{{ tr('invite.uses') }}: {{ v.getNumber('use_count') }}</text>
          <text class="co-note" v-on:click="editInviteNote(i)">{{ v.getString('note') != null && v.getString('note')!.length > 0 ? v.getString('note') : tr('invite.noNote') }}</text>
          <view class="co-row-actions">
            <text class="co-act" v-on:click="copyInvite(i)">{{ tr('invite.copy') }}</text>
            <text v-if="v.getBoolean('is_active') == true" class="co-act co-act-danger" v-on:click="deactivateInvite(i)">{{ tr('invite.deactivate') }}</text>
          </view>
        </view>
      </view>

      <view v-else-if="tab == 'earnings'">
        <view class="co-kpi-row">
          <view class="co-kpi"><text class="co-kpi-label">{{ tr('earnings.thisMonth') }}</text><text class="co-kpi-val">{{ earningsThisMonth }}</text></view>
          <view class="co-kpi"><text class="co-kpi-label">{{ tr('earnings.available') }}</text><text class="co-kpi-val">{{ earningsAvailable }}</text></view>
        </view>
        <text class="co-section">{{ tr('earnings.payoutHistory') }}</text>
        <text v-if="earningsPayouts.length == 0" class="co-empty">{{ tr('earnings.noPayouts') }}</text>
        <view v-for="(p, i) in earningsPayouts" :key="i" class="co-payout">
          <text class="co-v">{{ p.getString('period_start') }}</text>
          <text class="co-v">{{ p.getString('_amountFmt') }}</text>
          <text class="co-v">{{ p.getString('_statusFmt') }}</text>
        </view>
      </view>

      <view v-else-if="tab == 'questionnaires'">
        <text v-if="questionnaires.length == 0" class="co-empty">{{ tr('questionnaires.noQuestionnaires') }}</text>
        <view v-for="(q, i) in questionnaires" :key="i" class="co-q">
          <text class="co-client-name">{{ q.getString('name_zh') }}</text>
          <view class="co-row-actions">
            <text class="co-act" v-on:click="openQAssign(i)">{{ tr('questionnaires.assign') }}</text>
            <text class="co-act" v-on:click="openQResponses(i)">{{ tr('questionnaires.responsesTitle') }}</text>
          </view>
        </view>
      </view>

      <view v-else>
        <text class="co-section">{{ tr('kpiTitle') }}</text>
        <view class="co-kpi-row">
          <view class="co-kpi"><text class="co-kpi-label">{{ tr('kpiClients') }}</text><text class="co-kpi-val">{{ kpiField('total_clients') }}</text></view>
          <view class="co-kpi"><text class="co-kpi-label">{{ tr('kpiActive') }}</text><text class="co-kpi-val">{{ kpiField('active_clients') }}</text></view>
          <view class="co-kpi"><text class="co-kpi-label">{{ tr('kpiAtRisk') }}</text><text class="co-kpi-val">{{ kpiField('at_risk_count') }}</text></view>
        </view>
        <text class="co-section">{{ tr('crmPipeline') }}</text>
        <scroll-view direction="horizontal" class="co-kanban">
          <view v-for="(col, i) in crmPipelineColumns" :key="i" class="co-kanban-col">
            <text class="co-kanban-head" :style="'color:' + col.getString('color')">{{ col.getString('label') }}</text>
            <view v-for="(cc, j) in col.getArray<UTSJSONObject>('clients')" :key="j" class="co-kanban-card" v-on:longpress="openStagePicker(cc)" v-on:click="openApptForm(cc)">
              <text class="co-client-name">{{ cc.getString('nickname') }}</text>
            </view>
          </view>
        </scroll-view>
        <view class="co-btn" v-on:click="openApptForm(null)"><text class="btn-text">{{ tr('newAppt') }}</text></view>
        <text class="co-section">{{ tr('crmAppointments') }}</text>
        <text v-if="crmUpcomingAppts.length == 0" class="co-empty">{{ tr('noAppointments') }}</text>
        <view v-for="(a, i) in crmUpcomingAppts" :key="i" class="co-payout"><text class="co-v">{{ a.getString('title') }}</text><text class="co-v">{{ a.getString('_timeFmt') }}</text></view>
        <text class="co-section">{{ tr('crmActivity') }}</text>
        <text v-if="crmActivityFeed.length == 0" class="co-empty">{{ tr('noActivity') }}</text>
        <view v-for="(f, i) in crmActivityFeed" :key="i" class="co-payout">
          <text class="co-v">{{ f.getString('_label') }} · {{ f.getString('client_name') }}</text>
          <text class="co-v co-muted">{{ f.getString('_timeFmt') }}</text>
        </view>
      </view>
    </scroll-view>

    <view v-if="detailOpen" class="co-overlay">
      <view class="co-sheet">
        <view class="co-sheet-head">
          <text class="co-client-name">{{ detailClient != null ? detailClient!.getString('nickname') : '' }}</text>
          <text v-if="detailClient != null && detailClient!.getString('account_type') == 'managed'" class="co-badge">{{ tr('mc.badge') }}</text>
          <view class="co-row-actions">
            <text v-if="detailClient != null && detailClient!.getString('account_type') == 'managed'" class="co-act" v-on:click="openManagedFormEdit">{{ tr('mc.edit') }}</text>
            <text v-if="detailClient != null && detailClient!.getString('account_type') == 'managed'" class="co-act" v-on:click="scanBoxForCustomer">{{ tr('mc.boxScan') }}</text>
          </view>
          <text class="co-close" v-on:click="closeClientDetail">✕</text>
        </view>
        <view class="co-subtabs">
          <text v-for="(dt, i) in detailTabs" :key="i" class="co-chip" :class="detailTab == dt ? 'co-chip-on' : ''" v-on:click="switchDetailTab(dt)">{{ detailTabLabel(dt) }}</text>
        </view>

        <scroll-view direction="vertical" class="co-detail-body">
          <view v-if="detailTab == 'health'">
            <user-health :userId="detailClient != null ? detailClient!.getString('user_id') ?? '' : ''"
              :user="detailClient" :lang="lang" mode="coach" :coachId="coachId" :theme="theme"
              :textScale="textScale" v-on:profileUpdated="onClientProfileUpdated" />
          </view>

          <view v-else-if="detailTab == 'chat'">
            <scroll-view direction="vertical" class="co-chatlist" :scroll-top="chatScrollTop" :scroll-with-animation="true">
              <view v-for="(m, i) in chatMessages" :key="i" class="co-cmsg" :class="m.getBoolean('_isCoach') == true ? 'co-cmsg-coach' : (m.getBoolean('_isAi') == true ? 'co-cmsg-ai' : 'co-cmsg-user')">
                <text class="co-cmsg-who">{{ m.getString('role') }} {{ m.getString('_time') }}</text>
                <text v-if="m.getString('content') != null && m.getString('content')!.length > 0" class="co-cmsg-text">{{ m.getString('content') }}</text>
                <image v-if="m.getString('imageUrl') != null && m.getString('imageUrl')!.length > 0" class="co-cmsg-img" :src="m.getString('imageUrl')" mode="widthFix" />
              </view>
            </scroll-view>
            <view v-if="vivaThinking" class="co-typing"><text class="co-muted">{{ tr('mc.thinking') }}</text></view>
            <view class="co-tools">
              <text class="co-act" v-on:click="runTool('test_chip')">{{ tr('toolTestChip') }}</text>
              <text class="co-act" v-on:click="runTool('formula_dots')">{{ tr('toolFormulaDots') }}</text>
              <text class="co-act" v-on:click="runTool('health_advice')">{{ tr('toolHealthAdvice') }}</text>
              <text class="co-act" v-on:click="runTool('upload_image')">{{ tr('toolUploadImage') }}</text>
            </view>
            <view class="co-compose">
              <input class="co-msg-input" v-model="msgText" :placeholder="detailIsManaged ? tr('mc.askPh') : tr('msgPh')" />
              <view class="co-send" v-on:click="sendMessage"><text class="btn-text">{{ msgBusy ? tr('sending') : tr('send') }}</text></view>
              <view class="co-send co-send-ghost" v-on:click="openReminderComposer"><text class="btn-text-sm">{{ tr('setReminder') }}</text></view>
              <view v-if="detailIsManaged" class="co-send co-send-ghost" v-on:click="openRedeemForm"><text class="btn-text-sm">{{ tr('mc.redeem') }}</text></view>
            </view>
          </view>

          <view v-else-if="detailTab == 'plans'">
            <text class="co-section">{{ tr('clientPlans') }}</text>
            <text v-if="detailPlans.length == 0" class="co-empty">{{ tr('noClientPlans') }}</text>
            <view v-for="(p, i) in detailPlans" :key="i" class="co-plan">
              <text class="co-client-name">{{ p.getString('name_zh') }}</text>
              <text class="co-kv">{{ p.getString('plan_type') == 'primary' ? tr('planPrimary') : tr('planSecondary') }} · {{ p.getNumber('duration_weeks') }} {{ tr('planWeeks') }}</text>
            </view>
            <view class="co-row-actions">
              <text class="co-act" v-on:click="openPlanRecommend">{{ tr('recommendPlan') }}</text>
              <text class="co-act" v-on:click="openPlanCustom">{{ tr('createCustomPlan') }}</text>
            </view>
            <text class="co-section">{{ tr('clientPrograms') }}</text>
            <text v-if="detailPrograms.length == 0" class="co-empty">{{ tr('noClientPrograms') }}</text>
            <view v-for="(p, i) in detailPrograms" :key="i" class="co-plan">
              <text class="co-client-name">{{ p.getString('title_zh') }}</text>
              <text class="co-kv">{{ p.getString('statusLabel') }} · {{ p.getString('progressLabel') }}</text>
              <text v-if="p.getString('action') != null && p.getString('action')!.length > 0" class="co-act" v-on:click="handleProgramAction(p.getNumber('id'), `${p.getString('action')}`)">{{ p.getString('actionLabel') }}</text>
            </view>
          </view>

          <view v-else-if="detailTab == 'notes'">
            <view class="co-compose">
              <input class="co-msg-input" v-model="noteText" :placeholder="tr('addNotePh')" />
              <view class="co-send" v-on:click="saveNote"><text class="btn-text">{{ tr('saveNote') }}</text></view>
            </view>
            <text v-if="clientNotes.length == 0" class="co-empty">{{ tr('noNotes') }}</text>
            <view v-for="(n, i) in clientNotes" :key="i" class="co-note-card">
              <text class="co-v">{{ n.getString('content') }}</text>
              <view class="co-row-actions">
                <text class="co-act" v-on:click="toggleNotePin(i)">{{ n.getBoolean('is_pinned') == true ? tr('noteUnpin') : tr('notePin') }}</text>
                <text class="co-act co-act-danger" v-on:click="deleteNote(i)">{{ tr('noteDelete') }}</text>
              </view>
            </view>
          </view>

          <view v-else-if="detailTab == 'goals'">
            <view class="co-row-actions"><text class="co-act" v-on:click="openGoalForm">{{ tr('setGoal') }}</text></view>
            <text v-if="clientGoals.length == 0" class="co-empty">{{ tr('noGoals') }}</text>
            <view v-for="(g, i) in clientGoals" :key="i" class="co-note-card">
              <text class="co-v">{{ g.getString('title_zh') }} · {{ g.getString('_pctLabel') }}</text>
              <text class="co-kv">{{ g.getString('_statusLabel') }}</text>
            </view>
          </view>

          <view v-else>
            <view class="co-compose">
              <input class="co-msg-input" v-model="factText" :placeholder="tr('addFactPh')" />
              <view class="co-send" v-on:click="saveFact"><text class="btn-text">{{ tr('saveFact') }}</text></view>
            </view>
            <text v-if="clientFacts.length == 0" class="co-empty">{{ tr('noFacts') }}</text>
            <view v-for="(f, i) in clientFacts" :key="i" class="co-note-card">
              <text class="co-v">{{ factCatLabel(f.getString('category')) }}: {{ f.getString('fact_zh') }}</text>
              <text class="co-act co-act-danger" v-on:click="deleteFact(i)">{{ tr('factDelete') }}</text>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>

    <view v-if="planRecommendOpen" class="co-overlay" v-on:click="closePlanRecommend">
      <view class="co-sheet co-sheet-mid">
        <text class="co-client-name">{{ tr('recommendPlan') }}</text>
        <view v-for="(tpl, i) in planTemplates" :key="i" class="co-tpl" v-on:click="handleRecommendPlan(tpl.getNumber('id'))">
          <text class="co-v">{{ tpl.getString('name_zh') }}</text>
          <text class="co-kv">{{ tpl.getString('sub_ages_display') }}</text>
        </view>
      </view>
    </view>

    <view v-if="planCustomOpen" class="co-overlay">
      <view class="co-sheet co-sheet-mid">
        <text class="co-client-name">{{ tr('createCustomPlan') }}</text>
        <input class="co-msg-input co-field" v-model="planCustomName" :placeholder="tr('customPlanName')" />
        <input class="co-msg-input co-field" v-model="planCustomGoal" :placeholder="tr('customPlanGoal')" />
        <input class="co-msg-input co-field" v-model="planCustomDurationStr" :placeholder="tr('customPlanDuration')" />
        <view class="co-btn" v-on:click="handleCreateCustomPlan"><text class="btn-text">{{ tr('saveNote') }}</text></view>
        <text class="co-act" v-on:click="closePlanCustom">{{ tr('mc.cancel') }}</text>
      </view>
    </view>

    <view v-if="reminderOpen" class="co-overlay">
      <view class="co-sheet co-sheet-mid">
        <text class="co-client-name">{{ tr('reminderTitle') }}</text>
        <textarea class="co-msg-input co-field" v-model="reminderText" :placeholder="tr('reminderContentPh')" />
        <view class="co-compose-row">
          <view class="co-send co-send-ghost"><picker mode="date" v-on:change="onReminderDateChange"><text class="btn-text-sm">{{ reminderDate }}</text></picker></view>
          <view class="co-send co-send-ghost"><picker mode="time" v-on:change="onReminderTimeChange"><text class="btn-text-sm">{{ reminderTime }}</text></picker></view>
        </view>
        <view class="co-row-actions">
          <text class="co-act" :class="reminderRecurrence == 'none' ? 'co-act-on' : ''" v-on:click="setRecurrence('none')">{{ tr('recurrenceNone') }}</text>
          <text class="co-act" :class="reminderRecurrence == 'daily' ? 'co-act-on' : ''" v-on:click="setRecurrence('daily')">{{ tr('recurrenceDaily') }}</text>
          <text class="co-act" :class="reminderRecurrence == 'weekly' ? 'co-act-on' : ''" v-on:click="setRecurrence('weekly')">{{ tr('recurrenceWeekly') }}</text>
        </view>
        <view class="co-btn" v-on:click="submitReminder"><text class="btn-text">{{ tr('send') }}</text></view>
        <text class="co-act" v-on:click="closeReminderComposer">{{ tr('mc.cancel') }}</text>
      </view>
    </view>

    <view v-if="qAssignOpen" class="co-overlay">
      <view class="co-sheet co-sheet-mid">
        <text class="co-client-name">{{ tr('questionnaires.assignTitle') }}</text>
        <view class="co-detail-body">
          <view v-for="(c, i) in clients" :key="i" class="co-qrow" v-on:click="toggleQUser(c.getString('user_id'))">
            <text class="co-v">{{ c.getString('nickname') }}</text>
            <text class="co-v">{{ qAssignSelectedIds.indexOf(c.getString('user_id')) >= 0 ? '✓' : '' }}</text>
          </view>
        </view>
        <view class="co-btn" v-on:click="submitQAssign"><text class="btn-text">{{ tr('questionnaires.assign') }}</text></view>
        <text class="co-act" v-on:click="closeQAssign">{{ tr('mc.cancel') }}</text>
      </view>
    </view>

    <view v-if="qResponsesOpen" class="co-overlay">
      <view class="co-sheet co-sheet-mid">
        <text class="co-client-name">{{ tr('questionnaires.responsesTitle') }}</text>
        <view class="co-detail-body">
          <text v-if="qResponsesList.length == 0" class="co-empty">{{ tr('questionnaires.noResponses') }}</text>
          <view v-for="(grp, i) in qResponsesList" :key="i">
            <text class="co-section">{{ grp.getString('name') }}</text>
            <view v-for="(item, j) in grp.getArray<UTSJSONObject>('items')" :key="j" class="co-note-card">
              <text class="co-v">{{ item.getString('prompt') }} → {{ item.getString('answer_fmt') }}</text>
              <text class="co-kv">{{ item.getString('answered_at') }}</text>
            </view>
          </view>
        </view>
        <text class="co-act" v-on:click="closeQResponses">{{ tr('apptCancel') }}</text>
      </view>
    </view>

    <view v-if="mcFormOpen" class="co-overlay">
      <view class="co-sheet co-sheet-mid">
        <text class="co-client-name">{{ mcEditId.length > 0 ? tr('mc.titleEdit') : tr('mc.titleNew') }}</text>
        <text class="co-kv">{{ tr('mc.note') }}</text>
        <input class="co-msg-input co-field" v-model="mcLast" :placeholder="tr('mc.lastName')" />
        <input class="co-msg-input co-field" v-model="mcFirst" :placeholder="tr('mc.firstName')" />
        <input class="co-msg-input co-field" v-model="mcNickname" :placeholder="tr('mc.nickname')" />
        <view class="co-send co-send-ghost co-field"><picker mode="date" v-on:change="onMcBirthDateChange"><text class="btn-text-sm">{{ mcBirthDate.length > 0 ? mcBirthDate : tr('mc.selectDate') }}</text></picker></view>
        <view class="co-row-actions">
          <text class="co-act" :class="mcGender == 'male' ? 'co-act-on' : ''" v-on:click="mcGender = 'male'">{{ tr('mc.genders0') }}</text>
          <text class="co-act" :class="mcGender == 'female' ? 'co-act-on' : ''" v-on:click="mcGender = 'female'">{{ tr('mc.genders1') }}</text>
        </view>
        <input class="co-msg-input co-field" v-model="mcPhone" :placeholder="tr('mc.phone')" />
        <input class="co-msg-input co-field" v-model="mcRef" :placeholder="tr('mc.ref')" />
        <view class="co-btn" v-on:click="submitManagedForm"><text class="btn-text">{{ tr('mc.save') }}</text></view>
        <text class="co-act" v-on:click="closeManagedForm">{{ tr('mc.cancel') }}</text>
      </view>
    </view>

    <view v-if="redeemOpen" class="co-overlay">
      <view class="co-sheet co-sheet-mid">
        <text class="co-client-name">{{ tr('mc.redeemTitle') }}</text>
        <text class="co-kv">{{ tr('mc.redeemHint') }}</text>
        <input class="co-msg-input co-field" v-model="redeemCode" :placeholder="tr('mc.redeemCode')" />
        <input class="co-msg-input co-field" v-model="redeemName" :placeholder="tr('mc.redeemName')" />
        <input class="co-msg-input co-field" v-model="redeemPhone" :placeholder="tr('mc.redeemPhone')" />
        <textarea class="co-msg-input co-field" v-model="redeemAddress" :placeholder="tr('mc.redeemAddress')" />
        <view class="co-btn" v-on:click="submitRedeem"><text class="btn-text">{{ tr('mc.redeemSubmit') }}</text></view>
        <text class="co-act" v-on:click="closeRedeemForm">{{ tr('mc.cancel') }}</text>
      </view>
    </view>

    <view v-if="apptFormOpen" class="co-overlay">
      <view class="co-sheet co-sheet-mid">
        <text class="co-client-name">{{ tr('apptCreate') }}{{ apptClientName.length > 0 ? ' · ' + apptClientName : '' }}</text>
        <input class="co-msg-input co-field" v-model="apptTitleText" :placeholder="tr('apptTitle')" />
        <view class="co-compose-row">
          <view class="co-send co-send-ghost"><picker mode="date" v-on:change="onApptDateChange"><text class="btn-text-sm">{{ apptDate }}</text></picker></view>
          <view class="co-send co-send-ghost"><picker mode="time" v-on:change="onApptTimeChange"><text class="btn-text-sm">{{ apptTime }}</text></picker></view>
        </view>
        <view class="co-row-actions">
          <text v-for="(fm, i) in apptFormats" :key="i" class="co-act" :class="apptFormat == fm ? 'co-act-on' : ''" v-on:click="apptFormat = fm">{{ tr('apptFormats.' + fm) }}</text>
        </view>
        <input class="co-msg-input co-field" v-model="apptLink" placeholder="https://…" />
        <view class="co-btn" v-on:click="submitAppt"><text class="btn-text">{{ tr('apptCreate') }}</text></view>
        <text class="co-act" v-on:click="closeApptForm">{{ tr('apptCancel') }}</text>
      </view>
    </view>
  </view>
  <!-- #endif -->
</template>

<script>
// Ported from miniapp pages/coach/coach.js (full logic). Deviations, deliberate:
//  - privacy-modal hooks / capsule geometry / edge-swipe handlers dropped (WeChat-only or
//    covered by Android system back).
//  - <user-health> detail sub-tab is a placeholder until the component port lands.
//  - toolbox component → inline tool chips; upload goes through uni.chooseImage.
// Kept verbatim: the three distinct empty-list states + diagText (2026-08-30 incident),
// _repairCoachSession, sandbox request injection, coach-speaker managed-customer chat (§49)
// with the 285s thread poll, coach-instruction newline flattening, redeem/box-claim flows,
// the assignable-questionnaires allowlist (dynamic/viva_ag never assignable), and every
// endpoint/payload shape.

import { BASE, API_ORIGIN, VERSION } from '../../utils/config.uts'
import { idOf } from '../../utils/json-id.uts'
import { mdToSegments, inlineTagStyles, Segment, FormulaTier } from '../../utils/markdown.uts'
import { T_MAIN_ZH, T_MAIN_EN } from '../../utils/main-t.uts'
import { tr as trPath } from '../../utils/i18n.uts'
import { scanQr, setScanTitle, syncRootClasses } from '../../utils/web-ui.uts'
import { state } from '../../utils/state.uts'
import { saveSession, clearSession, checkAuthStatus } from '../../utils/session.uts'
import { maskPhone } from '../../utils/phone.uts'
import { RespEnvelope, ToolCtx, ToolOpts, ToolItem, getToolList, runTestChip, runFormulaDs, runHealthAdvice, runUploadImage, doUpload } from '../../utils/tool-actions.uts'
import UserHealth from '../../components/user-health/user-health.uvue'
import Toolbox from '../../components/toolbox/toolbox.uvue'

