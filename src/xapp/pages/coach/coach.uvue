function _pad2(n : number) : string { return n < 10 ? `0${n}` : `${n}` }

function _parseMs(v : any | null) : number {
  if (v == null) return NaN
  try {
    const s = `${v}`
    const ms = parseFloat(s)
    if (!isNaN(ms) && s.indexOf('-') == -1 && s.indexOf(':') == -1) return ms
    return new Date(s).getTime()
  } catch (e : any) {
    return NaN
  }
}

function fmtTime(v : any | null) : string {
  const ms = _parseMs(v)
  if (isNaN(ms)) return ''
  const d = new Date(ms)
  return `${d.getMonth() + 1}/${d.getDate()} ${_pad2(d.getHours())}:${_pad2(d.getMinutes())}`
}

function fmtDate(v : any | null) : string {
  if (v == null) return '—'
  const ms = _parseMs(v)
  if (isNaN(ms)) return `${v}`
  const d = new Date(ms)
  return `${d.getFullYear()}/${d.getMonth() + 1}/${d.getDate()}`
}

function fmtAnswer(v : any | null) : string {
  if (v == null) return '—'
  if (v instanceof Array) {
    const parts : string[] = []
    for (const item of (v as Array<any>)) parts.push(`${item}`)
    return parts.join(', ')
  }
  if (v instanceof UTSJSONObject) {
    const parts : string[] = []
    ;(v as UTSJSONObject).toMap().forEach((val : any | null, k : string) => { parts.push(`${k}: ${val}`) })
    return parts.join('  ')
  }
  return `${v}`
}

function todayStr() : string {
  const d = new Date()
  return `${d.getFullYear()}-${_pad2(d.getMonth() + 1)}-${_pad2(d.getDate())}`
}

function chronoAge(birthDate : string | null) : number | null {
  if (birthDate == null || birthDate!.length == 0) return null
  const ms = _parseMs(birthDate)
  if (isNaN(ms)) return null
  return Math.floor((Date.now() - ms) / (1000 * 60 * 60 * 24 * 365.25))
}

// uni.request's awaitable overload only resolves in module scope with a RequestMethod-TYPED
// parameter (mirrors utils/request.uts's _run); inside component methods the same call shape
// silently selects the RequestTask overload (full-build Kotlin error).
async function _envelopeRun(url : string, method : RequestMethod, data : UTSJSONObject | null, timeoutMs : number) : Promise<RespEnvelope> {
  const header = { 'Content-Type': 'application/json', 'Authorization': `Bearer ${state.apiToken}` } as UTSJSONObject
  let res : RequestSuccess<UTSJSONObject> | null = null
  await new Promise<boolean>((resolve : (v : boolean) => void, _reject : (e : any | null) => void) => {
    uni.request<UTSJSONObject>({
      url: url, method: method, header: header, data: data, timeout: timeoutMs,
      success: (r) => { res = r; resolve(true) },
      fail: (err) => { resolve(false) },
    })
  })
  if (res == null) return new RespEnvelope(0, null)
  checkAuthStatus(res!.statusCode)
  return new RespEnvelope(res!.statusCode, res!.data)
}


export default {
  name: 'CoachPage',
  components: { UserHealth, Toolbox },
  data() {
    return {
      lang: 'zh',
      t: T_ZH as UTSJSONObject,
      // Mirror of _coachId (data is unreachable from... templates can't read underscore
      // fields) — kept in step at both assignment sites, same as the miniapp.
      coachId: '' as string,
      textScale: 0 as number,
      tab: 'clients',
      tabKeys: ['clients', 'invites', 'earnings', 'questionnaires', 'crm'] as string[],
      detailTabs: ['health', 'chat', 'plans', 'notes', 'goals', 'facts'] as string[],
      detailTabOrder: ['health', 'plans', 'chat', 'notes', 'goals', 'facts'] as string[],
      statusBarHeight: 0,
      theme: 'dark',
      sandboxMode: false,
      sandboxBannerText: '',
      menuOpen: false,
      nickname: '',
      clients: [] as UTSJSONObject[],
      filteredClients: [] as UTSJSONObject[],
      clientsLoadState: '',
      diagText: '',
      clientSearch: '',
      clientStageFilter: '',
      clientFilterStages: [] as UTSJSONObject[],
      invites: [] as UTSJSONObject[],
      mcEnabled: false,
      detailOpen: false,
      detailClient: null as UTSJSONObject | null,
      detailTab: 'health',
      chatMessages: [] as UTSJSONObject[],
      chatScrollTop: 0,
      msgText: '',
      msgBusy: false,
      chatToolBusy: false,
      vivaThinking: false,
      _coachId: '' as string,
      _coachChannelId: 0 as number,
      _coachUserId: '' as string,
      _repairAttempted: false,
      _vivaPollTimer: 0 as number,
      earningsThisMonth: '—' as string,
      earningsAvailable: '—' as string,
      earningsPayouts: [] as UTSJSONObject[],
      reminderOpen: false,
      reminderDate: todayStr() as string,
      reminderTime: '08:00',
      reminderText: '',
      reminderRecurrence: 'none',
      reminderBusy: false,
      questionnaires: [] as UTSJSONObject[],
      qAssignOpen: false,
      qAssignQuestionnaire: null as UTSJSONObject | null,
      qAssignSelectedIds: [] as string[],
      qAssignBusy: false,
      qResponsesOpen: false,
      qResponsesList: [] as UTSJSONObject[],
      clientNotes: [] as UTSJSONObject[],
      noteText: '',
      notesBusy: false,
      clientGoals: [] as UTSJSONObject[],
      clientFacts: [] as UTSJSONObject[],
      factText: '',
      factsBusy: false,
      detailPlans: [] as UTSJSONObject[],
      detailPrograms: [] as UTSJSONObject[],
      planTemplates: [] as UTSJSONObject[],
      planRecommendOpen: false,
      planCustomOpen: false,
      planCustomName: '',
      planCustomGoal: '',
      planCustomDurationStr: '4',
      programActionBusy: false,
      planActionBusy: false,
      crmPipelineColumns: [] as UTSJSONObject[],
      crmActivityFeed: [] as UTSJSONObject[],
      crmUpcomingAppts: [] as UTSJSONObject[],
      kpiData: null as UTSJSONObject | null,
      apptFormOpen: false,
      apptClientId: '',
      apptClientName: '',
      apptTitleText: '',
      apptDate: todayStr() as string,
      apptTime: '10:00',
      apptFormat: 'video',
      apptFormats: ['video', 'phone', 'in_person', 'wechat'] as string[],
      apptLink: '',
      apptBusy: false,
      mcFormOpen: false,
      mcEditId: '',
      mcLast: '',
      mcFirst: '',
      mcNickname: '',
      mcBirthDate: '',
      mcGender: '',
      mcPhone: '',
      mcRef: '',
      mcBusy: false,
      redeemOpen: false,
      redeemCode: '',
      redeemName: '',
      redeemPhone: '',
      redeemAddress: '',
      redeemBusy: false,
      // ── pages/coach parity (the miniapp's own state; the web template renders all of it) ──
      loading: true,
      channelName: 'NANO',
      channelLogo: '/static/waven-logo-icon.png',
      reminderTarget: null as UTSJSONObject | null,
      qResponsesUser: null as UTSJSONObject | null,
      qResponsesLoading: false,
      goalFormOpen: false,
      goalType: 'bio_age',
      goalTypeKeys: ['bio_age', 'sub_age', 'weight', 'steps', 'sleep_score', 'hrv', 'custom'] as string[],
      goalTargetValue: '',
      goalTargetDate: '',
      goalBusy: false,
      factCategoryKeys: ['dietary_restriction', 'allergy', 'preference', 'goal', 'other'] as string[],
      factCategoryIndex: 2,
      chatToolboxOpen: false,
      chatToolList: [] as ToolItem[],
      topImprovers: [] as UTSJSONObject[],
      chatLoading: false,
      detailPlansLoading: false,
      clientNotesLoading: false,
      clientFactsLoading: false,
      clientGoalsLoading: false,
      crmLoading: false,
      kpiLoading: false,
      earningsLoading: false,
      questionnairesLoading: false,
    }
  },
  computed: {
    detailIsManaged() : boolean {
      const c = this.detailClient
      return c != null && c!.getString('account_type') == 'managed'
    }
  },
  onLoad(_options : OnLoadOptions) {
    const user = state.user
    if (user == null) { uni.reLaunch({ url: '/pages/login/login' }); return }
    const roles = user!.getArray<string>('roles') ?? ([] as string[])
    let isCoach = false
    let isAdmin = false
    let isSuperadmin = false
    for (const r of roles) {
      if (r == 'coach') isCoach = true
      if (r == 'admin') isAdmin = true
      if (r == 'superadmin') isSuperadmin = true
    }
    if (!isCoach && !isAdmin && !isSuperadmin) {
      uni.showToast({ title: _tr(T_ZH, 'noPermission'), icon: 'none' })
      uni.reLaunch({ url: '/pages/main/main' })
      return
    }
    const coach = state.coach
    this._coachId = idOf(coach, 'id')
    this.coachId = this._coachId
    this._coachChannelId = coach != null ? (coach!.getNumber('channel_id') ?? 0) : 0
    this._coachUserId = user!.getString('user_id') ?? ''
    this.textScale = state.textScale
    const info = uni.getWindowInfo()
    this.statusBarHeight = info.statusBarHeight
    this.nickname = user!.getString('nickname') ?? ''
    this.theme = user!.getString('theme') ?? state.theme
    this.lang = state.lang
    this.t = this.lang == 'en' ? T_EN : T_ZH
    this.sandboxMode = state.sandboxMode
    if (this.sandboxMode) {
      this.sandboxBannerText = _tr(this.t, 'sandboxBanner').split('{name}').join(this.nickname.length > 0 ? this.nickname : '—')
    }
    const channel = state.channel
    if (channel != null) {
      this.channelName = channel!.getString('name') ?? 'NANO'
      const logo = channel!.getString('logo_url')
      if (logo != null && logo!.length > 0) this.channelLogo = logo!
    }
    this.chatToolList = getToolList(this.t)
    this._loadAll().then(() => { this.loading = false })
    syncRootClasses(this.theme, this.textScale)
  },
  // A backgrounded coach must not keep a stale client list indefinitely (2026-08-30):
  // onShow refetches. onLoad already ran once, so guard on the resolved user id.
  onShow() {
    if (this._coachUserId.length > 0 && this.clients.length > 0) this._loadAll()
  },
  onUnload() { this._stopVivaPoll() },
  // Web: theme / text scale tokens live on <html> (utils/web-ui.uts syncRootClasses).
  watch: {
    theme(v : string) { syncRootClasses(v, this.textScale) },
    textScale(v : number) { syncRootClasses(this.theme, v) },
  },
  methods: {
    tr(path : string) : string { return _tr(this.t, path) },
    detailTabLabel(dt : string) : string {
      if (dt == 'health') return this.tr('tabHealth')
      if (dt == 'plans') return this.tr('tabPlans')
      if (dt == 'chat') return this.tr('tabChat')
      if (dt == 'notes') return this.tr('tabNotes')
      if (dt == 'goals') return this.tr('tabGoals')
      return this.tr('tabFacts')
    },
    kpiField(key : string) : string {
      const k = this.kpiData
      if (k == null) return '—'
      const v = k!.getNumber(key)
      return v != null ? `${v}` : '—'
    },
    factCatLabel(cat : string | null) : string {
      if (cat == null) return ''
      return _tr(this.t, 'factCategories.' + cat!)
    },

    async _loadAll() {
      if (this._coachId.length == 0) {
        const repaired = await this._repairCoachSession()
        if (repaired) { this._loadAll(); return }
        // Invites key on the user id, not the coach id — they still load (§2026-08-30).
        let invites : UTSJSONObject[] = []
        const listRes = await this._req(`${BASE}/api/invitations?created_by=${encodeURIComponent(this._coachUserId)}`, 'GET', null, 0)
        if (listRes.data != null) {
          const arr = listRes.data!.getArray<UTSJSONObject>('invitations')
          if (arr != null) invites = arr!
        }
        this.invites = invites
        this.clients = [] as UTSJSONObject[]
        this.filteredClients = [] as UTSJSONObject[]
        this.clientFilterStages = [] as UTSJSONObject[]
        this.clientsLoadState = 'no_coach'
        this.diagText = this._diagText(0, null)
        return
      }
      const clientsRes = await this._req(`${BASE}/api/coach-users/${this._coachId}`, 'GET', null, 0)
      const invitesRes = await this._req(`${BASE}/api/invitations?created_by=${encodeURIComponent(this._coachUserId)}`, 'GET', null, 0)
      const payload = clientsRes.data
      const usersArr = payload != null ? payload!.getArray<UTSJSONObject>('users') : null
      if (payload == null || usersArr == null) {
        this.clientsLoadState = 'failed'
        this.diagText = this._diagText(clientsRes.statusCode, null)
        uni.showToast({ title: this.tr('clientsLoadFailed'), icon: 'none' })
        return
      }
      const built : UTSJSONObject[] = []
      for (const u of usersArr!) {
        const cAge = chronoAge(u.getString('birth_date'))
        const bioAge = u.getNumber('bio_age')
        let deltaStr = '—'
        let deltaColor = '#A6C4E5'
        if (bioAge != null) {
          deltaColor = (cAge != null && bioAge! <= cAge!) ? '#10b981' : '#ef4444'
          if (cAge != null) {
            const d = (bioAge! - cAge!).toFixed(1)
            deltaStr = `${bioAge!.toFixed(1)} (${d} ${parseFloat(d) > 0 ? this.tr('older') : this.tr('younger')})`
          } else {
            deltaStr = bioAge!.toFixed(1)
          }
        }
        const row = new UTSJSONObject()
        u.toMap().forEach((v : any | null, k : string) => { row[k] = v })
        row['_cAge'] = cAge
        row['_bioAgeStr'] = deltaStr
        row['_bioAgeColor'] = deltaColor
        row['_lastScanFmt'] = u.getString('last_scan_at') != null ? fmtDate(u['last_scan_at']) : '—'
        const nick = u.getString('nickname') ?? 'U'
        row['_avatar'] = nick!.length > 0 ? nick!.substring(0, 1).toUpperCase() : 'U'
        row['_hasScan'] = u.getString('last_scan_at') != null
        row['_joinedFmt'] = fmtDate(u['created_at'])
        row['_lastMsgTimeFmt'] = u.getString('last_user_msg_at') != null ? fmtTime(u['last_user_msg_at']) : null
        const tagObjs = u.getArray<UTSJSONObject>('crm_tag_objects')
        const tags : UTSJSONObject[] = []
        if (tagObjs != null) { for (const tg of tagObjs!) { if (tg != null && tags.length < 4) tags.push(tg) } }
        row['_crmTags'] = tags
        const subs : UTSJSONObject[] = []
        const bioData = u.getJSON('bio_data')
        const profile = bioData != null ? bioData!.getJSON('bioage_profile') : null
        const subRaw = profile != null ? profile!.getJSON('SubAges') : null
        if (subRaw != null) {
          for (let s = 0; s < SUB_AGE_KEYS.length; s++) {
            const v = subRaw!.getNumber(SUB_AGE_KEYS[s])
            subs.push({
              key: SUB_AGE_KEYS[s],
              label: this.lang == 'zh' ? SUB_AGE_SHORT_ZH[s] : SUB_AGE_SHORT_EN[s],
              color: SUB_AGE_COLORS[s],
              value: v != null ? v!.toFixed(1) : null,
            } as UTSJSONObject)
          }
        }
        row['_subAges'] = subs
        const lm = u.getString('last_user_msg')
        row['_lastUserMsg'] = lm != null ? lm!.substring(0, Math.min(100, lm!.length)) : null
        const crmStage = u.getString('crm_stage')
        row['_crmStagePill'] = (crmStage != null && crmStage!.length > 0)
          ? { label: _tr(this.t, 'crmStages.' + crmStage!), color: STAGE_COLORS.get(crmStage!) ?? '#6b7280' } as UTSJSONObject
          : null
        built.push(row)
      }
      this.clients = built
      this.clientFilterStages = this._buildFilterStages(built)
      const inv : UTSJSONObject[] = []
      if (invitesRes.data != null) {
        const arr = invitesRes.data!.getArray<UTSJSONObject>('invitations')
        if (arr != null) { for (const v of arr!) inv.push(v) }
      }
      this.invites = inv
      this.clientsLoadState = ''
      this.diagText = ''
      this.mcEnabled = payload!.getBoolean('managed_customers_enabled') == true
      this._filterClients()
    },

    // Re-resolve the coach identity from the server and repair the stored session — a login
    // that captured globalData.coach=null keeps it across relaunches while roles DO refresh.
    async _repairCoachSession() : Promise<boolean> {
      if (this._repairAttempted) return false
      this._repairAttempted = true
      const res = await this._req(`${BASE}/api/my-coach?user_id=${encodeURIComponent(this._coachUserId)}`, 'GET', null, 0)
      if (res.data == null || res.data!.getBoolean('success') != true) return false
      const coach = res.data!.getJSON('coach')
      if (coach == null || idOf(coach, 'id').length == 0) return false
      state.coach = coach
      uni.setStorageSync('nano_coach', coach!)
      this._coachId = idOf(coach, 'id')
      this.coachId = this._coachId
      this._coachChannelId = coach!.getNumber('channel_id') ?? 0
      return true
    },

    _diagText(statusCode : number, err : string | null) : string {
      const host = API_ORIGIN.replace('https://', '').replace('http://', '')
      const parts : string[] = [`${host} · coach=${this._coachId.length == 0 ? 'null' : this._coachId}`, `v${VERSION}`]
      if (statusCode > 0) parts.push(`HTTP ${statusCode}`)
      if (err != null) parts.push(err!.substring(0, Math.min(40, err!.length)))
      return parts.join(' · ')
    },

    onClientsRefresh() { this._loadAll() },
    switchTab(tk : string) {
      this.tab = tk
      if (tk == 'earnings' && this.earningsThisMonth == '—') { this.earningsLoading = true; this._loadEarnings().then(() => { this.earningsLoading = false }) }
      if (tk == 'questionnaires' && this.questionnaires.length == 0) { this.questionnairesLoading = true; this._loadQuestionnaires().then(() => { this.questionnairesLoading = false }) }
      if (tk == 'crm') { this.crmLoading = true; this._loadCRM().then(() => { this.crmLoading = false }) }
    },
    handleBack() { uni.navigateBack() },
    toggleMenu() { this.menuOpen = !this.menuOpen },
    toggleLang() {
      this.lang = this.lang == 'zh' ? 'en' : 'zh'
      state.lang = this.lang
      this.t = this.lang == 'zh' ? T_ZH : T_EN
      this.menuOpen = false
      this.clientFilterStages = this._buildFilterStages(this.clients)
    },
    async toggleTheme() {
      this.theme = this.theme == 'dark' ? 'light' : 'dark'
      state.theme = this.theme
      const user = state.user
      if (user != null) user!['theme'] = this.theme
      const su1 = state.user
      if (su1 != null) uni.setStorageSync('nano_user', su1)
      this.menuOpen = false
      await this._req(`${BASE}/api/users/${this._coachUserId}`, 'PUT', { theme: this.theme } as UTSJSONObject, 0)
    },
    openUserPanel() {
      this.menuOpen = false
      uni.navigateBack()
    },
    exitSandbox() {
      const originRaw = uni.getStorageSync('nano_sandbox_origin')
      uni.removeStorageSync('nano_sandbox_origin')
      uni.removeStorageSync('nano_sandbox_active')
      state.sandboxMode = false
      if (originRaw != null && originRaw instanceof UTSJSONObject) {
        const origin = originRaw as UTSJSONObject
        const u = origin.getJSON('user')
        if (u != null) {
          state.user = u
          state.channel = origin.getJSON('channel')
          state.coach = origin.getJSON('coach')
          uni.setStorageSync('nano_user', u)
          const chn = origin.getJSON('channel')
          if (chn != null) uni.setStorageSync('nano_channel', chn)
          const co1 = origin.getJSON('coach')
          if (co1 != null) uni.setStorageSync('nano_coach', co1)
          uni.reLaunch({ url: '/pages/main/main' })
          return
        }
      }
      uni.removeStorageSync('nano_user')
      state.user = null
      uni.reLaunch({ url: '/pages/login/login' })
    },
    handleLogout() {
      this.menuOpen = false
      if (state.sandboxMode) { this.exitSandbox(); return }
      const user = state.user
      if (user != null && user!.getBoolean('guest') != true) {
        const snap = new UTSJSONObject()
        user!.toMap().forEach((v : any | null, k : string) => {
          if (k == 'phone' || k == 'email') return
          snap[k] = v
        })
        const storedMasked = user!.getString('maskedPhone')
        const m = storedMasked != null && storedMasked!.length > 0 ? storedMasked : maskPhone(user!.getString('phone'))
        uni.setStorageSync('nano_last_session', {
          user: snap, channel: state.channel, coach: state.coach, maskedPhone: m, session_token: state.apiToken,
        } as UTSJSONObject)
      }
      uni.removeStorageSync('nano_user')
      clearSession()
      state.user = null
      uni.reLaunch({ url: '/pages/login/login?loggedOut=1' })
    },

    _buildFilterStages(clients : UTSJSONObject[]) : UTSJSONObject[] {
      const counts = new Map<string, number>()
      for (const c of clients) {
        const s = c.getString('crm_stage') ?? 'lead'
        counts.set(s, (counts.get(s) ?? 0) + 1)
      }
      const out : UTSJSONObject[] = []
      for (const s of STAGE_ORDER) {
        const n = counts.get(s)
        if (n == null || n! <= 0) continue
        out.push({ stage: s, label: _tr(this.t, 'crmStages.' + s), color: STAGE_COLORS.get(s) ?? '#6b7280', count: n } as UTSJSONObject)
      }
      return out
    },
    _filterClients() {
      const q = this.clientSearch.trim().toLowerCase()
      const stage = this.clientStageFilter
      const out : UTSJSONObject[] = []
      for (const c of this.clients) {
        const cs = c.getString('crm_stage') ?? 'lead'
        if (stage.length > 0 && cs != stage) continue
        if (q.length > 0) {
          const nick = c.getString('nickname') ?? ''
          if (nick!.toLowerCase().indexOf(q) == -1) continue
        }
        out.push(c)
      }
      this.filteredClients = out
    },
    setStageFilter(stage : string) {
      this.clientStageFilter = stage
      this._filterClients()
    },

    openClientDetail(index : number, tabKey : string) {
      const c = this.filteredClients[index]
      if (c == null) return
      this.openClientDetailFor(c, tabKey)
    },
    openClientDetailFor(c : UTSJSONObject, tabKey : string) {
      this.detailOpen = true
      this.detailClient = c
      this.detailTab = tabKey == 'messages' ? 'chat' : tabKey
      this.chatMessages = [] as UTSJSONObject[]
      this.msgText = ''
      if (this.detailTab == 'chat') this._loadClientChat()
    },
    onClientProfileUpdated(updated : UTSJSONObject) {
      this.detailClient = updated
      const uid = updated.getString('user_id') ?? ''
      for (let i = 0; i < this.clients.length; i++) {
        if (`${this.clients[i]['user_id']}` == uid) this.clients[i] = updated
      }
      this._filterClients()
    },
    closeClientDetail() {
      this._stopVivaPoll()
      this.vivaThinking = false
      this.detailOpen = false
      this.detailClient = null
      this.chatMessages = [] as UTSJSONObject[]
      this.msgText = ''
      this.chatToolboxOpen = false
      this.goalFormOpen = false
    },
    switchDetailTab(tab : string) {
      this.detailTab = tab
      if (tab == 'chat' && this.chatMessages.length == 0) this._loadClientChat()
      if (tab == 'plans') { this.detailPlansLoading = true; this._loadClientPlans().then(() => { this.detailPlansLoading = false }) }
      if (tab == 'notes') { this.clientNotesLoading = true; this._loadClientNotes().then(() => { this.clientNotesLoading = false }) }
      if (tab == 'goals') { this.clientGoalsLoading = true; this._loadClientGoals().then(() => { this.clientGoalsLoading = false }) }
      if (tab == 'facts') { this.clientFactsLoading = true; this._loadClientFacts().then(() => { this.clientFactsLoading = false }) }
    },
    // pages/coach handleRefresh — the header refresh.
    handleRefresh() {
      this._loadAll()
      if (this.tab == 'earnings') this._loadEarnings()
      if (this.tab == 'questionnaires') this._loadQuestionnaires()
    },
    noop() {},
    // Chat (web): the main chat's dictionary, segments and tag styles — see the chat panel.
    mt(key : string) : string { return trPath(this.lang == 'en' ? T_MAIN_EN : T_MAIN_ZH, key) },
    sh(h : string) : string { return inlineTagStyles(h) },
    segsOf(m : UTSJSONObject) : Segment[] {
      const v = m['_segs']
      return v != null ? (v as Segment[]) : ([] as Segment[])
    },
    toggleFormulaTier(ft : FormulaTier) {
      ft.open = !ft.open
      this.chatMessages = this.chatMessages.slice(0)
    },
    _scrollChatBottom() {
      setTimeout(() => { this.chatScrollTop = (this.chatMessages.length + 1) * 100000 }, 60)
    },

    async _loadClientChat() {
      const client = this.detailClient
      if (client == null) return
      const params = `user_id=${encodeURIComponent(client!.getString('user_id') ?? '')}${this._coachId.length > 0 ? '&coach_id=' + this._coachId : ''}`
      this.chatLoading = true
      const res = await this._req(`${BASE}/api/coach-user-chat?${params}`, 'GET', null, 0)
      this.chatLoading = false
      const msgs = res.data != null ? res.data!.getArray<UTSJSONObject>('messages') : null
      const out : UTSJSONObject[] = []
      if (msgs != null) {
        for (const m of msgs!) {
          const row = new UTSJSONObject()
          m.toMap().forEach((v : any | null, k : string) => { row[k] = v })
          const role = m.getString('role')
          if (role == 'coach') {
            const content = m.getString('content') ?? ''
            row['content'] = content!.split('\n').join(' ') // coach messages are single-line bubbles (miniapp rule)
          }
          row['_time'] = fmtTime(m['created_at'])
          row['_isUser'] = role == 'user'
          row['_isCoach'] = role == 'coach'
          if (role != 'user' && role != 'coach') row['_segs'] = mdToSegments(m.getString('content') ?? '')
          out.push(row)
        }
      }
      this.chatMessages = out
      if (out.length > 0) this._scrollChatBottom()
    },

    toggleChatToolbox() {
      if (this.chatToolBusy && !this.chatToolboxOpen) return
      this.chatToolboxOpen = !this.chatToolboxOpen
    },
    // From the toolbox component: { action, tempFilePath? } (it picks the image itself).
    handleChatToolAction(e : any | null) {
      if (e == null || this.detailClient == null || this.chatToolBusy) return
      const detail = e as UTSJSONObject
      const action = detail.getString('action') ?? ''
      this.chatToolboxOpen = false
      if (action == 'upload_image') {
        const path = detail.getString('tempFilePath')
        if (path != null) runUploadImage(this.detailClient!.getString('user_id') ?? '', this.t, this._makeCtx(), path!)
        return
      }
      this.runTool(action)
    },
    runTool(action : string) {
      const client = this.detailClient
      if (client == null || this.chatToolBusy) return
      if (action == 'upload_image') {
        uni.chooseImage({
          count: 1,
          success: (res) => {
            const paths = res.tempFilePaths
            if (paths.length > 0) doUpload(`${paths[0]}`, client!.getString('user_id') ?? '', this.t, this._makeCtx())
          }
        })
        return
      }
      const uid = client!.getString('user_id') ?? ''
      const ctx = this._makeCtx()
      if (action == 'test_chip') runTestChip(uid, this.t, ctx)
      else if (action == 'formula_dots') runFormulaDs(uid, this.t, ctx, new ToolOpts())
      else if (action == 'health_advice') runHealthAdvice(uid, this.t, ctx, new ToolOpts())
    },
    _makeCtx() : ToolCtx {
      const ctx = new ToolCtx(
        (role : string, content : string, persist : boolean) : void => { this._addChatMsg(role, content, persist) },
        (url : string, method : string, body : UTSJSONObject | null, timeoutMs : number) : Promise<RespEnvelope> => this._req(url, method, body, timeoutMs),
        (v : boolean) : void => { this.chatToolBusy = v }
      )
      ctx.addImageMsg = (tempPath : string) : string => this._addChatImageMsg(tempPath)
      ctx.updateImageMsg = (msgId : string, permanentUrl : string | null) : void => { this._updateChatImageMsg(msgId, permanentUrl) }
      return ctx
    },

    _addChatMsg(role : string, content : string, persist : boolean) {
      const persistRole = role == 'user' ? 'coach' : role
      const msg = {
        id: `${role}-${Date.now()}`, role: persistRole, content: content,
        imageUrl: null as string | null, _time: '',
      } as UTSJSONObject
      if (persistRole != 'user' && persistRole != 'coach') msg['_segs'] = mdToSegments(content)
      this.chatMessages.push(msg)
      this._scrollChatBottom()
      const client = this.detailClient
      if (persist && client != null) {
        this._req(`${BASE}/api/chat-messages`, 'POST', {
          openid: client!.getString('user_id'), role: persistRole, content: content,
        } as UTSJSONObject, 0)
      }
    },
    _addChatImageMsg(tempPath : string) : string {
      const id = `img-${Date.now()}`
      this.chatMessages.push({ id: id, role: 'coach', content: '', imageUrl: tempPath, _time: '' } as UTSJSONObject)
      this._scrollChatBottom()
      return id
    },
    _updateChatImageMsg(id : string, permanentUrl : string | null) {
      const out : UTSJSONObject[] = []
      for (const m of this.chatMessages) {
        if (idOf(m, 'id') == id) m['imageUrl'] = permanentUrl
        out.push(m)
      }
      this.chatMessages = out
    },

    async sendMessage() {
      const client = this.detailClient
      const text = this.msgText.trim()
      if (text.length == 0 || client == null) return
      if (this.detailIsManaged) { this._askVivaAboutCustomer(); return }
      this.msgBusy = true
      const res = await this._req(`${BASE}/api/coach-instruction`, 'POST', {
        openid: client!.getString('user_id'),
        instruction: text.split('\n').join(' '),
      } as UTSJSONObject, 0)
      this.msgBusy = false
      if (res.statusCode >= 200 && res.statusCode < 300) {
        uni.showToast({ title: this.tr('sent'), icon: 'success' })
        this.msgText = ''
        this._loadClientChat()
      } else {
        uni.showToast({ title: this.tr('sendError'), icon: 'none' })
      }
    },

    // §49: managed customer never reads chat — coach asks Viva ABOUT them (speaker:'coach').
    // Agentic turns land async; no notification poll on this page → 285s thread poll.
    async _askVivaAboutCustomer() {
      const client = this.detailClient
      const text = this.msgText.trim()
      if (client == null) return
      this.msgBusy = true
      const res = await this._req(`${BASE}/api/chat`, 'POST', {
        openid: client!.getString('user_id'), message: text, speaker: 'coach', client: 'coach',
      } as UTSJSONObject, 90000)
      this.msgBusy = false
      const d = res.data
      if (d == null || d.getBoolean('success') != true) {
        uni.showToast({ title: this.tr('sendError'), icon: 'none' })
        return
      }
      this.msgText = ''
      if (d.getBoolean('processing') == true) {
        this.vivaThinking = true
        this._loadClientChat()
        this._startVivaPoll(d.getString('user_message_id'))
      } else {
        this._loadClientChat()
      }
    },
    _startVivaPoll(afterId : string | null) {
      this._stopVivaPoll()
      const deadline = Date.now() + 285000
      const client = this.detailClient
      const userId = client != null ? (client!.getString('user_id') ?? '') : ''
      var tick : (() => Promise<void>) | null = null
      tick = async () : Promise<void> => {
        const cur = this.detailClient
        if (cur == null || cur!.getString('user_id') != userId) { this._stopVivaPoll(); return }
        const params = `user_id=${encodeURIComponent(userId)}${this._coachId.length > 0 ? '&coach_id=' + this._coachId : ''}`
        const res = await this._req(`${BASE}/api/coach-user-chat?${params}`, 'GET', null, 0)
        const msgs = res.data != null ? res.data!.getArray<UTSJSONObject>('messages') : null
        if (msgs != null) {
          for (const m of msgs!) {
            if (m.getString('role') != 'ai') continue
            const idn = m.getNumber('id')
            if (afterId == null || idn == null || idn! > parseFloat(afterId!)) {
              this._stopVivaPoll()
              this.vivaThinking = false
              this._loadClientChat()
              return
            }
          }
        }
        if (Date.now() > deadline) {
          this._stopVivaPoll()
          this.vivaThinking = false
          uni.showToast({ title: this.tr('mc.noReply'), icon: 'none' })
          return
        }
        this._vivaPollTimer = setTimeout(() => { if (tick != null) tick!() }, 3000)
      }
      this._vivaPollTimer = setTimeout(() => { if (tick != null) tick!() }, 3000)
    },
    _stopVivaPoll() {
      if (this._vivaPollTimer != 0) clearTimeout(this._vivaPollTimer)
      this._vivaPollTimer = 0
    },

    openReminderFor(client : UTSJSONObject) {
      this.openReminderComposer()
      this.reminderTarget = client
    },
    openReminderComposer() {
      this.reminderTarget = null
      this.reminderOpen = true
      this.reminderText = ''
      this.reminderDate = todayStr()
      this.reminderTime = '08:00'
      this.reminderRecurrence = 'none'
      this.reminderBusy = false
    },
    closeReminderComposer() {
      if (this.reminderBusy) return
      this.reminderOpen = false
    },
    onReminderDateChange(e : UniPickerChangeEvent) { this.reminderDate = e.detail.value as string },
    onReminderTimeChange(e : UniPickerChangeEvent) { this.reminderTime = e.detail.value as string },
    setRecurrence(val : string) { this.reminderRecurrence = val },
    async submitReminder() {
      const client = this.reminderTarget ?? this.detailClient
      if (client == null) return
      const text = this.reminderText.trim()
      if (text.length == 0 || this.reminderDate.length == 0 || this.reminderTime.length == 0) return
      this.reminderBusy = true
      const res = await this._req(`${BASE}/api/reminders`, 'POST', {
        user_id: client!.getString('user_id'),
        coach_id: this._coachId,
        content: text,
        scheduled_for: `${this.reminderDate}T${this.reminderTime}:00+08:00`,
        recurrence: this.reminderRecurrence == 'none' ? null : this.reminderRecurrence,
      } as UTSJSONObject, 0)
      this.reminderBusy = false
      if (res.statusCode >= 200 && res.statusCode < 300) {
        uni.showToast({ title: this.tr('reminderSent'), icon: 'success' })
        this.reminderOpen = false
      } else {
        uni.showToast({ title: this.tr('reminderError'), icon: 'none' })
      }
    },

    generateInvite() {
      if (this._coachChannelId == 0) { uni.showToast({ title: this.tr('networkError'), icon: 'none' }); return }
      uni.showModal({
        title: this.tr('invite.generate'), editable: true, placeholderText: this.tr('invite.notePlaceholder'),
        success: (res) => { (async () : Promise<void> => {
          if (!res.confirm) return
          const note = res.content != null ? res.content!.trim() : ''
          await this._req(`${BASE}/api/invitations`, 'POST', {
            created_by: this._coachUserId, channel_id: this._coachChannelId, type: 'coach', note: note,
          } as UTSJSONObject, 0)
          this._loadAll()
        })() }
      })
    },
    editInviteNote(i : number) {
      const invite = this.invites[i]
      if (invite == null) return
      uni.showModal({
        title: this.tr('invite.editNote'), editable: true,
        content: invite.getString('note') ?? '', placeholderText: this.tr('invite.notePlaceholder'),
        success: (res) => { (async () : Promise<void> => {
          if (!res.confirm) return
          const note = res.content != null ? res.content!.trim() : ''
          await this._req(`${BASE}/api/invitations/${invite.getNumber('id')}`, 'PUT', { note: note } as UTSJSONObject, 0)
          uni.showToast({ title: this.tr('invite.noteSaved'), icon: 'success' })
          this._loadAll()
        })() }
      })
    },
    copyInvite(i : number) {
      const invite = this.invites[i]
      if (invite == null) return
      uni.setClipboardData({
        data: `pages/login/login?invite=${invite.getString('code')}`,
        success: () => { uni.showToast({ title: this.tr('invite.copied'), icon: 'success' }) }
      })
    },
    deactivateInvite(i : number) {
      const invite = this.invites[i]
      if (invite == null) return
      uni.showModal({
        title: this.tr('invite.deactivate'), content: this.tr('invite.deactivateWarning'),
        success: (res) => { (async () : Promise<void> => {
          if (!res.confirm) return
          await this._req(`${BASE}/api/invitations/${invite.getNumber('id')}`, 'DELETE', null, 0)
          this._loadAll()
        })() }
      })
    },

    async _loadEarnings() {
      if (this._coachUserId.length == 0) return
      const res = await this._req(`${BASE}/api/coach-earnings?coach_user_id=${encodeURIComponent(this._coachUserId)}`, 'GET', null, 0)
      const d = res.data
      if (d == null) return
      const payouts : UTSJSONObject[] = []
      const arr = d!.getArray<UTSJSONObject>('payouts')
      if (arr != null) {
        for (const p of arr!) {
          const row = new UTSJSONObject()
          p.toMap().forEach((v : any | null, k : string) => { row[k] = v })
          const amt = p.getNumber('total_cny')
          row['_amountFmt'] = `¥${(amt != null ? amt! : 0).toFixed(2)}`
          const st = p.getString('status') ?? ''
          row['_statusFmt'] = _tr(this.t, 'earnings.' + st)
          payouts.push(row)
        }
      }
      const pending = d!.getNumber('this_month_pending')
      const avail = d!.getNumber('available_cny')
      this.earningsThisMonth = `¥${(pending != null ? pending! : 0).toFixed(2)}`
      this.earningsAvailable = `¥${(avail != null ? avail! : 0).toFixed(2)}`
      this.earningsPayouts = payouts
    },

    async _loadQuestionnaires() {
      const params = this._coachChannelId != 0 ? `channel_id=${this._coachChannelId}` : ''
      const res = await this._req(`${BASE}/api/questionnaires?${params}`, 'GET', null, 0)
      const arr = res.data != null ? res.data!.getArray<UTSJSONObject>('questionnaires') : null
      const out : UTSJSONObject[] = []
      if (arr != null) {
        for (const q of arr!) {
          const type = q.getString('type') ?? ''
          // Allowlist, never a denylist: 'dynamic' and 'viva_ag' are person-scoped one-offs —
          // assigning either hands a client questions written about someone else.
          if (q.getBoolean('is_active') == true && ASSIGNABLE_TYPES.indexOf(type) >= 0) out.push(q)
        }
      }
      this.questionnaires = out
    },
    openQAssign(i : number) {
      const q = this.questionnaires[i]
      if (q == null) return
      this.qAssignOpen = true
      this.qAssignQuestionnaire = q
      this.qAssignSelectedIds = [] as string[]
    },
    closeQAssign() {
      if (this.qAssignBusy) return
      this.qAssignOpen = false
      this.qAssignQuestionnaire = null
    },
    toggleQUser(uid : string | null) {
      if (uid == null) return
      const idx = this.qAssignSelectedIds.indexOf(uid!)
      if (idx >= 0) this.qAssignSelectedIds.splice(idx, 1)
      else this.qAssignSelectedIds.push(uid!)
    },
    async submitQAssign() {
      if (this.qAssignSelectedIds.length == 0) {
        uni.showToast({ title: this.tr('questionnaires.noUsers'), icon: 'none' })
        return
      }
      const q = this.qAssignQuestionnaire
      if (q == null) return
      this.qAssignBusy = true
      const res = await this._req(`${BASE}/api/questionnaire-assignments`, 'POST', {
        questionnaire_id: q!['id'], user_ids: this.qAssignSelectedIds, assigned_by: this._coachUserId,
      } as UTSJSONObject, 0)
      this.qAssignBusy = false
      if (res.statusCode >= 200 && res.statusCode < 300) {
        uni.showToast({ title: this.tr('questionnaires.assigned'), icon: 'success' })
        this.qAssignOpen = false
      } else {
        uni.showToast({ title: this.tr('questionnaires.assignError'), icon: 'none' })
      }
    },
    openQResponses(i : number) {
      const q = this.questionnaires[i]
      if (q == null) return
      this.qResponsesOpen = true
      this.qResponsesList = [] as UTSJSONObject[]
      this._loadResponsesFor(idOf(q, 'id'))
    },
    async _loadResponsesFor(qid : string) {
      await this._loadResponsesBy(`questionnaire_id=${encodeURIComponent(qid)}`)
    },
    async _loadResponsesBy(query : string) {
      const res = await this._req(`${BASE}/api/questionnaire-responses?${query}`, 'GET', null, 0)
      const arr = res.data != null ? res.data!.getArray<UTSJSONObject>('responses') : null
      const grouped = new Map<string, UTSJSONObject[]>()
      const names : string[] = []
      if (arr != null) {
        for (const r of arr!) {
          const qName = this.lang == 'zh' ? (r.getString('name_zh') ?? r.getString('name') ?? '') : (r.getString('name') ?? '')
          if (!grouped.has(qName)) { names.push(qName); grouped.set(qName, [] as UTSJSONObject[]) }
          grouped.get(qName)!.push({
            prompt: this.lang == 'zh' ? r.getString('prompt_zh') : r.getString('prompt_en'),
            answer_fmt: fmtAnswer(r['answer']),
            answered_at: fmtDate(r['answered_at']),
          } as UTSJSONObject)
        }
      }
      const out : UTSJSONObject[] = []
      for (const n of names) out.push({ name: n, items: grouped.get(n) } as UTSJSONObject)
      this.qResponsesList = out
    },
    async openQResponsesFor(client : UTSJSONObject) {
      this.qResponsesOpen = true
      this.qResponsesUser = client
      this.qResponsesList = [] as UTSJSONObject[]
      this.qResponsesLoading = true
      await this._loadResponsesBy(`user_id=${encodeURIComponent(client.getString('user_id') ?? '')}`)
      this.qResponsesLoading = false
    },
    closeQResponses() {
      this.qResponsesOpen = false
      this.qResponsesList = [] as UTSJSONObject[]
    },

    async _loadClientPlans() {
      const client = this.detailClient
      if (client == null) return
      const plansRes = await this._req(`${BASE}/api/health-plans?openid=${encodeURIComponent(client!.getString('user_id') ?? '')}`, 'GET', null, 0)
      const tplRes = await this._req(`${BASE}/api/health-plan-templates`, 'GET', null, 0)
      const plans = plansRes.data != null ? plansRes.data!.getArray<UTSJSONObject>('plans') : null
      this.detailPlans = plans != null ? plans! : ([] as UTSJSONObject[])
      const tpls = tplRes.data != null ? tplRes.data!.getArray<UTSJSONObject>('templates') : null
      const out : UTSJSONObject[] = []
      if (tpls != null) {
        for (const t of tpls!) {
          const row = new UTSJSONObject()
          t.toMap().forEach((v : any | null, k : string) => { row[k] = v })
          const targets = t.getArray<string>('target_sub_ages') ?? ([] as string[])
          row['sub_ages_display'] = targets!.join(', ')
          out.push(row)
        }
      }
      this.planTemplates = out
      this._loadClientPrograms()
    },
    async _loadClientPrograms() {
      const client = this.detailClient
      if (client == null || this._coachId.length == 0) return
      const res = await this._req(`${BASE}/api/programs/coach?coach_id=${this._coachId}&openid=${encodeURIComponent(client!.getString('user_id') ?? '')}`, 'GET', null, 0)
      const arr = res.data != null ? res.data!.getArray<UTSJSONObject>('programs') : null
      const out : UTSJSONObject[] = []
      if (arr != null) {
        for (const p of arr!) {
          const e = p.getJSON('enrollment')
          const status = e != null ? (e!.getString('status') ?? 'not_started') : 'not_started'
          let statusLabel = this.tr('programStatusNotStarted')
          if (status == 'active') statusLabel = this.tr('programStatusActive')
          else if (status == 'paused') statusLabel = this.tr('programStatusPaused')
          else if (status == 'completed') statusLabel = this.tr('programStatusCompleted')
          let progressLabel = ''
          if (e != null) {
            const done = e!.getNumber('days_completed') ?? 0
            const total = p.getNumber('duration_days') ?? 0
            const openDay = e!.getNumber('open_day')
            const stalled = e!.getNumber('stalled_days') ?? 0
            progressLabel = `${done}/${total} ${this.tr('programDays').length > 1 ? '' : ''}days`
            if (openDay != null && openDay! > 0) {
              progressLabel += stalled > 0 ? ` · Day ${openDay} stalled ${stalled}d` : ` · Day ${openDay} open`
            }
          }
          let action = ''
          let actionLabel = ''
          if (status == 'not_started') { action = 'activate'; actionLabel = this.tr('programActivate') }
          else if (status == 'active') { action = 'pause'; actionLabel = this.tr('programPause') }
          else if (status == 'paused') { action = 'resume'; actionLabel = this.tr('programResume') }
          const row = new UTSJSONObject()
          p.toMap().forEach((v : any | null, k : string) => { row[k] = v })
          row['status'] = status
          row['statusLabel'] = statusLabel
          row['progressLabel'] = progressLabel
          row['action'] = action
          row['actionLabel'] = actionLabel
          out.push(row)
        }
      }
      this.detailPrograms = out
    },
    async handleProgramAction(programId : number | null, action : string) {
      const client = this.detailClient
      if (client == null || programId == null || action.length == 0 || this.programActionBusy) return
      this.programActionBusy = true
      let res : RespEnvelope
      if (action == 'activate' || action == 'resume') {
        res = await this._req(`${BASE}/api/programs/enroll`, 'POST', {
          coach_id: this._coachId, openid: client!.getString('user_id'), program_id: programId,
        } as UTSJSONObject, 0)
      } else {
        res = await this._req(`${BASE}/api/programs/enrollment`, 'PUT', {
          coach_id: this._coachId, openid: client!.getString('user_id'), program_id: programId, status: 'paused',
        } as UTSJSONObject, 0)
      }
      const d = res.data
      const ok = d != null && (d.getBoolean('success') == true || d.getBoolean('sandbox') == true)
      if (!ok) {
        uni.showToast({ title: d != null ? (d.getString('error') ?? 'Error') : 'Error', icon: 'none' })
      } else {
        uni.showToast({ title: action == 'activate' ? this.tr('programActivated') : (action == 'resume' ? this.tr('programResumed') : this.tr('programPaused')), icon: 'success' })
        this._loadClientPrograms()
      }
      this.programActionBusy = false
    },
    openPlanRecommend() { this.planRecommendOpen = true },
    closePlanRecommend() { this.planRecommendOpen = false },
    openPlanCustom() {
      this.planCustomOpen = true
      this.planCustomName = ''
      this.planCustomGoal = ''
      this.planCustomDurationStr = '4'
    },
    closePlanCustom() { this.planCustomOpen = false },
    async handleRecommendPlan(templateId : number | null) {
      const client = this.detailClient
      if (client == null || templateId == null || this.planActionBusy) return
      this.planActionBusy = true
      await this._req(`${BASE}/api/health-plans`, 'POST', {
        openid: client!.getString('user_id'), template_id: templateId, plan_type: 'secondary', source: 'coach', coach_id: this._coachId,
      } as UTSJSONObject, 0)
      uni.showToast({ title: this.tr('planRecommended'), icon: 'success' })
      this.planRecommendOpen = false
      this.planActionBusy = false
      this._loadClientPlans()
    },
    async handleCreateCustomPlan() {
      const client = this.detailClient
      const name = this.planCustomName.trim()
      if (client == null || name.length == 0 || this.planActionBusy) return
      this.planActionBusy = true
      const dur = parseInt(this.planCustomDurationStr)
      await this._req(`${BASE}/api/health-plans`, 'POST', {
        openid: client!.getString('user_id'), plan_type: 'secondary', source: 'coach', coach_id: this._coachId,
        custom_name_zh: name, custom_name_en: name,
        custom_goal_zh: this.planCustomGoal.trim(), custom_goal_en: this.planCustomGoal.trim(),
        duration_weeks: isNaN(dur) || dur <= 0 ? 4 : dur,
      } as UTSJSONObject, 0)
      uni.showToast({ title: this.tr('planRecommended'), icon: 'success' })
      this.planCustomOpen = false
      this.planActionBusy = false
      this._loadClientPlans()
    },

    async _loadClientNotes() {
      const client = this.detailClient
      if (client == null || this._coachId.length == 0) return
      const res = await this._req(`${BASE}/api/coach-notes?coach_id=${this._coachId}&user_id=${encodeURIComponent(client!.getString('user_id') ?? '')}`, 'GET', null, 0)
      const arr = res.data != null ? res.data!.getArray<UTSJSONObject>('notes') : null
      this.clientNotes = arr != null ? arr! : ([] as UTSJSONObject[])
    },
    async saveNote() {
      const client = this.detailClient
      const text = this.noteText.trim()
      if (client == null || text.length == 0 || this._coachId.length == 0 || this.notesBusy) return
      this.notesBusy = true
      await this._req(`${BASE}/api/coach-notes`, 'POST', {
        coach_id: this._coachId, user_id: client!.getString('user_id'), content: text,
      } as UTSJSONObject, 0)
      this.noteText = ''
      this.notesBusy = false
      this._loadClientNotes()
    },
    async toggleNotePin(i : number) {
      const note = this.clientNotes[i]
      if (note == null) return
      await this._req(`${BASE}/api/coach-notes/${note.getNumber('id')}`, 'PUT', { is_pinned: note.getBoolean('is_pinned') != true } as UTSJSONObject, 0)
      this._loadClientNotes()
    },
    deleteNote(i : number) {
      const note = this.clientNotes[i]
      if (note == null) return
      uni.showModal({
        title: this.tr('noteDelete'), content: this.tr('confirmDeleteFact'),
        success: (res) => { (async () : Promise<void> => {
          if (!res.confirm) return
          await this._req(`${BASE}/api/coach-notes/${note.getNumber('id')}`, 'DELETE', null, 0)
          this._loadClientNotes()
        })() }
      })
    },
    async _loadClientGoals() {
      const client = this.detailClient
      if (client == null || this._coachId.length == 0) return
      const res = await this._req(`${BASE}/api/client-goals?coach_id=${this._coachId}&user_id=${encodeURIComponent(client!.getString('user_id') ?? '')}`, 'GET', null, 0)
      const arr = res.data != null ? res.data!.getArray<UTSJSONObject>('goals') : null
      const out : UTSJSONObject[] = []
      if (arr != null) {
        for (const g of arr!) {
          const row = new UTSJSONObject()
          g.toMap().forEach((v : any | null, k : string) => { row[k] = v })
          const baseline = g.getNumber('baseline_value')
          const target = g.getNumber('target_value')
          const current = g.getNumber('current_value')
          let pct = 0
          if (baseline != null && target != null && current != null && (baseline! - target!) != 0 && (target! - baseline!) != 0) {
            const gt = g.getString('goal_type')
            pct = (gt == 'bio_age' || gt == 'sub_age')
              ? Math.round((baseline! - current!) / (baseline! - target!) * 100)
              : Math.round((current! - baseline!) / (target! - baseline!) * 100)
            pct = Math.min(100, Math.max(0, pct))
          }
          row['_pctLabel'] = `${pct}%`
          const status = g.getString('status')
          row['_statusLabel'] = status == 'achieved' ? this.tr('goalAchieved') : (status == 'missed' ? this.tr('goalMissed') : this.tr('goalActive'))
          out.push(row)
        }
      }
      this.clientGoals = out
    },
    openGoalSheet() {
      this.goalFormOpen = true
      this.goalType = 'bio_age'
      this.goalTargetValue = ''
      this.goalTargetDate = ''
    },
    closeGoalForm() { this.goalFormOpen = false },
    pickGoalType() {
      const labels : string[] = []
      for (const k of this.goalTypeKeys) labels.push(_tr(this.t, 'goalTypes.' + k))
      uni.showActionSheet({ itemList: labels, success: (res) => { this.goalType = this.goalTypeKeys[res.tapIndex] } })
    },
    pickFactCategory() {
      const labels : string[] = []
      for (let i = 0; i < this.factCategoryKeys.length; i++) labels.push(this.factCategoryLabel(i))
      uni.showActionSheet({ itemList: labels, success: (res) => { this.factCategoryIndex = res.tapIndex } })
    },
    pickMcGender() {
      uni.showActionSheet({ itemList: [this.tr('mc.genders0'), this.tr('mc.genders1')], success: (res) => { this.mcGender = res.tapIndex == 0 ? 'male' : 'female' } })
    },
    pickApptFormat() {
      const labels : string[] = []
      for (const f of this.apptFormats) labels.push(this.tr('apptFormats.' + f))
      uni.showActionSheet({ itemList: labels, success: (res) => { this.apptFormat = this.apptFormats[res.tapIndex] } })
    },
    pickApptClient() {
      const labels : string[] = []
      for (const c of this.clients) labels.push(c.getString('nickname') ?? '—')
      if (labels.length == 0) return
      uni.showActionSheet({ itemList: labels, success: (res) => {
        const c = this.clients[res.tapIndex]
        this.apptClientId = c.getString('user_id') ?? ''
        this.apptClientName = c.getString('nickname') ?? ''
      } })
    },
    onGoalTypeChange(e : UniPickerChangeEvent) {
      const i = parseInt(`${e.detail.value}`)
      if (!isNaN(i) && i >= 0 && i < this.goalTypeKeys.length) this.goalType = this.goalTypeKeys[i]
    },
    onGoalDateChange(e : UniPickerChangeEvent) { this.goalTargetDate = `${e.detail.value}` },
    async submitGoal() {
      const client = this.detailClient
      const target = parseFloat(this.goalTargetValue)
      if (client == null || isNaN(target) || this._coachId.length == 0 || this.goalBusy) return
      this.goalBusy = true
      const baseline = this.goalType == 'bio_age' ? client!.getNumber('bio_age') : null
      const res = await this._req(`${BASE}/api/client-goals`, 'POST', {
        coach_id: this._coachId, user_id: client!.getString('user_id'), goal_type: this.goalType,
        title_zh: _tr(this.t, 'goalTypes.' + this.goalType), baseline_value: baseline,
        target_value: target, target_date: this.goalTargetDate.length > 0 ? this.goalTargetDate : null,
      } as UTSJSONObject, 0)
      this.goalBusy = false
      if (res.statusCode >= 200 && res.statusCode < 300) {
        this.goalFormOpen = false
        this._loadClientGoals()
      } else {
        uni.showToast({ title: this.tr('networkError'), icon: 'none' })
      }
    },
    openGoalForm() {
      uni.showModal({
        title: this.tr('setGoal'), editable: true, placeholderText: this.tr('goalTargetLabel'),
        success: (res) => { (async () : Promise<void> => {
          const client = this.detailClient
          if (!res.confirm || client == null || this._coachId.length == 0) return
          const val = res.content != null ? parseFloat(res.content!.trim()) : NaN
          if (isNaN(val)) return
          const baselineRaw = client!.getNumber('bio_age')
          await this._req(`${BASE}/api/client-goals`, 'POST', {
            coach_id: this._coachId, user_id: client!.getString('user_id'), goal_type: 'bio_age',
            title_zh: _tr(this.t, 'goalTypes.bio_age'), baseline_value: baselineRaw,
            target_value: val, target_date: null,
          } as UTSJSONObject, 0)
          this._loadClientGoals()
        })() }
      })
    },
    async _loadClientFacts() {
      const client = this.detailClient
      if (client == null) return
      const qs = `openid=${encodeURIComponent(client!.getString('user_id') ?? '')}${this._coachId.length > 0 ? '&coach_id=' + this._coachId : ''}`
      const res = await this._req(`${BASE}/api/user-facts?${qs}`, 'GET', null, 0)
      const arr = res.data != null ? res.data!.getArray<UTSJSONObject>('facts') : null
      this.clientFacts = arr != null ? arr! : ([] as UTSJSONObject[])
    },
    onFactCategoryChange(e : UniPickerChangeEvent) {
      const i = parseInt(`${e.detail.value}`)
      if (!isNaN(i)) this.factCategoryIndex = i
    },
    factCategoryLabel(i : number) : string {
      return _tr(this.t, 'factCategories.' + (this.factCategoryKeys[i] ?? 'other'))
    },
    async saveFact() {
      const client = this.detailClient
      const text = this.factText.trim()
      if (client == null || text.length == 0 || this.factsBusy) return
      this.factsBusy = true
      await this._req(`${BASE}/api/user-facts`, 'POST', {
        openid: client!.getString('user_id'), category: this.factCategoryKeys[this.factCategoryIndex] ?? 'other', fact_zh: text,
      } as UTSJSONObject, 0)
      this.factText = ''
      this.factsBusy = false
      this._loadClientFacts()
    },
    deleteFact(i : number) {
      const f = this.clientFacts[i]
      if (f == null) return
      uni.showModal({
        title: this.tr('factDelete'), content: this.tr('confirmDeleteFact'),
        success: (res) => { (async () : Promise<void> => {
          if (!res.confirm) return
          await this._req(`${BASE}/api/user-facts/${f.getNumber('id')}`, 'DELETE', null, 0)
          this._loadClientFacts()
        })() }
      })
    },

    async _loadCRM() {
      if (this._coachId.length == 0) return
      this._loadKPIs()
      const actRes = await this._req(`${BASE}/api/coach-activity-feed?coach_id=${this._coachId}&limit=20`, 'GET', null, 0)
      const apptRes = await this._req(`${BASE}/api/appointments/upcoming?coach_id=${this._coachId}`, 'GET', null, 0)
      const acts = actRes.data != null ? actRes.data!.getArray<UTSJSONObject>('activities') : null
      const feed : UTSJSONObject[] = []
      if (acts != null) {
        for (const a of acts!) {
          const row = new UTSJSONObject()
          a.toMap().forEach((v : any | null, k : string) => { row[k] = v })
          const at = a.getString('activity_type') ?? ''
          row['_label'] = _tr(this.t, 'activityTypes.' + at)
          row['_timeFmt'] = fmtTime(a['occurred_at'])
          feed.push(row)
        }
      }
      const appts = apptRes.data != null ? apptRes.data!.getArray<UTSJSONObject>('appointments') : null
      const upcoming : UTSJSONObject[] = []
      if (appts != null) {
        for (const a of appts!) {
          const row = new UTSJSONObject()
          a.toMap().forEach((v : any | null, k : string) => { row[k] = v })
          row['_timeFmt'] = fmtTime(a['scheduled_at'])
          upcoming.push(row)
        }
      }
      this.crmPipelineColumns = this._buildPipelineColumns()
      this.crmActivityFeed = feed
      this.crmUpcomingAppts = upcoming
    },
    _buildPipelineColumns() : UTSJSONObject[] {
      const byStage = new Map<string, UTSJSONObject[]>()
      for (const s of STAGE_ORDER) byStage.set(s, [] as UTSJSONObject[])
      for (const c of this.clients) {
        const s = c.getString('crm_stage') ?? 'lead'
        const list = byStage.get(s)
        if (list != null) list!.push(c)
      }
      const out : UTSJSONObject[] = []
      for (const s of STAGE_ORDER) {
        out.push({ stage: s, label: _tr(this.t, 'crmStages.' + s), color: STAGE_COLORS.get(s), clients: byStage.get(s) ?? ([] as UTSJSONObject[]) } as UTSJSONObject)
      }
      return out
    },
    openStagePicker(client : UTSJSONObject) {
      if (this._coachId.length == 0) return
      const current = client.getString('crm_stage') ?? 'lead'
      const targets : string[] = []
      const labels : string[] = []
      for (const s of STAGE_ORDER) {
        if (s == current) continue
        targets.push(s)
        labels.push(_tr(this.t, 'crmStages.' + s))
      }
      uni.showActionSheet({
        itemList: labels,
        success: (res) => { (async () : Promise<void> => {
          const stage = targets[res.tapIndex]
          const r = await this._req(`${BASE}/api/client-pipeline`, 'POST', {
            coach_id: this._coachId, user_id: client.getString('user_id'), stage: stage,
          } as UTSJSONObject, 0)
          if (r.data == null || r.data!.getBoolean('success') != true) {
            uni.showToast({ title: this.tr('crmMoveError'), icon: 'none' })
            return
          }
          const clients : UTSJSONObject[] = []
          for (const c of this.clients) {
            if (c.getString('user_id') == client.getString('user_id')) {
              c['crm_stage'] = stage
              c['_crmStagePill'] = { label: _tr(this.t, 'crmStages.' + stage), color: STAGE_COLORS.get(stage) ?? '#6b7280' } as UTSJSONObject
            }
            clients.push(c)
          }
          this.clients = clients
          this._filterClients()
          this.crmPipelineColumns = this._buildPipelineColumns()
          uni.showToast({ title: this.tr('crmMoveSuccess'), icon: 'success' })
        })() }
      })
    },
    async _loadKPIs() {
      if (this._coachId.length == 0) return
      this.kpiLoading = true
      const res = await this._req(`${BASE}/api/coach-kpis?coach_id=${this._coachId}`, 'GET', null, 0)
      this.kpiData = res.data != null ? res.data!.getJSON('kpis') : null
      const ranked : UTSJSONObject[] = []
      for (const c of this.clients) {
        const cAge = c.getNumber('_cAge')
        const bio = c.getNumber('bio_age')
        if (cAge == null || bio == null || cAge == 0 || bio == 0) continue
        ranked.push({ nickname: c.getString('nickname') ?? '', delta: parseFloat((bio! - cAge!).toFixed(1)), _avatar: c.getString('_avatar') ?? 'U' } as UTSJSONObject)
      }
      ranked.sort((a, b) : number => (a.getNumber('delta') ?? 0) - (b.getNumber('delta') ?? 0))
      this.topImprovers = ranked.slice(0, 5)
      this.kpiLoading = false
    },

    openApptForm(client : UTSJSONObject | null) {
      this.apptFormOpen = true
      this.apptClientId = client != null ? (client!.getString('user_id') ?? '') : ''
      this.apptClientName = client != null ? (client!.getString('nickname') ?? '') : ''
      this.apptTitleText = ''
      this.apptDate = todayStr()
      this.apptTime = '10:00'
      this.apptFormat = 'video'
      this.apptLink = ''
    },
    closeApptForm() { this.apptFormOpen = false },
    onApptDateChange(e : UniPickerChangeEvent) { this.apptDate = e.detail.value as string },
    onApptTimeChange(e : UniPickerChangeEvent) { this.apptTime = e.detail.value as string },
    async submitAppt() {
      if (this.apptTitleText.length == 0 || this.apptDate.length == 0 || this._coachId.length == 0 || this.apptBusy) return
      this.apptBusy = true
      await this._req(`${BASE}/api/appointments`, 'POST', {
        coach_id: this._coachId, user_id: this.apptClientId, title: this.apptTitleText,
        scheduled_at: `${this.apptDate}T${this.apptTime}:00`, format: this.apptFormat,
        meeting_link: this.apptLink.length > 0 ? this.apptLink : null,
      } as UTSJSONObject, 0)
      this.apptFormOpen = false
      this.apptBusy = false
      this._loadCRM()
    },

    openManagedForm(_from : string) {
      this.mcFormOpen = true
      this.mcEditId = ''
      this.mcLast = ''
      this.mcFirst = ''
      this.mcNickname = ''
      this.mcBirthDate = ''
      this.mcGender = ''
      this.mcPhone = ''
      this.mcRef = ''
      this.mcBusy = false
    },
    openManagedFormEdit() {
      const c = this.detailClient
      if (c == null) return
      this.openManagedForm('')
      this.mcEditId = c!.getString('user_id') ?? ''
      this.mcLast = c!.getString('last_name') ?? ''
      this.mcFirst = c!.getString('first_name') ?? ''
      this.mcNickname = c!.getString('nickname') ?? ''
      const bd = c!.getString('birth_date')
      this.mcBirthDate = bd != null ? bd!.substring(0, Math.min(10, bd!.length)) : ''
      if (this.mcBirthDate == '—') this.mcBirthDate = ''
      this.mcGender = c!.getString('gender') ?? ''
      const cp = c!.getString('contact_phone') ?? ''
      this.mcPhone = cp.startsWith('+86') ? cp.substring(3) : cp
      this.mcRef = c!.getString('external_ref') ?? ''
    },
    closeManagedForm() { this.mcFormOpen = false },
    onMcBirthDateChange(e : UniPickerChangeEvent) { this.mcBirthDate = e.detail.value as string },
    async submitManagedForm() {
      if (this.mcBusy) return
      const errCode = this.mcBirthDate.length == 0 ? 'birth_date_required'
        : this.mcGender.length == 0 ? 'gender_required'
        : (this.mcNickname.trim().length == 0 && this.mcLast.trim().length == 0 && this.mcFirst.trim().length == 0 && this.mcRef.trim().length == 0) ? 'name_required'
        : null
      if (errCode != null) {
        const msg = MC_ERROR_ZH.get(errCode!)
        uni.showToast({ title: msg != null ? msg : errCode!, icon: 'none' })
        return
      }
      this.mcBusy = true
      const body = {
        last_name: this.mcLast.trim(), first_name: this.mcFirst.trim(), nickname: this.mcNickname.trim(),
        birth_date: this.mcBirthDate, gender: this.mcGender,
        contact_phone: this.mcPhone.trim(), external_ref: this.mcRef.trim(),
      } as UTSJSONObject
      let res : RespEnvelope
      if (this.mcEditId.length > 0) {
        res = await this._req(`${BASE}/api/managed-customers/${encodeURIComponent(this.mcEditId)}`, 'PUT', body, 0)
      } else {
        body['coach_id'] = this._coachId
        res = await this._req(`${BASE}/api/managed-customers`, 'POST', body, 0)
      }
      const d = res.data
      if (d == null || d.getBoolean('success') != true) {
        const code = d != null ? (d.getString('error') ?? '') : ''
        const msg = MC_ERROR_ZH.get(code)
        uni.showToast({ title: msg != null && msg!.length > 0 ? msg! : (code.length > 0 ? code : this.tr('mc.fallback')), icon: 'none' })
        this.mcBusy = false
        return
      }
      uni.showToast({ title: this.mcEditId.length > 0 ? this.tr('mc.saved') : this.tr('mc.created'), icon: 'success' })
      this.mcFormOpen = false
      this.mcBusy = false
      if (this.mcEditId.length > 0 && this.detailClient != null && this.detailClient!.getString('user_id') == this.mcEditId) {
        const updated = d!.getJSON('customer')
        if (updated != null) this.detailClient = updated
      }
      this._loadAll()
    },

    openRedeemForm() {
      const c = this.detailClient
      if (c == null) return
      const lastRaw = uni.getStorageSync('nano_mc_last_address')
      this.redeemOpen = true
      this.redeemBusy = false
      this.redeemCode = ''
      const nick = c!.getString('nickname') ?? ''
      if (nick != null && nick!.length > 0) {
        this.redeemName = nick!
      } else {
        this.redeemName = `${c!.getString('last_name') ?? ''}${c!.getString('first_name') ?? ''}`
      }
      const cp = c!.getString('contact_phone') ?? ''
      this.redeemPhone = cp.startsWith('+86') ? cp.substring(3) : cp
      this.redeemAddress = lastRaw != null ? `${lastRaw}` : ''
    },
    closeRedeemForm() {
      if (this.redeemBusy) return
      this.redeemOpen = false
    },
    async submitRedeem() {
      const client = this.detailClient
      if (client == null || this.redeemBusy) return
      const code = this.redeemCode.trim()
      const name = this.redeemName.trim()
      const phone = this.redeemPhone.trim()
      const address = this.redeemAddress.trim()
      const table = this.lang == 'zh' ? REDEEM_ERROR_ZH : REDEEM_ERROR_EN
      if (code.length == 0) { uni.showToast({ title: table.get('code_required') ?? '', icon: 'none' }); return }
      if (name.length == 0 || phone.length == 0 || address.length == 0) { uni.showToast({ title: table.get('shipping_required') ?? '', icon: 'none' }); return }
      this.redeemBusy = true
      const res = await this._req(`${BASE}/api/formulation-redeem`, 'POST', {
        openid: client!.getString('user_id'), code: code,
        shipping_name: name, shipping_phone: phone, shipping_address: address,
      } as UTSJSONObject, 30000)
      const d = res.data
      if (d == null || d.getBoolean('success') != true) {
        const reason = d != null ? (d.getString('reason') ?? '') : ''
        const msg = table.get(reason)
        uni.showToast({ title: msg != null && msg!.length > 0 ? msg! : reason, icon: 'none', duration: 3000 })
        this.redeemBusy = false
        return
      }
      uni.setStorageSync('nano_mc_last_address', address)
      uni.showToast({ title: d!.getBoolean('pending_confirmation') == true ? this.tr('mc.redeemPending') : this.tr('mc.redeemDone'), icon: 'success' })
      this.redeemOpen = false
      this.redeemBusy = false
      this._loadClientChat()
    },

    // Box activation for the managed customer — same /box-claim the customer's own app makes
    // (§28); not_your_box is the check that matters here.
    scanBoxForCustomer() {
      const client = this.detailClient
      if (client == null) return
      setScanTitle(this.tr('mc.boxScan'))
      scanQr({
        onlyFromCamera: false,
        success: (res) => { (async () : Promise<void> => {
          uni.showLoading({ title: '…', mask: true })
          const r = await this._req(`${BASE}/api/box-claim`, 'POST', {
            openid: client!.getString('user_id'), box_code: res.result,
          } as UTSJSONObject, 0)
          uni.hideLoading()
          const d = r.data
          if (d != null && d.getBoolean('success') == true) {
            uni.showToast({ title: d!.getBoolean('already_claimed') == true ? this.tr('mc.boxAlready') : this.tr('mc.boxOk'), icon: 'none', duration: 2500 })
            this._loadClientChat()
          } else {
            const reason = d != null ? (d.getString('reason') ?? '') : ''
            const msg = BOX_ERROR_ZH.get(reason)
            uni.showModal({
              title: this.tr('mc.boxFail'),
              content: msg != null && msg!.length > 0 ? msg! : this.tr('mc.boxFail'),
              showCancel: false,
            })
          }
        })() },
        fail: (_) => {}
      })
    },

    async _req(url : string, method : string, data : UTSJSONObject | null, timeoutMs : number) : Promise<RespEnvelope> {
      let body = data
      if (state.sandboxMode && method != 'GET') {
        const injected = new UTSJSONObject()
        if (data != null) data!.toMap().forEach((v : any | null, k : string) => { injected[k] = v })
        injected['sandbox'] = true
        body = injected
      }
      const to = timeoutMs > 0 ? timeoutMs : 60000
      if (method == 'POST') return _envelopeRun(url, 'POST', body, to)
      if (method == 'PUT') return _envelopeRun(url, 'PUT', body, to)
      if (method == 'DELETE') return _envelopeRun(url, 'DELETE', body, to)
      if (method == 'PATCH') return _envelopeRun(url, 'PATCH', body, to)
      return _envelopeRun(url, 'GET', body, to)
    },
  }
}
</script>

