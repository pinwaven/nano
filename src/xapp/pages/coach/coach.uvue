  ai: 'AI', coachLabel: 'Coach', detailTitle: 'Client Detail', goalDateLabel: 'Target Date', goalTargetLabel: 'Target Value', goalTypeLabel: 'Goal Type', joined: 'Joined', kpiCommission: 'Commission', kpiNps: 'NPS Score', kpiScans: 'Scans', noChatData: 'No chat history yet.', openMessages: 'Message', planCheckins: 'check-ins', programDays: 'days', retryLoad: 'Retry', selectTime: 'Select time', you: 'User',
} as UTSJSONObject

function _tr(t : UTSJSONObject, path : string) : string {
  const parts = path.split('.')
  var cur : UTSJSONObject = t
  for (let i = 0; i < parts.length; i++) {
    if (i == parts.length - 1) {
      const v = cur.getString(parts[i])
      return v != null ? v : parts[i]
    }
    const nxt = cur.getJSON(parts[i])
    if (nxt == null) return parts[parts.length - 1]
    cur = nxt!
  }
  return path
}

