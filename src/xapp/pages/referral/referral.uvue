}

.theme-light .card {
  background: #fff;
  border-color: rgba(99, 117, 236, 0.15);
}

.card-label {
  font-size: 22rpx;
  color: rgba(232, 240, 248, 0.5);
  letter-spacing: 3rpx;
  text-transform: uppercase;
  display: block;
  margin-bottom: 20rpx;
}

.theme-light .card-label { color: #5F656B; }

.code-row {
  margin-bottom: 28rpx;
}

.code-value {
  font-size: 44rpx;
  font-weight: 700;
