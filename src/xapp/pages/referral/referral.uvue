}

.theme-light .friend-meta { color: #6B7177; }

.friend-commission { flex-shrink: 0; }

.commission-amt {
  font-size: 26rpx;
  font-weight: 700;
  color: #4CAF8A;
}

.theme-light .commission-amt { color: #157A4D; }

/* Misc */
.center-msg {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-state {
  padding: 60rpx 0;
  display: flex;
  justify-content: center;
}

.dim-text {
  font-size: 26rpx;
  color: rgba(232, 240, 248, 0.4);
}

.theme-light .dim-text { color: #6A7175; }

.error-text {
  font-size: 26rpx;
  color: #E87070;
}

.theme-light .error-text { color: #DC2626; }

.bottom-safe { height: 60rpx; }

/* Credit balance card */
.credit-card { margin-bottom: 24rpx; }

.credit-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.credit-info { flex: 1; }

.credit-balance {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--blue);
  display: block;
  margin: 8rpx 0 4rpx;
}

.credit-currency {
  font-size: 26rpx;
  font-weight: 400;
  color: rgba(var(--blue-rgb), 0.7);
}

.credit-hint {
  font-size: 22rpx;
  color: rgba(232, 240, 248, 0.45);
  display: block;
}

.theme-light .credit-hint { color: #6B7177; }

.credit-withdraw-btn {
  flex: none;
  width: auto;
  padding: 0 32rpx;
  height: 72rpx;
