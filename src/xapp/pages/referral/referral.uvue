}

/* Stats */
.stats-row {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(99, 117, 236, 0.2);
  border-radius: 20rpx;
  padding: 32rpx;
