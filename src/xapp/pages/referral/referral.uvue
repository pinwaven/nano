<template>
  <!-- #ifdef WEB -->
  <!-- Web: the miniapp's pages/referral markup (the web user-app's ReferralPage), styled by the
       shared stylesheet in static/web/. 分享给好友 shares/copies an ?invite= link to this app. -->
  <view class="referral-page route-page" :class="theme == 'light' ? 'theme-light' : ''">
    <view class="app-header">
      <view class="back-btn" v-on:click="goBack"><text class="back-icon">‹</text><text class="back-label">{{ t('back') }}</text></view>
      <text class="header-title">{{ t('title') }}</text>
    </view>
    <view class="tab-scroll" style="flex: 1">
      <view class="card">
        <text class="card-label">{{ t('yourCode') }}</text>
        <view class="code-row"><text class="code-value">{{ referralCode }}</text></view>
        <view class="btn-row">
          <view class="btn btn-outline" v-on:click="copyCode"><text>{{ t('copyCode') }}</text></view>
          <view class="btn btn-primary" v-on:click="shareInvite"><text>{{ t('shareCard') }}</text></view>
        </view>
      </view>
      <view class="card how-card">
        <text class="card-label">{{ t('howTitle') }}</text>
        <view class="how-row"><text class="how-num">1</text><text class="how-text">{{ t('how1') }}</text></view>
        <view class="how-row"><text class="how-num">2</text><text class="how-text">{{ t('how2') }}</text></view>
        <view class="how-row"><text class="how-num">3</text><text class="how-text">{{ t('how3') }}</text></view>
      </view>
      <view class="bottom-safe"></view>
    </view>
  </view>
  <!-- #endif -->
  <!-- #ifdef MP-WEIXIN -->
  <!-- xapp-mini: the miniapp's pages/referral markup and stylesheet, so the two entries look the
       same; 分享给好友 is WeChat's own share button (onShareAppMessage below). -->
  <view class="referral-page" :class="theme == 'light' ? 'theme-light' : ''">
    <view class="status-bar-spacer" :style="'height: ' + statusBarHeight + 'px;'"></view>
    <view class="app-header">
      <view class="back-btn" v-on:click="goBack">
        <text class="back-icon">‹</text>
        <text class="back-label">{{ t('back') }}</text>
      </view>
      <text class="header-title">{{ t('title') }}</text>
    </view>
    <view class="card">
      <text class="card-label">{{ t('yourCode') }}</text>
      <view class="code-row">
        <text class="code-value">{{ referralCode }}</text>
      </view>
      <view class="btn-row">
        <view class="btn btn-outline" v-on:click="copyCode">
          <text>{{ t('copyCode') }}</text>
        </view>
        <button class="btn btn-primary" open-type="share">
          <text>{{ t('shareCard') }}</text>
        </button>
      </view>
    </view>
    <view class="card how-card">
      <text class="card-label">{{ t('howTitle') }}</text>
      <view class="how-row"><text class="how-num">1</text><text class="how-text">{{ t('how1') }}</text></view>
      <view class="how-row"><text class="how-num">2</text><text class="how-text">{{ t('how2') }}</text></view>
      <view class="how-row"><text class="how-num">3</text><text class="how-text">{{ t('how3') }}</text></view>
    </view>
    <view class="bottom-safe"></view>
  </view>
  <!-- #endif -->
  <!-- #ifdef APP -->
  <view class="rf-screen">
    <view class="rf-header" :style="'padding-top:' + statusBarHeight + 'px'">
      <view class="rf-back" v-on:click="goBack"><text class="rf-back-text">‹ {{ t('back') }}</text></view>
      <text class="rf-title">{{ t('title') }}</text>
    </view>

    <view class="rf-card">
      <text class="rf-label">{{ t('yourCode') }}</text>
      <text class="rf-code">{{ referralCode }}</text>
      <view class="rf-btn" v-on:click="copyCode"><text class="btn-text">{{ t('copyCode') }}</text></view>
      <view class="rf-btn rf-btn-ghost" v-on:click="copyShareText"><text class="btn-text">{{ t('shareCard') }}</text></view>
      <text class="rf-hint">{{ t('shareNote') }}</text>
    </view>

    <view class="rf-card">
      <text class="rf-section">{{ t('howTitle') }}</text>
      <text class="rf-how">{{ t('how1') }}</text>
      <text class="rf-how">{{ t('how2') }}</text>
      <text class="rf-how">{{ t('how3') }}</text>
    </view>
  </view>
  <!-- #endif -->
</template>

<script>
// Ported from miniapp pages/referral/referral.js. Deviation: a native app has no
// onShareAppMessage card — 分享给好友 becomes copy-invite-text (link + title), the app's
// own share sheet can come with a share plugin later.

import { state } from '../../utils/state.uts'

const T_ZH : UTSJSONObject = {
  title: '邀请好友', back: '返回', yourCode: '您的专属邀请码', copyCode: '复制邀请码',
  copied: '已复制', shareCard: '复制邀请链接', shareNote: '好友在登录页「邀请码」入口填入即可绑定邀请关系。',
  shareTitle: '加入 Waven Nano，开启精准健康之旅',
  howTitle: '如何邀请？',
  how1: '将邀请链接发送给好友。',
  how2: '好友通过您的链接注册后，即成功绑定邀请关系。',
  how3: '好友购买商品时，您将获得对应佣金，积分可申请提现。',
} as UTSJSONObject
const T_EN : UTSJSONObject = {
  title: 'Invite Friends', back: 'Back', yourCode: 'Your Referral Code', copyCode: 'Copy Code',
  copied: 'Copied', shareCard: 'Copy Invite Link', shareNote: 'Friends enter the code on the login screen to link the invitation.',
  shareTitle: 'Join Waven Nano — precision health for your biology',
  howTitle: 'How it works',
  how1: 'Send your invite link to a friend.',
  how2: 'When your friend registers through your link, they\'re linked to you.',
  how3: 'You earn credits whenever your friend makes a purchase. Credits can be withdrawn as cash.',
} as UTSJSONObject

// Web and xapp-mini: the miniapp's own wording (on the web 分享给好友 shares a link instead of a WeChat card).
const T_WEB_ZH : UTSJSONObject = {
  shareCard: '分享给好友', how1: '点击「分享给好友」，将邀请卡片发送给微信好友或群。', linkCopied: '邀请链接已复制',
} as UTSJSONObject
const T_WEB_EN : UTSJSONObject = {
  shareCard: 'Share with Friends', how1: 'Tap "Share with Friends" to send your invite card via WeChat.', linkCopied: 'Invite link copied',
} as UTSJSONObject

export default {
  name: 'ReferralPage',
  data() {
    return {
      lang: 'zh',
      statusBarHeight: 44,
      referralCode: '',
      theme: 'dark',
    }
  },
  onLoad(_options : OnLoadOptions) {
    this.lang = state.lang
    this.theme = state.theme
    const info = uni.getWindowInfo()
    this.statusBarHeight = info.statusBarHeight
    const user = state.user
    if (user != null) {
      const rc = user!.getString('referral_code')
      const uid = user!.getString('user_id')
      this.referralCode = rc != null && rc!.length > 0 ? rc! : (uid != null ? uid : '')
    }
  },
  // #ifdef MP-WEIXIN
  onShareAppMessage() : UTSJSONObject {
    return { title: this.t('shareTitle'), path: `pages/login/login?invite=${this.referralCode}` } as UTSJSONObject
  },
  // #endif
  methods: {
    t(key : string) : string {
      // #ifdef WEB || MP-WEIXIN
      const w = (this.lang == 'en' ? T_WEB_EN : T_WEB_ZH).getString(key)
      if (w != null) return w
      // #endif
      const dict = this.lang == 'en' ? T_EN : T_ZH
      const v = dict.getString(key)
      return v != null ? v : key
    },
    copyCode() {
      uni.setClipboardData({
        data: this.referralCode,
        success: () => { uni.showToast({ title: this.t('copied'), icon: 'success' }) }
      })
    },
    copyShareText() {
      const text = `${this.t('shareTitle')}  ${this.t('yourCode')}: ${this.referralCode}`
      uni.setClipboardData({
        data: text,
        success: () => { uni.showToast({ title: this.t('copied'), icon: 'success' }) }
      })
    },
    // Web: the user-app's ReferralPage share — the system share sheet when the browser has
    // one, else copy the ?invite= link to this app (components/web-login reads it).
    shareInvite() {
      // #ifdef WEB
      const url = `${window.location.origin}${window.location.pathname}?invite=${encodeURIComponent(this.referralCode)}`
      const nav = navigator as any
      const copy = () => {
        uni.setClipboardData({ data: url, success: () => { uni.showToast({ title: this.t('linkCopied'), icon: 'none' }) } })
      }
      if (nav.share != null) {
        nav.share({ title: this.t('shareTitle'), url: url }).catch(() => { copy() })
        return
      }
      copy()
      // #endif
    },
    goBack() {
      uni.navigateBack()
    }
  }
}
</script>

<style>
/* #ifdef MP-WEIXIN */
/* xapp-mini: the miniapp's pages/referral/referral.wxss verbatim. */
/* The miniapp's stylesheet assumes browser defaults (block views, `display:flex` = a row);
   uvue.wxss makes every view a flex column. Undo that for this page's own view classes, listed
   explicitly: a tag selector would also reach the embedded components (WeChat applies a page's
   tag selectors to them), and the WXSS compiler rejects both :not() and a :where() list (the
   whole app then renders blank). It sits before every miniapp rule, so at equal specificity
   those still win. */
.app-header, .back-btn, .bottom-safe, .btn-outline, .btn-row, .card, .code-row, .how-card, .how-row, .referral-page, .status-bar-spacer, .theme-light { display: block; position: static; flex-direction: row; flex-shrink: 1; align-items: normal; align-content: normal; justify-content: normal; min-height: auto; min-width: auto; }
.referral-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #0B1C2E;
  color: #E8F0F8;
  overflow: hidden;
}

.referral-page.theme-light {
  background: #F4F6FA;
  color: #1A2B3C;
}

.status-bar-spacer { width: 100%; flex-shrink: 0; }

/* Header */
.app-header {
  background: rgba(11, 28, 46, 0.85);
  border-bottom: 1rpx solid rgba(99, 117, 236, 0.18);
  padding: 16rpx 36rpx 28rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.theme-light .app-header {
  background: rgba(244, 246, 250, 0.95);
  border-bottom-color: rgba(99, 117, 236, 0.15);
}

.back-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.back-icon {
  font-size: 44rpx;
  color: var(--blue);
  line-height: 1;
}

.back-label {
  font-size: 26rpx;
  color: var(--blue);
}

.header-title {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #EEF2FF;
}

.theme-light .header-title { color: #1A2B3C; }

/* Scroll area */
.referral-content {
  flex: 1;
  overflow: hidden;
  padding: 32rpx 28rpx;
  box-sizing: border-box;
}

/* Cards */
.card {
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(99, 117, 236, 0.2);
  border-radius: 20rpx;
  padding: 36rpx;
