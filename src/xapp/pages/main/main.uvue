const KINO_SIM_SERIAL = 'KNA2-00000'

// Which channel trees have a GCN storefront, keyed on the ROOT of the channel tree (AGENTS §33).
const GCN_STORE_HOST_FOR_CHANNEL = new Map<string, string>()
GCN_STORE_HOST_FOR_CHANNEL.set('aeviva', 'aeviva')
GCN_STORE_HOST_FOR_CHANNEL.set('waven', 'waven')

function _channelRootKey(channel : UTSJSONObject | null) : string | null {
  if (channel == null) return null
  const rk = channel!.getString('root_key_name')
  if (rk != null && rk!.length > 0) return rk
  const key = channel!.getString('key_name') ?? ''
  if (key.length == 0) return null
  const dash = key.indexOf('-')
  return dash > 0 ? key.substring(0, dash) : key
}

const MONTH_EN : string[] = ['January','February','March','April','May','June','July','August','September','October','November','December']

const BM_META : UTSJSONObject[] = [
  { key: 'hsCRP', unit: 'mg/L', color: '#ef4444' } as UTSJSONObject,
  { key: 'GDF15', unit: 'pg/mL', color: '#f97316' } as UTSJSONObject,
  { key: 'IL6', unit: 'pg/mL', color: '#a855f7' } as UTSJSONObject,
  { key: 'GA', unit: '%', color: '#6375EC' } as UTSJSONObject,
  { key: 'CystatinC', unit: 'mg/L', color: '#0ea5e9' } as UTSJSONObject,
  { key: 'CD38', unit: 'xBaseline', color: '#10b981' } as UTSJSONObject,
]

const SUB_AGE_KEYS : string[] = ['ResilienceAge', 'CellularAge', 'MetabolicAge', 'MicroVascularAge']
const SUB_AGE_COLORS = new Map<string, string>()
SUB_AGE_COLORS.set('ResilienceAge', '#c084d4')
SUB_AGE_COLORS.set('CellularAge', '#10b981')
SUB_AGE_COLORS.set('MetabolicAge', '#6375EC')
SUB_AGE_COLORS.set('MicroVascularAge', '#0ea5e9')

// Notification types whose text is ALSO written to chat_messages, so the catch-up poll can
// legitimately re-deliver the same text — only these take part in _markRenderedAi/_isRenderedAi.
// Deliberately EXCLUDES coach_reminder / questionnaire_ready (no chat_messages row at all).
const AI_ECHO_TYPES = new Set<string>([
  'chat_reply', 'nutrition_plan', 'formulation_proposal', 'formulation_reorder_ready',
  'formulation_order_paid', 'biological_report',
  'coach_message', 'morning_checkin', 'midday_checkin', 'evening_checkin',
  'viva_ag_result', 'viva_ag_failed', 'viva_ag_questionnaire',
  'doc_extraction_result',
  'program_day', 'program_day_summary', 'program_day_comment', 'program_day_nudge',
])

// Notification types delivered by the external Viva AG agent rather than by Viva itself — drives
// the "Viva AG" label; the durable equivalent is chat_messages.source.
const AG_NOTIFICATION_TYPES = new Set<string>(['viva_ag_result', 'viva_ag_failed', 'viva_ag_questionnaire'])

// How long _poll keeps the typing indicator up (AGENTS §22). Async = the server's whole worst case
// (285s, above agenticChat's 200s deadline + ~60s grounding + the 250s watchdog); sync = the reply
// was already written when the ack arrived, so one poll tick away on either channel (30s).
const CHAT_WAIT_ASYNC_MS = 285000
const CHAT_WAIT_SYNC_MS = 30000

// Two chat messages more than this far apart get a time separator between them.
const MSG_SEPARATOR_GAP_MS = 30 * 60 * 1000

const DEFAULT_SUBAGE_OVERRIDES : UTSJSONObject | null = null

function buildSubAgeLabels(base : UTSJSONObject, overrides : UTSJSONObject | null, lang : string) : UTSJSONObject {
  if (overrides == null) return base
  const result = new UTSJSONObject()
  base.toMap().forEach((v : any | null, k : string) => { result[k] = v })
  for (const key of SUB_AGE_KEYS) {
    const entry = overrides!.getJSON(key)
    if (entry == null) continue
    const override = entry!.getString(lang)
    if (override != null && override!.trim().length > 0) result[key] = override!.trim()
  }
  return result
}

function _pad2(n : number) : string { return n < 10 ? `0${n}` : `${n}` }

function _parseMs(v : any | null) : number {
  if (v == null) return NaN
  try {
    const s = `${v}`
    const ms = parseFloat(s)
    if (!isNaN(ms) && s.indexOf('-') == -1 && s.indexOf(':') == -1) return ms
    return new Date(s).getTime()
  } catch (e : any) { return NaN }
}

function msgSeparator(prevTs : number, ts : number, lang : string) : string {
  if (prevTs <= 0 || ts <= 0 || ts - prevTs < MSG_SEPARATOR_GAP_MS) return ''
  const d = new Date(ts)
  const hh = _pad2(d.getHours())
  const mm = _pad2(d.getMinutes())
  const now = new Date()
  const sameDay = d.getFullYear() == now.getFullYear() && d.getMonth() == now.getMonth() && d.getDate() == now.getDate()
  if (sameDay) return `${hh}:${mm}`
  const md = lang == 'zh' ? `${d.getMonth() + 1}月${d.getDate()}日` : `${d.getMonth() + 1}/${d.getDate()}`
  return `${md} ${hh}:${mm}`
}

function chronoAge(birthDate : string | null) : number | null {
  if (birthDate == null || birthDate!.length == 0) return null
  return Math.floor((Date.now() - _parseMs(birthDate)) / (1000 * 60 * 60 * 24 * 365.25))
}

function fmtDate(v : any | null, lang : string) : string {
  if (v == null) return '—'
  const ms = _parseMs(v)
  if (isNaN(ms)) return `${v}`
  const date = new Date(ms)
  const y = date.getFullYear()
  const m = date.getMonth() + 1
  const day = date.getDate()
  if (lang == 'zh') return `${y}年${m}月${day}日`
  const months : string[] = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']
  return `${months[date.getMonth()]} ${day}, ${y}`
}

function fmtDateShort(v : any | null) : string {
  const ms = _parseMs(v)
  if (isNaN(ms)) return ''
  const d = new Date(ms)
  return `${d.getFullYear()}-${_pad2(d.getMonth() + 1)}-${_pad2(d.getDate())}`
}

function localISODate(d : Date) : string {
  return `${d.getFullYear()}-${_pad2(d.getMonth() + 1)}-${_pad2(d.getDate())}`
}

// { monday, sunday } as 'YYYY-MM-DD'
function getWeekRange(offsetWeeks : number) : UTSJSONObject {
  const now = new Date()
  const dow = now.getDay()
  const daysFromMonday = dow == 0 ? 6 : dow - 1
  const monday = new Date(now.getTime())
  monday.setDate(now.getDate() - daysFromMonday + offsetWeeks * 7)
  const sunday = new Date(monday.getTime())
  sunday.setDate(monday.getDate() + 6)
  return { monday: localISODate(monday), sunday: localISODate(sunday) } as UTSJSONObject
}

function fmtWeekLabel(monday : string, sunday : string, lang : string) : string {
  const m = new Date(monday + 'T12:00:00Z')
  const s = new Date(sunday + 'T12:00:00Z')
  const months : string[] = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']
  if (lang == 'zh') return `${m.getUTCMonth() + 1}月${m.getUTCDate()}日 – ${s.getUTCMonth() + 1}月${s.getUTCDate()}日`
  return `${months[m.getUTCMonth()]} ${m.getUTCDate()} – ${months[s.getUTCMonth()]} ${s.getUTCDate()}`
}

function mapCartridges(cartridges : UTSJSONObject[], lang : string) : UTSJSONObject[] {
  const out : UTSJSONObject[] = []
  for (const c of cartridges) {
    const remaining = c.getNumber('remaining_dots') ?? 0
    const total = c.getNumber('total_dots') ?? 1
    const pct = Math.max(0, Math.round(remaining / total * 100))
    const colorHex = c.getString('color_hex') ?? '#6375EC'
    const barColor = pct < 10 ? '#FF4D4D' : (pct < 25 ? '#F5A623' : colorHex)
    const dotKeyRaw = c.getString('dot_key') ?? ''
    out.push({
      id: c.getNumber('id'),
      dotKey: dotKeyRaw.split('DOT').join('D'),
      dotName: lang == 'zh' ? (c.getString('dot_name_zh') ?? c.getString('dot_name') ?? '') : (c.getString('dot_name') ?? ''),
      colorHex: colorHex,
      barColor: barColor,
      timing: c.getString('timing'),
      remaining: remaining,
      total: total,
      percent: pct,
      status: c.getString('status'),
      isEmpty: c.getString('status') == 'empty',
    } as UTSJSONObject)
  }
  return out
}

function bioAgeColor(bio : number | null, chrono : number | null) : string {
  if (bio == null || chrono == null) return '#EEF2FF'
  const diff = bio! - chrono!
  if (diff > 2) return '#ef4444'
  if (diff < -2) return '#10b981'
  return '#f59e0b'
}

function _execAll(re : RegExp, s : string) : string[][] {
  // matchAll equivalent: returns [full, g1, g2] per match.
  const out : string[][] = []
  let m = re.exec(s)
  while (m != null) {
    const g : string[] = []
    for (let i = 0; i < m!.length; i++) g.push(m![i] ?? '')
    out.push(g)
    if (re.lastIndex <= 0) break
    m = re.exec(s)
  }
  return out
}

// The legacy text plan: "7月5日: 早上 D01x2 D02x1 晚上 D03x1" one line per day.
function parsePlan(text : string | null, dotsMap : UTSJSONObject, lang : string) : UTSJSONObject[] {
  if (text == null || text.length == 0) return [] as UTSJSONObject[]
  const t = lang == 'zh' ? T_MAIN_ZH : T_MAIN_EN
  const now = new Date()
  const todayM = now.getMonth() + 1
  const todayD = now.getDate()
  const tmr = new Date(now.getTime())
  tmr.setDate(now.getDate() + 1)
  const tmrM = tmr.getMonth() + 1
  const tmrD = tmr.getDate()

  const out : UTSJSONObject[] = []
  for (const line of text.trim().split('\n')) {
    if (line.trim().length == 0) continue
    const ci = line.indexOf(':')
    if (ci == -1) continue
    const dateText = line.substring(0, ci).trim()
    const rest = line.substring(ci + 1).trim()

    const parseDots = (str : string | null) : UTSJSONObject[] => {
      const arr : UTSJSONObject[] = []
      if (str == null || str.length == 0) return arr
      for (const g of _execAll(/D(\d{2})x(\d+)/g, str!)) {
        const dotKey = `DOT${g[1]}`
        const dot = dotsMap.getJSON(dotKey)
        arr.push({
          displayKey: `D${g[1]}`,
          count: parseInt(g[2]),
          color: dot != null ? (dot!.getString('color_hex') ?? '#6375EC') : '#6375EC',
        } as UTSJSONObject)
      }
      return arr
    }

    const mMatch = rest.match(/(?:早上|Morning)\s+((?:D\d{2}x\d+\s*)+)/i)
    const eMatch = rest.match(/(?:晚上|Evening)\s+((?:D\d{2}x\d+\s*)+)/i)

    let month : number | null = null
    let day : number | null = null
    const zhDate = dateText.match(/(\d+)月(\d+)日/)
    const enDate = dateText.match(/([A-Za-z]+)\s+(\d+)/)
    if (zhDate != null) { month = parseInt(zhDate![1] ?? ''); day = parseInt(zhDate![2] ?? '') }
    else if (enDate != null) {
      const mi = MONTH_EN.findIndex((mn) : boolean => (enDate![1] ?? '').toLowerCase().startsWith(mn.toLowerCase().substring(0, 3)))
      if (mi != -1) { month = mi + 1; day = parseInt(enDate![2] ?? '') }
    }

    let label = dateText
    if (month != null && day != null) {
      if (month == todayM && day == todayD) label = tMainTr(t, 'today')
      else if (month == tmrM && day == tmrD) label = tMainTr(t, 'tomorrow')
    }

    out.push({
      dateStr: month != null && day != null ? `${now.getFullYear()}-${_pad2(month!)}-${_pad2(day!)}` : '',
      label: label,
      isToday: month != null && day != null && month == todayM && day == todayD,
      morning: parseDots(mMatch != null ? mMatch![1] : null),
      evening: parseDots(eMatch != null ? eMatch![1] : null),
    } as UTSJSONObject)
  }
  return out
}

function mapStructuredSchedules(schedules : UTSJSONObject[], dotsMap : UTSJSONObject, lang : string) : UTSJSONObject[] {
  const t = lang == 'zh' ? T_MAIN_ZH : T_MAIN_EN
  const keys : string[] = []
  const groups = new Map<string, UTSJSONObject>()
  const todayStr = localISODate(new Date())

  for (const s of schedules) {
    // PG DATE may come back as full ISO or just date
    const raw = s['scheduled_date']
    let dateStr = `${raw}`
    const tIdx = dateStr.indexOf('T')
    if (tIdx > 0) dateStr = dateStr.substring(0, tIdx)
    if (!groups.has(dateStr)) {
      groups.set(dateStr, {
        dateStr: dateStr,
        label: fmtDate(dateStr, lang),
        isToday: dateStr == todayStr,
        morning: [] as UTSJSONObject[],
        evening: [] as UTSJSONObject[],
      } as UTSJSONObject)
      keys.push(dateStr)
    }
    const recipe = s.getJSON('recipe')
    const dots = recipe != null ? recipe!.getJSON('dots') : null
    const parsed : UTSJSONObject[] = []
    if (dots != null) {
      dots!.toMap().forEach((count : any | null, key : string) => {
        const dot = dotsMap.getJSON(key)
        parsed.push({
          displayKey: key.split('DOT').join('D'),
          count: count,
          color: dot != null ? (dot!.getString('color_hex') ?? '#6375EC') : '#6375EC',
        } as UTSJSONObject)
      })
    }
    const slot = s.getString('slot_name')
    const g = groups.get(dateStr)!
    if (slot == 'morning_cup') g['morning'] = parsed
    else if (slot == 'evening_cup') g['evening'] = parsed
  }

  const out : UTSJSONObject[] = []
  for (const k of keys) out.push(groups.get(k)!)
  out.sort((a, b) : number => {
    const ta = _parseMs(`${a['dateStr']}`)
    const tb = _parseMs(`${b['dateStr']}`)
    return ta - tb
  })
  // 'today' / 'tomorrow' relabels on the label, same as parsePlan (WXML shows label).
  for (const g of out) {
    const ds = `${g['dateStr']}`
    if (ds.length == 10) {
      const mm = parseInt(ds.substring(5, 7))
      const dd = parseInt(ds.substring(8, 10))
      const now = new Date()
      if (mm == now.getMonth() + 1 && dd == now.getDate()) g['label'] = tMainTr(t, 'today')
      else {
        const tmr = new Date(now.getTime())
        tmr.setDate(now.getDate() + 1)
        if (mm == tmr.getMonth() + 1 && dd == tmr.getDate()) g['label'] = tMainTr(t, 'tomorrow')
      }
    }
  }
  return out
}

// The full name of a dots package: product + tier, ONE definition used by package rows, code rows
// and the submit picker (a user comparing them must not see three spellings).
function pkgTitle(p : UTSJSONObject | null, fallback : string) : string {
  if (p == null) return fallback
  const name = p!.getString('package_name') ?? ''
  const tier = p!.getString('tier_label') ?? ''
  const joined = name.length > 0 && tier.length > 0 ? `${name} · ${tier}` : (name.length > 0 ? name : tier)
  return joined.length > 0 ? joined : fallback
}

// One row per unredeemed code the user owns. Only codes bought in-app carry a buyer; manual entry
// covers codes a store handed over in person.
function mapCodes(rawCodes : UTSJSONObject[] | null, lang : string) : UTSJSONObject[] {
  const out : UTSJSONObject[] = []
  if (rawCodes == null) return out
  const t = lang == 'zh' ? T_MAIN_ZH : T_MAIN_EN
  for (let i = 0; i < rawCodes!.length; i++) {
    const c = rawCodes![i]
    const bits : string[] = []
    const max = c.getNumber('max_distinct_dots')
    if (max != null) bits.push(pkgTierUpTo(lang, max!))
    if (c['sold_at'] != null) bits.push(codeSoldOn(lang, fmtDate(c['sold_at'], lang)))
    out.push({
      key: `${c.getString('code')}-${i}`,
      code: c.getString('code') ?? '',
      name: pkgTitle(c, tMainTr(t, 'codeUnnamed')),
      meta: bits.join(' · '),
      max_distinct_dots: max,
      // An expert-review package is Viva AG's to formulate — the user does nothing after redeeming.
      fastTrack: c.getString('fulfillment') != 'expert_review',
    } as UTSJSONObject)
  }
  return out
}

// One row per dots package. Every stage label is t['pkgStage_' + stage] (one line per new stage in
// each T block, nothing else). A missing key falls back to the generic name, never an empty pill.
function mapPackages(rawPackages : UTSJSONObject[] | null, lang : string) : UTSJSONObject[] {
  const out : UTSJSONObject[] = []
  if (rawPackages == null) return out
  const t = lang == 'zh' ? T_MAIN_ZH : T_MAIN_EN
  for (let i = 0; i < rawPackages!.length; i++) {
    const p = rawPackages![i]
    const name = pkgTitle(p, tMainTr(t, 'pkgUnnamed'))
    const stage = p.getString('stage') ?? ''
    const bits : string[] = []
    if (stage == 'active' && (p.getNumber('day_index') ?? 0) > 0) {
      bits.push(pkgDay(lang, p.getNumber('day_index') ?? 0, p.getNumber('total_days') ?? 0))
    } else {
      const max = p.getNumber('max_distinct_dots')
      if (max != null) bits.push(pkgTierUpTo(lang, max!))
      if (p['ordered_at'] != null) bits.push(pkgOrderedOn(lang, fmtDate(p['ordered_at'], lang)))
    }
    const orderId = p.getString('order_id')
    const planId = p.getNumber('plan_id')
    const carrier = p.getString('shipping_carrier') ?? ''
    const tracking = p.getString('tracking_number') ?? ''
    const trackDesc = p.getString('tracking_status_desc') ?? ''
    const trackBits : string[] = []
    if (carrier.length > 0) trackBits.push(carrier)
    if (tracking.length > 0) trackBits.push(tracking)
    if (trackDesc.length > 0) trackBits.push(trackDesc)
    out.push({
      // wx:key equivalent: order_id is a UUID, plan_id an int; a package can have only one.
      key: `${orderId ?? 'p'}-${planId ?? 'o'}-${i}`,
      stage: stage,
      stageLabel: tMainTr(t, 'pkgStage_' + stage) != 'pkgStage_' + stage ? tMainTr(t, 'pkgStage_' + stage) : name,
      name: name,
      meta: bits.join(' · '),
      order_id: orderId,
      max_distinct_dots: p.getNumber('max_distinct_dots'),
      plan_id: planId,
      // The formula a waiting package could be filled with — DIFFERENT from plan_id (§28e);
      // dropping this is what makes the CTA silently render as a hint.
      submit_plan_id: p.getNumber('submit_plan_id'),
      distinct_dots: p.getNumber('distinct_dots'),
      can_submit: p.getBoolean('can_submit') == true,
      can_scan: p.getBoolean('can_scan') == true,
      can_order: p.getBoolean('can_order') == true,
      can_pay: p.getBoolean('can_pay') == true,
      tracking_number: tracking.length > 0 ? tracking : null,
      trackingLabel: trackBits.join(' · '),
      // "Bought and not yet finished with" — what hides the buy-another card.
      inFlight: ['proposed', 'active', 'cancelled', 'refunded'].indexOf(stage) == -1,
    } as UTSJSONObject)
  }
  return out
}

// Constrains <img> tags in HTML descriptions so pictures fit the store card width.
function prepDescHtml(html : string) : string {
  return html.replace(/<img\b([^>]*?)\/?>/gi, (m : string, attrs : string, _off : number, _src : string) : string => {
    if (/style\s*=/i.test(attrs)) {
      return `<img${attrs.replace(/style\s*=\s*"([^"]*)"/i, (_m2 : string, s : string, _off2 : number, _src2 : string) : string => `style="max-width:100%;height:auto;${s}"`)}>`
    }
    return `<img style="max-width:100%;height:auto;display:block;"${attrs.length > 0 ? ' ' + attrs : ''}>`
  })
}

function mapStoreItems(rawItems : UTSJSONObject[], lang : string) : UTSJSONObject[] {
  const t = lang == 'zh' ? T_MAIN_ZH : T_MAIN_EN
  const out : UTSJSONObject[] = []
  for (const item of rawItems) {
    const tag = item.getString('tag') ?? ''
    let tagLabel : string | null = null
    if (tag == 'bestseller') tagLabel = tMainTr(t, 'storeBestseller')
    else if (tag == 'value') tagLabel = tMainTr(t, 'storeValue')
    const partnerRaw = lang == 'zh' ? item.getNumber('partner_price_cny') : item.getNumber('partner_price_usd')
    const hasPartnerPrice = partnerRaw != null
    const desc = (lang == 'zh' ? item.getString('desc_zh') : item.getString('desc_en')) ?? ''
    const descIsHtml = /<[a-z][^>]*>/i.test(desc)
    // price_credits rides the wire as a string or number — read the raw value like the source does.
    const pcRaw = item['price_credits']
    const hasCreditsPrice = pcRaw != null
    const creditsRaw = hasCreditsPrice ? parseFloat(`${pcRaw}`) : NaN
    const variantsArr = item.getArray<UTSJSONObject>('variants')
    let variants : UTSJSONObject[] | null = null
    if (variantsArr != null) {
      variants = [] as UTSJSONObject[]
      for (const v of variantsArr!) {
        const attrs = v.getJSON('attributes')
        const labelBits : string[] = []
        if (attrs != null) {
          attrs!.toMap().forEach((val : any | null, k : string) => { labelBits.push(`${k} ${val}`) })
        }
        variants!.push({
          id: v['id'],
          skuCode: v.getString('sku_code'),
          label: labelBits.join(' · '),
          stockQuantity: v.getNumber('stock_quantity'),
        } as UTSJSONObject)
      }
    }
    const priceCny = item.getNumber('price_cny') ?? 0
    const priceUsd = item.getNumber('price_usd') ?? 0
    out.push({
      id: item['id'],
      key: item.getString('key_name'),
      name: lang == 'zh' ? (item.getString('name_zh') ?? '') : (item.getString('name_en') ?? ''),
      desc: descIsHtml ? prepDescHtml(desc) : desc,
      descIsHtml: descIsHtml,
      unit: lang == 'zh' ? item.getString('unit_zh') : item.getString('unit_en'),
      price: hasCreditsPrice ? `${creditsRaw} ${lang == 'zh' ? '积分' : 'pts'}` : (lang == 'zh' ? `¥${priceCny}` : `$${priceUsd}`),
      partnerPrice: (!hasCreditsPrice && hasPartnerPrice) ? (lang == 'zh' ? `¥${partnerRaw}` : `$${partnerRaw}`) : '',
      rawPrice: hasCreditsPrice ? creditsRaw : (hasPartnerPrice ? partnerRaw! : (lang == 'zh' ? priceCny : priceUsd)),
      useCredits: hasCreditsPrice,
      tagLabel: tagLabel,
      variants: variants,
      selectedVariantId: null as string | null,
    } as UTSJSONObject)
  }
  return out
}

function mapStoreOrders(rawOrders : UTSJSONObject[], lang : string) : UTSJSONObject[] {
  const out : UTSJSONObject[] = []
  for (const o of rawOrders) {
    const idStr = idOf(o, 'id')
    out.push({
      id: idStr,
      shortId: idStr.substring(0, Math.min(8, idStr.length)),
      name: lang == 'zh' ? (o.getString('name_zh') ?? o.getString('item_key') ?? '') : (o.getString('name_en') ?? o.getString('item_key') ?? ''),
      unit: lang == 'zh' ? o.getString('unit_zh') : o.getString('unit_en'),
      quantity: o.getNumber('quantity'),
      price: o['price_credits'] != null ? `${o.getString('price_credits')} ${lang == 'zh' ? '积分' : 'pts'}` : (lang == 'zh' ? `¥${o.getNumber('price_cny') ?? 0}` : `$${o.getNumber('price_usd') ?? 0}`),
      status: o.getString('status'),
      createdAt: fmtDateShort(o['created_at']),
      shippingName: o.getString('shipping_name') ?? '',
      shippingPhone: o.getString('shipping_phone') ?? '',
      shippingAddress: o.getString('shipping_address') ?? '',
      shippingCarrier: o.getString('shipping_carrier') ?? '',
      trackingNumber: o.getString('tracking_number') ?? '',
      paymentStatus: o.getString('payment_status') ?? 'paid',
      paymentMethod: o.getString('payment_method') ?? 'wechat_pay',
      shippedAt: o['shipped_at'] != null ? fmtDateShort(o['shipped_at']) : '',
      deliveredAt: o['delivered_at'] != null ? fmtDateShort(o['delivered_at']) : '',
    } as UTSJSONObject)
  }
  return out
}

// ── page-local value classes ──────────────────────────────────────────────────

class ChatMsg {
  id : string = ''
  role : string = 'user'          // user | ai | coach | action
  content : string = ''           // RAW text; AI rows are segmented for display, never written back
  imageUrl : string | null = null
  source : string | null = null   // 'viva_ag' attribution, else null
  action : string = ''
  label : string = ''
  ts : number = 0
  sep : string = ''
  imageOnly : boolean = false
  segments : Segment[] = []
}

class DayFlag {
  checkinDone : boolean = false
  lessonDone : boolean = true
  completed : boolean = false
}

class LessonWatch {
  seconds : number = 0
  last : number = -1              // -1 == null (no recent timeupdate sample)
  min : number = 0
  reported : number = 0
}

// "The user backed out of the package picker" is NOT "nothing is waiting" — one silently does
// nothing, the other must explain itself. (The miniapp used a Symbol; UTS has none.)
class PickerResult {
  cancelled : boolean = false
  orderId : string | null = null
}

// 用餐/身高体重 sliders state + the :::formula card CTA map are kept as UTSJSONObject / Map keyed
// by `${messageId}:${segmentIndex}` — Segment (utils/markdown.uts) has no cta field and is frozen.

// _checkIdentityVerified returns both store-gate flags (phone + email, AGENTS §33).
class IdentityFlags {
  phone : boolean = false
  email : boolean = false
}

// uni.request's awaitable overload only resolves in module scope with a RequestMethod-TYPED
// parameter (mirrors utils/request.uts's _run); inside component methods the same call shape
// silently selects the RequestTask overload (full-build Kotlin error).
async function _envelopeRun(url : string, method : RequestMethod, data : UTSJSONObject | null, timeoutMs : number) : Promise<RespEnvelope> {
  const header = { 'Content-Type': 'application/json', 'Authorization': `Bearer ${state.apiToken}` } as UTSJSONObject
  let res : RequestSuccess<UTSJSONObject> | null = null
  await new Promise<boolean>((resolve : (v : boolean) => void, _reject : (e : any | null) => void) => {
    uni.request<UTSJSONObject>({
      url: url, method: method, header: header, data: data, timeout: timeoutMs,
      success: (r) => { res = r; resolve(true) },
      fail: (err) => { resolve(false) },
    })
  })
  if (res == null) return new RespEnvelope(0, null)
  checkAuthStatus(res!.statusCode)
  return new RespEnvelope(res!.statusCode, res!.data)
}


// WeChat address → one line (miniapp main.js _joinAddress): skip a part the line already ends with,
// so 北京市 + 北京市 + 朝阳区 does not repeat the municipality.
function _joinAddress(parts : any[]) : string {
  let out = ''
  for (const part of parts) {
    const p = part != null ? `${part}`.trim() : ''
    if (p.length > 0 && !out.endsWith(p)) out += p
  }
  return out
}

// The soft keyboard's height from a focus / keyboardheightchange event (detail.height), or 0.
function _kbHeight(e : any) : number {
  // #ifdef MP-WEIXIN
  const d = e != null ? e.detail : null
  const h = d != null ? d.height : null
  return h != null ? (h as number) : 0
  // #endif
  // #ifndef MP-WEIXIN
  return 0 // native and web keep their default keyboard behaviour
  // #endif
}

