<template>
  <!-- Ported from miniapp pages/main/main.wxml. Deviations, deliberate (see utils/../README decision table):
     - mp-html → <rich-text> for prose segments (markdown.uts emits the same html strings);
     - the mic (WechatSI ASR) button is REMOVED — TODO(port): ASR plugin — the send button still works;
     - wx.chooseAddress (使用微信地址) and the privacy modal (wx.onNeedPrivacyAuthorization) are
       xapp-mini only; native has manual address entry and OS permission prompts;
     - capsule geometry / edge-swipe animation args dropped where native doesn't need them.
     Kept verbatim: all five tabs, the Kino overlay flow, onboarding gating, every modal/sheet,
     the ::: card render chain (metric/takeaway/dots/formula/product/grocery/lesson/checkin),
     the async two-channel chat delivery UI (§22), the pinch text-scale, and the 100px
     chat-inner bottom padding that fixes the clipped-last-message bug (AGENTS §23 — 200rpx ≈ 100px). -->
  <view class="main" :class="[theme == 'light' ? 'theme-light' : '', 'fs-' + textScale]" v-on:touchstart="onTouchStart" v-on:touchend="onTouchEnd">

    <!-- ── Status bar spacer ── -->
    <view class="status-bar-spacer" :style="'height:' + statusBarHeight + 'px'"></view>

    <!-- ── Header ── -->
    <view class="app-header" :style="capsuleRightPad > 0 ? 'padding-right:' + capsuleRightPad + 'px' : ''" v-on:click="toggleMenu">
      <view class="header-logo-btn">
        <image class="header-logo-img" :src="channelLogo" mode="aspectFit" />
        <text class="header-title">{{ channelName }}</text>
      </view>
      <view class="header-divider"></view>
      <text class="header-user">{{ isGuest ? tr('guestHeaderName') : headerUserName }}</text>
      <text v-if="version.length > 0" class="header-version">v{{ version }}</text>
    </view>

    <!-- ── Sandbox banner ── -->
    <view v-if="sandboxMode" class="sandbox-banner" v-on:click="exitSandbox">
      <text class="sandbox-banner-text">{{ sandboxBannerText }}</text>
      <text class="sandbox-banner-exit">{{ tr('exitSandbox') }}</text>
    </view>

    <!-- ── Viva subscription expired banner ── -->
    <view v-if="!sandboxMode && personaType == 'viva' && vivaSubscriptionExpired" class="viva-expired-banner" v-on:click="handleBuyVivaSubscription">
      <text class="viva-expired-banner-text">{{ tr('vivaSubscriptionExpiredBanner') }}</text>
      <text class="viva-expired-banner-btn">{{ tr('vivaSubscriptionRenewBtn') }}</text>
    </view>

    <!-- ── Logo menu ── -->
    <view v-if="menuOpen" class="menu-mask" v-on:click="closeMenu">
      <view class="menu-dropdown" :style="menuDropdownStyle" v-on:click.stop="noop">
        <view v-if="!isGuest && isAeviva && personaType == 'viva' && !vivaSubscriptionExpired && vivaSubscriptionExpiresAtDisplay.length > 0" class="menu-credit-row" v-on:click="openVivaRedeemSheet">
          <text class="menu-credit-label">{{ lang == 'zh' ? 'Viva 订阅至' : 'Viva subscribed until' }}</text>
          <text class="menu-credit-value">{{ vivaSubscriptionExpiresAtDisplay }}</text>
        </view>
        <!-- #ifdef WEB -->
        <view v-if="!isGuest && isAeviva && personaType == 'viva' && !vivaSubscriptionExpired && vivaSubscriptionExpiresAtDisplay.length > 0 && creditBalance <= 0" class="menu-divider"></view>
        <!-- #endif -->
        <view v-if="!isGuest && creditBalance > 0" class="menu-credit-row" v-on:click="openReferral">
          <text class="menu-credit-label">{{ lang == 'zh' ? '积分余额' : 'Credits' }}</text>
          <text class="menu-credit-value">{{ creditBalance }} pts</text>
        </view>
        <!-- #ifdef WEB -->
        <view v-if="!isGuest && creditBalance > 0" class="menu-divider"></view>
        <!-- #endif -->
        <view v-if="isCoach" class="menu-item" v-on:click="openCoach">
          <text class="menu-item-icon">👨‍⚕️</text>
          <text class="menu-item-label">{{ tr('coachMenu') }}</text>
        </view>
        <!-- #ifdef WEB -->
        <view v-if="isAdmin" class="menu-divider"></view>
        <view v-if="isAdmin" class="menu-item" v-on:click="openAdminPanel">
          <text class="menu-item-icon">⚙</text>
          <text class="menu-item-label">{{ lang == 'zh' ? '渠道管理' : 'Channel Admin' }}</text>
        </view>
        <view v-if="isSuperadmin" class="menu-divider"></view>
        <view v-if="isSuperadmin" class="menu-item" v-on:click="openAdminPanel">
          <text class="menu-item-icon">🖥</text>
          <text class="menu-item-label">{{ tr('webAdminMenu') }}</text>
        </view>
        <!-- #endif -->
        <!-- #ifndef WEB -->
        <view v-if="isAdmin" class="menu-divider"></view>
        <view v-if="isAdmin" class="menu-item" v-on:click="openWebAdmin">
          <text class="menu-item-icon">🖥</text>
          <text class="menu-item-label">{{ tr('webAdminMenu') }}</text>
        </view>
        <!-- #endif -->
        <view v-if="!isGuest" class="menu-divider"></view>
        <view v-if="!isGuest" class="menu-item" v-on:click="openReferral">
          <text class="menu-item-icon">★</text>
          <text class="menu-item-label">{{ tr('referralMenu') }}</text>
        </view>
        <view v-if="!isGuest" class="menu-item" v-on:click="openPhones">
          <text class="menu-item-icon">📱</text>
          <text class="menu-item-label">{{ tr('phonesMenu') }}</text>
        </view>
        <view v-if="!isGuest && emailLoginAllowed" class="menu-item" v-on:click="openEmails">
          <text class="menu-item-icon">✉️</text>
          <text class="menu-item-label">{{ tr('emailsMenu') }}</text>
        </view>
        <view v-if="!isGuest && isAeviva && personaType == 'viva'" class="menu-item" v-on:click="openVivaRedeemSheet">
          <text class="menu-item-icon">✧</text>
          <text class="menu-item-label">{{ tr('vivaRedeemMenu') }}</text>
        </view>
        <!-- #ifndef WEB -->
        <view v-if="isAdmin || isSuperadmin" class="menu-divider"></view>
        <view v-if="isAdmin || isSuperadmin" class="menu-item" v-on:click="openKinoSim">
          <text class="menu-item-icon">⬡</text>
          <text class="menu-item-label">{{ tr('kinoSimMenu') }}</text>
        </view>
        <!-- #endif -->
        <view class="menu-divider"></view>
        <view class="menu-item" v-on:click="toggleTheme">
          <text class="menu-item-icon">{{ theme == 'dark' ? '☀' : '🌑' }}</text>
          <text class="menu-item-label">{{ theme == 'dark' ? tr('lightMode') : tr('darkMode') }}</text>
        </view>
        <view class="menu-divider"></view>
        <!-- Text size stepper: setTextScale deliberately does NOT close the menu (4-way control,
             watch the text resize behind it). The four A glyphs keep hardcoded sizes on purpose. -->
        <view class="menu-fs-row">
          <text class="menu-item-icon">A</text>
          <text class="menu-item-label">{{ tr('textSizeMenu') }}</text>
          <view class="menu-fs-steps">
            <view class="menu-fs-step" :class="textScale == 0 ? 'menu-fs-step-on' : ''" v-on:click="setTextScale(0)"><text class="menu-fs-a0">A</text></view>
            <view class="menu-fs-step" :class="textScale == 1 ? 'menu-fs-step-on' : ''" v-on:click="setTextScale(1)"><text class="menu-fs-a1">A</text></view>
            <view class="menu-fs-step" :class="textScale == 2 ? 'menu-fs-step-on' : ''" v-on:click="setTextScale(2)"><text class="menu-fs-a2">A</text></view>
            <view class="menu-fs-step" :class="textScale == 3 ? 'menu-fs-step-on' : ''" v-on:click="setTextScale(3)"><text class="menu-fs-a3">A</text></view>
          </view>
        </view>
        <view class="menu-divider"></view>
        <view class="menu-item" v-on:click="toggleLang">
          <text class="menu-item-icon">{{ lang == 'zh' ? '🇺🇸' : '🇨🇳' }}</text>
          <text class="menu-item-label">{{ lang == 'zh' ? 'English' : '中文' }}</text>
        </view>
        <view class="menu-divider"></view>
        <view v-if="!isGuest" class="menu-item" v-on:click="handleLogout">
          <text class="menu-item-icon">↪</text>
          <text class="menu-item-label">{{ sandboxMode ? tr('exitSandbox') : tr('logout') }}</text>
        </view>
        <view v-if="isGuest" class="menu-item" v-on:click="openSignIn">
          <text class="menu-item-icon">↩</text>
          <text class="menu-item-label">{{ tr('guestMenuSignIn') }}</text>
        </view>
        <view v-if="isGuest" class="menu-item" v-on:click="openGuestSheet">
          <text class="menu-item-icon">✦</text>
          <text class="menu-item-label">{{ tr('guestMenuSignUp') }}</text>
        </view>
      </view>
    </view>

    <!-- ── Tab Content ── -->
    <view class="tab-content">

      <!-- ════ CHAT ════ -->
      <view v-show="tab == 'chat'" class="chat-tab"
            v-on:touchstart="onTabTouchStart" v-on:touchmove="onTabTouchMove"
            v-on:touchend="onTabTouchEnd" v-on:touchcancel="onTabTouchEnd">

        <scroll-view direction="vertical" class="chat-messages"
          :scroll-top="scrollTop" :scroll-with-animation="false"
          :scroll-into-view="scrollAnchor"
          :refresher-enabled="hasMoreHistory" :refresher-triggered="historyLoading"
          v-on:refresherrefresh="onPullLoadMore" v-on:scrolltoupper="onScrollToUpper">
          <view class="chat-inner">

            <!-- history load-more / start indicator -->
            <view v-if="hasMoreHistory" class="chat-history-load" :class="historyLoading ? 'chat-history-loading' : ''" v-on:click="onLoadMoreHistoryTap">
              <text class="chat-history-text">{{ historyLoading ? tr('chatHistoryLoading') : tr('chatHistoryLoadMore') }}</text>
            </view>
            <view v-else-if="messages.length > 0" class="chat-history-start">
              <text class="chat-history-start-text">{{ tr('chatHistoryStart') }}</text>
            </view>

            <view v-for="(m, mi) in messages" :key="m.id">
              <view v-if="m.sep.length > 0" class="msg-daysep"><text class="msg-daysep-text">{{ m.sep }}</text></view>
              <view :id="'m' + m.id" class="msg-row" :class="m.role == 'user' ? 'msg-row-user' : 'msg-row-ai'">
                <view v-if="m.role == 'action'" class="msg-action-card" v-on:click="handleMsgAction(m.action)">
                  <text class="msg-action-label">{{ m.label }}</text>
                  <text class="msg-action-arrow">›</text>
                </view>
                <view v-else-if="m.role == 'coach'" class="message-bubble message-coach">
                  <text class="msg-coach-label">Coach</text>
                  <text class="msg-text" :style="fs(14)">{{ m.content }}</text>
                </view>
                <view v-else class="message-bubble" :class="(m.role == 'user' ? 'message-user' : 'message-ai') + (m.imageOnly ? ' msg-bubble-image' : '')">
                  <image v-if="m.imageUrl != null" class="msg-image" :class="m.imageOnly ? '' : 'msg-image-inset'" :src="m.imageUrl" mode="widthFix" v-on:load="onChatImageLoad(m.id)" />
                  <text v-if="m.role == 'user' && m.content.length > 0" class="msg-text msg-text-user" :style="fs(14)">{{ m.content }}</text>
                  <text v-if="m.source == 'viva_ag'" class="msg-ag-label">Viva AG</text>
                  <view v-if="m.role != 'user'" v-for="(seg, si) in m.segments" :key="si" class="msg-seg" :style="'width: ' + msgTextW + 'px'">
                    <rich-text v-if="seg.t == 'html'" class="msg-html" :style="'width: ' + msgTextW + 'px'" :nodes="_sh(seg.h)" />
                    <view v-else-if="seg.t == 'rule'" class="msg-rule"></view>
                    <view v-else-if="seg.t == 'metric'" class="mcard">
                      <view v-for="(item, mj) in seg.metricItems" :key="mj" class="mcard-tile" :class="'mcard-' + item.s">
                        <text class="mcard-label">{{ item.label }}</text>
                        <view class="mcard-valrow">
                          <text class="mcard-val">{{ item.value }}</text>
                          <text v-if="item.unit.length > 0" class="mcard-unit">{{ item.unit }}</text>
                          <view v-if="tileSpark(item.label) != null" class="spark" :class="'spark-t-' + tileSpark(item.label)!.tone">
                            <view v-for="(sb, sk) in tileSpark(item.label)!.bars" :key="sk" class="spark-bar" :class="sb.last ? 'spark-bar-last-' + tileSpark(item.label)!.tone : ''" :style="'height:' + sb.h + '%'"></view>
                          </view>
                        </view>
                        <view v-if="item.sl.length > 0 || tileSpark(item.label) != null" class="mcard-footrow">
                          <text v-if="item.sl.length > 0" class="mcard-pill">{{ item.sl }}</text>
                          <text v-if="tileSpark(item.label) != null && tileSpark(item.label)!.delta.length > 0" class="spark-delta" :class="'spark-d-' + tileSpark(item.label)!.tone">{{ tileSpark(item.label)!.arrow }}{{ tileSpark(item.label)!.delta }}</text>
                        </view>
                      </view>
                    </view>
                    <view v-else-if="seg.t == 'takeaway'" class="tcard">
                      <text class="tcard-title">{{ takeawayTitle(seg) }}</text>
                      <rich-text class="msg-html tcard-body" :style="'width: ' + (msgTextW - 26) + 'px'" :nodes="_sh(seg.takeaway != null ? seg.takeaway!.h : '')" />
                    </view>
                    <view v-else-if="seg.t == 'dots'" class="dcard">
                      <view v-for="(di, dj) in seg.dotItems" :key="dj" class="dcard-chip">
                        <text class="dcard-id">{{ di.id }}</text>
                        <text v-if="di.name.length > 0" class="dcard-name">{{ di.name }}</text>
                        <text v-if="di.note.length > 0" class="dcard-note">{{ di.note }}</text>
                      </view>
                    </view>
                    <view v-else-if="seg.t == 'formula'" class="fcard">
                      <view class="fcard-head">
                        <text class="fcard-title">{{ tr('formulaCardTitle') }}</text>
                        <text class="fcard-note">{{ tr('formulaEvalNote') }}</text>
                      </view>
                      <!-- One block per purchasable package, each a COMPLETE formula; recommended
                           one open, others collapse to name+note+roster and expand on tap. -->
                      <view v-for="(ft, fti) in seg.formulaTiers" :key="fti" class="fcard-tier" :class="ft.open ? 'fcard-tier-open' : ''">
                        <view v-if="ft.label.length > 0" class="fcard-tier-head" v-on:click="handleFormulaTierToggle(m, si, fti)">
                          <view class="fcard-tier-name">
                            <text class="fcard-tier-label">{{ ft.label }}</text>
                            <text v-if="ft.recommended" class="fcard-tier-rec">{{ tr('formulaTierRecommended') }}</text>
                          </view>
                          <text class="fcard-tier-chev">{{ ft.open ? '⌃' : '⌄' }}</text>
                        </view>
                        <view v-if="ft.note.length > 0" class="fcard-tier-note" v-on:click="handleFormulaTierToggle(m, si, fti)">
                          <text class="fcard-tier-note-text">{{ ft.note }}</text>
                        </view>
                        <view v-if="!ft.open" class="fcard-legend fcard-tier-dots" v-on:click="handleFormulaTierToggle(m, si, fti)">
                          <view v-for="(fd, fdk) in ft.dots" :key="fdk" class="fcard-leg">
                            <view class="fcard-swatch" :style="'background:' + fd.color"></view>
                            <text class="fcard-leg-name">{{ fd.name }}</text>
                          </view>
                        </view>
                        <view v-if="ft.open">
                          <view v-for="(fg, fgi) in ft.groups" :key="fgi" class="fcard-group">
                            <view v-if="fg.days.length > 0" class="fcard-days">
                              <text class="fcard-daylabel">{{ tr('formulaDayWord') }} {{ fg.days }}</text>
                              <text v-if="fg.kind == 'n7'" class="fcard-daytag">{{ tr('formulaResetDay') }}</text>
                            </view>
                            <view class="fcard-row">
                              <text class="fcard-slot">{{ tr('formulaAm') }}</text>
                              <view class="fcard-track">
                                <view v-for="(fi, fk) in fg.items" :key="fk" class="fcard-seg" :style="'width:' + fi.amPct + '%;background:' + fi.color"></view>
                              </view>
                              <text class="fcard-num">{{ fg.am }}</text>
                            </view>
                            <view class="fcard-row">
                              <text class="fcard-slot">{{ tr('formulaPm') }}</text>
                              <view class="fcard-track">
                                <view v-for="(fi, fk) in fg.items" :key="fk" class="fcard-seg" :style="'width:' + fi.pmPct + '%;background:' + fi.color"></view>
                              </view>
                              <text class="fcard-num">{{ fg.pm }}</text>
                            </view>
                            <view class="fcard-legend">
                              <view v-for="(fi, fk) in fg.items" :key="fk" class="fcard-leg">
                                <view class="fcard-swatch" :style="'background:' + fi.color"></view>
                                <text class="fcard-leg-name">{{ fi.name }}</text>
                                <text class="fcard-leg-num">{{ fi.am }}·{{ fi.pm }}</text>
                              </view>
                            </view>
                            <text class="fcard-foot">{{ tr('formulaTotalLabel') }} {{ fg.total }}</text>
                          </view>
                          <text v-if="ft.pitch.length > 0" class="fcard-tier-pitch">{{ ft.pitch }}</text>
                        </view>
                      </view>
                      <text v-if="seg.cycleDays > 0" class="fcard-cycle">{{ seg.cycleDays }}{{ tr('formulaDaysUnit') }} · {{ seg.cycleCapsules }}{{ tr('formulaCapsulesUnit') }}</text>
                      <text v-if="seg.formulaTiers.length > 1" class="fcard-tier-hint">{{ tr('formulaTierHint') }}</text>
                      <!-- Retired upgrade ladder, kept for cards written before packages replaced it —
                           chat history is permanent. -->
                      <view v-if="seg.formulaRungs.length > 0" class="fcard-upgrades">
                        <text class="fcard-uphead">{{ tr('formulaUpgradeTitle') }}</text>
                        <view v-for="(fr, fri) in seg.formulaRungs" :key="fri" class="fcard-rung">
                          <view class="fcard-rung-head">
                            <text class="fcard-rung-label">{{ fr.label }}</text>
                            <text class="fcard-rung-add">+{{ fr.items.length }}</text>
                          </view>
                          <view class="fcard-legend fcard-rung-dots">
                            <view v-for="(ri, rk) in fr.items" :key="rk" class="fcard-leg">
                              <view class="fcard-swatch" :style="'background:' + ri.color"></view>
                              <text class="fcard-leg-name">{{ ri.name }}</text>
                              <text class="fcard-leg-num">{{ ri.am }}·{{ ri.pm }}</text>
                              <text v-if="ri.weeks.length > 0" class="fcard-leg-weeks">{{ tr('formulaWeekPrefix') }}{{ ri.weeks }}{{ tr('formulaWeekSuffix') }}</text>
                            </view>
                          </view>
                          <text v-if="fr.pitch.length > 0" class="fcard-rung-pitch">{{ fr.pitch }}</text>
                        </view>
                        <text class="fcard-rung-hint">{{ tr('formulaUpgradeHint') }}</text>
                      </view>
                      <view v-if="seg.planId.length > 0 && isAeviva && seg.orderMode == 'submit'" class="fcard-cta" v-on:click="handleFormulaSubmit(m, si)">
                        <text class="fcard-cta-label">{{ tr('formulaSubmitCta') }}</text>
                      </view>
                      <view v-else-if="seg.planId.length > 0 && isAeviva && seg.orderMode == 'buy'">
                        <text v-if="segCtaOwned(m, si).length > 0" class="fcard-owned">{{ segCtaOwned(m, si) }}</text>
                        <view class="fcard-cta" v-on:click="handleFormulaOrder(m, si)">
                          <text class="fcard-cta-label">{{ segCtaBtn(m, si, seg) }}</text>
                        </view>
                      </view>
                      <text v-else-if="seg.orderMode == 'ag'" class="fcard-agnote">{{ tr('formulaAgPending') }}</text>
                    </view>
                    <view v-else-if="seg.t == 'product'" class="pcard">
                      <text class="pcard-title">{{ tr('productCardTitle') }}</text>
                      <view v-for="(pi, pk) in seg.productItems" :key="pi.sku" class="pcard-row" v-on:click="handleProductCardTap(pi.sku)">
                        <view class="pcard-main">
                          <text class="pcard-name">{{ pi.name }}</text>
                          <text v-if="pi.reason.length > 0" class="pcard-reason">{{ pi.reason }}</text>
                        </view>
                        <text class="pcard-price">{{ pi.price }}</text>
                        <text class="pcard-arrow">›</text>
                      </view>
                    </view>
                    <!-- :::grocery (AGENTS §46) — a tap copies the product name; the supermarket's
                         own app has no deep link a native app can verify either. -->
                    <view v-else-if="seg.t == 'grocery'" class="gcard">
                      <text class="gcard-title">{{ tr('groceryCardTitle') }}</text>
                      <view v-for="(gi, gk) in seg.groceryItems" :key="gi.id" class="gcard-row" v-on:click="handleGroceryCardTap(gi.name, gi.supplierName)">
                        <image v-if="gi.image.length > 0" class="gcard-img" :src="gi.image" mode="aspectFill" />
                        <view v-else class="gcard-img gcard-img-empty"></view>
                        <view class="gcard-main">
                          <text class="gcard-name">{{ gi.name }}</text>
                          <text v-if="gi.reason.length > 0" class="gcard-reason">{{ gi.reason }}</text>
                          <text class="gcard-supplier">{{ gi.supplierName }}</text>
                        </view>
                        <text v-if="gi.price.length > 0" class="gcard-price">{{ gi.price }}</text>
                      </view>
                      <text v-if="seg.groceryNote.length > 0" class="gcard-note">{{ seg.groceryNote }}</text>
                    </view>
                    <!-- :::lesson — 打卡 program day Academy lesson, played inline (AGENTS §42). -->
                    <view v-else-if="seg.t == 'lesson'" class="lcard">
                      <video v-if="seg.lessonUrl.length > 0" class="lcard-video" :src="seg.lessonUrl" :poster="seg.lessonPoster" :controls="true"
                             v-on:ended="handleLessonEnded(m, si)" v-on:timeupdate="onLessonTimeUpdate(m, si, $event)" v-on:pause="onLessonPause(m, si)" />
                      <view v-else class="lcard-cover" v-on:click="handleLessonCardTap(m, si)">
                        <text class="lcard-play">{{ seg.lessonLoading ? tr('loading') : '▶  ' + tr('programLessonPlay') }}</text>
                      </view>
                      <view class="lcard-meta">
                        <text class="lcard-title">{{ seg.lessonTitle }}</text>
                        <text v-if="seg.lessonDone" class="lcard-done">✓ {{ tr('programLessonDone') }}</text>
                      </view>
                    </view>
                    <!-- :::checkin — same day's 开始打卡; done-state stamped from GET /api/programs/my. -->
                    <view v-else-if="seg.t == 'checkin'" class="ccard">
                      <view v-if="seg.checkinDone" class="ccard-done">
                        <text class="ccard-cta-label">✓ {{ tr('programCheckinDone') }}</text>
                      </view>
                      <view v-else class="ccard-cta" :class="seg.checkinActive ? '' : 'ccard-cta-off'" v-on:click="handleCheckinStart(seg.checkinProgramId, seg.checkinDayIndex)">
                        <text class="ccard-cta-label">{{ seg.checkinLabel.length > 0 ? seg.checkinLabel : tr('programCheckinCta') }}</text>
                      </view>
                    </view>
                  </view>
                  <rich-text v-if="m.role != 'user' && m.segments.length == 0 && m.content.length > 0" class="msg-html" :style="'width: ' + msgTextW + 'px'" :nodes="_sh(m.content)" />
                </view>
              </view>
            </view>

            <view v-if="typing" class="msg-row msg-row-ai">
              <view class="message-bubble message-ai typing-indicator">
                <view v-for="i in 3" :key="i" class="typing-dot" :class="typingDotOn(i - 1) ? 'typing-dot-on' : ''"></view>
                <text v-if="chatStatusText.length > 0" class="typing-status-text">{{ chatStatusText }}</text>
              </view>
            </view>

            <!-- 200rpx ≈ 100px: AGENTS §23 — the short-last-message clipping fix. Do not shrink
                 this back down without confirming the underlying repaint issue is actually fixed. -->
            <view :style="'height:100px'"></view>
          </view>
        </scroll-view>

        <!-- Onboarding / questionnaire input bars (one per input_type) -->
        <view v-if="obQuestion != null && obInputType == 'text'" class="ob-bar name-bar">
          <input class="ob-input" :placeholder="obPlaceholder" v-model="obName" v-on:confirm="handleSubmitName" />
          <view class="ob-confirm" v-on:click="handleSubmitName"><text class="ob-confirm-label">{{ tr('confirm') }}</text></view>
        </view>

        <view v-if="obQuestion != null && obInputType == 'button_select' && !typing" class="ob-bar gender-bar">
          <view v-for="(opt, oi) in obOptions()" :key="oi" class="quick-btn" v-on:click="handleSelectButton(`${opt.getString('value')}`)">
            <text class="quick-btn-label">{{ obOptionLabel(opt) }}</text>
          </view>
        </view>

        <view v-if="obQuestion != null && obInputType == 'date_picker'" class="ob-bar birthday-bar">
          <picker mode="date" v-on:change="onObBirthdayChange">
            <view class="picker-row">
              <text class="picker-val">{{ obBirthday.length > 0 ? obBirthday : tr('selectBirthday') }}</text>
              <text class="picker-arrow">›</text>
            </view>
          </picker>
          <view class="ob-confirm" :class="obBirthday.length > 0 ? '' : 'ob-confirm-off'" v-on:click="handleSubmitBirthday"><text class="ob-confirm-label">{{ tr('confirm') }}</text></view>
        </view>

        <!-- Questionnaire: time picker (用餐时间 / 步行时间 in a 打卡 program day) -->
        <view v-if="obQuestion != null && obInputType == 'time_picker'" class="ob-bar birthday-bar">
          <picker mode="time" v-on:change="onObTimeChange">
            <view class="picker-row">
              <text class="picker-val">{{ obTime.length > 0 ? obTime : tr('selectTime') }}</text>
              <text class="picker-arrow">›</text>
            </view>
          </picker>
          <view class="ob-confirm" :class="obTime.length > 0 ? '' : 'ob-confirm-off'" v-on:click="handleSubmitTime"><text class="ob-confirm-label">{{ tr('confirm') }}</text></view>
        </view>

        <view v-if="obQuestion != null && obInputType == 'slider_group'" class="ob-bar body-bar">
          <view v-for="(s, si2) in obSlidersCfg()" :key="si2" class="slider-row">
            <view class="slider-labels">
              <text class="slider-key">{{ obSliderLabel(s) }}</text>
              <view class="slider-value-wrap">
                <input class="slider-val-input" type="digit" :id="'sl-' + s.getString('key')" :value="obSliderValStr(`${s.getString('key')}`)"
                       v-on:blur="onSliderValueBlur(`${s.getString('key')}`)" />
                <text class="slider-unit">{{ s.getString('unit') }}</text>
              </view>
            </view>
            <view class="slider-control-row">
              <view class="slider-step-btn" v-on:click="onSliderStep(`${s.getString('key')}`, -1)"><text>−</text></view>
              <slider class="slider-input" :min="numOr(s.getNumber('min'), 0)" :max="numOr(s.getNumber('max'), 100)" :value="obSliderNum(`${s.getString('key')}`)" :step="numOr(s.getNumber('step'), 1)"
                      active-color="#6375EC" block-color="#6375EC" v-on:change="onSliderChange(`${s.getString('key')}`, $event)" />
              <view class="slider-step-btn" v-on:click="onSliderStep(`${s.getString('key')}`, 1)"><text>＋</text></view>
            </view>
          </view>
          <view class="ob-confirm" v-on:click="handleSubmitBody"><text class="ob-confirm-label">{{ tr('confirm') }}</text></view>
        </view>

        <view v-if="obQuestion != null && obInputType == 'multi_select'" class="ob-bar conditions-bar">
          <view class="cond-chips">
            <view v-for="(c, ci) in obConditionList" :key="ci" class="cond-chip" :class="c.getBoolean('selected') == true ? 'cond-chip-on' : ''" v-on:click="handleToggleCondition(`${c.getString('key')}`)">
              <text class="cond-chip-label">{{ c.getString('label') }}</text>
            </view>
          </view>
          <input v-if="obOtherSelected" class="ob-input cond-other-input" :placeholder="tr('obConditionsOtherPh')" v-model="obConditionsOther" />
          <view class="ob-confirm" v-on:click="handleSubmitConditions"><text class="ob-confirm-label">{{ tr('confirm') }}</text></view>
        </view>

        <!-- Kino chip scan button -->
        <view v-if="kinoScanPending" class="ob-bar kino-scan-bar">
          <view class="kino-scan-btn" v-on:click="handleKinoScan">
            <text class="kino-scan-icon">⬡</text>
            <text class="kino-scan-label">{{ tr('kinoScanBtn') }}</text>
          </view>
          <view class="kino-scan-close" v-on:click="cancelKinoScan"><text class="kino-scan-x">✕</text></view>
        </view>

        <view v-if="obStep == 'done' || isGuest" class="ai-disclaimer">
          <text class="ai-disclaimer-text">{{ tr('aiDisclaimer') }}</text>
        </view>

        <!-- Normal chat input — guests get the mic slot replaced by a Sign-up CTA and send routed
             to the sign-up sheet instead of _req'ing chat.
             Press-to-talk: web (Web Speech) and xapp-mini (WechatSI) share the hold button;
             TODO(port): native needs an ASR plugin — its mic button only toasts. -->
        <view v-if="obStep == 'done' || isGuest" class="input-container">
          <toolbox v-if="toolboxOpen" :tools="toolList" :disabled="typing" v-on:toolaction="handleToolAction" />
          <view v-if="micRecording" class="mic-recording-banner">
            <view class="mic-recording-dot"></view>
            <text class="mic-recording-text">{{ tr('micRecording') }}</text>
          </view>
          <view class="input-area">
            <view class="plus-btn" :class="toolboxOpen ? 'plus-btn-open' : ''" v-on:click="toggleToolbox">
              <text class="plus-icon">+</text>
            </view>
            <textarea class="chat-textarea" :style="chatInputH" :placeholder="tr('inputPh')" placeholder-style="color: rgba(166, 196, 229, 0.4)" v-model="chatInput" maxlength="500" />
            <!-- #ifdef WEB || MP-WEIXIN -->
            <view v-if="chatInput.length == 0 && !isGuest && webSpeech" class="mic-btn" :class="micRecording ? 'mic-btn-active' : (typing ? 'mic-btn-disabled' : '')"
              v-on:touchstart="onMicStart" v-on:touchend="onMicEnd" v-on:touchcancel="onMicEnd"
              v-on:mousedown="onMicStart" v-on:mouseup="onMicEnd" v-on:mouseleave="onMicEnd">
              <image class="mic-icon-img" src="/static/icons/mic.svg" mode="aspectFit" />
            </view>
            <!-- #endif -->
            <!-- #ifdef APP -->
            <view v-if="chatInput.length == 0 && !isGuest" class="mic-btn" v-on:click="onMicTap">
              <image class="mic-icon-img" src="/static/icons/mic.svg" mode="aspectFit" />
            </view>
            <!-- #endif -->
            <view v-else-if="chatInput.length == 0 && isGuest" class="mic-btn guest-signup-btn" v-on:click="openGuestSheet">
              <text class="guest-signup-btn-text">{{ tr('guestSignupBtn') }}</text>
            </view>
            <view v-else-if="isGuest" class="send-btn send-active" v-on:click="openGuestSheet">
              <text class="send-icon">↑</text>
            </view>
            <view v-else class="send-btn" :class="chatInput.length > 0 ? 'send-active' : ''" v-on:click="handleSend">
              <text class="send-icon">↑</text>
            </view>
          </view>
        </view>
      </view>
      <!-- end CHAT -->

      <!-- ════ HEALTH ════ -->
      <!-- The health tab is the <user-health> component (parallel port, same props/events contract
           as main.wxml lines 753-768). It owns the twin layers, wearable sync (ring BLE — all ring
           calls are guarded inside it, TODO(port): BLE transport), health-documents, viva-ag-panel
           and strip-record — those are its children, not this page's. -->
      <view v-show="tab == 'health'" class="health-tab">
        <user-health ref="healthComp"
          :user="user"
          :user-id="userIdStr"
          :lang="lang"
          mode="self"
          :is-guest="isGuest"
          :theme="theme"
          :text-scale="textScale"
          :viva-ag-enabled="vivaAgActive"
          v-on:chooseavatar="handleHealthChooseAvatar"
          v-on:customavatar="handleHealthCustomAvatar"
          v-on:guesttap="openGuestSheet"
          v-on:gotochat="handleAgGoToChat"
          v-on:textscalestep="onTextScaleStep"
          v-on:profileUpdated="onProfileUpdated">
        </user-health>
      </view>
      <!-- end HEALTH -->

      <!-- ════ PLANS + DOTS ════ -->
      <view v-show="tab == 'plans'" class="plans-tab"
            v-on:touchstart="onTabTouchStart" v-on:touchmove="onTabTouchMove"
            v-on:touchend="onTabTouchEnd" v-on:touchcancel="onTabTouchEnd">

        <view class="inner-tab-bar">
          <view class="inner-tab" :class="plansDotsSubTab == 'dots' ? 'inner-tab-active' : ''" v-on:click="switchPlansDotsSubTab('dots')">
            <text class="inner-tab-text" :class="plansDotsSubTab == 'dots' ? 'inner-tab-text-on' : ''">{{ tr('plansDotsDotsTab') }}</text>
          </view>
          <view class="inner-tab" :class="plansDotsSubTab == 'plans' ? 'inner-tab-active' : ''" v-on:click="switchPlansDotsSubTab('plans')">
            <text class="inner-tab-text" :class="plansDotsSubTab == 'plans' ? 'inner-tab-text-on' : ''">{{ tr('plansDotsPlanTab') }}</text>
          </view>
        </view>

        <view v-if="plansDotsSubTab == 'plans'">
          <view v-if="isGuest" class="guest-lock-card" v-on:click="openGuestSheet">
            <text class="guest-lock-icon">🔒</text>
            <text class="guest-lock-text">{{ tr('guestLockMsg') }}</text>
          </view>
          <view v-else-if="plansLoading" class="plans-loading"><text class="loading-dots">···</text></view>
          <scroll-view v-else direction="vertical" class="plans-scroll">
            <view class="plans-header">
              <text class="plans-title">{{ tr('plansTitle') }}</text>
              <view class="plans-browse-btn" v-on:click="openPlanBrowse"><text class="plans-browse-btn-text">+ {{ tr('plansBrowse') }}</text></view>
            </view>

            <view v-if="activePlans.length == 0" class="plans-empty">
              <text class="plans-empty-text">{{ tr('plansEmpty') }}</text>
              <view class="plans-browse-cta" v-on:click="openPlanBrowse"><text class="plans-browse-cta-text">{{ tr('plansBrowse') }}</text></view>
            </view>

            <view v-for="(p, pi) in activePlans" :key="pi" class="plan-card" v-on:click="openPlanDetail(pi)">
              <view class="plan-card-header">
                <view class="plan-type-badge" :class="'plan-type-' + p.getString('plan_type')">
                  <text class="plan-type-text">{{ p.getString('plan_type') == 'primary' ? tr('plansPrimary') : tr('plansSecondary') }}</text>
                </view>
                <text class="plan-card-name">{{ lang == 'zh' ? p.getString('name_zh') : p.getString('name_en') }}</text>
              </view>
              <view class="plan-progress-bar-track">
                <view class="plan-progress-bar-fill" :style="'width:' + numOr(p.getNumber('progressPct'), 0) + '%'"></view>
              </view>
              <view class="plan-card-meta-row">
                <text class="plan-meta-item">{{ tr('plansAdherence') }}: {{ numOr(p.getNumber('adherencePct'), 0) }}%</text>
                <text class="plan-meta-item">{{ numOr(p.getNumber('weeksDone'), 0) }}/{{ numOr(p.getNumber('totalWeeks'), 4) }} {{ tr('plansWeeks') }}</text>
              </view>
              <view class="plan-daily-section">
                <view class="plan-daily-tasks">
                  <view v-for="(task, ti) in arrOf(p, 'todayTasks')" :key="ti" class="plan-task-chip" :class="task.getBoolean('done') == true ? 'plan-task-done' : ''" v-on:click.stop="handlePlanTask(`${p.getNumber('id')}`, `${task.getString('key')}`)">
                    <text class="plan-task-label">{{ lang == 'zh' ? task.getString('labelZh') : task.getString('labelEn') }}</text>
                    <text class="plan-task-check">{{ task.getBoolean('done') == true ? '✓' : '○' }}</text>
                  </view>
                </view>
                <view class="plan-daily-bar-row">
                  <view class="plan-daily-bar-track">
                    <view class="plan-daily-bar-fill" :class="numOr(p.getNumber('todayDoneCount'), 0) == arrLen(p, 'todayTasks') ? 'plan-daily-complete' : ''" :style="'width:' + numOr(p.getNumber('todayProgressPct'), 0) + '%'"></view>
                  </view>
                  <text class="plan-daily-count">{{ numOr(p.getNumber('todayDoneCount'), 0) }}/{{ arrLen(p, 'todayTasks') }} {{ tr('todayProgress') }}</text>
                </view>
              </view>
            </view>

            <view v-if="!plansLoading" class="reminders-section">
              <text class="reminders-section-title">{{ tr('remindersTitle') }}</text>
              <view v-if="remindersLoading" class="reminders-empty"><text class="reminder-date">···</text></view>
              <view v-else-if="upcomingReminders.length == 0" class="reminders-empty"><text class="reminder-date">{{ tr('remindersEmpty') }}</text></view>
              <view v-for="(r, ri) in upcomingReminders" :key="ri" class="reminder-card">
                <view class="reminder-card-top">
                  <text class="reminder-content">{{ r.getString('content') }}</text>
                  <view class="reminder-source-badge" :class="r.getBoolean('isCoach') == true ? 'reminder-source-coach' : 'reminder-source-ai'">
                    <text class="reminder-source-text">{{ r.getBoolean('isCoach') == true ? tr('reminderSourceCoach') : tr('reminderSourceAi') }}</text>
                  </view>
                </view>
                <view class="reminder-card-bottom">
                  <text class="reminder-date">{{ r.getString('dateLabel') }}</text>
                  <view v-if="(`${r.getString('recurrenceLabel')}`.length) > 0" class="reminder-recur-badge">
                    <text class="reminder-recur-text">{{ r.getString('recurrenceLabel') }}</text>
                  </view>
                </view>
              </view>
            </view>
            <view style="height:24px"></view>
          </scroll-view>
        </view>

        <scroll-view v-else-if="plansDotsSubTab == 'dots'" direction="vertical" class="dots-subtab-scroll">
          <!-- Neo dispenser is not shipping yet; bind prompt stays off behind neoAvailable
               (permanently false in data). Kept rather than deleted — one entry point to it. -->
          <view v-if="neoAvailable && !neoBound && !isGuest" class="guest-lock-card neo-bind-card" v-on:click="handleBindNeoDevice">
            <text class="guest-lock-icon">⬢</text>
            <text class="guest-lock-title">{{ tr('neoBindTitle') }}</text>
            <view class="guest-lock-btn"><text class="guest-lock-label">{{ tr('neoBindBtn') }}</text></view>
          </view>

          <view v-if="neoBound && !isGuest" class="cart-section">
            <view class="cart-section-hdr">
              <text class="cart-section-title">{{ tr('cartridgeTitle') }}</text>
              <view class="cart-sim-btn" v-on:click="openCartSim"><text class="cart-sim-btn-icon">+</text></view>
            </view>
            <view v-if="cartridgesLoading" class="cart-loading"><text class="loading-dots">···</text></view>
            <view v-else-if="cartridges.length > 0" class="cart-grid">
              <view v-for="(c, ci) in cartridges" :key="ci" class="cart-slot" :class="c.getBoolean('isEmpty') == true ? 'cart-slot-empty' : ''">
                <view class="ink-bar-wrap">
                  <view class="ink-bar-fill" :style="'height:' + numOr(c.getNumber('percent'), 0) + '%;background:' + c.getString('barColor')"></view>
                </view>
                <text class="cart-key">{{ c.getString('dotKey') }}</text>
                <text class="cart-remaining">{{ c.getNumber('remaining') }}</text>
              </view>
            </view>
            <view v-else class="cart-empty"><text class="cart-empty-label">{{ tr('noCartridges') }}</text></view>
          </view>

          <!-- ── My dots packages ── merged server-side from the GCN order + nano's formula. -->
          <view v-if="isAeviva && !isGuest && packages.length > 0" class="pkg-section">
            <text class="pkg-section-title">{{ tr('pkgSectionTitle') }}</text>
            <view v-for="(p, pi) in packages" :key="pi" class="pkg-card">
              <view class="pkg-card-hdr">
                <text class="pkg-name">{{ p.getString('name') }}</text>
                <text class="pkg-stage" :class="'pkg-stage-' + p.getString('stage')">{{ p.getString('stageLabel') }}</text>
              </view>
              <text v-if="(`${p.getString('meta')}`.length) > 0" class="pkg-meta">{{ p.getString('meta') }}</text>
              <view v-if="p.getString('tracking_number') != null" class="pkg-track" v-on:click.stop="handleCopyPackageTracking(`${p.getString('tracking_number')}`)">
                <text class="pkg-track-text">{{ p.getString('trackingLabel') }}</text>
                <text class="pkg-track-copy">{{ tr('copy') }}</text>
              </view>
              <view v-if="p.getBoolean('can_pay') == true" class="pkg-cta" v-on:click.stop="handlePackagePay(`${p.getString('order_id')}`)">
                <text class="pkg-cta-text">{{ tr('pkgPayBtn') }}</text>
              </view>
              <view v-else-if="p.getBoolean('can_submit') == true && p.getString('submit_plan_id') != null" class="pkg-cta" v-on:click.stop="handlePackageSubmit(`${p.getString('order_id')}`, `${p.getString('submit_plan_id')}`)">
                <text class="pkg-cta-text">{{ tr('pkgUseFormulaBtn') }}</text>
              </view>
              <text v-else-if="p.getBoolean('can_submit') == true" class="pkg-hint">{{ tr('pkgNeedsFormulaHint') }}</text>
              <view v-else-if="p.getBoolean('can_scan') == true" class="pkg-cta pkg-cta-ghost" v-on:click.stop="handleScanBox">
                <text class="pkg-cta-text-ghost">{{ tr('pkgScanBtn') }}</text>
              </view>
              <!-- A 'proposed' row deliberately carries NO cta: its only action is "use a code",
                   which the 兑换码 section below owns with the user's actual codes named. -->
            </view>
          </view>

          <!-- ── 兑换码 ── codes bought in-app; 输入兑换码 is the path for codes a store handed
               over in person, so it shows even when the list is empty. -->
          <view v-if="isAeviva && !isGuest" class="code-section">
            <text class="pkg-section-title">{{ tr('codeSectionTitle') }}</text>
            <view v-for="(c, ci) in codes" :key="ci" class="pkg-card">
              <view class="pkg-card-hdr">
                <text class="pkg-name">{{ c.getString('name') }}</text>
                <text class="code-chip">{{ c.getString('code') }}</text>
              </view>
              <text v-if="(`${c.getString('meta')}`.length) > 0" class="pkg-meta">{{ c.getString('meta') }}</text>
              <view class="pkg-cta" v-on:click.stop="handleUseCode(`${c.getString('code')}`, c.getNumber('max_distinct_dots'), `${c.getString('name')}`)">
                <text class="pkg-cta-text">{{ tr('codeUseBtn') }}</text>
              </view>
            </view>
            <view class="pkg-cta pkg-cta-ghost" v-on:click.stop="handleManualCode">
              <text class="pkg-cta-text-ghost">{{ tr('codeManualBtn') }}</text>
            </view>
          </view>

          <!-- The one way into ordering dots from this tab, and it only ever offers the tool.
               Hidden while a package is in flight (GCN's formulation_already_in_progress guard). -->
          <view v-if="!neoBound && isAeviva && !isGuest && !hasPackageInFlight && !hasProposedFormula" class="order-dots-card" v-on:click="handleGoFormulate">
            <text class="order-dots-title">{{ tr('formulateFirstTitle') }}</text>
            <text class="order-dots-detail">{{ tr('formulateFirstDetail') }}</text>
            <view class="order-dots-btn"><text class="order-dots-btn-text">{{ tr('formulateFirstBtn') }}</text></view>
          </view>

          <!-- Scan the box you received to start its 28-day cycle (real users on a GCN channel). -->
          <view v-if="isAeviva && !isGuest" class="scan-box-card" v-on:click="handleScanBox">
            <view class="scan-box-main">
              <text class="scan-box-title">{{ tr('scanBoxTitle') }}</text>
              <text class="scan-box-detail">{{ tr('scanBoxDetail') }}</text>
            </view>
            <image class="scan-box-icon" src="/static/icons/scan.svg" mode="aspectFit" />
          </view>

          <view class="dots-header">
            <text class="dots-title">{{ tr('dotsTitle') }}</text>
            <view class="dots-week-nav">
              <text class="dots-week-arrow" :class="!hasPrevWeek ? 'dots-week-arrow-disabled' : ''" v-on:click.stop="handleDotsPrevWeek">‹</text>
              <text v-if="weekLabel.length > 0" class="dots-week-label">{{ weekLabel }}</text>
              <text class="dots-week-arrow" :class="!hasNextWeek ? 'dots-week-arrow-disabled' : ''" v-on:click.stop="handleDotsNextWeek">›</text>
            </view>
          </view>

          <view v-if="isGuest" class="guest-lock-card" v-on:click="openGuestSheet">
            <text class="guest-lock-icon">◉</text>
            <text class="guest-lock-title">{{ tr('guestDotsCta') }}</text>
            <view class="guest-lock-btn"><text class="guest-lock-label">{{ tr('guestJoinBtn') }}</text></view>
          </view>
          <view v-else-if="dotsLoading" class="center-wrap"><text class="loading-dots">···</text></view>
          <view v-else-if="dotsDays.length > 0">
            <scroll-view direction="horizontal" class="dots-scroll" :scroll-left="todayScrollLeft" :show-scrollbar="false">
              <view class="dots-days">
                <view v-for="(d, di) in dotsDays" :key="di" class="day-card" :class="d.getBoolean('isToday') == true ? 'day-today' : ''">
                  <text class="day-label">{{ d.getString('label') }}</text>
                  <view v-if="arrLen(d, 'morning') > 0" class="meal-slot" :class="d.getBoolean('isToday') == true && dispenseSlot == 'morning_cup' ? 'meal-slot-active' : ''">
                    <text class="meal-name">{{ tr('morning') }}</text>
                    <view class="dot-chips">
                      <view v-for="(dot, dj) in arrOf(d, 'morning')" :key="dj" class="dot-chip">
                        <view class="dot-swatch" :style="'background:' + dot.getString('color')"></view>
                        <text class="dot-key">{{ dot.getString('displayKey') }}</text>
                        <text class="dot-count">×{{ dot.getNumber('count') }}</text>
                      </view>
                    </view>
                  </view>
                  <view v-if="arrLen(d, 'evening') > 0" class="meal-slot" :class="d.getBoolean('isToday') == true && dispenseSlot == 'evening_cup' ? 'meal-slot-active' : ''">
                    <text class="meal-name">{{ tr('evening') }}</text>
                    <view class="dot-chips">
                      <view v-for="(dot, dj) in arrOf(d, 'evening')" :key="dj" class="dot-chip">
                        <view class="dot-swatch" :style="'background:' + dot.getString('color')"></view>
                        <text class="dot-key">{{ dot.getString('displayKey') }}</text>
                        <text class="dot-count">×{{ dot.getNumber('count') }}</text>
                      </view>
                    </view>
                  </view>
                </view>
              </view>
            </scroll-view>

            <view v-if="dispenseHasToday && neoBound" class="dispense-section">
              <view class="dispense-btn" :class="dispenseStatus == 'done' ? ' dispense-btn-done' : (dispenseStatus == 'error' ? ' dispense-btn-error' : (dispenseStatus == 'loading' ? ' dispense-btn-loading' : ''))" v-on:click="dispenseToday">
                <text class="dispense-btn-text">{{ dispenseStatus == 'loading' ? tr('dispensing') : (dispenseStatus == 'done' ? tr('dispenseOk') : (dispenseStatus == 'error' ? tr('dispenseErr') : tr('dispenseBtn'))) }}</text>
              </view>
            </view>
          </view>
          <view v-else class="dots-empty"><text class="dots-empty-label">{{ tr('noPlan') }}</text></view>
          <view style="height:24px"></view>
        </scroll-view>
      </view>
      <!-- end PLANS+DOTS -->

      <!-- Weight entry modal -->
      <view v-if="planWeightOpen" class="modal-overlay">
        <view class="modal-sheet" :style="planWeightKeyboard > 0 ? 'margin-bottom: ' + planWeightKeyboard + 'px;' : ''">
          <text class="modal-title">{{ tr('taskWeightTitle') }}</text>
          <input class="modal-input" type="digit" :placeholder="tr('taskWeightPlaceholder')" v-model="planWeightInput"
            :adjust-position="false" v-on:focus="handleWeightFocus" v-on:blur="handleWeightBlur" />
          <view class="modal-actions">
            <view class="modal-btn modal-btn-cancel" v-on:click="closeWeightTask"><text class="modal-btn-cancel-label">{{ tr('taskWeightCancel') }}</text></view>
            <view class="modal-btn modal-btn-confirm" v-on:click="handleWeightSubmit"><text class="modal-btn-confirm-label">{{ tr('taskWeightConfirm') }}</text></view>
          </view>
        </view>
      </view>

      <!-- Daily questions modal -->
      <view v-if="planQuestionsOpen" class="modal-overlay">
        <view class="modal-sheet">
          <text class="modal-title">{{ tr('taskQuestionsTitle') }}</text>
          <view class="q-row">
            <text class="q-label">{{ tr('taskQEnergy') }}</text>
            <slider :min="1" :max="5" :step="1" :value="planQEnergy" :show-value="true" :block-size="20" active-color="#6375EC" v-on:change="onPlanQChange('energy', $event)" />
          </view>
          <view class="q-row">
            <text class="q-label">{{ tr('taskQSleep') }}</text>
            <slider :min="1" :max="5" :step="1" :value="planQSleep" :show-value="true" :block-size="20" active-color="#6375EC" v-on:change="onPlanQChange('sleep', $event)" />
          </view>
          <view class="q-row">
            <text class="q-label">{{ tr('taskQMood') }}</text>
            <slider :min="1" :max="5" :step="1" :value="planQMood" :show-value="true" :block-size="20" active-color="#6375EC" v-on:change="onPlanQChange('mood', $event)" />
          </view>
          <view class="modal-actions">
            <view class="modal-btn modal-btn-cancel" v-on:click="closeQuestionsTask"><text class="modal-btn-cancel-label">{{ tr('taskQCancel') }}</text></view>
            <view class="modal-btn modal-btn-confirm" v-on:click="handleQuestionsSubmit"><text class="modal-btn-confirm-label">{{ tr('taskQSubmit') }}</text></view>
          </view>
        </view>
      </view>

      <!-- Plan Detail Sheet -->
      <view v-if="planDetailOpen" class="overlay-mask">
        <view class="overlay-panel">
          <view class="overlay-header">
            <text class="overlay-title">{{ planDetailData != null ? (lang == 'zh' ? planDetailData!.getString('name_zh') : planDetailData!.getString('name_en')) : '' }}</text>
            <view class="overlay-close" v-on:click="closePlanDetail"><text class="close-x">✕</text></view>
          </view>
          <view class="detail-tabs">
            <view class="detail-tab" :class="planSubTab == 'overview' ? 'detail-tab-active' : ''" v-on:click="switchPlanSubTab('overview')"><text class="detail-tab-text">{{ tr('plansSubTabOverview') }}</text></view>
            <view class="detail-tab" :class="planSubTab == 'progress' ? 'detail-tab-active' : ''" v-on:click="switchPlanSubTab('progress')"><text class="detail-tab-text">{{ tr('plansSubTabProgress') }}</text></view>
            <view class="detail-tab" :class="planSubTab == 'activities' ? 'detail-tab-active' : ''" v-on:click="switchPlanSubTab('activities')"><text class="detail-tab-text">{{ tr('plansSubTabActivities') }}</text></view>
            <view class="detail-tab" :class="planSubTab == 'guidance' ? 'detail-tab-active' : ''" v-on:click="switchPlanSubTab('guidance')"><text class="detail-tab-text">{{ tr('plansSubTabGuidance') }}</text></view>
          </view>

          <scroll-view v-if="planSubTab == 'overview'" direction="vertical" class="overlay-scroll">
            <view class="plan-detail-section">
              <text class="plan-detail-label">{{ tr('plansGoal') }}</text>
              <text class="plan-detail-value">{{ planDetailData != null ? (lang == 'zh' ? planDetailData!.getString('goal_zh') : planDetailData!.getString('goal_en')) : '' }}</text>
            </view>
            <view class="plan-detail-section">
              <text class="plan-detail-label">{{ tr('plansStartDate') }}</text>
              <text class="plan-detail-value">{{ planDetailData != null ? planDetailData!.getString('start_date') : '' }}</text>
            </view>
            <view class="plan-detail-section">
              <text class="plan-detail-label">{{ tr('plansDuration') }}</text>
              <text class="plan-detail-value">{{ planDetailData != null ? planDetailData!.getNumber('totalWeeks') : 0 }} {{ tr('plansWeeks') }}</text>
            </view>
            <view v-if="planTargetSubAges.length > 0" class="plan-detail-section">
              <text class="plan-detail-label">{{ tr('plansTargetSubAges') }}</text>
              <view class="plan-chips-row">
                <view v-for="(sa, sai) in planTargetSubAges" :key="sai" class="plan-chip"><text class="plan-chip-text">{{ sa }}</text></view>
              </view>
            </view>
            <view class="plan-detail-section">
              <text class="plan-detail-label plan-section-label">{{ tr('planReminders') }}</text>
              <view v-if="planDetailReminders.length == 0" class="plan-empty-hint"><text class="plan-empty-hint-text">{{ tr('planNoReminders') }}</text></view>
              <view v-for="(r, ri) in planDetailReminders" :key="ri" class="plan-reminder-row">
                <view class="plan-reminder-info">
                  <text class="plan-reminder-time">{{ r.getString('timeDisplay') }}</text>
                  <text class="plan-reminder-content">{{ r.getString('content') }}</text>
                </view>
                <view class="plan-reminder-toggle" :class="r.getString('status') == 'paused' ? 'reminder-paused' : 'reminder-active'" v-on:click="handleTogglePlanReminder(idStr(r, 'id'), `${r.getString('status')}`)">
                  <text class="plan-reminder-toggle-label">{{ r.getString('status') == 'paused' ? tr('planReminderResume') : tr('planReminderPause') }}</text>
                </view>
              </view>
            </view>
            <!-- Committed formulation for this focus — Aeviva-only purchase CTA (AGENTS §31). -->
            <view v-if="planFormulation != null" class="plan-detail-section">
              <text class="plan-detail-label plan-section-label">{{ tr('formulationReadyTitle') }}</text>
              <view class="plan-chips-row">
                <view v-for="(fd, fi) in planFormulationDots" :key="fi" class="plan-chip plan-chip-dot">
                  <text class="plan-chip-text">{{ lang == 'zh' ? fd.getString('name_zh') : fd.getString('name') }} ×{{ fd.getNumber('total_count') }}</text>
                </view>
              </view>
              <view v-if="isAeviva" class="plan-action-btn plan-action-buy" v-on:click="handleBuyFormulation"><text class="plan-action-label">{{ tr('buyFormulationBtn') }}</text></view>
            </view>
            <view v-else-if="isAeviva" class="plan-detail-section">
              <text class="plan-detail-label plan-section-label">{{ tr('formulationNotReadyTitle') }}</text>
              <text class="plan-empty-hint">{{ tr('formulationNotReadyHint') }}</text>
            </view>
            <view class="plan-actions-row">
              <view class="plan-action-btn plan-action-switch" v-on:click="handleSwitchPlanType"><text class="plan-action-label">{{ tr('plansSwitch') }}</text></view>
              <view class="plan-action-btn plan-action-abandon" v-on:click="handleAbandonPlan"><text class="plan-action-label">{{ tr('plansAbandon') }}</text></view>
            </view>
          </scroll-view>

          <scroll-view v-else-if="planSubTab == 'progress'" direction="vertical" class="overlay-scroll">
            <view class="plan-detail-section">
              <text class="plan-detail-label">{{ tr('plansAdherence') }}</text>
              <text class="plan-detail-value">{{ planDetailData != null ? planDetailData!.getNumber('adherencePct') : 0 }}% ({{ planDetailData != null ? planDetailData!.getNumber('checkin_count') : 0 }} {{ lang == 'zh' ? '次打卡' : 'check-ins' }})</text>
            </view>
            <view class="plan-detail-section">
              <text class="plan-detail-label">{{ tr('plansWeeks') }}</text>
              <text class="plan-detail-value">{{ planDetailData != null ? planDetailData!.getNumber('weeksDone') : 0 }}/{{ planDetailData != null ? planDetailData!.getNumber('totalWeeks') : 0 }}</text>
            </view>
            <view class="plan-detail-section">
              <text class="plan-detail-label">{{ tr('plansNoMilestones') }}</text>
            </view>
          </scroll-view>

          <scroll-view v-else-if="planSubTab == 'activities'" direction="vertical" class="overlay-scroll">
            <view v-if="eventsLoading" class="panel-center"><text class="empty-text">{{ tr('eventsLoading') }}</text></view>
            <view v-else-if="events.length == 0" class="panel-center"><text class="empty-text">{{ tr('eventsEmpty') }}</text></view>
            <view v-else class="events-list">
              <view v-for="(ev, ei) in events" :key="ei" class="event-card">
                <view class="event-card-header">
                  <text class="event-title">{{ ev.getString('title') }}</text>
                  <view v-if="isSignupEvent(ev.getNumber('id'))" class="event-badge-signed"><text>{{ tr('eventsSignedUp') }}</text></view>
                </view>
                <text class="event-meta">📅 {{ ev.getString('scheduled_at_display') }}</text>
                <text v-if="ev.getString('location') != null" class="event-meta">📍 {{ ev.getString('location') }}</text>
                <text v-if="ev.getString('description') != null" class="event-desc">{{ ev.getString('description') }}</text>
                <text v-if="ev.getNumber('capacity') != null" class="event-meta">{{ tr('eventsCapacity') }}: {{ ev.getNumber('remaining') }}/{{ ev.getNumber('capacity') }}</text>
                <view class="event-card-actions">
                  <view v-if="isSignupEvent(ev.getNumber('id'))" class="event-btn event-btn-cancel" v-on:click.stop="handleEventCancelSignup(`${ev.getNumber('id')}`)"><text class="event-btn-label">{{ tr('eventsCancel') }}</text></view>
                  <view v-else-if="ev.getBoolean('is_full') == true" class="event-btn event-btn-disabled"><text class="event-btn-label">{{ tr('eventsFull') }}</text></view>
                  <view v-else class="event-btn event-btn-signup" v-on:click.stop="handleEventSignUp(`${ev.getNumber('id')}`)"><text class="event-btn-label">{{ tr('eventsSignUp') }}</text></view>
                </view>
              </view>
            </view>
          </scroll-view>

          <scroll-view v-else direction="vertical" class="overlay-scroll">
            <view class="plan-detail-section">
              <text class="plan-detail-value">{{ guidanceText }}</text>
            </view>
            <view v-if="planRecommendedDots.length > 0" class="plan-detail-section">
              <text class="plan-detail-label">{{ tr('plansRecommendedDots') }}</text>
              <view class="plan-chips-row">
                <view v-for="(rd, ri2) in planRecommendedDots" :key="ri2" class="plan-chip plan-chip-dot">
                  <text class="plan-chip-text">{{ lang == 'zh' ? recommendedDotZh(rd) : rd.getString('name') }}</text>
                </view>
              </view>
            </view>
          </scroll-view>
        </view>
      </view>

      <!-- Plan Browse Sheet -->
      <view v-if="planBrowseOpen" class="overlay-mask">
        <view class="overlay-panel">
          <view class="overlay-header">
            <text class="overlay-title">{{ tr('plansTemplates') }}</text>
            <view class="overlay-close" v-on:click="closePlanBrowse"><text class="close-x">✕</text></view>
          </view>
          <scroll-view direction="vertical" class="overlay-scroll">
            <view v-for="(tpl, ti) in planTemplates" :key="ti" class="browse-tpl-card">
              <text class="browse-tpl-name">{{ lang == 'zh' ? tpl.getString('name_zh') : tpl.getString('name_en') }}</text>
              <text class="browse-tpl-goal">{{ lang == 'zh' ? tpl.getString('goal_zh') : tpl.getString('goal_en') }}</text>
              <text class="browse-tpl-meta">{{ tpl.getNumber('duration_weeks') }} {{ tr('plansWeeks') }} · {{ tpl.getString('sub_ages_display') }}</text>
              <view class="browse-tpl-actions">
                <view v-if="tpl.getBoolean('alreadyEnrolled') == true" class="browse-enrolled-badge"><text class="browse-enrolled-label">{{ tr('plansAlreadyEnrolled') }}</text></view>
                <view v-else class="browse-join-row">
                  <view class="browse-join-btn" :class="tpl.getBoolean('canJoinPrimary') == true ? '' : ' browse-join-disabled'" v-on:click="handleJoinPlan(`${tpl.getNumber('id')}`, 'primary')"><text class="browse-join-label">{{ tr('plansJoinPrimary') }}</text></view>
                  <view class="browse-join-btn browse-join-secondary" :class="tpl.getBoolean('canJoinSecondary') == true ? '' : ' browse-join-disabled'" v-on:click="handleJoinPlan(`${tpl.getNumber('id')}`, 'secondary')"><text class="browse-join-label browse-join-label-secondary">{{ tr('plansJoinSecondary') }}</text></view>
                </view>
              </view>
            </view>
            <view style="height:24px"></view>
          </scroll-view>
        </view>
      </view>

      <!-- ════ STORE ════ -->
      <!-- A GCN-store channel's Store tab tap opens the storefront via pages/appview instead
           (switchTab/_openAevivaStoreGated) — `tab` never becomes 'store' for those users; this
           section is the native dots/credits store for everyone else. -->
      <view v-show="tab == 'store'" class="store-tab"
            v-on:touchstart="onTabTouchStart" v-on:touchmove="onTabTouchMove"
            v-on:touchend="onTabTouchEnd" v-on:touchcancel="onTabTouchEnd">

        <view class="store-header">
          <text class="store-title">{{ tr('storeTitle') }}</text>
          <view class="store-header-right">
            <view v-if="!isGuest" class="store-credit-card">
              <text class="store-credit-card-num">{{ creditBalance }}</text>
              <text class="store-credit-card-unit">pts</text>
              <text class="store-credit-card-label">{{ lang == 'zh' ? '我的积分' : 'MY CREDITS' }}</text>
            </view>
            <view v-if="cartCount > 0" class="store-cart-icon" v-on:click="handleOpenCart">
              <text class="store-cart-badge">{{ cartCount }}</text>
            </view>
          </view>
        </view>

        <view v-if="!storeLoading" class="store-subtab-row">
          <view class="store-subtab-btn" :class="storeSubTab == 'products' ? ' store-subtab-active' : ''" v-on:click="switchStoreTab('products')"><text>{{ tr('storeSubProducts') }}</text></view>
          <view class="store-subtab-btn" :class="storeSubTab == 'orders' ? ' store-subtab-active' : ''" v-on:click="switchStoreTab('orders')"><text>{{ tr('storeSubOrders') }}</text></view>
        </view>

        <view v-if="storeLoading" class="center-wrap"><text class="loading-dots">···</text></view>

        <scroll-view v-else-if="storeSubTab == 'products' && storeItems.length > 0" direction="vertical" class="store-scroll"
                     :refresher-enabled="true" :refresher-triggered="storeRefreshing" v-on:refresherrefresh="onStoreRefresh">
          <view class="store-list">
            <view v-for="(item, ii) in storeItems" :key="ii" class="store-card">
              <view v-if="item.getString('tagLabel') != null" class="store-tag"><text class="store-tag-text">{{ item.getString('tagLabel') }}</text></view>
              <text class="store-card-name">{{ item.getString('name') }}</text>
              <rich-text v-if="item.getBoolean('descIsHtml') == true" class="store-card-desc store-card-desc-rich" :nodes="`${item.getString('desc')}`" />
              <text v-else class="store-card-desc">{{ item.getString('desc') }}</text>
              <view v-if="arrLen(item, 'variants') > 0" class="store-variants">
                <view v-for="(variant, vi) in arrOf(item, 'variants')" :key="vi" class="store-variant-pill" :class="idStr(item, 'selectedVariantId') == idStr(variant, 'id') ? ' store-variant-pill-active' : ''" v-on:click="handleSelectVariant(idStr(item, 'id'), idStr(variant, 'id'))">
                  <text class="store-variant-label">{{ variant.getString('label') }}</text>
                </view>
              </view>
              <view class="store-card-footer">
                <view v-if="(`${item.getString('partnerPrice')}`.length) > 0" class="store-price-wrap store-price-wrap-partner">
                  <view class="store-partner-row">
                    <view class="store-partner-badge"><text class="store-partner-badge-text">{{ tr('storePartnerPrice') }}</text></view>
                    <text class="store-price store-price-partner">{{ item.getString('partnerPrice') }}</text>
                    <text class="store-unit">/ {{ item.getString('unit') }}</text>
                  </view>
                  <text class="store-price-regular">{{ item.getString('price') }}</text>
                </view>
                <view v-else class="store-price-wrap">
                  <text class="store-price">{{ item.getString('price') }}</text>
                  <text class="store-unit">/ {{ item.getString('unit') }}</text>
                </view>
                <view v-if="cartQty(variantOrItemId(item)) == 0" class="store-buy-btn" v-on:click="handleAddToCart(ii)">
                  <text class="store-buy-label">{{ tr('storeAddToCart') }}</text>
                </view>
                <view v-else class="cart-stepper">
                  <view class="stepper-btn" v-on:click="handleCartQtyChange(variantOrItemId(item), -1)"><text class="stepper-sym">－</text></view>
                  <text class="stepper-qty">{{ cartQty(variantOrItemId(item)) }}</text>
                  <view class="stepper-btn" v-on:click="handleCartQtyChange(variantOrItemId(item), 1)"><text class="stepper-sym">＋</text></view>
                </view>
              </view>
            </view>
            <view :style="'height:' + (cartCount > 0 ? '70px' : '16px')"></view>
          </view>
        </scroll-view>

        <view v-else-if="storeSubTab == 'products'" class="dots-empty"><text class="dots-empty-label">{{ tr('storeEmpty') }}</text></view>

        <view v-if="cartCount > 0 && storeSubTab == 'products' && !storeLoading" class="cart-bar" v-on:click="handleOpenCart">
          <text class="cart-bar-label">{{ tr('storeCartTotal') }} · {{ cartCount }}{{ tr('storeCartItems') }}</text>
          <view class="cart-bar-right">
            <text class="cart-bar-total">{{ cartTotal }}</text>
            <view class="cart-bar-btn" v-on:click.stop="handleCheckout"><text class="cart-bar-btn-text">{{ tr('storeCartCheckout') }}</text></view>
          </view>
        </view>

        <scroll-view v-if="!storeLoading && storeSubTab == 'orders' && storeOrders.length > 0" direction="vertical" class="store-scroll"
                     :refresher-enabled="true" :refresher-triggered="storeRefreshing" v-on:refresherrefresh="onStoreRefresh">
          <view class="store-list">
            <view v-for="(o, oi) in storeOrders" :key="oi" class="order-card">
              <view class="order-card-top">
                <text class="order-name">{{ o.getString('name') }}</text>
                <view class="order-status" :class="'order-status-' + o.getString('status')">
                  <text>{{ orderStatusLabel(o.getString('status')) }}</text>
                </view>
              </view>
              <view class="order-card-mid">
                <text class="order-price">{{ o.getString('price') }}</text>
                <text class="order-meta"> · {{ o.getString('unit') }} · ×{{ o.getNumber('quantity') }}</text>
              </view>
              <view class="order-date-row"><text class="order-date">{{ o.getString('createdAt') }}</text></view>
              <view v-if="(`${o.getString('shippingName')}`.length) > 0" class="order-delivery-info">
                <view class="delivery-row">
                  <text class="delivery-label">{{ lang == 'zh' ? '收货人' : 'Recipient' }}</text>
                  <text class="delivery-val">{{ o.getString('shippingName') }} ({{ o.getString('shippingPhone') }})</text>
                </view>
                <view class="delivery-row">
                  <text class="delivery-label">{{ lang == 'zh' ? '收货地址' : 'Address' }}</text>
                  <text class="delivery-val">{{ o.getString('shippingAddress') }}</text>
                </view>
                <view v-if="(`${o.getString('trackingNumber')}`.length) > 0" class="delivery-row tracking-section">
                  <text class="delivery-label">{{ lang == 'zh' ? '快递单号' : 'Tracking' }}</text>
                  <view class="tracking-val-wrap">
                    <text class="delivery-val bold">{{ o.getString('shippingCarrier') }} {{ o.getString('trackingNumber') }}</text>
                    <view class="copy-badge" v-on:click="handleCopyTracking(`${o.getString('trackingNumber')}`)"><text class="copy-badge-label">{{ lang == 'zh' ? '复制' : 'Copy' }}</text></view>
                  </view>
                </view>
              </view>
              <view v-if="o.getString('status') == 'pending'" class="order-actions">
                <view class="cancel-order-btn" v-on:click="handleCancelOrder(idStr(o, 'id'))"><text>{{ lang == 'zh' ? '取消订单' : 'Cancel Order' }}</text></view>
              </view>
            </view>
            <view style="height:16px"></view>
          </view>
        </scroll-view>

        <view v-if="!storeLoading && storeSubTab == 'orders' && storeOrders.length == 0" class="dots-empty"><text class="dots-empty-label">{{ tr('noOrders') }}</text></view>

        <!-- Cart modal -->
        <view v-if="cartOpen" class="cart-overlay" v-on:click="handleCloseCart">
          <view class="cart-sheet" v-on:click.stop="noop">
            <view class="cart-sheet-header">
              <text class="cart-sheet-title">{{ tr('storeCart') }}</text>
              <view class="cart-close-btn" v-on:click="handleCloseCart"><text class="cart-close-sym">✕</text></view>
            </view>
            <scroll-view direction="vertical" class="cart-sheet-scroll">
              <view v-if="cart.length == 0" class="cart-empty-row"><text class="cart-empty-text">{{ tr('storeCartEmpty') }}</text></view>
              <view v-for="(citem, ci2) in cart" :key="ci2" class="cart-item-row">
                <view class="cart-item-info">
                  <text class="cart-item-name">{{ citem.getString('name') }}</text>
                  <text class="cart-item-price">{{ (`${citem.getString('partnerPrice')}`.length) > 0 ? citem.getString('partnerPrice') : citem.getString('price') }} / {{ citem.getString('unit') }}</text>
                </view>
                <view class="cart-stepper cart-stepper-sm">
                  <view class="stepper-btn" v-on:click="handleCartQtyChange(idStr(citem, 'id'), -1)"><text class="stepper-sym">－</text></view>
                  <text class="stepper-qty">{{ citem.getNumber('quantity') }}</text>
                  <view class="stepper-btn" v-on:click="handleCartQtyChange(idStr(citem, 'id'), 1)"><text class="stepper-sym">＋</text></view>
                </view>
              </view>
              <view v-if="cart.length > 0" class="checkout-addr-form">
                <view class="checkout-addr-hdr">
                  <text class="checkout-addr-title">{{ tr('checkoutShippingTitle') }}</text>
                  <!-- WeChat address book: xapp-mini only (native has none — manual entry). -->
                  <!-- #ifdef MP-WEIXIN -->
                  <view v-if="wxAddressEnabled" class="checkout-wx-addr-btn" v-on:click="fetchWechatAddress('checkout')">
                    <text class="checkout-wx-addr-icon">📍</text>
                    <text class="checkout-wx-addr-text">{{ tr('checkoutWxAddress') }}</text>
                  </view>
                  <!-- #endif -->
                </view>
                <view class="checkout-addr-row">
                  <text class="checkout-addr-label">{{ tr('checkoutName') }}</text>
                  <input class="checkout-addr-input" :placeholder="tr('checkoutNamePh')" v-model="checkoutName" />
                </view>
                <view class="checkout-addr-row">
                  <text class="checkout-addr-label">{{ tr('checkoutPhone') }}</text>
                  <input class="checkout-addr-input" type="number" :placeholder="tr('checkoutPhonePh')" v-model="checkoutPhone" />
                </view>
                <view class="checkout-addr-row checkout-addr-row-tall">
                  <text class="checkout-addr-label">{{ tr('checkoutAddress') }}</text>
                  <textarea class="checkout-addr-textarea" :placeholder="tr('checkoutAddressPh')" v-model="checkoutAddress" />
                </view>
              </view>
            </scroll-view>
            <view class="cart-sheet-footer">
              <text class="cart-total-text">{{ tr('storeCartTotal') }}  {{ cartTotal }}</text>
              <view v-if="cart.length > 0" class="cart-checkout-btn" v-on:click="handleCheckout"><text class="cart-checkout-text">{{ tr('storeCartCheckout') }}</text></view>
            </view>
          </view>
        </view>
      </view>
      <!-- end STORE -->

      <!-- ════ LEARN (Academy + Wellness) ════ -->
      <view v-show="tab == 'learn'" class="learn-tab"
            v-on:touchstart="onTabTouchStart" v-on:touchmove="onTabTouchMove"
            v-on:touchend="onTabTouchEnd" v-on:touchcancel="onTabTouchEnd">

        <view class="inner-tab-bar">
          <view class="inner-tab" :class="learnSubTab == 'academy' ? 'inner-tab-active' : ''" v-on:click="switchLearnSubTab('academy')"><text class="inner-tab-text" :class="learnSubTab == 'academy' ? 'inner-tab-text-on' : ''">{{ tr('learnAcademyTab') }}</text></view>
          <view class="inner-tab" :class="learnSubTab == 'wellness' ? 'inner-tab-active' : ''" v-on:click="switchLearnSubTab('wellness')"><text class="inner-tab-text" :class="learnSubTab == 'wellness' ? 'inner-tab-text-on' : ''">{{ tr('learnBoxTab') }}</text></view>
        </view>

        <scroll-view v-if="learnSubTab == 'academy'" direction="vertical" class="academy-subtab-scroll">
          <view class="training-tab">
            <view v-if="trainingLoading" class="loading-row"><text class="loading-text">{{ tr('loading') }}</text></view>

            <view v-else-if="trainingView == 'list'">
              <view v-if="trainingDashboard != null" class="academy-status-card">
                <view class="academy-card-glow-tl"></view>
                <view class="academy-card-glow-br"></view>
                <view class="academy-card-header">
                  <text class="academy-card-header-label">{{ lang == 'zh' ? '学院状态' : 'ACADEMY STATUS' }}</text>
                  <view class="academy-card-tier-badge"><text class="academy-card-tier-text">{{ trainingDashboard != null ? trainingDashboard!.getString('_tierLabel') : '' }}</text></view>
                </view>
                <view class="academy-card-hero">
                  <text class="academy-card-credits-num">{{ trainingDashboard != null ? trainingDashboard!.getNumber('total_credits') : 0 }}</text>
                  <text class="academy-card-credits-label">{{ lang == 'zh' ? '学分' : 'CREDITS' }}</text>
                </view>
                <view class="academy-card-divider"></view>
                <view class="academy-card-stats">
                  <view class="academy-card-stat">
                    <text class="academy-card-stat-num">{{ trainingDashboard != null ? trainingDashboard!.getNumber('completed_lessons') : 0 }}</text>
                    <text class="academy-card-stat-label">{{ lang == 'zh' ? '完成课程' : 'LESSONS' }}</text>
                  </view>
                  <view class="academy-card-stat-sep"></view>
                  <view class="academy-card-stat">
                    <text class="academy-card-stat-num">{{ trainingDashboard != null ? trainingDashboard!.getNumber('certifications_count') : 0 }}</text>
                    <text class="academy-card-stat-label">{{ lang == 'zh' ? '证书' : 'CERTS' }}</text>
                  </view>
                </view>
              </view>

              <view v-if="trainingPaths.length > 0" class="training-section-header">
                <text class="training-section-title">{{ lang == 'zh' ? '学习路径' : 'Learning Paths' }}</text>
              </view>
              <view v-for="(tp, tpi) in trainingPaths" :key="tpi" class="training-path-card" v-on:click="trainingOpenCourse(tpi, true)">
                <view class="training-path-header">
                  <text class="training-path-title">{{ tp.getString('title') }}</text>
                  <text class="training-path-tier">{{ tp.getString('_tierLabel') }}</text>
                </view>
                <view v-if="tp.getString('description') != null" class="training-path-desc"><text>{{ tp.getString('description') }}</text></view>
                <view class="training-path-progress-bar">
                  <view class="training-path-progress-fill" :style="'width:' + pathPct(tp) + '%'"></view>
                </view>
                <text class="training-path-progress-label">{{ tp.getNumber('_done') }}/{{ tp.getNumber('_total') }} {{ lang == 'zh' ? '课程' : 'courses' }}</text>
              </view>

              <view class="training-section-header"><text class="training-section-title">{{ tr('training.courses') }}</text></view>
              <view v-if="trainingCourses.length == 0" class="empty-state"><text class="empty-text">{{ tr('training.noTraining') }}</text></view>
              <view v-for="(c, ci) in trainingCourses" :key="ci" class="training-course-card" :class="c.getBoolean('_locked') == true ? ' training-course-card-locked' : ''" v-on:click="trainingOpenCourse(ci, false)">
                <view class="training-course-cover">
                  <text class="training-course-cover-text">{{ c.getString('title') }}</text>
                  <view class="training-lesson-badge"><text class="training-lesson-badge-text">{{ c.getString('_lessonCountLabel') }}</text></view>
                  <view v-if="c.getBoolean('_locked') == true" class="training-course-lock-badge"><text class="training-course-lock-icon">🔒</text></view>
                </view>
                <view class="training-course-body">
                  <view class="training-course-meta">
                    <text class="training-course-title">{{ c.getString('title') }}</text>
                    <text v-if="c.getString('description') != null" class="training-course-desc">{{ c.getString('description') }}</text>
                    <view class="training-course-meta-row">
                      <text class="training-course-level">{{ c.getString('_levelLabel') }}</text>
                      <text class="training-course-credits">+{{ c.getNumber('credit_value') }} {{ lang == 'zh' ? '学分' : 'cr' }}</text>
                    </view>
                    <text v-if="c.getBoolean('_locked') == true && c.getString('prerequisite_title') != null" class="training-course-prereq-hint">
                      {{ lang == 'zh' ? '前置：' : 'Requires: ' }}{{ c.getString('prerequisite_title') }}
                    </text>
                  </view>
                </view>
              </view>

              <view v-if="trainingCertifications.length > 0" class="training-section-header">
                <text class="training-section-title">{{ lang == 'zh' ? '我的证书' : 'My Certifications' }}</text>
              </view>
              <view v-for="(cert, cti) in trainingCertifications" :key="cti" class="training-cert-card" v-on:click="showCertDetail(cti)">
                <text class="training-cert-icon">🏅</text>
                <view class="training-cert-info">
                  <text class="training-cert-title">{{ cert.getString('title') }}</text>
                  <text v-if="cert.getString('tier') != null" class="training-cert-tier">{{ cert.getString('_tierLabel') }}</text>
                </view>
                <text class="training-cert-chevron">›</text>
              </view>

              <!-- Certificate detail overlay -->
              <view v-if="certDetailOpen" class="cert-overlay" v-on:click="hideCertDetail">
                <view class="cert-detail-card" v-on:click.stop="noop">
                  <view class="cert-detail-header">
                    <view class="cert-status-badge">
                      <text class="cert-status-check">✓</text>
                      <text class="cert-status-text">{{ lang == 'zh' ? '证书有效' : 'Certificate Valid' }}</text>
                    </view>
                    <view class="cert-close-btn" v-on:click="hideCertDetail"><text>✕</text></view>
                  </view>
                  <view v-if="certDetailItem != null && (`${certDetailItem!.getString('templateImageUrl')}`.length) > 0" class="cert-bg-wrap">
                    <image :src="`${certDetailItem!.getString('templateImageUrl')}`" class="cert-bg-preview" mode="widthFix" />
                  </view>
                  <view class="cert-field-list">
                    <view class="cert-field"><text class="cert-label">{{ lang == 'zh' ? '姓名' : 'Name' }}</text><text class="cert-value">{{ certName }}</text></view>
                    <view class="cert-field"><text class="cert-label">{{ lang == 'zh' ? '学员编号' : 'Student ID' }}</text><text class="cert-value cert-mono">{{ certDetailItem != null ? certDetailItem!.getString('user_id') : '—' }}</text></view>
                    <view v-if="certDetailItem != null && certDetailItem!.getString('course_display_name') != null" class="cert-field"><text class="cert-label">{{ lang == 'zh' ? '课程名称' : 'Course' }}</text><text class="cert-value">{{ certDetailItem!.getString('course_display_name') }}</text></view>
                    <view class="cert-field"><text class="cert-label">{{ lang == 'zh' ? '证书名称' : 'Certificate' }}</text><text class="cert-value">{{ certDetailItem != null ? certDetailItem!.getString('title') : '' }}</text></view>
                    <view v-if="certDetailItem != null && certDetailItem!.getString('certificate_number') != null" class="cert-field"><text class="cert-label">{{ lang == 'zh' ? '证书编号' : 'Cert No.' }}</text><text class="cert-value cert-mono cert-number">{{ certDetailItem!.getString('certificate_number') }}</text></view>
                    <view v-if="certDetailItem != null && certDetailItem!.getString('assessment_period') != null" class="cert-field"><text class="cert-label">{{ lang == 'zh' ? '考核时间' : 'Assessment' }}</text><text class="cert-value">{{ certDetailItem!.getString('assessment_period') }}</text></view>
                    <view v-if="certDetailItem != null && certDetailItem!.getNumber('score') != null" class="cert-field"><text class="cert-label">{{ lang == 'zh' ? '考试分数' : 'Score' }}</text><text class="cert-value">{{ certDetailItem!.getNumber('score') }}</text></view>
                    <view class="cert-field"><text class="cert-label">{{ lang == 'zh' ? '证书状态' : 'Status' }}</text><text class="cert-value cert-valid">{{ lang == 'zh' ? '有效' : 'Valid' }}</text></view>
                    <view v-if="certDetailItem != null && certDetailItem!.getString('issuing_org') != null" class="cert-field"><text class="cert-label">{{ lang == 'zh' ? '颁发机构' : 'Issuing Org' }}</text><text class="cert-value">{{ certDetailItem!.getString('issuing_org') }}</text></view>
                    <view v-if="certDetailItem != null && certDetailItem!.getString('school_org') != null" class="cert-field"><text class="cert-label">{{ lang == 'zh' ? '办学机构' : 'Institute' }}</text><text class="cert-value">{{ certDetailItem!.getString('school_org') }}</text></view>
                    <view v-if="certDetailItem != null && (`${certDetailItem!.getString('issueDateDisplay')}`.length) > 0" class="cert-field"><text class="cert-label">{{ lang == 'zh' ? '颁发时间' : 'Issue Date' }}</text><text class="cert-value">{{ certDetailItem!.getString('issueDateDisplay') }}</text></view>
                    <view v-if="certDetailItem != null && (`${certDetailItem!.getString('expiryDateDisplay')}`.length) > 0" class="cert-field"><text class="cert-label">{{ lang == 'zh' ? '有效期至' : 'Expires' }}</text><text class="cert-value">{{ certDetailItem!.getString('expiryDateDisplay') }}</text></view>
                  </view>
                  <view v-if="certDetailItem != null && certDetailItem!.getString('cert_oss_key') != null" class="cert-download-btn" v-on:click="downloadCert(`${certDetailItem!.getString('cert_oss_key')}`)">
                    <text class="cert-download-label">↓ {{ lang == 'zh' ? '下载电子证书' : 'Download Certificate' }}</text>
                  </view>
                </view>
              </view>

              <view class="training-section-header"><text class="training-section-title">{{ tr('training.library') }}</text></view>
              <view v-if="trainingLibrary.length == 0" class="empty-state"><text class="empty-text">{{ tr('training.noLibrary') }}</text></view>
              <view v-for="(lib, li) in trainingLibrary" :key="li" class="training-library-row" v-on:click="trainingOpenLibraryItem(li)">
                <text class="training-library-icon">📄</text>
                <text class="training-library-title">{{ lib.getString('title') }}</text>
                <text class="training-library-chevron">›</text>
              </view>
            </view>

            <view v-else-if="trainingView == 'lessons'">
              <view class="training-back-row" v-on:click="trainingBackToList"><text class="training-back-text">{{ tr('training.backToCourses') }}</text></view>
              <view class="training-course-header">
                <text class="training-course-header-title">{{ trainingCurrentCourse != null ? trainingCurrentCourse!.getString('title') : '' }}</text>
                <text v-if="trainingCurrentCourse != null && trainingCurrentCourse!.getString('description') != null" class="training-course-header-desc">{{ trainingCurrentCourse!.getString('description') }}</text>
                <view class="training-course-meta-row">
                  <text class="training-course-level">{{ trainingCurrentCourse != null ? trainingCurrentCourse!.getString('_levelLabel') : '' }}</text>
                  <text class="training-course-credits">+{{ trainingCurrentCourse != null ? trainingCurrentCourse!.getNumber('credit_value') : 0 }} {{ lang == 'zh' ? '学分' : 'cr' }}</text>
                </view>
              </view>
              <view v-if="trainingLessons.length == 0" class="empty-state"><text class="empty-text">{{ tr('training.noLessons') }}</text></view>
              <view v-for="(lsn, lni) in trainingLessons" :key="lni" class="training-lesson-row" v-on:click="trainingOpenLesson(lni)">
                <view class="training-lesson-num"><text class="training-lesson-num-text">{{ lni + 1 }}</text></view>
                <view class="training-lesson-info">
                  <text class="training-lesson-title">{{ lsn.getString('title') }}</text>
                  <text v-if="lsn.getString('description') != null" class="training-lesson-desc">{{ lsn.getString('description') }}</text>
                  <view class="training-lesson-meta-row">
                    <text class="training-lesson-type-badge">{{ lsn.getString('content_type') == 'video' ? '🎬' : (lsn.getString('content_type') == 'text' ? '📄' : '🧩') }}</text>
                    <text class="training-lesson-credits-label">+{{ lsn.getNumber('credit_value') }} {{ lang == 'zh' ? '学分' : 'cr' }}</text>
                    <text v-if="lsn.getBoolean('has_quiz') == true" class="training-lesson-quiz-badge">📝 {{ lang == 'zh' ? '含测验' : 'Quiz' }}</text>
                  </view>
                </view>
                <view v-if="isLessonCompleted(lni)" class="training-lesson-done"><text class="training-lesson-done-text">✓</text></view>
                <text v-else class="training-lesson-chevron">›</text>
              </view>
            </view>

            <view v-else-if="trainingView == 'player'">
              <view class="training-back-row" v-on:click="trainingBackToLessons"><text class="training-back-text">{{ tr('training.backToLessons') }}</text></view>
              <view v-if="trainingCurrentLesson != null && (trainingCurrentLesson!.getString('content_type') == 'video' || trainingCurrentLesson!.getString('content_type') == null)">
                <view class="training-video-container">
                  <video v-if="trainingVideoUrl.length > 0" class="training-video" :src="trainingVideoUrl" :controls="true" object-fit="contain" />
                  <view v-else class="training-video-loading"><text class="training-video-loading-text">{{ tr('loading') }}</text></view>
                </view>
              </view>
              <view v-else-if="trainingCurrentLesson != null && (trainingCurrentLesson!.getString('content_type') == 'text' || trainingCurrentLesson!.getString('content_type') == 'interactive')">
                <view class="training-text-content">
                  <text class="training-text-body">{{ trainingTextContent.length > 0 ? trainingTextContent : tr('loading') }}</text>
                </view>
              </view>
              <view class="training-lesson-detail">
                <text class="training-lesson-detail-title">{{ trainingCurrentLesson != null ? trainingCurrentLesson!.getString('title') : '' }}</text>
                <text v-if="trainingCurrentLesson != null && trainingCurrentLesson!.getString('description') != null" class="training-lesson-detail-desc">{{ trainingCurrentLesson!.getString('description') }}</text>

                <view v-if="trainingQuizQuestions.length > 0" class="training-quiz-section">
                  <text class="training-quiz-title">{{ lang == 'zh' ? '📝 课后测验' : '📝 Quiz' }}</text>
                  <view v-if="trainingQuizResult != null" class="training-quiz-result" :class="trainingQuizResult!.getBoolean('passed') == true ? 'training-quiz-passed' : 'training-quiz-failed'">
                    <text class="training-quiz-result-score">{{ trainingQuizResult!.getNumber('score') }}%</text>
                    <text class="training-quiz-result-label">{{ trainingQuizResult!.getBoolean('passed') == true ? (lang == 'zh' ? '通过！' : 'Passed!') : (lang == 'zh' ? '未通过，请重试' : 'Not passed, try again') }}</text>
                    <text v-if="(trainingQuizResult!.getNumber('credits_earned') ?? 0) > 0" class="training-quiz-result-credits">+{{ trainingQuizResult!.getNumber('credits_earned') }} {{ lang == 'zh' ? '学分' : 'credits' }}</text>
                    <view v-if="trainingQuizReview.length > 0" class="training-quiz-review">
                      <view v-for="(rv, rvi) in trainingQuizReview" :key="rvi" class="training-quiz-review-item" :class="rv.getBoolean('is_correct') == true ? ' training-quiz-review-correct' : ' training-quiz-review-wrong'">
                        <text class="training-quiz-review-icon">{{ rv.getBoolean('is_correct') == true ? '✓' : '✗' }}</text>
                        <view class="training-quiz-review-body">
                          <text class="training-quiz-review-q">{{ rv.getString('question') }}</text>
                          <text v-if="rv.getBoolean('is_correct') != true" class="training-quiz-review-your-ans">{{ lang == 'zh' ? '你的答案：' : 'Your answer: ' }}{{ rv.getString('user_answer') }}</text>
                          <text class="training-quiz-review-correct-ans">{{ lang == 'zh' ? '正确答案：' : 'Correct: ' }}{{ rv.getString('correct_answer') }}</text>
                          <text v-if="(`${rv.getString('explanation')}`.length) > 0" class="training-quiz-review-explanation">{{ rv.getString('explanation') }}</text>
                        </view>
                      </view>
                    </view>
                  </view>

                  <view v-if="trainingQuizResult == null || trainingQuizResult!.getBoolean('passed') != true">
                    <view v-for="(q, qi) in trainingQuizQuestions" :key="qi" class="training-quiz-question">
                      <text v-if="q.getString('scenario') != null" class="training-quiz-scenario">{{ q.getString('scenario') }}</text>
                      <text class="training-quiz-q-text">{{ qi + 1 }}. {{ q.getString('question') }}</text>
                      <view v-for="(opt, oi2) in arrOf(q, 'options')" :key="oi2" class="training-quiz-option" :class="quizAnswerFor(q) == oi2 ? 'training-quiz-option-selected' : ''" v-on:click="trainingSelectAnswer(idStr(q, 'id'), oi2)">
                        <view class="training-quiz-option-radio" :class="quizAnswerFor(q) == oi2 ? 'training-quiz-option-radio-checked' : ''"></view>
                        <text class="training-quiz-option-text">{{ opt.getString('text') }}</text>
                      </view>
                    </view>
                    <view class="training-quiz-submit-btn" :class="trainingQuizSubmitting ? 'training-mark-btn-busy' : ''" v-on:click="trainingSubmitQuiz">
                      <text class="training-mark-btn-text">{{ trainingQuizSubmitting ? tr('loading') : (lang == 'zh' ? '提交答案' : 'Submit Answers') }}</text>
                    </view>
                  </view>
                </view>

                <view v-if="currentLessonCompleted" class="training-completed-badge">
                  <text class="training-completed-badge-text">{{ tr('training.markedComplete') }}</text>
                </view>
                <view v-else-if="trainingQuizQuestions.length == 0" class="training-mark-btn" :class="trainingMarkingComplete ? 'training-mark-btn-busy' : ''" v-on:click="trainingMarkComplete">
                  <text class="training-mark-btn-text">{{ trainingMarkingComplete ? tr('loading') : tr('training.markComplete') }}</text>
                </view>
                <view v-else-if="trainingQuizResult != null && trainingQuizResult!.getBoolean('passed') == true" class="training-mark-btn" :class="trainingMarkingComplete ? 'training-mark-btn-busy' : ''" v-on:click="trainingMarkComplete">
                  <text class="training-mark-btn-text">{{ trainingMarkingComplete ? tr('loading') : tr('training.markComplete') }}</text>
                </view>
              </view>
            </view>

            <view v-else-if="trainingView == 'library-viewer'">
              <view class="training-back-row" v-on:click="trainingBackToList"><text class="training-back-text">{{ tr('training.backToCourses') }}</text></view>
              <view class="training-library-header">
                <text class="training-library-header-title">{{ trainingCurrentLibraryItem != null ? trainingCurrentLibraryItem!.getString('title') : '' }}</text>
              </view>
              <view class="training-library-content-scroll">
                <text class="training-library-content-text">{{ trainingLibraryContent.length > 0 ? trainingLibraryContent : tr('loading') }}</text>
              </view>
            </view>
          </view>
        </scroll-view>

        <scroll-view v-else direction="vertical" class="wellness-subtab-scroll">
          <view v-if="wellnessLoading" class="wellness-loading"><text class="loading-dots">···</text></view>
          <view v-else>
            <view v-if="wellnessAssets.length == 0 && deviceApkUrl.length == 0" class="wellness-empty">
              <text class="wellness-empty-text">{{ tr('wellnessEmpty') }}</text>
            </view>
            <view v-for="(a, ai) in wellnessAssets" :key="ai" class="wellness-section">
              <view v-if="a.getString('mediaType') == 'audio'" class="sleep-track-card" v-on:click="playAudioAsset(ai)">
                <view class="sleep-track-icon"><text class="sleep-icon-glyph">{{ trackPlaying(a) ? '⏸' : '▶' }}</text></view>
                <view class="sleep-track-info">
                  <text class="sleep-track-name">{{ a.getString('title_zh') != null ? a.getString('title_zh') : a.getString('title') }}</text>
                  <text v-if="a.getNumber('duration_seconds') != null" class="sleep-track-dur">{{ durLabel(a.getNumber('duration_seconds')) }}</text>
                </view>
                <view v-if="trackActive(a)" class="sleep-track-active-dot"></view>
              </view>
              <view v-else-if="a.getString('mediaType') == 'video'" class="media-asset-card" v-on:click="openMediaAsset(ai)">
                <view class="media-asset-icon media-asset-icon--video"><text class="media-asset-glyph">▶</text></view>
                <view class="media-asset-info">
                  <text class="media-asset-name">{{ a.getString('title_zh') != null ? a.getString('title_zh') : a.getString('title') }}</text>
                  <text v-if="a.getNumber('duration_seconds') != null" class="media-asset-sub">{{ durLabel(a.getNumber('duration_seconds')) }}</text>
                </view>
                <view class="media-asset-btn"><text class="media-asset-btn-text">{{ tr('wellnessOpenLink') }}</text></view>
              </view>
              <view v-else class="media-asset-card" v-on:click="openMediaAsset(ai)">
                <view class="media-asset-icon media-asset-icon--doc"><text class="media-asset-glyph">↓</text></view>
                <view class="media-asset-info">
                  <text class="media-asset-name">{{ a.getString('title_zh') != null ? a.getString('title_zh') : a.getString('title') }}</text>
                </view>
                <view class="media-asset-btn"><text class="media-asset-btn-text">{{ tr('wellnessOpenLink') }}</text></view>
              </view>
            </view>

            <!-- #ifdef WEB -->
            <!-- The web user-app's Kino APK card (LearnTab) — copy the download link. -->
            <view v-if="deviceApkUrl.length > 0" class="wellness-section" style="padding-bottom: 0">
              <view class="media-asset-card" v-on:click="copyApkUrl">
                <view class="media-asset-icon media-asset-icon--doc"><text class="media-asset-glyph">↓</text></view>
                <view class="media-asset-info"><text class="media-asset-name">Kino APK {{ deviceApkVersion }}</text></view>
                <view class="media-asset-btn"><text class="media-asset-btn-text">{{ tr('wellnessOpenLink') }}</text></view>
              </view>
            </view>
            <!-- #endif -->

            <view v-if="sleepCurrentTrack != null" class="sleep-now-playing">
              <view class="sleep-np-info">
                <text class="sleep-np-label">{{ tr('nowPlaying') }}</text>
                <text class="sleep-np-title">{{ sleepCurrentTrack!.getString('title_zh') != null ? sleepCurrentTrack!.getString('title_zh') : sleepCurrentTrack!.getString('title') }}</text>
              </view>
              <view class="sleep-np-controls">
                <view class="sleep-np-btn" v-on:click="stopAudioAsset"><text class="sleep-np-btn-icon">⏹</text></view>
              </view>
            </view>

          </view>
        </scroll-view>
      </view>
      <!-- end LEARN -->
    </view>
    <!-- end tab-content -->

    <!-- ════ 营养定制 focus sheet (page-level, overlays every tab) ════
         Asked before the tool runs, because a focus is not a hint: it decides which dots survive
         the weekly tier cap (AGENTS §31). Never a gate — 不设方向 / Formulate anyway always present. -->
    <view v-if="formulaFocusOpen" class="overlay-mask focus-mask" v-on:click="closeFormulaFocus">
      <view class="focus-sheet" v-on:click.stop="noop">
        <view class="overlay-header">
          <text class="overlay-title">{{ tr('focusTitle') }}</text>
          <view class="overlay-close" v-on:click="closeFormulaFocus"><text class="close-x">✕</text></view>
        </view>
        <view v-if="formulaFocusPlans.length > 0">
          <text class="focus-intro">{{ tr('focusHasIntro') }}</text>
          <view v-for="(fp, fi) in formulaFocusPlans" :key="fi" class="focus-plan-row">
            <view class="plan-type-badge" :class="'plan-type-' + fp.getString('plan_type')">
              <text class="plan-type-text">{{ fp.getString('plan_type') == 'primary' ? tr('plansPrimary') : tr('plansSecondary') }}</text>
            </view>
            <view class="focus-plan-body">
              <text class="focus-plan-name">{{ fp.getString('name') }}</text>
              <text v-if="(`${fp.getString('goal')}`.length) > 0" class="focus-plan-goal">{{ fp.getString('goal') }}</text>
            </view>
          </view>
          <text class="focus-hint">{{ tr('focusHasHint') }}</text>
          <view class="focus-btn focus-btn-primary" v-on:click="handleFormulaFocusGo"><text class="focus-btn-label-primary">{{ tr('focusGo') }}</text></view>
          <view class="focus-btn-row">
            <view class="focus-btn focus-btn-ghost focus-btn-half" v-on:click="handleFormulaFocusChoose"><text class="focus-btn-label-ghost">{{ tr('focusChoose') }}</text></view>
            <view class="focus-btn focus-btn-ghost focus-btn-half" v-on:click="handleFormulaFocusSkip"><text class="focus-btn-label-ghost">{{ tr('focusSkip') }}</text></view>
          </view>
        </view>
        <view v-else>
          <text class="focus-intro">{{ tr('focusNoneIntro') }}</text>
          <text class="focus-hint">{{ tr('focusNoneHint') }}</text>
          <view class="focus-btn focus-btn-primary" v-on:click="handleFormulaFocusChoose"><text class="focus-btn-label-primary">{{ tr('focusChoose') }}</text></view>
          <view class="focus-btn focus-btn-ghost" v-on:click="handleFormulaFocusGo"><text class="focus-btn-label-ghost">{{ tr('focusGoNoPlan') }}</text></view>
        </view>
      </view>
    </view>

    <!-- ── Cartridge Sim Overlay ──
         TODO(port): NFC tag emulation — the miniapp's set-insert fabricates SIM-<dot>-<ts>-<i>
         NFC tag ids; a native app has no dispenser to receive them. Server calls kept as-is. -->
    <view v-if="simCartOpen" class="csim-overlay" v-on:click="closeCartSim">
      <view class="csim-sheet" v-on:click.stop="noop">
        <text class="csim-title">{{ tr('simCartTitle') }}</text>
        <text class="csim-subtitle">{{ tr('simCartSubtitle') }}</text>
        <view class="csim-sets">
          <view v-for="(set, seti) in simCartSets" :key="seti" class="csim-set-card" :style="'border-color:' + set.getString('color')" v-on:click="handleSelectCartSet(seti)">
            <view class="csim-set-accent" :style="'background:' + set.getString('color')"></view>
            <view class="csim-set-body">
              <text class="csim-set-name">{{ set.getString('name') }}</text>
              <text class="csim-set-desc">{{ set.getString('desc') }}</text>
              <view class="csim-dot-badges">
                <view v-for="(di, dj) in arrOf(set, 'dotItems')" :key="dj" class="csim-dot-badge">
                  <text class="csim-badge-key" :style="'color:' + set.getString('color')">{{ di.getString('displayKey') }}</text>
                  <text class="csim-badge-name">{{ di.getString('dotName') }}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
        <view v-if="simCartLoading" class="csim-loading"><text class="loading-dots">···</text></view>
        <view class="csim-cancel" v-on:click="closeCartSim"><text class="csim-cancel-label">{{ tr('simCartCancel') }}</text></view>
      </view>
    </view>

    <!-- ── Kino Passcode Overlay ── -->
    <view v-if="kinoPassOpen" class="kpass-overlay">
      <view class="kpass-box" :style="'margin-top:' + (statusBarHeight + 44) + 'px'">
        <text class="kpass-logo">⬡</text>
        <text class="kpass-title">{{ tr('kinoSimPassTitle') }}</text>
        <view class="kpass-dots">
          <view class="kpass-dot" :class="kinoPassInput.length > 0 ? 'kpass-dot-filled' : ''" :style="kinoPassError ? 'background:#ef4444' : ''"></view>
          <view class="kpass-dot" :class="kinoPassInput.length > 1 ? 'kpass-dot-filled' : ''" :style="kinoPassError ? 'background:#ef4444' : ''"></view>
          <view class="kpass-dot" :class="kinoPassInput.length > 2 ? 'kpass-dot-filled' : ''" :style="kinoPassError ? 'background:#ef4444' : ''"></view>
          <view class="kpass-dot" :class="kinoPassInput.length > 3 ? 'kpass-dot-filled' : ''" :style="kinoPassError ? 'background:#ef4444' : ''"></view>
        </view>
        <text v-if="kinoPassError" class="kpass-error">{{ tr('kinoSimPassError') }}</text>
        <view v-else style="height:18px"></view>
        <view class="kpass-numpad">
          <view v-for="(k, ki) in passKeys" :key="ki" class="kpass-key" v-on:click="handlePassKey(`${k}`)"><text class="kpass-key-label">{{ k }}</text></view>
          <view class="kpass-key kpass-key-empty"></view>
          <view class="kpass-key" v-on:click="handlePassKey('0')"><text class="kpass-key-label">0</text></view>
          <view class="kpass-key kpass-key-del" v-on:click="handlePassDelete"><text class="kpass-del-icon">⌫</text></view>
        </view>
        <view class="kpass-cancel" v-on:click="closeKinoPass"><text class="kpass-cancel-label">{{ tr('logout') }}</text></view>
      </view>
    </view>

    <!-- ── Kino Simulator Overlay ── full-screen <view> over the page; flow kept exactly:
         passcode → ready → chip scan → analyzing → complete (slide + results tabs) / failed. -->
    <view v-if="kinoSimOpen" class="ksm-overlay">
      <view class="ksm-container">
        <view class="ksm-header" :style="'padding-top:' + statusBarHeight + 'px'">
          <view>
            <text class="ksm-title">{{ tr('kinoSimTitle') }}</text>
            <text class="ksm-serial">S/N: KNA2-00000</text>
          </view>
          <view class="ksm-close" v-on:click="closeKinoSim"><text class="ksm-close-label">✕</text></view>
        </view>
        <scroll-view direction="vertical" class="ksm-body">
          <view class="ksm-body-inner">
            <view class="ksm-device-wrap" :class="'ksm-state-' + kinoSimStatus">
              <view class="ksm-ring-face" :style="ksmRingStyle">
                <view v-if="kinoSimStatus == 'complete' && kinoSimBmList.length > 0" class="ksm-face-slide" :class="kinoSimSlideVisible ? 'ksm-slide-visible' : ''">
                  <text class="ksm-slide-index">{{ kinoSimSlideIndex + 1 }} / {{ kinoSimBmList.length }}</text>
                  <text class="ksm-slide-label">{{ slideLabel }}</text>
                  <text class="ksm-slide-val">{{ slideValue }}</text>
                  <text class="ksm-slide-unit">{{ slideUnit }}</text>
                </view>
                <view v-else class="ksm-face-static">
                  <text class="ksm-face-label">STATUS</text>
                  <text class="ksm-face-status" :class="'ksm-face-status-' + kinoSimStatus">
                    {{ kinoSimStatus == 'ready' ? tr('kinoSimStatusReady') : (kinoSimStatus == 'analyzing' ? tr('kinoSimStatusAnalyzing') : (kinoSimStatus == 'complete' ? tr('kinoSimStatusComplete') : tr('kinoSimStatusFailed'))) }}
                  </text>
                  <text v-if="kinoSimScannedUserName.length > 0" class="ksm-face-patient-label">{{ tr('kinoSimPatientLabel') }}</text>
                  <text class="ksm-face-user">{{ kinoSimScannedUserName.length > 0 ? kinoSimScannedUserName : '—' }}</text>
                </view>
              </view>
            </view>

            <view v-if="kinoSimStatus == 'complete' && kinoSimBmList.length > 0" class="ksm-results">
              <view class="ksm-tabs">
                <view class="ksm-tab" :class="kinoSimActiveTab == 'bioage' ? 'ksm-tab-active' : ''" v-on:click="onKinoSimTabChange('bioage')"><text>{{ tr('kinoSimTabBioAge') }}</text></view>
                <view class="ksm-tab" :class="kinoSimActiveTab == 'biomarkers' ? 'ksm-tab-active' : ''" v-on:click="onKinoSimTabChange('biomarkers')"><text>{{ tr('kinoSimTabBm') }}</text></view>
              </view>
              <view v-if="kinoSimActiveTab == 'bioage'" class="ksm-tab-content">
                <view class="ksm-bioage-row">
                  <view class="ksm-bioage-chip">
                    <text class="ksm-bioage-num" :style="'color:' + kinoSimBioAgeColor">{{ kinoSimBioAge }}</text>
                    <text class="ksm-bioage-chip-label">{{ tr('kinoSimBioAgeLabel') }}</text>
                  </view>
                  <view class="ksm-bioage-chip ksm-bioage-chip-dim">
                    <text class="ksm-bioage-num" style="color:#A6C4E5">{{ kinoSimChronoAge }}</text>
                    <text class="ksm-bioage-chip-label">{{ tr('kinoSimChronoLabel') }}</text>
                  </view>
                </view>
                <view v-for="(sa, sai) in kinoSimSubAgeList" :key="sai" class="ksm-sub-row">
                  <view class="ksm-sub-dot" :style="'background:' + sa.getString('color')"></view>
                  <text class="ksm-sub-label">{{ sa.getString('label') }}</text>
                  <text class="ksm-sub-val" :style="'color:' + sa.getString('color')">{{ sa.getString('value') }}</text>
                </view>
              </view>
              <view v-if="kinoSimActiveTab == 'biomarkers'" class="ksm-tab-content">
                <view v-for="(bm, bi) in kinoSimBmList" :key="bi" class="ksm-bm-row">
                  <text class="ksm-bm-label">{{ bm.getString('label') }}</text>
                  <text class="ksm-bm-val">{{ bm.getString('value') }} <text class="ksm-bm-unit">{{ bm.getString('unit') }}</text></text>
                </view>
              </view>
            </view>

            <view class="ksm-btn" :class="'ksm-btn-' + kinoSimStatus" v-on:click="handleKinoSimStart">
              <text v-if="kinoSimStatus == 'analyzing'" class="ksm-btn-label">···</text>
              <text v-else-if="kinoSimStatus == 'complete'" class="ksm-btn-label">{{ tr('kinoSimBtnRunAnother') }}</text>
              <text v-else class="ksm-btn-label">{{ tr('kinoSimBtnStart') }}</text>
            </view>

            <view class="ksm-quit-btn" v-on:click="closeKinoSim"><text class="ksm-quit-label">✕  {{ tr('kinoSimQuit') }}</text></view>

            <view class="ksm-debug-toggle" v-on:click="toggleKinoSimDebug">
              <text class="ksm-debug-toggle-text">{{ kinoSimDebug ? '▲ DEBUG' : '▼ DEBUG' }}</text>
            </view>
            <view v-if="kinoSimDebug && kinoSimError.length > 0" class="ksm-debug-box">
              <text class="ksm-debug-label">ERROR</text>
              <text class="ksm-debug-msg">{{ kinoSimError }}</text>
            </view>
            <view v-else-if="kinoSimDebug" class="ksm-debug-box"><text class="ksm-debug-msg">No errors.</text></view>
            <view style="height:24px"></view>
          </view>
        </scroll-view>
      </view>
    </view>

    <!-- ── Bottom Tab Bar ── -->
    <view class="tab-bar">
      <view class="tab-btn" :class="tab == 'chat' ? 'tab-active' : ''" v-on:click="switchTab('chat')">
        <view v-if="tab == 'chat'" class="tab-line"></view>
        <image class="tab-icon-img" :class="tab == 'chat' ? 'tab-icon-on' : ''" src="/static/icons/chat.svg" mode="aspectFit" />
        <text class="tab-label" :class="tab == 'chat' ? 'tab-label-on' : ''">{{ tr('tabChat') }}</text>
      </view>
      <view class="tab-btn" :class="tab == 'health' ? 'tab-active' : ''" v-on:click="switchTab('health')">
        <view v-if="tab == 'health'" class="tab-line"></view>
        <image class="tab-icon-img" :class="tab == 'health' ? 'tab-icon-on' : ''" src="/static/icons/health.svg" mode="aspectFit" />
        <text class="tab-label" :class="tab == 'health' ? 'tab-label-on' : ''">{{ tr('tabHealth') }}</text>
      </view>
      <view class="tab-btn" :class="tab == 'plans' ? 'tab-active' : ''" v-on:click="switchTab('plans')">
        <view v-if="tab == 'plans'" class="tab-line"></view>
        <image class="tab-icon-img" :class="tab == 'plans' ? 'tab-icon-on' : ''" src="/static/icons/plans.svg" mode="aspectFit" />
        <text class="tab-label" :class="tab == 'plans' ? 'tab-label-on' : ''">{{ tr('tabPlans') }}</text>
      </view>
      <view v-if="!isGuest" class="tab-btn" :class="tab == 'learn' ? 'tab-active' : ''" v-on:click="switchTab('learn')">
        <view v-if="tab == 'learn'" class="tab-line"></view>
        <image class="tab-icon-img" :class="tab == 'learn' ? 'tab-icon-on' : ''" src="/static/icons/training.svg" mode="aspectFit" />
        <text class="tab-label" :class="tab == 'learn' ? 'tab-label-on' : ''">{{ tr('tabLearn') }}</text>
      </view>
      <view v-if="!isGuest" class="tab-btn" :class="tab == 'store' ? 'tab-active' : ''" v-on:click="switchTab('store')">
        <view v-if="tab == 'store'" class="tab-line"></view>
        <image class="tab-icon-img" :class="tab == 'store' ? 'tab-icon-on' : ''" src="/static/icons/store.svg" mode="aspectFit" />
        <text class="tab-label" :class="tab == 'store' ? 'tab-label-on' : ''">{{ tr('tabStore') }}</text>
      </view>
    </view>

    <!-- ── Guest Join Sheet ── invite-code entry only; a valid code hands off to login,
         which owns account creation + the phone/email OTP gate. -->
    <view v-if="guestSheetOpen" class="guest-sheet-mask" v-on:click="closeGuestSheet">
      <view class="guest-sheet" :style="guestKeyboardHeight > 0 ? 'padding-bottom: ' + guestKeyboardHeight + 'px;' : ''" v-on:click.stop="noop">
        <view class="guest-sheet-handle"></view>
        <text class="guest-sheet-title">{{ tr('guestJoinTitle') }}</text>
        <text class="guest-sheet-desc">{{ tr('guestJoinDesc') }}</text>
        <view class="pin-field">
          <view class="pin-boxes">
            <view v-for="(dg, di2) in pinDigits" :key="di2" class="pin-box" :class="dg.length > 0 ? 'pin-filled' : (di2 == guestInviteCode.length ? 'pin-active' : '')">
              <text class="pin-digit">{{ dg }}</text>
            </view>
          </view>
          <input class="pin-capture" type="number" v-model="guestInviteCode" maxlength="6" v-on:input="onGuestInviteTyped()"
            :focus="guestSheetOpen" :adjust-position="false" v-on:keyboardheightchange="onGuestKeyboardHeightChange" />
        </view>
        <view v-if="guestInviteError.length > 0" class="guest-sheet-error"><text class="guest-sheet-error-text">{{ guestInviteError }}</text></view>
        <view class="guest-sheet-btn" :class="guestInviteBusy ? 'guest-sheet-btn-disabled' : ''" v-on:click="submitGuestInvite">
          <text class="guest-sheet-label">{{ guestInviteBusy ? tr('guestActivating') : tr('guestJoinBtn') }}</text>
        </view>
      </view>
    </view>

    <!-- ── 兑换码 sheet ── shipping is mandatory: GCN's redemption refuses without it (the box
         physically ships and no later step can collect an address). -->
    <view v-if="codeSheetOpen" class="guest-sheet-mask" v-on:click="closeCodeSheet">
      <view class="guest-sheet" v-on:click.stop="noop">
        <view class="guest-sheet-handle"></view>
        <text class="guest-sheet-title">{{ codeSheetManual ? tr('codeSheetTitle') : codeSheetName }}</text>
        <text class="guest-sheet-desc">{{ codeSheetManual ? tr('codeSheetDescManual') : tr('codeSheetDesc') }}</text>
        <input v-if="codeSheetManual" class="viva-redeem-input" type="text" v-model="codeSheetCode" :placeholder="tr('codePlaceholder')" v-on:input="clearCodeError()" />
        <input class="viva-redeem-input" type="text" v-model="codeShipName" :placeholder="tr('codeNamePlaceholder')" />
        <input class="viva-redeem-input" type="text" v-model="codeShipPhone" :placeholder="tr('codePhonePlaceholder')" />
        <input class="viva-redeem-input" type="text" v-model="codeShipAddress" :placeholder="tr('codeAddrPlaceholder')" />
        <!-- #ifdef MP-WEIXIN -->
        <text v-if="wxAddressEnabled" class="code-wx-addr" v-on:click.stop="fetchWechatAddress('codeShip')">{{ tr('codeWxAddrBtn') }}</text>
        <!-- #endif -->
        <view v-if="codeSheetError.length > 0" class="guest-sheet-error"><text class="guest-sheet-error-text">{{ codeSheetError }}</text></view>
        <view class="guest-sheet-btn" :class="codeSheetBusy ? 'guest-sheet-btn-disabled' : ''" v-on:click="submitFormulationRedeem">
          <text class="guest-sheet-label">{{ codeSheetBusy ? '…' : tr('codeSubmitBtn') }}</text>
        </view>
      </view>
    </view>

    <!-- ── Viva Subscription Redeem Sheet ── -->
    <view v-if="vivaRedeemSheetOpen" class="guest-sheet-mask" v-on:click="closeVivaRedeemSheet">
      <view class="guest-sheet" v-on:click.stop="noop">
        <view class="guest-sheet-handle"></view>
        <text class="guest-sheet-title">{{ tr('vivaRedeemTitle') }}</text>
        <text class="guest-sheet-desc">
          {{ vivaSubscriptionExpiresAtDisplay.length > 0 && !vivaSubscriptionExpired
            ? (lang == 'zh' ? '当前订阅至 ' + vivaSubscriptionExpiresAtDisplay : 'Currently active until ' + vivaSubscriptionExpiresAtDisplay)
            : (lang == 'zh' ? '当前无有效订阅' : 'No active subscription') }}
        </text>
        <input class="viva-redeem-input" type="text" v-model="vivaRedeemCode" :placeholder="tr('vivaRedeemPlaceholder')" v-on:input="clearVivaRedeemError()" />
        <view v-if="vivaRedeemError.length > 0" class="guest-sheet-error"><text class="guest-sheet-error-text">{{ vivaRedeemError }}</text></view>
        <view class="guest-sheet-btn" :class="vivaRedeemBusy ? 'guest-sheet-btn-disabled' : ''" v-on:click="submitVivaRedeem">
          <text class="guest-sheet-label">{{ vivaRedeemBusy ? '…' : tr('vivaRedeemBtn') }}</text>
        </view>
      </view>
    </view>

    <!-- Page-level WeChat privacy modal (xapp-mini) — outside every tab container, so it shows
         whichever tab is active. The agree button must be WeChat's own agreePrivacyAuthorization
         button: that is what releases the held privacy API call (utils/privacy.uts). Android and
         web use OS permission prompts. -->
    <!-- #ifdef MP-WEIXIN -->
    <view v-if="showPrivacyModal" class="page-privacy-mask" v-on:click.stop="noop">
      <view class="page-privacy-box">
        <text class="page-privacy-title">{{ lang == 'en' ? 'Privacy Notice' : '隐私保护提示' }}</text>
        <text class="page-privacy-body">{{ lang == 'en' ? 'To upload images and use health features, this app needs access to your photo album and camera. Please agree to our privacy policy to continue.' : '为上传图片及使用健康功能，本应用需要访问您的相册和摄像头。请阅读并同意我们的隐私保护指引后继续。' }}</text>
        <button class="page-privacy-agree-btn" id="privacy-agree-btn" open-type="agreePrivacyAuthorization" v-on:agreeprivacyauthorization="onPrivacyAgree">{{ lang == 'en' ? 'Agree & Continue' : '同意并继续' }}</button>
        <view class="page-privacy-cancel-btn" v-on:click="onPrivacyCancel"><text class="page-privacy-cancel-text">{{ lang == 'en' ? 'Decline' : '拒绝' }}</text></view>
      </view>
    </view>
    <!-- #endif -->
  </view>
</template>

<script>
// Ported from miniapp pages/main/main.js (5682 lines). Orchestrator rules kept line-for-line where
// they carry production history:
//  - async two-channel delivery (§22): /api/chat {processing} + user_message_id, the 3s
//    /api/notifications poll with chat_status captions, the chat_messages catch-up replay gated on
//    _chatWaitStartedAt with roles coach,ai (durable backstop for the DESTRUCTIVE notification
//    read), turn-scoped _aiKey dedup over AI_ECHO_TYPES, CHAT_WAIT_SYNC_MS/ASYNC_MS budgeting via
//    _beginChatWait, and the timeout line that must stay above the server's 266s worst case;
//  - biomarker sparklines from data.validated only (§17, via biomarker-series.uts);
//  - agentic action tails: stripActionJson behaviour lives server-side; the client keeps
//    action-role bubbles, hr_* consent chain, remember_fact chips via toolbox;
//  - onboarding checklist gating (obStep !== 'done' blocks send/tools/poll);
//  - sandbox banner + sandbox:true injection on every mutating POST;
//  - text-scale pinch: ONE step per gesture via PinchStepper (coordinates, not touch events);
//  - .chat-inner 100px bottom padding = the 200rpx clipping fix (AGENTS §23) — do not shrink;
//  - cart/package/redeem mapping helpers (mapPackages/mapCodes/parsePlan/mapStructuredSchedules/
//    mapStoreItems/mapStoreOrders/mapCartridges/pkgTitle) ported fully.
// Deliberate deviations:
//  - wx.getUpdateManager OTA — not present in this page to begin with; the native app updates
//    differ (uni-app x wgt path), nothing to port.
//  - WechatSI mic → removed. // TODO(port): ASR plugin
//  - wx.login/_getCode → skipped; xapp login is phone/email OTP (already ported, AGENTS §33).
//  - wx.chooseAddress → xapp-mini only (fetchWechatAddress); native: manual entry.
//  - wx.requestSubscribeMessage (weight-reminder subscribe) → xapp-mini only. TODO(port): native
//    push equivalents; there _weightSubAccepted stays false (send_weight_reminder:false).
//  - getApp().globalData → utils/state.uts singleton; privacy-resolve hooks → utils/privacy.uts (xapp-mini).
//  - selectComponent('#health-comp') method calls → $refs cast to UserHealthComponentPublicInstance (the generated per-component type; a hand-written interface cast throws at runtime).
//  - mp-html → <rich-text>; its bindlinktap/bindready (_onMdLinkTap/_onSegReady) have no rich-text
//    equivalent yet. // TODO(port): link-tap copy + settle-scroll for long replies; the timer ladder
//    in _scrollBottom still covers the common case.

import { BASE, API_ORIGIN, DISPLAY_VERSION, IS_DEV, CHANNEL_DISPLAY, WX_ADDRESS_ENABLED } from '../../utils/config.uts'
import { openInNewTab } from '../../utils/web-open.uts'
import { idOf } from '../../utils/json-id.uts'
import { speechSupported, startSpeech, stopSpeech } from '../../utils/web-speech.uts'
import { scanQr, setScanTitle, syncRootClasses } from '../../utils/web-ui.uts'
import { state } from '../../utils/state.uts'
import { setPrivacyHandler, resolvePrivacy } from '../../utils/privacy.uts'
import { clearSession, checkAuthStatus } from '../../utils/session.uts'
import { maskPhone } from '../../utils/phone.uts'
import { PinchStepper } from '../../utils/pinch.uts'
import { resolveAvatarUrl, DEFAULT_MOOD } from '../../utils/mood.uts'
import { mdToSegments, Segment, MD_TAG_STYLE, inlineTagStyles } from '../../utils/markdown.uts'

// uni-app x rich-text does not inherit a container color (`.msg-html` color warns on view), and
// node styles come from MD_TAG_STYLE. Nudging it page-side keeps markdown.uts byte-identical to
// the miniapp for the differential harness. TODO(port): dark-theme literal — revisit with the
// light-theme pass (Android).
// Android/iOS only — on the web and in xapp-mini rich-text inherits its bubble's colour from
// the stylesheet (.msg-html, light theme included).
// #ifdef APP
const _HTML_COLOR = 'color:#EEF2FF'
const _colorTags : string[] = ['p', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'li', 'strong', 'em', 'blockquote', 'code', 'pre', 'th', 'td', 'del']
for (const tg of _colorTags) {
  const cur = MD_TAG_STYLE.get(tg)
