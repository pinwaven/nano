/* Text the miniapp colours by inheritance, which xapp's <text> does not do: each child the port gave
   its own class and a dark literal takes its nearest ancestor's light colour
   (tools/xapp-mini/style-gen/lightinherit.js; .pkg-cta-text-ghost set by hand to the miniapp's
   .pkg-cta-ghost .pkg-cta-text). */
.theme-light .msg-text { color: var(--text); }
.theme-light .fcard-tier-note-text { color: rgb(121, 96, 68); }
.theme-light .fcard-cta-label { color: rgb(122, 74, 40); }
.theme-light .ccard-cta-label { color: var(--chat-accent); }
.theme-light .typing-status-text { color: var(--text); }
.theme-light .quick-btn-label { color: var(--text); }
.theme-light .cond-chip-label { color: var(--text-muted); }
.theme-light .cart-empty-label { color: var(--text-muted); }
.theme-light .pkg-cta-text-ghost { color: var(--steel); }
.theme-light .dots-empty-label { color: var(--text-muted); }
.theme-light .modal-btn-cancel-label { color: #656462; }
.theme-light .browse-enrolled-label { color: #4f5fcc; }
.theme-light .copy-badge-label { color: var(--blue); }
.theme-light .csim-cancel-label { color: var(--text-muted); }
.theme-light .kpass-key-label { color: var(--text); }
.theme-light .kpass-cancel-label { color: var(--text-muted); }
.theme-light .ksm-close-label { color: var(--text-sub); }
.theme-light .ksm-quit-label { color: var(--text-muted); }
.theme-light .guest-sheet-error-text { color: #dc2626; }
/* #endif */
/* #ifdef MP-WEIXIN */
/* Text size (菜单 › 字体大小), from the miniapp's stylesheet: every rule of its whose font-size reads
   var(--fs-N), with the line-height it declares. The variables come from App.uvue's copy of app.wxss,
   rescaled under the page's .fs-1/.fs-2/.fs-3, and inherit into components; this file's own px sizes
   never would. Regenerate (tools/xapp-mini/style-gen: fsvars.js, then fsinherit.js) when the miniapp's sizes change. */
.coach-back-pill { font-size: var(--fs-20, 20rpx); }
.sandbox-banner-text { font-size: var(--fs-22, 22rpx); }
.sandbox-banner-exit { font-size: var(--fs-22, 22rpx); }
