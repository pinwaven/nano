  computed: {
    // Native: below the status bar + header. Web: the user-app's .menu-dropdown { top: 54px }.
    menuDropdownStyle() : string {
      // #ifdef WEB
      return ''
      // #endif
      // #ifndef WEB
      return 'top:' + (this.statusBarHeight + 44) + 'px'
      // #endif
    },
    // uni-app x <textarea> has no auto-height (miniapp auto-height="true"): the box starts as
    // one line and grows to 4 (the miniapp's 80→200rpx), then scrolls internally.
    chatInputH() : string {
      const s = this.chatInput
      let units = 0.0
      let lines = 1
      for (let i = 0; i < s.length; i++) {
        if (s.charAt(i) == '\n') { lines++; units = 0.0; continue }
        units += (s.charCodeAt(i) ?? 0) > 255 ? 1.0 : 0.55
        if (units > 15.0) { lines++; units = 0.0 }
      }
      if (lines > 4) lines = 4
      const h = lines == 1 ? 40 : 20 * lines + 20
      return 'height:' + h + 'px;'
    },
    userIdStr() : string {
      const u = this.user
      return u != null ? (u!.getString('user_id') ?? '') : ''
    },
    channelLogo() : string {
      // A guest has no channel; it wears the build's brand (xapp-mini: SuperiorMed).
      const c = this.channel != null ? this.channel : (this.isGuest ? CHANNEL_DISPLAY : null)
      if (c != null) {
        const l = c!.getString('logo_url')
        if (l != null && l!.length > 0) return l!
      }
      return '/static/waven-logo-icon.png'
    },
    channelName() : string {
      const c = this.channel != null ? this.channel : (this.isGuest ? CHANNEL_DISPLAY : null)
      if (c != null) {
        const n = c!.getString('name')
        if (n != null && n!.length > 0) return n!
      }
      return 'NANO'
    },
    headerUserName() : string {
      const u = this.user
      if (u == null) return 'User'
      const n = u!.getString('nickname')
      return n != null && n!.length > 0 ? n! : 'User'
    },
    pinDigits() : string[] {
      const out : string[] = []
      for (let i = 0; i < 6; i++) {
        out.push(i < this.guestInviteCode.length ? this.guestInviteCode.substring(i, i + 1) : '')
      }
      return out
    },
    obInputType() : string {
      const q = this.obQuestion
      return q != null ? (q!.getString('input_type') ?? '') : ''
    },
    obPlaceholder() : string {
      const q = this.obQuestion
      if (q == null) return ''
      const cfg = q!.getJSON('config')
      if (cfg == null) return ''
      const zh = cfg!.getString('placeholder_zh')
      const en = cfg!.getString('placeholder_en')
      if (this.lang == 'zh') return zh != null ? zh! : (en != null ? en! : '')
      return en != null ? en! : (zh != null ? zh! : '')
    },
    ksmRingStyle() : string {
      if (this.kinoSimStatus == 'analyzing') return 'border-color:#F59E0B'
      if (this.kinoSimStatus == 'complete') return 'border-color:#10B981'
      if (this.kinoSimStatus == 'failed') return 'border-color:#EF4444'
      return 'border-color:rgba(99, 117, 236, 0.4)'
    },
    slideLabel() : string {
      const list = this.kinoSimBmList
      if (this.kinoSimSlideIndex >= list.length) return ''
      return list[this.kinoSimSlideIndex].getString('label') ?? ''
    },
    slideValue() : string {
      const list = this.kinoSimBmList
      if (this.kinoSimSlideIndex >= list.length) return '—'
      const v = list[this.kinoSimSlideIndex]['value']
      return v != null ? `${v}` : '—'
    },
    slideUnit() : string {
      const list = this.kinoSimBmList
      if (this.kinoSimSlideIndex >= list.length) return ''
      return list[this.kinoSimSlideIndex].getString('unit') ?? ''
    },
    planTargetSubAges() : string[] {
      const d = this.planDetailData
      if (d == null) return [] as string[]
      return d!.getArray<string>('target_sub_ages') ?? ([] as string[])
    },
    planDetailReminders() : UTSJSONObject[] {
      const d = this.planDetailData
      if (d == null) return [] as UTSJSONObject[]
      return d!.getArray<UTSJSONObject>('reminders') ?? ([] as UTSJSONObject[])
    },
    planFormulation() : UTSJSONObject | null {
      const d = this.planDetailData
      if (d == null) return null
      return d!.getJSON('formulation')
    },
    planFormulationDots() : UTSJSONObject[] {
      const f = this.planFormulation
      if (f == null) return [] as UTSJSONObject[]
      return f!.getArray<UTSJSONObject>('dot_breakdown') ?? ([] as UTSJSONObject[])
    },
    planRecommendedDots() : UTSJSONObject[] {
      const d = this.planDetailData
      if (d == null) return [] as UTSJSONObject[]
      return d!.getArray<UTSJSONObject>('recommendedDots') ?? ([] as UTSJSONObject[])
    },
    guidanceText() : string {
      const d = this.planDetailData
      if (d == null) return ''
      if (this.lang == 'zh') {
        const dz = d!.getString('desc_zh')
        if (dz != null && dz!.length > 0) return dz!
        return d!.getString('goal_zh') ?? ''
      }
      const de = d!.getString('desc_en')
      if (de != null && de!.length > 0) return de!
      return d!.getString('goal_en') ?? ''
    },
    currentLessonCompleted() : boolean {
      const l = this.trainingCurrentLesson
      if (l == null) return false
      const id = l!.getNumber('id')
      if (id == null) return false
      return this.trainingCompletedIds.indexOf(id!) >= 0
    },
    certName() : string {
      const c = this.certDetailItem
      if (c != null) {
        const un = c!.getString('_userName')
        if (un != null && un!.length > 0) return un!
      }
      const u = this.user
      return u != null ? (u!.getString('nickname') ?? '—') : '—'
    },
  },
  onLoad(_options : OnLoadOptions) {
    const user = state.user
    if (user == null) { uni.reLaunch({ url: '/pages/login/login' }); return }
    // Defense in depth: an interrupted sign-up shouldn't land here (login owns that redirect).
    // xapp: the pending-phone gate is the verify-phone flow's own redirect, kept in login port.
    const info = uni.getWindowInfo()
    this.statusBarHeight = info.statusBarHeight
    this._screenW = info.windowWidth
    this.msgTextW = info.windowWidth - 56
    // #ifdef MP-WEIXIN
    const capsule = uni.getMenuButtonBoundingClientRect()
    this.capsuleRightPad = info.windowWidth - (capsule.left > 0 ? capsule.left : info.windowWidth - 96) + 8
    // #endif

    const channel = state.channel
    const userLang = user!.getString('language')
    const channelLocale = channel != null ? channel!.getString('locale') : null
    let lang = 'zh'
    if (userLang == 'en') lang = 'en'
    else if (channelLocale == 'en') lang = 'en'
    lang = state.lang.length > 0 ? state.lang : lang

    const isGuest = user!.getBoolean('guest') == true
    const roles = user!.getArray<string>('roles') ?? ([] as string[]).concat(isGuest ? ([] as string[]) : (['user'] as string[]))
    let isCoach = false
    let isAdmin2 = false
    let isSuperadmin = false
    for (const r of roles) {
      if (r == 'coach') isCoach = true
      if (r == 'admin' || r == 'superadmin') isAdmin2 = true
      if (r == 'superadmin') isSuperadmin = true
    }
    const userTheme = user!.getString('theme')
    const theme = userTheme != null && userTheme!.length > 0 ? userTheme! : state.theme

    const overrides = channel != null ? channel!.getJSON('sub_age_display_names') : DEFAULT_SUBAGE_OVERRIDES
    const baseT = lang == 'zh' ? T_MAIN_ZH : T_MAIN_EN
    const mergedT = new UTSJSONObject()
    baseT.toMap().forEach((v : any | null, k : string) => { mergedT[k] = v })
    mergedT['subAgeLabels'] = buildSubAgeLabels(baseT.getJSON('subAgeLabels')!, overrides, lang)

    this.user = user
    this.channel = channel
    this.lang = lang
    state.lang = lang
    this.theme = theme
    state.theme = theme
    this.textScale = state.textScale
    this.isGuest = isGuest
    this.isCoach = isCoach
    this.isAdmin = isAdmin2
    this.isSuperadmin = isSuperadmin
    this.userAvatarLetter = this._avatarLetter(user!.getString('nickname'))
    this.t = mergedT
    state.user = user

    // `isAeviva` = "this channel tree has a GCN storefront" (aeviva or waven ROOT, AGENTS §33);
    // gcnStoreSlug is the host it lives on. Email login availability is the complement.
    const channelRoot = _channelRootKey(channel)
    const slug = channelRoot != null ? GCN_STORE_HOST_FOR_CHANNEL.get(channelRoot!) : null
    this.gcnStoreSlug = slug != null ? slug! : ''
    this.isAeviva = slug != null
    this.emailLoginAllowed = channelRoot == null || channelRoot == 'waven'
    // #ifdef WEB
    this.emailLoginAllowed = true // the web user-app offers email login on every channel
    // #endif

    this.toolList = getToolList(mergedT)
    this.sandboxMode = state.sandboxMode
    const nick = user!.getString('nickname') ?? '—'
    this.sandboxBannerText = this.sandboxMode ? tMainTr(mergedT, 'sandboxBanner').split('{name}').join(nick.length > 0 ? nick : '—') : ''

    // _applyNavBarColor dropped: navigationStyle custom + native status bar (manifest).
    // TODO(port): light/dark status-bar icon colour is set per-build in pages.json/manifest,
    // not at runtime like wx.setNavigationBarColor.

    if (isGuest) {
      const init = this._makeMsg('init', 'ai', tMainTr(baseT, 'initMsg'), null, '', '', null, null)
      this.messages = [init]
      this.obStep = ''
      this.storeLoading = true
      this._loadGuestStore(lang)
      return
    }
    this._initChat(user!, lang)
    this._loadVivaSubscriptionStatus(user!)
    this._loadDots(user!, lang)
    this._loadCartridges(user!, lang)
    // Aeviva's GCN store URL is minted lazily in switchTab (wvt is one-time/60s-TTL).
    if (!this.isAeviva) {
      this._loadStore(user!, lang)
    }
    this._loadCreditBalance(user!)
    // Restore persisted cart
    try {
      const savedCart = uni.getStorageSync('nano_cart')
      if (savedCart != null && savedCart instanceof Array) {
        this._syncCart(savedCart as UTSJSONObject[])
      }
    } catch (e : any) {}
  },

  // onShow refetches so a backgrounded user never keeps a stale view (2026-08-30 incident class);
  // onLoad's async init may not have resolved the user id yet — guarded below.
  onShow() {
    syncRootClasses(this.theme, this.textScale);
    // The page on screen owns the privacy modal; re-taken on every show, so returning from coach
    // (which registers its own) hands it back here. The miniapp only registered once, in onReady.
    setPrivacyHandler(() => { this.showPrivacyModal = true });
    (async () : Promise<void> => {
    const user = this.user
    if (user != null && !this.isGuest) {
      this._healthRefresh()
      this._startPolling(user)
      this._loadCreditBalance(user)
      // Re-checks persona_type + subscription expiry on every foreground — a subscription that
      // lapsed while backgrounded clears, and returning from the GCN store webview after a
      // "buy for myself" auto-redeem reflects the new expiry immediately.
      this._loadVivaSubscriptionStatus(user)
      if (this.obStep == 'done') this._checkForPendingQuestionnaire()

      // If a wearable sync is due (>30min stale per _maybeAutoSync's own throttle), let it finish
      // BEFORE the heartbeat marks this user active — otherwise the dispatcher's check-in scan
      // (§29) fires on stale wearable data. Capped at 90s, fail-open: a full non-incremental sync
      // chains several 8-15s BLE command timeouts. Most opens aren't due and resolve immediately.
      const syncPromise = this._healthMaybeAutoSync()
      if (syncPromise != null) {
        await new Promise<boolean>((resolve : (v : boolean) => void, _reject : (e : any | null) => void) => {
          let done = false
          const finish = () => { if (!done) { done = true; resolve(true) } }
          syncPromise!.then((_v : any) : void => { finish() }).catch((_e : any | null) : void => { finish() })
          setTimeout(() => { finish() }, 90000)
        })
      }

      const uid = user!.getString('user_id') ?? ''
      this._req(`${BASE}/api/heartbeat`, 'POST', { user_id: uid } as UTSJSONObject, 0).then((res) => {
        const phone = res.data != null ? res.data!.getString('phone') : null
        const cur = this.user
        if (phone != null && phone!.length > 0 && cur != null && cur!.getString('phone') == null) {
          const updated = new UTSJSONObject()
          cur!.toMap().forEach((v : any | null, k : string) => { updated[k] = v })
          updated['phone'] = phone
          this.user = updated
        }
        if (res.data != null) this._applyServerSession(res.data!)
      }).catch((e : any | null) => {})
    }
    })()
  },

  onHide() {
    this._stopPolling()
    this._stopKinoSlide()
  },

  onUnload() {
    this._stopTypingDots()
    this._stopPolling()
    this._stopKinoSlide()
    setPrivacyHandler(null)
  },

  // Fires because pages.json sets enablePullDownRefresh on pages/main.
  onPullDownRefresh() {
    (async () : Promise<void> => {
    const tab = this.tab
    const user = this.user
    if (user == null) { uni.stopPullDownRefresh(); return }
    const lang = this.lang
    if (tab == 'health') {
      this._healthRefresh()
    } else if (tab == 'store') {
      this.storeLoading = true
      await this._loadStore(user, lang)
    }
    uni.stopPullDownRefresh()
    })()
  },

  // Web: theme / text scale tokens live on <html> (utils/web-ui.uts syncRootClasses).
  watch: {
    theme(v : string) { syncRootClasses(v, this.textScale) },
    textScale(v : number) { syncRootClasses(this.theme, v) },
    typing(v : boolean) { if (v) this._startTypingDots(); else this._stopTypingDots() },
  },
  methods: {
    // Store-scroll refresher (a Page method in the source, not a lifecycle hook).
    async onStoreRefresh() {
      const user = this.user
      if (user == null) return
      this.storeRefreshing = true
      await this._loadStore(user, this.lang)
      this.storeRefreshing = false
    },
    // The miniapp's dot-bounce keyframes (1.2s, dots 0.2s apart) as a 200ms step timer: uvue has
    // no @keyframes on native, and a timer plus a transition looks the same on every platform.
    _startTypingDots() {
      if (this._typingTimer != 0) return
      this.typingPhase = 0
      this._typingTimer = setInterval(() => { this.typingPhase = (this.typingPhase + 1) % 6 }, 200)
    },
    _stopTypingDots() {
      if (this._typingTimer != 0) clearInterval(this._typingTimer)
      this._typingTimer = 0
    },
    // Dot i is up for two of the six steps, each one step after the dot before it.
    typingDotOn(i : number) : boolean {
      const d = (this.typingPhase - i + 6) % 6
      return d == 1 || d == 2
    },
    // The heartbeat carries the account's current channel and own coach identity (worker
    // handlePostHeartbeat). Stored at sign-in and never re-read before, so a user moved to another
    // channel in the admin panel kept the old one (dev 2026-10-03). On a change: store it and relaunch
    // once — the channel drives labels, locale, the store host and the coach entry, all set in onLoad.
    _applyServerSession(data : UTSJSONObject) {
      if (state.sandboxMode || !data.toMap().has('channel')) return
      const channel = data.getJSON('channel')
      const coach = data.getJSON('coach')
      const key = (o : UTSJSONObject | null, k : string) : string => o != null ? `${o!.get(k) ?? ''}` : ''
      const changed = key(channel, 'key_name') != key(state.channel, 'key_name')
        || key(coach, 'id') != key(state.coach, 'id')
      state.channel = channel
      state.coach = coach
      if (channel != null) uni.setStorageSync('nano_channel', channel!); else uni.removeStorageSync('nano_channel')
      if (coach != null) uni.setStorageSync('nano_coach', coach!); else uni.removeStorageSync('nano_coach')
      if (changed) uni.reLaunch({ url: '/pages/main/main' })
    },
    // ── dictionary access ──
    tr(path : string) : string { return tMainTr(this.t, path) },
    numOr(v : number | null, d : number) : number { return v != null ? v! : d },
    // Template-side array accessor — getArray<T>() inside template expressions is avoided.
    arrOf(obj : UTSJSONObject, key : string) : UTSJSONObject[] {
      const a = obj.getArray<UTSJSONObject>(key)
      return a != null ? a : ([] as UTSJSONObject[])
    },
    arrLen(obj : UTSJSONObject, key : string) : number {
      return obj.getArray<UTSJSONObject>(key)?.length ?? 0
    },
    trackActive(a : UTSJSONObject) : boolean {
      const cur = this.sleepCurrentTrack
      return cur != null && cur!.getNumber('id') == a.getNumber('id')
    },
    trackPlaying(a : UTSJSONObject) : boolean {
      return this.trackActive(a) && this.sleepPlaying
    },
    // Structural text-scale: uvue has no CSS-variable cascade, so the fs-0..3 ladder is applied
    // inline to the main text runs (TODO(port): full fs-N cascade parity with main.wxss).
    // xapp-mini has the cascade (the miniapp's --fs-N rules at the end of the style block), and an
    // inline size would override it.
    fs(size : number) : string {
      // #ifdef MP-WEIXIN
      if (size > 0) return ''
      // #endif
      const mul = 1 + (this.textScale * 0.08)
      return 'font-size:' + Math.round(size * mul) + 'px'
    },
    _avatarLetter(nickname : string | null) : string {
      const n = nickname != null && nickname!.length > 0 ? nickname! : 'U'
      return n.substring(n.length - 1).toUpperCase()
    },

    // ── user-health bridge ──
    // The miniapp reaches the health component via selectComponent('#health-comp') + method calls.
    // uni-app x: $refs on a component is its public instance — the documented typing is
    // InstanceType<typeof Comp['$component']> (a custom interface cast throws ClassCastException).
    // mp-html's tag-style has no uni-app x equivalent — merge MD_TAG_STYLE into the node html.
    _sh(h : string) : string { return inlineTagStyles(h) },
    _healthApi() : UserHealthComponentPublicInstance | null {
      const r = this.$refs['healthComp']
      if (r == null) return null
      return r as UserHealthComponentPublicInstance
    },
    _healthRefresh() {
      const c = this._healthApi()
      if (c != null) c!.refresh()
    },
    _healthRefreshIfStale(ms : number) {
      const c = this._healthApi()
      if (c != null) c!.refreshIfStale(ms)
    },
    _healthRefreshReports() {
      const c = this._healthApi()
      if (c != null) c!.refreshHealthReports()
    },
    _healthSetAvatarUpdating(v : boolean) {
      const c = this._healthApi()
      if (c != null) c!.setAvatarUpdating(v)
    },
    _healthMaybeAutoSync() : Promise<void> | null {
      const c = this._healthApi()
      if (c == null) return null
      return c!.maybeAutoSync()
    },

    // ── Tab navigation ──
    // Shared by the Store tab and the Dots subtab's "Order Dots" button — both need the same
    // phone/email-verification gate before minting a wvt nobody can use (handleNanoSSO hard-
    // requires a verified identity). A verified email satisfies the gate on waven-tree channels.
    async _openAevivaStoreGated(context : UTSJSONObject | null) {
      const idv = await this._checkIdentityVerified()
      const verified = idv.phone || (idv.email && this.emailLoginAllowed)
      if (!verified) {
        const zh = this.lang == 'zh'
        uni.showModal({
          title: zh ? (this.emailLoginAllowed ? '需要验证手机号或邮箱' : '需要验证手机号') : (this.emailLoginAllowed ? 'Verification needed' : 'Phone verification needed'),
          content: zh
            ? (this.emailLoginAllowed ? '进入商城前，请先验证您的手机号码或邮箱' : '进入商城前，请先验证您的手机号码')
            : (this.emailLoginAllowed ? 'Please verify your phone number or email before entering the store.' : 'Please verify your phone number before entering the store.'),
          confirmText: zh ? '去验证' : 'Verify',
          cancelText: zh ? '取消' : 'Cancel',
          success: (r) => {
            if (r.confirm) uni.navigateTo({ url: '/pages/verify-phone/verify-phone' })
          },
        })
        return
      }
      this._openAevivaStore(context)
    },

    // Scan the Dots box you received — this is what starts a Viva AG formulation's 28-day cycle
    // (day 1 = the day the capsules are actually in hand). uni.scanCode returns whatever the QR
    // encodes (box code itself, or the public page URL containing it); the server accepts either.
    handleScanBox() {
      const user = this.user
      if (user == null) return
      const uid = user!.getString('user_id') ?? ''
      if (uid.length == 0) return
      setScanTitle(this.tr('scanBoxTitle'))
      scanQr({
        onlyFromCamera: false,
        success: (res) => { (async () : Promise<void> => {
          uni.showLoading({ title: this.tr('scanBoxWorking'), mask: true })
          try {
            const r = await this._req(`${BASE}/api/box-claim`, 'POST', { openid: uid, box_code: res.result } as UTSJSONObject, 0)
            uni.hideLoading()
            const d = r.data
            if (d != null && d!.getBoolean('success') == true) {
              // A second scan of an already-claimed box is not an error — say so plainly.
              uni.showToast({ title: d!.getBoolean('already_claimed') == true ? this.tr('scanBoxAlready') : this.tr('scanBoxOk'), icon: 'none', duration: 2500 })
              this._loadDots(user!, this.lang)
            } else {
              const reason = d != null ? (d!.getString('reason') ?? '') : ''
              uni.showModal({
                title: this.tr('scanBoxFailTitle'),
                content: this._dynT('scanBoxErr_' + reason, this.tr('scanBoxErrGeneric')),
                showCancel: false,
                confirmText: this.tr('gotIt'),
              })
            }
          } catch (e : any) {
            uni.hideLoading()
            uni.showToast({ title: this.tr('scanBoxErrGeneric'), icon: 'none' })
          }
        })() },
        // Silent on cancel — backing out of the camera is not a failure.
        fail: (_) => {}
      })
    },

    // dynamic-key lookup with an explicit fallback ('' means the key is missing → use fb).
    _dynT(key : string, fb : string) : string {
      const v = this.t.getString(key)
      return v != null && v!.length > 0 ? v! : (tMainTr(this.t, key) != key ? tMainTr(this.t, key) : fb)
    },

    // The Dots subtab's order card. There is no longer a second card opening the store with no
    // plan id — once a formula exists the package row names it; before one exists this makes it.
    // Runs the same 营养定制 tool the chat toolbox does. Mirrors handleAgGoToChat: land on chat
    // first, then act, so the tool's bubbles are on screen as they arrive.
    handleGoFormulate() {
      if (this.isGuest || this.user == null) return
      this.tab = 'chat'
      this.toolboxOpen = false
      // Same guard handleToolAction uses: a turn already in flight owns the chat; landing on the
      // tab still helps — whatever is running is what the user wanted to see.
      if (this.typing || this.obStep != 'done') return
      this._startFormulaDots(new ToolOpts())
    },

    async switchTab(tab : string) {
      if (tab == 'store' && !this.isGuest) {
        // A GCN-storefront channel opens the store as a separate navigated page (pages/appview)
        // rather than an inline tab section. Don't change `tab` at all.
        if (this.isAeviva) {
          await this._openAevivaStoreGated(null)
          return
        }
      }
      this.tab = tab
      const STALE_MS = 30000
      const now = Date.now()
      const user = this.user
      if (tab == 'health') {
        this._healthMaybeAutoSync()
        // The health tab is the Digital Twin and chat writes into it (remember_fact,
        // record_weight, report uploads) — without this it only ever showed attach-time state.
        this._healthRefreshIfStale(STALE_MS)
      }
      if (tab == 'plans' && user != null) {
        if (now - this._plansLoadedAt > STALE_MS) {
          this.plansLoading = true
          this.remindersLoading = true
          this._loadPlans(user, this.lang)
          this._loadReminders(user)
        }
        if (now - this._dotsLoadedAt > STALE_MS) {
          this.dotsLoading = true
          this.cartridgesLoading = true
          this._loadDots(user, this.lang)
          this._loadCartridges(user, this.lang)
        }
      }
      if (tab == 'learn') {
        if (this.learnSubTab == 'academy' && this.trainingCourses.length == 0) this._loadAcademy()
        if (this.learnSubTab == 'wellness' && this.wellnessAssets.length == 0) this._loadWellness()
      }
    },

    // ── 兑换码 sheet (Plans ▸ Dots) ──
    // Redeeming in-app instead of GCN's store webview. The list only holds codes bought in-app;
    // manual entry is the path for every code a store handed over in person.
    handleUseCode(code : string, max : number | null, name : string) {
      if (!this.isAeviva || code.length == 0) return
      this._openCodeSheet(code, false, max, name, '')
    },

    handleManualCode() {
      if (!this.isAeviva) return
      this._openCodeSheet('', true, null, '', '')
    },

    _openCodeSheet(code : string, manual : boolean, max : number | null, name : string, planId : string) {
      const user = this.user
      this.codeSheetOpen = true
      // Named explicitly by the chat card, which knows its own plan; null from the Dots subtab,
      // where submitFormulationRedeem resolves it from the proposal row instead.
      this.codeSheetPlanId = planId
      this.codeSheetManual = manual
      this.codeSheetCode = code
      this.codeSheetMax = max
      this.codeSheetName = name
      this.codeSheetError = ''
      this.codeSheetBusy = false
      this.codeShipName = this.codeShipName.length > 0 ? this.codeShipName : (user != null ? (user!.getString('nickname') ?? '') : '')
      this.codeShipPhone = this.codeShipPhone.length > 0 ? this.codeShipPhone : (user != null ? (user!.getString('phone') ?? '') : '')
      // Offer the address book only when there is nothing to keep — re-opening the picker over an
      // address the user already typed would be the one thing they cannot undo here.
      if (this.codeShipAddress.trim().length == 0) this.fetchWechatAddress('codeShip')
    },

    closeCodeSheet() {
      if (this.codeSheetBusy) return
      this.codeSheetOpen = false
      this.codeSheetError = ''
    },

    clearCodeError() { this.codeSheetError = '' },
    clearVivaRedeemError() { this.vivaRedeemError = '' },

    async submitFormulationRedeem() {
      const user = this.user
      if (this.codeSheetBusy || user == null) return
      const code = this.codeSheetCode.trim()
      if (code.length == 0) { this.codeSheetError = this.tr('codeRequired'); return }
      const name = this.codeShipName.trim()
      const phone = this.codeShipPhone.trim()
      const address = this.codeShipAddress.trim()
      if (name.length == 0 || phone.length == 0 || address.length == 0) { this.codeSheetError = this.tr('codeShippingRequired'); return }

      // A code is single-use, so what it will actually compound is worth saying before it is spent.
      // A laddered proposal (6/ +2 /+2) has a version for every tier sold — the honest message is
      // WHICH version this code compounds. The old over-tier warning stays reachable for pre-ladder
      // proposals (proposedTierWidths null), which were capped by nothing.
      const lang = this.lang
      const max = this.codeSheetMax
      const widths = this.proposedTierWidths
      const distinct = this.proposedDistinctDots
      let fitsMax = 0
      if (widths != null && max != null) {
        for (const w of widths!) { if (w <= max!) { if (w > fitsMax) fitsMax = w } }
      }
      const overTier = max != null && distinct != null && distinct! > max!
      let confirmText = this.tr('codeConfirm')
      if (fitsMax > 0 && max != null) confirmText = codeTierMatch(lang, fitsMax, max!)
      else if (overTier && max != null && distinct != null) confirmText = codeOverTier(lang, distinct!, max!)
      const ok = await new Promise<boolean>((resolve : (v : boolean) => void) => {
        uni.showModal({
          title: this.tr('codeSheetTitle'), content: confirmText,
          confirmText: this.tr('codeSubmitBtn'), cancelText: this.tr('codeCancel'),
          success: (r) => { resolve(r.confirm) }, fail: (_) => { resolve(false) },
        })
      })
      if (!ok) return

      this.codeSheetBusy = true
      this.codeSheetError = ''
      try {
        // Advisory plan_id: GCN carries it back through its payment notify where
        // _settleFastTrackPackage decides whether it can actually be used. Nothing is bound here.
        let planIdArg : any | null = this.codeSheetPlanId.length > 0 ? parseInt(this.codeSheetPlanId) : null
        if (planIdArg == null) {
          const proposed = this.packages.find((p) : boolean => p.getString('stage') == 'proposed')
          planIdArg = proposed != null ? proposed!.getNumber('plan_id') : null
        }
        const body = {
          openid: user!.getString('user_id'), code: code,
          plan_id: planIdArg,
          shipping_name: name, shipping_phone: phone, shipping_address: address,
        } as UTSJSONObject
        const res = await this._req(`${BASE}/api/formulation-redeem`, 'POST', body, 30000)
        const d = res.data
        // Sandbox preview: the request never reached the handler, but it answers success:true —
        // say so rather than toasting a redemption that did not happen.
        if (d != null && d!.getBoolean('sandbox') == true) {
          this.codeSheetBusy = false
          this.codeSheetError = this.tr('codeSandbox')
          return
        }
        if (d == null || d!.getBoolean('success') != true) {
          const reason = d != null ? (d!.getString('reason') ?? '') : ''
          // The store account is only linked by the SSO exchange — offer the webview once; that
          // path links it and can redeem there and then.
          if (reason == 'nano_identity_not_linked' || /nano identity not linked/i.test(reason)) {
            this.codeSheetBusy = false
            this.codeSheetOpen = false
            uni.showModal({
              title: this.tr('codeLinkTitle'), content: this.tr('codeLinkDetail'),
              confirmText: this.tr('gotIt'), cancelText: this.tr('codeCancel'),
              success: (r) => { if (r.confirm) this._openAevivaStoreGated({ intent: 'redeem_formulation_code' } as UTSJSONObject) },
            })
            return
          }
          this.codeSheetBusy = false
          this.codeSheetError = this._dynT('codeErr_' + reason, this.tr('codeErrGeneric'))
          return
        }
        this.codeSheetOpen = false
        this.codeSheetBusy = false
        this.codeSheetCode = ''
        uni.showToast({
          title: d!.getBoolean('pending_confirmation') == true ? this.tr('codePending') : this.tr('codeOk'),
          icon: 'none', duration: 3000,
        })
        // Force a refetch: the code left the list and a package took its place.
        this._dotsLoadedAt = 0
        this._loadDots(user!, this.lang)
      } catch (err : any) {
        this.codeSheetBusy = false
        this.codeSheetError = this.tr('codeErrGeneric')
      }
    },

    // Tapping a row of the :::product card (§37). A native tap handler is mandatory — chat prose
    // cannot open an external link; GCN's dashboard.html owns the ?sku= opener.
    handleProductCardTap(skuId : string) {
      if (!this.isAeviva || skuId.length == 0) return
      this._openAevivaStoreGated({ intent: 'view_product', sku_id: skuId } as UTSJSONObject)
    },

    // Tapping a row of the :::grocery card (§46): the supermarket's app has no verifiable deep
    // link, so the row's one job is copying the exact product name.
    handleGroceryCardTap(name : string, supplier : string) {
      if (name.length == 0) return
      const msg = this.tr('groceryCopied').split('{supplier}').join(supplier)
      uni.setClipboardData({
        data: name,
        success: () => { uni.showToast({ title: msg, icon: 'none', duration: 2500 }) },
        fail: () => { uni.showToast({ title: name, icon: 'none' }) },
      })
    },

    // ── 打卡 program cards (AGENTS §42) ──
    // Stamps done-state onto lesson/checkin segments from _programLessons/_programDays (GET
    // /api/programs/my). In place; reports whether anything changed so callers can re-render.
    _attachProgramState(segments : Segment[]) : boolean {
      let changed = false
      for (const seg of segments) {
        if (seg.t == 'lesson') {
          const done = this._programLessons.get(seg.lessonId) == true
          if (seg.lessonDone != done) { seg.lessonDone = done; changed = true }
        } else if (seg.t == 'checkin') {
          const d = this._programDays.get(`${seg.checkinProgramId}:${seg.checkinDayIndex}`)
          const done = d != null && d!.checkinDone
          const lessonDone = d == null ? true : d!.lessonDone
          // Tappable only while the day is offered and its 打卡 is still open; a card from a day
          // the server never offered (or a sandbox preview) stays inert.
          const active = d != null && !d!.checkinDone
          if (seg.checkinDone != done) { seg.checkinDone = done; changed = true }
          if (seg.checkinLessonDone != lessonDone) { seg.checkinLessonDone = lessonDone; changed = true }
          if (seg.checkinActive != active) { seg.checkinActive = active; changed = true }
        }
      }
      return changed
    },

    // Re-reads program state and patches only the segments whose flags changed. Called after
    // history loads, when a program_day* notification lands, after a lesson ends, and after a
    // program questionnaire completes — never on a timer of its own.
    async _refreshProgramState() {
      const user = this.user
      if (user == null) return
      try {
        const res = await this._req(`${BASE}/api/programs/my?openid=${encodeURIComponent(user!.getString('user_id') ?? '')}`, 'GET', null, 0)
        const enrollments = res.data != null ? (res.data!.getArray<UTSJSONObject>('enrollments') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        const lessons = new Map<string, boolean>()
        const days = new Map<string, DayFlag>()
        for (const e of enrollments) {
          const programId = `${e.getNumber('program_id')}`
          const dayArr = e.getArray<UTSJSONObject>('days') ?? ([] as UTSJSONObject[])
          for (const d of dayArr) {
            const flag = new DayFlag()
            flag.checkinDone = d['checkin_completed_at'] != null
            const lessonId = d.getString('lesson_id')
            flag.lessonDone = lessonId == null || d['lesson_completed_at'] != null
            flag.completed = d['completed_at'] != null
            days.set(`${programId}:${d.getNumber('day_index')}`, flag)
            if (lessonId != null && d['lesson_completed_at'] != null) lessons.set(lessonId!, true)
          }
        }
        this._programLessons = lessons
        this._programDays = days
        let changed = false
        for (const m of this.messages) {
          if (m.segments.length > 0 && this._attachProgramState(m.segments)) changed = true
        }
        if (changed) this.messages = [...this.messages]
      } catch (e : any) { if (IS_DEV) console.error('program state refresh failed', e) }
    },

    // 观看课程 on a :::lesson card: fresh presigned URL, mounted inline. Only ONE native <video>
    // stays alive in the transcript at a time — any other card's url is cleared first.
    async handleLessonCardTap(m : ChatMsg, si : number) {
      const user = this.user
      const seg = si < m.segments.length ? m.segments[si] : null
      if (user == null || seg == null || seg!.t != 'lesson' || seg!.lessonLoading) return
      for (const om of this.messages) {
        for (const osg of om.segments) {
          if (osg.t == 'lesson' && osg.lessonUrl.length > 0) osg.lessonUrl = ''
        }
      }
      seg!.lessonLoading = true
      this.messages = [...this.messages]
      const lesson = seg!.lessonId
      try {
        const res = await this._req(`${BASE}/api/programs/lesson-url?openid=${encodeURIComponent(user!.getString('user_id') ?? '')}&lesson_id=${encodeURIComponent(lesson)}`, 'GET', null, 0)
        const d = res.data
        if (d == null || d!.getBoolean('success') != true || d!.getString('url') == null) throw new Error(d != null ? (d!.getString('error') ?? 'no url') : 'no url')
        seg!.lessonUrl = d!.getString('url')!
        const poster = d!.getString('poster_url')
        seg!.lessonPoster = poster != null ? poster! : ''
        seg!.lessonLoading = false
        // Watch-time accounting starts from what the server already knows (a previous session's
        // partial watch), so the min_watch_seconds gate accumulates across sessions.
        const w = new LessonWatch()
        w.seconds = d!.getNumber('watched_seconds') ?? 0
        w.min = d!.getNumber('min_watch_seconds') ?? 0
        w.reported = w.seconds
        this._lessonWatch.set(lesson, w)
        this.messages = [...this.messages]
      } catch (err : any) {
        seg!.lessonLoading = false
        this.messages = [...this.messages]
        uni.showToast({ title: this.tr('programLessonUnavailable'), icon: 'none' })
      }
    },

    // Watch-time accounting: bindended alone is NOT evidence of watching (a seek to the end fires
    // it), so the card accumulates real playback seconds from timeupdate (a delta > 1.5s is a seek
    // and is not counted) and reports them on every pause and on end. The server merges with
    // GREATEST and stamps the day only once min_watch_seconds is reached.
    onLessonTimeUpdate(m : ChatMsg, si : number, e : any | null) {
      const seg = si < m.segments.length ? m.segments[si] : null
      if (seg == null) return
      const id = seg!.lessonId
      const t = e != null ? (e as UniVideoTimeUpdateEvent).detail.currentTime : NaN
      if (id.length == 0 || isNaN(t)) return
      let w = this._lessonWatch.get(id)
      if (w == null) { w = new LessonWatch(); this._lessonWatch.set(id, w) }
      if (w!.last >= 0) {
        const d = t - w!.last
        if (d > 0 && d <= 1.5) w!.seconds += d
      }
      w!.last = t
    },

    async onLessonPause(m : ChatMsg, si : number) {
      const seg = si < m.segments.length ? m.segments[si] : null
      if (seg == null) return
      const id = seg!.lessonId
      const w = this._lessonWatch.get(id)
      if (w != null) w!.last = -1
      const r = await this._reportLessonWatch(id)
      // A pause can be the report that crosses min_watch_seconds — refresh so ✓ 已观看 appears
      // without waiting for the end.
      if (r != null && r!.getString('skipped') != 'yes') this._refreshProgramState()
    },

    // Same write the Academy tab's ✓ button makes (POST /api/academy/progress) plus the seconds
    // actually watched. Always POSTs (idempotent server-side) — unlike _doMarkComplete, which
    // skips once a lesson is completed and would never carry a later, longer watch time.
    async _reportLessonWatch(lessonId : string) : Promise<UTSJSONObject | null> {
      const user = this.user
      const w = this._lessonWatch.get(lessonId)
      if (user == null || lessonId.length == 0) return null
      const seconds = Math.round(w != null ? w!.seconds : 0)
      if (w != null && seconds <= w!.reported && w!.reported > 0) {
        const skipped = new UTSJSONObject(); skipped['skipped'] = 'yes'; return Promise.resolve(skipped)
      }
      try {
        const res = await this._req(`${BASE}/api/academy/progress`, 'POST', {
          user_id: user!.getString('user_id'), lesson_id: parseInt(lessonId), time_spent_seconds: seconds,
        } as UTSJSONObject, 0)
        if (w != null) w!.reported = seconds
        const lid = parseInt(lessonId)
        if (this.trainingCompletedIds.indexOf(lid) < 0) this.trainingCompletedIds = this.trainingCompletedIds.concat([lid])
        return res.data
      } catch (e : any) { return null }
    },

    async handleLessonEnded(m : ChatMsg, si : number) {
      const seg = si < m.segments.length ? m.segments[si] : null
      if (seg == null) return
      const lessonId = parseInt(seg!.lessonId)
      if (isNaN(lessonId) || lessonId == 0) return
      const w = this._lessonWatch.get(seg!.lessonId)
      if (w != null) w!.last = -1
      await this._reportLessonWatch(seg!.lessonId)
      await this._refreshProgramState()
      // Not stamped: the lesson sets a threshold the watch time hasn't reached yet.
      if (w != null && w!.min > 0 && Math.round(w!.seconds) < w!.min && this._programLessons.get(seg!.lessonId) != true) {
        uni.showToast({ title: programLessonTooShort(this.lang, Math.max(1, w!.min - Math.round(w!.seconds))), icon: 'none', duration: 2500 })
      }
    },

    // 开始打卡: ask the server for today's questionnaire assignment (created on demand — see
    // handlers/programs.js for why never earlier), then start it through the ordinary pending-
    // questionnaire flow. No questionnaire_ready notification is involved, so nothing else can
    // start the same form a second time.
    async handleCheckinStart(program : string, day : string) {
      const user = this.user
      if (user == null || program.length == 0 || day.length == 0 || this.typing || this.obStep != 'done') return
      try {
        const res = await this._req(`${BASE}/api/programs/day/start-checkin`, 'POST', {
          openid: user!.getString('user_id'), program_id: parseInt(program), day_index: parseInt(day),
        } as UTSJSONObject, 0)
        const d = res.data
        if (d == null || d!.getBoolean('success') != true) {
          uni.showToast({ title: d != null ? (d!.getString('error') ?? this.tr('errServer')) : this.tr('errServer'), icon: 'none' })
          return
        }
        // done: a day with no form completed on tap. sandbox: the preview short-circuit returns
        // no assignment — nothing to start.
        if (d!.getBoolean('done') == true || d!.getBoolean('sandbox') == true) { this._refreshProgramState(); return }
        await this._checkForPendingQuestionnaire()
      } catch (err : any) {
        uni.showToast({ title: this.tr('errServer'), icon: 'none' })
      }
    },

    // ── :::formula card CTAs ──
    // What the card's call-to-action should say and do for ONE package. The CTA follows the
    // package the user has OPEN. EXACT tier match, deliberately: a wider code compounds ITS OWN
    // variant, so offering 开始配制 on a narrower package while holding a wider code would
    // compound a formula other than the one on screen. Returns null for a card with no packages
    // (legacy, or a user who already holds one) — the generic redeem CTA then renders.
    _formulaCtaFor(tier : UTSJSONObject | null) : UTSJSONObject | null {
      const t = this.t
      const lang = this.lang
      if (tier == null) return null
      const width = tier!.getNumber('width') ?? 0
      const label = tier!.getString('label') ?? ''
      if (!(width > 0) || label.length == 0) return null
      // An unpaid order for this tier: sending them to buy it again is a dead end (GCN refuses
      // with formulation_already_in_progress) — the honest CTA is Plans ▸ Dots' own pay action.
      let unpaidOrderId = ''
      for (const p of this.packages) {
        if (p.getString('stage') == 'pending_payment' && p.getString('order_id') != null && (p.getNumber('max_distinct_dots') ?? 0) == width) {
          unpaidOrderId = p.getString('order_id') ?? ''
          break
        }
      }
      if (unpaidOrderId.length > 0) {
        return {
          mode: 'pay', owned: formulaOrderedPkg(lang, label), btn: tMainTr(t, 'pkgPayBtn'),
          code: '', max: null, orderId: unpaidOrderId, label: label, width: width,
        } as UTSJSONObject
      }
      let held : UTSJSONObject | null = null
      for (const c of this.codes) {
        if (c.getBoolean('fastTrack') == true && (c.getNumber('max_distinct_dots') ?? 0) == width) { held = c; break }
      }
      if (held != null) {
        const heldMax = held!.getNumber('max_distinct_dots')
        return {
          mode: 'redeem', owned: formulaOwnedPkg(lang, label), btn: tMainTr(t, 'formulaStartCta'),
          code: held!.getString('code'), max: heldMax != null && heldMax! > 0 ? heldMax : width,
          orderId: '', label: label, width: width,
        } as UTSJSONObject
      }
      return { mode: 'buy', owned: '', btn: formulaBuyPkgCta(lang, label), code: '', max: null, orderId: '', label: label, width: width } as UTSJSONObject
    },

    // Recomputes every formula card's CTA in place. Cheap and idempotent, so it runs whenever
    // either input changes: the card is built, a package is opened, or codes finish loading.
    // Stored in _segCtas (Segment is a frozen class in utils/markdown.uts — no cta field).
    _attachFormulaCta(m : ChatMsg) {
      for (let si = 0; si < m.segments.length; si++) {
        const seg = m.segments[si]
        if (seg.t != 'formula' || seg.formulaTiers.length == 0) continue
        let openTier : UTSJSONObject | null = null
        const tierJsons : UTSJSONObject[] = []
        for (const tr of seg.formulaTiers) {
          tierJsons.push({ label: tr.label, width: tr.width, open: tr.open, recommended: tr.recommended } as UTSJSONObject)
        }
        for (const tj of tierJsons) { if (tj.getBoolean('open') == true) { openTier = tj; break } }
        if (openTier == null && tierJsons.length > 0) openTier = tierJsons[0]
        const cta = this._formulaCtaFor(openTier)
        if (cta != null) { this._segCtas.set(`${m.id}:${si}`, cta!) } else { this._segCtas.delete(`${m.id}:${si}`) }
      }
    },

    // Re-runs the above across the whole transcript after _loadDots resolves — a card delivered
    // before the codes list arrived would otherwise offer to BUY a package the user already holds
    // a code for.
    _refreshFormulaCtas() {
      let touched = false
      for (const m of this.messages) {
        if (m.segments.some((s) : boolean => s.t == 'formula')) { this._attachFormulaCta(m); touched = true }
      }
      if (touched) this.messages = [...this.messages]
    },

    // Template accessors for the CTA stored outside the Segment.
    segCta(m : ChatMsg, si : number) : UTSJSONObject | null {
      return this._segCtas.get(`${m.id}:${si}`) ?? null
    },
    segCtaOwned(m : ChatMsg, si : number) : string {
      const cta = this.segCta(m, si)
      if (cta == null) return ''
      return cta!.getString('owned') ?? ''
    },
    segCtaBtn(m : ChatMsg, si : number, seg : Segment) : string {
      const cta = this.segCta(m, si)
      const btn = cta != null ? (cta!.getString('btn') ?? '') : ''
      return btn.length > 0 ? btn : this.tr('formulaOrderCta')
    },

    // Opens one package on a :::formula card and closes whichever was open — a radio, not a
    // checkbox (two open charts in one bubble is the stacked layout collapsing exists to avoid).
    // Addressed by message + segment + tier index because the flag lives on the parsed segment:
    // a transcript can hold several formula cards, each remembering its own open package.
    handleFormulaTierToggle(m : ChatMsg, si : number, ti : number) {
      if (si >= m.segments.length) return
      const seg = m.segments[si]
      const tiers = seg.formulaTiers
      if (ti >= tiers.length) return
      // A single package is the whole card (legacy, or a user who already holds one); collapsing
      // it would leave the bubble with nothing in it.
      if (tiers.length < 2) return
      let openIdx = -1
      for (let i = 0; i < tiers.length; i++) {
        const open = i == ti ? !tiers[i].open : false
        tiers[i].open = open
        if (open && openIdx < 0) openIdx = i
      }
      // The CTA belongs to whichever package is now open — it moves with the selection rather
      // than being recomputed by the handler that acts on it.
      const ctaKey = `${m.id}:${si}`
      const cta = openIdx >= 0
        ? this._formulaCtaFor({ label: tiers[openIdx].label, width: tiers[openIdx].width, open: true, recommended: tiers[openIdx].recommended } as UTSJSONObject)
        : null
      if (cta != null) { this._segCtas.set(ctaKey, cta!) } else { this._segCtas.delete(ctaKey) }
      this.messages = [...this.messages]
    },

    // The order CTA on a :::formula card in chat. A 28-day package is bought with a prepaid REDEEM
    // CODE (§28e) — no payment step. It opens the in-app sheet, which can also list owned codes;
    // the webview stays reachable through the nano_identity_not_linked fallback, the one case that
    // genuinely needs it.
    async handleFormulaOrder(m : ChatMsg, si : number) {
      if (si >= m.segments.length) return
      const seg = m.segments[si]
      const planId = seg.planId
      const user = this.user
      if (!this.isAeviva || user == null) return
      // Chat can be reached without the Dots subtab ever having loaded; both the code list and the
      // over-tier warning come from that fetch. Without it a user could spend a code on a formula
      // wider than it covers with no warning — the one thing this sheet exists to prevent.
      if (this.proposedDistinctDots == null) {
        try { await this._loadDots(user, this.lang) } catch (err : any) { /* the sheet still works unwarned */ }
      }
      const cta = this.segCta(m, si)
      if (cta == null) {
        this._fallbackOrderCta(planId)
        return
      }
      const mode = cta!.getString('mode') ?? ''
      const code = cta!.getString('code') ?? ''
      const max = cta!.getNumber('max')
      const label = cta!.getString('label') ?? ''
      const width = cta!.getNumber('width') ?? 0
      const orderId = cta!.getString('orderId') ?? ''

      // Holds a code for exactly this package: prefill THAT code against THIS formula. The sheet
      // still collects shipping and still confirms — prefilled, not skipped.
      if (mode == 'redeem' && code.length > 0) {
        this._openCodeSheet(code, false, max, label, planId)
        return
      }
      // Ordered but unpaid: land on that order's payment QR, not a second checkout.
      if (mode == 'pay' && orderId.length > 0) {
        this._openAevivaStoreGated({ intent: 'pay_order', order_id: orderId } as UTSJSONObject)
        return
      }
      // No code for this package — hand GCN the WIDTH and let it resolve which sku that is; nano
      // deliberately holds no sku ids (§28c: a stale client-side sku broke both checkouts 2026-08-22,
      // and this card is a stored chat message that would freeze one for good).
      if (mode == 'buy' && width > 0) {
        this._openAevivaStoreGated({
          intent: 'buy_formulation_package',
          max_distinct_dots: width,
          nutrition_plan_id: planId.length > 0 ? parseInt(planId) : null,
        } as UTSJSONObject)
        return
      }
      this._fallbackOrderCta(planId)
    },

    // Legacy card, or a package list that never resolved. Someone who already owns codes should
    // tap one, not retype — the list only exists on Plans ▸ Dots, so land them there. NOTE: the
    // sub-tab key is plansDotsSubTab, NOT tab:'dots' (matches no WXML block, blank page — real
    // device report 2026-07-29).
    _fallbackOrderCta(planId : string) {
      if (this.codes.length > 0) {
        this.tab = 'plans'
        this.plansDotsSubTab = 'dots'
        return
      }
      this._openCodeSheet('', true, null, '', planId)
    },

    // The confirm CTA on a :::formula card, shown only when GCN reported a paid FAST-TRACK package
    // waiting to be formulated. Fast track = no expert review before compounding, so the formula
    // is fixed at this tap — hence explicit confirm. The server re-checks independently; this
    // handler never assumes the card is current.
    async handleFormulaSubmit(m : ChatMsg, si : number) {
      if (si >= m.segments.length) return
      const planId = m.segments[si].planId
      const user = this.user
      if (!this.isAeviva || planId.length == 0 || user == null) return
      if (this._formulaSubmitting) return

      // Confirm first, then ask which package — agreeing to compound is the bigger decision, and
      // this keeps the single-package flow byte-identical to what it was before a picker existed.
      const confirmed = await new Promise<boolean>((resolve : (v : boolean) => void) => {
        uni.showModal({
          title: this.tr('formulaSubmitConfirmTitle'),
          content: this.tr('formulaSubmitConfirmBody'),
          success: (r) => { resolve(r.confirm) }, fail: (_) => { resolve(false) },
        })
      })
      if (!confirmed) return

      // Which package? Resolved NOW, not from the card: the formulation turn is async, so this
      // card may be minutes old — an order can have been refunded, or a second confirmed, since.
      const pick = await this._pickAwaitingOrder()
      if (pick.cancelled) return
      await this._submitFormulation(planId, pick.orderId, (msg : string) => { this._addMsg('ai', msg, true) })
    },

    // The Dots subtab's own submit. The package row already names its order, so there is nothing
    // to pick — tapping the row IS the choice. Reports through a modal, not a chat bubble: the
    // user is not on the chat tab.
    async handlePackageSubmit(orderId : string, planId : string) {
      const user = this.user
      if (!this.isAeviva || planId.length == 0 || orderId.length == 0 || user == null) return
      if (this._formulaSubmitting) return
      const confirmed = await new Promise<boolean>((resolve : (v : boolean) => void) => {
        uni.showModal({
          title: this.tr('formulaSubmitConfirmTitle'),
          content: this.tr('pkgSubmitConfirm'),
          success: (r) => { resolve(r.confirm) }, fail: (_) => { resolve(false) },
        })
      })
      if (!confirmed) return
      const ok = await this._submitFormulation(planId, orderId.length > 0 && orderId != 'null' ? orderId : null,
        (msg : string) => { uni.showModal({ title: '', content: msg, showCancel: false }) })
      if (ok) {
        uni.showToast({ title: this.tr('pkgSubmitOk'), icon: 'success' })
        // The package moved to 'compounding' on GCN's side; repaint so the row stops offering an
        // action that has already been taken.
        this._dotsLoadedAt = 0
        this._loadDots(user, this.lang)
      }
    },

    // 待付款 → the GCN order, with its payment QR already open. Payment is a manual scan-and-upload
    // flow on GCN's side, so the whole job is landing the user on the right screen.
    // Deploy GCN first: an older dashboard.html doesn't recognise 'pay_order' and falls through to
    // its normal mall load (a store landing rather than a failure).
    handlePackagePay(orderId : string) {
      if (orderId.length == 0 || orderId == 'null' || !this.isAeviva) return
      this._openAevivaStoreGated({ intent: 'pay_order', order_id: orderId } as UTSJSONObject)
    },

    // Returns the chosen order_id, null when nothing is waiting (the server says so
    // authoritatively and its message is the one the user sees), or cancelled=true.
    async _pickAwaitingOrder() : Promise<PickerResult> {
      const user = this.user
      const result = new PickerResult()
      if (user == null) return result
      let packages : UTSJSONObject[] = []
      try {
        const res = await this._req(`${BASE}/api/formulation-orders?openid=${encodeURIComponent(user!.getString('user_id') ?? '')}`, 'GET', null, 0)
        const arr = res.data != null ? (res.data!.getArray<UTSJSONObject>('packages') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        for (const p of arr) { if (p.getBoolean('can_submit') == true && p.getString('order_id') != null) packages.push(p) }
      } catch (err : any) {
        // Fall through with no id: the submit below re-resolves server-side and picks the oldest,
        // exactly as before a picker existed. A lookup failure must not block the action.
        return result
      }
      if (packages.length <= 1) {
        result.orderId = packages.length == 1 ? (packages[0].getString('order_id')) : null
        return result
      }
      const t = this.t
      const lang = this.lang
      const labels : string[] = packages.map((p) : string => {
        // Same title the Dots subtab shows, plus the width — the picker is where two packages are
        // hardest to tell apart, so it's the one place worth spelling out both.
        const width = (p.getNumber('max_distinct_dots') ?? 0) > 0 ? pkgTierUpTo(lang, p.getNumber('max_distinct_dots')!) : ''
        const name = pkgTitle(p, tMainTr(t, 'pkgUnnamed'))
        return width.length > 0 ? `${name} · ${width}` : name
      })
      return await new Promise<PickerResult>((resolve : (r : PickerResult) => void) => {
        uni.showActionSheet({
          itemList: labels,
          success: (r) => {
            const pr = new PickerResult()
            pr.orderId = packages[r.tapIndex].getString('order_id')
            resolve(pr)
          },
          fail: (_) => { const pr = new PickerResult(); pr.cancelled = true; resolve(pr) },
        })
      })
    },

    // The ONE submit path — shared by the chat card and the Dots subtab so the two surfaces can
    // never disagree about what a reason code means. `report` is how each surface talks to its
    // own user. Returns true only on a real success.
    async _submitFormulation(planId : string, orderId : string | null, report : (msg : string) => void) : Promise<boolean> {
      const user = this.user
      if (user == null) return false
      this._formulaSubmitting = true
      uni.showLoading({ title: this.tr('formulaSubmitCta'), mask: true })
      try {
        const body = { openid: user!.getString('user_id'), plan_id: parseInt(planId) } as UTSJSONObject
        if (orderId != null && orderId!.length > 0) body['order_id'] = orderId
        const res = await this._req(`${BASE}/api/formulation-submit`, 'POST', body, 0)
        const d = res.data
        if (d != null && d!.getBoolean('success') == true) { report(this.tr('formulaSubmitOk')); return true }
        // Named reasons the user can act on get their own message; everything else is a retry.
        const reason = d != null ? (d!.getString('reason') ?? '') : ''
        if (reason == 'no_awaiting_order') report(this.tr('formulaSubmitNoOrder'))
        // The package moved on between the picker and the tap — not a failure of their formula,
        // so it must not read like one.
        else if (reason == 'order_not_available') report(this.tr('pkgOrderGone'))
        else if (reason == 'order_requires_expert_review') report(this.tr('formulaSubmitExpert'))
        else if (reason == 'formulation_exceeds_package') report(this.tr('formulaSubmitOverTier'))
        else report(this.tr('formulaSubmitFailed'))
        return false
      } catch (err : any) {
        report(this.tr('formulaSubmitFailed'))
        return false
      } finally {
        uni.hideLoading()
        this._formulaSubmitting = false
      }
    },

    handleCopyPackageTracking(num : string) {
      if (num.length == 0 || num == 'null') return
      uni.setClipboardData({
        data: num,
        success: () => { uni.showToast({ title: this.lang == 'zh' ? '单号已复制' : 'Tracking copied', icon: 'success' }) },
      })
    },

    // Raised by the AG panel (via user-health) when a job is parked waiting on a clarifying
    // questionnaire — one server-driven renderer for every questionnaire, so this lands the user
    // on chat and asks it to start. Guard matters MORE here than anywhere else: the
    // questionnaire_ready notification has usually started the form already by tap time, so an
    // unguarded call duplicated almost every time (live end-to-end find). `obStep` and NOT
    // `obQuestion` — _onAllQuestionnaireDone sets obStep 'done' but leaves obQuestion populated.
    handleAgGoToChat() {
      this.tab = 'chat'
      const formInProgress = this.obStep.length > 0 && this.obStep != 'done'
      if (!formInProgress) this._checkForPendingQuestionnaire()
      this._scrollBottom()
    },

    // ── 营养定制 focus confirmation ──
    // A health-plan focus is not a hint: it decides which dots survive the weekly tier cap and
    // doses listed dots toward the top of their range (§31). So it asks first. Deliberately NOT a
    // gate (formulating from biomarkers alone is a correct result, and ~83% of users hold none):
    // 不设方向 is always available. Every entry point routes through here.
    async _startFormulaDots(opts : ToolOpts) {
      const user = this.user
      if (user == null) return
      this.formulaFocusLoading = true
      let plans : UTSJSONObject[] = []
      try {
        // Fetched here rather than reused from activePlans: that is loaded by the Plans tab and
        // this runs in the chat tab, which the user may have opened without ever visiting it.
        const res = await this._req(`${BASE}/api/health-plans?openid=${encodeURIComponent(user!.getString('user_id') ?? '')}`, 'GET', null, 0)
        const arr = res.data != null ? (res.data!.getArray<UTSJSONObject>('plans') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        const lang = this.lang
        plans = arr.map((p) : UTSJSONObject => {
          return {
            id: p.getNumber('id'),
            plan_type: p.getString('plan_type'),
            name: lang == 'zh' ? (p.getString('name_zh') ?? p.getString('custom_name_zh') ?? '') : (p.getString('name_en') ?? p.getString('custom_name_en') ?? ''),
            goal: lang == 'zh' ? (p.getString('goal_zh') ?? p.getString('custom_goal_zh') ?? '') : (p.getString('goal_en') ?? p.getString('custom_goal_en') ?? ''),
          } as UTSJSONObject
        })
      } catch (e : any) {
        // A focus we cannot read is not a reason to refuse the tool — fall through with none,
        // which shows the "pick a direction" sheet; 直接定制 stays available.
      }
      this.formulaFocusOpen = true
      this.formulaFocusPlans = plans
      this.formulaFocusOpts = opts
      this.formulaFocusLoading = false
    },

    // Proceed with whatever focus the user holds — also the path when they have none and choose
    // 直接定制.
    handleFormulaFocusGo() {
      const opts = this.formulaFocusOpts != null ? this.formulaFocusOpts! : new ToolOpts()
      this.formulaFocusOpen = false
      this.formulaFocusOpts = null
      this._runFormulaDots(opts)
    },

    // 不设方向: formulate from biomarkers alone despite holding a focus.
    handleFormulaFocusSkip() {
      const opts = this.formulaFocusOpts != null ? this.formulaFocusOpts! : new ToolOpts()
      this.formulaFocusOpen = false
      this.formulaFocusOpts = null
      const skip = new ToolOpts()
      skip.skipUserMsg = opts.skipUserMsg
      skip.ignoreFocus = true
      skip.async = opts.async
      this._runFormulaDots(skip)
    },

    // The Plans tab is page state, not a route — "go choose one" is a local switch, routed
    // through switchTab with a synthetic tab so its staleness reloads still run.
    handleFormulaFocusChoose() {
      this.formulaFocusOpen = false
      this.formulaFocusOpts = null
      this.switchTab('plans')
      this.plansDotsSubTab = 'plans'
    },

    closeFormulaFocus() {
      this.formulaFocusOpen = false
      this.formulaFocusOpts = null
    },

    _runFormulaDots(opts : ToolOpts) {
      const user = this.user
      if (user == null) return
      runFormulaDs(user!.getString('user_id') ?? '', this.t, this._toolCtx(), opts)
      this._scrollBottom()
    },

    switchPlansDotsSubTab(subTab : string) {
      this.plansDotsSubTab = subTab
      const user = this.user
      if (subTab == 'dots' && user != null) {
        const STALE_MS = 30000
        if (Date.now() - this._dotsLoadedAt > STALE_MS) {
          this.dotsLoading = true
          this.cartridgesLoading = true
          this._loadDots(user, this.lang)
          this._loadCartridges(user, this.lang)
        }
      }
    },

    handleBindNeoDevice() {
      uni.showToast({ title: this.tr('neoNotFoundMsg'), icon: 'none', duration: 2000 })
    },

    switchLearnSubTab(subTab : string) {
      this.learnSubTab = subTab
      if (subTab == 'academy' && this.trainingCourses.length == 0) this._loadAcademy()
      if (subTab == 'wellness' && this.wellnessAssets.length == 0) this._loadWellness()
    },

    // ── Logo menu ──
    toggleMenu() { this.menuOpen = !this.menuOpen },
    closeMenu() { this.menuOpen = false },
    noop() {},
    onPrivacyAgree() {
      resolvePrivacy(true)
      this.showPrivacyModal = false
    },
    onPrivacyCancel() {
      resolvePrivacy(false)
      this.showPrivacyModal = false
    },

    toggleLang() {
      const lang = this.lang == 'zh' ? 'en' : 'zh'
      state.lang = lang
      const storeItems = this._rawStoreItems != null ? mapStoreItems(this._rawStoreItems!, lang) : ([] as UTSJSONObject[])
      const storeOrders = this._rawStoreOrders != null ? mapStoreOrders(this._rawStoreOrders!, lang) : ([] as UTSJSONObject[])
      const channel = this.channel
      const overrides = channel != null ? channel!.getJSON('sub_age_display_names') : null
      const baseT = lang == 'zh' ? T_MAIN_ZH : T_MAIN_EN
      const mergedT = new UTSJSONObject()
      baseT.toMap().forEach((v : any | null, k : string) => { mergedT[k] = v })
      mergedT['subAgeLabels'] = buildSubAgeLabels(baseT.getJSON('subAgeLabels')!, overrides, lang)
      this.lang = lang
      this.t = mergedT
      this.menuOpen = false
      this.storeItems = storeItems
      this.storeOrders = storeOrders
      this.toolList = getToolList(mergedT)
      const user = this.user
      if (user != null) {
        this._loadDots(user, lang)
        this._loadCartridges(user, lang)
      }
      if (this.tab == 'plans' && user != null) this._loadReminders(user)
      // Viva replies in users.language, so the switch is saved too — UI-only, she kept
      // answering in Chinese. Guests have no account to save it on.
      if (user != null && !this.isGuest) {
        const updated = new UTSJSONObject()
        user!.toMap().forEach((v : any | null, k : string) => { updated[k] = v })
        updated['language'] = lang
        uni.setStorageSync('nano_user', updated)
        this.user = updated
        state.user = updated
        const uid = this.userIdStr
        if (uid.length > 0) this._req(`${BASE}/api/users/${uid}`, 'PATCH', { language: lang } as UTSJSONObject, 0)
      }
    },

    async toggleTheme() {
      const theme = this.theme == 'dark' ? 'light' : 'dark'
      this.theme = theme
      state.theme = theme
      uni.setStorageSync('nano_theme', theme)
      const user = this.user
      if (user != null) {
        const updated = new UTSJSONObject()
        user!.toMap().forEach((v : any | null, k : string) => { updated[k] = v })
        updated['theme'] = theme
        uni.setStorageSync('nano_user', updated)
        this.user = updated
        state.user = updated
      }
      this.menuOpen = false
      // NOTE: kept PATCH exactly as the source sends it (handlePutUser partial update).
      const uid = this.userIdStr
      if (uid.length > 0) await this._req(`${BASE}/api/users/${uid}`, 'PATCH', { theme: theme } as UTSJSONObject, 0)
    },

    // One step per gesture; a pinch past either end stop is a silent no-op, not a wrap-around.
    _stepTextScale(dir : number) {
      const next = this.textScale + (dir > 0 ? 1 : -1)
      if (next < 0 || next > 3) return
      this._applyTextScale(next)
      uni.vibrateShort({ type: 'light' as VibrateShortType })
    },

    // Pinch on the health tab, forwarded up by the user-health component (event payload {dir},
    // mirroring the miniapp's e.detail.dir).
    onTextScaleStep(detail : any | null) {
      if (detail == null) return
      const d = detail as UTSJSONObject
      const dir = d.getNumber('dir')
      if (dir != null) this._stepTextScale(dir!)
    },

    // Pinch on every other tab body. The health tab's gesture lives inside user-health (it emits
    // textscalestep, handled above), so it is deliberately NOT bound here — binding both would
    // step twice. One shared stepper across the four tabs is safe because hidden tabs (v-show →
    // display:none) never receive touches.
    _tabPinch() : PinchStepper {
      if (this._pinch == null) {
        this._pinch = new PinchStepper((dir : number) : void => { this._stepTextScale(dir) })
      }
      return this._pinch!
    },

    // TODO(port): confirm the concrete touch-event type at first compile; the stepper takes
    // coordinates, not events (utils/pinch.uts).
    onTabTouchStart(e : UniTouchEvent) {
      const ts = e.touches
      if (ts.length >= 2) this._tabPinch().start(2, ts[0].clientX, ts[0].clientY, ts[1].clientX, ts[1].clientY)
      else this._tabPinch().start(ts.length, 0, 0, 0, 0)
    },
    onTabTouchMove(e : UniTouchEvent) {
      const ts = e.touches
      if (ts.length >= 2) this._tabPinch().move(2, ts[0].clientX, ts[0].clientY, ts[1].clientX, ts[1].clientY)
      else this._tabPinch().move(ts.length, 0, 0, 0, 0)
    },
    onTabTouchEnd(_e : UniTouchEvent | null) { this._tabPinch().end() },

    // Header-menu stepper. Deliberately does NOT close the menu — tap through levels and watch the
    // text behind it resize.
    setTextScale(level : number) {
      if (level == this.textScale) return
      this._applyTextScale(level)
    },

    // Mirrors toggleTheme's persistence chain: state -> storage -> data -> server.
    async _applyTextScale(textScale : number) {
      state.textScale = textScale
      uni.setStorageSync('nano_text_scale', textScale)
      this.textScale = textScale
      const levels = textSizeLevels(this.lang)
      uni.showToast({ title: levels[textScale], icon: 'none', duration: 900 })
      const user = this.user
      if (this.isGuest || user == null) return
      const uid = user!.getString('user_id')
      if (uid == null) return
      try {
        await this._req(`${BASE}/api/users/${uid}`, 'PATCH', { text_scale: textScale } as UTSJSONObject, 0)
      } catch (e : any) {}
    },

    // Edge-swipe to the coach panel (isCoach only). A two-finger pinch must not also read as an
    // edge swipe — latched in touchstart because touchend fires once per finger.
    onTouchStart(e : UniTouchEvent) {
      const ts = e.touches
      if (ts.length > 1) { this._multiTouch = true; return }
      this._multiTouch = false
      this._touchX = ts[0].clientX
      this._touchY = ts[0].clientY
    },

    onTouchEnd(e : UniTouchEvent) {
      if (this._multiTouch) return
      if (!this.isCoach) return
      if (this.menuOpen || this.kinoSimOpen || this.guestSheetOpen) return
      if (this._touchX < this._screenW - 40) return // only swipes starting at the right edge
      const ct = e.changedTouches
      if (ct.length < 1) return
      const dx = ct[0].clientX - this._touchX
      const dy = ct[0].clientY - this._touchY
      if (dx < -70 && Math.abs(dx) > Math.abs(dy) * 1.5) {
        uni.navigateTo({ url: '/pages/coach/coach' })
      }
    },

    openCoach() { this.menuOpen = false; uni.navigateTo({ url: '/pages/coach/coach' }) },
    openReferral() { this.menuOpen = false; uni.navigateTo({ url: '/pages/referral/referral' }) },
    openPhones() { this.menuOpen = false; uni.navigateTo({ url: '/pages/phones/phones' }) },
    openEmails() { this.menuOpen = false; uni.navigateTo({ url: '/pages/emails/emails' }) },
    // The native admin / superadmin pages were removed (2026-09-23): both panels run on the web
    // admin panel, which has its own login.
    openWebAdmin() { this.menuOpen = false; uni.navigateTo({ url: '/pages/webadmin/webadmin' }) },
    // Web: the admin panel in a new tab, like the user-app's LogoMenu links.
    openAdminPanel() {
      this.menuOpen = false
      // #ifdef WEB
      window.open(`${API_ORIGIN}/admin/`, '_blank', 'noopener')
      // #endif
    },

    // ── Viva subscription redeem sheet ──
    // Subscription codes are 16+ crypto-random alphanumeric chars, so a plain text input, not the
    // guest sheet's 6-digit grid.
    openVivaRedeemSheet() {
      this.vivaRedeemSheetOpen = true
      this.vivaRedeemCode = ''
      this.vivaRedeemError = ''
      this.menuOpen = false
    },
    closeVivaRedeemSheet() {
      if (this.vivaRedeemBusy) return
      this.vivaRedeemSheetOpen = false
    },
    async submitVivaRedeem() {
      if (this.vivaRedeemBusy) return
      const user = this.user
      if (user == null) return
      const code = this.vivaRedeemCode.trim()
      if (code.length == 0) { this.vivaRedeemError = this.tr('vivaRedeemRequired'); return }
      this.vivaRedeemBusy = true
      this.vivaRedeemError = ''
      try {
        const res = await this._req(`${BASE}/api/viva-subscription-redeem`, 'POST', { openid: user!.getString('user_id'), code: code } as UTSJSONObject, 0)
        const d = res.data
        if (d == null || d!.getBoolean('success') != true) {
          const status = d != null ? (d!.getString('status') ?? '') : ''
          let errText = this.tr('errServer')
          if (status == 'invalid_code') errText = this.tr('vivaRedeemInvalid')
          else if (status == 'already_used') errText = this.tr('vivaRedeemAlreadyUsed')
          else if (status == 'code_expired') errText = this.tr('vivaRedeemExpired')
          else if (status == 'revoked') errText = this.tr('vivaRedeemInvalid')
          this.vivaRedeemError = errText
          this.vivaRedeemBusy = false
          return
        }
        const newExpiresAt = d!.getString('new_expires_at') ?? ''
        const newDisplay = fmtDate(newExpiresAt, this.lang)
        this.vivaRedeemSheetOpen = false
        this.vivaRedeemBusy = false
        this.vivaSubscriptionExpiresAt = newExpiresAt
        this.vivaSubscriptionExpiresAtDisplay = newDisplay
        this.vivaSubscriptionExpired = false
        // Toast shows the ACTUAL new expiry date — that date is the whole point of redeeming.
        uni.showToast({ title: `${this.tr('vivaRedeemSuccess')} ${newDisplay}`, icon: 'none', duration: 3000 })
      } catch (e : any) {
        this.vivaRedeemError = this.tr('errServer')
        this.vivaRedeemBusy = false
      }
    },

    // "Renew" CTA in the expired banner and the sheet's store link — reuses the same GCN-store
    // bridge as handleBuyFormulation; GCN's checkout owns the "for me / as a gift" choice.
    handleBuyVivaSubscription() {
      if (!this.isAeviva) return
      this._openAevivaStoreGated({ intent: 'buy_viva_subscription' } as UTSJSONObject)
    },

    // `context` is an arbitrary JSON-serializable intent payload ({intent:'buy_custom_formulation',
    // nutrition_plan_id}, 'view_product', 'redeem_formulation_code', …) carried through to
    // pages/appview, which threads it into /api/webview-token so GCN's dashboard.html reads it
    // back after the SSO exchange (webview_tokens.context, AGENTS §31).
    openUserApp(path : string = '/app', context : UTSJSONObject | null = null) {
      this.menuOpen = false
      // #ifdef WEB
      openInNewTab(path, context) // a browser can't frame GCN — see utils/web-open.uts
      return
      // #endif
      let contextParam = ''
      if (context != null) contextParam = `&context=${encodeURIComponent(JSON.stringify(context))}`
      uni.navigateTo({ url: `/pages/appview/appview?url=${encodeURIComponent(path)}${contextParam}` })
    },

    // GCN storefront host: mirror API_ORIGIN's develop-vs-release split, not IS_DEV (which also
    // covers trial). The slug is the channel root's GCN sector (AGENTS §33).
    _openAevivaStore(context : UTSJSONObject | null) {
      const slug = this.gcnStoreSlug.length > 0 ? this.gcnStoreSlug : 'aeviva'
      const host = API_ORIGIN.includes('-dev.') ? `https://${slug}-dev.gcn.net` : `https://${slug}.gcn.net`
      this.openUserApp(`${host}/dashboard.html`, context)
    },

    // ── Kino Simulator ──
    async _resolveKinoSimDevice() {
      try {
        const res = await this._req(`${BASE}/api/kino-devices`, 'GET', null, 0)
        const devices = res.data != null ? (res.data!.getArray<UTSJSONObject>('devices') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        for (const dev of devices) {
          if (dev.getString('serial_number') == KINO_SIM_SERIAL) {
            const sn = dev.getString('serial_number')
            if (sn != null) this.kinoSimDeviceId = sn!
          }
        }
      } catch (e : any) {}
    },

    openKinoSim() {
      if (this.isSuperadmin) {
        this.menuOpen = false
        this.kinoSimOpen = true
        this._resolveKinoSimDevice()
      } else {
        this.menuOpen = false
        this.kinoPassOpen = true
        this.kinoPassInput = ''
        this.kinoPassError = false
      }
    },

    closeKinoPass() {
      this.kinoPassOpen = false
      this.kinoPassInput = ''
      this.kinoPassError = false
    },

    handlePassKey(digit : string) {
      if (this.kinoPassError || this.kinoPassInput.length >= 4) return
      const next = this.kinoPassInput + digit
      if (next.length < 4) { this.kinoPassInput = next; return }
      // 4th digit entered — check immediately
      if (next == '1709') {
        this.kinoPassInput = next
        setTimeout(() => {
          this.kinoPassOpen = false
          this.kinoPassInput = ''
          this.kinoSimOpen = true
          this._resolveKinoSimDevice()
        }, 180)
      } else {
        this.kinoPassInput = next
        this.kinoPassError = true
        setTimeout(() => {
          this.kinoPassInput = ''
          this.kinoPassError = false
        }, 900)
      }
    },

    handlePassDelete() {
      if (this.kinoPassInput.length == 0) return
      this.kinoPassInput = this.kinoPassInput.substring(0, this.kinoPassInput.length - 1)
      this.kinoPassError = false
    },

    toggleKinoSimDebug() { this.kinoSimDebug = !this.kinoSimDebug },

    closeKinoSim() {
      this._stopKinoSlide()
      this.kinoSimOpen = false
      this.kinoSimStatus = 'ready'
      this.kinoSimDebug = false
      this.kinoSimError = ''
      this.kinoSimBmList = [] as UTSJSONObject[]
      this.kinoSimSubAgeList = [] as UTSJSONObject[]
      this.kinoSimBioAge = ''
      this.kinoSimChronoAge = '—'
      this.kinoSimBioAgeColor = '#A6C4E5'
      this.kinoSimActiveTab = 'bioage'
      this.kinoSimSlideIndex = 0
      this.kinoSimSlideVisible = true
      this.kinoSimScannedUserId = ''
      this.kinoSimScannedUserName = ''
      this.kinoSimChipId = ''
    },

    _stopKinoSlide() {
      if (this._kinoSlideTimer != 0) clearInterval(this._kinoSlideTimer)
      this._kinoSlideTimer = 0
    },

    _startKinoSlide() {
      this._stopKinoSlide()
      const len = BM_META.length
      this._kinoSlideTimer = setInterval(() => {
        this.kinoSimSlideVisible = false
        setTimeout(() => {
          this.kinoSimSlideIndex = (this.kinoSimSlideIndex + 1) % len
          this.kinoSimSlideVisible = true
        }, 300)
      }, 2300)
    },

    onKinoSimTabChange(tabKey : string) { this.kinoSimActiveTab = tabKey },

    handleKinoSimStart() {
      if (this.kinoSimStatus == 'analyzing') return
      if (this.kinoSimStatus == 'complete') {
        this._stopKinoSlide()
        this.kinoSimStatus = 'ready'
        this.kinoSimError = ''
        this.kinoSimBmList = [] as UTSJSONObject[]
        this.kinoSimSubAgeList = [] as UTSJSONObject[]
        this.kinoSimBioAge = ''
        this.kinoSimChronoAge = '—'
        this.kinoSimBioAgeColor = '#A6C4E5'
        this.kinoSimActiveTab = 'bioage'
        this.kinoSimSlideIndex = 0
        this.kinoSimSlideVisible = true
        this.kinoSimScannedUserId = ''
        this.kinoSimScannedUserName = ''
        this.kinoSimChipId = ''
        return
      }
      scanQr({
        onlyFromCamera: false,
        success: (scanRes) => { (async () : Promise<void> => {
          const chipId = scanRes.result
          this.kinoSimStatus = 'analyzing'
          try {
            const chipRes = await this._req(`${BASE}/api/kino-chip?chip_id=${encodeURIComponent(chipId)}`, 'GET', null, 0)
            if (chipRes.statusCode != 200 || chipRes.data == null || chipRes.data!.getBoolean('found') != true) {
              this.kinoSimStatus = 'failed'
              this.kinoSimError = 'Chip not bound to any user. Ask the user to scan and bind the chip first via the chat Test Chip tool.'
              return
            }
            if (chipRes.data!.getBoolean('used') == true) {
              this.kinoSimStatus = 'failed'
              this.kinoSimError = 'chip already used'
              return
            }
            const chipUserId = chipRes.data!.getString('user_id') ?? ''
            const chipNickname = chipRes.data!.getString('nickname') ?? ''
            this.kinoSimScannedUserId = chipUserId
            this.kinoSimScannedUserName = chipNickname
            this.kinoSimChipId = chipId
            await this._runKinoAnalysis(chipUserId)
          } catch (e : any) {
            this.kinoSimStatus = 'failed'
            this.kinoSimError = `${e}`
          }
        })() },
        fail: (_) => {}
      })
    },

    // POST /api/biomarkers with an empty test_data makes the estimator run against the user's
    // existing readings — the sim's "analysis". BiomarkerValues in the response ARE data.validated
    // (§17), so the sparkline fold-in is honest without a refetch. Sparks already attached to older
    // messages are left alone — they belong to the reading those messages describe.
    async _runKinoAnalysis(targetUserId : string) {
      try {
        const body = {
          openid: targetUserId,
          test_type: 'kino_chip',
          test_data: {} as UTSJSONObject,
        } as UTSJSONObject
        // source sent `kino_device_id: id || undefined` — key ABSENT when unset, not null.
        if (this.kinoSimDeviceId.length > 0) body['kino_device_id'] = this.kinoSimDeviceId
        const res = await this._req(`${BASE}/api/biomarkers`, 'POST', body, 0)
        if (res.statusCode != 200 && res.statusCode != 201) {
          throw new Error(`POST /biomarkers HTTP ${res.statusCode}: ${res.data != null ? JSON.stringify(res.data) : ''}`)
        }
        const biomarkers = res.data != null ? res.data!.getJSON('biomarkers') : null
        const biomarkerId = res.data != null ? res.data!.getNumber('biomarker_id') : null
        if (biomarkers != null && this._bioSeries != null) appendReading(this._bioSeries!, biomarkers, null)
        let bioageProfile = res.data != null ? res.data!.getJSON('bioage_profile') : null
        if (bioageProfile == null) {
          try {
            const bmRes = await this._req(`${BASE}/api/biomarkers?openid=${encodeURIComponent(targetUserId)}`, 'GET', null, 0)
            const records = bmRes.data != null ? (bmRes.data!.getArray<UTSJSONObject>('records') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
            if (records.length > 0) {
              const latest = records[records.length - 1]
              const dataJ = latest.getJSON('data')
              bioageProfile = dataJ != null ? dataJ!.getJSON('bioage_profile') : null
            }
          } catch (e : any) {}
        }
        const t = this.t
        const bmLabels = t.getJSON('bmLabels')!
        const bmList : UTSJSONObject[] = []
        for (const meta of BM_META) {
          const key = meta.getString('key') ?? ''
          const label = bmLabels.getString(key) ?? key
          bmList.push({
            key: key, label: label, unit: meta.getString('unit'),
            value: biomarkers != null ? biomarkers!.getNumber(key) : null,
          } as UTSJSONObject)
        }
        const subAgeLabels = t.getJSON('subAgeLabels')!
        const subAges = bioageProfile != null ? bioageProfile!.getJSON('SubAges') : null
        const subAgeList : UTSJSONObject[] = []
        if (subAges != null) {
          for (const key of SUB_AGE_KEYS) {
            const v = subAges!.getNumber(key)
            subAgeList.push({
              key: key,
              label: subAgeLabels.getString(key) ?? key,
              color: SUB_AGE_COLORS.get(key) ?? '#A6C4E5',
              value: v != null ? v!.toFixed(1) : '—',
            } as UTSJSONObject)
          }
        }
        const rawBioAge = bioageProfile != null ? bioageProfile!.getNumber('BioAge') : null
        const rawChronoAge = bioageProfile != null ? bioageProfile!.getNumber('ChronoAge') : null
        if (this.kinoSimChipId.length > 0) {
          try {
            const resultBody = {
              chip_id: this.kinoSimChipId,
              data: { biomarkers: biomarkers, bioage_profile: bioageProfile } as UTSJSONObject,
              bio_age: rawBioAge,
              biomarker_id: biomarkerId,
            } as UTSJSONObject
            if (this.kinoSimDeviceId.length > 0) resultBody['kino_device_id'] = this.kinoSimDeviceId
            await this._req(`${BASE}/api/kino-result`, 'POST', resultBody, 0)
          } catch (e : any) {}
        }
        this.kinoSimStatus = 'complete'
        this.kinoSimBmList = bmList
        this.kinoSimSubAgeList = subAgeList
        this.kinoSimBioAge = rawBioAge != null ? rawBioAge!.toFixed(1) : '—'
        this.kinoSimChronoAge = rawChronoAge != null ? `${rawChronoAge}` : '—'
        this.kinoSimBioAgeColor = bioAgeColor(rawBioAge, rawChronoAge)
        this.kinoSimActiveTab = 'bioage'
        this.kinoSimSlideIndex = 0
        this.kinoSimSlideVisible = true
        this._startKinoSlide()
      } catch (e : any) {
        this.kinoSimStatus = 'failed'
        this.kinoSimError = `${e}`
      }
    },

    // ── Logout / sandbox ──
    exitSandbox() {
      this._stopPolling()
      const originRaw = uni.getStorageSync('nano_sandbox_origin')
      uni.removeStorageSync('nano_sandbox_origin')
      uni.removeStorageSync('nano_sandbox_active')
      state.sandboxMode = false
      if (originRaw != null && originRaw instanceof UTSJSONObject) {
        const origin = originRaw as UTSJSONObject
        const u = origin.getJSON('user')
        if (u != null) {
          state.user = u
          state.channel = origin.getJSON('channel')
          state.coach = origin.getJSON('coach')
          uni.setStorageSync('nano_user', u)
          const chn = origin.getJSON('channel')
          if (chn != null) uni.setStorageSync('nano_channel', chn)
          const co1 = origin.getJSON('coach')
          if (co1 != null) uni.setStorageSync('nano_coach', co1)
          uni.reLaunch({ url: '/pages/main/main' })
          return
        }
      }
      uni.removeStorageSync('nano_user')
      state.user = null
      uni.reLaunch({ url: '/pages/login/login' })
    },

    // A guest with an account signs in with phone or email on the login page's entry form;
    // 返回 there comes back to this page (navigateTo, not reLaunch).
    openSignIn() {
      this.menuOpen = false
      uni.navigateTo({ url: '/pages/login/login?signin=1' })
    },

    handleLogout() {
      this.menuOpen = false
      if (state.sandboxMode) { this.exitSandbox(); return }
      this._stopPolling()
      // Snapshot this session (minus phone/email — same PII-stripping convention as login.js) so
      // the logged-out screen can offer an instant "continue as previous" restore. Prefer the
      // already-persisted maskedPhone over re-deriving from a raw phone that almost never survives
      // a restart (see main.js comment).
      const user = state.user
      if (user != null && user!.getBoolean('guest') != true) {
        const snap = new UTSJSONObject()
        user!.toMap().forEach((v : any | null, k : string) => {
          if (k == 'phone' || k == 'email') return
          snap[k] = v
        })
        const storedMasked = user!.getString('maskedPhone')
        const m = storedMasked != null && storedMasked!.length > 0 ? storedMasked : maskPhone(user!.getString('phone'))
        uni.setStorageSync('nano_last_session', {
          user: snap, channel: state.channel, coach: state.coach, maskedPhone: m, session_token: state.apiToken,
        } as UTSJSONObject)
      }
      uni.removeStorageSync('nano_user')
      clearSession()
      state.user = null
      uni.reLaunch({ url: '/pages/login/login?loggedOut=1' })
    },

    // ── Chat init ──
    async _initChat(user : UTSJSONObject, lang : string) {
      const baseT = lang == 'zh' ? T_MAIN_ZH : T_MAIN_EN
      const initMsg = this._makeMsg('init', 'ai', tMainTr(baseT, 'initMsg'), null, '', '', null, null)

      let historyLoaded = false
      try {
        const res = await this._req(`${BASE}/api/chat-history?openid=${encodeURIComponent(user!.getString('user_id') ?? '')}`, 'GET', null, 0)
        const history = res.data != null ? (res.data!.getArray<UTSJSONObject>('messages') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        if (history.length > 0) {
          const msgs : ChatMsg[] = []
          for (let i = 0; i < history.length; i++) msgs.push(this._fromHistoryRow(history[i], `h-${i}`))
          this._applySeparators(msgs, null)
          let maxId = 0
          let minId = Number.MAX_SAFE_INTEGER
          let any = false
          for (const m of history) {
            const id = m.getNumber('id')
            if (id != null) { any = true; if (id! > maxId) maxId = id!; if (id! < minId) minId = id! }
          }
          this._lastMsgId = any ? maxId : 0
          this._oldestDbId = any ? minId : null
          // Register every AI bubble history just rendered with the cross-channel de-dup: a
          // dual-written message delivered while the app was closed is already in chat_messages AND
          // still 'pending' in notifications — without this the first poll renders it twice
          // (found live 2026-09-16, coach-activated program day).
          for (const m of history) {
            const role = m.getString('role')
            if (role == 'ai' || role == 'assistant') this._markRenderedAi(m.getString('content') ?? '')
          }
          this.messages = msgs
          this.hasMoreHistory = res.data!.getBoolean('has_more') == true
          this._scrollBottom()
          historyLoaded = true
          this._refreshProgramState()
        } else {
          this._lastMsgId = 0
        }
      } catch (e : any) { if (IS_DEV) console.error('History load failed', e) }
      if (!historyLoaded) { this.messages = [initMsg] }

      // Advisory nudge, not a blocking gate — shown client-side only (never persisted), so it
      // reappears each session until phone_verified flips, without duplicating in history.
      // An email-verified account (waven tree) has a proven identity — no phone nudge for it.
      if (user!.getBoolean('phone_verified') != true && user!.getBoolean('email_verified') != true) {
        this._addMsg('ai', tMainTr(baseT, 'verifyPhonePrompt'), false)
        this._addActionMsg('verify_phone', tMainTr(baseT, 'verifyPhoneCta'), false)
      }

      // Fetch pending questionnaires + biomarkers in parallel
      let pendingAssignments : UTSJSONObject[] = []
      let biomarkerRecords : UTSJSONObject[] = []
      try {
        const uid = encodeURIComponent(user!.getString('user_id') ?? '')
        const qRes = await this._req(`${BASE}/api/pending-questionnaires?openid=${uid}`, 'GET', null, 0)
        const bRes = await this._req(`${BASE}/api/biomarkers?openid=${uid}`, 'GET', null, 0)
        pendingAssignments = qRes.data != null ? (qRes.data!.getArray<UTSJSONObject>('assignments') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        biomarkerRecords = bRes.data != null ? (bRes.data!.getArray<UTSJSONObject>('records') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        this._setBioSeries(biomarkerRecords)
      } catch (e : any) { if (IS_DEV) console.error('Init fetch failed', e) }

      // Find first assignment with an unanswered question
      for (const assignment of pendingAssignments) {
        const answeredIds = new Set<number>()
        const resp = assignment.getArray<UTSJSONObject>('responses') ?? ([] as UTSJSONObject[])
        for (const r of resp) {
          const qid = r.getNumber('question_id')
          if (qid != null) answeredIds.add(qid!)
        }
        const questions = assignment.getArray<UTSJSONObject>('questions') ?? ([] as UTSJSONObject[])
        const firstIdx = this._firstUnanswered(questions, user, biomarkerRecords, answeredIds)
        if (firstIdx >= 0) {
          this._startQuestionnaire(assignment, questions, firstIdx)
          return
        }
      }
      this._onAllQuestionnaireDone(user, '', true)
    },

    _firstUnanswered(questions : UTSJSONObject[], user : UTSJSONObject, biomarkerRecords : UTSJSONObject[], answeredIds : Set<number>) : number {
      for (let i = 0; i < questions.length; i++) {
        if (!this._isQuestionAnswered(questions[i], user, biomarkerRecords, answeredIds)) return i
      }
      return -1
    },

    _isQuestionAnswered(q : UTSJSONObject, user : UTSJSONObject, biomarkerRecords : UTSJSONObject[], answeredIds : Set<number>) : boolean {
      const qid = q.getNumber('id')
      if (qid != null && answeredIds.has(qid!)) return true
      const cc = q.getJSON('completion_check')
      if (cc == null) return false
      const type = cc!.getString('type') ?? ''
      const field = cc!.getString('field') ?? ''
      if (type == 'user_field') {
        const v = user![field]
        return v != null && `${v}` != 'false' && `${v}` != ''
      }
      if (type == 'bio_data_field') {
        const bio = user!.getJSON('bio_data')
        return bio != null && bio![field] != null
      }
      if (type == 'biomarker') {
        const testType = cc!.getString('test_type') ?? ''
        const dataPath = cc!.getString('data_path') ?? ''
        for (const r of biomarkerRecords) {
          if (r.getString('test_type') == testType && this._getNestedPath(r.getJSON('data'), dataPath) != null) return true
        }
      }
      return false
    },

    _getNestedPath(obj : UTSJSONObject | null, dotPath : string) : any | null {
      if (obj == null || dotPath.length == 0) return null
      let cur : UTSJSONObject | null = obj
      const parts = dotPath.split('.')
      for (let i = 0; i < parts.length; i++) {
        if (cur == null) return null
        if (i == parts.length - 1) return cur![parts[i]]
        cur = cur!.getJSON(parts[i])
      }
      return null
    },

    _startQuestionnaire(assignment : UTSJSONObject, questions : UTSJSONObject[], firstIdx : number) {
      const type = assignment.getString('type') ?? ''
      // A program day's 打卡 (§42) was introduced by its own card — the coach-questions intro
      // would be wrong for it.
      if (type != 'onboarding' && type != 'program_day') {
        this._addMsg('ai', this.tr('questionnaireIntro'), true)
      }
      this.obQuestions = questions
      const aid = assignment.getString('assignment_id')
      this.obAssignmentId = aid != null ? aid! : `${assignment.getNumber('assignment_id')}`
      this.obQIndex = firstIdx
      this.obQuestionnaireType = type
      if (assignment.getString('status') == 'pending') {
        this._req(`${BASE}/api/questionnaire-assignments/${this.obAssignmentId}`, 'PATCH', { status: 'in_progress' } as UTSJSONObject, 0).catch((e : any | null) => {})
      }
      this._showQuestion(questions[firstIdx])
    },

    _showQuestion(q : UTSJSONObject) {
      const lang = this.lang
      const prompt = lang == 'zh' ? (q.getString('prompt_zh') ?? '') : (q.getString('prompt_en') ?? '')
      this._addMsg('ai', prompt, false)
      this.obQuestion = q
      this.obStep = q.getString('key') ?? ''
      const inputType = q.getString('input_type') ?? ''
      const cfg = q.getJSON('config')

      if (inputType == 'slider_group' && cfg != null) {
        const sliders = cfg!.getArray<UTSJSONObject>('sliders') ?? ([] as UTSJSONObject[])
        const sObj = new UTSJSONObject()
        const dObj = new UTSJSONObject()
        for (const s of sliders) {
          const key = s.getString('key') ?? ''
          const def = s.getNumber('default') ?? 0
          const step = s.getNumber('step') ?? 1
          sObj[key] = def
          dObj[key] = step < 1 ? def.toFixed(1) : `${def}`
          if (key == 'height') this.obHeight = def
          if (key == 'weight') { this.obWeight = def; this.obWeightDisplay = step < 1 ? def.toFixed(1) : `${def}` }
        }
        this.obSliders = sObj
        this.obSliderDisplay = dObj
      }

      if (inputType == 'multi_select' && cfg != null) {
        const options = cfg!.getArray<UTSJSONObject>('options') ?? ([] as UTSJSONObject[])
        const list : UTSJSONObject[] = []
        for (let idx = 0; idx < options.length; idx++) {
          const opt = options[idx]
          const key = (opt.getString('key') ?? opt.getString('value')) ?? `${idx}`
          list.push({
            key: key,
            label: lang == 'zh' ? (opt.getString('label_zh') ?? '') : (opt.getString('label_en') ?? ''),
            selected: false,
          } as UTSJSONObject)
        }
        this.obConditionList = list
        this.obConditions = [] as string[]
        this.obOtherSelected = false
        this.obConditionsOther = ''
      }

      if (inputType == 'date_picker') this.obBirthday = ''
      if (inputType == 'time_picker') {
        const def = cfg != null ? (cfg!.getString('default') ?? '') : ''
        this.obTime = def
      }
      if (inputType == 'text') this.obName = ''
    },

    // Template accessors for the questionnaire bars.
    obOptions() : UTSJSONObject[] {
      const q = this.obQuestion
      if (q == null) return [] as UTSJSONObject[]
      const cfg = q!.getJSON('config')
      if (cfg == null) return [] as UTSJSONObject[]
      return cfg!.getArray<UTSJSONObject>('options') ?? ([] as UTSJSONObject[])
    },
    obOptionLabel(opt : UTSJSONObject) : string {
      return this.lang == 'zh' ? (opt.getString('label_zh') ?? '') : (opt.getString('label_en') ?? '')
    },
    obSlidersCfg() : UTSJSONObject[] {
      const q = this.obQuestion
      if (q == null) return [] as UTSJSONObject[]
      const cfg = q!.getJSON('config')
      if (cfg == null) return [] as UTSJSONObject[]
      return cfg!.getArray<UTSJSONObject>('sliders') ?? ([] as UTSJSONObject[])
    },
    obSliderLabel(s : UTSJSONObject) : string {
      return this.lang == 'zh' ? (s.getString('label_zh') ?? '') : (s.getString('label_en') ?? '')
    },
    obSliderNum(key : string) : number {
      const v = this.obSliders.getNumber(key)
      return v != null ? v! : 0
    },
    obSliderValStr(key : string) : string {
      const d = this.obSliderDisplay.getString(key)
      if (d != null && d!.length > 0) return d!
      return `${this.obSliders.getNumber(key) ?? 0}`
    },
    takeawayTitle(seg : Segment) : string {
      const tk = seg.takeaway
      if (tk != null && tk!.title.length > 0) return tk!.title
      return this.tr('mdTakeaway')
    },
    orderStatusLabel(status : string | null) : string {
      if (status == null) return ''
      const v = this.t.getJSON('orderStatus')!.getString(status!)
      return v != null ? v! : status!
    },

    async _saveAnswer(displayText : string, answerValue : any | null) {
      const q = this.obQuestion
      const user = this.user
      if (q == null || this.obAssignmentId.length == 0 || user == null) return
      this._addMsg('user', displayText, false)
      this.typing = true
      try {
        const res = await this._req(`${BASE}/api/questionnaire-responses`, 'POST', {
          assignment_id: this.obAssignmentId,
          question_id: q!.getNumber('id'),
          answer: answerValue,
          answer_display: displayText,
        } as UTSJSONObject, 0)
        // Update local user cache for onboarding profile fields.
        const saveTarget = q!.getString('save_target') ?? ''
        const saveField = q!.getString('save_field') ?? ''
        if (saveTarget == 'user_field' && saveField.length > 0) {
          const updated = this._copyUser()
          updated[saveField] = answerValue
          this._updateUser(updated)
        } else if (saveTarget == 'bio_data_field' && saveField.length > 0) {
          const updated = this._copyUser()
          const bio = updated.getJSON('bio_data')
          const newBio = new UTSJSONObject()
          if (bio != null) bio!.toMap().forEach((v : any | null, k : string) => { newBio[k] = v })
          newBio[saveField] = answerValue
          updated['bio_data'] = newBio
          this._updateUser(updated)
        }
        const completed = res.data != null && res.data!.getBoolean('completed') == true
        if (completed) {
          this.obQuestion = null
          this.obStep = ''
          this.typing = false
          await this._advanceOnboarding()
        } else {
          // Find next question after obQIndex (questions up to it are answered).
          const nextIdx = this.obQIndex + 1 < this.obQuestions.length ? this.obQIndex + 1 : -1
          if (nextIdx >= 0) {
            this.obQIndex = nextIdx
            this.typing = false
            this._showQuestion(this.obQuestions[nextIdx])
          } else {
            this.obQuestion = null
            this.obStep = ''
            this.typing = false
            await this._advanceOnboarding()
          }
        }
      } catch (e : any) {
        this._addMsg('ai', this.tr('errServer'), false)
        this.typing = false
      }
    },

    _copyUser() : UTSJSONObject {
      const updated = new UTSJSONObject()
      const u = this.user
      if (u != null) u!.toMap().forEach((v : any | null, k : string) => { updated[k] = v })
      return updated
    },

    async _checkForPendingQuestionnaire() {
      const user = this.user
      if (user == null) return
      try {
        const uid = encodeURIComponent(user!.getString('user_id') ?? '')
        const qRes = await this._req(`${BASE}/api/pending-questionnaires?openid=${uid}`, 'GET', null, 0)
        const bRes = await this._req(`${BASE}/api/biomarkers?openid=${uid}`, 'GET', null, 0)
        const pendingAssignments = qRes.data != null ? (qRes.data!.getArray<UTSJSONObject>('assignments') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        const biomarkerRecords = bRes.data != null ? (bRes.data!.getArray<UTSJSONObject>('records') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        for (const assignment of pendingAssignments) {
          const answeredIds = new Set<number>()
          const resp = assignment.getArray<UTSJSONObject>('responses') ?? ([] as UTSJSONObject[])
          for (const r of resp) { const qid = r.getNumber('question_id'); if (qid != null) answeredIds.add(qid!) }
          const questions = assignment.getArray<UTSJSONObject>('questions') ?? ([] as UTSJSONObject[])
          const firstIdx = this._firstUnanswered(questions, user, biomarkerRecords, answeredIds)
          if (firstIdx >= 0) { this._startQuestionnaire(assignment, questions, firstIdx); return }
        }
      } catch (e : any) {}
    },

    async _advanceOnboarding() {
      const user = this.user
      if (user == null) return
      try {
        const uid = encodeURIComponent(user!.getString('user_id') ?? '')
        const qRes = await this._req(`${BASE}/api/pending-questionnaires?openid=${uid}`, 'GET', null, 0)
        const bRes = await this._req(`${BASE}/api/biomarkers?openid=${uid}`, 'GET', null, 0)
        const pendingAssignments = qRes.data != null ? (qRes.data!.getArray<UTSJSONObject>('assignments') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        const biomarkerRecords = bRes.data != null ? (bRes.data!.getArray<UTSJSONObject>('records') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        for (const assignment of pendingAssignments) {
          const answeredIds = new Set<number>()
          const resp = assignment.getArray<UTSJSONObject>('responses') ?? ([] as UTSJSONObject[])
          for (const r of resp) { const qid = r.getNumber('question_id'); if (qid != null) answeredIds.add(qid!) }
          const questions = assignment.getArray<UTSJSONObject>('questions') ?? ([] as UTSJSONObject[])
          const firstIdx = this._firstUnanswered(questions, user, biomarkerRecords, answeredIds)
          if (firstIdx >= 0) {
            if (this.obQuestionnaireType == 'custom') this._addMsg('ai', this.tr('questionnaireThanks'), true)
            this._startQuestionnaire(assignment, questions, firstIdx)
            return
          }
        }
      } catch (e : any) {}

      // A program day's recap + comment arrive via the poll within a tick — no "thanks" bubble,
      // and the card's 已完成打卡 state comes from the server, not from us.
      const isProgramDay = this.obQuestionnaireType == 'program_day'
      this._onAllQuestionnaireDone(user, this.obQuestionnaireType, isProgramDay)
      if (isProgramDay) this._refreshProgramState()
    },

    _onAllQuestionnaireDone(user : UTSJSONObject, completedType : string, silent : boolean) {
      if (!silent) this._addMsg('ai', this.tr('questionnaireThanks'), true)
      this.obStep = 'done'
      // Phone verification is a hard gate before reaching this page — no in-chat nudge needed.
      this._startPolling(user)
    },

    onScrollToUpper() {
      // Intentionally empty — history loads on explicit pull or tap, never auto-triggered.
    },
    onLoadMoreHistoryTap() { this._loadMoreHistory() },

    async _loadMoreHistory() {
      if (this.historyLoading || !this.hasMoreHistory) return
      const user = this.user
      if (user == null || this._oldestDbId == null || this._oldestDbId! <= 0) return
      this.historyLoading = true
      try {
        const url = `${BASE}/api/chat-history?openid=${encodeURIComponent(user!.getString('user_id') ?? '')}&before_id=${this._oldestDbId}`
        const res = await this._req(url, 'GET', null, 0)
        const history = res.data != null ? (res.data!.getArray<UTSJSONObject>('messages') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        const hasMore = res.data != null && res.data!.getBoolean('has_more') == true
        if (history.length > 0) {
          // Older rows are PREPENDED — the separator pass runs over the new run alone, then the
          // first pre-existing message is re-evaluated against the newly-arrived tail.
          const newMsgs : ChatMsg[] = []
          for (const m of history) newMsgs.push(this._fromHistoryRow(m, `old-${m.getNumber('id')}`))
          this._applySeparators(newMsgs, null)
          const existing = [...this.messages]
          if (existing.length > 0 && newMsgs.length > 0) {
            existing[0].sep = msgSeparator(newMsgs[newMsgs.length - 1].ts, existing[0].ts, this.lang)
          }
          const anchorId = 'm' + (existing.length > 0 ? existing[0].id : '')
          let minId = this._oldestDbId!
          for (const m of history) {
            const id = m.getNumber('id')
            if (id != null && id! < minId) minId = id!
          }
          this._oldestDbId = minId
          this.messages = [...newMsgs, ...existing]
          this.hasMoreHistory = hasMore
          this.scrollAnchor = anchorId
          setTimeout(() => { this.scrollAnchor = '' }, 300)
        } else {
          this.hasMoreHistory = false
        }
      } catch (e : any) { if (IS_DEV) console.error('Load more history failed', e) }
      this.historyLoading = false
    },

    async _loadHistory(user : UTSJSONObject) {
      // Already handled in _initChat; kept for callers that want a bare refresh.
      try {
        const res = await this._req(`${BASE}/api/chat-history?openid=${encodeURIComponent(user!.getString('user_id') ?? '')}`, 'GET', null, 0)
        const history = res.data != null ? (res.data!.getArray<UTSJSONObject>('messages') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        if (history.length > 0) {
          const msgs : ChatMsg[] = []
          for (let i = 0; i < history.length; i++) msgs.push(this._fromHistoryRow(history[i], `h-${i}`))
          this._applySeparators(msgs, null)
          this.messages = msgs
          this._scrollBottom()
        }
      } catch (e : any) {}
    },

    // ── Chat messaging ──
    // Single construction point for every chat message (main.js: nine of them used to re-derive
    // this). `content` is always the RAW text — AI rows are segmented for display here; the
    // persist path posts its own raw argument, so nothing rendered is written back to the server.
    _makeMsg(id : string, role : string, content : string, imageUrl : string | null, action : string, label : string, createdAt : string | null, source : string | null) : ChatMsg {
      const msg = new ChatMsg()
      msg.id = id
      msg.role = role == 'assistant' ? 'ai' : role
      msg.imageUrl = imageUrl
      msg.source = source
      msg.ts = createdAt != null && createdAt!.length > 0 ? _parseMs(createdAt) : Date.now()
      msg.sep = ''
      msg.action = action
      msg.label = label
      if (msg.role == 'action') return msg
      if (msg.role == 'coach') {
        // Coach messages are single-line bubbles (miniapp rule) — flatten newlines.
        msg.content = content.replace(/\n+/g, ' ')
        return msg
      }
      if (msg.role == 'ai') {
        msg.segments = mdToSegments(content)
        this._attachFormulaCta(msg)
        this._attachProgramState(msg.segments)
        // _attachSparks in the miniapp mutated items in place; xapp draws sparklines at render time
        // from _bioSeries via tileSpark (biomarker-series reads data.validated ONLY, §17).
        // Distinguishes an image-only bubble (drops its padding) from an image WITH text, which
        // must keep it — the old wx:elif chain silently dropped the text for the latter.
        msg.imageOnly = msg.imageUrl != null && msg.content.length == 0 && msg.segments.length == 0
        return msg
      }
      msg.content = content
      msg.imageOnly = msg.imageUrl != null && msg.content.length == 0 && msg.segments.length == 0
      return msg
    },

    tileSpark(label : string) : Spark | null {
      return sparkForLabel(this._bioSeries, label)
    },

    // GET /api/biomarkers resolves AFTER _initChat rendered history, so the first paint of an
    // older metric card had no sparkline — back-fill once when the series lands by forcing a
    // re-render (tileSpark recomputes against the now-present series).
    _setBioSeries(records : UTSJSONObject[]) {
      try {
        this._bioSeries = buildSeriesIndex(records)
      } catch (e : any) {
        if (IS_DEV) console.error('buildSeriesIndex failed', e)
        return
      }
      if (this.messages.some((m) : boolean => m.role == 'ai' && m.segments.some((s) : boolean => s.t == 'metric'))) {
        this.messages = [...this.messages]
      }
    },

    _fromHistoryRow(m : UTSJSONObject, id : string) : ChatMsg {
      const rawRole = m.getString('role') ?? ''
      const role = rawRole == 'assistant' || rawRole == 'ai' ? 'ai' : rawRole
      if (role == 'action') {
        try {
          const d = JSON.parse<UTSJSONObject>(m.getString('content') ?? '')
          if (d != null) {
            return this._makeMsg(id, 'action', '', null, d!.getString('action') ?? '', d!.getString('label') ?? '', m.getString('created_at'), null)
          }
          return this._makeMsg(id, 'ai', m.getString('content') ?? '', null, '', '', m.getString('created_at'), null)
        } catch (e : any) {
          return this._makeMsg(id, 'ai', m.getString('content') ?? '', null, '', '', m.getString('created_at'), null)
        }
      }
      return this._makeMsg(id, role, m.getString('content') ?? '', m.getString('image_url'), '', '', m.getString('created_at'), m.getString('source'))
    },

    // Stamps each message's time separator relative to its predecessor. `prev` is the message
    // immediately before msgs[0] (null at the conversation start). Appends pass only the new run.
    _applySeparators(msgs : ChatMsg[], prev : ChatMsg | null) : ChatMsg[] {
      const lang = this.lang
      let last = prev
      for (const m of msgs) {
        m.sep = msgSeparator(last != null ? last!.ts : 0, m.ts, lang)
        last = m
      }
      return msgs
    },

    // A mini program / native app cannot navigate to an arbitrary external URL from chat text;
    // rich-text in uvue has no linktap yet. TODO(port): link-tap → copy sheet (the miniapp's
    // _onMdLinkTap offered t.mdLinkCopy/mdLinkCopied behind an action sheet).
    _onMdLinkTap(href : string) {
      if (href.length == 0 || !/^https?:\/\//i.test(href)) return
      uni.showActionSheet({
        itemList: [this.tr('mdLinkCopy')],
        success: () => {
          uni.setClipboardData({ data: href, success: () => { uni.showToast({ title: this.tr('mdLinkCopied'), icon: 'none' }) } })
        },
        fail: (_) => {}
      })
    },

    // Identity of an AI bubble for cross-channel de-dup (§22). The same reply reaches this page
    // through two independent channels (notifications poll — fast; chat_messages catch-up —
    // durable) and either can win, so whichever renders first registers its text here and the
    // other drops it. Keyed on normalised text because a notification row carries no
    // chat_messages id. Text ALONE cannot tell "same reply on the other channel" from "a new
    // reply that repeats an earlier one" (dev, 2026-09-23: the second identical answer got
    // swallowed) — so each key remembers its turn; once scoped, only this turn's renders count.
    _aiKey(content : string) : string {
      const norm = content.replace(/\s+/g, ' ').trim()
      return norm.length > 160 ? norm.substring(0, 160) : norm
    },

    _markRenderedAi(content : string) {
      const k = this._aiKey(content)
      if (k.length == 0) return
      this._renderedAiKeys.delete(k)
      this._renderedAiKeys.set(k, this._turnSeq)
      // Bounded — a long session must not grow this without limit. Maps iterate in insertion
      // order, so this evicts the oldest key.
      if (this._renderedAiKeys.size > 200) {
        let oldestKey = ''
        for (const key of this._renderedAiKeys.keys) { oldestKey = key; break }
        if (oldestKey.length > 0) this._renderedAiKeys.delete(oldestKey)
      }
    },

    // `anyTurn` is for a chat_messages row at or below _aiRowFloor — a reply to an EARLIER turn
    // the catch-up can still return (_lastMsgId only advances past rows it fetched), which the
    // old any-turn rule must keep dropping or it would re-render an old reply.
    _isRenderedAi(content : string, anyTurn : boolean) : boolean {
      const k = this._aiKey(content)
      if (k.length == 0) return false
      const seq = this._renderedAiKeys.get(k)
      if (seq == null) return false
      return anyTurn || seq! >= this._aiDedupeSeq
    },

    // Called with /api/chat's user_message_id: every reply to this turn is a chat_messages row
    // after that id, and only renders from this turn count as duplicates from here on.
    _scopeAiDedupeToTurn(userMessageId : number | null) {
      if (userMessageId == null) return
      this._aiDedupeSeq = this._turnSeq
      this._aiRowFloor = userMessageId
    },

    _addMsg(role : string, rawContent : string, persist : boolean) {
      const msg = this._makeMsg(`${role}-${Date.now()}`, role, rawContent, null, '', '', null, null)
      // Locally-added AI bubbles are persisted server-side too (persist=true) — the catch-up poll
      // will see them come back, so register them as already rendered.
      if (msg.role == 'ai') this._markRenderedAi(rawContent)
      const prev = this.messages.length > 0 ? this.messages[this.messages.length - 1] : null
      this._applySeparators([msg], prev)
      this.messages = [...this.messages, msg]
      this._scrollBottom()
      const user = this.user
      if (persist && user != null && (user!.getString('user_id') ?? '').length > 0) {
        this._req(`${BASE}/api/chat-messages`, 'POST', {
          openid: user!.getString('user_id'), role: role, content: rawContent,
        } as UTSJSONObject, 0).catch((e : any | null) => { if (IS_DEV) console.error('Persistent msg failed', e) })
      }
    },

    // AGENTS §23 (scroll half): scrollTop alone under-shoots on a real phone's cold launch; the
    // anchor mechanism scrolls a specific element against whatever the layout actually is. The
    // nextTick the miniapp used has no xapp equivalent — the two follow-up timers (150/500ms)
    // catch slower devices/longer markdown re-layout; images re-snap via onChatImageLoad and
    // short non-overflowing messages are covered by the 100px .chat-inner padding above.
    _scrollBottom() {
      if (this.messages.length == 0) return
      if (this._scrollTimer != 0) clearTimeout(this._scrollTimer)
      if (this._scrollTimer2 != 0) clearTimeout(this._scrollTimer2)
      if (this._scrollAnchorTimer != 0) clearTimeout(this._scrollAnchorTimer)
      const doScrollTop = () => {
        this._scrollFlip = !this._scrollFlip
        this.scrollTop = this._scrollFlip ? 999998 : 999999
      }
      this._scrollTimer = setTimeout(doScrollTop, 150)
      this._scrollTimer2 = setTimeout(doScrollTop, 500)
      const lastId = this.messages[this.messages.length - 1].id
      this.scrollAnchor = `m${lastId}`
      this._scrollAnchorTimer = setTimeout(() => { this.scrollAnchor = '' }, 700)
    },

    // <image mode="widthFix"> bubbles reach their final height only once the image loads — well
    // after the timer-driven scroll above fired. Re-snap ONLY for the LAST message so an older
    // history image finishing loading doesn't yank the view.
    onChatImageLoad(msgId : string) {
      if (this.messages.length == 0) return
      const last = this.messages[this.messages.length - 1]
      if (last.id == msgId) this._scrollBottom()
    },

    toggleToolbox() {
      // A turn in flight can still CLOSE the sheet, not open it.
      if (this.typing && !this.toolboxOpen) return
      this.toolboxOpen = !this.toolboxOpen
    },

    // Web and xapp-mini: press-and-hold voice input (utils/web-speech.uts — Web Speech / WechatSI);
    // merged into the input like main.js:_onMicStop. Native keeps the onMicTap toast until an ASR
    // plugin exists.
    onMicStart(e : any) {
      if (this.typing || this.micRecording) return
      this.micRecording = startSpeech(this.lang, (text : string) => {
        this.micRecording = false
        if (text.length == 0) return
        const cur = this.chatInput
        this.chatInput = cur.length > 0 ? `${cur}${/\s$/.test(cur) ? '' : ' '}${text}` : text
      })
    },
    onMicEnd(e : any) {
      if (this.micRecording) stopSpeech()
    },

    onMicTap() {
      uni.showToast({ title: this.lang == 'zh' ? '语音输入即将上线' : 'Voice input coming soon', icon: 'none' })
    },

    // The context a toolbox tool runs against. Shared, because a tool starts two ways: the
    // toolbox tap (handleToolAction) and the chat classifier's launch_tool branch.
    _toolCtx() : ToolCtx {
      const ctx = new ToolCtx(
        (role : string, content : string, persist : boolean) : void => { this._addMsg(role, content, persist) },
        (url : string, method : string, body : UTSJSONObject | null, timeoutMs : number) : Promise<RespEnvelope> => this._req(url, method, body, timeoutMs),
        (v : boolean) : void => { this.typing = v }
      )
      ctx.addActionMsg = (action : string, label : string, persist : boolean) : void => { this._addActionMsg(action, label, persist) }
      ctx.addImageMsg = (tempPath : string) : string => this._addImageMsg(tempPath)
      ctx.updateImageMsg = (msgId : string, permanentUrl : string | null) : void => { this._updateImageMsg(msgId, permanentUrl) }
      ctx.onHealthReportPending = (payload : UTSJSONObject) : void => { this._startHealthReportConsent(payload) }
      // Fires when the backend acks with {processing:true} instead of the reply (async agentic
      // loop) — mirrors _sendMessage so the same status-caption/safety-timeout machinery in _poll
      // covers this path too.
      ctx.onAsyncStart = () : void => {
        this._beginChatWait(CHAT_WAIT_ASYNC_MS)
        this.typing = true
        this.chatStatusText = this.tr('chatThinking')
      }
      return ctx
    },

    // Opens the "a reply is pending" window _poll works against: while it is open the
    // chat_messages catch-up also replays ai rows (the durable backstop for the destructive
    // notification read), and the typing indicator stays up until a reply lands or budgetMs
    // elapses. Every wait goes through here so the budget can never be left over from a turn of
    // the other kind (§22).
    _beginChatWait(budgetMs : number) {
      this._chatWaitStartedAt = Date.now()
      this._chatWaitBudgetMs = budgetMs
    },

    handleToolAction(e : any | null) {
      // From the toolbox component: { action, tempFilePath? }.
      let action = ''
      let tempFilePath : string | null = null
      if (e != null) {
        const detail = e as UTSJSONObject
        action = detail.getString('action') ?? ''
        tempFilePath = detail.getString('tempFilePath')
      }
      const user = this.user
      const t = this.t
      if (this.typing || this.obStep != 'done') return
      this.toolboxOpen = false
      if (user == null) return
      const uid = user!.getString('user_id') ?? ''
      const ctx = this._toolCtx()
      if (action == 'test_chip') {
        this._addMsg('ai', tMainTr(t, 'kinoScanPrompt'), false)
        this.kinoScanPending = true
      } else if (action == 'formula_dots') {
        this._startFormulaDots(new ToolOpts())
      } else if (action == 'health_advice') {
        const opts = new ToolOpts()
        opts.async = true
        runHealthAdvice(uid, t, ctx, opts)
      } else if (action == 'upload_image') {
        // The xapp toolbox component picks the image itself (uni.chooseImage) and emits the
        // tempFilePath with the action; fall back to picking here if it doesn't.
        if (tempFilePath != null && tempFilePath!.length > 0) {
          doUpload(tempFilePath!, uid, t, ctx)
        } else {
          uni.chooseImage({
            count: 1,
            success: (res) => {
              const paths = res.tempFilePaths
              if (paths.length > 0) doUpload(`${paths[0]}`, uid, t, ctx)
            }
          })
        }
      }
    },

    _addImageMsg(imageUrl : string) : string {
      const id = `user-${Date.now()}`
      const msg = this._makeMsg(id, 'user', '', imageUrl, '', '', null, null)
      const prev = this.messages.length > 0 ? this.messages[this.messages.length - 1] : null
      this._applySeparators([msg], prev)
      this.messages = [...this.messages, msg]
      this._scrollBottom()
      return id
    },

    _updateImageMsg(id : string, imageUrl : string | null) {
      const out : ChatMsg[] = []
      for (const m of this.messages) {
        if (m.id == id) m.imageUrl = imageUrl
        out.push(m)
      }
      this.messages = out
    },

    _addActionMsg(action : string, label : string, persist : boolean) {
      const msg = this._makeMsg(`action-${action}-${Date.now()}`, 'action', '', null, action, label, null, null)
      const prev = this.messages.length > 0 ? this.messages[this.messages.length - 1] : null
      this._applySeparators([msg], prev)
      this.messages = [...this.messages, msg]
      this._scrollBottom()
      const user = this.user
      if (persist && user != null && (user!.getString('user_id') ?? '').length > 0) {
        this._req(`${BASE}/api/chat-messages`, 'POST', {
          openid: user!.getString('user_id'), role: 'action',
          content: JSON.stringify({ action: action, label: label } as UTSJSONObject),
        } as UTSJSONObject, 0).catch((e : any | null) => { if (IS_DEV) console.error('Persistent action failed', e) })
      }
    },

    handleMsgAction(action : string) {
      const t = this.t
      const user = this.user
      if (action == 'view_dots') {
        // Dots is a sub-tab under the 'plans' tab, NOT a top-level tab value — tab:'dots' matches
        // no WXML block and renders blank (real-device report, 2026-07-29).
        this.tab = 'plans'
        this.plansDotsSubTab = 'dots'
        this.dotsLoading = true
        this.cartridgesLoading = true
        if (user != null) {
          this._loadDots(user, this.lang)
          this._loadCartridges(user, this.lang)
        }
      } else if (action == 'verify_phone') {
        // No ?new=1 — an existing account being prompted later, not the brand-new-signup flow.
        uni.navigateTo({ url: '/pages/verify-phone/verify-phone' })
      } else if (action == 'hr_own_yes') {
        this._removeHrActions()
        this._addMsg('ai', tMainTr(t, 'hrAskSave'), false)
        this._addActionMsg('hr_save_yes', tMainTr(t, 'hrSave'), false)
        this._addActionMsg('hr_save_no', tMainTr(t, 'hrLater'), false)
      } else if (action == 'hr_own_no') {
        this._removeHrActions()
        this._pendingHealthReport = null
        this._addMsg('ai', tMainTr(t, 'hrNotOwn'), false)
      } else if (action == 'hr_save_yes') {
        this._removeHrActions()
        this._saveHealthReport()
      } else if (action == 'hr_save_no') {
        this._removeHrActions()
        this._pendingHealthReport = null
        this._addMsg('ai', tMainTr(t, 'hrNotSaved'), false)
      }
    },

    // Lab-report consent flow: triggered after analyze-image flags pending_health_report.
    _startHealthReportConsent(payload : UTSJSONObject | null) {
      if (payload == null) return
      this._pendingHealthReport = payload
      const t = this.t
      this._addMsg('ai', tMainTr(t, 'hrAskOwn'), false)
      this._addActionMsg('hr_own_yes', tMainTr(t, 'hrYes'), false)
      this._addActionMsg('hr_own_no', tMainTr(t, 'hrNo'), false)
    },

    _removeHrActions() {
      this.messages = this.messages.filter((m : ChatMsg) : boolean => !(m.role == 'action' && m.action.indexOf('hr_') == 0))
    },

    async _saveHealthReport() {
      const t = this.t
      const user = this.user
      const payload = this._pendingHealthReport
      if (payload == null || user == null) return
      this._pendingHealthReport = null
      this.typing = true
      try {
        const body = {
          openid: user!.getString('user_id'),
          oss_key: payload!.getString('oss_key'),
          get_url: payload!.getString('get_url'),
          report_date: payload!['report_date'],
          institution: payload!.getString('institution'),
          report_type: payload!.getString('report_type'),
          observations: payload!.getArray<UTSJSONObject>('observations') ?? ([] as UTSJSONObject[]),
          compute_bioage: true,
        } as UTSJSONObject
        const res = await this._req(`${BASE}/api/health-reports`, 'POST', body, 0)
        const d = res.data
        if (d != null && d!.getBoolean('success') == true) {
          let msg = tMainTr(t, 'hrSaved')
          if (d!.getBoolean('bioage_updated') == true) msg += ' ' + tMainTr(t, 'hrSavedBioage')
          this._addMsg('ai', msg, false)
          this._healthRefreshReports()
        } else {
          this._addMsg('ai', tMainTr(t, 'hrSaveError'), false)
        }
      } catch (err : any) {
        if (IS_DEV) console.error('save health report failed', err)
        this._addMsg('ai', tMainTr(t, 'hrSaveError'), false)
      } finally {
        this.typing = false
      }
    },

    cancelKinoScan() { this.kinoScanPending = false },

    handleKinoScan() {
      const user = this.user
      if (user == null) return
      this.kinoScanPending = false
      runTestChip(user!.getString('user_id') ?? '', this.t, this._toolCtx())
    },

    async handleSend() {
      const text = this.chatInput.trim()
      if (text.length == 0 || this.typing || this.obStep != 'done' || this.isSending) return
      this.chatInput = ''
      this.isSending = true
      await this._sendMessage(text)
      this.isSending = false
    },

    async _sendMessage(text : string) {
      const user = this.user
      if (user == null) return
      // A new turn: a reply rendered from here on (by either channel, even while the request
      // below is still in flight) is tagged with it — see _scopeAiDedupeToTurn.
      this._turnSeq += 1
      this._addMsg('user', text, false)
      this.typing = true
      this.chatStatusText = ''
      this.toolboxOpen = false
      try {
        // `client` gates the ::: display-card syntax server-side — this renderer understands the
        // fences. 30s: /api/chat holds the request open for the agentic loop; the client timeout
        // must not trip before the worker responds (the reply still arrives via the poller).
        const res = await this._req(`${BASE}/api/chat`, 'POST', { openid: user!.getString('user_id'), message: text, client: 'miniapp' } as UTSJSONObject, 30000)
        const d = res.data
        if (d != null && d!['recorded_weight'] != null) this._healthRefresh()
        this._scopeAiDedupeToTurn(d != null ? d!.getNumber('user_message_id') : null)
        // The classifier recognised an explicit "formulate my dots" request and handed the turn
        // to the toolbox tool — that tool is what actually produces a formulation, so running it
        // beats describing it. skipUserMsg: the user's own message already stands in the chat.
        if (d != null && d!.getString('launch_tool') == 'formula_dots') {
          const opts = new ToolOpts()
          opts.skipUserMsg = true
          this._startFormulaDots(opts)
          return
        }
        if (d != null && d!.getBoolean('processing') == true) {
          // The agentic loop runs asynchronously (chat.generate event) — keep the typing
          // indicator up with an evolving status caption; _poll clears it when the actual reply
          // (or the safety timeout) arrives. Immediate local caption so no gap before the first
          // server-sent status notification lands on the next 3s tick.
          this._beginChatWait(CHAT_WAIT_ASYNC_MS)
          this.chatStatusText = this.tr('chatThinking')
          return
        }
        // Sandbox sessions get the reply directly in the response (nothing was persisted to
        // notifications for polling to pick up).
        if (state.sandboxMode) {
          const reply = d != null ? d!.getString('reply') : null
          if (reply != null) this._addMsg('ai', reply!, false)
          this.typing = false
          this.chatStatusText = ''
          return
        }
        if (d != null && d!.getBoolean('success') == false) {
          this._addMsg('ai', this.tr('errServer'), false)
          this.typing = false
          this.chatStatusText = ''
          return
        }
        // Synchronous turn (casual_chat / emotional_support / record_weight shortcut): the reply
        // is already persisted (chat_messages + notifications row) but has NOT reached this page;
        // it arrives through _poll. Until 2026-09-13 this branch left delivery to the
        // notification channel ALONE — a DESTRUCTIVE read; one missed poll consumed the only copy
        // (reproduced live on dev with "你好"). Open the short sync wait window so _poll's
        // chat_messages replay backstops this path too, and poll right away instead of waiting
        // up to 3s for the next tick.
        this._beginChatWait(CHAT_WAIT_SYNC_MS)
        this._poll(user)
      } catch (e : any) {
        this._addMsg('ai', this.tr('errServer'), false)
        this.typing = false
        this.chatStatusText = ''
      }
    },

    // ── Polling ──
    _startPolling(user : UTSJSONObject) {
      this._stopPolling()
      this._poll(user)
      this._pollingTimer = setInterval(() => { this._poll(user) }, 3000)
    },

    _stopPolling() {
      if (this._pollingTimer != 0) clearInterval(this._pollingTimer)
      this._pollingTimer = 0
    },

    async _poll(user : UTSJSONObject) {
      if (this.obStep != 'done') return
      try {
        const res = await this._req(`${BASE}/api/notifications?openid=${user!.getString('user_id')}`, 'GET', null, 0)
        const notifications = res.data != null ? (res.data!.getArray<UTSJSONObject>('notifications') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        const unseen : UTSJSONObject[] = []
        for (const n of notifications) {
          const id = n.getNumber('id')
          if (id != null && !this._seenIds.has(id!)) unseen.push(n)
        }
        if (unseen.length > 0) {
          for (const n of unseen) { const id = n.getNumber('id'); if (id != null) this._seenIds.add(id!) }
          // 'chat_status' rows are transient "what I'm doing" captions from the async agentic loop
          // (makeStatusNotifier) — update the caption only, never add bubbles. Everything else
          // behaves as before and clears the caption/wait timer, since a real reply means done.
          let statusText = ''
          const realRows : UTSJSONObject[] = []
          for (const n of unseen) {
            if (n.getString('notification_type') == 'chat_status') statusText = n.getString('content') ?? ''
            else realRows.push(n)
          }
          if (statusText.length > 0) this.chatStatusText = statusText
          if (realRows.length > 0) {
            // A 'questionnaire_ready' row's content is just a placeholder caption — skip the
            // generic bubble so the user doesn't see a redundant one-liner immediately followed
            // by the form's own first question.
            let hasQuestionnaireReady = false
            for (const n of realRows) { if (n.getString('notification_type') == 'questionnaire_ready') hasQuestionnaireReady = true }
            // _isRenderedAi drops a row whose text the chat_messages catch-up below already
            // rendered. Only AI_ECHO_TYPES take part: a coach_reminder has no chat_messages row,
            // so registering it would make two genuinely separate identical reminders look like
            // a duplicate and swallow the second.
            const bubbleRows : UTSJSONObject[] = []
            for (const n of realRows) {
              const nt = n.getString('notification_type') ?? ''
              if (nt == 'questionnaire_ready') continue
              if (AI_ECHO_TYPES.has(nt) && this._isRenderedAi(n.getString('content') ?? '', false)) continue
              bubbleRows.push(n)
            }
            for (const n of bubbleRows) {
              const nt = n.getString('notification_type') ?? ''
              if (AI_ECHO_TYPES.has(nt)) this._markRenderedAi(n.getString('content') ?? '')
            }
            const newMsgs : ChatMsg[] = []
            for (const n of bubbleRows) {
              const nt = n.getString('notification_type') ?? ''
              // The notification type is the only attribution available on this channel — the
              // matching chat_messages row carries it durably for reloads.
              newMsgs.push(this._makeMsg(`n-${n.getNumber('id')}`, 'ai', n.getString('content') ?? '', null, '', '', null, AG_NOTIFICATION_TYPES.has(nt) ? 'viva_ag' : null))
            }
            // No "view plan" button on a 'nutrition_plan' row any more: Formulate-Dots writes a
            // 'proposed' plan with no schedules; the whole 28-day allocation lives in the message
            // itself as a :::formula card with its own order CTA.
            this._chatWaitStartedAt = 0
            if (newMsgs.length > 0) {
              const prev = this.messages.length > 0 ? this.messages[this.messages.length - 1] : null
              this._applySeparators(newMsgs, prev)
              this.messages = [...this.messages, ...newMsgs]
              this.typing = false
              this.chatStatusText = ''
              this._scrollBottom()
            } else {
              this.typing = false
              this.chatStatusText = ''
            }
            if (hasQuestionnaireReady) this._checkForPendingQuestionnaire()
            // A program day / recap just landed: its card's flags come from the server.
            let programRow = false
            for (const n of realRows) {
              const nt = n.getString('notification_type') ?? ''
              if (nt.indexOf('program_day') == 0) programRow = true
            }
            if (programRow) this._refreshProgramState()
          }
        }
      } catch (e : any) {}

      // Catch-up on what was written to chat_messages since the last tick. Coach messages, always;
      // ai replies ONLY while a turn is actually pending.
      //
      // That second half is the durable backstop for the async agentic turn. GET /api/notifications
      // is a DESTRUCTIVE read — the server marks rows 'sent' in the same statement that returns
      // them, no ack — so a single poll response this client never receives (app backgrounded
      // mid-request, network blip, request timeout) consumes the only copy of the reply and
      // strands the typing indicator forever. Confirmed live 2026-08-22 (health-advice reply saved
      // to chat_messages, notification marked 'sent' 81s after the request, still never reached the
      // device). chat_messages is not destructive, so replaying from it recovers exactly that case
      // within one 3s tick. Gated on _chatWaitStartedAt so this stays a recovery path, not a
      // second delivery channel. Runs BELOW the notification block and ABOVE the wait timeout on
      // purpose — the timeout must be the last thing considered, after both channels had their turn.
      if (this._lastMsgId != null) {
        try {
          const roles = this._chatWaitStartedAt > 0 ? 'coach,ai' : 'coach'
          const res = await this._req(`${BASE}/api/chat-history?openid=${encodeURIComponent(user!.getString('user_id') ?? '')}&since_id=${this._lastMsgId}&roles=${roles}`, 'GET', null, 0)
          const rows = res.data != null ? (res.data!.getArray<UTSJSONObject>('messages') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
          if (rows.length > 0) {
            let maxId = this._lastMsgId!
            for (const m of rows) { const id = m.getNumber('id'); if (id != null && id! > maxId) maxId = id! }
            this._lastMsgId = maxId
            // An ai row normally arrives here just after the notification channel already showed
            // the same text — drop those instead of double-rendering.
            const floor = this._aiRowFloor
            const fresh : UTSJSONObject[] = []
            for (const m of rows) {
              const role = m.getString('role') ?? ''
              if (role == 'coach') { fresh.push(m); continue }
              const id = m.getNumber('id')
              const anyTurn = floor != null && id != null && id! <= floor!
              if (!this._isRenderedAi(m.getString('content') ?? '', anyTurn)) fresh.push(m)
            }
            let gotAi = false
            for (const m of fresh) { if ((m.getString('role') ?? '') != 'coach') gotAi = true }
            for (const m of fresh) { if ((m.getString('role') ?? '') != 'coach') this._markRenderedAi(m.getString('content') ?? '') }
            if (fresh.length > 0) {
              const newMsgs : ChatMsg[] = []
              for (const m of fresh) newMsgs.push(this._fromHistoryRow(m, `c-${m.getNumber('id')}`))
              const prev = this.messages.length > 0 ? this.messages[this.messages.length - 1] : null
              this._applySeparators(newMsgs, prev)
              this.messages = [...this.messages, ...newMsgs]
              // Only an ai row ends the wait — a coach message arriving mid-turn says nothing about
              // whether the reply the user is waiting for has landed.
              if (gotAi) {
                this._chatWaitStartedAt = 0
                this.typing = false
                this.chatStatusText = ''
              }
              this._scrollBottom()
            }
          }
        } catch (e : any) {}
      }

      // Last resort: neither delivery channel produced anything within the whole server-side
      // budget, so the turn is genuinely lost (e.g. the chat.generate event never delivered) — say
      // so plainly instead of leaving the dots up forever. Must stay ABOVE the server's worst
      // case: TURN_DEADLINE_MS is 200s and grounding adds one more LLM call (~40-60s), a legit
      // turn measures ~266s (2026-08-22); at the old 180s this bound fired on turns going to
      // succeed. 285s also sits just past handleChatGenerateEvent's own 250s watchdog, so reaching
      // this line means even that never made it. A sync turn uses the much shorter CHAT_WAIT_SYNC_MS.
      const waitBudget = this._chatWaitBudgetMs > 0 ? this._chatWaitBudgetMs : CHAT_WAIT_ASYNC_MS
      if (this.typing && this._chatWaitStartedAt > 0 && Date.now() - this._chatWaitStartedAt > waitBudget) {
        this._chatWaitStartedAt = 0
        this._addMsg('ai', this.tr('chatTimedOut'), false)
        this.typing = false
        this.chatStatusText = ''
      }
    },

    // ── Onboarding handlers ──
    async handleSubmitName() {
      const name = this.obName.trim()
      if (name.length == 0) return
      this.obName = ''
      await this._saveAnswer(name, name)
    },

    async handleSelectButton(value : string) {
      const q = this.obQuestion
      let label = value
      if (q != null) {
        const cfg = q!.getJSON('config')
        const options = cfg != null ? (cfg!.getArray<UTSJSONObject>('options') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        for (const o of options) {
          if (o.getString('value') == value) { label = this.obOptionLabel(o); break }
        }
      }
      await this._saveAnswer(label, value)
    },

    // App(uni-app x) 5.08+: <picker mode="date"/"time"> is the supported picker (uni.showDatePicker does not exist).
    onObBirthdayChange(e : UniPickerChangeEvent) { this.obBirthday = e.detail.value as string },
    onObTimeChange(e : UniPickerChangeEvent) { this.obTime = e.detail.value as string },

    async handleSubmitTime() {
      if (this.obTime.length == 0) return
      await this._saveAnswer(this.obTime, this.obTime)
    },

    async handleSubmitBirthday() {
      if (this.obBirthday.length == 0) return
      await this._saveAnswer(this.obBirthday, this.obBirthday)
    },

    _applySliderValue(key : string, rawVal : number, step : number, min : number, max : number, hasRange : boolean) {
      let val = rawVal
      if (hasRange) val = Math.min(max, Math.max(min, val))
      if (step > 0) val = Math.round(val / step) * step
      const display = step < 1 ? val.toFixed(1) : `${val}`
      const sObj = new UTSJSONObject()
      this.obSliders.toMap().forEach((v : any | null, k : string) => { sObj[k] = v })
      sObj[key] = val
      const dObj = new UTSJSONObject()
      this.obSliderDisplay.toMap().forEach((v : any | null, k : string) => { dObj[k] = v })
      dObj[key] = display
      this.obSliders = sObj
      this.obSliderDisplay = dObj
      if (key == 'height') this.obHeight = val
      if (key == 'weight') this.obWeightDisplay = display
      if (key == 'weight') this.obWeight = val
    },

    // TODO(port): confirm slider change-event payload type at compile (detail.value).
    onSliderChange(key : string, e : any | null) {
      const q = this.obQuestion
      let step = 1
      if (q != null) {
        for (const s of this.obSlidersCfg()) { if (s.getString('key') == key) { step = s.getNumber('step') ?? 1; break } }
      }
      const val = e != null ? (e as UniSliderChangeEvent).detail.value : NaN
      if (isNaN(val)) return
      this._applySliderValue(key, val, step, 0, 0, false)
    },

    onSliderValueBlur(key : string) {
      let step = 1
      let min = 0
      let max = 0
      let hasRange = false
      for (const s of this.obSlidersCfg()) {
        if (s.getString('key') == key) {
          step = s.getNumber('step') ?? 1
          const mn = s.getNumber('min')
          const mx = s.getNumber('max')
          if (mn != null && mx != null && !isNaN(mn!) && !isNaN(mx!)) { min = mn!; max = mx!; hasRange = true }
          break
        }
      }
      const el = uni.getElementById('sl-' + key)
      let val = el != null ? parseFloat((el as UniInputElement).value) : NaN
      if (isNaN(val)) val = this.obSliders.getNumber(key) ?? 0
      this._applySliderValue(key, val, step, min, max, hasRange)
    },

    onSliderStep(key : string, dir : number) {
      let step = 1
      let min = 0
      let max = 0
      let hasRange = false
      for (const s of this.obSlidersCfg()) {
        if (s.getString('key') == key) {
          step = s.getNumber('step') ?? 1
          const mn = s.getNumber('min')
          const mx = s.getNumber('max')
          if (mn != null && mx != null) { min = mn!; max = mx!; hasRange = true }
          break
        }
      }
      const current = this.obSliders.getNumber(key) ?? 0
      this._applySliderValue(key, current + dir * step, step, min, max, hasRange)
    },

    async handleSubmitBody() {
      const sliders = this.obSlidersCfg()
      const lang = this.lang
      const parts : string[] = []
      const answer = new UTSJSONObject()
      for (const s of sliders) {
        const key = s.getString('key') ?? ''
        const lbl = this.obSliderLabel(s)
        const dv = this.obSliderValStr(key)
        parts.push(`${lbl}: ${dv}${s.getString('unit') ?? ''}`)
        answer[key] = this.obSliders.getNumber(key)
      }
      await this._saveAnswer(parts.join('  '), answer)
    },

    handleToggleCondition(key : string) {
      let list : UTSJSONObject[]
      if (key == 'none') {
        // selecting "none" clears everything else
        list = this.obConditionList.map((item : UTSJSONObject) : UTSJSONObject => {
          return { key: item.getString('key'), label: item.getString('label'), selected: item.getString('key') == 'none' } as UTSJSONObject
        })
      } else {
        // selecting any real option deselects "none", then toggles the tapped item
        list = this.obConditionList.map((item : UTSJSONObject) : UTSJSONObject => {
          const k = item.getString('key') ?? ''
          if (k == 'none') return { key: k, label: item.getString('label'), selected: false } as UTSJSONObject
          if (k == key) return { key: k, label: item.getString('label'), selected: item.getBoolean('selected') != true } as UTSJSONObject
          return { key: k, label: item.getString('label'), selected: item.getBoolean('selected') == true } as UTSJSONObject
        })
      }
      let otherSelected = false
      const selectedKeys : string[] = []
      for (const i of list) {
        if (i.getBoolean('selected') == true) {
          if (i.getString('key') == 'other') otherSelected = true
          const k = i.getString('key')
          if (k != null) selectedKeys.push(k!)
        }
      }
      this.obConditionList = list
      this.obConditions = selectedKeys
      this.obOtherSelected = otherSelected
      if (!otherSelected) this.obConditionsOther = ''
    },

    async handleSubmitConditions() {
      const otherText = this.obOtherSelected ? this.obConditionsOther.trim() : ''
      const sep = this.lang == 'zh' ? '、' : ', '
      const selectedLabels : string[] = []
      for (const i of this.obConditionList) {
        if (i.getBoolean('selected') != true) continue
        const label = i.getString('label') ?? ''
        const key = i.getString('key') ?? ''
        selectedLabels.push(key == 'other' && otherText.length > 0 ? `${label}（${otherText}）` : label)
      }
      const displayText = selectedLabels.length > 0 ? selectedLabels.join(sep) : this.tr('obConditionsNone')
      await this._saveAnswer(displayText, this.obConditions)

      // Also persist 'other' free-text to bio_data via a separate update.
      const q = this.obQuestion
      if (otherText.length > 0 && q != null) {
        const cfg = q!.getJSON('config')
        const otherKey = cfg != null ? cfg!.getString('other_key') : null
        const user = this.user
        if (otherKey != null && otherKey!.length > 0 && user != null) {
          const bio = new UTSJSONObject()
          bio[otherKey!] = otherText
          this._saveUser(user, { bio_data: bio } as UTSJSONObject).catch((e : any | null) => {})
        }
      }
    },

    // ── User state ──
    _updateUser(updated : UTSJSONObject) {
      state.user = updated
      uni.setStorageSync('nano_user', updated)
      this.user = updated
      this.userAvatarLetter = this._avatarLetter(updated.getString('nickname'))
    },

    // phone/email/language/coach_id are deliberately omitted from the base object (only sent when
    // a caller explicitly includes one via `updates`) — user.phone/email are stripped from the
    // cached session and resending them unconditionally risked silently wiping a verified phone on
    // every unrelated save (real incident). handlePutUser treats an omitted key as "leave
    // untouched", so omitting here is the correct, safe default.
    _saveUser(user : UTSJSONObject, updates : UTSJSONObject | null) : Promise<RespEnvelope> {
      const body = {
        nickname: user.getString('nickname'), gender: user.getString('gender'), birth_date: user.getString('birth_date'),
      } as UTSJSONObject
      if (updates != null) updates!.toMap().forEach((v : any | null, k : string) => { body[k] = v })
      return this._req(`${BASE}/api/users/${user.getString('user_id')}`, 'PUT', body, 0)
    },

    // ── Dots tab ──
    async _loadDots(user : UTSJSONObject, lang : string) {
      this._dotsLoadedAt = Date.now()
      try {
        const res = await this._req(`${BASE}/api/nutrition-plan?openid=${encodeURIComponent(user!.getString('user_id') ?? '')}`, 'GET', null, 0)
        const d = res.data
        const plan = d != null ? d!.getString('plan') : null
        const structured = d != null ? d!.getJSON('structured_plan') : null
        const schedules = d != null ? (d!.getArray<UTSJSONObject>('schedules') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        const dotsArr = d != null ? (d!.getArray<UTSJSONObject>('dots') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        const dotsMap = new UTSJSONObject()
        for (const dot of dotsArr) {
          const kn = dot.getString('key_name')
          if (kn != null) dotsMap[kn!] = dot
        }

        let allDays : UTSJSONObject[] = []
        if (structured != null && schedules.length > 0) {
          allDays = mapStructuredSchedules(schedules, dotsMap, lang)
        } else if (plan != null && plan!.length > 0) {
          allDays = parsePlan(plan, dotsMap, lang)
        }
        this._dotsAllDays = allDays

        let todayDay : UTSJSONObject | null = null
        for (const day of allDays) { if (day.getBoolean('isToday') == true) { todayDay = day; break } }
        const dispenseSlot = new Date().getHours() < 12 ? 'morning_cup' : 'evening_cup'
        let dispenseSlotDots : UTSJSONObject[] = []
        if (todayDay != null) {
          dispenseSlotDots = todayDay!.getArray<UTSJSONObject>(dispenseSlot == 'morning_cup' ? 'morning' : 'evening') ?? ([] as UTSJSONObject[])
        }

        const packages = mapPackages(d != null ? d!.getArray<UTSJSONObject>('packages') : null, lang)
        const codes = mapCodes(d != null ? d!.getArray<UTSJSONObject>('codes') : null, lang)
        let proposed : UTSJSONObject | null = null
        let inFlight = false
        let hasProposed = false
        for (const p of packages) {
          const stage = p.getString('stage') ?? ''
          if (stage == 'proposed' && proposed == null) proposed = p
          if (p.getBoolean('inFlight') == true) inFlight = true
          if (stage == 'proposed') hasProposed = true
        }

        this.dotsLoading = false
        // hasPlan stays 'active'-only, deliberately. `packages` is a sibling of the plan fields
        // and must NEVER feed it — §28b records the bug where a proposal made this tab report a
        // plan the user did not physically have.
        this.hasPlan = structured != null || (plan != null && plan!.length > 0)
        this.packages = packages
        // Buying a second package while one is in flight is refused by GCN
        // (formulation_already_in_progress), so the order card hides rather than dead-ending.
        this.hasPackageInFlight = inFlight
        this.hasProposedFormula = hasProposed
        this.codes = codes
        this.proposedDistinctDots = proposed != null ? proposed!.getNumber('distinct_dots') : null
        const tw = proposed != null ? proposed!.getArray<number>('tier_widths') : null
        this.proposedTierWidths = tw != null ? tw : null
        this.dispenseSlot = dispenseSlot
        this.dispenseSlotDots = dispenseSlotDots
        this.dispenseDate = localISODate(new Date())
        this.dispenseHasToday = todayDay != null
        this.dispenseStatus = ''
        this._applyDotsWeek(0)
        // A formula card delivered before this resolved would be offering to BUY a package the
        // user already holds a code for — re-resolve the cards the moment the codes land.
        this._refreshFormulaCtas()
      } catch (e : any) {
        this.dotsLoading = false
        this.hasPlan = false
        this.packages = [] as UTSJSONObject[]
        this.hasPackageInFlight = false
        this.hasProposedFormula = false
        this.codes = [] as UTSJSONObject[]
        this.proposedDistinctDots = null
        this.proposedTierWidths = null
        // Same reason in reverse: a card must not keep offering 开始配制 against a cleared codes list.
        this._refreshFormulaCtas()
      }
    },

    // Slices the full (up to 28-day) plan cached in _dotsAllDays down to one calendar Mon-Sun week
    // for the card scroller, so paging weeks is instant and needs no refetch.
    _applyDotsWeek(offset : number) {
      const allDays = this._dotsAllDays
      const week = getWeekRange(offset)
      const monday = week.getString('monday') ?? ''
      const sunday = week.getString('sunday') ?? ''
      this.weekLabel = fmtWeekLabel(monday, sunday, this.lang)
      const dotsDays : UTSJSONObject[] = []
      let todayIndex = -1
      for (let i = 0; i < allDays.length; i++) {
        const ds = allDays[i].getString('dateStr') ?? ''
        if (ds.length > 0 && ds >= monday && ds <= sunday) {
          if (allDays[i].getBoolean('isToday') == true && todayIndex < 0) todayIndex = dotsDays.length
          dotsDays.push(allDays[i])
        }
      }
      let todayScrollLeft = 0
      if (todayIndex >= 0) {
        const windowWidth = this._screenW
        const r = windowWidth / 750
        const cardPx = windowWidth * 0.7
        const gapPx = 16 * r
        const padPx = 28 * r
        todayScrollLeft = Math.max(0, todayIndex * (cardPx + gapPx) + padPx - (windowWidth - cardPx) / 2)
      }
      const hasPrevWeek = allDays.length > 0 && (allDays[0].getString('dateStr') ?? '') < monday
      const hasNextWeek = allDays.length > 0 && (allDays[allDays.length - 1].getString('dateStr') ?? '') > sunday
      this.dotsWeekOffset = offset
      this.dotsDays = dotsDays
      this.todayScrollLeft = Math.round(todayScrollLeft)
      this.hasPrevWeek = hasPrevWeek
      this.hasNextWeek = hasNextWeek
    },

    handleDotsPrevWeek() {
      if (!this.hasPrevWeek) return
      this._applyDotsWeek(this.dotsWeekOffset - 1)
    },
    handleDotsNextWeek() {
      if (!this.hasNextWeek) return
      this._applyDotsWeek(this.dotsWeekOffset + 1)
    },

    async _loadCartridges(user : UTSJSONObject, lang : string) {
      try {
        const res = await this._req(`${BASE}/api/my-cartridges?openid=${encodeURIComponent(user!.getString('user_id') ?? '')}`, 'GET', null, 0)
        const raw = res.data != null ? (res.data!.getArray<UTSJSONObject>('cartridges') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        this.cartridgesLoading = false
        this.cartridges = mapCartridges(raw, lang)
      } catch (e : any) {
        this.cartridgesLoading = false
      }
    },

    async dispenseToday() {
      if (this.dispenseStatus == 'loading' || this.dispenseStatus == 'done') return
      if (this.dispenseSlotDots.length == 0) return
      const user = this.user
      if (user == null) return
      this.dispenseStatus = 'loading'
      try {
        const dispensed = new UTSJSONObject()
        for (const dot of this.dispenseSlotDots) {
          const dk = dot.getString('displayKey') ?? ''
          // 'D01' → 'DOT01' exactly as the source builds the key.
          dispensed['DOT' + dk.substring(1)] = dot.getNumber('count')
        }
        const res = await this._req(`${BASE}/api/dispense`, 'POST', {
          openid: user!.getString('user_id'), slot: this.dispenseSlot, date: this.dispenseDate, dispensed: dispensed,
        } as UTSJSONObject, 0)
        if (res.data != null && res.data!.getBoolean('success') == true) {
          this.dispenseStatus = 'done'
          this._loadCartridges(user, this.lang)
        } else {
          this.dispenseStatus = 'error'
        }
      } catch (e : any) {
        this.dispenseStatus = 'error'
      }
    },

    // TODO(port): NFC tag emulation — the miniapp's "auto-generates NFC tags and inserts" is
    // simulator-only fabrication (SIM-<dot>-<ts>-<i>); the /api/cartridge-insert payload is kept.
    openCartSim() {
      const lang = this.lang
      const sets : UTSJSONObject[] = []
      for (const s of CART_SETS) {
        const dotItems = s.getArray<UTSJSONObject>('dotItems') ?? ([] as UTSJSONObject[])
        const shown : UTSJSONObject[] = []
        const dotsRaw : string[] = []
        for (const di of dotItems) {
          const key = di.getString('key') ?? ''
          shown.push({
            displayKey: key.split('DOT').join('D'),
            dotName: lang == 'zh' ? (di.getString('zhName') ?? '') : (di.getString('enName') ?? ''),
          } as UTSJSONObject)
          dotsRaw.push(key)
        }
        sets.push({
          key: s.getString('key'),
          name: lang == 'zh' ? s.getString('nameZh') : s.getString('nameEn'),
          desc: lang == 'zh' ? s.getString('descZh') : s.getString('descEn'),
          color: s.getString('color'),
          dotItems: shown,
          dots_raw: dotsRaw,
        } as UTSJSONObject)
      }
      this.simCartOpen = true
      this.simCartSets = sets
    },

    closeCartSim() {
      this.simCartOpen = false
      this.simCartLoading = false
    },

    async handleSelectCartSet(index : number) {
      if (this.simCartLoading) return
      const set = index < this.simCartSets.length ? this.simCartSets[index] : null
      const user = this.user
      if (set == null || user == null) return
      this.simCartLoading = true
      const dotsRaw = set!.getArray<string>('dots_raw') ?? ([] as string[])
      try {
        const ts = Date.now()
        const jobs : Promise<RespEnvelope>[] = []
        for (let i = 0; i < dotsRaw.length; i++) {
          const dotKey = dotsRaw[i]
          jobs.push(this._req(`${BASE}/api/cartridge-insert`, 'POST', {
            openid: user!.getString('user_id'),
            nfc_tag_id: `SIM-${dotKey}-${ts}-${i}`,
            dot_key: dotKey,
          } as UTSJSONObject, 0))
        }
        await Promise.all(jobs)
        uni.showToast({ title: this.tr('simCartDone'), icon: 'success', duration: 1500 })
      } catch (e : any) {
        uni.showToast({ title: this.tr('errServer'), icon: 'none', duration: 2000 })
      }
      this.simCartOpen = false
      this.simCartLoading = false
      this.cartridgesLoading = true
      this._loadCartridges(user, this.lang)
    },

    // ── Store tab ──
    async _loadStore(user : UTSJSONObject, lang : string) {
      try {
        const uid = user!.getString('user_id')
        const openid = uid != null && uid!.length > 0 ? `?openid=${encodeURIComponent(uid!)}` : ''
        const res = await this._req(`${BASE}/api/store-items${openid}`, 'GET', null, 0)
        const raw = res.data != null ? (res.data!.getArray<UTSJSONObject>('items') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        this._rawStoreItems = raw
        this.storeLoading = false
        this.storeItems = mapStoreItems(raw, lang)
      } catch (e : any) {
        this.storeLoading = false
      }
      await this._loadStoreOrders(user, lang)
    },

    async _loadCreditBalance(user : UTSJSONObject) {
      const uid = user!.getString('user_id')
      if (uid == null || uid!.length == 0) return
      try {
        const res = await this._req(`${BASE}/api/credits/balance?user_id=${encodeURIComponent(uid!)}`, 'GET', null, 0)
        const d = res.data
        if (d != null && d!.getBoolean('success') == true) {
          this.creditBalance = d!.getNumber('balance') ?? 0
          this.creditCurrency = d!.getString('currency') ?? 'CNY'
        }
      } catch (e : any) {}
    },

    // persona_type + viva_subscription_expires_at in one small dedicated endpoint (not threaded
    // through login's many branched user-lookup queries). Drives the redeem menu entry and the
    // expired banner.
    async _loadVivaSubscriptionStatus(user : UTSJSONObject) {
      const uid = user!.getString('user_id')
      if (uid == null || uid!.length == 0) return
      try {
        const res = await this._req(`${BASE}/api/viva-subscription-status?openid=${encodeURIComponent(uid!)}`, 'GET', null, 0)
        const d = res.data
        if (d != null && d!.getBoolean('success') == true) {
          const expiresAt = d!.getString('viva_subscription_expires_at') ?? ''
          const personaType = d!.getString('persona_type') ?? 'nano'
          const vivaSubscriptionExpired = personaType == 'viva' && (expiresAt.length == 0 || _parseMs(expiresAt) <= Date.now())
          this.personaType = personaType
          this.vivaSubscriptionExpiresAt = expiresAt
          this.vivaSubscriptionExpiresAtDisplay = expiresAt.length > 0 ? fmtDate(expiresAt, this.lang) : ''
          this.vivaSubscriptionExpired = vivaSubscriptionExpired
          // Viva AG add-on — drives the health tab's subtab strip. Cosmetic; the server re-checks.
          this.vivaAgActive = d!.getBoolean('viva_ag_active') == true
        }
      } catch (e : any) {}
    },

    async _loadStoreOrders(user : UTSJSONObject, lang : string) {
      try {
        const res = await this._req(`${BASE}/api/my-orders?openid=${encodeURIComponent(user!.getString('user_id') ?? '')}`, 'GET', null, 0)
        const raw = res.data != null ? (res.data!.getArray<UTSJSONObject>('orders') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        this._rawStoreOrders = raw
        this.storeOrders = mapStoreOrders(raw, lang)
      } catch (e : any) {}
    },

    switchStoreTab(tabKey : string) { this.storeSubTab = tabKey },

    _syncCart(cart : UTSJSONObject[]) {
      const lang = this.lang
      const cartMap = new UTSJSONObject()
      let total = 0.0
      let count = 0
      let allCredits = cart.length > 0
      for (const entry of cart) {
        if (entry.getBoolean('useCredits') != true) allCredits = false
      }
      for (const entry of cart) {
        cartMap[this.idStr(entry, 'id')] = entry.getNumber('quantity')
        total += (entry.getNumber('rawPrice') ?? 0) * (entry.getNumber('quantity') ?? 0)
        count += entry.getNumber('quantity') ?? 0
      }
      const totalRounded = Math.round(total * 100) / 100
      const cartTotal = allCredits
        ? `${totalRounded} ${lang == 'zh' ? '积分' : 'pts'}`
        : (lang == 'zh' ? `¥${totalRounded}` : `$${Math.round(total / 7.2)}`)
      this.cart = cart
      this.cartMap = cartMap
      this.cartCount = count
      this.cartTotal = cartTotal
      try { uni.setStorageSync('nano_cart', cart) } catch (e : any) {}
    },

    // Template helpers for the cart. ids ride the wire as number OR string (store items /
    // variants) — compare on the stringified raw value, which the source's `x.id === id` did
    // implicitly.
    idStr(o : UTSJSONObject, key : string) : string {
      const raw = o[key]
      return raw != null ? `${raw}` : ''
    },
    cartQty(id : string) : number {
      const v = this.cartMap.getNumber(id)
      return v != null ? v! : 0
    },
    variantOrItemId(item : UTSJSONObject) : string {
      const sel = this.idStr(item, 'selectedVariantId')
      if (sel.length > 0 && sel != 'null') return sel
      return this.idStr(item, 'id')
    },
    durLabel(seconds : number | null) : string {
      const s = seconds ?? 0
      if (s >= 60) return `${Math.floor(s / 60)} 分钟`
      return `${s} 秒`
    },

    handleAddToCart(index : number) {
      if (this.isGuest) { this.openGuestSheet(); return }
      const item = index < this.storeItems.length ? this.storeItems[index] : null
      if (item == null) return
      const variants = item!.getArray<UTSJSONObject>('variants') ?? ([] as UTSJSONObject[])
      if (variants.length > 0) {
        const selStr = this.idStr(item!, 'selectedVariantId')
        const sel : string | null = selStr.length > 0 && selStr != 'null' ? selStr : null
        if (sel == null) {
          uni.showToast({ title: this.lang == 'zh' ? '请先选择规格' : 'Please select a size', icon: 'none', duration: 1500 })
          return
        }
        let variant : UTSJSONObject | null = null
        for (const v of variants) { if (this.idStr(v, 'id') == sel) { variant = v; break } }
        const cartItem = this._copyItemForCart(item!, variant, `${sel}`)
        this._pushCart(cartItem)
        return
      }
      const cartItem = this._copyItemForCart(item!, null, this.idStr(item!, 'id'))
      this._pushCart(cartItem)
    },

    _copyItemForCart(item : UTSJSONObject, variant : UTSJSONObject | null, id : string) : UTSJSONObject {
      const row = new UTSJSONObject()
      item.toMap().forEach((v : any | null, k : string) => { row[k] = v })
      row['id'] = id
      if (variant != null) {
        row['name'] = `${item.getString('name') ?? ''} ${variant!.getString('label') ?? ''}`
        row['variants'] = null
      }
      return row
    },

    _pushCart(cartItem : UTSJSONObject) {
      const cart : UTSJSONObject[] = []
      let bumped = false
      const id = this.idStr(cartItem, 'id')
      for (const x of this.cart) {
        if (this.idStr(x, 'id') == id) {
          const row = this._copyRow(x)
          row['quantity'] = (x.getNumber('quantity') ?? 0) + 1
          cart.push(row)
          bumped = true
        } else {
          cart.push(x)
        }
      }
      if (!bumped) {
        const row = this._copyRow(cartItem)
        row['quantity'] = 1
        cart.push(row)
      }
      this._syncCart(cart)
    },

    _copyRow(x : UTSJSONObject) : UTSJSONObject {
      const row = new UTSJSONObject()
      x.toMap().forEach((v : any | null, k : string) => { row[k] = v })
      return row
    },

    handleSelectVariant(itemId : string, variantId : string) {
      this.storeItems = this.storeItems.map((it : UTSJSONObject) : UTSJSONObject => {
        if (this.idStr(it, 'id') != itemId) return it
        const row = this._copyRow(it)
        row['selectedVariantId'] = variantId
        return row
      })
    },

    handleCartQtyChange(id : string, delta : number) {
      const cart : UTSJSONObject[] = []
      for (const x of this.cart) {
        if (this.idStr(x, 'id') == id) {
          const row = this._copyRow(x)
          const q = (x.getNumber('quantity') ?? 0) + delta
          if (q > 0) { row['quantity'] = q; cart.push(row) }
        } else {
          cart.push(x)
        }
      }
      this._syncCart(cart)
    },

    handleOpenCart() { this.cartOpen = true },
    handleCloseCart() {
      this.cartOpen = false
      this.checkoutName = ''
      this.checkoutPhone = ''
      this.checkoutAddress = ''
    },

    async handleCheckout() {
      if (this.isGuest) { this.openGuestSheet(); return }
      const user = this.user
      if (user == null) return
      if (this.cart.length == 0) return
      const items : UTSJSONObject[] = this.cart.map((x : UTSJSONObject) : UTSJSONObject => {
        return { channel_inventory_item_id: x['id'], quantity: x['quantity'] } as UTSJSONObject
      })
      let useCredits = true
      for (const x of this.cart) { if (x.getBoolean('useCredits') != true) useCredits = false }
      let needCredits = 0
      if (useCredits) {
        for (const x of this.cart) needCredits += (x.getNumber('rawPrice') ?? 0) * (x.getNumber('quantity') ?? 0)
      }
      const showInsufficient = () => {
        uni.showModal({
          title: this.tr('checkoutInsufficientTitle'),
          content: this.tr('checkoutInsufficientMsg').split('{need}').join(`${Math.round(needCredits)}`).split('{have}').join(`${this.creditBalance}`),
          showCancel: false,
          confirmText: 'OK',
        })
      }
      // Credit-paid orders: stop before submitting if the balance can't cover the cart.
      if (useCredits && this.creditBalance < needCredits) { showInsufficient(); return }

      const submitBatchOrder = async (shippingName : string, shippingPhone : string, shippingAddress : string) : Promise<void> => {
        try {
          uni.showLoading({ title: this.tr('storeOrderSent'), mask: true })
          const res = await this._req(`${BASE}/api/orders/batch`, 'POST', {
            openid: user!.getString('user_id'),
            items: items,
            shipping_name: shippingName,
            shipping_phone: shippingPhone,
            shipping_address: shippingAddress,
            payment_method: useCredits ? 'credits' : 'wechat_pay',
            payment_status: 'paid',
          } as UTSJSONObject, 0)
          uni.hideLoading()
          // uni.request resolves on HTTP 4xx/5xx too — must check the payload.
          const d = res.data
          if (d == null || d!.getBoolean('success') != true) {
            const errMsg = d != null ? (d!.getString('error') ?? '') : ''
            if (/insufficient credits/i.test(errMsg)) {
              await this._loadCreditBalance(user) // refresh stale balance, then notify
              showInsufficient()
            } else {
              uni.showToast({ title: this.tr('errServer'), icon: 'none', duration: 2500 })
            }
            return
          }
          uni.showToast({ title: this.tr('storeOrderSent'), icon: 'success', duration: 2500 })
          this._syncCart([] as UTSJSONObject[])
          this.cartOpen = false
          this.checkoutName = ''
          this.checkoutPhone = ''
          this.checkoutAddress = ''
          await this._loadStoreOrders(user, this.lang)
          this.storeSubTab = 'orders'
          this._loadCreditBalance(user) // reflect the debit
        } catch (err : any) {
          uni.hideLoading()
          uni.showToast({ title: this.tr('errServer'), icon: 'none', duration: 2500 })
        }
      }

      const name = this.checkoutName.trim()
      const phone = this.checkoutPhone.trim()
      const address = this.checkoutAddress.trim()
      if (name.length > 0 && phone.length > 0 && address.length > 0) {
        await submitBatchOrder(name, phone, address)
        return
      }
      // Address incomplete — open cart, pre-fill name/phone, then try the WeChat address book.
      this.cartOpen = true
      this.checkoutName = name.length > 0 ? name : (user!.getString('nickname') ?? '')
      this.checkoutPhone = phone.length > 0 ? phone : (user!.getString('phone') ?? '')
      if (address.length == 0) this.fetchWechatAddress('checkout')
    },

    // WeChat address book (xapp-mini): fills name, phone and address of the checkout or the
    // code-ship form. Needs "chooseAddress" in requiredPrivateInfos (manifest.json) and in the
    // appid's privacy guide. Native has no address book, so it is a no-op there: manual entry.
    fetchWechatAddress(prefix : string) {
      // Off until the chooseAddress privacy interface is approved (WX_ADDRESS_ENABLED, config.uts).
      if (!WX_ADDRESS_ENABLED) return
      // #ifdef MP-WEIXIN
      wx.chooseAddress({
        // WeChat hands back plain objects, not UTSJSONObject — read fields directly (as
        // utils/wearable/transport-mp.uts does).
        success: (a : any) => {
          const name = a.userName != null ? `${a.userName}` : ''
          const tel = a.telNumber != null ? `${a.telNumber}` : ''
          const full = _joinAddress([a.provinceName, a.cityName, a.countyName, a.detailInfo])
          if (prefix == 'codeShip') {
            if (name.length > 0) this.codeShipName = name
            if (tel.length > 0) this.codeShipPhone = tel
            this.codeShipAddress = full
          } else {
            if (name.length > 0) this.checkoutName = name
            if (tel.length > 0) this.checkoutPhone = tel
            this.checkoutAddress = full
          }
        },
        fail: (err : any) => {
          const errMsg = err != null && err.errMsg != null ? `${err.errMsg}` : ''
          console.log(JSON.stringify({ level: 'WARN', msg: 'wx.chooseAddress failed', data: { errMsg } }))
          // Dismissed or denied — stay silent, the manual form is right there.
          if (/cancel|deny/i.test(errMsg)) return
          // A real failure (e.g. the privacy declaration missing) — say to fill it in by hand.
          uni.showToast({ title: this.tr('checkoutWxAddressFail'), icon: 'none', duration: 2500 })
        },
      } as any)
      // #endif
    },

    async handleCancelOrder(orderId : string) {
      const user = this.user
      if (user == null) return
      const lang = this.lang
      uni.showModal({
        title: lang == 'zh' ? '取消订单' : 'Cancel Order',
        content: lang == 'zh' ? '您确定要取消此订单吗？' : 'Are you sure you want to cancel this order?',
        confirmColor: '#ef4444',
        success: (res) => { (async () : Promise<void> => {
          if (!res.confirm) return
          try {
            await this._req(`${BASE}/api/orders/${orderId}`, 'PUT', { status: 'cancelled' } as UTSJSONObject, 0)
            uni.showToast({ title: lang == 'zh' ? '订单已取消' : 'Order cancelled', icon: 'success' })
            await this._loadStoreOrders(user, lang)
          } catch (err : any) {
            uni.showToast({ title: this.tr('errServer'), icon: 'none' })
          }
        })() }
      })
    },

    handleCopyTracking(tracking : string) {
      uni.setClipboardData({
        data: tracking,
        success: () => {
          uni.showToast({ title: this.lang == 'zh' ? '单号已复制' : 'Tracking copied', icon: 'success' })
        }
      })
    },

    // ── Health Plans ──
    async _loadPlans(user : UTSJSONObject, lang : string) {
      this._plansLoadedAt = Date.now()
      try {
        const uid = encodeURIComponent(user!.getString('user_id') ?? '')
        const plansRes = await this._req(`${BASE}/api/health-plans?openid=${uid}`, 'GET', null, 0)
        const tplRes = await this._req(`${BASE}/api/health-plan-templates`, 'GET', null, 0)
        const now = Date.now()
        const rawPlans = plansRes.data != null ? (plansRes.data!.getArray<UTSJSONObject>('plans') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        const plans : UTSJSONObject[] = []
        const enrolledIds = new Set<number>()
        let hasPrimary = false
        let hasSecondary = false
        for (const p of rawPlans) {
          const totalWeeks = p.getNumber('duration_weeks') ?? p.getNumber('template_duration_weeks') ?? 4
          const startMs = _parseMs(p['start_date'])
          const weeksElapsed = Math.max(0, Math.floor((now - startMs) / (7 * 86400000)))
          const progressPct = Math.min(100, Math.round(weeksElapsed / (totalWeeks ?? 4) * 100))
          const checkins = p.getNumber('checkin_count') ?? 0
          const daysSinceStart = Math.max(1, Math.floor((now - startMs) / 86400000))
          const adherencePct = Math.min(100, Math.round(checkins / daysSinceStart * 100))
          const tc = p.getJSON('today_checkin')
          const acts = tc != null ? (tc!.getArray<string>('activities_done') ?? ([] as string[])) : ([] as string[])
          const dotsTaken = tc != null && tc!.getBoolean('dots_taken') == true
          // Daily task chips: template-driven when the plan carries daily_tasks, else the three
          // defaults. Done-state is derived server-side from today's checkin row, never locally.
          const taskDone = new Map<string, boolean>()
          taskDone.set('dots', dotsTaken)
          taskDone.set('weight', acts.indexOf('weight_logged') >= 0)
          taskDone.set('questions', acts.indexOf('daily_questions') >= 0)
          let templateTasks = p.getArray<UTSJSONObject>('daily_tasks')
          if (templateTasks == null || templateTasks!.length == 0) {
            templateTasks = [
              { key: 'dots', label_zh: '服用原粒', label_en: 'Dots', enabled: true } as UTSJSONObject,
              { key: 'weight', label_zh: '记录体重', label_en: 'Weight', enabled: true } as UTSJSONObject,
              { key: 'questions', label_zh: '每日问答', label_en: 'Questions', enabled: true } as UTSJSONObject,
            ] as UTSJSONObject[]
          }
          const todayTasks : UTSJSONObject[] = []
          for (const task of templateTasks!) {
            if (task.getBoolean('enabled') != true) continue
            const key = task.getString('key') ?? ''
            todayTasks.push({
              key: key, labelZh: task.getString('label_zh'), labelEn: task.getString('label_en'),
              done: taskDone.get(key) == true,
            } as UTSJSONObject)
          }
          const total = todayTasks.length > 0 ? todayTasks.length : 1
          let doneCount = 0
          for (const tt of todayTasks) { if (tt.getBoolean('done') == true) doneCount++ }
          const row = this._copyRow(p)
          row['name_zh'] = p.getString('name_zh') ?? p.getString('custom_name_zh') ?? ''
          row['name_en'] = p.getString('name_en') ?? p.getString('custom_name_en') ?? ''
          row['totalWeeks'] = totalWeeks
          row['weeksDone'] = weeksElapsed
          row['progressPct'] = progressPct
          row['adherencePct'] = adherencePct
          row['checkedInToday'] = (p.getNumber('checked_in_today') ?? 0) > 0
          row['todayTasks'] = todayTasks
          row['todayDoneCount'] = doneCount
          row['todayProgressPct'] = Math.round(doneCount / total * 100)
          row['today_dots_taken'] = dotsTaken
          row['today_activities'] = acts
          plans.push(row)
          const tid = p.getNumber('template_id')
          if (tid != null) enrolledIds.add(tid!)
          const ptype = p.getString('plan_type')
          if (ptype == 'primary') hasPrimary = true
          if (ptype == 'secondary') hasSecondary = true
        }
        const rawTemplates = tplRes.data != null ? (tplRes.data!.getArray<UTSJSONObject>('templates') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        const templates : UTSJSONObject[] = []
        for (const tpl of rawTemplates) {
          const row = this._copyRow(tpl)
          const targets = tpl.getArray<string>('target_sub_ages') ?? ([] as string[])
          row['sub_ages_display'] = targets!.join(' · ')
          const tid = tpl.getNumber('id')
          const enrolled = tid != null && enrolledIds.has(tid!)
          row['alreadyEnrolled'] = enrolled
          row['canJoinPrimary'] = !enrolled && !hasPrimary
          row['canJoinSecondary'] = !enrolled && !hasSecondary
          templates.push(row)
        }
        this.activePlans = plans
        this.planTemplates = templates
        this.plansLoading = false
      } catch (e : any) {
        this.plansLoading = false
      }
    },

    async _loadReminders(user : UTSJSONObject) {
      this.remindersLoading = true
      try {
        const res = await this._req(`${BASE}/api/reminders?openid=${encodeURIComponent(user!.getString('user_id') ?? '')}`, 'GET', null, 0)
        const raw = res.data != null ? (res.data!.getArray<UTSJSONObject>('reminders') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        const lang = this.lang
        const t = this.t
        const now = new Date()
        const out : UTSJSONObject[] = []
        for (const r of raw) {
          const d = new Date(_parseMs(r['scheduled_for']))
          const sameDay = d.getFullYear() == now.getFullYear() && d.getMonth() == now.getMonth() && d.getDate() == now.getDate()
          const tomorrow = new Date(now.getTime() + 86400000)
          const isTomorrow = d.getFullYear() == tomorrow.getFullYear() && d.getMonth() == tomorrow.getMonth() && d.getDate() == tomorrow.getDate()
          const hhmm = `${_pad2(d.getHours())}:${_pad2(d.getMinutes())}`
          let dateLabel = fmtDate(r['scheduled_for'], lang)
          if (sameDay) dateLabel = lang == 'zh' ? `今天 ${hhmm}` : `Today ${hhmm}`
          else if (isTomorrow) dateLabel = lang == 'zh' ? `明天 ${hhmm}` : `Tomorrow ${hhmm}`
          const recurrence = r.getString('recurrence') ?? ''
          const row = this._copyRow(r)
          row['dateLabel'] = dateLabel
          row['isCoach'] = idOf(r, 'coach_id').length > 0
          row['recurrenceLabel'] = recurrence == 'daily' ? tMainTr(t, 'reminderRecurDaily') : (recurrence == 'weekly' ? tMainTr(t, 'reminderRecurWeekly') : '')
          out.push(row)
        }
        this.upcomingReminders = out
        this.remindersLoading = false
      } catch (e : any) {
        this.remindersLoading = false
      }
    },

    switchPlanSubTab(tabKey : string) {
      this.planSubTab = tabKey
      if (tabKey == 'activities') this.loadEvents()
    },

    async openPlanDetail(index : number) {
      const plan = index < this.activePlans.length ? this.activePlans[index] : null
      if (plan == null) return
      this.planDetailOpen = true
      this.planDetailData = plan
      this.planSubTab = 'overview'
      const user = this.user
      if (user == null) return
      try {
        const res = await this._req(`${BASE}/api/health-plans/${plan!.getNumber('id')}?openid=${encodeURIComponent(user!.getString('user_id') ?? '')}`, 'GET', null, 0)
        const d = res.data
        const detail = d != null ? d!.getJSON('plan') : null
        const rawReminders = d != null ? (d!.getArray<UTSJSONObject>('reminders') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        const reminders : UTSJSONObject[] = []
        for (const r of rawReminders) {
          const dt = new Date(_parseMs(r['scheduled_for']))
          const row = this._copyRow(r)
          row['timeDisplay'] = `${_pad2(dt.getHours())}:${_pad2(dt.getMinutes())}`
          reminders.push(row)
        }
        const formulation = d != null ? d!.getJSON('formulation') : null
        // Server-resolved names for the focus's recommended dots — the guidance tab used to render
        // raw "DOT7" ids. Defaults to [] so an older server response just hides the section.
        const recommendedDots = d != null ? (d!.getArray<UTSJSONObject>('recommended_dots') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        const merged = this._copyRow(plan!)
        if (detail != null) detail!.toMap().forEach((v : any | null, k : string) => { merged[k] = v })
        merged['reminders'] = reminders
        merged['formulation'] = formulation
        merged['recommendedDots'] = recommendedDots
        this.planDetailData = merged
      } catch (e : any) { /* keep existing plan data if fetch fails */ }
    },

    closePlanDetail() {
      this.planDetailOpen = false
      this.planDetailData = null
    },
    openPlanBrowse() { this.planBrowseOpen = true },
    closePlanBrowse() { this.planBrowseOpen = false },

    recommendedDotZh(rd : UTSJSONObject) : string {
      const kn = rd.getString('key_name_zh')
      if (kn != null && kn!.length > 0) return kn!
      const nz = rd.getString('name_zh')
      return nz != null ? nz! : (rd.getString('name') ?? '')
    },

    async handleTogglePlanReminder(reminderId : string, currentStatus : string) {
      const user = this.user
      if (user == null) return
      const newStatus = currentStatus == 'paused' ? 'pending' : 'paused'
      try {
        await this._req(`${BASE}/api/plan-reminders/${reminderId}`, 'PATCH', { openid: user!.getString('user_id'), status: newStatus } as UTSJSONObject, 0)
        const d = this.planDetailData
        if (d != null) {
          const reminders = (d!.getArray<UTSJSONObject>('reminders') ?? ([] as UTSJSONObject[])).map((r : UTSJSONObject) : UTSJSONObject => {
            if (idOf(r, 'id') == reminderId) {
              const row = this._copyRow(r)
              row['status'] = newStatus
              return row
            }
            return r
          })
          const merged = this._copyRow(d!)
          merged['reminders'] = reminders
          this.planDetailData = merged
        }
      } catch (e : any) { /* ignore */ }
    },

    async handlePlanCheckin(planId : string) {
      if (this.isGuest) { this.openGuestSheet(); return }
      const user = this.user
      if (planId.length == 0 || this.planCheckinBusy || user == null) return
      this.planCheckinBusy = true
      try {
        const today = new Date()
        const checkinDate = `${today.getFullYear()}-${_pad2(today.getMonth() + 1)}-${_pad2(today.getDate())}`
        await this._req(`${BASE}/api/health-plans/${planId}/checkin`, 'POST', {
          openid: user!.getString('user_id'),
          checkin_date: checkinDate,
          dots_taken: true,
          activities_done: [] as string[],
        } as UTSJSONObject, 0)
        await this._loadPlans(user, this.lang)
      } catch (err : any) {
        uni.showToast({ title: `${err}`, icon: 'none' })
      } finally {
        this.planCheckinBusy = false
      }
    },

    async _upsertCheckin(planId : string, dotsTaken : boolean, activitiesDone : string[]) {
      const user = this.user
      if (user == null) return
      const today = new Date()
      const checkinDate = `${today.getFullYear()}-${_pad2(today.getMonth() + 1)}-${_pad2(today.getDate())}`
      await this._req(`${BASE}/api/health-plans/${planId}/checkin`, 'POST', {
        openid: user!.getString('user_id'), checkin_date: checkinDate, dots_taken: dotsTaken, activities_done: activitiesDone,
      } as UTSJSONObject, 0)
    },

    _findPlan(planId : string) : UTSJSONObject | null {
      for (const p of this.activePlans) { if (`${p.getNumber('id')}` == planId) return p }
      return null
    },

    handlePlanTask(planId : string, task : string) {
      if (this.isGuest) { this.openGuestSheet(); return }
      if (this.planTaskBusy) return
      if (task == 'dots') this._doDotsTask(planId)
      else if (task == 'weight') this.openWeightTask(planId)
      else if (task == 'questions') this.openQuestionsTask(planId)
    },

    async _doDotsTask(planId : string) {
      const plan = this._findPlan(planId)
      if (plan == null) return
      this.planTaskBusy = true
      try {
        await this._upsertCheckin(planId, plan!.getBoolean('today_dots_taken') != true, plan!.getArray<string>('today_activities') ?? ([] as string[]))
        const user = this.user
        if (user != null) await this._loadPlans(user, this.lang)
      } catch (err : any) {
        uni.showToast({ title: `${err}`, icon: 'none' })
      } finally {
        this.planTaskBusy = false
      }
    },

    openWeightTask(planId : string) {
      this.planWeightOpen = true
      this.planWeightInput = ''
      this.planWeightPlanId = planId
      this._weightSubAccepted = false
      // xapp-mini: WeChat's template-message opt-in for the weight reminder, as the miniapp. The
      // template id belongs to an appid — this is the miniapp's (wx84bd7d00a6fd626e); under
      // another appid WeChat rejects it and the reminder stays off (send_weight_reminder: false).
      // Native has no equivalent.
      // #ifdef MP-WEIXIN
      wx.requestSubscribeMessage({
        tmplIds: [WEIGHT_TMPL_ID],
        success: (res : any) => { this._weightSubAccepted = res[WEIGHT_TMPL_ID] == 'accept' },
      } as any)
      // #endif
    },

    async handleWeightSubmit() {
      const user = this.user
      if (user == null) return
      const w = parseFloat(this.planWeightInput)
      if (isNaN(w) || w < 10 || w > 500) {
        uni.showToast({ title: user!.getString('language') == 'zh' ? '请输入有效体重' : 'Enter a valid weight', icon: 'none' })
        return
      }
      this.planTaskBusy = true
      try {
        await this._req(`${BASE}/api/biomarkers`, 'POST', {
          openid: user!.getString('user_id'), test_type: 'body_composition',
          test_data: { weight: w } as UTSJSONObject,
          send_weight_reminder: this._weightSubAccepted,
        } as UTSJSONObject, 0)
        const plan = this._findPlan(this.planWeightPlanId)
        const actsArr = plan != null ? (plan!.getArray<string>('today_activities') ?? ([] as string[])) : ([] as string[])
        const activities : string[] = []
        for (const a of actsArr) { if (a != 'weight_logged') activities.push(a) }
        activities.push('weight_logged')
        await this._upsertCheckin(this.planWeightPlanId, plan != null && plan!.getBoolean('today_dots_taken') == true, activities)
        this.planWeightOpen = false
        await this._loadPlans(user, this.lang)
      } catch (err : any) {
        uni.showToast({ title: `${err}`, icon: 'none' })
      } finally {
        this.planTaskBusy = false
      }
    },

    // The sheets sit at the bottom with adjust-position off, so they lift themselves by the
    // keyboard's height — the miniapp's handleWeightFocus/Blur and onGuestKeyboardHeightChange.
    // (A platform without the height in the event leaves 0: no lift, default behaviour.)
    closeWeightTask() { this.planWeightOpen = false; this.planWeightKeyboard = 0 },
    handleWeightFocus(e : any) { this.planWeightKeyboard = _kbHeight(e) },
    handleWeightBlur(_e : any) { this.planWeightKeyboard = 0 },
    onGuestKeyboardHeightChange(e : any) { this.guestKeyboardHeight = _kbHeight(e) },

    openQuestionsTask(planId : string) {
      this.planQuestionsOpen = true
      this.planQEnergy = 3
      this.planQSleep = 3
      this.planQMood = 3
      this.planQuestionsPlanId = planId
    },

    // TODO(port): confirm slider change-event payload type at compile (detail.value).
    onPlanQChange(key : string, e : any | null) {
      const val = e != null ? Math.round((e as UniSliderChangeEvent).detail.value) : NaN
      if (isNaN(val)) return
      if (key == 'energy') this.planQEnergy = val
      else if (key == 'sleep') this.planQSleep = val
      else if (key == 'mood') this.planQMood = val
    },

    async handleQuestionsSubmit() {
      const user = this.user
      if (user == null) return
      this.planTaskBusy = true
      try {
        const plan = this._findPlan(this.planQuestionsPlanId)
        const actsArr = plan != null ? (plan!.getArray<string>('today_activities') ?? ([] as string[])) : ([] as string[])
        const activities : string[] = []
        for (const a of actsArr) { if (a != 'daily_questions') activities.push(a) }
        activities.push('daily_questions')
        await this._upsertCheckin(this.planQuestionsPlanId, plan != null && plan!.getBoolean('today_dots_taken') == true, activities)
        this.planQuestionsOpen = false
        await this._loadPlans(user, this.lang)
      } catch (err : any) {
        uni.showToast({ title: `${err}`, icon: 'none' })
      } finally {
        this.planTaskBusy = false
      }
    },

    closeQuestionsTask() { this.planQuestionsOpen = false },

    async handleJoinPlan(templateId : string, planType : string) {
      if (this.isGuest) { this.openGuestSheet(); return }
      const user = this.user
      if (user == null) return
      const lang = this.lang
      try {
        const res = await this._req(`${BASE}/api/health-plans`, 'POST', {
          openid: user!.getString('user_id'),
          template_id: parseInt(templateId),
          plan_type: planType.length > 0 ? planType : 'primary',
          source: 'self',
        } as UTSJSONObject, 0)
        const d = res.data
        if (d != null && d!.getBoolean('success') != true && d!.getString('error') == 'conflict') {
          uni.showModal({
            title: this.tr('plansConflict'),
            content: '',
            confirmText: lang == 'zh' ? '替换' : 'Replace',
            success: (modal) => { (async () : Promise<void> => {
              if (!modal.confirm) return
              // Abandon existing and retry.
              const existingId = d!.getNumber('existing_plan_id')
              if (existingId != null) {
                await this._req(`${BASE}/api/health-plans/${existingId}`, 'PUT', { openid: user!.getString('user_id'), status: 'abandoned' } as UTSJSONObject, 0)
              }
              await this._req(`${BASE}/api/health-plans`, 'POST', {
                openid: user!.getString('user_id'),
                template_id: parseInt(templateId),
                plan_type: planType.length > 0 ? planType : 'primary',
                source: 'self',
              } as UTSJSONObject, 0)
              this.planBrowseOpen = false
              await this._loadPlans(user, lang)
            })() },
          })
          return
        }
        this.planBrowseOpen = false
        await this._loadPlans(user, lang)
      } catch (err : any) {
        uni.showToast({ title: `${err}`, icon: 'none' })
      }
    },

    handleAbandonPlan() {
      const user = this.user
      const d = this.planDetailData
      const planId = d != null ? `${d!.getNumber('id')}` : ''
      if (planId.length == 0 || planId == 'null' || user == null) return
      uni.showModal({
        title: this.tr('plansConfirmAbandon'),
        content: '',
        success: (res) => { (async () : Promise<void> => {
          if (!res.confirm) return
          try {
            await this._req(`${BASE}/api/health-plans/${planId}`, 'PUT', { openid: user!.getString('user_id'), status: 'abandoned' } as UTSJSONObject, 0)
            this.planDetailOpen = false
            await this._loadPlans(user, this.lang)
          } catch (err : any) {
            uni.showToast({ title: `${err}`, icon: 'none' })
          }
        })() },
      })
    },

    handleSwitchPlanType() {
      const user = this.user
      const d = this.planDetailData
      const planId = d != null ? `${d!.getNumber('id')}` : ''
      const currentType = d != null ? (d!.getString('plan_type') ?? '') : ''
      const newType = currentType == 'primary' ? 'secondary' : 'primary'
      if (planId.length == 0 || planId == 'null' || user == null) return
      uni.showModal({
        title: this.tr('plansConfirmSwitch'),
        content: '',
        success: (res) => { (async () : Promise<void> => {
          if (!res.confirm) return
          try {
            await this._req(`${BASE}/api/health-plans/${planId}`, 'PUT', { openid: user!.getString('user_id'), plan_type: newType } as UTSJSONObject, 0)
            this.planDetailOpen = false
            await this._loadPlans(user, this.lang)
          } catch (err : any) {
            uni.showToast({ title: `${err}`, icon: 'none' })
          }
        })() },
      })
    },

    // "Buy This Formulation" CTA in the plan-detail overlay — only rendered once
    // planDetailData.formulation is populated (a real committed nutrition_plans row for this
    // focus). Passes the specific plan id through the webview-token bridge so GCN's checkout
    // validates/prices against the exact recipe (§31).
    handleBuyFormulation() {
      const d = this.planDetailData
      if (!this.isAeviva || d == null) return
      const f = d!.getJSON('formulation')
      if (f == null) return
      const npid = f!.getNumber('nutrition_plan_id')
      if (npid == null) return
      this._openAevivaStoreGated({ intent: 'buy_custom_formulation', nutrition_plan_id: npid } as UTSJSONObject)
    },

    // ── Events (线下活动) ──
    async loadEvents() {
      const user = this.user
      if (user == null) return
      const channelId = user!.getNumber('channel_id')
      if (channelId == null) return
      this.eventsLoading = true
      try {
        const res = await this._req(`${BASE}/api/events?channel_id=${encodeURIComponent(`${channelId}`)}&user_id=${encodeURIComponent(user!.getString('user_id') ?? '')}`, 'GET', null, 0)
        const raw = res.data != null ? (res.data!.getArray<UTSJSONObject>('events') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        const out : UTSJSONObject[] = []
        const signupIds : number[] = []
        for (const ev of raw) {
          const d = new Date(_parseMs(ev['scheduled_at']))
          const signupCount = ev.getNumber('signup_count') ?? 0
          const capacity = ev.getNumber('capacity')
          const remaining = capacity != null ? Math.max(0, capacity - signupCount) : null
          const row = this._copyRow(ev)
          row['scheduled_at_display'] = `${d.getFullYear()}-${_pad2(d.getMonth() + 1)}-${_pad2(d.getDate())} ${_pad2(d.getHours())}:${_pad2(d.getMinutes())}`
          row['remaining'] = remaining
          row['is_full'] = capacity != null && remaining == 0
          out.push(row)
          if (ev.getBoolean('signed_up') == true) {
            const id = ev.getNumber('id')
            if (id != null) signupIds.push(id!)
          }
        }
        this.events = out
        this.mySignupEventIds = signupIds
        this.eventsLoading = false
      } catch (e : any) {
        this.eventsLoading = false
      }
    },

    isSignupEvent(id : number | null) : boolean {
      if (id == null) return false
      return this.mySignupEventIds.indexOf(id!) >= 0
    },

    async handleEventSignUp(eventIdStr : string) {
      const user = this.user
      if (user == null) return
      const eventId = parseInt(eventIdStr)
      try {
        const res = await this._req(`${BASE}/api/event-signups`, 'POST', { event_id: eventId, user_id: user!.getString('user_id') } as UTSJSONObject, 0)
        const d = res.data
        if (d != null && d!.getBoolean('success') == true) {
          this.mySignupEventIds = [...this.mySignupEventIds, eventId]
          uni.showToast({ title: this.tr('eventsSignedUp'), icon: 'success' })
        } else {
          uni.showToast({ title: d != null ? (d!.getString('error') ?? 'Error') : 'Error', icon: 'none' })
        }
      } catch (e : any) {
        uni.showToast({ title: this.tr('errServer'), icon: 'none' })
      }
    },

    async handleEventCancelSignup(eventIdStr : string) {
      const user = this.user
      if (user == null) return
      const eventId = parseInt(eventIdStr)
      try {
        await this._req(`${BASE}/api/event-signups/${eventIdStr}?user_id=${encodeURIComponent(user!.getString('user_id') ?? '')}`, 'DELETE', null, 0)
        const out : number[] = []
        for (const id of this.mySignupEventIds) { if (id != eventId) out.push(id) }
        this.mySignupEventIds = out
        uni.showToast({ title: this.tr('eventsCancel'), icon: 'none' })
      } catch (e : any) {
        uni.showToast({ title: this.tr('errServer'), icon: 'none' })
      }
    },

    // ── Guest join sheet ──
    async _loadGuestStore(lang : string) {
      try {
        const res = await this._req(`${BASE}/api/store-items`, 'GET', null, 0)
        const raw = res.data != null ? (res.data!.getArray<UTSJSONObject>('items') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        this._rawStoreItems = raw
        this.storeLoading = false
        this.storeItems = mapStoreItems(raw, lang)
      } catch (e : any) {
        this.storeLoading = false
      }
    },

    openGuestSheet() {
      this.guestSheetOpen = true
      this.guestInviteCode = ''
      this.guestInviteError = ''
      this.menuOpen = false
    },

    closeGuestSheet() { this.guestSheetOpen = false; this.guestKeyboardHeight = 0 },

    // 6-digit code; auto-submits on the 6th digit (main.js onGuestInviteInput).
    onGuestInviteTyped() {
      const val = this.guestInviteCode.length > 6 ? this.guestInviteCode.substring(0, 6) : this.guestInviteCode
      this.guestInviteCode = val
      this.guestInviteError = ''
      if (val.length == 6) this.submitGuestInvite()
    },

    async submitGuestInvite() {
      if (this.guestInviteBusy) return
      const code = this.guestInviteCode.trim()
      if (code.length == 0) { this.guestInviteError = this.tr('guestInviteRequired'); return }
      this.guestInviteBusy = true
      this.guestInviteError = ''
      try {
        const res = await this._req(`${BASE}/api/validate-invite`, 'POST', { invite_code: code } as UTSJSONObject, 0)
        const d = res.data
        if (d != null && d!.getBoolean('invalid_code') == true) {
          this.guestInviteError = this.tr('guestInviteInvalid')
          this.guestInviteBusy = false
          return
        }
        if (d == null || d!.getBoolean('success') != true) {
          this.guestInviteError = d != null ? (d!.getString('error') ?? this.tr('errServer')) : this.tr('errServer')
          this.guestInviteBusy = false
          return
        }
        // Valid invite code confirmed — hand off to login, which owns account creation, avatar
        // capture, and the phone/email OTP gate. One implementation of "new account".
        uni.reLaunch({ url: `/pages/login/login?invite=${encodeURIComponent(code)}` })
      } catch (e : any) {
        this.guestInviteError = this.tr('errServer')
        this.guestInviteBusy = false
      }
    },

    // ── user-health event handlers (same contracts as main.wxml) ──
    handleHealthChooseAvatar(detail : any | null) {
      // The xapp component emits { avatarId }; the miniapp used e.detail.
      let avatarId = ''
      if (detail != null) {
        const d = detail as UTSJSONObject
        avatarId = d.getString('avatarId') ?? ''
      }
      if (avatarId.length == 0) { this._healthSetAvatarUpdating(false); return }
      // mood.uts needs the third arg (custom moods) in xapp; a gallery pick has none (§20).
      const url = resolveAvatarUrl(avatarId, DEFAULT_MOOD, null)
      const done = () => { this._healthSetAvatarUpdating(false) }
      if (url == null) { done(); return }
      const user = this.user
      if (user == null) { done(); return }
      this._saveUser(user, { avatar_url: url, avatar_character: avatarId } as UTSJSONObject).then((_v : RespEnvelope) : void => {
        const updated = this._copyUser()
        updated['avatar_url'] = url
        updated['avatar_character'] = avatarId
        this._updateUser(updated)
      }).catch((e : any | null) => {}).finally(done)
    },

    // A generated ("my photo") avatar was applied by the picker via POST /avatar-generation/apply;
    // the server row is already updated, so this is only the local mirror of it (§20).
    handleHealthCustomAvatar(detail : any | null) {
      if (detail == null) return
      const d = detail as UTSJSONObject
      const url = d.getString('avatar_url')
      const moods = d.getJSON('avatar_moods')
      if (url == null || moods == null) return
      const user = this.user
      if (user == null) return
      const updated = this._copyUser()
      updated['avatar_url'] = url
      const ch = d.getString('avatar_character')
      updated['avatar_character'] = ch != null && ch!.length > 0 ? ch : 'custom'
      updated['avatar_moods'] = moods
      this._updateUser(updated)
    },

    onProfileUpdated(detail : any | null) {
      if (detail == null) return
      this._updateUser(detail as UTSJSONObject)
    },

    // ── Wellness tab ──
    // xapp-mini plays through wx.getBackgroundAudioManager, as the miniapp. TODO(port): native has
    // no equivalent yet — uni.createInnerAudioContext keeps playing only while foregrounded. Wiring kept
    // identical in shape (onPlay/onPause/onStop/onEnded/onTimeUpdate).
    async _loadWellness() {
      this.wellnessLoading = true
      try {
        const user = this.user
        const cid = user != null ? user!.getNumber('channel_id') : null
        const assetsRes = await this._req(`${BASE}/api/digital-assets${cid != null ? `?channel_id=${cid}` : ''}`, 'GET', null, 0)
        const raw = assetsRes.data != null ? (assetsRes.data!.getArray<UTSJSONObject>('assets') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        const assets : UTSJSONObject[] = []
        for (const a of raw) {
          const ct = a.getString('content_type') ?? ''
          let mediaType = 'other'
          if (ct.startsWith('audio/')) mediaType = 'audio'
          else if (ct.startsWith('video/')) mediaType = 'video'
          const row = this._copyRow(a)
          row['mediaType'] = mediaType
          assets.push(row)
        }
        const apkRes = await this._req(`${BASE}/api/kino-upgrade`, 'GET', null, 0)
        const apk = apkRes.data
        this.wellnessAssets = assets
        this.deviceApkVersion = apk != null ? (apk!.getString('version') ?? '') : ''
        this.deviceApkUrl = apk != null ? (apk!.getString('url') ?? '') : ''
        this.wellnessLoading = false
      } catch (err : any) {
        this.wellnessLoading = false
      }
    },

    _initBgAudio() {
      // #ifdef MP-WEIXIN
      // xapp-mini: WeChat's background audio manager, as the miniapp — playback carries on with
      // the screen off or the app in the background (requiredBackgroundModes: audio).
      if (this._bgm != null) return
      const bgm = wx.getBackgroundAudioManager()
      bgm.onPlay(() => { this.sleepPlaying = true })
      bgm.onPause(() => { this.sleepPlaying = false })
      bgm.onStop(() => { this.sleepPlaying = false; this.sleepPosition = 0 })
      bgm.onEnded(() => { this.sleepPlaying = false; this.sleepPosition = 0 })
      bgm.onTimeUpdate(() => {
        this.sleepPosition = Math.floor(bgm.currentTime as number)
        const dur = Math.floor(bgm.duration as number)
        if (dur > 0) this.sleepDuration = dur
      })
      this._bgm = bgm
      return
      // #endif
      if (this._audio != null) return
      const ctx = uni.createInnerAudioContext()
      ctx.onPlay(() => { this.sleepPlaying = true })
      ctx.onPause(() => { this.sleepPlaying = false })
      ctx.onStop(() => { this.sleepPlaying = false; this.sleepPosition = 0 })
      ctx.onEnded(() => { this.sleepPlaying = false; this.sleepPosition = 0 })
      ctx.onTimeUpdate(() => {
        this.sleepPosition = Math.floor(ctx.currentTime)
        const dur = Math.floor(ctx.duration)
        if (dur > 0) this.sleepDuration = dur
      })
      this._audio = ctx
    },

    playAudioAsset(index : number) {
      const track = index < this.wellnessAssets.length ? this.wellnessAssets[index] : null
      if (track == null) return
      const cur = this.sleepCurrentTrack
      this._initBgAudio()
      // #ifdef MP-WEIXIN
      const bgm = this._bgm
      if (bgm == null) return
      if (cur != null && cur!.getNumber('id') == track!.getNumber('id') && this.sleepPlaying) {
        bgm.pause()
        return
      }
      const src = track!.getString('url')
      if (src == null) return
      // title is required by the background manager (it shows on the lock screen); src starts it.
      bgm.title = track!.getString('title_zh') ?? (track!.getString('title') ?? '')
      bgm.coverImgUrl = ''
      bgm.src = src!
      this.sleepCurrentTrack = track
      this.sleepPosition = 0
      this.sleepDuration = track!.getNumber('duration_seconds') ?? 0
      return
      // #endif
      const ctx = this._audio
      if (ctx == null) return
      if (cur != null && cur!.getNumber('id') == track!.getNumber('id') && this.sleepPlaying) {
        ctx.pause()
        return
      }
      const url = track!.getString('url')
      if (url == null) return
      ctx.src = url!
      // InnerAudioContext has no title field on uni-app x (WeChat-era metadata) — skipped.
      this.sleepCurrentTrack = track
      this.sleepPosition = 0
      this.sleepDuration = track!.getNumber('duration_seconds') ?? 0
    },

    stopAudioAsset() {
      // #ifdef MP-WEIXIN
      if (this._bgm != null) this._bgm.stop()
      // #endif
      const ctx = this._audio
      if (ctx != null) ctx.stop()
      this.sleepCurrentTrack = null
      this.sleepPlaying = false
      this.sleepPosition = 0
    },

    // The miniapp copied the asset URL for a browser (media-asset-btn = 复制链接); same native.
    openMediaAsset(index : number) {
      const asset = index < this.wellnessAssets.length ? this.wellnessAssets[index] : null
      if (asset == null) return
      const url = asset!.getString('url')
      if (url == null || url!.length == 0) return
      uni.setClipboardData({
        data: url!,
        success: () => { uni.showToast({ title: '链接已复制，请在浏览器打开', icon: 'none', duration: 2500 }) },
      })
    },

    copyApkUrl() {
      if (this.deviceApkUrl.length == 0) return
      uni.setClipboardData({
        data: this.deviceApkUrl,
        success: () => { uni.showToast({ title: '链接已复制，请在浏览器打开', icon: 'none', duration: 2500 }) },
      })
    },

    // ── Academy tab ──
    async _loadAcademy() {
      const user = this.user
      const userId = user != null ? (user!.getString('user_id') ?? '') : ''
      if (userId.length == 0) return
      this.trainingLoading = true
      try {
        // Promise.allSettled in the source → sequential awaits with per-call try/catch; same
        // partial-failure semantics (each list defaults to empty when its fetch fails).
        let rawCourses : UTSJSONObject[] = []
        let library : UTSJSONObject[] = []
        let progressRows : UTSJSONObject[] = []
        let rawDashboard : UTSJSONObject | null = null
        let paths : UTSJSONObject[] = []
        let certs : UTSJSONObject[] = []
        try {
          const r = await this._req(`${BASE}/api/academy/courses`, 'GET', null, 0)
          rawCourses = r.data != null ? (r.data!.getArray<UTSJSONObject>('courses') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        } catch (e : any) {}
        try {
          const r = await this._req(`${BASE}/api/academy/library`, 'GET', null, 0)
          library = r.data != null ? (r.data!.getArray<UTSJSONObject>('items') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        } catch (e : any) {}
        try {
          const r = await this._req(`${BASE}/api/academy/progress?user_id=${userId}`, 'GET', null, 0)
          progressRows = r.data != null ? (r.data!.getArray<UTSJSONObject>('progress') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        } catch (e : any) {}
        try {
          const r = await this._req(`${BASE}/api/academy/coach-dashboard?user_id=${userId}`, 'GET', null, 0)
          rawDashboard = r.data
        } catch (e : any) {}
        try {
          const r = await this._req(`${BASE}/api/academy/learning-paths`, 'GET', null, 0)
          paths = r.data != null ? (r.data!.getArray<UTSJSONObject>('paths') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        } catch (e : any) {}
        try {
          const r = await this._req(`${BASE}/api/academy/coach-certifications?user_id=${userId}`, 'GET', null, 0)
          certs = r.data != null ? (r.data!.getArray<UTSJSONObject>('certifications') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        } catch (e : any) {}

        const t = this.lang == 'zh' ? T_MAIN_ZH : T_MAIN_EN
        const tl = t.getJSON('training')!
        const tierLabels = tl!.getJSON('tierLabels')!
        const publishedCourses = rawCourses.filter((c : UTSJSONObject) : boolean => c.getString('status') == 'published')
        const completedIds : number[] = []
        for (const p of progressRows) {
          const lid = p.getNumber('lesson_id')
          if (lid != null) completedIds.push(lid!)
        }
        // Per-course completion counts; a course is fully completed when ALL its lessons are done.
        const completedByCourse = new Map<number, number>()
        for (const p of progressRows) {
          const cid = p.getNumber('course_id')
          if (cid != null) completedByCourse.set(cid!, (completedByCourse.get(cid!) ?? 0) + 1)
        }
        const completedCourseIds = new Set<number>()
        for (const c of publishedCourses) {
          const lc = c.getNumber('lesson_count') ?? 0
          const cid = c.getNumber('id')
          if (cid != null && lc > 0 && (completedByCourse.get(cid!) ?? 0) >= lc) completedCourseIds.add(cid!)
        }
        const courses : UTSJSONObject[] = []
        for (const c of publishedCourses) {
          const row = this._copyRow(c)
          const lc = c.getNumber('lesson_count') ?? 0
          row['_lessonCountLabel'] = lessonCount(this.lang, lc!)
          const level = c.getString('level') ?? ''
          const tierLabel = tierLabels.getString(level)
          row['_levelLabel'] = tierLabel != null && tierLabel!.length > 0 ? tierLabel : level
          const prereq = c.getNumber('prerequisite_course_id')
          row['_locked'] = prereq != null && !completedCourseIds.has(prereq!)
          courses.push(row)
        }
        let dashboard : UTSJSONObject | null = null
        if (rawDashboard != null) {
          dashboard = this._copyRow(rawDashboard!)
          const tier = `${rawDashboard!.getString('tier') ?? ''}`
          const tl2 = tierLabels.getString(tier)
          dashboard!['_tierLabel'] = tl2 != null && tl2!.length > 0 ? tl2 : tier
        }
        const certifications : UTSJSONObject[] = []
        for (const c of certs) {
          const row = this._copyRow(c)
          const tier = c.getString('tier') ?? ''
          const tl3 = tierLabels.getString(tier)
          row['_tierLabel'] = tl3 != null && tl3!.length > 0 ? tl3 : tier
          certifications.push(row)
        }
        const enrichedPaths : UTSJSONObject[] = []
        for (const p of paths) {
          const pCourses = p.getArray<UTSJSONObject>('courses') ?? ([] as UTSJSONObject[])
          let done = 0
          for (const pc of pCourses) {
            const cid = pc.getNumber('course_id')
            if (cid != null && completedCourseIds.has(cid!)) done++
          }
          const row = this._copyRow(p)
          row['_total'] = pCourses.length
          row['_done'] = done
          const tier = p.getString('tier') ?? ''
          const tl4 = tierLabels.getString(tier)
          row['_tierLabel'] = tl4 != null && tl4!.length > 0 ? tl4 : tier
          enrichedPaths.push(row)
        }
        this.trainingCourses = courses
        this.trainingLibrary = library
        this.trainingCompletedIds = completedIds
        this.trainingDashboard = dashboard
        this.trainingPaths = enrichedPaths
        this.trainingCertifications = certifications
      } catch (e : any) {
        uni.showToast({ title: this.tr('training.loadError'), icon: 'none' })
      } finally {
        this.trainingLoading = false
      }
    },

    pathPct(p : UTSJSONObject) : number {
      const total = p.getNumber('_total') ?? 0
      const done = p.getNumber('_done') ?? 0
      return total > 0 ? Math.round(done / total * 100) : 0
    },
    isLessonCompleted(index : number) : boolean {
      const lsn = index < this.trainingLessons.length ? this.trainingLessons[index] : null
      if (lsn == null) return false
      const id = lsn!.getNumber('id')
      if (id == null) return false
      return this.trainingCompletedIds.indexOf(id!) >= 0
    },
    quizAnswerFor(q : UTSJSONObject) : number {
      const v = this.trainingQuizAnswers.getNumber(idOf(q, 'id'))
      return v != null ? v! : -1
    },

    async trainingOpenCourse(index : number, isPath : boolean) {
      const source = isPath ? this.trainingPaths : this.trainingCourses
      const course = index < source.length ? source[index] : null
      if (course == null) return
      if (course!.getBoolean('_locked') == true) {
        const prereq = course!.getString('prerequisite_title') ?? (this.lang == 'zh' ? '前置课程' : 'prerequisite course')
        uni.showToast({ title: this.lang == 'zh' ? `请先完成：${prereq}` : `Complete first: ${prereq}`, icon: 'none', duration: 2500 })
        return
      }
      this.trainingCurrentCourse = course
      this.trainingLessons = [] as UTSJSONObject[]
      this.trainingView = 'lessons'
      try {
        const cid = course!.getNumber('id') ?? ''
        const res = await this._req(`${BASE}/api/academy/lessons?course_id=${cid}`, 'GET', null, 0)
        this.trainingLessons = res.data != null ? (res.data!.getArray<UTSJSONObject>('lessons') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
      } catch (e : any) {
        uni.showToast({ title: this.tr('training.loadError'), icon: 'none' })
      }
    },

    async trainingOpenLesson(index : number) {
      const lesson = index < this.trainingLessons.length ? this.trainingLessons[index] : null
      if (lesson == null) return
      this.trainingCurrentLesson = lesson
      this.trainingVideoUrl = ''
      this.trainingTextContent = ''
      this.trainingQuizQuestions = [] as UTSJSONObject[]
      this.trainingQuizAnswers = {} as UTSJSONObject
      this.trainingQuizResult = null
      this.trainingQuizReview = [] as UTSJSONObject[]
      this.trainingView = 'player'
      try {
        const lid = lesson!.getNumber('id') ?? ''
        const detailRes = await this._req(`${BASE}/api/academy/lessons/${lid}`, 'GET', null, 0)
        const detail = detailRes.data
        const quizQuestions = detail != null ? (detail!.getArray<UTSJSONObject>('quiz_questions') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        const contentType = lesson!.getString('content_type') ?? ''
        if (contentType == 'text' || contentType == 'interactive') {
          const inner = detail != null ? detail!.getJSON('lesson') : null
          this.trainingTextContent = inner != null ? (inner!.getString('text_content') ?? '') : ''
          this.trainingQuizQuestions = quizQuestions
          return
        }
        const ossKey = lesson!.getString('oss_key')
        if (ossKey != null && ossKey!.length > 0) {
          const presignRes = await this._req(`${BASE}/api/oss/presign?action=get&key=${encodeURIComponent(ossKey!)}`, 'GET', null, 0)
          this.trainingVideoUrl = presignRes.data != null ? (presignRes.data!.getString('url') ?? '') : ''
          this.trainingQuizQuestions = quizQuestions
        }
      } catch (e : any) {
        uni.showToast({ title: this.tr('training.loadError'), icon: 'none' })
      }
    },

    trainingSelectAnswer(questionId : string, optionIndex : number) {
      const answers = this._copyRow(this.trainingQuizAnswers)
      answers[questionId] = optionIndex
      this.trainingQuizAnswers = answers
    },

    async trainingSubmitQuiz() {
      const lesson = this.trainingCurrentLesson
      const user = this.user
      if (lesson == null || user == null) return
      if (this.trainingQuizAnswers.toMap().size == 0) { uni.showToast({ title: '请先回答问题', icon: 'none' }); return }
      this.trainingQuizSubmitting = true
      try {
        const answerObj = new UTSJSONObject()
        this.trainingQuizAnswers.toMap().forEach((v : any | null, k : string) => { answerObj[k] = v })
        const res = await this._req(`${BASE}/api/academy/quiz-attempts`, 'POST', {
          user_id: user!.getString('user_id'), lesson_id: lesson!.getNumber('id'), answers: answerObj,
        } as UTSJSONObject, 0)
        const result = res.data
        const correctAnswers = result != null ? (result!.getArray<UTSJSONObject>('correct_answers') ?? ([] as UTSJSONObject[])) : ([] as UTSJSONObject[])
        const review : UTSJSONObject[] = []
        for (const q of this.trainingQuizQuestions) {
          const qid = q.getNumber('id')
          let ca : UTSJSONObject | null = null
          for (const x of correctAnswers) { if (x.getNumber('question_id') == qid) { ca = x; break } }
          const options = q.getArray<UTSJSONObject>('options') ?? ([] as UTSJSONObject[])
          const ansIdx = qid != null ? this.trainingQuizAnswers.getNumber(`${qid}`) : null
          let userAnswer = '—'
          if (ca != null && ansIdx != null && ansIdx! >= 0 && ansIdx! < options.length) {
            userAnswer = options[ansIdx!].getString('text') ?? '—'
          }
          let correctAnswer = ''
          if (ca != null) {
            const ci = ca!.getNumber('correct_index')
            if (ci != null && ci! >= 0 && ci! < options.length) correctAnswer = options[ci!].getString('text') ?? ''
          }
          review.push({
            question: q.getString('question'),
            user_answer: userAnswer,
            correct_answer: correctAnswer,
            explanation: ca != null ? (ca!.getString('explanation') ?? '') : '',
            is_correct: ca != null && ca!.getBoolean('is_correct') == true,
          } as UTSJSONObject)
        }
        this.trainingQuizResult = result != null ? result : new UTSJSONObject()
        this.trainingQuizReview = review
        if (result != null && result!.getBoolean('passed') == true) {
          const lid = lesson!.getNumber('id')
          if (lid != null) { await this._doMarkComplete(lid!); this._loadAcademy() }
        }
      } catch (e : any) {
        uni.showToast({ title: this.tr('training.loadError'), icon: 'none' })
      } finally {
        this.trainingQuizSubmitting = false
      }
    },

    async _doMarkComplete(lessonId : number) {
      const user = this.user
      if (user == null) return
      if (this.trainingCompletedIds.indexOf(lessonId) >= 0) return
      try {
        await this._req(`${BASE}/api/academy/progress`, 'POST', { user_id: user!.getString('user_id'), lesson_id: lessonId } as UTSJSONObject, 0)
        this.trainingCompletedIds = [...this.trainingCompletedIds, lessonId]
      } catch (e : any) { /* silent */ }
    },

    async trainingMarkComplete() {
      const lesson = this.trainingCurrentLesson
      if (lesson == null) return
      if (lesson!.getBoolean('has_quiz') == true && this.trainingQuizQuestions.length > 0 && (this.trainingQuizResult == null || this.trainingQuizResult!.getBoolean('passed') != true)) {
        uni.showToast({ title: '请先完成测验', icon: 'none' }); return
      }
      const lid = lesson!.getNumber('id')
      if (lid != null && this.trainingCompletedIds.indexOf(lid!) >= 0) return
      this.trainingMarkingComplete = true
      try {
        if (lid != null) await this._doMarkComplete(lid!)
        uni.showToast({ title: this.tr('training.markedComplete'), icon: 'success' })
        this._loadAcademy()
      } catch (e : any) {
        uni.showToast({ title: this.tr('training.loadError'), icon: 'none' })
      } finally {
        this.trainingMarkingComplete = false
      }
    },

    async trainingOpenLibraryItem(index : number) {
      const item = index < this.trainingLibrary.length ? this.trainingLibrary[index] : null
      if (item == null) return
      this.trainingCurrentLibraryItem = item
      this.trainingLibraryContent = ''
      this.trainingView = 'library-viewer'
      try {
        const res = await this._req(`${BASE}/api/academy/library/${item!.getNumber('id')}/content`, 'GET', null, 0)
        this.trainingLibraryContent = res.data != null ? (res.data!.getString('content') ?? JSON.stringify(res.data)) : ''
      } catch (e : any) {
        uni.showToast({ title: this.tr('training.loadError'), icon: 'none' })
      }
    },

    trainingBackToList() {
      this.trainingView = 'list'
      this.trainingCurrentCourse = null
      this.trainingCurrentLesson = null
      this.trainingVideoUrl = ''
      this.trainingQuizQuestions = [] as UTSJSONObject[]
      this.trainingQuizAnswers = {} as UTSJSONObject
      this.trainingQuizResult = null
      this.trainingQuizReview = [] as UTSJSONObject[]
    },

    // API responses serialize DATE columns as full ISO datetimes parsed in the backend's
    // Asia/Shanghai process timezone — e.g. "2026-07-05T16:00:00.000Z" for a stored 2026-07-06.
    // Shift by the fixed +8h (no DST in China) before reading fields, so the day comes out right
    // on any device timezone.
    _formatCertDate(dateStr : string | null) : string {
      if (dateStr == null || dateStr!.length == 0) return ''
      const t = _parseMs(dateStr)
      if (isNaN(t)) return dateStr!
      const shanghai = new Date(t + 8 * 60 * 60 * 1000)
      const y = shanghai.getUTCFullYear()
      const day = shanghai.getUTCDate()
      if (this.lang == 'zh') return `${y}年${shanghai.getUTCMonth() + 1}月${day}日`
      return `${MONTH_EN[shanghai.getUTCMonth()]} ${day}, ${y}`
    },

    async showCertDetail(index : number) {
      const cert = index < this.trainingCertifications.length ? this.trainingCertifications[index] : null
      if (cert == null) return
      // cert_oss_key is the backend-composited image (name/dates burned in) — prefer it;
      // template_image_oss_key is the blank template, only a fallback when generation hasn't run.
      const certKey = cert!.getString('cert_oss_key') ?? ''
      const tmplKey = cert!.getString('template_image_oss_key') ?? ''
      const displayKey = certKey.length > 0 ? certKey : tmplKey
      let templateImageUrl = ''
      if (displayKey.length > 0) {
        try {
          const res = await this._req(`${BASE}/api/oss/presign?action=get&key=${encodeURIComponent(displayKey)}`, 'GET', null, 0)
          templateImageUrl = res.data != null ? (res.data!.getString('url') ?? '') : ''
        } catch (e : any) {}
      }
      const row = this._copyRow(cert!)
      row['templateImageUrl'] = templateImageUrl
      row['issueDateDisplay'] = this._formatCertDate(cert!.getString('issue_date'))
      row['expiryDateDisplay'] = this._formatCertDate(cert!.getString('expiry_date'))
      this.certDetailOpen = true
      this.certDetailItem = row
    },

    hideCertDetail() {
      this.certDetailOpen = false
      this.certDetailItem = null
    },

    async downloadCert(key : string) {
      if (key.length == 0) return
      uni.showLoading({ title: this.lang == 'zh' ? '准备中…' : 'Loading…' })
      try {
        const res = await this._req(`${BASE}/api/oss/presign?action=get&key=${encodeURIComponent(key)}`, 'GET', null, 0)
        const url = res.data != null ? res.data!.getString('url') : null
        if (url == null || url!.length == 0) throw new Error('No URL')
        uni.hideLoading()
        // #ifdef MP-WEIXIN
        // xapp-mini: download and hand to WeChat's document viewer, as the miniapp.
        const filePath = await new Promise<string>((resolve, reject) => {
          uni.downloadFile({ url: url!, success: (r) => { if (r.statusCode == 200) resolve(r.tempFilePath); else reject(new Error(`http ${r.statusCode}`)) }, fail: (e) => { reject(e) } })
        })
        wx.openDocument({ filePath: filePath, showMenu: true } as any)
        return
        // #endif
        // TODO(port): no in-app PDF viewer is wired on the native side yet; pay-qr's
        // save-to-album precedent doesn't fit a PDF. Copy link for now.
        uni.setClipboardData({ data: url!, success: () => { uni.showToast({ title: '链接已复制，请在浏览器打开', icon: 'none', duration: 2500 }) } })
      } catch (e : any) {
        uni.hideLoading()
        uni.showToast({ title: this.lang == 'zh' ? '下载失败' : 'Download failed', icon: 'none' })
      }
    },

    trainingBackToLessons() {
      this.trainingView = 'lessons'
      this.trainingCurrentLesson = null
      this.trainingVideoUrl = ''
      this.trainingCurrentLibraryItem = null
      this.trainingLibraryContent = ''
      this.trainingQuizQuestions = [] as UTSJSONObject[]
      this.trainingQuizAnswers = {} as UTSJSONObject
      this.trainingQuizResult = null
      this.trainingQuizReview = [] as UTSJSONObject[]
    },

    // ── HTTP helper (mirrors coach.uvue._req / the miniapp's _req, body-level) ──
    // The miniapp's _req resolves on HTTP 4xx too and callers read res.data.success — so this
    // returns RespEnvelope {statusCode, data}. Sandbox sessions inject sandbox:true on every
    // non-GET (the admin "login as" preview short-circuit). Default timeout is the framework's
    // 60s; /api/chat passes its own 30s (see _sendMessage), health-advice 290s (tool-actions).
    async _req(url : string, method : string, data : UTSJSONObject | null, timeoutMs : number) : Promise<RespEnvelope> {
      let body = data
      if (state.sandboxMode && method != 'GET') {
        const injected = new UTSJSONObject()
        if (data != null) data!.toMap().forEach((v : any | null, k : string) => { injected[k] = v })
        injected['sandbox'] = true
        body = injected
      }
      const to = timeoutMs > 0 ? timeoutMs : 60000
      if (method == 'POST') return _envelopeRun(url, 'POST', body, to)
      if (method == 'PUT') return _envelopeRun(url, 'PUT', body, to)
      if (method == 'DELETE') return _envelopeRun(url, 'DELETE', body, to)
      if (method == 'PATCH') return _envelopeRun(url, 'PATCH', body, to)
      return _envelopeRun(url, 'GET', body, to)
    },

    // Fetches the AUTHORITATIVE phone_verified/email_verified state from the server rather than
    // the locally cached flag, which is only refreshed on a fresh login — a returning session
    // restores it straight from storage and never re-syncs, so a pre-migration account whose cache
    // still says true would otherwise sail past the store gate (real incident). Falls back to the
    // cached values on network error so a flaky connection doesn't block store access.
    async _checkIdentityVerified() : Promise<IdentityFlags> {
      const flags = new IdentityFlags()
      const user = this.user
      if (user == null || user!.getBoolean('guest') == true) return flags
      flags.phone = user!.getBoolean('phone_verified') == true
      flags.email = user!.getBoolean('email_verified') == true
      try {
        const res = await this._req(`${BASE}/api/users/${user!.getString('user_id')}`, 'GET', null, 0)
        const u = res.data != null ? res.data!.getJSON('user') : null
        if (u != null) {
          flags.phone = u!.getBoolean('phone_verified') == true
          flags.email = u!.getBoolean('email_verified') == true
        }
        const updated = this._copyUser()
        updated['phone_verified'] = flags.phone
        updated['email_verified'] = flags.email
        this.user = updated
        state.user = updated
        uni.setStorageSync('nano_user', updated)
      } catch (e : any) {}
      return flags
    },

    async _checkPhoneVerified() : Promise<boolean> {
      return (await this._checkIdentityVerified()).phone
    },

    // scroll-view pull-to-load-history refresher (bindrefresherrefresh in the source).
    onPullLoadMore() { this._loadMoreHistory() },
  },
}
</script>

<style>
/* Native only — the web build is styled by static/web/ (the web user-app's own CSS). */
/* #ifndef WEB */
/* STRUCTURAL port of main.wxss (5592 lines of WebView CSS → the uvue subset). Palette and layout
   lifted; gradients, keyframes, safe-area env() and the --fs-* variable cascade are NOT expressed
   here. TODO(port): a real-device styling pass; the miniapp's .theme-light overrides and the
   light-theme contrast re-solve (--chat-good/--chat-high ≈ 5.1:1 on the tinted cards) come with it.
   Dark tokens: navy #0B1C2E page, card #162E4A / #12283F, accent #6375EC, blue #2E7CF6,
   text #EAF2FB / sub #A6C4E5, user bubble gradient flattened to #6375EC. */

.main { flex: 1; background-color: #0B1C2E; }
/* #ifdef MP-WEIXIN */
.main { background-image: radial-gradient(at 50% 0%, rgb(20, 40, 71) 0%, rgb(11, 28, 46) 70%); }
.theme-light { background-image: none; }
/* #endif */
.theme-light { background-color: #FAF7F2; }
.status-bar-spacer { background-color: rgba(11, 28, 46, 0.85); }

.app-header { flex-direction: row; align-items: center; padding: 8px 16px 12px; background-color: rgba(11, 28, 46, 0.85); border-top-width: 0px; border-right-width: 0px; border-bottom-width: 1px; border-left-width: 0px; border-bottom-color: rgba(99, 117, 236, 0.18); border-style: solid; }
.header-logo-btn { flex-direction: row; align-items: center; }
.header-logo-img { width: 29px; height: 22px; border-radius: 0px; margin-right: 6px; }
.header-title { color: #EEF2FF; font-size: 14px; font-weight: bold; letter-spacing: 4px; }
.header-divider { width: 1px; height: 16px; background-color: rgba(99, 117, 236, 0.25); margin-left: 10px; margin-right: 10px; }
.header-user { color: #A6C4E5; font-size: 14px; flex: 1; }
.header-version { color: rgba(99, 117, 236, 0.7); background-color: rgba(99, 117, 236, 0.12); border: 1px solid rgba(99, 117, 236, 0.25); border-radius: 4px; padding: 2px 5px; font-size: 9px; flex-shrink: 0; }

.sandbox-banner { flex-direction: row; align-items: center; justify-content: space-between; padding: 6px 14px; background-color: rgba(245, 158, 11, 0.16); }
.sandbox-banner-text { color: #FBBF24; font-size: 12px; flex: 1; }
.sandbox-banner-exit { color: #FBBF24; font-size: 12px; font-weight: bold; }
.viva-expired-banner { flex-direction: row; align-items: center; justify-content: space-between; padding: 6px 14px; background-color: rgba(99, 117, 236, 0.16); }
.viva-expired-banner-text { color: #A0B4FF; font-size: 12px; flex: 1; }
.viva-expired-banner-btn { color: #A0B4FF; font-size: 12px; font-weight: bold; }

.menu-mask { position: absolute; left: 0; top: 0; right: 0; bottom: 0; z-index: 100; }
.menu-dropdown { position: absolute; left: 12px; background-color: #0F2540; border: 1px solid rgba(99, 117, 236, 0.25); border-radius: 10px; min-width: 120px; overflow: hidden; box-shadow: rgba(0, 0, 0, 0.5) 0px 4px 20px 0px; }
.menu-item { flex-direction: row; align-items: center; padding: 14px 16px; color: rgb(238, 242, 255); }
.menu-item-icon { color: #A6C4E5; font-size: 14px; margin-right: 10px; }
.menu-item-label { color: #EEF2FF; font-size: 14px; }
.menu-divider { height: 1px; background-color: rgba(99, 117, 236, 0.15); margin: 0 12px; }
.menu-credit-row { flex-direction: row; align-items: center; justify-content: space-between; background-color: rgba(99, 117, 236, 0.08); padding: 12px 16px 12px 16px; }
.menu-credit-label { color: rgba(166, 196, 229, 0.7); font-size: 11px; letter-spacing: 1px; }
.menu-credit-value { color: rgb(99, 117, 236); font-size: 14px; font-weight: bold; }
.menu-fs-row { flex-direction: row; align-items: center; padding: 10px 16px 10px 16px; }
.menu-fs-steps { flex-direction: row; margin-left: auto; }
.menu-fs-step { width: 29px; height: 29px; margin-left: 5px; border-radius: 6px; background-color: transparent; border-style: solid; border-width: 1px; border-color: rgba(99, 117, 236, 0.25); flex-direction: row; align-items: center; justify-content: center; }
.menu-fs-step-on { background-color: rgba(99, 117, 236, 0.22); border-color: #6375EC; }
.menu-fs-a0 { color: rgb(238, 242, 255); font-size: 10px; }
.menu-fs-a1 { color: #A6C4E5; font-size: 13px; }
.menu-fs-a2 { color: rgb(166, 196, 229); font-size: 16px; }
.menu-fs-a3 { color: rgb(166, 196, 229); font-size: 19px; }

.tab-content { flex: 1; }
.chat-tab { flex: 1; }
.health-tab { flex: 1; }
.plans-tab { flex: 1; }
.store-tab { flex: 1; }
.learn-tab { flex: 1; }

/* ── Chat ── */
.chat-messages { flex: 1; }
/* 100px bottom padding == the miniapp's 200rpx: AGENTS §23 — the short-last-message clipping fix.
   Do not shrink without confirming the underlying repaint bug is actually fixed. */
.chat-inner { flex-direction: column; padding: 12px 14px 104px 14px; }
.chat-history-load { align-items: center; padding: 7px 0 3px; flex-direction: row; justify-content: center; }
.chat-history-text { color: rgba(160, 180, 220, 0.6); font-size: 11px; }
.chat-history-start { align-items: center; padding: 7px 0 3px; }
.chat-history-start-text { color: rgba(160, 180, 220, 0.35); font-size: 10px; }
.msg-row { flex-direction: row; margin-bottom: 8px; }
.msg-row-user { justify-content: flex-end; }
.msg-row-ai { justify-content: flex-start; }
.msg-daysep { align-items: center; padding: 6px 0 2px; color: rgb(238, 242, 255); flex-direction: row; justify-content: center; }
.msg-daysep-text { color: #7F97B5; font-size: 11px; letter-spacing: 0.5px; }
.message-bubble { max-width: 320px; padding: 9px 12px; border-radius: 14px; }
/* uni-app x: <rich-text> has no intrinsic width — it collapses to 0 inside a fit-content bubble
   unless told how wide to lay out. 334px is a 390px screen's; the template sets msgTextW per phone. */
.msg-html { width: 334px; font-size: 14.5px; line-height: 23.5px; color: #EEF2FF; }
.msg-seg { width: 334px; }
.message-user { background-color: #6375EC; }
.msg-text-user { color: #FFFFFF; font-size: 14px; line-height: 22px; }
.msg-text { color: rgb(255, 255, 255); font-size: 14px; line-height: 22px; }
.message-ai { padding: 11px 13px; background-color: #162E4A; border: 1px solid rgba(99, 117, 236, 0.18); }
.message-coach { background-color: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.3); }
.msg-coach-label { color: #34D399; font-size: 10px; font-weight: bold; }
.msg-ag-label { color: #A0B4FF; font-size: 10px; font-weight: bold; }
.msg-bubble-image { padding: 0; }
.msg-image { width: 240px; border-radius: 8px; }
.msg-image-inset { margin-bottom: 7px; }
/* color moved into MD_TAG_STYLE node styles — view/rich-text ignore it (see top of script) */
.msg-rule { height: 1px; background-color: rgba(127, 127, 127, 0.3); margin-top: 12px; margin-bottom: 12px; }
.typing-indicator { flex-direction: row; align-items: center; }
.typing-dot { width: 6px; height: 6px; border-radius: 3px; margin-right: 5px; background-color: #6375EC;
  opacity: 0.35; transform: scale(0.7); transition-property: transform, opacity; transition-duration: 0.25s; }
.typing-dot-on { opacity: 1; transform: scale(1.2); }
.typing-status-text { color: #A6C4E5; font-size: 11px; margin-left: 8px; }
.msg-action-card { flex-direction: row; align-items: center; background-color: rgba(99, 117, 236, 0.12); border: 1px solid rgba(99, 117, 236, 0.3); border-radius: 10px; padding: 8px 12px; }
.msg-action-label { color: #A0B4FF; font-size: 13px; }
.msg-action-arrow { color: #A0B4FF; font-size: 14px; margin-left: 6px; }

/* metric tiles */
.mcard { flex-direction: row; flex-wrap: wrap; margin-top: 7px; margin-bottom: 9px; }
.mcard-tile { width: 48%; background-color: rgba(99, 117, 236, 0.08); border: 1px solid rgba(99, 117, 236, 0.2); border-left-width: 3px; border-left-color: #64748B; border-radius: 8px; padding: 8px; margin: 2px; }
.mcard-good { border-left-color: #10B981; }
.mcard-normal { border-left-color: #64748B; }
.mcard-watch { border-left-color: #F59E0B; }
.mcard-high { border-left-color: #EF4444; }
.mcard-low { border-left-color: #3B82F6; }
.mcard-none { border-left-color: rgba(127, 127, 127, 0.35); }
.mcard-label { color: #A6C4E5; font-size: 11px; }
.mcard-valrow { flex-direction: row; align-items: flex-end; margin-top: 2px; }
.mcard-val { color: #EEF2FF; font-size: 18px; font-weight: bold; }
.mcard-unit { color: #A6C4E5; font-size: 11px; margin-left: 3px; }
.mcard-footrow { flex-direction: row; align-items: center; margin-top: 4px; }
.mcard-pill { background-color: rgba(127, 127, 127, 0.14); color: #C3D6EE; font-size: 10px; border-radius: 10px; padding: 1px 6px; }

/* spark bars (declarative — biomarker-series builds them; height set inline) */
.spark { flex-direction: row; align-items: flex-end; height: 18px; margin-left: auto; }
.spark-bar { width: 5px; border-radius: 2px; background-color: rgba(238, 242, 255, 0.55); margin-right: 2px; }
.spark-bar-last { background-color: rgba(238, 242, 255, 0.9); }
.spark-bar-last-good { background-color: #6EE7B7; }
.spark-bar-last-bad { background-color: #FFB3B3; }
.spark-bar-last-flat { background-color: rgba(238, 242, 255, 0.9); }
.spark-delta { font-size: 10px; }
.spark-d-good { color: #6EE7B7; }
.spark-d-bad { color: #FFB3B3; }

/* takeaway */
.tcard { background-color: rgba(99, 117, 236, 0.1); border: 1px solid rgba(99, 117, 236, 0.28); border-left: 3px solid #6375EC; border-radius: 8px; padding: 9px 11px; margin-top: 7px; margin-bottom: 9px; color: rgb(238, 242, 255); }
.tcard-title { color: #A0B4FF; font-size: 10px; font-weight: bold; letter-spacing: 0.5px; margin: 0px 0px 4px 0px; }

/* dots chips */
.dcard { flex-direction: row; flex-wrap: wrap; margin-top: 6px; }
.dcard-chip { background-color: rgba(99, 117, 236, 0.1); border: 1px solid rgba(99, 117, 236, 0.25); border-radius: 8px; padding: 5px 8px; margin: 2px; flex-direction: row; }
.dcard-id { color: #A0B4FF; font-size: 12px; font-weight: bold; }
.dcard-name { color: #EEF2FF; font-size: 12px; margin-left: 4px; }
.dcard-note { color: #A6C4E5; font-size: 11px; margin-left: 4px; }

/* formula card */
.fcard { background-color: rgba(99, 117, 236, 0.06); border-radius: 10px; color: rgb(238, 242, 255); padding: 12px 13px 10px 13px; margin: 7px 0px 9px 0px; border-style: solid; border-width: 1px; border-color: rgba(99, 117, 236, 0.26); }
.fcard-head { flex-direction: row; justify-content: space-between; margin: 0px 0px 10px 0px; align-items: flex-end; }
.fcard-title { color: rgb(160, 180, 255); font-size: 13px; font-weight: bold; letter-spacing: 1px; }
.fcard-note { color: #A6C4E5; font-size: 9px; text-align: right; }
.fcard-tier { border-top: 1px solid rgba(99, 117, 236, 0.15); color: rgb(238, 242, 255); border-radius: 7px; background-color: rgba(127, 127, 127, 0.08); padding: 8px 9px 8px 9px; margin: 9px 0px 0px 0px; border-width: 0px; }
.fcard-tier-head { flex-direction: row; align-items: flex-end; justify-content: space-between; padding: 3px 0px 3px 0px; }
.fcard-tier-name { flex-direction: row; align-items: flex-end; }
.fcard-tier-label { color: #EEF2FF; font-size: 12px; font-weight: bold; letter-spacing: 1px; }
.fcard-tier-rec { color: rgb(160, 180, 255); font-size: 9px; background-color: rgba(99, 117, 236, 0.18); border-radius: 519px; padding: 1px 6px; margin-left: 6px; }
.fcard-tier-chev { color: #A6C4E5; font-size: 11px; padding: 0px 0px 0px 4px; }
.fcard-tier-note { font-size: 10px; color: rgb(166, 196, 229); margin: 4px 0px 0px 0px; }
.fcard-tier-note-text { color: #A6C4E5; font-size: 11px; }
.fcard-tier-pitch { color: #A6C4E5; font-size: 11px; margin: 6px 0px 0px 0px; }
.fcard-days { flex-direction: row; align-items: flex-end; margin-top: 4px; margin-bottom: 6px; }
.fcard-daylabel { color: #EEF2FF; font-size: 11px; font-weight: bold; letter-spacing: 1px; }
.fcard-daytag { color: #A0B4FF; font-size: 9px; padding: 1px 6px; border-radius: 519px; background-color: rgba(99, 117, 236, 0.18); margin-left: 6px; }
.fcard-row { flex-direction: row; align-items: center; margin: 3px 0px 6px 0px; }
.fcard-slot { color: #A6C4E5; font-size: 10px; width: 29px; }
.fcard-track { flex: 1; flex-direction: row; height: 13px; border-radius: 6px; overflow: hidden; background-color: rgba(127, 127, 127, 0.16); }
.fcard-seg { height: 13px; }
.fcard-num { color: rgb(160, 180, 255); font-size: 11px; width: 30px; text-align: right; font-weight: bold; }
.fcard-legend { flex-direction: row; flex-wrap: wrap; margin: 6px 0px 0px 0px; }
.fcard-leg { flex-direction: row; align-items: center; margin-right: 8px; margin-top: 2px; color: rgb(238, 242, 255); }
.fcard-swatch { width: 8px; height: 8px; border-radius: 2px; margin-right: 3px; }
.fcard-leg-name { color: rgb(238, 242, 255); font-size: 10px; }
.fcard-leg-num { color: rgb(166, 196, 229); font-size: 9px; margin-left: 2px; }
.fcard-leg-weeks { color: #FBBF24; font-size: 10px; margin-left: 2px; }
.fcard-foot { color: rgb(166, 196, 229); font-size: 10px; border-top-width: 1px; border-right-width: 0px; border-bottom-width: 0px; border-left-width: 0px; border-top-color: rgba(127, 127, 127, 0.18); padding: 7px 0px 0px 0px; margin: 8px 0px 0px 0px; border-style: solid; }
.fcard-cycle { color: #A6C4E5; font-size: 11px; margin: 9px 0px 0px 0px; }
.fcard-tier-hint { color: #7F97B5; font-size: 10px; margin: 7px 0px 0px 0px; }
.fcard-upgrades { border-top: 1px solid rgba(99, 117, 236, 0.15); margin-top: 8px; padding-top: 6px; }
.fcard-uphead { color: #A6C4E5; font-size: 11px; font-weight: bold; }
.fcard-rung { margin-top: 6px; }
.fcard-rung-head { flex-direction: row; align-items: center; }
.fcard-rung-label { color: #EEF2FF; font-size: 12px; }
.fcard-rung-add { color: #6EE7B7; font-size: 11px; margin-left: 6px; }
.fcard-rung-pitch { color: #A6C4E5; font-size: 10px; }
.fcard-rung-hint { color: #7F97B5; font-size: 10px; margin-top: 4px; }
.fcard-owned { color: #6EE7B7; font-size: 11px; margin-top: 6px; }
.fcard-cta { background-color: rgba(99, 117, 236, 0.16); border: 1px solid rgba(99, 117, 236, 0.40); border-radius: 8px; padding: 9px 12px; margin-top: 9px; align-items: center; font-size: 12px; color: rgb(160, 180, 255); font-weight: bold; text-align: center; }
.fcard-cta-label { color: #A0B4FF; font-size: 12px; font-weight: 600; }
.fcard-agnote { color: #FBBF24; font-size: 11px; margin-top: 6px; }

/* product / grocery cards */
.pcard { background-color: rgba(16, 185, 129, 0.07); border: 1px solid rgba(16, 185, 129, 0.25); border-radius: 10px; padding: 10px; margin-top: 7px; }
.pcard-title { color: #6EE7B7; font-size: 12px; font-weight: bold; }
.pcard-row { flex-direction: row; align-items: center; padding: 8px 0; border-bottom: 1px solid rgba(127, 127, 127, 0.12); }
.pcard-main { flex: 1; }
.pcard-name { color: #EEF2FF; font-size: 13px; }
.pcard-reason { color: #A6C4E5; font-size: 11px; }
.pcard-price { color: #EEF2FF; font-size: 12px; }
.pcard-arrow { color: #A6C4E5; margin-left: 6px; }
.gcard { background-color: rgba(245, 158, 11, 0.07); border: 1px solid rgba(245, 158, 11, 0.25); border-radius: 10px; padding: 10px; margin-top: 7px; }
.gcard-title { color: #FBBF24; font-size: 12px; font-weight: bold; }
.gcard-row { flex-direction: row; align-items: center; padding: 7px 0; }
.gcard-img { width: 44px; height: 44px; border-radius: 6px; margin-right: 8px; }
.gcard-img-empty { background-color: #162E4A; }
.gcard-main { flex: 1; }
.gcard-name { color: #EEF2FF; font-size: 13px; }
.gcard-reason { color: #A6C4E5; font-size: 11px; }
.gcard-supplier { color: #7F97B5; font-size: 10px; }
.gcard-price { color: #EEF2FF; font-size: 12px; }
.gcard-note { color: #7F97B5; font-size: 10px; margin-top: 4px; }

/* lesson / checkin cards */
.lcard { background-color: rgba(99, 117, 236, 0.08); border: 1px solid rgba(99, 117, 236, 0.25); border-radius: 10px; padding: 10px; margin-top: 7px; }
.lcard-video { width: 100%; height: 180px; border-radius: 8px; }
.lcard-cover { height: 90px; border-radius: 8px; background-color: #12283F; align-items: center; justify-content: center; }
.lcard-play { color: #A0B4FF; font-size: 13px; }
.lcard-meta { flex-direction: row; align-items: center; justify-content: space-between; margin-top: 6px; }
.lcard-title { color: #EEF2FF; font-size: 12px; flex: 1; }
.lcard-done { color: #6EE7B7; font-size: 11px; }
.ccard { margin-top: 7px; }
.ccard-cta { background-color: #6375EC; border-radius: 10px; padding: 10px; align-items: center; }
.ccard-cta-label { color: #FFFFFF; font-size: 13px; font-weight: bold; }
.ccard-cta-off { background-color: rgba(99, 117, 236, 0.3); }
.ccard-done { color: #6EE7B7; font-size: 12px; }

/* chat input */
.ob-bar { flex-direction: row; align-items: center; padding: 8px 14px; background-color: #12283F; }
.ob-input { flex: 1; height: 40px; background-color: #162E4A; color: #EEF2FF; border-radius: 10px; padding-left: 10px; }
.ob-ph { color: rgba(166, 196, 229, 0.5); }
.ob-confirm { background-color: #6375EC; border-radius: 10px; padding: 10px 14px; margin-left: 8px; }
.ob-confirm-label { color: #FFFFFF; font-size: 14px; }
.ob-confirm-off { background-color: rgba(99, 117, 236, 0.35); }
.quick-btn { background-color: #162E4A; border: 1px solid rgba(99, 117, 236, 0.35); border-radius: 20px; padding: 8px 16px; margin-right: 8px; }
.quick-btn-label { color: #EEF2FF; font-size: 14px; }
.picker-row { flex: 1; flex-direction: row; align-items: center; background-color: #162E4A; border-radius: 10px; padding: 10px 12px; }
.picker-val { color: #EEF2FF; font-size: 14px; flex: 1; }
.picker-arrow { color: #A6C4E5; }
.slider-row { flex: 1; margin-top: 6px; }
.slider-labels { flex-direction: row; align-items: center; justify-content: space-between; }
.slider-key { color: #A6C4E5; font-size: 12px; }
.slider-value-wrap { flex-direction: row; align-items: center; }
.slider-val-input { width: 70px; height: 30px; background-color: #162E4A; color: #EEF2FF; border-radius: 8px; text-align: right; }
.slider-unit { color: #A6C4E5; font-size: 11px; margin-left: 4px; }
.slider-control-row { flex-direction: row; align-items: center; }
.slider-step-btn { width: 30px; height: 30px; border-radius: 8px; background-color: #162E4A; color: #A6C4E5; text-align: center; align-items: center; justify-content: center; }
.slider-input { flex: 1; }
.cond-chips { flex-direction: row; flex-wrap: wrap; flex: 1; }
.cond-chip { background-color: #162E4A; border: 1px solid rgba(99, 117, 236, 0.3); border-radius: 16px; padding: 6px 12px; margin: 3px; }
.cond-chip-label { color: #EEF2FF; font-size: 12px; }
.cond-chip-on { background-color: #6375EC; }
.cond-other-input { margin-top: 6px; }
.kino-scan-bar { justify-content: space-between; }
.kino-scan-btn { flex-direction: row; align-items: center; background-color: #6375EC; border-radius: 10px; padding: 9px 16px; }
.kino-scan-icon { color: #FFFFFF; margin-right: 6px; }
.kino-scan-label { color: #FFFFFF; font-size: 13px; }
.kino-scan-close { color: #A6C4E5; font-size: 16px; padding: 6px 10px; }
.kino-scan-x { color: #A6C4E5; font-size: 16px; }
.ai-disclaimer { align-items: center; color: rgb(238, 242, 255); text-align: center; padding: 4px 12px 2px 12px; }
.ai-disclaimer-text { color: rgba(255, 255, 255, 0.3); font-size: 10px; letter-spacing: 1px; text-align: center; }
.input-container { }
.input-area { flex-direction: row; align-items: flex-end; background-color: rgba(11, 28, 46, 0.92); border-top: 1px solid rgba(99, 117, 236, 0.18); padding: 10px 12px; }
.plus-btn { width: 40px; height: 40px; border-radius: 12px; background-color: rgba(99, 117, 236, 0.12); border: 1px solid rgba(99, 117, 236, 0.25); align-items: center; justify-content: center; margin-right: 8px; flex-direction: row; }
.plus-btn-open { background-color: rgba(99, 117, 236, 0.3); border-color: #6375EC; }
.plus-icon { color: #A6C4E5; font-size: 20px; }
.chat-textarea { flex: 1; background-color: #162E4A; color: #EEF2FF; border: 1px solid rgba(99, 117, 236, 0.22); border-radius: 12px; font-size: 14px; line-height: 20px; padding: 9px 12px 9px 12px; }
.textarea-ph { color: rgba(166, 196, 229, 0.5); }
.mic-btn { width: 40px; height: 40px; border-radius: 12px; background-color: rgba(99, 117, 236, 0.12); border: 1px solid rgba(99, 117, 236, 0.25); align-items: center; justify-content: center; margin-left: 8px; flex-direction: row; }
.mic-icon-img { width: 18px; height: 18px; }
.guest-signup-btn { width: auto; padding-left: 14px; padding-right: 14px; border-width: 0px; background-color: #6375EC; background-image: linear-gradient(135deg, #6375EC 0%, #8B9FFF 100%); box-shadow: 0 2px 10px rgba(99, 117, 236, 0.45); }
.guest-signup-btn-text { color: #FFFFFF; font-size: 13px; font-weight: bold; }
.send-btn { width: 40px; height: 40px; border-radius: 12px; background-color: rgba(99, 117, 236, 0.25); align-items: center; justify-content: center; margin-left: 8px; }
.send-active { background-color: #6375EC; }
.send-icon { color: #FFFFFF; font-size: 17px; }

/* ── inner tab bars (plans / learn) ── */
.inner-tab-bar { flex-direction: row; background-color: #0A1F36; border-bottom: 1px solid #1E3A5F; }
.inner-tab { flex: 1; align-items: center; padding: 10px 0; color: rgb(238, 242, 255); flex-direction: row; justify-content: center; }
.inner-tab-text { color: rgb(122, 154, 191); font-size: 13px; }
.inner-tab-text-on { color: #A0B4FF; font-size: 13px; font-weight: bold; }

/* ── Plans tab ── */
.plans-scroll { flex: 1; padding: 0px 0px 0px 0px; }
.plans-header { flex-direction: row; align-items: center; justify-content: space-between; padding: 18px 16px 8px 16px; }
.plans-title { color: #EEF2FF; font-size: 17px; font-weight: bold; }
.plans-browse-btn { background-color: rgba(99, 117, 236, 0.15); border-radius: 10px; padding: 6px 12px; color: rgb(238, 242, 255); border-style: solid; border-width: 1px; border-color: rgba(99, 117, 236, 0.4); }
.plans-browse-btn-text { color: rgb(139, 159, 255); font-size: 12px; }
.plans-empty { align-items: center; padding: 24px 0; }
.plans-empty-text { color: #A6C4E5; font-size: 13px; }
.plans-browse-cta { background-color: #6375EC; border-radius: 10px; padding: 8px 16px; margin-top: 10px; }
.plans-browse-cta-text { color: #FFFFFF; font-size: 13px; }
.loading-dots { color: #A6C4E5; font-size: 16px; }
/* (.guest-sheet: the miniapp's 32rpx flex gap → 16px child margins) */
/* miniapp main.wxss .guest-lock-* (its 28rpx flex gap → 14px child margins) */
.guest-lock-card { margin: 32px 16px 16px; padding: 32px 24px; background-color: rgba(15, 37, 64, 0.5); border-style: solid; border-width: 1px; border-color: rgba(99, 117, 236, 0.15); border-radius: 16px; align-items: center; }
.guest-lock-icon { color: #EEF2FF; font-size: 36px; }
.guest-lock-text { color: rgba(166, 196, 229, 0.7); font-size: 14px; line-height: 24px; text-align: center; margin-top: 14px; padding: 0 8px; }
.guest-lock-title { color: rgba(166, 196, 229, 0.7); font-size: 14px; line-height: 24px; text-align: center; margin-top: 14px; padding: 0 8px; }
.guest-lock-btn { margin-top: 20px; background-color: #6375EC; background-image: linear-gradient(135deg, #6375EC 0%, #8B9FFF 100%); padding: 12px 36px; border-radius: 50px; box-shadow: 0 4px 20px rgba(99, 117, 236, 0.4); }
.guest-lock-label { color: #FFFFFF; font-size: 14px; font-weight: bold; }
.neo-bind-card { margin: 10px 16px 6px; padding: 12px 14px; border-radius: 10px; }
.neo-bind-card .guest-lock-icon { font-size: 16px; }
.neo-bind-card .guest-lock-title { font-size: 11px; line-height: 16.5px; padding: 0; margin-top: 6px; }
.neo-bind-card .guest-lock-btn { margin-top: 7px; padding: 7px 20px; box-shadow: 0 2px 10px rgba(99, 117, 236, 0.35); }
.neo-bind-card .guest-lock-label { font-size: 11px; }
.plan-card { background-color: rgba(255, 255, 255, 0.04); border-radius: 10px; color: rgb(238, 242, 255); padding: 14px 14px 14px 14px; margin: 10px 12px 12px 12px; border-style: solid; border-width: 1px; border-color: rgba(255, 255, 255, 0.07); }
.plan-card-header { flex-direction: column; align-items: stretch; margin: 0px 0px 10px 0px; }
.plan-type-badge { align-self: flex-start; border-radius: 10px; margin-bottom: 5px; background-color: rgba(99, 117, 236, 0.2); padding: 2px 9px 2px 9px; flex-direction: row; }
.plan-type-primary { background-color: rgba(99, 117, 236, 0.25); }
.plan-type-secondary { background-color: rgba(16, 185, 129, 0.2); }
.plan-type-text { color: rgb(139, 159, 255); font-size: 10px; font-weight: bold; }
.plan-card-name { color: #EEF2FF; font-size: 14px; font-weight: bold; flex: 1; }
.plan-progress-bar-track { height: 6px; border-radius: 4px; background-color: rgba(255, 255, 255, 0.08); margin: 8px 0px 8px 0px; }
.plan-progress-bar-fill { height: 6px; border-radius: 4px; background-color: transparent; background-image: linear-gradient(90deg, rgb(99, 117, 236), rgb(139, 159, 255)); }
.plan-card-meta-row { flex-direction: row; justify-content: space-between; margin: 6px 0px 10px 0px; }
.plan-meta-item { color: rgb(107, 140, 174); font-size: 11px; }
.plan-daily-section { margin: 10px 0px 0px 0px; }
.plan-daily-tasks { flex-direction: row; flex-wrap: wrap; margin: 0px 0px 7px 0px; }
.plan-task-chip { flex: 1; flex-direction: row; align-items: center; background-color: rgba(255, 255, 255, 0.04); border-radius: 7px; margin: 0px 3px; padding: 6px 7px 6px 7px; border-style: solid; border-width: 1px; border-color: rgba(255, 255, 255, 0.1); justify-content: space-between; }
.plan-task-done { background-color: rgba(16, 185, 129, 0.18); }
.plan-task-label { color: rgba(255, 255, 255, 0.6); font-size: 10px; }
.plan-task-check { color: rgba(255, 255, 255, 0.25); font-size: 10px; margin: 0px 0px 0px 3px; }
.plan-daily-bar-row { flex-direction: row; align-items: center; margin-top: 6px; }
.plan-daily-bar-track { flex: 1; height: 4px; border-radius: 3px; background-color: rgba(255, 255, 255, 0.07); }
.plan-daily-bar-fill { height: 4px; border-radius: 3px; background-color: transparent; background-image: linear-gradient(90deg, rgb(99, 117, 236), rgb(139, 159, 255)); }
.plan-daily-complete { background-color: #10B981; }
.plan-daily-count { color: rgba(255, 255, 255, 0.35); font-size: 10px; margin-left: 8px; }
.reminders-section { color: rgb(238, 242, 255); margin: 16px 12px 8px 12px; }
.reminders-section-title { color: rgb(107, 140, 174); font-size: 13px; font-weight: bold; letter-spacing: 1px; padding: 4px 0px 0px 0px; margin: 0px 0px 8px 0px; }
/* #ifdef MP-WEIXIN */
.reminders-section-title { text-transform: uppercase; }
/* #endif */
.reminders-empty { padding: 6px 0px 4px 0px; }
.reminder-card { background-color: #12283F; border-radius: 10px; padding: 10px; margin-top: 8px; }
.reminder-card-top { flex-direction: row; align-items: center; justify-content: space-between; }
.reminder-content { color: #EEF2FF; font-size: 13px; flex: 1; }
.reminder-source-badge { border-radius: 8px; padding: 2px 8px; }
.reminder-source-coach { background-color: rgba(16, 185, 129, 0.18); }
.reminder-source-ai { background-color: rgba(99, 117, 236, 0.18); }
.reminder-source-text { color: #EEF2FF; font-size: 10px; }
.reminder-card-bottom { flex-direction: row; align-items: center; margin-top: 4px; }
.reminder-date { color: rgb(107, 140, 174); font-size: 11px; }
.reminder-recur-badge { background-color: rgba(245, 158, 11, 0.15); border-radius: 8px; padding: 1px 6px; margin-left: 8px; }
.reminder-recur-text { color: #FBBF24; font-size: 10px; }

/* dots subtab */
.dots-subtab-scroll { flex: 1; padding: 0px 0px 0px 0px; }
.cart-section { margin-top: 10px; }
.cart-section-hdr { flex-direction: row; align-items: center; justify-content: space-between; }
.cart-section-title { color: #EEF2FF; font-size: 14px; font-weight: bold; }
.cart-sim-btn { width: 26px; height: 26px; border-radius: 13px; background-color: rgba(99, 117, 236, 0.2); align-items: center; justify-content: center; }
.cart-sim-btn-icon { color: #A0B4FF; font-size: 16px; }
.cart-grid { flex-direction: row; flex-wrap: wrap; margin-top: 8px; }
.cart-slot { width: 34px; margin-right: 10px; align-items: center; }
.cart-slot-empty { opacity: 0.4; }
.ink-bar-wrap { width: 18px; height: 44px; border-radius: 9px; background-color: #162E4A; justify-content: flex-end; overflow: hidden; }
.ink-bar-fill { width: 18px; border-radius: 9px; }
.cart-key { color: #A6C4E5; font-size: 9px; margin-top: 3px; }
.cart-remaining { color: #EEF2FF; font-size: 10px; }
.cart-empty { margin-top: 8px; }
.cart-empty-label { color: #A6C4E5; font-size: 12px; }
.cart-loading { margin-top: 10px; }
.pkg-section { margin-top: 16px; color: rgb(238, 242, 255); padding: 12px 18px 2px 18px; }
.pkg-section-title { color: #EEF2FF; font-size: 13px; font-weight: bold; letter-spacing: 1px; margin: 0px 0px 8px 0px; }
.pkg-card { background-color: rgba(166, 196, 229, 0.08); border: 1px solid rgba(166, 196, 229, 0.28); border-radius: 11px; padding: 12px 13px; margin: 8px 0px 8px 0px; }
.pkg-card-hdr { flex-direction: row; align-items: center; justify-content: space-between; }
.pkg-name { color: #EEF2FF; font-size: 13px; flex: 1; font-weight: bold; }
.pkg-stage { border-radius: 52px; padding: 3px 8px; background-color: rgba(166, 196, 229, 0.16); color: #A6C4E5; font-size: 10px; font-weight: 600; }
.pkg-stage-awaiting_formulation { background-color: rgba(245, 197, 106, 0.16); color: #F5C56A; }
.pkg-stage-shipped { background-color: rgba(245, 197, 106, 0.16); color: #F5C56A; }
.pkg-stage-delivered { background-color: rgba(245, 197, 106, 0.16); color: #F5C56A; }
.pkg-stage-active { background-color: rgba(52, 211, 153, 0.14); color: #34d399; }
.pkg-stage-cancelled { background-color: rgba(166, 196, 229, 0.1); color: rgba(166, 196, 229, 0.4); }
.pkg-stage-refunded { background-color: rgba(166, 196, 229, 0.1); color: rgba(166, 196, 229, 0.4); }
.pkg-meta { color: #A6C4E5; font-size: 11px; margin: 5px 0px 0px 0px; }
.pkg-track { flex-direction: row; align-items: center; justify-content: space-between; margin-top: 6px; background-color: rgba(14, 165, 233, 0.1); border-radius: 8px; padding: 6px 8px; }
.pkg-track-text { color: #A6C4E5; font-size: 11px; flex: 1; }
.pkg-track-copy { color: #A0B4FF; font-size: 11px; }
.pkg-cta { background-color: rgba(245, 197, 106, 0.18); border: 1px solid rgba(245, 197, 106, 0.5); border-radius: 52px; height: 33px; justify-content: center; align-items: center; margin-top: 10px; color: rgb(238, 242, 255); flex-direction: row; }
.pkg-cta-text { color: #F5C56A; font-size: 12px; font-weight: 600; letter-spacing: 1px; }
.pkg-cta-ghost { background-color: rgba(166, 196, 229, 0.12); border-color: rgba(166, 196, 229, 0.4); border-radius: 52px; flex-direction: row; }
.pkg-cta-text-ghost { color: #7A9ABF; font-size: 12px; font-weight: 600; }
.pkg-hint { color: #7F97B5; font-size: 11px; margin-top: 6px; }
.code-section { margin-top: 16px; padding: 12px 18px 2px 18px; }
.code-chip { color: #6EE7B7; font-size: 11px; background-color: rgba(16, 185, 129, 0.12); border-radius: 8px; padding: 2px 8px; }
.order-dots-card { background-color: rgba(245, 197, 106, 0.08); border: 1px solid rgba(245, 197, 106, 0.3); border-radius: 12px; padding: 16px; margin: 12px 18px 10px 18px; align-items: center; }
.order-dots-title { color: rgba(245, 197, 106, 0.95); font-size: 13px; font-weight: bold; text-align: center; }
.order-dots-detail { color: rgba(245, 197, 106, 0.6); font-size: 11px; margin-top: 5px; text-align: center; }
.order-dots-btn { background-color: rgba(245, 197, 106, 0.18); border: 1px solid rgba(245, 197, 106, 0.5); border-radius: 50px; height: 34px; padding: 0 20px; margin-top: 12px; align-items: center; justify-content: center; }
.order-dots-btn-text { color: #F5C56A; font-size: 12px; font-weight: bold; letter-spacing: 0.5px; }
.scan-box-card { background-color: rgba(166, 196, 229, 0.08); border: 1px solid rgba(166, 196, 229, 0.28); border-radius: 12px; padding: 14px 16px; flex-direction: row; align-items: center; justify-content: space-between; margin: 12px 18px 10px 18px; }
.scan-box-main { flex: 1; }
.scan-box-title { color: #EEF2FF; font-size: 13px; font-weight: bold; }
.scan-box-detail { color: rgba(166, 196, 229, 0.4); font-size: 11px; margin-top: 3px; }
.scan-box-icon { width: 22px; height: 22px; margin-left: 12px; opacity: 0.9; }
.dots-header { flex-direction: row; align-items: flex-end; justify-content: space-between; margin-top: 14px; padding: 14px 18px 10px 18px; }
.dots-title { color: rgba(166, 196, 229, 0.4); font-size: 13px; font-weight: bold; letter-spacing: 1px; }
/* #ifdef MP-WEIXIN */
.dots-title { text-transform: uppercase; }
/* #endif */
.dots-week-nav { flex-direction: row; align-items: center; margin-left: auto; }
.dots-week-arrow { color: rgba(166, 196, 229, 0.7); font-size: 20px; font-weight: bold; min-width: 32px; min-height: 32px; margin: 0 3px; flex-direction: row; align-items: center; justify-content: center; }
.dots-week-arrow-disabled { color: rgba(166, 196, 229, 0.2); }
.dots-week-label { color: rgba(166, 196, 229, 0.5); font-size: 11px; font-weight: 500; }
.center-wrap { align-items: center; padding: 41px 0px 41px 0px; flex-direction: row; justify-content: center; }
.dots-scroll { height: 210px; margin-top: 8px; }
.dots-days { flex-direction: row; }
.day-card { width: 70%; background-color: #162E4A; border: 1px solid rgba(99, 117, 236, 0.15); border-radius: 12px; padding: 10px; margin-right: 8px; }
.day-today { border-color: #6375EC; }
.day-label { color: #EEF2FF; font-size: 12px; font-weight: bold; }
.meal-slot { margin-top: 6px; border-radius: 8px; padding: 6px; background-color: rgba(127, 127, 127, 0.07); }
.meal-slot-active { background-color: rgba(99, 117, 236, 0.14); }
.meal-name { color: #A6C4E5; font-size: 10px; }
.dot-chips { flex-direction: row; flex-wrap: wrap; margin-top: 3px; }
.dot-chip { flex-direction: row; align-items: center; margin-right: 8px; }
.dot-swatch { width: 8px; height: 8px; border-radius: 4px; margin-right: 3px; }
.dot-key { color: #EEF2FF; font-size: 10px; }
.dot-count { color: #A6C4E5; font-size: 10px; }
.dots-empty { padding: 33px 29px 33px 29px; flex-direction: column; align-items: center; justify-content: center; }
.dots-empty-label { color: rgba(166, 196, 229, 0.4); font-size: 13.5px; line-height: 21.5px; text-align: center; }
.dispense-section { margin-top: 10px; align-items: center; }
.dispense-btn { background-color: #6375EC; border-radius: 24px; padding: 12px 26px; }
.dispense-btn-done { background-color: #10B981; }
.dispense-btn-error { background-color: #EF4444; }
.dispense-btn-loading { background-color: #475569; }
.dispense-btn-text { color: #FFFFFF; font-size: 14px; font-weight: bold; }

/* plan modals / sheets */
.modal-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(4, 10, 18, 0.72); justify-content: flex-end; }
.modal-sheet { background-color: rgb(26, 26, 46); border-top-left-radius: 16px; border-top-right-radius: 16px; width: 100%; padding: 29px 20px 33px 20px; }
.modal-title { color: rgb(255, 255, 255); font-size: 16px; font-weight: bold; margin: 0px 0px 16px 0px; }
.modal-input { height: 42px; background-color: #162E4A; color: #EEF2FF; border-radius: 10px; padding-left: 10px; }
.modal-actions { flex-direction: row; justify-content: flex-start; margin: 10px 0px 0px 0px; }
.modal-btn { flex: 1; border-radius: 10px; margin-left: 5px; margin-right: 5px; font-size: 14px; color: rgba(255, 255, 255, 0.55); text-align: center; padding: 12px 12px 12px 12px; background-color: rgba(255, 255, 255, 0.07); }
.modal-btn-cancel { background-color: rgba(255, 255, 255, 0.07); font-size: 14px; color: rgba(255, 255, 255, 0.55); text-align: center; padding: 12px 12px 12px 12px; }
.modal-btn-cancel-label { color: rgba(255, 255, 255, 0.55); font-size: 14px; }
.modal-btn-confirm { background-color: transparent; font-size: 14px; color: rgb(255, 255, 255); font-weight: bold; text-align: center; padding: 12px 12px 12px 12px; background-image: linear-gradient(90deg, rgb(99, 117, 236), rgb(139, 159, 255)); }
.modal-btn-confirm-label { color: #FFFFFF; font-size: 14px; font-weight: bold; }
.q-row { margin: 8px 0px 14px 0px; }
.q-label { color: rgba(255, 255, 255, 0.65); font-size: 13px; margin: 0px 0px 4px 0px; }
.overlay-mask { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(4, 10, 18, 0.72); justify-content: flex-end; }
.overlay-panel { background-color: rgb(15, 37, 64); border-top-left-radius: 16px; border-top-right-radius: 16px; width: 100%; height: 82%; padding: 0px 0px 0px 0px; }
.overlay-header { flex-direction: row; align-items: center; justify-content: flex-start; padding: 16px 20px 16px 20px; border-style: solid; border-top-width: 0px; border-right-width: 0px; border-bottom-width: 1px; border-left-width: 0px; border-bottom-color: rgb(30, 58, 95); }
.overlay-title { color: rgb(232, 240, 248); font-size: 16px; font-weight: bold; flex: 1; }
.overlay-close { padding: 0px 0px 0px 0px; flex-direction: row; align-items: center; justify-content: center; }
.close-x { color: rgb(122, 154, 191); font-size: 16px; }
.detail-tabs { flex-direction: row; margin-top: 8px; border-bottom: 1px solid #1E3A5F; background-color: rgb(10, 31, 54); }
.detail-tab { flex: 1; align-items: center; padding: 10px 0px 10px 0px; flex-direction: row; justify-content: center; }
.detail-tab-text { color: rgb(160, 180, 255); font-size: 13px; font-weight: bold; }
.detail-tab-text-on { color: #A0B4FF; font-size: 12px; font-weight: bold; }
.overlay-scroll { max-height: 380px; }
.plan-detail-section { margin-top: 12px; padding: 12px 16px 12px 16px; border-style: solid; border-top-width: 0px; border-right-width: 0px; border-bottom-width: 1px; border-left-width: 0px; border-bottom-color: rgba(255, 255, 255, 0.06); }
.plan-detail-label { color: rgb(107, 140, 174); font-size: 11px; margin: 0px 0px 4px 0px; }
.plan-detail-value { color: #EEF2FF; font-size: 13px; margin-top: 2px; }
.plan-section-label { font-weight: normal; color: rgb(107, 140, 174); letter-spacing: 1px; margin: 0px 0px 4px 0px; }
/* #ifdef MP-WEIXIN */
.plan-section-label { text-transform: uppercase; }
/* #endif */
.plan-empty-hint { color: rgb(238, 242, 255); font-size: 16px; margin-top: 2px; padding: 6px 0px 6px 0px; }
.plan-empty-hint-text { font-size: 12px; color: #4A6A8F; }
.plan-chips-row { flex-direction: row; flex-wrap: wrap; margin-top: 4px; }
.plan-chip { background-color: rgba(99, 117, 236, 0.15); border-radius: 10px; margin: 2px; padding: 3px 9px 3px 9px; }
.plan-chip-text { color: rgb(139, 159, 255); font-size: 11px; }
.plan-chip-dot { background-color: rgba(16, 185, 129, 0.14); }
.plan-reminder-row { flex-direction: row; align-items: center; justify-content: space-between; margin-top: 6px; }
.plan-reminder-info { flex: 1; }
.plan-reminder-time { color: #EEF2FF; font-size: 12px; }
.plan-reminder-content { color: #A6C4E5; font-size: 11px; }
.plan-reminder-toggle { border-radius: 8px; padding: 5px 10px; background-color: rgba(99, 117, 236, 0.18); }
.plan-reminder-toggle-label { color: #A0B4FF; font-size: 11px; }
.reminder-paused { background-color: rgba(245, 158, 11, 0.18); }
.plan-actions-row { flex-direction: row; justify-content: flex-start; margin-top: 16px; padding: 12px 16px 12px 16px; }
.plan-action-btn { border-radius: 8px; margin-right: 8px; padding: 10px 10px 10px 10px; border-style: solid; border-width: 1px; border-color: rgba(99, 117, 236, 0.3); background-color: rgba(99, 117, 236, 0.15); }
.plan-action-label { color: #FFFFFF; font-size: 12px; }
.plan-action-switch { background-color: rgba(99, 117, 236, 0.15); padding: 10px 10px 10px 10px; border-style: solid; border-width: 1px; border-color: rgba(99, 117, 236, 0.3); border-radius: 8px; }
.plan-action-abandon { background-color: rgba(239, 68, 68, 0.1); padding: 10px 10px 10px 10px; border-style: solid; border-width: 1px; border-color: rgba(239, 68, 68, 0.25); border-radius: 8px; }
.plan-action-buy { background-color: #10B981; margin-top: 8px; align-self: flex-start; }
.panel-center { align-items: center; padding: 30px 0; }
.empty-text { color: rgb(238, 242, 255); font-size: 16px; }
.events-list { margin-top: 6px; }
.event-card { background-color: #12283F; border-radius: 10px; padding: 12px; margin-top: 8px; }
.event-card-header { flex-direction: row; align-items: center; justify-content: space-between; }
.event-title { color: #EEF2FF; font-size: 14px; font-weight: bold; flex: 1; }
.event-badge-signed { background-color: rgba(16, 185, 129, 0.18); border-radius: 8px; padding: 2px 8px; }
.event-badge-signed-text { color: #6EE7B7; font-size: 10px; }
.event-meta { color: #A6C4E5; font-size: 11px; margin-top: 3px; }
.event-desc { color: #EEF2FF; font-size: 12px; margin-top: 4px; }
.event-card-actions { flex-direction: row; justify-content: flex-end; margin-top: 8px; }
.event-btn { border-radius: 8px; padding: 7px 14px; margin-left: 8px; }
.event-btn-label { color: #FFFFFF; font-size: 12px; }
.event-btn-signup { background-color: #6375EC; }
.event-btn-cancel { background-color: #EF4444; }
.event-btn-disabled { background-color: #475569; }
.browse-tpl-card { background-color: transparent; border-radius: 0px; margin-top: 8px; padding: 14px 16px 14px 16px; border-style: solid; border-top-width: 0px; border-right-width: 0px; border-bottom-width: 1px; border-left-width: 0px; border-bottom-color: rgba(255, 255, 255, 0.07); }
.browse-tpl-name { color: #EEF2FF; font-size: 14px; font-weight: bold; margin: 0px 0px 3px 0px; }
.browse-tpl-goal { color: #A6C4E5; font-size: 12px; margin: 3px 0px 3px 0px; }
.browse-tpl-meta { color: rgb(107, 140, 174); font-size: 11px; margin: 3px 0px 10px 0px; }
.browse-tpl-actions { flex-direction: row; justify-content: flex-start; margin-top: 8px; align-items: center; }
.browse-enrolled-badge { background-color: rgba(99, 117, 236, 0.15); border-radius: 10px; padding: 5px 12px 5px 12px; border-style: solid; border-width: 1px; border-color: rgba(99, 117, 236, 0.4); }
.browse-enrolled-label { color: #6EE7B7; font-size: 12px; }
.browse-join-row { flex: 1; flex-direction: row; }
.browse-join-btn { flex: 1; align-items: center; background-color: #6375EC; background-image: linear-gradient(90deg, #6375EC, #8B9FFF); border-radius: 8px; padding: 9px; margin-left: 4px; margin-right: 4px; }
.browse-join-label { color: #FFFFFF; font-size: 12px; font-weight: bold; }
.browse-join-label-secondary { color: #8B9FFF; }
.browse-join-secondary { background-color: rgba(99, 117, 236, 0.15); background-image: none; border-style: solid; border-width: 1px; border-color: rgba(99, 117, 236, 0.35); }
.browse-join-disabled { opacity: 0.35; }

/* focus sheet */
.focus-sheet { background-color: #0F2235; border-top-left-radius: 16px; border-top-right-radius: 16px; padding: 14px; width: 100%; }
.focus-intro { color: #EEF2FF; font-size: 13px; margin-top: 10px; }
.focus-hint { color: #A6C4E5; font-size: 12px; margin-top: 6px; }
.focus-plan-row { flex-direction: row; align-items: center; background-color: #162E4A; border-radius: 10px; padding: 10px; margin-top: 8px; }
.focus-plan-body { flex: 1; margin-left: 8px; }
.focus-plan-name { color: #EEF2FF; font-size: 13px; font-weight: bold; }
.focus-plan-goal { color: #A6C4E5; font-size: 11px; }
.focus-btn { border-radius: 10px; padding: 11px; margin-top: 10px; align-items: center; }
.focus-btn-label { color: #EEF2FF; font-size: 13px; }
.focus-btn-primary { background-color: #6375EC; }
.focus-btn-label-primary { color: #FFFFFF; font-size: 13px; font-weight: bold; }
.focus-btn-ghost { background-color: rgba(99, 117, 236, 0.16); }
.focus-btn-label-ghost { color: #A0B4FF; font-size: 13px; }
.focus-btn-row { flex-direction: row; justify-content: space-between; }
.focus-btn-half { flex: 1; margin-right: 6px; }

/* ── Store tab ── */
.store-header { flex-direction: row; align-items: flex-start; justify-content: space-between; padding: 14px 18px 10px 18px; }
.store-title { color: #EEF2FF; font-size: 17px; font-weight: bold; }
.store-header-right { flex-direction: row; align-items: center; }
.store-credit-card { flex-direction: row; align-items: center; background-color: transparent; border-radius: 13px; color: rgb(238, 242, 255); background-image: linear-gradient(150deg, rgb(29, 53, 101) 0%, rgb(22, 46, 74) 100%); box-shadow: rgba(99, 117, 236, 0.35) 0px 4px 16px 0px, rgba(255, 255, 255, 0.07) 0px 1px 0px 0px inset; padding: 9px 14px 9px 11px; border-style: solid; border-width: 1px; border-color: rgba(139, 159, 255, 0.45); }
.store-credit-card-num { color: rgb(255, 255, 255); font-size: 27px; font-weight: bold; letter-spacing: -1px; }
.store-credit-card-unit { color: rgba(160, 180, 255, 0.65); font-size: 9px; font-weight: bold; margin: 0px 0px 2px 3px; }
.store-credit-card-label { color: #A6C4E5; font-size: 9px; margin-left: 8px; }
.store-cart-icon { width: 32px; height: 32px; border-radius: 16px; background-color: #6375EC; align-items: center; justify-content: center; margin-left: 10px; }
.store-cart-badge { color: #FFFFFF; font-size: 12px; font-weight: bold; }
.store-subtab-row { flex-direction: row; padding: 0 12px; }
.store-subtab-btn { border-radius: 14px; padding: 6px 14px; margin-right: 8px; background-color: #162E4A; }
.store-subtab-label { color: #A6C4E5; font-size: 12px; }
.store-subtab-active { background-color: #6375EC; }
.store-subtab-label-on { color: #FFFFFF; font-size: 12px; font-weight: bold; }
.store-scroll { flex: 1; padding: 8px 12px; }
.store-list { }
.store-card { background-color: #162E4A; border: 1px solid rgba(99, 117, 236, 0.15); border-radius: 12px; padding: 12px; margin-top: 8px; }
.store-tag { position: absolute; top: -6px; left: 10px; background-color: #F59E0B; border-radius: 6px; padding: 1px 6px; }
.store-tag-text { color: #0B1C2E; font-size: 9px; font-weight: bold; }
.store-card-name { color: #EEF2FF; font-size: 14px; font-weight: bold; }
.store-card-desc { color: #A6C4E5; font-size: 11px; margin-top: 3px; }
.store-card-desc-rich { margin-top: 3px; }
.store-variants { flex-direction: row; flex-wrap: wrap; margin-top: 6px; }
.store-variant-pill { border: 1px solid rgba(99, 117, 236, 0.3); border-radius: 14px; padding: 4px 10px; margin-right: 6px; }
.store-variant-pill-active { background-color: rgba(99, 117, 236, 0.25); border-color: #6375EC; }
.store-variant-label { color: #EEF2FF; font-size: 11px; }
.store-card-footer { flex-direction: row; align-items: center; justify-content: space-between; margin-top: 8px; }
.store-price-wrap { flex-direction: column; }
.store-price-wrap-partner { flex-direction: column; }
.store-partner-row { flex-direction: row; align-items: center; }
.store-partner-badge { background-color: rgba(16, 185, 129, 0.18); border-radius: 6px; padding: 1px 6px; margin-right: 4px; }
.store-partner-badge-text { color: #6EE7B7; font-size: 9px; }
.store-price { color: #EEF2FF; font-size: 14px; font-weight: bold; }
.store-price-partner { color: #6EE7B7; }
.store-price-regular { color: #7F97B5; font-size: 11px; }
.store-unit { color: #A6C4E5; font-size: 11px; }
.store-buy-btn { background-color: #6375EC; border-radius: 16px; padding: 6px 14px; }
.store-buy-label { color: #FFFFFF; font-size: 12px; }
.cart-stepper { flex-direction: row; align-items: center; }
.cart-stepper-sm { }
.stepper-btn { width: 26px; height: 26px; border-radius: 13px; background-color: rgba(99, 117, 236, 0.2); align-items: center; justify-content: center; }
.stepper-sym { color: #A0B4FF; font-size: 14px; }
.stepper-qty { color: #EEF2FF; font-size: 13px; margin-left: 8px; margin-right: 8px; min-width: 18px; text-align: center; }
.cart-bar { position: absolute; left: 12px; right: 12px; bottom: 70px; flex-direction: row; align-items: center; justify-content: space-between; background-color: #6375EC; border-radius: 14px; padding: 10px 14px; }
.cart-bar-label { color: rgba(255, 255, 255, 0.85); font-size: 12px; }
.cart-bar-right { flex-direction: row; align-items: center; }
.cart-bar-total { color: #FFFFFF; font-size: 14px; font-weight: bold; margin-right: 10px; }
.cart-bar-btn { background-color: #FFFFFF; border-radius: 14px; padding: 6px 14px; }
.cart-bar-btn-text { color: #6375EC; font-size: 13px; font-weight: bold; }
.order-card { background-color: #162E4A; border-radius: 12px; padding: 12px; margin-top: 8px; }
.order-card-top { flex-direction: row; align-items: center; justify-content: space-between; }
.order-name { color: #EEF2FF; font-size: 14px; font-weight: bold; flex: 1; }
.order-status { border-radius: 8px; padding: 2px 8px; background-color: rgba(100, 116, 139, 0.25); }
.order-status-label { color: #EEF2FF; font-size: 10px; }
.order-status-shipped { background-color: rgba(14, 165, 233, 0.2); }
.order-status-delivered { background-color: rgba(16, 185, 129, 0.2); }
.order-status-cancelled { background-color: rgba(239, 68, 68, 0.2); }
.order-card-mid { flex-direction: row; align-items: center; margin-top: 4px; }
.order-price { color: #EEF2FF; font-size: 13px; }
.order-meta { color: #A6C4E5; font-size: 11px; }
.order-date-row { margin-top: 3px; }
.order-date { color: #7F97B5; font-size: 10px; }
.order-delivery-info { margin-top: 8px; border-top: 1px solid rgba(127, 127, 127, 0.12); padding-top: 6px; }
.delivery-row { flex-direction: row; margin-top: 3px; }
.delivery-label { color: #A6C4E5; font-size: 11px; width: 70px; }
.delivery-val { color: #EEF2FF; font-size: 11px; flex: 1; }
.delivery-val.bold { font-weight: bold; }
.tracking-val-wrap { flex-direction: row; align-items: center; flex: 1; }
.copy-badge { background-color: rgba(99, 117, 236, 0.2); border-radius: 6px; padding: 2px 8px; margin-left: 6px; }
.copy-badge-label { color: #A0B4FF; font-size: 10px; }
.order-actions { flex-direction: row; justify-content: flex-end; margin-top: 8px; }
.cancel-order-btn { background-color: rgba(239, 68, 68, 0.15); border-radius: 8px; padding: 6px 12px; }
.cancel-order-label { color: #FF6B6B; font-size: 12px; }
.cart-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(4, 10, 18, 0.72); justify-content: flex-end; }
.cart-sheet { background-color: #0F2235; border-top-left-radius: 16px; border-top-right-radius: 16px; padding: 14px; width: 100%; max-height: 460px; }
.cart-sheet-header { flex-direction: row; align-items: center; justify-content: space-between; }
.cart-sheet-title { color: #EEF2FF; font-size: 15px; font-weight: bold; }
.cart-close-btn { padding: 4px 10px; }
.cart-close-sym { color: #A6C4E5; font-size: 15px; }
.cart-sheet-scroll { max-height: 300px; }
.cart-empty-row { padding: 16px 0; align-items: center; }
.cart-empty-text { color: #A6C4E5; font-size: 12px; }
.cart-item-row { flex-direction: row; align-items: center; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid rgba(127, 127, 127, 0.1); }
.cart-item-info { flex: 1; }
.cart-item-name { color: #EEF2FF; font-size: 13px; }
.cart-item-price { color: #A6C4E5; font-size: 11px; }
.checkout-addr-form { background-color: #162E4A; border-radius: 10px; padding: 10px; margin-top: 10px; }
.checkout-addr-hdr { flex-direction: row; align-items: center; justify-content: space-between; }
.checkout-addr-title { color: #EEF2FF; font-size: 13px; font-weight: bold; }
.checkout-wx-addr-btn { background-color: rgba(99, 117, 236, 0.18); border-radius: 8px; padding: 4px 8px; }
.checkout-wx-addr-text { color: #A0B4FF; font-size: 11px; }
.checkout-wx-addr-icon { color: #A0B4FF; font-size: 11px; margin-right: 2px; }
.checkout-addr-row { flex-direction: row; align-items: center; margin-top: 8px; }
.checkout-addr-row-tall { align-items: flex-start; }
.checkout-addr-label { color: #A6C4E5; font-size: 12px; width: 78px; }
.checkout-addr-input { flex: 1; height: 36px; background-color: #0F2235; color: #EEF2FF; border-radius: 8px; padding-left: 8px; }
.checkout-addr-textarea { flex: 1; min-height: 40px; background-color: #0F2235; color: #EEF2FF; border-radius: 8px; padding: 6px 8px; }
.cart-sheet-footer { flex-direction: row; align-items: center; justify-content: space-between; margin-top: 10px; }
.cart-total-text { color: #EEF2FF; font-size: 14px; font-weight: bold; }
.cart-checkout-btn { background-color: #6375EC; border-radius: 12px; padding: 10px 18px; }
.cart-checkout-text { color: #FFFFFF; font-size: 14px; font-weight: bold; }

/* ── Learn tab ── */
.academy-subtab-scroll { flex: 1; }
.wellness-subtab-scroll { flex: 1; padding: 0px 0px 0px 0px; }
.training-tab { padding: 10px 16px 10px 16px; }
.loading-row { align-items: center; padding: 20px 0; }
.loading-text { color: #A6C4E5; font-size: 13px; }
.academy-status-card { position: relative; overflow: hidden; background-image: linear-gradient(150deg, rgb(26, 31, 98) 0%, rgb(29, 53, 101) 50%, rgb(22, 46, 74) 100%); border: 1px solid rgba(139, 159, 255, 0.38); border-radius: 16px; padding: 16px 16px 14px; box-shadow: rgba(99, 117, 236, 0.32) 0px 6px 24px 0px, rgba(255, 255, 255, 0.06) 0px 1px 0px 0px inset; margin: 12px 14px 8px 14px; }
.academy-card-glow-tl { position: absolute; top: -35px; right: -25px; width: 114px; height: 114px; background-color: rgba(139, 159, 255, 0.10); border-radius: 57px; }
/* #ifdef MP-WEIXIN */
.academy-card-glow-tl { background-image: radial-gradient(circle, rgba(139, 159, 255, 0.22) 0%, rgba(0, 0, 0, 0) 70%); }
/* #endif */
.academy-card-glow-br { position: absolute; bottom: -25px; left: -15px; width: 93px; height: 93px; background-color: rgba(99, 117, 236, 0.08); border-radius: 46.5px; }
/* #ifdef MP-WEIXIN */
.academy-card-glow-br { background-image: radial-gradient(circle, rgba(99, 117, 236, 0.15) 0%, rgba(0, 0, 0, 0) 70%); }
/* #endif */
.academy-card-header { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 16px; color: rgb(238, 242, 255); }
.academy-card-header-label { color: rgba(139, 159, 255, 0.5); font-size: 10px; font-weight: bold; letter-spacing: 1px; }
.academy-card-tier-badge { background-image: linear-gradient(135deg, rgba(139,159,255,0.22), rgba(99,117,236,0.12)); border: 1px solid rgba(139, 159, 255, 0.38); border-radius: 20px; padding: 3px 11px; }
.academy-card-tier-text { color: #A0B2FF; font-size: 10px; font-weight: bold; letter-spacing: 1px; }
/* #ifdef MP-WEIXIN */
.academy-card-tier-text { text-transform: capitalize; }
/* #endif */
.academy-card-hero { align-items: center; padding-bottom: 14px; }
.academy-card-credits-num { color: #FFFFFF; font-size: 41px; font-weight: bold; letter-spacing: -1px; }
.academy-card-credits-label { color: rgba(139, 159, 255, 0.5); font-size: 8px; font-weight: bold; letter-spacing: 2px; margin-top: 6px; }
.academy-card-divider { height: 1px; background-image: linear-gradient(90deg, rgba(0, 0, 0, 0), rgba(139, 159, 255, 0.28), rgba(0, 0, 0, 0)); margin-bottom: 12px; }
.academy-card-stats { flex-direction: row; align-items: center; }
.academy-card-stat { flex: 1; align-items: center; color: rgb(238, 242, 255); }
.academy-card-stat-sep { width: 1px; height: 24px; background-color: rgba(139, 159, 255, 0.18); }
.academy-card-stat-num { color: #FFFFFF; font-size: 18px; font-weight: bold; }
.academy-card-stat-label { color: rgba(139, 159, 255, 0.5); font-size: 8px; font-weight: 600; letter-spacing: 1px; margin-top: 3px; }
.training-section-header { margin-top: 14px; }
.training-section-title { color: rgb(122, 154, 191); font-size: 11px; font-weight: bold; letter-spacing: 1px; }
/* #ifdef MP-WEIXIN */
.training-section-title { text-transform: uppercase; }
/* #endif */
.training-path-card { background-color: #162E4A; border-radius: 8px; padding: 10px 10px 8px 10px; margin: 8px 0px 8px 0px; border-style: solid; border-width: 1px; border-color: rgba(99, 117, 236, 0.18); }
.training-path-header { flex-direction: row; align-items: center; justify-content: space-between; margin: 0px 0px 4px 0px; }
.training-path-title { color: #EEF2FF; font-size: 14px; font-weight: bold; flex: 1; }
.training-path-tier { color: rgb(129, 140, 248); font-size: 10px; padding: 1px 6px 1px 6px; border-radius: 10px; background-color: rgba(99, 101, 241, 0.15); }
/* #ifdef MP-WEIXIN */
.training-path-tier { text-transform: capitalize; }
/* #endif */
.training-path-desc { color: #A6C4E5; font-size: 11px; margin-top: 3px; }
.training-path-progress-bar { height: 4px; border-radius: 2px; background-color: rgba(255, 255, 255, 0.1); margin: 8px 0px 4px 0px; }
.training-path-progress-fill { height: 4px; border-radius: 2px; background-color: transparent; background-image: linear-gradient(90deg, rgb(99, 117, 236), rgb(139, 159, 255)); }
.training-path-progress-label { color: rgba(166, 196, 229, 0.4); font-size: 11px; margin-top: 3px; }
.empty-state { align-items: center; padding: 0px 0px 0px 0px; }
.training-course-card { background-color: #162E4A; border-radius: 12px; margin-top: 8px; }
.training-course-card-locked { opacity: 0.55; }
.training-course-cover { position: relative; border-radius: 0px; background-color: transparent; align-items: flex-start; justify-content: space-between; color: rgb(238, 242, 255); border-top-width: 0px; border-right-width: 0px; border-bottom-width: 1px; border-left-width: 0px; border-bottom-color: rgba(99, 117, 236, 0.15); background-image: linear-gradient(135deg, rgb(26, 47, 90) 0%, rgb(10, 24, 48) 100%); padding: 18px 16px 14px 16px; border-style: solid; flex-direction: row; }
.training-course-cover-text { flex: 1; color: rgb(232, 240, 248); font-size: 15px; font-weight: bold; line-height: 21px; margin: 0px 8px 0px 0px; }
.training-lesson-badge { flex-shrink: 0; background-color: rgba(99, 117, 236, 0.2); border-radius: 10px; padding: 2px 8px; color: rgb(238, 242, 255); border-style: solid; border-width: 1px; border-color: rgba(99, 117, 236, 0.4); }
.training-lesson-badge-text { color: rgb(139, 159, 255); font-size: 10px; }
.training-course-lock-badge { position: absolute; right: 8px; bottom: 8px; }
.training-course-lock-icon { font-size: 14px; }
.training-course-body { padding: 10px 16px 10px 16px; }
.training-course-meta { flex: 1; }
.training-course-title { color: rgb(232, 240, 248); font-size: 14px; font-weight: bold; }
.training-course-desc { color: rgb(122, 154, 191); font-size: 12px; margin-top: 2px; }
.training-course-meta-row { flex-direction: row; align-items: center; margin-top: 4px; }
.training-course-level { color: rgb(129, 140, 248); font-size: 10px; background-color: rgba(99, 101, 241, 0.15); border-radius: 10px; padding: 1px 5px 1px 5px; }
/* #ifdef MP-WEIXIN */
.training-course-level { text-transform: capitalize; }
/* #endif */
.training-course-credits { color: rgb(16, 185, 129); font-size: 10px; margin-left: 8px; }
.training-course-prereq-hint { color: #FBBF24; font-size: 10px; margin-top: 3px; }
.training-cert-card { flex-direction: row; align-items: center; background-color: #162E4A; border-radius: 12px; padding: 12px; margin-top: 8px; }
.training-cert-icon { font-size: 18px; margin-right: 10px; }
.training-cert-info { flex: 1; }
.training-cert-title { color: #EEF2FF; font-size: 13px; font-weight: bold; }
.training-cert-tier { color: #A0B4FF; font-size: 10px; }
.training-cert-chevron { color: #A6C4E5; font-size: 16px; }
.cert-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(4, 10, 18, 0.8); align-items: center; justify-content: center; }
.cert-detail-card { background-color: #0F2235; border-radius: 14px; padding: 16px; width: 90%; max-height: 480px; }
.cert-detail-header { flex-direction: row; align-items: center; justify-content: space-between; }
.cert-status-badge { flex-direction: row; align-items: center; background-color: rgba(16, 185, 129, 0.15); border-radius: 8px; padding: 3px 8px; }
.cert-status-check { color: #6EE7B7; font-size: 12px; margin-right: 4px; }
.cert-status-text { color: #6EE7B7; font-size: 11px; }
.cert-close-btn { padding: 4px 8px; }
.cert-close-label { color: #A6C4E5; font-size: 14px; }
.cert-bg-wrap { margin-top: 10px; }
.cert-bg-preview { width: 100%; border-radius: 8px; }
.cert-field-list { margin-top: 10px; }
.cert-field { flex-direction: row; padding: 5px 0; border-bottom: 1px solid rgba(127, 127, 127, 0.08); }
.cert-label { color: #A6C4E5; font-size: 11px; width: 90px; }
.cert-value { color: #EEF2FF; font-size: 12px; flex: 1; }
.cert-mono { font-family: monospace; }
.cert-number { color: #A0B4FF; }
.cert-valid { color: #6EE7B7; }
.cert-download-btn { background-color: #6375EC; border-radius: 10px; padding: 10px; margin-top: 12px; align-items: center; }
.cert-download-label { color: #FFFFFF; font-size: 13px; }
.training-library-row { flex-direction: row; align-items: center; background-color: rgb(15, 37, 64); border-radius: 8px; padding: 14px 10px 14px 10px; margin: 8px 0px 8px 0px; border-style: solid; border-width: 1px; border-color: rgb(30, 58, 95); }
.training-library-icon { margin-right: 8px; color: rgb(238, 242, 255); }
.training-library-title { color: rgb(232, 240, 248); font-size: 14px; flex: 1; }
.training-library-chevron { color: rgb(74, 106, 138); font-size: 18px; }
.training-back-row { padding: 4px 0 8px; }
.training-back-text { color: #A0B4FF; font-size: 13px; }
.training-course-header { margin-bottom: 8px; }
.training-course-header-title { color: #EEF2FF; font-size: 16px; font-weight: bold; }
.training-course-header-desc { color: #A6C4E5; font-size: 12px; margin-top: 3px; }
.training-lesson-row { flex-direction: row; align-items: center; background-color: #162E4A; border-radius: 10px; padding: 10px; margin-top: 8px; }
.training-lesson-num { width: 28px; height: 28px; border-radius: 14px; background-color: rgba(99, 117, 236, 0.2); align-items: center; justify-content: center; margin-right: 10px; }
.training-lesson-num-text { color: #A0B4FF; font-size: 12px; }
.training-lesson-info { flex: 1; }
.training-lesson-title { color: #EEF2FF; font-size: 13px; }
.training-lesson-desc { color: #A6C4E5; font-size: 11px; }
.training-lesson-meta-row { flex-direction: row; align-items: center; margin-top: 3px; }
.training-lesson-type-badge { font-size: 11px; margin-right: 6px; }
.training-lesson-credits-label { color: #6EE7B7; font-size: 10px; }
.training-lesson-quiz-badge { color: #FBBF24; font-size: 10px; margin-left: 6px; }
.training-lesson-done { width: 22px; height: 22px; border-radius: 11px; background-color: rgba(16, 185, 129, 0.2); align-items: center; justify-content: center; }
.training-lesson-done-text { color: #6EE7B7; font-size: 12px; }
.training-lesson-chevron { color: #A6C4E5; font-size: 15px; }
.training-video-container { border-radius: 12px; overflow: hidden; }
.training-video { width: 100%; height: 200px; }
.training-video-loading { height: 160px; align-items: center; justify-content: center; background-color: #162E4A; border-radius: 12px; }
.training-video-loading-text { color: #A6C4E5; font-size: 12px; }
.training-text-content { background-color: #162E4A; border-radius: 12px; padding: 12px; }
.training-text-body { color: #EEF2FF; font-size: 13px; line-height: 20px; }
.training-lesson-detail { margin-top: 10px; }
.training-lesson-detail-title { color: #EEF2FF; font-size: 15px; font-weight: bold; }
.training-lesson-detail-desc { color: #A6C4E5; font-size: 12px; margin-top: 3px; }
.training-quiz-section { background-color: #12283F; border-radius: 12px; padding: 12px; margin-top: 10px; }
.training-quiz-title { color: #EEF2FF; font-size: 13px; font-weight: bold; }
.training-quiz-result { border-radius: 10px; padding: 10px; margin-top: 8px; align-items: center; }
.training-quiz-passed { background-color: rgba(16, 185, 129, 0.12); }
.training-quiz-failed { background-color: rgba(239, 68, 68, 0.12); }
.training-quiz-result-score { color: #EEF2FF; font-size: 22px; font-weight: bold; }
.training-quiz-result-label { color: #A6C4E5; font-size: 12px; }
.training-quiz-result-credits { color: #6EE7B7; font-size: 12px; }
.training-quiz-review { margin-top: 8px; width: 100%; }
.training-quiz-review-item { border-radius: 8px; padding: 8px; margin-top: 6px; flex-direction: row; }
.training-quiz-review-correct { background-color: rgba(16, 185, 129, 0.1); }
.training-quiz-review-wrong { background-color: rgba(239, 68, 68, 0.1); }
.training-quiz-review-icon { color: #EEF2FF; font-size: 13px; margin-right: 8px; }
.training-quiz-review-body { flex: 1; }
.training-quiz-review-q { color: #EEF2FF; font-size: 12px; }
.training-quiz-review-your-ans { color: #FFB3B3; font-size: 11px; }
.training-quiz-review-correct-ans { color: #6EE7B7; font-size: 11px; }
.training-quiz-review-explanation { color: #A6C4E5; font-size: 11px; }
.training-quiz-question { margin-top: 10px; }
.training-quiz-scenario { color: #A6C4E5; font-size: 11px; font-style: italic; }
.training-quiz-q-text { color: #EEF2FF; font-size: 13px; margin-top: 4px; }
.training-quiz-option { flex-direction: row; align-items: center; background-color: #162E4A; border-radius: 10px; padding: 9px 10px; margin-top: 6px; border: 1px solid rgba(99, 117, 236, 0.15); }
.training-quiz-option-selected { border-color: #6375EC; background-color: rgba(99, 117, 236, 0.16); }
.training-quiz-option-radio { width: 14px; height: 14px; border-radius: 7px; border: 1px solid #64748B; margin-right: 8px; }
.training-quiz-option-radio-checked { background-color: #6375EC; border-color: #6375EC; }
.training-quiz-option-text { color: #EEF2FF; font-size: 12px; flex: 1; }
.training-quiz-submit-btn { background-color: #6375EC; border-radius: 10px; padding: 10px; margin-top: 12px; align-items: center; }
.training-mark-btn { background-color: #10B981; border-radius: 10px; padding: 10px; margin-top: 12px; align-items: center; }
.training-mark-btn-busy { opacity: 0.6; }
.training-mark-btn-text { color: #FFFFFF; font-size: 13px; font-weight: bold; }
.training-completed-badge { background-color: rgba(16, 185, 129, 0.15); border-radius: 10px; padding: 10px; margin-top: 12px; align-items: center; }
.training-completed-badge-text { color: #6EE7B7; font-size: 13px; font-weight: bold; }
.training-library-header { margin-bottom: 8px; }
.training-library-header-title { color: #EEF2FF; font-size: 15px; font-weight: bold; }
.training-library-content-scroll { max-height: 380px; }
.training-library-content-text { color: #EEF2FF; font-size: 13px; line-height: 21px; }
.wellness-loading { align-items: center; padding: 20px 0; }
.wellness-section { margin-bottom: 10px; }
.wellness-empty { align-items: center; padding: 30px 14px; }
.wellness-empty-text { color: #A6C4E5; font-size: 13px; }
.sleep-track-card { flex-direction: row; align-items: center; background-color: #162E4A; border-radius: 12px; padding: 12px; margin-top: 8px; }
.sleep-track-icon { width: 34px; height: 34px; border-radius: 17px; background-color: rgba(99, 117, 236, 0.2); align-items: center; justify-content: center; margin-right: 10px; }
.sleep-icon-glyph { color: #A0B4FF; font-size: 14px; }
.sleep-track-info { flex: 1; }
.sleep-track-name { color: #EEF2FF; font-size: 13px; }
.sleep-track-dur { color: #A6C4E5; font-size: 11px; }
.sleep-track-active-dot { width: 8px; height: 8px; border-radius: 4px; background-color: #6EE7B7; }
.media-asset-card { flex-direction: row; align-items: center; background-color: #162E4A; border-radius: 9px; padding: 12px 10px 12px 10px; margin: 8px 0px 8px 0px; border-style: solid; border-width: 1px; border-color: rgba(166, 196, 229, 0.1); }
.media-asset-icon { width: 34px; height: 34px; border-radius: 0px; background-color: rgba(245, 158, 11, 0.15); align-items: center; justify-content: center; margin-right: 10px; flex-direction: row; }
.media-asset-glyph { color: rgb(245, 158, 11); font-size: 13px; }
.media-asset-info { flex: 1; }
.media-asset-name { color: #EEF2FF; font-size: 14px; font-weight: bold; }
.media-asset-sub { color: #A6C4E5; font-size: 11px; }
.media-asset-btn { background-color: rgba(166, 196, 229, 0.1); border-radius: 10px; padding: 6px 10px; color: rgb(238, 242, 255); border-style: solid; border-width: 1px; border-color: rgba(166, 196, 229, 0.2); }
.media-asset-btn-text { color: rgb(166, 196, 229); font-size: 11px; font-weight: bold; }
.sleep-now-playing { flex-direction: row; align-items: center; justify-content: space-between; background-color: #12283F; border: 1px solid rgba(99, 117, 236, 0.3); border-radius: 12px; padding: 10px 12px; }
.sleep-np-info { flex: 1; }
.sleep-np-label { color: #A0B4FF; font-size: 10px; }
.sleep-np-title { color: #EEF2FF; font-size: 13px; }
.sleep-np-controls { flex-direction: row; }
.sleep-np-btn { width: 32px; height: 32px; border-radius: 16px; background-color: rgba(239, 68, 68, 0.2); align-items: center; justify-content: center; }
.sleep-np-btn-icon { color: #FF6B6B; font-size: 13px; }
.library-float-back { position: absolute; right: 12px; top: 120px; }

/* ── bottom tab bar ── */
.tab-bar { flex-direction: row; background-color: rgba(8, 18, 32, 0.95); border-top: 1px solid rgba(99, 117, 236, 0.18); padding-bottom: 6px; }
.tab-btn { flex: 1; align-items: center; padding: 10px 0 12px; }
.tab-line { width: 32px; height: 2px; background-color: transparent; border-radius: 1px; margin-bottom: 3px; background-image: linear-gradient(90deg, rgb(99, 117, 236), rgb(139, 159, 255)); }
.tab-icon-img { width: 20px; height: 20px; margin-top: 3px; opacity: 0.35; }
.tab-icon-on { opacity: 1; }
.tab-label { color: rgba(166, 196, 229, 0.4); font-size: 10px; font-weight: bold; margin-top: 3px; letter-spacing: 1px; }
.tab-label-on { color: #6375EC; font-size: 10px; font-weight: bold; }

/* ── cartridge set simulator ── */
.csim-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(4, 10, 18, 0.72); justify-content: flex-end; }
.csim-sheet { background-color: #0F2235; border-top-left-radius: 16px; border-top-right-radius: 16px; padding: 14px; width: 100%; max-height: 480px; }
.csim-title { color: #EEF2FF; font-size: 15px; font-weight: bold; }
.csim-subtitle { color: #A6C4E5; font-size: 11px; margin-top: 2px; }
.csim-sets { margin-top: 10px; max-height: 320px; }
.csim-set-card { border: 1px solid #6375EC; border-radius: 12px; padding: 12px; margin-top: 8px; }
.csim-set-accent { width: 40px; height: 4px; border-radius: 2px; }
.csim-set-body { margin-top: 6px; }
.csim-set-name { color: #EEF2FF; font-size: 14px; font-weight: bold; }
.csim-set-desc { color: #A6C4E5; font-size: 11px; margin-top: 2px; }
.csim-dot-badges { flex-direction: row; flex-wrap: wrap; margin-top: 6px; }
.csim-dot-badge { flex-direction: row; align-items: center; background-color: rgba(127, 127, 127, 0.1); border-radius: 8px; padding: 3px 8px; margin: 2px; }
.csim-badge-key { font-size: 11px; font-weight: bold; margin-right: 3px; }
.csim-badge-name { color: #A6C4E5; font-size: 10px; }
.csim-loading { align-items: center; margin-top: 10px; }
.csim-cancel { align-items: center; padding: 12px 0 4px; }
.csim-cancel-label { color: #A6C4E5; font-size: 13px; }

/* ── Kino passcode + simulator overlays ── */
.kpass-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(6, 15, 25, 0.96); align-items: center; }
.kpass-box { align-items: center; padding: 0 40px; width: 100%; }
.kpass-logo { color: #6375EC; font-size: 36px; margin-bottom: 10px; }
.kpass-title { color: #A6C4E5; font-size: 14px; letter-spacing: 2px; margin-bottom: 24px; }
.kpass-dots { flex-direction: row; margin-bottom: 12px; }
.kpass-dot { width: 12px; height: 12px; border-radius: 6px; background-color: rgba(166, 196, 229, 0.25); margin-left: 6px; margin-right: 6px; }
.kpass-dot-filled { background-color: #A6C4E5; }
.kpass-error { color: #FF6B6B; font-size: 12px; margin-bottom: 8px; }
.kpass-numpad { flex-direction: row; flex-wrap: wrap; justify-content: center; width: 260px; }
.kpass-key { width: 74px; height: 62px; border-radius: 12px; background-color: #162E4A; align-items: center; justify-content: center; margin: 4px; }
.kpass-key-label { color: #EEF2FF; font-size: 22px; }
.kpass-key-empty { background-color: transparent; }
.kpass-key-del { background-color: rgba(239, 68, 68, 0.15); }
.kpass-del-icon { color: #FF6B6B; font-size: 18px; }
.kpass-cancel { margin-top: 18px; padding: 8px 20px; }
.kpass-cancel-label { color: #A6C4E5; font-size: 13px; }

.ksm-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: #060F19; }
/* #ifdef MP-WEIXIN */
.ksm-overlay { background-image: radial-gradient(at 50% 0%, rgb(26, 49, 85) 0%, rgb(11, 28, 46) 65%); }
/* #endif */
.ksm-container { flex: 1; }
.ksm-header { flex-direction: row; align-items: center; justify-content: space-between; padding-left: 18px; padding-right: 18px; padding-bottom: 10px; border-style: solid; border-top-width: 0px; border-right-width: 0px; border-bottom-width: 1px; border-left-width: 0px; border-bottom-color: rgba(99, 117, 236, 0.18); background-color: rgba(11, 28, 46, 0.7); }
.ksm-title { color: #EEF2FF; font-size: 13px; font-weight: bold; letter-spacing: 4px; }
.ksm-serial { color: rgb(74, 85, 104); font-size: 9px; letter-spacing: 1px; margin: 2px 0px 0px 0px; }
.ksm-close { color: rgb(166, 196, 229); padding: 0px 0px 0px 0px; border-style: solid; border-width: 1px; border-color: rgba(99, 117, 236, 0.3); border-radius: 16px; background-color: rgba(99, 117, 236, 0.1); flex-direction: row; align-items: center; justify-content: center; }
.ksm-close-label { color: #A6C4E5; font-size: 16px; }
.ksm-close { width: 32px; height: 32px; }
.ksm-body { flex: 1; }
.ksm-body-inner { align-items: center; padding: 18px 22px 24px 22px; }
.ksm-device-wrap { width: 176px; height: 176px; align-items: center; justify-content: center; }
.ksm-ring-face { width: 160px; height: 160px; border-radius: 80px; background-color: rgb(255, 255, 255); align-items: center; justify-content: center; border-width: 0px; box-shadow: rgba(99, 117, 236, 0.06) 0px 2px 12px 0px inset, rgba(99, 117, 236, 0.18) 0px 4px 24px 0px; }

.ksm-face-slide { align-items: center; opacity: 1; }
.ksm-slide-index { color: #7F97B5; font-size: 10px; }
.ksm-slide-label { color: #A6C4E5; font-size: 12px; margin-top: 4px; }
.ksm-slide-val { color: #EEF2FF; font-size: 26px; font-weight: bold; }
.ksm-slide-unit { color: #7F97B5; font-size: 10px; }
.ksm-face-static { align-items: center; }
.ksm-face-label { color: rgba(26, 62, 95, 0.4); font-size: 8px; letter-spacing: 3px; margin: 0px 0px 2px 0px; }
.ksm-face-status { font-size: 15px; font-weight: bold; color: rgb(26, 62, 95); margin-top: 2px; }
.ksm-face-status-ready { }
.ksm-face-status-analyzing { color: #6375EC; }
.ksm-face-status-complete { color: #1A8A6A; }
.ksm-face-status-failed { color: #E86060; }
.ksm-face-patient-label { color: #7F97B5; font-size: 9px; margin-top: 6px; }
.ksm-face-user { color: rgb(99, 117, 236); font-size: 11px; margin: 5px 0px 0px 0px; }
.ksm-results { width: 100%; margin-top: 14px; }
.ksm-tabs { flex-direction: row; border-bottom: 1px solid #1E3A5F; }
.ksm-tab { flex: 1; align-items: center; padding: 8px 0; }
.ksm-tab-label { color: #64748B; font-size: 12px; }
.ksm-tab-label-on { color: #A0B4FF; font-size: 12px; font-weight: bold; }
.ksm-tab-content { margin-top: 10px; width: 100%; }
.ksm-bioage-row { flex-direction: row; justify-content: space-around; }
.ksm-bioage-chip { align-items: center; }
.ksm-bioage-chip-dim { opacity: 0.7; }
.ksm-bioage-num { font-size: 26px; font-weight: bold; }
.ksm-bioage-chip-label { color: #7F97B5; font-size: 9px; letter-spacing: 1px; margin-top: 2px; }
.ksm-sub-row { flex-direction: row; align-items: center; margin-top: 8px; }
.ksm-sub-dot { width: 8px; height: 8px; border-radius: 4px; margin-right: 8px; }
.ksm-sub-label { color: #A6C4E5; font-size: 12px; flex: 1; }
.ksm-sub-val { font-size: 13px; font-weight: bold; }
.ksm-bm-row { flex-direction: row; justify-content: space-between; margin-top: 6px; }
.ksm-bm-label { color: #A6C4E5; font-size: 12px; }
.ksm-bm-val { color: #EEF2FF; font-size: 12px; }
.ksm-bm-unit { color: #7F97B5; font-size: 10px; }
.ksm-btn { width: 100%; border-radius: 12px; background-color: transparent; margin-top: 16px; align-items: center; font-size: 14px; color: rgb(255, 255, 255); font-weight: bold; padding: 14px 0px 14px 0px; background-image: linear-gradient(135deg, rgb(99, 117, 236) 0%, rgb(123, 143, 255) 100%); box-shadow: rgba(99, 117, 236, 0.45) 0px 4px 20px 0px; flex-direction: row; justify-content: center; }
.ksm-btn-label { color: #FFFFFF; font-size: 14px; font-weight: bold; }
.ksm-btn-analyzing { background-color: #475569; }
.ksm-btn-complete { background-color: #10B981; }
.ksm-btn-failed { background-color: #EF4444; }
.ksm-quit-btn { padding: 10px 0px 10px 0px; margin: 12px 0px 0px 0px; }
.ksm-quit-label { color: #A6C4E5; font-size: 12px; }
.ksm-debug-toggle { text-align: center; padding: 6px 0px 6px 0px; margin: 8px 16px 0px 16px; }
.ksm-debug-toggle-text { color: rgba(26, 62, 95, 0.3); font-size: 9px; font-weight: bold; letter-spacing: 1px; text-align: center; }
.ksm-debug-box { width: 100%; background-color: rgba(239, 68, 68, 0.08); border-radius: 8px; padding: 8px; margin-top: 6px; }
.ksm-debug-label { color: #FF6B6B; font-size: 9px; font-weight: bold; }
.ksm-debug-msg { color: #FFB3B3; font-size: 10px; }

/* ── guest / redeem sheets ── */
.guest-sheet-mask { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(4, 10, 18, 0.72); justify-content: flex-end; }
.guest-sheet { background-color: rgb(15, 37, 64); border-top-left-radius: 18px; border-top-right-radius: 18px; width: 100%; padding: 14px 24px 63px 24px; border-style: solid; border-top-width: 1px; border-right-width: 0px; border-bottom-width: 0px; border-left-width: 0px; border-top-color: rgba(99, 117, 236, 0.2); align-items: center; }
.guest-sheet-handle { width: 40px; height: 4px; border-radius: 2px; background-color: rgba(255, 255, 255, 0.15); align-self: center; margin: 0px 0px 2px 0px; }
.guest-sheet-title { margin-top: 16px; color: #EEF2FF; font-size: 18px; font-weight: bold; letter-spacing: 1px; text-align: center; }
.guest-sheet-desc { color: rgba(166, 196, 229, 0.6); font-size: 13px; margin-top: 16px; line-height: 21px; text-align: center; }
.pin-field { position: relative; margin-top: 16px; }
.pin-boxes { flex-direction: row; justify-content: center; }
.pin-box { width: 41px; height: 49px; margin: 0 4px; border-radius: 8px; background-color: #162E4A; border: 1px solid rgba(99, 117, 236, 0.25); align-items: center; justify-content: center; }
.pin-filled { border-color: #6375EC; }
.pin-active { border-color: #A0B4FF; }
.pin-digit { color: #EEF2FF; font-size: 18px; font-weight: bold; }
/* opacity alone is not enough: iOS WeChat draws a focused <input> as a native overlay that ignores it,
   so the typed digits showed over the first box. Transparent text + 1px font, as the miniapp does. */
.pin-capture { position: absolute; left: 0; top: 0; width: 100%; height: 54px; opacity: 0; color: rgba(0, 0, 0, 0); font-size: 1px; background-color: rgba(0, 0, 0, 0); }
.guest-sheet-error { width: 100%; background-color: rgba(239, 68, 68, 0.12); border-radius: 8px; padding: 8px 10px; margin-top: 10px; }
.guest-sheet-error-text { color: #FFB3B3; font-size: 12px; }
.guest-sheet-btn { width: 100%; background-color: transparent; border-radius: 14px; margin-top: 16px; align-items: center; padding: 18px 18px 18px 18px; background-image: linear-gradient(135deg, rgb(99, 117, 236) 0%, rgb(139, 159, 255) 100%); box-shadow: rgba(99, 117, 236, 0.45) 0px 4px 20px 0px; }
.guest-sheet-label { color: #FFFFFF; font-size: 15px; font-weight: bold; }
.guest-sheet-btn-disabled { background-color: #475569; background-image: none; box-shadow: none; }
.viva-redeem-input { height: 44px; background-color: rgba(255, 255, 255, 0.06); color: #EEF2FF; border-radius: 10px; margin-top: 10px; width: 100%; padding: 12px 14px 12px 14px; border-style: solid; border-width: 1px; border-color: rgba(255, 255, 255, 0.12); }
.code-wx-addr { color: #A0B4FF; font-size: 12px; margin-top: 8px; }
.mic-btn-active { background-image: linear-gradient(135deg, #E25858 0%, #FF7A7A 100%); border-color: transparent; box-shadow: 0 2px 10px rgba(226, 88, 88, 0.45); }
.mic-btn-disabled { opacity: 0.4; }
.mic-recording-banner { flex-direction: row; align-items: center; background-color: rgba(226, 88, 88, 0.12); border-top-width: 0.5px; border-top-style: solid; border-top-color: rgba(226, 88, 88, 0.3); padding: 7px 12px; }
.mic-recording-dot { width: 7px; height: 7px; border-radius: 4px; background-color: #E25858; margin-right: 6px; }
.mic-recording-text { font-size: 12px; color: #FFB3B3; }
/* #endif */

/* #ifdef MP-WEIXIN */
/* Page-level privacy modal — the miniapp's main.wxss .page-privacy-* (24rpx gap → 12px margins) */
.page-privacy-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 9999; background-color: rgba(0, 0, 0, 0.65); align-items: center; justify-content: center; }
.page-privacy-box { margin: 0 24px; padding: 24px 20px 18px; background-color: #132236; border-radius: 12px; align-items: center; }
.page-privacy-title { font-size: 16px; font-weight: bold; color: #e2eaf4; text-align: center; }
.page-privacy-body { margin-top: 12px; font-size: 13px; line-height: 21px; color: rgba(166, 196, 229, 0.8); text-align: center; }
.page-privacy-agree-btn { width: 100%; margin-top: 16px; padding: 10px 0; background-color: #3b82f6; color: #FFFFFF; border-radius: 50px; border-width: 0px; font-size: 14px; font-weight: bold; line-height: 22px; }
.page-privacy-cancel-btn { margin-top: 12px; padding: 4px 0; }
.page-privacy-cancel-text { font-size: 13px; color: rgba(166, 196, 229, 0.5); }
/* #endif */

/* #ifdef MP-WEIXIN */
/* 使用微信地址 — the miniapp's .checkout-wx-addr-* / .code-wx-addr */
.checkout-wx-addr-btn { flex-direction: row; align-items: center; background-color: rgba(99, 117, 236, 0.15); border-style: solid; border-width: 1px; border-color: rgba(99, 117, 236, 0.35); border-radius: 12px; padding: 4px 10px; }
.checkout-wx-addr-icon { font-size: 11px; margin-right: 3px; }
.checkout-wx-addr-text { font-size: 11px; font-weight: bold; color: #8B9FFF; }
.code-wx-addr { align-self: flex-start; margin: 2px 0 6px; font-size: 12px; color: #7A9ABF; text-decoration: underline; }
/* #endif */

/* #ifdef MP-WEIXIN */
/* The miniapp's values Android's CSS engine rejects (align-items: baseline, max-width: %);
   native gets the nearest supported value in the rule itself. */
.fcard-head { align-items: baseline; }
.fcard-tier-head { align-items: baseline; }
.fcard-tier-name { align-items: baseline; }
.fcard-days { align-items: baseline; }
.dots-header { align-items: baseline; }
.message-ai { max-width: 100%; }
/* #endif */

/* #ifdef MP-WEIXIN */
/* 营养定制 focus sheet as the miniapp draws it. Its type reads var(--fs-body)/var(--fs-small),
   which app.wxss never defines, so the miniapp renders all of it at the inherited 16px; match
   that. The mask is fixed above the tab bar, which otherwise covered the sheet's buttons. */
.focus-mask { position: fixed; z-index: 100; }
.focus-sheet { background-color: #0F2540; padding: 0 18px calc(20px + env(safe-area-inset-bottom)); }
.focus-intro { font-size: 16px; line-height: 25.6px; color: #E8EEF7; margin-top: 0; margin-bottom: 10px; }
.focus-plan-row { align-items: flex-start; padding: 11px 12px; border-radius: 10px; background-color: rgba(99, 117, 236, 0.1); margin-top: 0; margin-bottom: 7px; }
.focus-plan-body { margin-left: 9px; }
.focus-plan-name { font-size: 16px; color: #FFFFFF; font-weight: 600; }
.focus-plan-goal { font-size: 16px; line-height: 24px; color: #8FA3BF; margin-top: 3px; }
.focus-hint { font-size: 16px; line-height: 25.6px; color: #8FA3BF; margin-top: 8px; margin-bottom: 14px; }
.focus-btn { padding: 13px 0; border-radius: 999px; margin-top: 0; }
.focus-btn-label-primary { font-size: 16px; font-weight: 600; }
.focus-btn-ghost { background-color: transparent; border: 1px solid rgba(143, 163, 191, 0.35); margin-top: 8px; }
.focus-btn-label-ghost { font-size: 16px; color: #8FA3BF; }
.focus-btn-row { gap: 8px; }
.focus-btn-half { margin-right: 0; }
.theme-light .focus-btn-label-ghost { color: #607090; }
/* #endif */

/* #ifdef MP-WEIXIN */
/* 扫描二维码 bar (检测 in the toolbox): the miniapp centres a glowing pill and floats the ✕ at the right. */
.kino-scan-bar { justify-content: center; padding-top: 12px; padding-bottom: 12px; background-color: rgba(11, 28, 46, 0.92); border-top: 1px solid rgba(99, 117, 236, 0.18); position: relative; }
.kino-scan-btn { padding: 12px 29px; border-radius: 24px; box-shadow: 0 2px 12px rgba(99, 117, 236, 0.5); }
.kino-scan-icon { font-size: 18px; font-weight: 600; margin-right: 7px; }
.kino-scan-label { font-size: 15px; font-weight: 600; }
.kino-scan-close { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); width: 29px; height: 29px; padding: 0; align-items: center; justify-content: center; color: rgba(255, 255, 255, 0.5); }
.kino-scan-x { color: rgba(255, 255, 255, 0.5); }
/* AI text: the miniapp's .msg-html is 28rpx with line-height 1.62 — in rpx, so it rounds the same on every phone width. */
.msg-html { font-size: 28rpx; line-height: 1.62; }
/* Redeem sheets: the miniapp's .guest-sheet spaces every child 16px apart (flex gap). */
.viva-redeem-input { margin-top: 16px; font-size: 15px; letter-spacing: 1px; }
.code-wx-addr { margin: 18px 0 6px; }
/* Learn tab (学院), measured against the miniapp: soft glows with no tint behind them, its 800/600
   weights, and its line boxes (inline text inside 16px blocks). */
.academy-card-glow-tl, .academy-card-glow-br { background-color: transparent; border-radius: 50%; }
.academy-card-credits-num { font-weight: 800; line-height: 41px; }
.academy-card-stat-num { font-weight: 800; line-height: 18px; }
.academy-card-tier-text { line-height: 21px; }
.training-section-header { margin-top: 12px; margin-bottom: 8px; }
.training-section-title { line-height: 19px; }
.training-path-card { margin-top: 0; }
.training-path-title, .training-course-title { font-weight: 600; }
.training-path-progress-label { margin-top: 0; line-height: 13px; }
.training-course-desc { line-height: 18px; margin-top: 0; }
.training-course-meta-row { margin-top: 6px; }
.training-lesson-badge-text { line-height: 19px; }
.training-course-card { background-color: #0F2540; border: 1rpx solid #1E3A5F; border-radius: 10px; margin-top: 0; margin-bottom: 10px; }
/* 魔盒: the miniapp pads each asset section rather than spacing cards, and its icons are round. */
.wellness-section { padding: 16px 14px 0; margin-bottom: 0; }
.media-asset-card { margin-top: 0; }
.media-asset-icon { border-radius: 999px; }
.media-asset-name, .media-asset-btn-text { font-weight: 600; }
.media-asset-btn-text { line-height: 19px; }
/* Header menu, measured against the miniapp. */
.menu-credit-label, .menu-credit-value { flex-shrink: 0; white-space: nowrap; }
.header-user { font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
/* The channel name in the header: SuperiorMed is long, and at the miniapp's 4px tracking it left the
   user's name no room beside the version pill. A condensed face with no tracking (iOS Avenir Next
   Condensed, Android's sans-serif-condensed) keeps it to about two-thirds the width. */
.header-title { font-family: "Avenir Next Condensed", "AvenirNextCondensed-DemiBold", "Roboto Condensed", "sans-serif-condensed", "Arial Narrow", sans-serif; letter-spacing: 0; flex-shrink: 0; white-space: nowrap; }
.header-divider { flex-shrink: 0; }
.header-logo-btn { flex-shrink: 0; }
.menu-item-icon { line-height: 19px; }
.menu-item-label { font-weight: 500; }
.menu-fs-step:first-child { margin-left: 0; }
/* Plans ▸ Dots: the miniapp's sections sit flush (their padding is the spacing). */
.pkg-section, .code-section { margin-top: 0; }
.dots-header { margin-top: 0; }
.pkg-name, .scan-box-title { font-weight: 600; }
.pkg-name { margin-right: 8px; }
.pkg-meta { color: rgba(166, 196, 229, 0.4); line-height: 17px; }
.scan-box-title { line-height: 20px; }
.scan-box-detail { line-height: 16.5px; }
.theme-light .kino-scan-x { color: var(--text-muted); }
/* #endif */

/* #ifdef MP-WEIXIN */
/* Light theme on xapp-mini: every top-level .theme-light rule of the miniapp's pages/main/main.wxss, verbatim
   (the colour variables they read come from App.uvue's copy of app.wxss). Two-class selectors,
   so they win over this file's own rules. Regenerate from the miniapp when its light theme
   changes; Android keeps its own minimal light rules above. */
/* Every colour declaration of the miniapp's main.wxss that reads a CSS variable, restated under
   .theme-light (tools/xapp-mini/style-gen/lightvars.js --derived-only), with the literal-coloured
   modifiers of those classes. The miniapp's flip with its theme variables; xapp's base rules carry
   the dark literals. Before the miniapp's own .theme-light rules below, which win where both apply. */
.theme-light .sandbox-banner-text { color: var(--warn); }
.theme-light .sandbox-banner-exit { color: var(--warn); }
.theme-light .viva-expired-banner-text { color: var(--info-pale); }
.theme-light .viva-expired-banner-btn { color: var(--info-pale); }
.theme-light .inner-tab-text { color: var(--steel); }
.theme-light .msg-coach-label { color: var(--success-deep); }
.theme-light .msg-daysep-text { color: var(--chat-sep-fg); }
.theme-light .mcard-tile { background: rgba(var(--blue-rgb), 0.08); border: 1rpx solid rgba(var(--blue-rgb), 0.20); border-left-color: var(--steel); }
.theme-light .mcard-label { color: var(--text-sub); }
.theme-light .mcard-unit { color: var(--text-sub); }
.theme-light .mcard-pill { color: var(--chat-pill-fg); }
.theme-light .mcard-good { border-left-color: var(--success); }
.theme-light .mcard-good .mcard-pill { color: var(--chat-good); }
.theme-light .mcard-normal { border-left-color: var(--steel); }
.theme-light .mcard-watch { border-left-color: var(--warn); }
.theme-light .mcard-watch .mcard-pill { color: var(--chat-warn); }
.theme-light .mcard-high { border-left-color: var(--danger); }
.theme-light .mcard-high .mcard-pill { color: var(--chat-high); }
.theme-light .mcard-low { border-left-color: var(--info); }
.theme-light .mcard-low .mcard-pill { color: var(--chat-low); }
.theme-light .spark-t-good .spark-bar-last { background: var(--chat-good); }
.theme-light .spark-t-bad .spark-bar-last { background: var(--chat-high); }
.theme-light .spark-d-good { color: var(--chat-good); }
.theme-light .spark-d-bad { color: var(--chat-high); }
.theme-light .tcard { background: rgba(var(--blue-rgb), 0.10); border: 1rpx solid rgba(var(--blue-rgb), 0.28); border-left: 6rpx solid var(--blue); }
.theme-light .tcard-title { color: var(--chat-accent); }
.theme-light .dcard-chip { background: rgba(var(--blue-rgb), 0.12); border: 1rpx solid rgba(var(--blue-rgb), 0.30); }
.theme-light .dcard-id { color: var(--chat-accent); }
.theme-light .dcard-note { color: var(--text-sub); }
.theme-light .fcard { background: rgba(var(--blue-rgb), 0.10); border: 1rpx solid rgba(var(--blue-rgb), 0.26); }
.theme-light .fcard-title { color: var(--chat-accent); }
.theme-light .fcard-note { color: var(--text-sub); }
.theme-light .fcard-slot { color: var(--text-sub); }
.theme-light .fcard-track { background: rgba(127, 127, 127, 0.16); }
.theme-light .fcard-num { color: var(--chat-accent); }
.theme-light .fcard-leg-name { color: var(--text); }
.theme-light .fcard-leg-num { color: var(--text-sub); }
.theme-light .fcard-foot { border-top: 1rpx solid rgba(127, 127, 127, 0.18); color: var(--text-sub); }
.theme-light .fcard-daylabel { color: var(--text); }
.theme-light .fcard-daytag { color: var(--chat-accent); background: rgba(var(--blue-rgb), 0.18); }
.theme-light .fcard-cycle { color: var(--text-sub); }
.theme-light .fcard-tier { background: rgba(127, 127, 127, 0.08); }
.theme-light .fcard-tier-open { background: rgba(127, 127, 127, 0.12); border: 1rpx solid rgba(var(--blue-rgb), 0.22); }
.theme-light .fcard-tier-chev { color: var(--text-sub); }
.theme-light .fcard-tier-label { color: var(--text); }
.theme-light .fcard-tier-rec { color: var(--chat-accent); background: rgba(var(--blue-rgb), 0.18); }
.theme-light .fcard-tier-note { color: var(--text-sub); }
.theme-light .fcard-tier-pitch { color: var(--text-sub); }
.theme-light .fcard-tier-hint { color: var(--text-sub); }
.theme-light .fcard-upgrades { border-top: 1rpx solid rgba(var(--blue-rgb), 0.26); }
.theme-light .fcard-uphead { color: var(--chat-accent); }
.theme-light .fcard-rung { background: rgba(127, 127, 127, 0.10); }
.theme-light .fcard-rung-label { color: var(--text); }
.theme-light .fcard-rung-add { color: var(--chat-accent); background: rgba(var(--blue-rgb), 0.18); }
.theme-light .fcard-leg-weeks { color: var(--text-sub); background: rgba(127, 127, 127, 0.14); }
.theme-light .fcard-rung-pitch { color: var(--text-sub); }
.theme-light .fcard-rung-hint { color: var(--text-sub); }
.theme-light .fcard-owned { color: var(--chat-accent); }
.theme-light .fcard-cta { color: var(--chat-accent); background: rgba(var(--blue-rgb), 0.16); border: 1rpx solid rgba(var(--blue-rgb), 0.40); }
.theme-light .fcard-agnote { color: var(--text-sub); background: rgba(127, 127, 127, 0.10); }
.theme-light .plus-btn-open .plus-icon { color: var(--info-pale); }
.theme-light .mic-recording-text { color: var(--danger-pale); }
.theme-light .pkg-section-title { color: var(--text); }
.theme-light .pkg-card { background: rgba(var(--wave-rgb), 0.08); border: 2rpx solid rgba(var(--wave-rgb), 0.28); }
.theme-light .pkg-name { color: var(--text); }
.theme-light .pkg-stage { color: var(--text-sub); background: rgba(var(--wave-rgb), 0.16); }
.theme-light .pkg-stage-awaiting_formulation, .theme-light .pkg-stage-shipped, .theme-light .pkg-stage-delivered { color: var(--gold); background: rgba(245, 197, 106, 0.16); }
.theme-light .pkg-stage-active { color: var(--success); background: rgba(52, 211, 153, 0.14); }
.theme-light .pkg-stage-cancelled, .theme-light .pkg-stage-refunded { color: var(--text-muted); background: rgba(var(--wave-rgb), 0.1); }
.theme-light .pkg-meta { color: var(--text-muted); }
.theme-light .pkg-track { background: rgba(var(--wave-rgb), 0.12); }
.theme-light .pkg-track-text { color: var(--text-sub); }
.theme-light .pkg-track-copy { color: var(--steel); }
.theme-light .pkg-cta-ghost { background: rgba(var(--wave-rgb), 0.12); border-color: rgba(var(--wave-rgb), 0.4); }
.theme-light .pkg-cta-text { color: var(--gold); }
.theme-light .pkg-cta-ghost .pkg-cta-text { color: var(--steel); }
.theme-light .code-chip { color: var(--steel); }
.theme-light .code-wx-addr { color: var(--steel); }
.theme-light .pkg-hint { color: var(--gold); }
.theme-light .order-dots-btn-text { color: var(--gold); }
.theme-light .store-partner-badge-text { color: var(--info-pale); }
.theme-light .store-price-partner { color: var(--info-pale); }
.theme-light .order-status-pending { color: var(--warn); }
.theme-light .order-status-delivered { color: var(--success); }
.theme-light .cancel-order-btn text { color: var(--danger); }
.theme-light .checkout-wx-addr-text { color: var(--info-pale); }
.theme-light .kpass-error { color: var(--danger-muted); }
.theme-light .ksm-face-status-failed { color: var(--danger-muted); }
.theme-light .ksm-debug-label { color: var(--danger-muted); }
.theme-light .ksm-debug-msg { color: var(--danger-pale); }
.theme-light .plans-browse-btn-text { color: var(--info-pale); }
.theme-light .plan-type-primary   .plan-type-text { color: var(--info-pale); }
.theme-light .plan-type-secondary .plan-type-text { color: var(--success); }
.theme-light .plan-checkin-done .plan-checkin-text { color: var(--success); }
.theme-light .close-x { color: var(--steel); }
.theme-light .detail-tab-text { color: var(--steel); }
.theme-light .plan-chip-text { color: var(--info-pale); }
.theme-light .plan-chip-dot .plan-chip-text { color: var(--success); }
.theme-light .plan-action-switch  text { color: var(--info-pale); }
.theme-light .plan-action-abandon text { color: var(--danger-soft); }
.theme-light .plan-action-buy text { color: var(--gold); }
.theme-light .browse-enrolled-badge { color: var(--info-pale); }
.theme-light .browse-join-secondary text { color: var(--info-pale); }
.theme-light .reminder-active text { color: var(--info-pale); }
.theme-light .reminder-paused text { color: var(--steel); }
.theme-light .reminder-source-coach .reminder-source-text { color: var(--success); }
.theme-light .reminder-source-ai    .reminder-source-text { color: var(--info-pale); }
.theme-light .reminder-recur-text { color: var(--warn); }
.theme-light .plan-task-chip.plan-task-done .plan-task-label { color: var(--success); }
.theme-light .plan-task-chip.plan-task-done .plan-task-check { color: var(--success); }
.theme-light .event-badge-signed text { color: var(--success); }
.theme-light .event-btn-cancel text { color: var(--info-pale); }
.theme-light .training-section-title { color: var(--steel); }
.theme-light .training-lesson-badge-text { color: var(--info-pale); }
.theme-light .training-course-desc { color: var(--steel); }
.theme-light .training-course-prereq-hint { color: var(--warn); }
.theme-light .training-course-header-desc { color: var(--steel); }
.theme-light .training-lesson-num-text { color: var(--info-pale); }
.theme-light .training-lesson-desc { color: var(--steel); }
.theme-light .training-lesson-done-text { color: var(--success-deep); }
.theme-light .training-video-loading-text { color: var(--steel); }
.theme-light .training-lesson-detail-desc { color: var(--steel); }
.theme-light .training-completed-badge-text { color: var(--success-deep); }
.theme-light .training-path-card { background: var(--navy-lift); border: 1rpx solid var(--navy-border); }
.theme-light .training-path-title { color: var(--text); }
.theme-light .training-path-tier { color: var(--info); }
.theme-light .training-path-desc { color: var(--text-muted); }
.theme-light .training-path-progress-label { color: var(--text-muted); }
.theme-light .training-course-level { color: var(--info); }
.theme-light .training-course-credits { color: var(--success-deep); }
.theme-light .training-lesson-credits-label { color: var(--success-deep); }
.theme-light .training-lesson-quiz-badge { color: var(--warn); }
.theme-light .training-text-content { background: var(--navy-lift); }
.theme-light .training-quiz-section { border-top: 1rpx solid var(--navy-border); }
.theme-light .training-quiz-title { color: var(--text); }
.theme-light .training-quiz-question { background: var(--navy-lift); }
.theme-light .training-quiz-scenario { border-bottom: 1rpx solid var(--navy-border); }
.theme-light .training-quiz-q-text { color: var(--text); }
.theme-light .training-quiz-option-text { color: var(--text); }
.theme-light .training-quiz-result-score { color: var(--text); }
.theme-light .training-quiz-result-label { color: var(--text-muted); }
.theme-light .training-quiz-result-credits { color: var(--success-deep); }
.theme-light .training-quiz-review-correct .training-quiz-review-icon { color: var(--success-deep); }
.theme-light .training-quiz-review-wrong .training-quiz-review-icon { color: var(--danger); }
.theme-light .training-quiz-review-your-ans { color: var(--danger); }
.theme-light .training-quiz-review-correct-ans { color: var(--success-deep); }
.theme-light .training-cert-card { background: var(--navy-lift); }
.theme-light .training-cert-title { color: var(--text); }
.theme-light .training-cert-tier { color: var(--warn); }
.theme-light .training-cert-chevron { color: var(--text-muted); }
.theme-light .cert-detail-card { background: var(--navy-card); }
.theme-light .cert-status-check { color: var(--success-deep); }
.theme-light .cert-status-text { color: var(--success-deep); }
.theme-light .cert-close-btn { color: var(--text-muted); }
.theme-light .cert-label { color: var(--text-muted); }
.theme-light .cert-value { color: var(--text); }
.theme-light .cert-valid { color: var(--success-deep) !important; }
.theme-light .wellness-section-title { color: var(--text); }
.theme-light .wellness-empty-text { color: var(--text-muted); }
.theme-light .sleep-track-card { background: var(--navy-lift); }
.theme-light .sleep-track-name { color: var(--text); }
.theme-light .sleep-track-dur { color: var(--text-muted); }
.theme-light .sleep-np-title { color: var(--text); }
.theme-light .media-asset-card { background: var(--navy-lift); }
.theme-light .media-asset-icon--video .media-asset-glyph { color: var(--danger); }
.theme-light .media-asset-icon--doc .media-asset-glyph { color: var(--warn); }
.theme-light .media-asset-name { color: var(--text); }
.theme-light .media-asset-sub { color: var(--text-muted); }
.theme-light .media-asset-btn-text { color: var(--text-sub); }
.theme-light .device-apk-card { background: var(--navy-lift); }
.theme-light .device-apk-name { color: var(--text); }
.theme-light .device-apk-version { color: var(--text-muted); }
.theme-light .device-apk-btn-text { color: var(--success-deep); }
.theme-light .scan-box-card { background: rgba(var(--wave-rgb), 0.08); border: 2rpx solid rgba(var(--wave-rgb), 0.28); }
.theme-light .scan-box-title { color: var(--text); }
.theme-light .scan-box-detail { color: var(--text-muted); }
.theme-light .pcard { background: rgba(var(--blue-rgb), 0.10); border: 1rpx solid rgba(var(--blue-rgb), 0.26); }
.theme-light .pcard-title { color: var(--chat-accent); }
.theme-light .pcard-row { border-top: 1rpx solid rgba(var(--blue-rgb), 0.18); }
.theme-light .pcard-row:first-of-type { border-top: none; }
.theme-light .pcard-reason { color: var(--text-sub); }
.theme-light .pcard-price { color: var(--chat-accent); }
.theme-light .pcard-arrow { color: var(--text-sub); }
.theme-light .gcard { background: rgba(var(--blue-rgb), 0.10); border: 1rpx solid rgba(var(--blue-rgb), 0.26); }
.theme-light .gcard-title { color: var(--chat-accent); }
.theme-light .gcard-row { border-top: 1rpx solid rgba(var(--blue-rgb), 0.18); }
.theme-light .gcard-row:first-of-type { border-top: none; }
.theme-light .gcard-img { background: rgba(var(--blue-rgb), 0.08); }
.theme-light .gcard-reason { color: var(--text-sub); }
.theme-light .gcard-supplier { color: var(--chat-accent); }
.theme-light .gcard-price { color: var(--chat-accent); }
.theme-light .gcard-note { color: var(--text-sub); }
.theme-light .lcard { background: rgba(var(--blue-rgb), 0.10); border: 1rpx solid rgba(var(--blue-rgb), 0.26); }
.theme-light .lcard-video { background: #000; }
.theme-light .lcard-cover { background: rgba(var(--blue-rgb), 0.14); }
.theme-light .lcard-play { color: var(--chat-accent); }
.theme-light .lcard-done { color: var(--chat-accent); }
.theme-light .ccard-cta { color: var(--chat-accent); background: rgba(var(--blue-rgb), 0.16); border: 1rpx solid rgba(var(--blue-rgb), 0.40); }
.theme-light .ccard-done { color: var(--chat-accent); background: rgba(var(--blue-rgb), 0.08); border: 1rpx dashed rgba(var(--blue-rgb), 0.30); }
/* The miniapp's own .theme-light rules: */
.theme-light { --chat-accent: #7A4A28; --chat-good: #0B5C3E; --chat-warn: #6E4805; --chat-high: #A32A1E; --chat-low: #3730A3; --chat-pill-fg: #5A4630; --chat-sep-fg: #6B5947; }
.theme-light .sandbox-banner { background: rgba(245, 158, 11, 0.12); border-bottom-color: rgba(245, 158, 11, 0.35); }
.theme-light .viva-expired-banner { background: rgba(99, 117, 236, 0.1); border-bottom-color: rgba(99, 117, 236, 0.3); }
.theme-light .menu-credit-row { background: rgba(99, 117, 236, 0.06); }
.theme-light .menu-credit-value { color: #4f5fcc; }
.theme-light .pkg-card { background: rgba(var(--wave-rgb), 0.06); border-color: rgba(var(--wave-rgb), 0.22); }
.theme-light .pkg-stage { background: rgba(var(--wave-rgb), 0.08); }
.theme-light .pkg-stage-awaiting_formulation,
.theme-light .pkg-stage-shipped,
.theme-light .pkg-stage-delivered { background: rgba(138, 93, 10, 0.08); }
.theme-light .pkg-stage-active { background: rgba(15, 122, 82, 0.08); }
.theme-light .pkg-track { background: rgba(var(--wave-rgb), 0.07); }
.theme-light .pkg-track-copy { color: var(--blue); }
.theme-light .pkg-cta { background: rgba(138, 93, 10, 0.09); border-color: rgba(138, 93, 10, 0.42); }
.theme-light .pkg-cta-ghost { background: rgba(var(--wave-rgb), 0.1); border-color: rgba(var(--wave-rgb), 0.32); }
.theme-light .store-credit-card { background: linear-gradient(150deg, rgba(99, 117, 236, 0.12) 0%, rgba(99, 117, 236, 0.04) 100%); border-color: rgba(99, 117, 236, 0.3); box-shadow: 0 4rpx 20rpx rgba(99, 117, 236, 0.12); }
.theme-light .store-credit-card-num { color: #1e2c8a; }
.theme-light .store-credit-card-unit { color: #4A58C8; }
.theme-light .store-credit-card-label { color: #5B67C9; }
.theme-light.main { background: var(--bg-gradient); }
.theme-light .status-bar-spacer { background: var(--bg-surface); }
.theme-light .app-header { background: var(--bg-surface); border-bottom-color: var(--navy-border); }
.theme-light .header-title { color: var(--text); }
.theme-light .header-user { color: var(--text-sub); }
.theme-light .header-divider { background: rgba(201, 149, 106, 0.25); }
.theme-light .menu-dropdown { background: var(--navy-card); border-color: rgba(201, 149, 106, 0.25); box-shadow: 0 8rpx 40rpx rgba(44, 44, 44, 0.12); }
.theme-light .menu-divider { background: rgba(201, 149, 106, 0.15); }
.theme-light .menu-item-icon { color: var(--text-sub); }
.theme-light .menu-item-label { color: var(--text); }
.theme-light .menu-fs-step { border-color: rgba(201, 149, 106, 0.3); color: var(--text-sub); }
.theme-light .menu-fs-step-on { background: rgba(201, 149, 106, 0.16); border-color: #C9956A; color: var(--text); }
.theme-light .tab-bar { background: var(--bg-tabbar); border-top-color: var(--navy-border); }
.theme-light .tab-label { color: var(--text-muted); }
.theme-light .tab-active .tab-label { color: var(--blue); }
.theme-light .tab-icon-img { filter: brightness(0); opacity: 0.3; }
.theme-light .tab-active .tab-icon-img { filter: brightness(0); opacity: 0.75; }
.theme-light .message-ai { background: var(--navy-lift); color: var(--text); border-color: rgba(201, 149, 106, 0.2); }
.theme-light .message-coach { background: rgba(16, 185, 129, 0.08); color: var(--text); border-color: rgba(16, 185, 129, 0.25); }
.theme-light .chat-history-text { color: #667188; }
.theme-light .chat-history-start-text { color: #697183; }
.theme-light .chat-history-spinner,
.theme-light .chat-refresher-spinner { border-color: rgba(60,80,120,0.15); border-top-color: rgba(60,80,120,0.55); }
.theme-light .msg-coach-label { color: #076646; }
.theme-light .msg-ag-label { color: #2942E5; }
.theme-light .msg-action-card { background: linear-gradient(135deg, rgba(201, 149, 106, 0.15), rgba(201, 149, 106, 0.06)); border-color: rgba(201, 149, 106, 0.4); }
.theme-light .msg-action-label { color: var(--text-sub); }
.theme-light .msg-action-arrow { color: var(--blue); }
.theme-light .ob-bar { background: var(--bg-input); border-top-color: var(--navy-border); }
.theme-light .ob-input { background: rgba(0, 0, 0, 0.04); border-color: rgba(201, 149, 106, 0.3); color: var(--text); }
.theme-light .ob-ph { color: var(--text-muted); }
.theme-light .slider-key { color: var(--text-muted); }
.theme-light .slider-val { color: var(--text); }
.theme-light .slider-unit { color: var(--text-muted); }
.theme-light .slider-val-input { color: var(--text); }
.theme-light .slider-step-btn { background: rgba(99, 117, 236, 0.1); border-color: rgba(99, 117, 236, 0.3); }
.theme-light .quick-btn { border-color: rgba(201, 149, 106, 0.35); background: rgba(201, 149, 106, 0.1); color: var(--text); }
.theme-light .picker-row { background: var(--navy-lift); border-color: rgba(201, 149, 106, 0.28); }
.theme-light .picker-val { color: var(--text); }
.theme-light .picker-arrow { color: var(--text-muted); }
.theme-light .cond-chip { border-color: rgba(201, 149, 106, 0.3); background: rgba(201, 149, 106, 0.06); color: var(--text-muted); }
.theme-light .cond-chip-on { border-color: var(--blue); background: rgba(201, 149, 106, 0.2); color: var(--text); }
.theme-light .tool-item { background: rgba(201, 149, 106, 0.08); border-color: rgba(201, 149, 106, 0.25); }
.theme-light .tool-item-label { color: var(--text); }
.theme-light .tool-item-icon { color: var(--blue); }
.theme-light .input-area { background: var(--bg-input); border-top-color: var(--navy-border); }
.theme-light .chat-textarea { background: var(--navy-lift); border-color: rgba(201, 149, 106, 0.22); color: var(--text); }
.theme-light .textarea-ph { color: var(--text-muted); }
.theme-light .plus-btn { background: rgba(201, 149, 106, 0.1); border-color: rgba(201, 149, 106, 0.25); }
.theme-light .plus-icon { color: var(--text-sub); }
.theme-light .plus-btn-open { background: rgba(201, 149, 106, 0.25); border-color: var(--blue); }
.theme-light .plus-btn-open .plus-icon { color: var(--blue); }
.theme-light .mic-btn { background: rgba(201, 149, 106, 0.1); border-color: rgba(201, 149, 106, 0.25); }
.theme-light .mic-recording-banner { background: rgba(226, 88, 88, 0.08); border-top-color: rgba(226, 88, 88, 0.25); }
.theme-light .mic-icon { filter: brightness(0); opacity: 0.55; }
.theme-light .mic-btn-active .mic-icon { filter: none; opacity: 1; }
.theme-light .kino-scan-bar { background: var(--bg-input); border-top-color: var(--navy-border); }
