/* #ifdef MP-WEIXIN */
/* Header menu geometry in the miniapp's rpx (pages/main/main.wxss .menu-*): with px padding and gaps
   but rpx text, the menu did not grow with the screen — on a 430pt phone 字体大小 ran into its A
   buttons. Gaps replace the px margins between icon/label and between the A steps. */
.menu-dropdown { left: 24rpx; border-radius: 20rpx; min-width: 240rpx; }
.menu-item { gap: 20rpx; padding: 28rpx 32rpx; }
.menu-item-icon { margin-right: 0; }
.menu-divider { margin: 0 24rpx; }
.menu-fs-row { gap: 20rpx; padding: 20rpx 32rpx; }
.menu-fs-steps { gap: 10rpx; }
.menu-fs-step { width: 56rpx; height: 56rpx; margin-left: 0; border-radius: 12rpx; }
.menu-fs-a0 { font-size: 20rpx; }
.menu-fs-a1 { font-size: 26rpx; }
.menu-fs-a2 { font-size: 32rpx; }
.menu-fs-a3 { font-size: 38rpx; }
.menu-credit-row { padding: 24rpx 32rpx; }
/* #endif */
