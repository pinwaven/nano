<template>
  <!-- #ifdef WEB || MP-WEIXIN -->
  <!-- xapp-mini renders this miniapp markup too, with the miniapp's own stylesheet (style block). -->
  <!-- Web: the miniapp's pages/emails markup (the web user-app's IdentityPage), styled by the
       shared stylesheet in static/web/. Native keeps its own layout below. -->
  <view :class="nativeClass('emails-page route-page', (theme == 'light' ? 'theme-light' : ''))">
    <!-- #ifdef MP-WEIXIN -->
    <view class="status-bar-spacer" :style="'height: ' + statusBarHeight + 'px;'"></view>
    <!-- #endif -->
    <view :class="nativeClass('app-header', (null))">
      <view class="back-btn" v-on:click="goBack"><text :class="nativeClass('back-icon', (null))">‹</text><text :class="nativeClass('back-label', (null))">{{ t('back') }}</text></view>
      <text :class="nativeClass('header-title', (null))">{{ t('title') }}</text>
    </view>
    <view class="emails-content tab-scroll">
      <view v-if="loading" class="center-msg"><text :class="nativeClass('dim-text', (null))">{{ t('loading') }}</text></view>
      <view v-else :class="nativeClass('card', (null))">
        <view v-for="(e, i) in emails" :key="i" class="email-row">
          <view class="email-row-main">
            <text :class="nativeClass('email-value', (null))">{{ e.getString('email') }}</text>
            <text v-if="e.getBoolean('is_primary') == true" :class="nativeClass('email-badge', (null))">{{ t('primaryBadge') }}</text>
            <text v-if="e.getString('verified_at') == null" :class="nativeClass('email-badge email-badge-muted', (null))">{{ t('unverifiedBadge') }}</text>
          </view>
          <view class="email-row-actions">
            <text v-if="e.getBoolean('is_primary') != true" :class="nativeClass('email-action', (null))" v-on:click="setPrimary(`${e.getString('email')}`)">{{ t('setPrimaryAction') }}</text>
            <text :class="nativeClass('email-action email-action-danger', (null))" v-on:click="removeEmail(`${e.getString('email')}`)">{{ t('removeAction') }}</text>
          </view>
        </view>
        <view v-if="emails.length == 0" class="center-msg"><text :class="nativeClass('dim-text', (null))">{{ t('emptyHint') }}</text></view>
        <view :class="nativeClass('btn btn-outline add-email-btn', (null))" v-on:click="openAddEmail"><text>{{ t('addEmailBtn') }}</text></view>
      </view>
    </view>
    <view v-if="addMode" class="withdraw-overlay" v-on:click="closeAddEmail">
      <view :class="nativeClass('withdraw-modal', (null))" v-on:click.stop="noop">
        <text :class="nativeClass('withdraw-modal-title', (null))">{{ t('addEmailBtn') }}</text>
        <view v-if="addStep == 'email'">
          <view class="form-field">
            <text :class="nativeClass('form-label', (null))">{{ t('emailLabel') }}</text>
            <input :class="nativeClass('form-input', (null))" v-model="newEmail" :placeholder="t('emailPlaceholder')" :maxlength="254" type="text" :focus="true" v-on:confirm="sendCode" />
          </view>
          <text v-if="addError.length > 0" :class="nativeClass('error-text', (null))">{{ addError }}</text>
          <view class="withdraw-btns">
            <view :class="nativeClass('btn btn-outline', (null))" v-on:click="closeAddEmail"><text>{{ t('cancelBtn') }}</text></view>
            <view :class="nativeClass('btn btn-primary', (addLoading ? 'disabled' : ''))" v-on:click="sendCode"><text>{{ addLoading ? t('sending') : t('sendCodeBtn') }}</text></view>
          </view>
        </view>
        <view v-else>
          <view class="form-field">
            <text :class="nativeClass('form-label', (null))">{{ t('codeLabel') }}</text>
            <text :class="nativeClass('email-step-desc', (null))">{{ codeSentToText }}</text>
            <input :class="nativeClass('form-input', (null))" v-model="code" placeholder="——————" :maxlength="6" type="number" :focus="true" />
          </view>
          <text v-if="addError.length > 0" :class="nativeClass('error-text', (null))">{{ addError }}</text>
          <view class="emails-links">
            <text v-if="resendCooldown > 0" :class="nativeClass('dim-text', (null))">{{ t('resendCooldown').split('{n}').join(`${resendCooldown}`) }}</text>
            <text v-else :class="nativeClass('emails-link', (null))" v-on:click="sendCode">{{ t('resendCode') }}</text>
            <text :class="nativeClass('emails-link', (null))" v-on:click="changeEmail">{{ t('changeEmail') }}</text>
          </view>
          <view class="withdraw-btns">
            <view :class="nativeClass('btn btn-outline', (null))" v-on:click="closeAddEmail"><text>{{ t('cancelBtn') }}</text></view>
            <view :class="nativeClass('btn btn-primary', (addLoading ? 'disabled' : ''))" v-on:click="manualVerify"><text>{{ addLoading ? t('verifying') : t('verifyBtn') }}</text></view>
          </view>
        </view>
      </view>
    </view>
  </view>
  <!-- #endif -->
  <!-- #ifdef APP -->
  <view class="ph-screen">
    <view class="ph-header" :style="'padding-top:' + statusBarHeight + 'px'">
      <view class="ph-back" v-on:click="goBack"><text class="ph-back-text">‹ {{ t('back') }}</text></view>
      <text class="ph-title">{{ t('title') }}</text>
    </view>

    <text v-if="loading" class="ph-hint">{{ t('loading') }}</text>

    <scroll-view direction="vertical" v-else class="ph-list">
      <view v-for="(e, i) in emails" :key="i" class="ph-row">
        <view class="ph-row-main">
          <text class="ph-number">{{ e.getString('email') }}</text>
          <text v-if="e.getBoolean('is_primary') == true" class="ph-badge">{{ t('primaryBadge') }}</text>
          <text v-else-if="e.getString('verified_at') == null" class="ph-badge ph-badge-muted">未验证</text>
        </view>
        <view class="ph-row-actions">
          <text v-if="e.getBoolean('is_primary') != true" class="ph-action" v-on:click="setPrimary(`${e.getString('email')}`)">{{ t('setPrimaryAction') }}</text>
          <text class="ph-action ph-action-danger" v-on:click="removeEmail(`${e.getString('email')}`)">{{ t('removeAction') }}</text>
        </view>
      </view>

      <view class="ph-add-btn" v-on:click="openAddEmail"><text class="btn-text">{{ t('addEmailBtn') }}</text></view>
    </scroll-view>

    <view v-if="addMode" class="ph-modal">
      <view class="ph-card">
        <view v-if="addStep == 'email'">
          <text class="ph-label">{{ t('emailLabel') }}</text>
          <input class="ph-input" v-model="newEmail" :placeholder="t('emailPlaceholder')" :maxlength="254" />
          <text v-if="addError.length > 0" class="ph-error">{{ addError }}</text>
          <view class="ph-btn" v-on:click="sendCode"><text class="btn-text">{{ addLoading ? t('sending') : t('sendCodeBtn') }}</text></view>
        </view>
        <view v-else>
          <text class="ph-label">{{ t('codeLabel') }}</text>
          <text class="ph-hint">{{ codeSentToText }}</text>
          <input class="ph-input" v-model="code" placeholder="6位验证码" :maxlength="6" />
          <text v-if="addError.length > 0" class="ph-error">{{ addError }}</text>
          <view class="ph-btn" v-on:click="manualVerify"><text class="btn-text">{{ addLoading ? t('verifying') : t('verifyBtn') }}</text></view>
          <view class="ph-link" v-on:click="changeEmail"><text class="ph-link-text">{{ t('changeEmail') }}</text></view>
        </view>
        <view class="ph-link" v-on:click="closeAddEmail"><text class="ph-link-text">{{ t('cancelBtn') }}</text></view>
      </view>
    </view>
  </view>
  <!-- #endif -->
</template>

<script>
import { nativeClass as nativeVisualClass } from '../../utils/native-visual.uts'

// Ported from miniapp pages/emails/emails.js — sibling of the phones page. Waven-root
// channels only (server refuses aeviva-tree accounts with channel_not_supported, kept as a
// user-visible error string). Live-filtered inputs → v-model + validate-on-send.

import { BASE } from '../../utils/config.uts'
import { state } from '../../utils/state.uts'
import { saveSession } from '../../utils/session.uts'
import { getBody, postBody } from '../../utils/request.uts'
import { maskPhone, maskEmail } from '../../utils/phone.uts'

const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/

const T_ZH : UTSJSONObject = {
  title: '邮箱管理', back: '返回', loading: '加载中…', primaryBadge: '主邮箱',
  setPrimaryAction: '设为主邮箱', removeAction: '移除', addEmailBtn: '+ 添加邮箱',
  emailLabel: '邮箱', emailPlaceholder: '请输入邮箱地址', sendCodeBtn: '发送验证码', sending: '发送中…',
  codeLabel: '输入验证码', codeSentTo: '验证码已发送至 {email}', verifyBtn: '验证并添加', verifying: '验证中…',
  changeEmail: '更换邮箱', cancelBtn: '取消', resendCode: '重新发送验证码', resendCooldown: '{n}秒后可重新发送',
  unverifiedBadge: '未验证', emptyHint: '还没有绑定邮箱。绑定后可用邮箱验证码登录。',
  confirmRemoveTitle: '移除邮箱', confirmRemoveContent: '确定要移除 {email} 吗？',
  confirmSetPrimaryTitle: '设为主邮箱', confirmSetPrimaryContent: '将 {email} 设为主邮箱？',
  errorInvalidEmail: '请输入正确的邮箱地址', errorSendFailed: '验证码发送失败，请重试',
  errorRateLimited: '发送过于频繁，请稍后再试', errorNetwork: '网络错误，请重试',
  errorInvalidCode: '验证码不正确', errorTooManyAttempts: '错误次数过多，请重新获取验证码',
  errorEmailInUse: '该邮箱已被其他账号绑定', errorChannel: '当前账号不支持邮箱登录',
  toastRemoved: '已移除', toastPrimarySet: '已设为主邮箱', toastAdded: '已添加',
} as UTSJSONObject
const T_EN : UTSJSONObject = {
  title: 'Manage Emails', back: 'Back', loading: 'Loading…', primaryBadge: 'Primary',
  setPrimaryAction: 'Set Primary', removeAction: 'Remove', addEmailBtn: '+ Add Email',
  emailLabel: 'Email', emailPlaceholder: 'Enter email address', sendCodeBtn: 'Send Code', sending: 'Sending…',
  codeLabel: 'Enter Verification Code', codeSentTo: 'Code sent to {email}', verifyBtn: 'Verify & Add', verifying: 'Verifying…',
  changeEmail: 'Change Email', cancelBtn: 'Cancel', resendCode: 'Resend Code', resendCooldown: 'Resend in {n}s',
  unverifiedBadge: 'Unverified', emptyHint: 'No email yet. Add one to sign in with an email code.',
  confirmRemoveTitle: 'Remove Email', confirmRemoveContent: 'Remove {email}?',
  confirmSetPrimaryTitle: 'Set Primary', confirmSetPrimaryContent: 'Set {email} as your primary email?',
  errorInvalidEmail: 'Please enter a valid email address', errorSendFailed: 'Failed to send code, please try again',
  errorRateLimited: 'Too many requests, please try again later', errorNetwork: 'Network error, please try again',
  errorInvalidCode: 'Invalid code', errorTooManyAttempts: 'Too many wrong attempts — request a new code',
  errorEmailInUse: 'This email is already bound to another account', errorChannel: 'Email login is not available for this account',
  toastRemoved: 'Removed', toastPrimarySet: 'Primary email updated', toastAdded: 'Added',
} as UTSJSONObject

export default {
  name: 'EmailsPage',
  data() {
    return {
      lang: 'zh',
      statusBarHeight: 44,
      emails: [] as UTSJSONObject[],
      loading: true,
      addMode: false,
      addStep: 'email',
      newEmail: '',
      code: '',
      addLoading: false,
      addError: '',
      codeSentToText: '',
      theme: 'dark',
      resendCooldown: 0,
      _cooldownTimer: 0 as number,
    }
  },
  onUnload() { this._stopCooldown() },
  onLoad(_options : OnLoadOptions) {
    this.lang = state.lang
    this.theme = state.theme
    const info = uni.getWindowInfo()
    this.statusBarHeight = info.statusBarHeight
    this.fetchEmails()
  },
  methods: {
    nativeClass(names : string, dynamic : any | null) : string {
      return nativeVisualClass(names, dynamic, this.theme, null)
    },
    t(key : string) : string {
      const dict = this.lang == 'en' ? T_EN : T_ZH
      const v = dict.getString(key)
      return v != null ? v : key
    },
    _fmt(s : string, email : string) : string {
      return s.split('{email}').join(email)
    },
    goBack() {
      uni.navigateBack()
    },
    async fetchEmails() {
      const user = state.user
      if (user == null || user!.getBoolean('guest') == true) { this.loading = false; return }
      this.loading = true
      const uid = user!.getString('user_id') ?? ''
      const res = await getBody(`${BASE}/api/email-otp/list?user_id=${encodeURIComponent(uid)}`)
      const out : UTSJSONObject[] = []
      if (res != null && res!.getBoolean('success') == true) {
        const list = res!.getArray<UTSJSONObject>('emails')
        if (list != null) {
          for (const e of list!) out.push(e)
        }
      }
      this.emails = out
      this.loading = false
    },
    openAddEmail() {
      this.addMode = true
      this.addStep = 'email'
      this.newEmail = ''
      this.code = ''
      this.addError = ''
    },
    closeAddEmail() {
      this.addMode = false
      this._stopCooldown()
    },
    async sendCode() {
      const email = this.newEmail.trim().toLowerCase()
      if (!EMAIL_RE.test(email)) { this.addError = this.t('errorInvalidEmail'); return }
      if (this.resendCooldown > 0 || this.addLoading) return
      this.newEmail = email
      this.addLoading = true
      this.addError = ''
      const res = await postBody(`${BASE}/api/email-otp/send`, {
        email: email, purpose: 'bind', language: this.lang,
      } as UTSJSONObject)
      this.addLoading = false
      if (res == null || res.getBoolean('success') != true) {
        const err = res == null ? '' : res.getString('error')
        this.addError = err == 'rate_limited' ? this.t('errorRateLimited')
          : err == 'invalid_email' ? this.t('errorInvalidEmail')
          : this.t('errorSendFailed')
        return
      }
      this.addStep = 'code'
      this.code = ''
      this.codeSentToText = this._fmt(this.t('codeSentTo'), email)
      this._startCooldown()
    },
    // pages/emails/emails.js: 60s before "resend" is offered again.
    _startCooldown() {
      this._stopCooldown()
      this.resendCooldown = 60
      this._cooldownTimer = setInterval(() => {
        if (this.resendCooldown <= 1) this._stopCooldown()
        else this.resendCooldown = this.resendCooldown - 1
      }, 1000)
    },
    _stopCooldown() {
      if (this._cooldownTimer != 0) clearInterval(this._cooldownTimer)
      this._cooldownTimer = 0
      this.resendCooldown = 0
    },
    noop() {},
    manualVerify() {
      this.verifyCode()
    },
    async verifyCode() {
      const code = this.code.trim()
      if (code.length == 0 || this.addLoading) return
      const user = state.user
      if (user == null) return
      this.addLoading = true
      this.addError = ''
      const res = await postBody(`${BASE}/api/email-otp/bind`, {
        user_id: user!.getString('user_id'), email: this.newEmail, code: code,
      } as UTSJSONObject)
      this.addLoading = false
      if (res == null) { this.addError = this.t('errorNetwork'); return }
      if (res.getBoolean('success') != true) {
        const err = res.getString('error')
        this.addError = err == 'invalid_code' ? this.t('errorInvalidCode')
          : err == 'too_many_attempts' ? this.t('errorTooManyAttempts')
          : err == 'email_in_use' ? this.t('errorEmailInUse')
          : err == 'channel_not_supported' ? this.t('errorChannel')
          : this.t('errorNetwork')
        return
      }
      // Same merge semantics as phone bind: the response user (winner) replaces the cache.
      const token = res.getString('session_token')
      if (token != null && token!.length > 0) saveSession(token!)
      this._applyUpdatedUser(res.getJSON('user'), res.getJSON('channel'))
      this.addMode = false
      uni.showToast({ title: this.t('toastAdded'), icon: 'success' })
      this.fetchEmails()
    },
    changeEmail() {
      this.addStep = 'email'
      this.code = ''
      this.addError = ''
      this._stopCooldown()
    },
    setPrimary(email : string) {
      uni.showModal({
        title: this.t('confirmSetPrimaryTitle'),
        content: this._fmt(this.t('confirmSetPrimaryContent'), email),
        success: (res) => { (async () : Promise<void> => {
          if (!res.confirm) return
          const user = state.user
          if (user == null) return
          const r = await postBody(`${BASE}/api/email-otp/set-primary`, {
            user_id: user!.getString('user_id'), email: email,
          } as UTSJSONObject)
          if (r == null || r.getBoolean('success') != true) { uni.showToast({ title: this.t('errorNetwork'), icon: 'none' }); return }
          var verified = false
          for (const row of this.emails) {
            if (row.getString('email') == email && row.getString('verified_at') != null) verified = true
          }
          this._applyEmailChange(email, verified)
          uni.showToast({ title: this.t('toastPrimarySet'), icon: 'success' })
          this.fetchEmails()
        })() }
      })
    },
    removeEmail(email : string) {
      uni.showModal({
        title: this.t('confirmRemoveTitle'),
        content: this._fmt(this.t('confirmRemoveContent'), email),
        success: (res) => { (async () : Promise<void> => {
          if (!res.confirm) return
          const user = state.user
          if (user == null) return
          const r = await postBody(`${BASE}/api/email-otp/remove`, {
            user_id: user!.getString('user_id'), email: email,
          } as UTSJSONObject)
          if (r == null || r.getBoolean('success') != true) { uni.showToast({ title: this.t('errorNetwork'), icon: 'none' }); return }
          const next = r.getString('new_primary')
          var verified = false
          if (next != null) {
            for (const row of this.emails) {
              if (row.getString('email') == next! && row.getString('verified_at') != null) verified = true
            }
          }
          this._applyEmailChange(next, next != null && verified)
          uni.showToast({ title: this.t('toastRemoved'), icon: 'success' })
          this.fetchEmails()
        })() }
      })
    },
    _applyEmailChange(newPrimaryEmail : string | null, verified : boolean) {
      const user = state.user
      if (user == null) return
      const updated = new UTSJSONObject()
      user!.toMap().forEach((v : any | null, k : string) => { updated[k] = v })
      updated['email'] = newPrimaryEmail
      updated['email_verified'] = newPrimaryEmail != null && verified
      this._applyUpdatedUser(updated, state.channel)
    },
    _applyUpdatedUser(updatedUser : UTSJSONObject | null, channel : UTSJSONObject | null) {
      if (updatedUser == null) return
      const rawPhone = updatedUser!.getString('phone')
      const rawEmail = updatedUser!.getString('email')
      const storedMasked = updatedUser!.getString('maskedPhone')
      var masked = storedMasked != null ? storedMasked! : ''
      if (masked.length == 0) {
        const mp = maskPhone(rawPhone)
        masked = mp.length > 0 ? mp : maskEmail(rawEmail)
      }
      const fullUser = new UTSJSONObject()
      updatedUser!.toMap().forEach((v : any | null, k : string) => { fullUser[k] = v })
      fullUser['maskedPhone'] = masked
      state.user = fullUser
      if (channel != null) state.channel = channel
      const stored = new UTSJSONObject()
      fullUser.toMap().forEach((v : any | null, k : string) => {
        if (k == 'phone' || k == 'email') return
        stored[k] = v
      })
      const phoneSet = fullUser.getBoolean('phoneSet')
      stored['phoneSet'] = (rawPhone != null && rawPhone!.length > 0) || (phoneSet != null && phoneSet!)
      stored['phone_verified'] = fullUser.getBoolean('phone_verified') == true
      stored['email_verified'] = fullUser.getBoolean('email_verified') == true
      stored['maskedPhone'] = masked
      uni.setStorageSync('nano_user', stored)
    },
  },
  watch: {
    code(newVal : string) {
      let clean = ''
      for (let i = 0; i < newVal.length; i++) {
        const c = newVal.charCodeAt(i) ?? 0
        if (c >= 48 && c <= 57) clean += newVal.charAt(i)
      }
      if (clean.length > 6) { this.code = clean.substring(0, 6); return }
      if (clean != newVal) { this.code = clean; return }
      this.addError = ''
      if (clean.length == 6) this.verifyCode()
    },
    newEmail(newVal : string) {
      this.addError = ''
    },
  }
}
</script>

<style>
/* #ifdef MP-WEIXIN */
/* xapp-mini: the miniapp's pages/emails/emails.wxss verbatim. */
/* The miniapp's stylesheet assumes browser defaults (block views, `display:flex` = a row);
   uvue.wxss makes every view a flex column. Undo that for this page's own view classes, listed
   explicitly: a tag selector would also reach the embedded components (WeChat applies a page's
   tag selectors to them), and the WXSS compiler rejects both :not() and a :where() list (the
   whole app then renders blank). It sits before every miniapp rule, so at equal specificity
   those still win. */
.add-email-btn, .app-header, .back-btn, .bottom-safe, .btn, .btn-outline, .btn-primary, .card, .center-msg, .email-row, .email-row-actions, .email-row-main, .emails-content, .emails-links, .emails-page, .form-field, .route-page, .status-bar-spacer, .tab-scroll, .theme-light, .withdraw-btns, .withdraw-modal, .withdraw-overlay { display: block; position: static; flex-direction: row; flex-shrink: 1; align-items: normal; align-content: normal; justify-content: normal; min-height: auto; min-width: auto; }
/* inlined from the miniapp's ../referral/referral.wxss (its @import) */
.referral-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #0B1C2E;
  color: #E8F0F8;
  overflow: hidden;
}

.referral-page.theme-light {
  background: #F4F6FA;
  color: #1A2B3C;
}

.status-bar-spacer { width: 100%; flex-shrink: 0; }

/* Header */
.app-header {
  background: rgba(11, 28, 46, 0.85);
  border-bottom: 1rpx solid rgba(99, 117, 236, 0.18);
  padding: 16rpx 36rpx 28rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.theme-light .app-header {
  background: rgba(244, 246, 250, 0.95);
  border-bottom-color: rgba(99, 117, 236, 0.15);
}

.back-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.back-icon {
  font-size: 44rpx;
  color: var(--blue);
  line-height: 1;
}

.back-label {
  font-size: 26rpx;
  color: var(--blue);
}

.header-title {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #EEF2FF;
}

.theme-light .header-title { color: #1A2B3C; }

/* Scroll area */
.referral-content {
  flex: 1;
  overflow: hidden;
  padding: 32rpx 28rpx;
  box-sizing: border-box;
}

/* Cards */
.card {
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(99, 117, 236, 0.2);
  border-radius: 20rpx;
  padding: 36rpx;
  margin-bottom: 24rpx;
}

.theme-light .card {
  background: #fff;
  border-color: rgba(99, 117, 236, 0.15);
}

.card-label {
  font-size: 22rpx;
  color: rgba(232, 240, 248, 0.5);
  letter-spacing: 3rpx;
  text-transform: uppercase;
  display: block;
  margin-bottom: 20rpx;
}

.theme-light .card-label { color: #5F656B; }

.code-row {
  margin-bottom: 28rpx;
}

.code-value {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: var(--blue);
  font-family: monospace;
}

.btn-row {
  display: flex;
  gap: 16rpx;
}

.btn {
  flex: 1;
  height: 72rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
  padding: 0;
  margin: 0;
  line-height: 1;
}

.btn-outline {
  background: transparent;
  border: 1rpx solid rgba(var(--blue-rgb), 0.5);
  color: var(--blue);
}

.btn-primary {
  background: var(--blue);
  color: #fff;
  border: none;
}

/* Stats */
.stats-row {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(99, 117, 236, 0.2);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.theme-light .stats-row { background: #fff; border-color: rgba(99, 117, 236, 0.15); }

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--blue);
}

.stat-label {
  font-size: 22rpx;
  color: rgba(232, 240, 248, 0.55);
}

.theme-light .stat-label { color: #5E656B; }

.stat-divider {
  width: 1rpx;
  height: 80rpx;
  background: rgba(var(--blue-rgb), 0.2);
}

/* How it works */
.how-card { margin-bottom: 24rpx; }

.how-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.how-row:last-child { margin-bottom: 0; }

.how-num {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(var(--blue-rgb), 0.2);
  border: 1rpx solid rgba(var(--blue-rgb), 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--blue);
  flex-shrink: 0;
  text-align: center;
  line-height: 36rpx;
}

.how-text {
  font-size: 26rpx;
  color: rgba(232, 240, 248, 0.75);
  line-height: 1.6;
  flex: 1;
}

.theme-light .how-text { color: rgba(26, 43, 60, 0.75); }

/* Section title */
.section-title {
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  color: rgba(232, 240, 248, 0.45);
  margin-bottom: 16rpx;
}

.theme-light .section-title { color: #6B7177; }

/* Friend cards */
.friend-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(var(--blue-rgb), 0.1);
}

.friend-card:last-child { border-bottom: none; }

.friend-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(var(--blue-rgb), 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-letter {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--blue);
}

.friend-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.friend-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #E8F0F8;
}

.theme-light .friend-name { color: #1A2B3C; }

.friend-meta {
  font-size: 22rpx;
  color: rgba(232, 240, 248, 0.45);
}

.theme-light .friend-meta { color: #6B7177; }

.friend-commission { flex-shrink: 0; }

.commission-amt {
  font-size: 26rpx;
  font-weight: 700;
  color: #4CAF8A;
}

.theme-light .commission-amt { color: #157A4D; }

/* Misc */
.center-msg {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-state {
  padding: 60rpx 0;
  display: flex;
  justify-content: center;
}

.dim-text {
  font-size: 26rpx;
  color: rgba(232, 240, 248, 0.4);
}

.theme-light .dim-text { color: #6A7175; }

.error-text {
  font-size: 26rpx;
  color: #E87070;
}

.theme-light .error-text { color: #DC2626; }

.bottom-safe { height: 60rpx; }

/* Credit balance card */
.credit-card { margin-bottom: 24rpx; }

.credit-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.credit-info { flex: 1; }

.credit-balance {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--blue);
  display: block;
  margin: 8rpx 0 4rpx;
}

.credit-currency {
  font-size: 26rpx;
  font-weight: 400;
  color: rgba(var(--blue-rgb), 0.7);
}

.credit-hint {
  font-size: 22rpx;
  color: rgba(232, 240, 248, 0.45);
  display: block;
}

.theme-light .credit-hint { color: #6B7177; }

.credit-withdraw-btn {
  flex: none;
  width: auto;
  padding: 0 32rpx;
  height: 72rpx;
  font-size: 26rpx;
}

/* Withdraw overlay */
.withdraw-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.withdraw-modal {
  width: 100%;
  background: #122033;
  border-radius: 32rpx 32rpx 0 0;
  padding: 48rpx 40rpx 80rpx;
  box-sizing: border-box;
}

.theme-light .withdraw-modal { background: #fff; }

.withdraw-modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #E8F0F8;
  display: block;
  margin-bottom: 40rpx;
  text-align: center;
}

.theme-light .withdraw-modal-title { color: #1A2B3C; }

.form-field { margin-bottom: 28rpx; }

.form-label {
  font-size: 24rpx;
  color: rgba(232, 240, 248, 0.55);
  display: block;
  margin-bottom: 12rpx;
}

.theme-light .form-label { color: #5E656B; }

.form-input {
  width: 100%;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(99, 117, 236, 0.3);
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #E8F0F8;
  box-sizing: border-box;
}

.theme-light .form-input { background: #f4f6fa; color: #1A2B3C; border-color: rgba(99, 117, 236, 0.2); }

.withdraw-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 40rpx;
}

.withdraw-btns .btn { flex: 1; }

/* Withdrawal history cards */
.wd-card {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(var(--blue-rgb), 0.1);
}

.wd-card:last-child { border-bottom: none; }

.wd-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.wd-credits {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--blue);
}

.wd-arrow {
  font-size: 22rpx;
  color: rgba(232, 240, 248, 0.4);
}

.theme-light .wd-arrow { color: #6A7175; }

.wd-cash {
  font-size: 28rpx;
  font-weight: 700;
  color: #4CAF8A;
  flex: 1;
}

.theme-light .wd-cash { color: #157A4D; }

.wd-badge {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.wd-status-pending  { background: rgba(245, 158, 11, 0.2); color: var(--warn); }
.wd-status-approved { background: rgba(37, 99, 235, 0.2);  color: #60a5fa; }
.wd-status-rejected { background: rgba(239, 68, 68, 0.2);  color: var(--danger-soft); }
.wd-status-completed { background: rgba(16, 185, 129, 0.2); color: var(--success); }

.theme-light .wd-status-pending   { color: #B45309; }
.theme-light .wd-status-approved  { color: #1D4ED8; }
.theme-light .wd-status-rejected  { color: #B91C1C; }
.theme-light .wd-status-completed { color: #047857; }

.wd-date {
  font-size: 22rpx;
  color: rgba(232, 240, 248, 0.4);
}

.theme-light .wd-date { color: #6A7175; }

/* ════════════════════════════════════════════════════════
   Light theme — muted-text contrast fixes (generated)
   The base rules above use low-alpha rgba() tuned for a bright color on dark
   navy. On the cream light surface that same alpha washes out to 1.4-2.1:1,
   and no alpha <= 0.6 can reach 4.5:1 on cream regardless of base color — so
   light theme needs opaque values. Ramp preserves the faint->strong hierarchy.
   ════════════════════════════════════════════════════════ */
.theme-light .back-icon { color: #5D4C32; }
.theme-light .back-label { color: #5D4C32; }
.theme-light .code-value { color: #5D4C32; }
.theme-light .btn-outline { color: #5D4C32; }
.theme-light .stat-num { color: #5D4C32; }
.theme-light .how-num { color: #5D4C32; }
.theme-light .avatar-letter { color: #5D4C32; }
.theme-light .credit-balance { color: #5D4C32; }
.theme-light .credit-currency { color: #5D4C32; }
.theme-light .wd-credits { color: #5D4C32; }

.emails-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #0B1C2E;
  color: #E8F0F8;
  overflow: hidden;
}

.emails-page.theme-light {
  background: #F4F6FA;
  color: #1A2B3C;
}

.emails-content {
  flex: 1;
  overflow-y: auto;
  padding: 32rpx 28rpx;
  box-sizing: border-box;
}

.email-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(var(--blue-rgb), 0.1);
}

.email-row:last-child { border-bottom: none; }

.email-row-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.email-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #E8F0F8;
}

.theme-light .email-value { color: #1A2B3C; }

.email-badge {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 600;
  background: rgba(var(--blue-rgb), 0.2);
  color: var(--blue);
}

/* An admin-added address nobody has proved yet (user_emails.verified_at IS NULL). */
.email-badge-muted {
  background: rgba(166, 196, 229, 0.12);
  color: rgba(166, 196, 229, 0.7);
}

/* An address can be long; let it wrap rather than push the actions off-screen. */
.email-value {
  word-break: break-all;
}

.email-row-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex-shrink: 0;
}

.email-action {
  font-size: 24rpx;
  color: var(--blue);
}

.email-action-danger {
  color: #E87070;
}

.theme-light .email-action-danger { color: #DC2626; }

.add-email-btn {
  margin-top: 24rpx;
  width: 100%;
}

.email-step-desc {
  font-size: 24rpx;
  color: rgba(232, 240, 248, 0.55);
  display: block;
  margin: 12rpx 0 20rpx;
}

.theme-light .email-step-desc { color: #5E656B; }

.emails-links {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.emails-link {
  font-size: 24rpx;
  color: var(--blue);
}

/* ════════════════════════════════════════════════════════
   Light theme — muted-text contrast fixes (generated)
   The base rules above use low-alpha rgba() tuned for a bright color on dark
   navy. On the cream light surface that same alpha washes out to 1.4-2.1:1,
   and no alpha <= 0.6 can reach 4.5:1 on cream regardless of base color — so
   light theme needs opaque values. Ramp preserves the faint->strong hierarchy.
   ════════════════════════════════════════════════════════ */
.theme-light .email-badge { color: #5D4C32; }
.theme-light .email-action { color: #5D4C32; }
.theme-light .emails-link { color: #5D4C32; }
/* #endif */
