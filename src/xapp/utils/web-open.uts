// Web build only — the twin of the web user-app's gcn.js:openGcnStore. A browser cannot frame
// the GCN storefront (it sends X-Frame-Options: sameorigin), so where the native app pushes
// pages/appview, the web build opens a NEW TAB: created synchronously in the tap handler and
// navigated after the webview-token mint, because a window.open after an await is
// popup-blocked on Safari and Chrome. Same `wvt` + `context` contract as appview (AGENTS §31).

import { BASE, API_ORIGIN } from './config.uts'
import { state } from './state.uts'
import { postBody } from './request.uts'

export function openInNewTab(path : string, context : UTSJSONObject | null) {
  // #ifdef WEB
  const target = /^https?:\/\//i.test(path) ? path : `${API_ORIGIN}${path}`
  const win = window.open('', '_blank')
  const go = (url : string) => {
    if (win != null) win.location.href = url
    else window.location.href = url
  }
  const user = state.user
  const openid = user != null ? (user.getString('user_id') ?? user.getString('openid')) : null
  if (openid == null || openid.length == 0) { go(target); return }
  const body = context != null
    ? { openid: openid, context: context } as UTSJSONObject
    : { openid: openid } as UTSJSONObject
  postBody(`${BASE}/api/webview-token`, body).then((res) => {
    const wvt = res != null ? res.getString('wvt') : null
    const sep = target.indexOf('?') != -1 ? '&' : '?'
    go(wvt != null ? `${target}${sep}wvt=${encodeURIComponent(wvt)}` : target)
  }).catch((_e : any | null) => { go(target) }) // appview does the same: opens, signed out
  // #endif
}
