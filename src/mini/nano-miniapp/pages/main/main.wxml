<view class="main fs-{{textScale}} {{theme === 'light' ? 'theme-light' : ''}}" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">

  <!-- ── Status bar spacer ── -->
  <view class="status-bar-spacer" style="height: {{statusBarHeight}}px;"></view>

  <!-- ── Header ── -->
  <view class="app-header" style="padding-right: {{capsuleRightPad}}px;" bindtap="toggleMenu">
    <view class="header-logo-btn">
      <image class="header-logo-img" src="{{channel.logo_url || '/assets/waven-logo-icon.png'}}" mode="aspectFit" />
      <text class="header-title">{{channel.name || 'NANO'}}</text>
    </view>
    <view class="header-divider"></view>
    <text class="header-user">{{isGuest ? t.guestHeaderName : (user.nickname || 'User')}}</text>
    <text wx:if="{{version}}" class="header-version">v{{version}}</text>
  </view>

  <!-- ── Sandbox banner ── -->
  <view wx:if="{{sandboxMode}}" class="sandbox-banner" catchtap="exitSandbox">
    <text class="sandbox-banner-text">{{sandboxBannerText}}</text>
    <text class="sandbox-banner-exit">{{t.exitSandbox}}</text>
  </view>

  <!-- ── Viva subscription expired banner ── -->
  <view wx:if="{{!sandboxMode && personaType === 'viva' && vivaSubscriptionExpired}}" class="viva-expired-banner" bindtap="handleBuyVivaSubscription">
    <text class="viva-expired-banner-text">{{t.vivaSubscriptionExpiredBanner}}</text>
    <text class="viva-expired-banner-btn">{{t.vivaSubscriptionRenewBtn}}</text>
  </view>

  <!-- ── Logo menu ── -->
  <view wx:if="{{menuOpen}}" class="menu-mask" bindtap="closeMenu">
    <view class="menu-dropdown" catchtap="noop" style="top: {{menuTop}}px;">
      <view wx:if="{{!isGuest && isAeviva && personaType === 'viva' && !vivaSubscriptionExpired && vivaSubscriptionExpiresAtDisplay}}" class="menu-credit-row" bindtap="openVivaRedeemSheet">
        <text class="menu-credit-label">{{lang === 'zh' ? 'Viva 订阅至' : 'Viva subscribed until'}}</text>
        <text class="menu-credit-value">{{vivaSubscriptionExpiresAtDisplay}}</text>
      </view>
      <view wx:if="{{!isGuest && isAeviva && personaType === 'viva' && !vivaSubscriptionExpired && vivaSubscriptionExpiresAtDisplay && creditBalance <= 0}}" class="menu-divider"></view>
      <view wx:if="{{!isGuest && creditBalance > 0}}" class="menu-credit-row" bindtap="openReferral">
        <text class="menu-credit-label">{{lang === 'zh' ? '积分余额' : 'Credits'}}</text>
        <text class="menu-credit-value">{{creditBalance}} pts</text>
      </view>
      <view wx:if="{{!isGuest && creditBalance > 0}}" class="menu-divider"></view>
      <view wx:if="{{isCoach}}" class="menu-item" bindtap="openCoach">
        <text class="menu-item-icon">👨‍⚕️</text>
        <text class="menu-item-label">{{t.coachMenu}}</text>
      </view>
      <view wx:if="{{isAdmin}}" class="menu-divider"></view>
      <view wx:if="{{isAdmin}}" class="menu-item" bindtap="openAdmin">
        <text class="menu-item-icon">⚙</text>
        <text class="menu-item-label">{{t.adminMenu}}</text>
      </view>
      <view wx:if="{{isSuperadmin}}" class="menu-divider"></view>
      <view wx:if="{{isSuperadmin}}" class="menu-item" bindtap="openSuperadmin">
        <text class="menu-item-icon">🌐</text>
        <text class="menu-item-label">{{t.superadminMenu}}</text>
      </view>
      <view wx:if="{{isSuperadmin}}" class="menu-item" bindtap="openWebAdmin">
        <text class="menu-item-icon">🖥</text>
        <text class="menu-item-label">{{t.webAdminMenu}}</text>
      </view>
      <view wx:if="{{!isGuest}}" class="menu-divider"></view>
      <view wx:if="{{!isGuest}}" class="menu-item" bindtap="openReferral">
        <text class="menu-item-icon">★</text>
        <text class="menu-item-label">{{t.referralMenu}}</text>
      </view>
      <view wx:if="{{!isGuest}}" class="menu-item" bindtap="openPhones">
        <text class="menu-item-icon">📱</text>
        <text class="menu-item-label">{{t.phonesMenu}}</text>
      </view>
      <view wx:if="{{!isGuest && isAeviva && personaType === 'viva'}}" class="menu-item" bindtap="openVivaRedeemSheet">
        <text class="menu-item-icon">✧</text>
        <text class="menu-item-label">{{t.vivaRedeemMenu}}</text>
      </view>
      <view wx:if="{{isAdmin || isSuperadmin}}" class="menu-divider"></view>
      <view wx:if="{{isAdmin || isSuperadmin}}" class="menu-item" bindtap="openKinoSim">
        <text class="menu-item-icon">⬡</text>
        <text class="menu-item-label">{{t.kinoSimMenu}}</text>
      </view>
      <view class="menu-divider"></view>
      <view class="menu-item" bindtap="toggleTheme">
        <text class="menu-item-icon">{{theme === 'dark' ? '☀' : '🌑'}}</text>
        <text class="menu-item-label">{{theme === 'dark' ? t.lightMode : t.darkMode}}</text>
      </view>
      <view class="menu-divider"></view>
      <!-- Text size. A stepper, not a .menu-item: setTextScale deliberately leaves menuOpen
           alone (every menu-item handler clears it), so you can tap through the levels and
           watch the text behind the menu resize. The four A glyphs keep hardcoded sizes on
           purpose — they advertise the choice, so they must not resize themselves. -->
      <view class="menu-fs-row">
        <text class="menu-item-icon">A</text>
        <text class="menu-item-label">{{t.textSizeMenu}}</text>
        <view class="menu-fs-steps">
          <view class="menu-fs-step {{textScale === 0 ? 'menu-fs-step-on' : ''}}" catchtap="setTextScale" data-level="0"><text class="menu-fs-a0">A</text></view>
          <view class="menu-fs-step {{textScale === 1 ? 'menu-fs-step-on' : ''}}" catchtap="setTextScale" data-level="1"><text class="menu-fs-a1">A</text></view>
          <view class="menu-fs-step {{textScale === 2 ? 'menu-fs-step-on' : ''}}" catchtap="setTextScale" data-level="2"><text class="menu-fs-a2">A</text></view>
          <view class="menu-fs-step {{textScale === 3 ? 'menu-fs-step-on' : ''}}" catchtap="setTextScale" data-level="3"><text class="menu-fs-a3">A</text></view>
        </view>
      </view>
      <view class="menu-divider"></view>
      <view class="menu-item" bindtap="toggleLang">
        <text class="menu-item-icon">{{lang === 'zh' ? '🇺🇸' : '🇨🇳'}}</text>
        <text class="menu-item-label">{{lang === 'zh' ? 'English' : '中文'}}</text>
      </view>
      <view class="menu-divider"></view>
      <view wx:if="{{!isGuest}}" class="menu-item" bindtap="handleLogout">
        <text class="menu-item-icon">↪</text>
        <text class="menu-item-label">{{sandboxMode ? t.exitSandbox : t.logout}}</text>
      </view>
      <view wx:if="{{isGuest}}" class="menu-item" bindtap="openGuestSheet">
        <text class="menu-item-icon">✦</text>
        <text class="menu-item-label">{{t.guestMenuSignUp}}</text>
      </view>
    </view>
  </view>

  <!-- ── Tab Content ── -->
  <view class="tab-content">

    <!-- ════ CHAT ════ -->
    <view class="chat-tab{{tab !== 'chat' ? ' tab-hidden' : ''}}"
          bindtouchstart="onTabTouchStart"
          bindtouchmove="onTabTouchMove"
          bindtouchend="onTabTouchEnd"
          bindtouchcancel="onTabTouchEnd">

      <scroll-view
        class="chat-messages"
        scroll-y="true"
        scroll-top="{{scrollTop}}"
        scroll-with-animation="false"
        enhanced="true"
        bounces="false"
        bindscrolltoupper="onScrollToUpper"
        scroll-into-view="{{scrollAnchor}}"
        refresher-enabled="{{hasMoreHistory}}"
        refresher-triggered="{{historyLoading}}"
        refresher-default-style="none"
        bindrefresherrefresh="_loadMoreHistory"
      >
        <view slot="refresher" class="chat-refresher">
          <view class="chat-refresher-spinner"></view>
        </view>
        <view class="chat-inner">

          <!-- history load-more / start indicator -->
          <view wx:if="{{hasMoreHistory}}" class="chat-history-load {{historyLoading ? 'chat-history-loading' : ''}}" bindtap="_loadMoreHistory">
            <view wx:if="{{historyLoading}}" class="chat-history-spinner-row">
              <view class="chat-history-spinner"></view>
              <text class="chat-history-text">{{t.chatHistoryLoading}}</text>
            </view>
            <text wx:else class="chat-history-text">{{t.chatHistoryLoadMore}}</text>
          </view>
          <view wx:elif="{{messages.length > 0}}" class="chat-history-start">
            <text class="chat-history-start-text">{{t.chatHistoryStart}}</text>
          </view>

          <!-- AI bubbles render as an array of typed SEGMENTS: prose runs go through <mp-html>,
               while designed cards (metric / takeaway / dots) are native page-scope views. They
               have to be, because mp-html is style-isolated and its tag-style is a flat per-tag
               inline-style map — no descendant selectors, no pseudo-elements, no .theme-light
               cascade reach inside it. See utils/markdown.js.
               Do NOT put a comment between any wx:if / wx:elif / wx:else pair below: a comment
               node breaks the chain and produces "Page not found" on Android. -->
          <block wx:for="{{messages}}" wx:key="id">
            <view wx:if="{{item.sep}}" class="msg-daysep"><text class="msg-daysep-text">{{item.sep}}</text></view>
            <view
              id="m{{item.id}}"
              class="msg-row {{item.role === 'user' ? 'msg-row-user' : 'msg-row-ai'}}"
            >
              <block wx:if="{{item.role === 'action'}}">
                <view
                  class="msg-action-card"
                  bindtap="handleMsgAction"
                  data-action="{{item.action}}"
                >
                  <text class="msg-action-label">{{item.label}}</text>
                  <text class="msg-action-arrow">›</text>
                </view>
              </block>
              <view wx:elif="{{item.role === 'coach'}}" class="message-bubble message-coach">
                <text class="msg-coach-label">Coach</text>
                <text class="msg-text" selectable="true">{{item.content}}</text>
              </view>
              <view wx:else class="message-bubble {{item.role === 'user' ? 'message-user' : 'message-ai'}} {{item.imageOnly ? 'msg-bubble-image' : ''}}">
                <image
                  wx:if="{{item.imageUrl}}"
                  class="msg-image {{item.imageOnly ? '' : 'msg-image-inset'}}"
                  src="{{item.imageUrl}}"
                  mode="widthFix"
                  show-menu-by-longpress="{{true}}"
                  data-id="{{item.id}}"
                  bindload="_onChatImageLoad"
                />
                <text wx:if="{{item.role === 'user' && item.content}}" class="msg-text" selectable="true">{{item.content}}</text>
                <!-- Attribution for a reply that came from the external Viva AG agent rather
                     than Viva itself. Same shape as the Coach label above. -->
                <text wx:if="{{item.source === 'viva_ag'}}" class="msg-ag-label">Viva AG</text>
                <block wx:if="{{item.role !== 'user'}}">
                  <view wx:for="{{item.segments}}" wx:for-item="seg" wx:for-index="si" wx:key="si" class="msg-seg">
                    <mp-html
                      wx:if="{{seg.t === 'html'}}"
                      class="msg-html"
                      content="{{seg.h}}"
                      tag-style="{{mdTagStyle}}"
                      container-style="padding:0"
                      selectable="{{true}}"
                      copy-link="{{false}}"
                      data-id="{{item.id}}"
                      bindlinktap="_onMdLinkTap"
                      bindready="_onSegReady"
                    />
                    <view wx:elif="{{seg.t === 'rule'}}" class="msg-rule"></view>
                    <view wx:elif="{{seg.t === 'metric'}}" class="mcard">
                      <view wx:for="{{seg.items}}" wx:for-item="mi" wx:for-index="mj" wx:key="mj" class="mcard-tile mcard-{{mi.s}}">
                        <text class="mcard-label">{{mi.label}}</text>
                        <view class="mcard-valrow">
                          <text class="mcard-val">{{mi.value}}</text>
                          <text wx:if="{{mi.unit}}" class="mcard-unit">{{mi.unit}}</text>
                          <view wx:if="{{mi.spark}}" class="spark spark-t-{{mi.spark.tone}}">
                            <view
                              wx:for="{{mi.spark.bars}}"
                              wx:for-item="sb"
                              wx:for-index="sk"
                              wx:key="sk"
                              class="spark-bar {{sb.last ? 'spark-bar-last' : ''}}"
                              style="height:{{sb.h}}%"
                            ></view>
                          </view>
                        </view>
                        <view wx:if="{{mi.sl || mi.spark}}" class="mcard-footrow">
                          <text wx:if="{{mi.sl}}" class="mcard-pill">{{mi.sl}}</text>
                          <text wx:if="{{mi.spark && mi.spark.delta}}" class="spark-delta spark-d-{{mi.spark.tone}}">{{mi.spark.arrow}}{{mi.spark.delta}}</text>
                        </view>
                      </view>
                    </view>
                    <view wx:elif="{{seg.t === 'takeaway'}}" class="tcard">
                      <text class="tcard-title">{{seg.title || t.mdTakeaway}}</text>
                      <mp-html
                        class="msg-html tcard-body"
                        content="{{seg.h}}"
                        tag-style="{{mdTagStyle}}"
                        container-style="padding:0"
                        selectable="{{true}}"
                        copy-link="{{false}}"
                        data-id="{{item.id}}"
                        bindlinktap="_onMdLinkTap"
                        bindready="_onSegReady"
                      />
                    </view>
                    <view wx:elif="{{seg.t === 'dots'}}" class="dcard">
                      <view wx:for="{{seg.items}}" wx:for-item="di" wx:for-index="dj" wx:key="dj" class="dcard-chip">
                        <text class="dcard-id">{{di.id}}</text>
                        <text wx:if="{{di.name}}" class="dcard-name">{{di.name}}</text>
                        <text wx:if="{{di.note}}" class="dcard-note">{{di.note}}</text>
                      </view>
                    </view>
                    <view wx:elif="{{seg.t === 'formula'}}" class="fcard">
                      <view class="fcard-head">
                        <text class="fcard-title">{{t.formulaCardTitle}}</text>
                        <text class="fcard-note">{{t.formulaEvalNote}}</text>
                      </view>
                      <view wx:for="{{seg.groups}}" wx:for-item="fg" wx:for-index="fgi" wx:key="days" class="fcard-group">
                        <view wx:if="{{fg.days}}" class="fcard-days">
                          <text class="fcard-daylabel">{{t.formulaDayWord}} {{fg.days}}</text>
                          <text wx:if="{{fg.kind === 'n7'}}" class="fcard-daytag">{{t.formulaResetDay}}</text>
                        </view>
                        <view class="fcard-row">
                          <text class="fcard-slot">{{t.formulaAm}}</text>
                          <view class="fcard-track">
                            <view
                              wx:for="{{fg.items}}"
                              wx:for-item="fi"
                              wx:for-index="fk"
                              wx:key="key"
                              class="fcard-seg"
                              style="width:{{fi.amPct}}%;background:{{fi.color}}"
                            ></view>
                          </view>
                          <text class="fcard-num">{{fg.am}}</text>
                        </view>
                        <view class="fcard-row">
                          <text class="fcard-slot">{{t.formulaPm}}</text>
                          <view class="fcard-track">
                            <view
                              wx:for="{{fg.items}}"
                              wx:for-item="fi"
                              wx:for-index="fk"
                              wx:key="key"
                              class="fcard-seg"
                              style="width:{{fi.pmPct}}%;background:{{fi.color}}"
                            ></view>
                          </view>
                          <text class="fcard-num">{{fg.pm}}</text>
                        </view>
                        <view class="fcard-legend">
                          <view wx:for="{{fg.items}}" wx:for-item="fi" wx:for-index="fk" wx:key="key" class="fcard-leg">
                            <view class="fcard-swatch" style="background:{{fi.color}}"></view>
                            <text class="fcard-leg-name">{{fi.name}}</text>
                            <text class="fcard-leg-num">{{fi.am}}·{{fi.pm}}</text>
                          </view>
                        </view>
                        <text class="fcard-foot">{{t.formulaTotalLabel}} {{fg.total}}</text>
                      </view>
                      <text wx:if="{{seg.cycleDays}}" class="fcard-cycle">{{seg.cycleDays}}{{t.formulaDaysUnit}} · {{seg.cycleCapsules}}{{t.formulaCapsulesUnit}}</text>
                      <view
                        wx:if="{{seg.labelUrl}}"
                        class="fcard-label"
                        bindtap="handleFormulaLabel"
                        data-url="{{seg.labelUrl}}"
                      >
                        <text>{{t.formulaLabelCta}}</text>
                      </view>
                      <view
                        wx:if="{{seg.planId && isAeviva && seg.orderMode === 'submit'}}"
                        class="fcard-cta"
                        bindtap="handleFormulaSubmit"
                        data-plan="{{seg.planId}}"
                      >
                        <text>{{t.formulaSubmitCta}}</text>
                      </view>
                      <view
                        wx:elif="{{seg.planId && isAeviva && seg.orderMode === 'buy'}}"
                        class="fcard-cta"
                        bindtap="handleFormulaOrder"
                        data-plan="{{seg.planId}}"
                      >
                        <text>{{t.formulaOrderCta}}</text>
                      </view>
                      <text wx:elif="{{seg.orderMode === 'ag'}}" class="fcard-agnote">{{t.formulaAgPending}}</text>
                    </view>
                    <view wx:elif="{{seg.t === 'product'}}" class="pcard">
                      <text class="pcard-title">{{t.productCardTitle}}</text>
                      <view
                        wx:for="{{seg.items}}"
                        wx:for-item="pi"
                        wx:for-index="pk"
                        wx:key="sku"
                        class="pcard-row"
                        bindtap="handleProductCardTap"
                        data-sku="{{pi.sku}}"
                      >
                        <view class="pcard-main">
                          <text class="pcard-name">{{pi.name}}</text>
                          <text wx:if="{{pi.reason}}" class="pcard-reason">{{pi.reason}}</text>
                        </view>
                        <text class="pcard-price">{{pi.price}}</text>
                        <text class="pcard-arrow">›</text>
                      </view>
                    </view>
                  </view>
                </block>
                <mp-html
                  wx:if="{{item.role !== 'user' && !item.segments && item.content}}"
                  class="msg-html"
                  content="{{item.content}}"
                  tag-style="{{mdTagStyle}}"
                  container-style="padding:0"
                  selectable="{{true}}"
                />
              </view>
            </view>
          </block>

          <view wx:if="{{typing}}" class="msg-row msg-row-ai">
            <view class="message-bubble message-ai typing-indicator">
              <view class="typing-dot"></view>
              <view class="typing-dot"></view>
              <view class="typing-dot"></view>
              <text wx:if="{{chatStatusText}}" class="typing-status-text">{{chatStatusText}}</text>
            </view>
          </view>

          <view style="height: 16rpx;"></view>
        </view>
      </scroll-view>

      <!-- Onboarding: text input -->
      <view wx:if="{{obQuestion && obQuestion.input_type === 'text'}}" class="ob-bar name-bar">
        <input
          class="ob-input"
          placeholder="{{obQuestion.config.placeholder_zh || obQuestion.config.placeholder_en || ''}}"
          placeholder-class="ob-ph"
          value="{{obName}}"
          bindinput="onObNameInput"
          bindconfirm="handleSubmitName"
          focus="{{tab === 'chat' && obQuestion.input_type === 'text'}}"
          adjust-position="true"
        />
        <view class="ob-confirm" bindtap="handleSubmitName">
          <text>{{t.confirm}}</text>
        </view>
      </view>

      <!-- Onboarding: button select -->
      <view wx:if="{{obQuestion && obQuestion.input_type === 'button_select' && !typing}}" class="ob-bar gender-bar">
        <view
          wx:for="{{obQuestion.config.options}}"
          wx:key="value"
          class="quick-btn"
          bindtap="handleSelectButton"
          data-value="{{item.value}}"
        >
          <text>{{lang === 'zh' ? item.label_zh : item.label_en}}</text>
        </view>
      </view>

      <!-- Onboarding: date picker -->
      <view wx:if="{{obQuestion && obQuestion.input_type === 'date_picker'}}" class="ob-bar birthday-bar">
        <picker
          mode="date"
          value="{{obBirthday}}"
          start="{{obQuestion.config.min_date || '1920-01-01'}}"
          end="{{obQuestion.config.max_date || '2099-12-31'}}"
          bindchange="onBirthdayChange"
        >
          <view class="picker-row">
            <text class="picker-val">{{obBirthday || t.selectBirthday}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
        <view class="ob-confirm {{obBirthday ? '' : 'ob-confirm-off'}}" bindtap="handleSubmitBirthday">
          <text>{{t.confirm}}</text>
        </view>
      </view>

      <!-- Onboarding: slider group -->
      <view wx:if="{{obQuestion && obQuestion.input_type === 'slider_group'}}" class="ob-bar body-bar">
        <view
          wx:for="{{obQuestion.config.sliders}}"
          wx:key="key"
          class="slider-row"
        >
          <view class="slider-labels">
            <text class="slider-key">{{lang === 'zh' ? item.label_zh : item.label_en}}</text>
            <view class="slider-value-wrap">
              <input
                class="slider-val-input"
                type="digit"
                value="{{obSliderDisplay[item.key] || obSliders[item.key]}}"
                bindblur="onSliderValueBlur"
                data-key="{{item.key}}" data-step="{{item.step}}" data-min="{{item.min}}" data-max="{{item.max}}"
              />
              <text class="slider-unit">{{item.unit}}</text>
            </view>
          </view>
          <view class="slider-control-row">
            <view class="slider-step-btn" bindtap="onSliderStep"
              data-key="{{item.key}}" data-step="{{item.step}}" data-min="{{item.min}}" data-max="{{item.max}}" data-dir="-1">−</view>
            <slider
              class="slider-input"
              min="{{item.min}}" max="{{item.max}}" value="{{obSliders[item.key]}}" step="{{item.step}}"
              activeColor="#6375EC" backgroundColor="#162E4A" block-color="#6375EC"
              bindchange="onSliderChange" bindchanging="onSliderChange"
              data-key="{{item.key}}" data-step="{{item.step}}"
              block-size="24"
            />
            <view class="slider-step-btn" bindtap="onSliderStep"
              data-key="{{item.key}}" data-step="{{item.step}}" data-min="{{item.min}}" data-max="{{item.max}}" data-dir="1">+</view>
          </view>
        </view>
        <view class="ob-confirm" bindtap="handleSubmitBody">
          <text>{{t.confirm}}</text>
        </view>
      </view>

      <!-- Onboarding: multi select -->
      <view wx:if="{{obQuestion && obQuestion.input_type === 'multi_select'}}" class="ob-bar conditions-bar">
        <view class="cond-chips">
          <view
            wx:for="{{obConditionList}}"
            wx:key="key"
            class="cond-chip {{item.selected ? 'cond-chip-on' : ''}}"
            bindtap="handleToggleCondition"
            data-key="{{item.key}}"
          >
            <text>{{item.label}}</text>
          </view>
        </view>
        <input
          wx:if="{{obOtherSelected}}"
          class="ob-input cond-other-input"
          placeholder="{{t.obConditionsOtherPh}}"
          placeholder-class="ob-ph"
          value="{{obConditionsOther}}"
          bindinput="onObConditionsOtherInput"
          focus="{{obOtherSelected}}"
          adjust-position="true"
        />
        <view class="ob-confirm" bindtap="handleSubmitConditions">
          <text>{{t.confirm}}</text>
        </view>
      </view>

      <!-- Kino chip scan button -->
      <view wx:if="{{kinoScanPending}}" class="ob-bar kino-scan-bar">
        <view class="kino-scan-btn" bindtap="handleKinoScan">
          <text class="kino-scan-icon">⬡</text>
          <text class="kino-scan-label">{{t.kinoScanBtn}}</text>
        </view>
        <view class="kino-scan-close" bindtap="cancelKinoScan">✕</view>
      </view>

      <!-- AI disclaimer -->
      <view wx:if="{{obStep === 'done' || isGuest}}" class="ai-disclaimer">
        <text class="ai-disclaimer-text">{{t.aiDisclaimer}}</text>
      </view>

      <!-- Normal chat input — also shown to guests, with the mic button replaced by
           a Sign-up CTA and send routed to the sign-up sheet instead of _req'ing chat -->
      <view wx:if="{{obStep === 'done' || isGuest}}" class="input-container">
        <toolbox wx:if="{{toolboxOpen}}" tools="{{toolList}}" disabled="{{typing}}" bind:toolaction="handleToolAction" />
        <view wx:if="{{isRecording}}" class="mic-recording-banner">
          <text class="mic-recording-dot"></text>
          <text class="mic-recording-text">{{t.micRecording}}</text>
        </view>
        <view class="input-area">
          <view class="plus-btn {{toolboxOpen ? 'plus-btn-open' : ''}}" bindtap="toggleToolbox">
            <text class="plus-icon">+</text>
          </view>
          <textarea
            class="chat-textarea"
            placeholder="{{t.inputPh}}"
            placeholder-class="textarea-ph"
            value="{{chatInput}}"
            bindinput="onChatInput"
            auto-height="true"
            maxlength="500"
            adjust-position="true"
            fixed="true"
            cursor-spacing="12"
            show-confirm-bar="false"
          />
          <view
            wx:if="{{!chatInput && !isGuest}}"
            class="mic-btn {{isRecording ? 'mic-btn-active' : ''}} {{typing || isSending ? 'mic-btn-disabled' : ''}}"
            bindtouchstart="onMicTouchStart"
            bindtouchend="onMicTouchEnd"
            bindtouchcancel="onMicTouchEnd"
          >
            <image class="mic-icon" src="/assets/icons/mic.svg" mode="aspectFit" />
          </view>
          <view wx:elif="{{!chatInput && isGuest}}" class="mic-btn guest-signup-btn" bindtap="openGuestSheet">
            <text class="guest-signup-btn-text">{{t.guestSignupBtn}}</text>
          </view>
          <view wx:elif="{{isGuest}}" class="send-btn send-active" bindtap="openGuestSheet">
            <text class="send-icon">↑</text>
          </view>
          <view wx:else class="send-btn {{chatInput ? 'send-active' : ''}}" bindtap="handleSend">
            <text class="send-icon">↑</text>
          </view>
        </view>
      </view>

    </view>
    <!-- end CHAT -->

    <!-- ════ HEALTH ════ -->
    <view class="health-tab{{tab !== 'health' ? ' tab-hidden' : ''}}">
      <user-health id="health-comp"
        user="{{user}}"
        user-id="{{user.user_id}}"
        lang="{{lang}}"
        mode="self"
        is-guest="{{isGuest}}"
        theme="{{theme}}"
        text-scale="{{textScale}}"
        viva-ag-enabled="{{vivaAgActive}}"
        bindchooseavatar="handleHealthChooseAvatar"
        bindguesttap="openGuestSheet"
        bind:gotochat="handleAgGoToChat"
        bind:textscalestep="onTextScaleStep"
        bind:profileUpdated="onProfileUpdated">
      </user-health>
    </view>
    <!-- end HEALTH -->

    <!-- ════ PLANS + DOTS ════ -->
    <view class="plans-tab{{tab !== 'plans' ? ' tab-hidden' : ''}}"
          bindtouchstart="onTabTouchStart"
          bindtouchmove="onTabTouchMove"
          bindtouchend="onTabTouchEnd"
          bindtouchcancel="onTabTouchEnd">

      <view class="inner-tab-bar">
        <view class="inner-tab {{plansDotsSubTab==='dots'?'inner-tab-active':''}}" bindtap="switchPlansDotsSubTab" data-tab="dots">
          <text class="inner-tab-text">{{t.plansDotsDotsTab}}</text>
        </view>
        <view class="inner-tab {{plansDotsSubTab==='plans'?'inner-tab-active':''}}" bindtap="switchPlansDotsSubTab" data-tab="plans">
          <text class="inner-tab-text">{{t.plansDotsPlanTab}}</text>
        </view>
      </view>

      <block wx:if="{{plansDotsSubTab==='plans'}}">
        <view wx:if="{{isGuest}}" class="guest-lock-card" bindtap="openGuestSheet">
          <text class="guest-lock-icon">🔒</text>
          <text class="guest-lock-text">{{t.guestLockMsg}}</text>
        </view>
        <view wx:elif="{{plansLoading}}" class="plans-loading">
          <text class="loading-dots">···</text>
        </view>
        <block wx:else>
          <scroll-view class="plans-scroll" scroll-y="true">

            <view class="plans-header">
              <text class="plans-title">{{t.plansTitle}}</text>
              <view class="plans-browse-btn" bindtap="openPlanBrowse">
                <text class="plans-browse-btn-text">+ {{t.plansBrowse}}</text>
              </view>
            </view>

            <view wx:if="{{activePlans.length === 0}}" class="plans-empty">
              <text class="plans-empty-text">{{t.plansEmpty}}</text>
              <view class="plans-browse-cta" bindtap="openPlanBrowse">
                <text class="plans-browse-cta-text">{{t.plansBrowse}}</text>
              </view>
            </view>

            <view wx:for="{{activePlans}}" wx:key="id" class="plan-card" bindtap="openPlanDetail" data-plan="{{item}}">
              <view class="plan-card-header">
                <view class="plan-type-badge plan-type-{{item.plan_type}}">
                  <text class="plan-type-text">{{item.plan_type === 'primary' ? t.plansPrimary : t.plansSecondary}}</text>
                </view>
                <text class="plan-card-name">{{lang === 'zh' ? item.name_zh : item.name_en}}</text>
              </view>
              <view class="plan-progress-bar-track">
                <view class="plan-progress-bar-fill" style="width: {{item.progressPct}}%;"></view>
              </view>
              <view class="plan-card-meta-row">
                <text class="plan-meta-item">{{t.plansAdherence}}: {{item.adherencePct}}%</text>
                <text class="plan-meta-item">{{item.weeksDone}}/{{item.totalWeeks}} {{t.plansWeeks}}</text>
              </view>
              <view class="plan-daily-section">
                <view class="plan-daily-tasks">
                  <view wx:for="{{item.todayTasks}}" wx:key="key" wx:for-item="task"
                        class="plan-task-chip {{task.done ? 'plan-task-done' : ''}}"
                        catchtap="handlePlanTask" data-plan-id="{{item.id}}" data-task="{{task.key}}">
                    <text class="plan-task-label">{{lang === 'zh' ? task.labelZh : task.labelEn}}</text>
                    <text class="plan-task-check">{{task.done ? '✓' : '○'}}</text>
                  </view>
                </view>
                <view class="plan-daily-bar-row">
                  <view class="plan-daily-bar-track">
                    <view class="plan-daily-bar-fill {{item.todayDoneCount === item.todayTasks.length ? 'plan-daily-complete' : ''}}"
                          style="width: {{item.todayProgressPct}}%;"></view>
                  </view>
                  <text class="plan-daily-count">{{item.todayDoneCount}}/{{item.todayTasks.length}} {{t.todayProgress}}</text>
                </view>
              </view>
            </view>

            <view wx:if="{{!plansLoading}}" class="reminders-section">
              <text class="reminders-section-title">{{t.remindersTitle}}</text>
              <view wx:if="{{remindersLoading}}" class="reminders-empty"><text class="reminder-date">···</text></view>
              <view wx:elif="{{upcomingReminders.length === 0}}" class="reminders-empty">
                <text class="reminder-date">{{t.remindersEmpty}}</text>
              </view>
              <view wx:for="{{upcomingReminders}}" wx:key="id" class="reminder-card">
                <view class="reminder-card-top">
                  <text class="reminder-content">{{item.content}}</text>
                  <view class="reminder-source-badge reminder-source-{{item.isCoach ? 'coach' : 'ai'}}">
                    <text class="reminder-source-text">{{item.isCoach ? t.reminderSourceCoach : t.reminderSourceAi}}</text>
                  </view>
                </view>
                <view class="reminder-card-bottom">
                  <text class="reminder-date">{{item.dateLabel}}</text>
                  <view wx:if="{{item.recurrenceLabel}}" class="reminder-recur-badge">
                    <text class="reminder-recur-text">{{item.recurrenceLabel}}</text>
                  </view>
                </view>
              </view>
            </view>

            <view style="height: 48rpx;"></view>
          </scroll-view>
        </block>
      </block>
      <scroll-view wx:elif="{{plansDotsSubTab==='dots'}}" scroll-y class="dots-subtab-scroll">

        <!-- Neo dispenser is not shipping yet, so the bind prompt is off behind neoAvailable
             (permanently false in data). Kept rather than deleted: nothing else about the
             dispenser changed, and this is the one entry point to it. -->
        <view wx:if="{{neoAvailable && !neoBound && !isGuest}}" class="guest-lock-card neo-bind-card" bindtap="handleBindNeoDevice">
          <text class="guest-lock-icon">⬢</text>
          <text class="guest-lock-title">{{t.neoBindTitle}}</text>
          <view class="guest-lock-btn"><text>{{t.neoBindBtn}}</text></view>
        </view>

        <view wx:if="{{neoBound && !isGuest}}" class="cart-section">
          <view class="cart-section-hdr">
            <text class="cart-section-title">{{t.cartridgeTitle}}</text>
            <view class="cart-sim-btn" bindtap="openCartSim">
              <text class="cart-sim-btn-icon">+</text>
            </view>
          </view>

          <view wx:if="{{cartridgesLoading}}" class="cart-loading">
            <view class="pulse-dot"></view>
            <view class="pulse-dot"></view>
            <view class="pulse-dot"></view>
          </view>

          <view wx:elif="{{cartridges.length > 0}}" class="cart-grid">
            <view
              wx:for="{{cartridges}}"
              wx:key="id"
              class="cart-slot{{item.isEmpty ? ' cart-slot-empty' : ''}}"
            >
              <view class="ink-bar-wrap">
                <view class="ink-bar-fill" style="height:{{item.percent}}%;background:{{item.barColor}};"></view>
              </view>
              <text class="cart-key">{{item.dotKey}}</text>
              <text class="cart-remaining">{{item.remaining}}</text>
            </view>
          </view>

          <view wx:else class="cart-empty">
            <text>{{t.noCartridges}}</text>
          </view>
        </view>

        <!-- ── My dots packages ────────────────────────────────────────────────────────────
             One row per journey, merged server-side from the GCN order and nano's own formula
             (handlers/dots.js, _mergeFormulationPackages). This is the whole point of the
             feature: where a user's capsules are, without opening the store webview.
             Above the order card, so "where are mine" reads before "buy another". -->
        <view wx:if="{{isAeviva && !isGuest && packages.length > 0}}" class="pkg-section">
          <text class="pkg-section-title">{{t.pkgSectionTitle}}</text>
          <view wx:for="{{packages}}" wx:key="key" class="pkg-card">
            <view class="pkg-card-hdr">
              <text class="pkg-name">{{item.name}}</text>
              <text class="pkg-stage pkg-stage-{{item.stage}}">{{item.stageLabel}}</text>
            </view>
            <text wx:if="{{item.meta}}" class="pkg-meta">{{item.meta}}</text>
            <view wx:if="{{item.tracking_number}}" class="pkg-track" catchtap="handleCopyPackageTracking" data-num="{{item.tracking_number}}">
              <text class="pkg-track-text">{{item.trackingLabel}}</text>
              <text class="pkg-track-copy">{{t.copy}}</text>
            </view>
            <view wx:if="{{item.can_submit && item.submit_plan_id}}" class="pkg-cta" catchtap="handlePackageSubmit" data-order="{{item.order_id}}" data-plan="{{item.submit_plan_id}}">
              <text class="pkg-cta-text">{{t.pkgUseFormulaBtn}}</text>
            </view>
            <text wx:elif="{{item.can_submit}}" class="pkg-hint">{{t.pkgNeedsFormulaHint}}</text>
            <view wx:elif="{{item.can_scan}}" class="pkg-cta pkg-cta-ghost" catchtap="handleScanBox">
              <text class="pkg-cta-text">{{t.pkgScanBtn}}</text>
            </view>
            <view wx:elif="{{item.can_order && item.plan_id}}" class="pkg-cta" catchtap="handleFormulaOrder" data-plan="{{item.plan_id}}">
              <text class="pkg-cta-text">{{t.pkgOrderBtn}}</text>
            </view>
          </view>
        </view>

        <!-- The one way into ordering dots from this tab, and it only ever offers the tool.
             Buying without a formula is a real flow (§28c parks the order at
             awaiting_formulation) but it hands the buyer back this same job one screen later, and
             once a formula DOES exist the package row above already carries 按此配方下单 — which
             is strictly better, because it names the plan and GCN prices that exact recipe.
             A second card next to it would be a worse route to the same product.

             Hidden while a package is in flight: GCN's formulation_already_in_progress guard
             would reject the purchase anyway. -->
        <view wx:if="{{!neoBound && isAeviva && !isGuest && !hasPackageInFlight && !hasProposedFormula}}" class="order-dots-card" bindtap="handleGoFormulate">
          <text class="order-dots-title">{{t.formulateFirstTitle}}</text>
          <text class="order-dots-detail">{{t.formulateFirstDetail}}</text>
          <view class="order-dots-btn"><text class="order-dots-btn-text">{{t.formulateFirstBtn}}</text></view>
        </view>

        <!-- Scan the box you received to start its 28-day cycle. Shown only to a real (non-guest)
             user on the Aeviva channel, where the AI Precision Nutrition flow actually exists. -->
        <view wx:if="{{isAeviva && !isGuest}}" class="scan-box-card" bindtap="handleScanBox">
          <view class="scan-box-main">
            <text class="scan-box-title">{{t.scanBoxTitle}}</text>
            <text class="scan-box-detail">{{t.scanBoxDetail}}</text>
          </view>
          <text class="scan-box-icon">⌗</text>
        </view>

        <view class="dots-header">
          <text class="dots-title">{{t.dotsTitle}}</text>
          <view class="dots-week-nav">
            <text class="dots-week-arrow {{!hasPrevWeek ? 'dots-week-arrow-disabled' : ''}}" catchtap="handleDotsPrevWeek">‹</text>
            <text wx:if="{{weekLabel}}" class="dots-week-label">{{weekLabel}}</text>
            <text class="dots-week-arrow {{!hasNextWeek ? 'dots-week-arrow-disabled' : ''}}" catchtap="handleDotsNextWeek">›</text>
          </view>
        </view>

        <view wx:if="{{isGuest}}" class="guest-lock-card" bindtap="openGuestSheet">
          <text class="guest-lock-icon">◉</text>
          <text class="guest-lock-title">{{t.guestDotsCta}}</text>
          <view class="guest-lock-btn"><text>{{t.guestJoinBtn}}</text></view>
        </view>
        <view wx:elif="{{dotsLoading}}" class="center-wrap">
          <view class="pulse-dot"></view>
          <view class="pulse-dot"></view>
          <view class="pulse-dot"></view>
        </view>
        <block wx:elif="{{dotsDays.length > 0}}">
          <scroll-view class="dots-scroll" scroll-x enhanced="{{true}}" show-scrollbar="{{false}}" scroll-left="{{todayScrollLeft}}">
            <view class="dots-days">
              <view
                wx:for="{{dotsDays}}"
                wx:key="label"
                class="day-card {{item.isToday ? 'day-today' : ''}}"
              >
                <text class="day-label">{{item.label}}</text>

                <view wx:if="{{item.morning.length > 0}}" class="meal-slot{{item.isToday && dispenseSlot === 'morning_cup' ? ' meal-slot-active' : ''}}">
                  <text class="meal-name">{{t.morning}}</text>
                  <view class="dot-chips">
                    <view
                      wx:for="{{item.morning}}"
                      wx:key="displayKey"
                      wx:for-item="dot"
                      class="dot-chip"
                    >
                      <view class="dot-swatch" style="background: {{dot.color}}"></view>
                      <text class="dot-key">{{dot.displayKey}}</text>
                      <text class="dot-count">×{{dot.count}}</text>
                    </view>
                  </view>
                </view>

                <view wx:if="{{item.evening.length > 0}}" class="meal-slot{{item.isToday && dispenseSlot === 'evening_cup' ? ' meal-slot-active' : ''}}">
                  <text class="meal-name">{{t.evening}}</text>
                  <view class="dot-chips">
                    <view
                      wx:for="{{item.evening}}"
                      wx:key="displayKey"
                      wx:for-item="dot"
                      class="dot-chip"
                    >
                      <view class="dot-swatch" style="background: {{dot.color}}"></view>
                      <text class="dot-key">{{dot.displayKey}}</text>
                      <text class="dot-count">×{{dot.count}}</text>
                    </view>
                  </view>
                </view>
              </view>
              <view style="width: 8rpx; flex-shrink: 0;"></view>
            </view>
          </scroll-view>

          <view wx:if="{{dispenseHasToday && neoBound}}" class="dispense-section">
            <view
              class="dispense-btn{{dispenseStatus === 'done' ? ' dispense-btn-done' : dispenseStatus === 'error' ? ' dispense-btn-error' : dispenseStatus === 'loading' ? ' dispense-btn-loading' : ''}}"
              bindtap="dispenseToday"
            >
              <view class="dispense-btn-gloss"></view>
              <text class="dispense-btn-text">{{dispenseStatus === 'loading' ? t.dispensing : dispenseStatus === 'done' ? t.dispenseOk : dispenseStatus === 'error' ? t.dispenseErr : t.dispenseBtn}}</text>
            </view>
          </view>
        </block>
        <view wx:elif="{{!dotsLoading}}" class="dots-empty">
          <text>{{t.noPlan}}</text>
        </view>

        <view style="height: 48rpx;"></view>
      </scroll-view>

    </view>
    <!-- end PLANS+DOTS -->

    <!-- Weight entry modal -->
    <view wx:if="{{planWeightOpen}}" class="modal-overlay" catchtouchmove="noop">
      <view class="modal-sheet" catchtap="noop" style="margin-bottom: {{planWeightKeyboard}}px;">
        <text class="modal-title">{{t.taskWeightTitle}}</text>
        <input class="modal-input" type="digit" placeholder="{{t.taskWeightPlaceholder}}"
               value="{{planWeightInput}}" bindinput="handleWeightInput"
               adjust-position="{{false}}" bindfocus="handleWeightFocus" bindblur="handleWeightBlur" />
        <view class="modal-actions">
          <view class="modal-btn modal-btn-cancel" bindtap="closeWeightTask"><text>{{t.taskWeightCancel}}</text></view>
          <view class="modal-btn modal-btn-confirm" bindtap="handleWeightSubmit"><text>{{t.taskWeightConfirm}}</text></view>
        </view>
      </view>
    </view>

    <!-- Daily questions modal -->
    <view wx:if="{{planQuestionsOpen}}" class="modal-overlay" catchtouchmove="noop">
      <view class="modal-sheet" catchtap="noop">
        <text class="modal-title">{{t.taskQuestionsTitle}}</text>
        <view class="q-row">
          <text class="q-label">{{t.taskQEnergy}}</text>
          <slider min="1" max="5" step="1" value="{{planQuestionsData.energy}}" show-value
                  bindchange="handleQuestionChange" data-key="energy" block-size="20" activeColor="#6375EC" />
        </view>
        <view class="q-row">
          <text class="q-label">{{t.taskQSleep}}</text>
          <slider min="1" max="5" step="1" value="{{planQuestionsData.sleep}}" show-value
                  bindchange="handleQuestionChange" data-key="sleep" block-size="20" activeColor="#6375EC" />
        </view>
        <view class="q-row">
          <text class="q-label">{{t.taskQMood}}</text>
          <slider min="1" max="5" step="1" value="{{planQuestionsData.mood}}" show-value
                  bindchange="handleQuestionChange" data-key="mood" block-size="20" activeColor="#6375EC" />
        </view>
        <view class="modal-actions">
          <view class="modal-btn modal-btn-cancel" bindtap="closeQuestionsTask"><text>{{t.taskQCancel}}</text></view>
          <view class="modal-btn modal-btn-confirm" bindtap="handleQuestionsSubmit"><text>{{t.taskQSubmit}}</text></view>
        </view>
      </view>
    </view>

    <!-- Plan Detail Sheet -->
    <view wx:if="{{planDetailOpen}}" class="overlay-mask" catchtouchmove="noop">
      <view class="overlay-panel" catchtap="noop">

        <view class="overlay-header">
          <text class="overlay-title">{{lang === 'zh' ? planDetailData.name_zh : planDetailData.name_en}}</text>
          <view class="overlay-close" bindtap="closePlanDetail"><text class="close-x">✕</text></view>
        </view>

        <!-- Sub-tab bar -->
        <view class="detail-tabs">
          <view class="detail-tab {{planSubTab === 'overview' ? 'detail-tab-active' : ''}}" bindtap="switchPlanSubTab" data-tab="overview">
            <text class="detail-tab-text">{{t.plansSubTabOverview}}</text>
          </view>
          <view class="detail-tab {{planSubTab === 'progress' ? 'detail-tab-active' : ''}}" bindtap="switchPlanSubTab" data-tab="progress">
            <text class="detail-tab-text">{{t.plansSubTabProgress}}</text>
          </view>
          <view class="detail-tab {{planSubTab === 'activities' ? 'detail-tab-active' : ''}}" bindtap="switchPlanSubTab" data-tab="activities">
            <text class="detail-tab-text">{{t.plansSubTabActivities}}</text>
          </view>
          <view class="detail-tab {{planSubTab === 'guidance' ? 'detail-tab-active' : ''}}" bindtap="switchPlanSubTab" data-tab="guidance">
            <text class="detail-tab-text">{{t.plansSubTabGuidance}}</text>
          </view>
        </view>

        <!-- Overview sub-tab -->
        <scroll-view wx:if="{{planSubTab === 'overview'}}" scroll-y class="overlay-scroll">
          <view class="plan-detail-section">
            <text class="plan-detail-label">{{t.plansGoal}}</text>
            <text class="plan-detail-value">{{lang === 'zh' ? planDetailData.goal_zh : planDetailData.goal_en}}</text>
          </view>
          <view class="plan-detail-section">
            <text class="plan-detail-label">{{t.plansStartDate}}</text>
            <text class="plan-detail-value">{{planDetailData.start_date}}</text>
          </view>
          <view class="plan-detail-section">
            <text class="plan-detail-label">{{t.plansDuration}}</text>
            <text class="plan-detail-value">{{planDetailData.totalWeeks}} {{t.plansWeeks}}</text>
          </view>
          <view wx:if="{{planDetailData.target_sub_ages && planDetailData.target_sub_ages.length > 0}}" class="plan-detail-section">
            <text class="plan-detail-label">{{t.plansTargetSubAges}}</text>
            <view class="plan-chips-row">
              <view wx:for="{{planDetailData.target_sub_ages}}" wx:key="*this" class="plan-chip">
                <text class="plan-chip-text">{{item}}</text>
              </view>
            </view>
          </view>
          <!-- Reminders -->
          <view class="plan-detail-section">
            <text class="plan-detail-label plan-section-label">{{t.planReminders}}</text>
            <view wx:if="{{!planDetailData.reminders || planDetailData.reminders.length === 0}}" class="plan-empty-hint">
              <text>{{t.planNoReminders}}</text>
            </view>
            <view wx:for="{{planDetailData.reminders}}" wx:key="id" class="plan-reminder-row">
              <view class="plan-reminder-info">
                <text class="plan-reminder-time">{{item.timeDisplay}}</text>
                <text class="plan-reminder-content">{{item.content}}</text>
              </view>
              <view class="plan-reminder-toggle {{item.status === 'paused' ? 'reminder-paused' : 'reminder-active'}}"
                    bindtap="handleTogglePlanReminder"
                    data-reminder-id="{{item.id}}"
                    data-current-status="{{item.status}}">
                <text>{{item.status === 'paused' ? t.planReminderResume : t.planReminderPause}}</text>
              </view>
            </view>
          </view>
          <!-- Committed formulation for this focus (see handleGetHealthPlanDetail's `formulation`
               field) — only present once Formulate Dots has actually run while this focus was
               active. Aeviva-only purchase CTA; other channels see the summary with no CTA. -->
          <view wx:if="{{planDetailData.formulation}}" class="plan-detail-section">
            <text class="plan-detail-label plan-section-label">{{t.formulationReadyTitle}}</text>
            <view class="plan-chips-row">
              <view wx:for="{{planDetailData.formulation.dot_breakdown}}" wx:key="key_name" class="plan-chip plan-chip-dot">
                <text class="plan-chip-text">{{lang === 'zh' ? item.name_zh : item.name}} ×{{item.total_count}}</text>
              </view>
            </view>
            <view wx:if="{{isAeviva}}" class="plan-action-btn plan-action-buy" bindtap="handleBuyFormulation">
              <text>{{t.buyFormulationBtn}}</text>
            </view>
          </view>
          <view wx:elif="{{isAeviva}}" class="plan-detail-section">
            <text class="plan-detail-label plan-section-label">{{t.formulationNotReadyTitle}}</text>
            <text class="plan-empty-hint">{{t.formulationNotReadyHint}}</text>
          </view>

          <!-- Actions -->
          <view class="plan-actions-row">
            <view class="plan-action-btn plan-action-switch" bindtap="handleSwitchPlanType" data-plan-id="{{planDetailData.id}}" data-current-type="{{planDetailData.plan_type}}">
              <text>{{t.plansSwitch}}</text>
            </view>
            <view class="plan-action-btn plan-action-abandon" bindtap="handleAbandonPlan" data-plan-id="{{planDetailData.id}}">
              <text>{{t.plansAbandon}}</text>
            </view>
          </view>
        </scroll-view>

        <scroll-view wx:elif="{{planSubTab === 'progress'}}" scroll-y class="overlay-scroll">
          <view class="plan-detail-section">
            <text class="plan-detail-label">{{t.plansAdherence}}</text>
            <text class="plan-detail-value">{{planDetailData.adherencePct}}% ({{planDetailData.checkin_count || 0}} {{lang === 'zh' ? '次打卡' : 'check-ins'}})</text>
          </view>
          <view class="plan-detail-section">
            <text class="plan-detail-label">{{t.plansWeeks}}</text>
            <text class="plan-detail-value">{{planDetailData.weeksDone}}/{{planDetailData.totalWeeks}}</text>
          </view>
          <view class="plan-detail-section">
            <text class="plan-detail-label">{{t.plansNoMilestones}}</text>
          </view>
        </scroll-view>

        <scroll-view wx:elif="{{planSubTab === 'activities'}}" scroll-y class="overlay-scroll">
          <view wx:if="{{eventsLoading}}" class="panel-center" style="padding:60rpx 0">
            <text class="empty-text">{{t.eventsLoading}}</text>
          </view>
          <view wx:elif="{{events.length === 0}}" class="panel-center" style="padding:60rpx 0">
            <text class="empty-text">{{t.eventsEmpty}}</text>
          </view>
          <view wx:else class="events-list">
            <view wx:for="{{events}}" wx:key="id" class="event-card">
              <view class="event-card-header">
                <text class="event-title">{{item.title}}</text>
                <view wx:if="{{mySignupEventIds.indexOf(item.id) > -1}}" class="event-badge-signed">
                  <text>{{t.eventsSignedUp}}</text>
                </view>
              </view>
              <text class="event-meta">📅 {{item.scheduled_at_display}}</text>
              <text wx:if="{{item.location}}" class="event-meta">📍 {{item.location}}</text>
              <text wx:if="{{item.description}}" class="event-desc">{{item.description}}</text>
              <text wx:if="{{item.capacity}}" class="event-meta">{{t.eventsCapacity}}: {{item.remaining}}/{{item.capacity}}</text>
              <view class="event-card-actions">
                <view wx:if="{{mySignupEventIds.indexOf(item.id) > -1}}"
                      class="event-btn event-btn-cancel"
                      catchtap="handleEventCancelSignup"
                      data-event-id="{{item.id}}">
                  <text>{{t.eventsCancel}}</text>
                </view>
                <view wx:elif="{{item.is_full}}"
                      class="event-btn event-btn-disabled">
                  <text>{{t.eventsFull}}</text>
                </view>
                <view wx:else
                      class="event-btn event-btn-signup"
                      catchtap="handleEventSignUp"
                      data-event-id="{{item.id}}">
                  <text>{{t.eventsSignUp}}</text>
                </view>
              </view>
            </view>
          </view>
        </scroll-view>

        <scroll-view wx:elif="{{planSubTab === 'guidance'}}" scroll-y class="overlay-scroll">
          <view class="plan-detail-section">
            <text class="plan-detail-value">{{lang === 'zh' ? (planDetailData.desc_zh || planDetailData.goal_zh) : (planDetailData.desc_en || planDetailData.goal_en)}}</text>
          </view>
          <view wx:if="{{planDetailData.recommended_dot_ids && planDetailData.recommended_dot_ids.length > 0}}" class="plan-detail-section">
            <text class="plan-detail-label">{{t.plansRecommendedDots}}</text>
            <view class="plan-chips-row">
              <view wx:for="{{planDetailData.recommended_dot_ids}}" wx:key="*this" class="plan-chip plan-chip-dot">
                <text class="plan-chip-text">DOT{{item}}</text>
              </view>
            </view>
          </view>
        </scroll-view>

      </view>
    </view>

    <!-- Plan Browse Sheet -->
    <view wx:if="{{planBrowseOpen}}" class="overlay-mask" catchtouchmove="noop">
      <view class="overlay-panel" catchtap="noop">
        <view class="overlay-header">
          <text class="overlay-title">{{t.plansTemplates}}</text>
          <view class="overlay-close" bindtap="closePlanBrowse"><text class="close-x">✕</text></view>
        </view>
        <scroll-view scroll-y class="overlay-scroll">
          <view wx:for="{{planTemplates}}" wx:key="id" class="browse-tpl-card">
            <text class="browse-tpl-name">{{lang === 'zh' ? item.name_zh : item.name_en}}</text>
            <text class="browse-tpl-goal">{{lang === 'zh' ? item.goal_zh : item.goal_en}}</text>
            <text class="browse-tpl-meta">{{item.duration_weeks}} {{t.plansWeeks}} · {{item.sub_ages_display}}</text>
            <view class="browse-tpl-actions">
              <view wx:if="{{item.alreadyEnrolled}}" class="browse-enrolled-badge">
                <text>{{t.plansAlreadyEnrolled}}</text>
              </view>
              <block wx:else>
                <view class="browse-join-btn{{item.canJoinPrimary ? '' : ' browse-join-disabled'}}" bindtap="{{item.canJoinPrimary ? 'handleJoinPlan' : 'noop'}}" data-template-id="{{item.id}}" data-plan-type="primary">
                  <text>{{t.plansJoinPrimary}}</text>
                </view>
                <view class="browse-join-btn browse-join-secondary{{item.canJoinSecondary ? '' : ' browse-join-disabled'}}" bindtap="{{item.canJoinSecondary ? 'handleJoinPlan' : 'noop'}}" data-template-id="{{item.id}}" data-plan-type="secondary">
                  <text>{{t.plansJoinSecondary}}</text>
                </view>
              </block>
            </view>
          </view>
          <view style="height: 48rpx;"></view>
        </scroll-view>
      </view>
    </view>

    <!-- ════ STORE ════ -->
    <view class="store-tab{{tab !== 'store' ? ' tab-hidden' : ''}}"
          bindtouchstart="onTabTouchStart"
          bindtouchmove="onTabTouchMove"
          bindtouchend="onTabTouchEnd"
          bindtouchcancel="onTabTouchEnd">

      <!-- Aeviva channel: tapping the Store tab button opens the GCN partner storefront
           as a separate navigated page instead (see main.js switchTab/_openAevivaStore)
           rather than showing it here inline — <web-view> doesn't reliably support an
           overlay back button when embedded inside this absolutely-positioned
           tab-switching container (confirmed by testing, not just theory), so `tab` is
           never actually set to 'store' for aeviva users and this section always renders
           the native store below for everyone. -->

      <view class="store-header">
        <text class="store-title">{{t.storeTitle}}</text>
        <view class="store-header-right">
          <view wx:if="{{!isGuest}}" class="store-credit-card">
            <view class="store-credit-card-glow"></view>
            <image class="store-credit-card-icon" src="/assets/icons/credits.svg" mode="aspectFit"/>
            <view class="store-credit-card-body">
              <view class="store-credit-card-amount-row">
                <text class="store-credit-card-num">{{creditBalance}}</text>
                <text class="store-credit-card-unit">pts</text>
              </view>
              <text class="store-credit-card-label">{{lang === 'zh' ? '我的积分' : 'MY CREDITS'}}</text>
            </view>
          </view>
          <view wx:if="{{cartCount > 0}}" class="store-cart-icon" bindtap="handleOpenCart">
            <text class="store-cart-badge">{{cartCount}}</text>
          </view>
        </view>
      </view>

      <!-- Subtab toggle -->
      <view wx:if="{{!storeLoading}}" class="store-subtab-row">
        <view class="store-subtab-btn{{storeSubTab === 'products' ? ' store-subtab-active' : ''}}" bindtap="switchStoreTab" data-tab="products">
          <text>{{t.storeSubProducts}}</text>
        </view>
        <view class="store-subtab-btn{{storeSubTab === 'orders' ? ' store-subtab-active' : ''}}" bindtap="switchStoreTab" data-tab="orders">
          <text>{{t.storeSubOrders}}</text>
        </view>
      </view>

      <!-- Loading -->
      <view wx:if="{{storeLoading}}" class="center-wrap">
        <view class="pulse-dot"></view>
        <view class="pulse-dot"></view>
        <view class="pulse-dot"></view>
      </view>

      <scroll-view wx:elif="{{storeSubTab === 'products' && storeItems.length > 0}}" class="store-scroll" scroll-y="true" refresher-enabled="{{true}}" refresher-triggered="{{storeRefreshing}}" bindrefresherrefresh="onStoreRefresh">
        <view class="store-list">
          <view wx:for="{{storeItems}}" wx:key="id" class="store-card">
            <view wx:if="{{item.tagLabel}}" class="store-tag">
              <text class="store-tag-text">{{item.tagLabel}}</text>
            </view>
            <text class="store-card-name">{{item.name}}</text>
            <rich-text wx:if="{{item.descIsHtml}}" class="store-card-desc store-card-desc-rich" nodes="{{item.desc}}"></rich-text>
            <text wx:else class="store-card-desc">{{item.desc}}</text>
            <view wx:if="{{item.variants && item.variants.length > 0}}" class="store-variants">
              <view
                wx:for="{{item.variants}}"
                wx:key="id"
                wx:for-item="variant"
                wx:for-index="vi"
                class="store-variant-pill{{item.selectedVariantId === variant.id ? ' store-variant-pill-active' : ''}}"
                bindtap="handleSelectVariant"
                data-item-id="{{item.id}}"
                data-variant-id="{{variant.id}}"
              >
                <text class="store-variant-label">{{variant.label}}</text>
              </view>
            </view>
            <view class="store-card-footer">
              <view wx:if="{{item.partnerPrice}}" class="store-price-wrap store-price-wrap-partner">
                <view class="store-partner-row">
                  <view class="store-partner-badge"><text class="store-partner-badge-text">{{t.storePartnerPrice}}</text></view>
                  <text class="store-price store-price-partner">{{item.partnerPrice}}</text>
                  <text class="store-unit">/ {{item.unit}}</text>
                </view>
                <text class="store-price-regular">{{item.price}}</text>
              </view>
              <view wx:else class="store-price-wrap">
                <text class="store-price">{{item.price}}</text>
                <text class="store-unit">/ {{item.unit}}</text>
              </view>
              <view wx:if="{{!cartMap[item.selectedVariantId || item.id]}}" class="store-buy-btn" bindtap="handleAddToCart" data-item="{{item}}">
                <text class="store-buy-label">{{t.storeAddToCart}}</text>
              </view>
              <view wx:else class="cart-stepper">
                <view class="stepper-btn" bindtap="handleCartQtyChange" data-id="{{item.selectedVariantId || item.id}}" data-delta="{{-1}}"><text class="stepper-sym">－</text></view>
                <text class="stepper-qty">{{cartMap[item.selectedVariantId || item.id]}}</text>
                <view class="stepper-btn" bindtap="handleCartQtyChange" data-id="{{item.selectedVariantId || item.id}}" data-delta="{{1}}"><text class="stepper-sym">＋</text></view>
              </view>
            </view>
          </view>
          <view style="height: {{cartCount > 0 ? '140rpx' : '32rpx'}};"></view>
        </view>
      </scroll-view>

      <view wx:elif="{{storeSubTab === 'products'}}" class="dots-empty">
        <text>{{t.storeEmpty}}</text>
      </view>

      <!-- Cart bottom bar -->
      <view wx:if="{{cartCount > 0 && storeSubTab === 'products' && !storeLoading}}" class="cart-bar" bindtap="handleOpenCart">
        <text class="cart-bar-label">{{t.storeCartTotal}} · {{cartCount}}{{t.storeCartItems}}</text>
        <view class="cart-bar-right">
          <text class="cart-bar-total">{{cartTotal}}</text>
          <view class="cart-bar-btn" catchtap="handleCheckout">
            <text class="cart-bar-btn-text">{{t.storeCartCheckout}}</text>
          </view>
        </view>
      </view>

      <!-- Orders subtab -->
      <scroll-view wx:if="{{!storeLoading && storeSubTab === 'orders' && storeOrders.length > 0}}" class="store-scroll" scroll-y="true" refresher-enabled="{{true}}" refresher-triggered="{{storeRefreshing}}" bindrefresherrefresh="onStoreRefresh">
        <view class="store-list">
          <view wx:for="{{storeOrders}}" wx:key="id" class="order-card">
            <view class="order-card-top">
              <text class="order-name">{{item.name}}</text>
              <view class="order-status order-status-{{item.status}}">
                <text>{{t.orderStatus[item.status] || item.status}}</text>
              </view>
            </view>
            <view class="order-card-mid">
              <text class="order-price">{{item.price}}</text>
              <text class="order-meta"> · {{item.unit}} · ×{{item.quantity}}</text>
            </view>
            <view class="order-date-row">
              <text class="order-date">{{item.createdAt}}</text>
            </view>
            
            <!-- Delivery Details -->
            <view wx:if="{{item.shippingName}}" class="order-delivery-info">
              <view class="delivery-row">
                <text class="delivery-label">{{lang === 'zh' ? '收货人' : 'Recipient'}}</text>
                <text class="delivery-val">{{item.shippingName}} ({{item.shippingPhone}})</text>
              </view>
              <view class="delivery-row">
                <text class="delivery-label">{{lang === 'zh' ? '收货地址' : 'Address'}}</text>
                <text class="delivery-val">{{item.shippingAddress}}</text>
              </view>
              
              <!-- Courier Tracking Details -->
              <view wx:if="{{item.trackingNumber}}" class="delivery-row tracking-section">
                <text class="delivery-label">{{lang === 'zh' ? '快递单号' : 'Tracking'}}</text>
                <view class="tracking-val-wrap">
                  <text class="delivery-val bold">{{item.shippingCarrier}} {{item.trackingNumber}}</text>
                  <view class="copy-badge" bindtap="handleCopyTracking" data-tracking="{{item.trackingNumber}}">
                    <text>{{lang === 'zh' ? '复制' : 'Copy'}}</text>
                  </view>
                </view>
              </view>
            </view>
            
            <!-- Actions Section -->
            <view wx:if="{{item.status === 'pending'}}" class="order-actions">
              <view class="cancel-order-btn" bindtap="handleCancelOrder" data-id="{{item.id}}">
                <text>{{lang === 'zh' ? '取消订单' : 'Cancel Order'}}</text>
              </view>
            </view>
          </view>
          <view style="height: 32rpx;"></view>
        </view>
      </scroll-view>

      <view wx:if="{{!storeLoading && storeSubTab === 'orders' && storeOrders.length === 0}}" class="dots-empty">
        <text>{{t.noOrders}}</text>
      </view>

      <!-- Cart modal -->
      <view wx:if="{{cartOpen}}" class="cart-overlay" catchtap="handleCloseCart">
        <view class="cart-sheet" catchtap="noop">
          <view class="cart-sheet-header">
            <text class="cart-sheet-title">{{t.storeCart}}</text>
            <view class="cart-close-btn" bindtap="handleCloseCart"><text class="cart-close-sym">✕</text></view>
          </view>
          <scroll-view class="cart-sheet-scroll" scroll-y="true">
            <view wx:if="{{cart.length === 0}}" class="cart-empty-row">
              <text class="cart-empty-text">{{t.storeCartEmpty}}</text>
            </view>
            <view wx:for="{{cart}}" wx:key="id" class="cart-item-row">
              <view class="cart-item-info">
                <text class="cart-item-name">{{item.name}}</text>
                <text class="cart-item-price">{{item.partnerPrice || item.price}} / {{item.unit}}</text>
              </view>
              <view class="cart-stepper cart-stepper-sm">
                <view class="stepper-btn" bindtap="handleCartQtyChange" data-id="{{item.id}}" data-delta="{{-1}}"><text class="stepper-sym">－</text></view>
                <text class="stepper-qty">{{item.quantity}}</text>
                <view class="stepper-btn" bindtap="handleCartQtyChange" data-id="{{item.id}}" data-delta="{{1}}"><text class="stepper-sym">＋</text></view>
              </view>
            </view>
            <view wx:if="{{cart.length > 0}}" class="checkout-addr-form">
              <view class="checkout-addr-hdr">
                <text class="checkout-addr-title">{{t.checkoutShippingTitle}}</text>
                <view class="checkout-wx-addr-btn" bindtap="fetchWechatAddress">
                  <text class="checkout-wx-addr-icon">📍</text>
                  <text class="checkout-wx-addr-text">{{t.checkoutWxAddress}}</text>
                </view>
              </view>
              <view class="checkout-addr-row">
                <text class="checkout-addr-label">{{t.checkoutName}}</text>
                <input class="checkout-addr-input" placeholder="{{t.checkoutNamePh}}" value="{{checkoutName}}" bindinput="handleCheckoutFieldInput" data-field="checkoutName" />
              </view>
              <view class="checkout-addr-row">
                <text class="checkout-addr-label">{{t.checkoutPhone}}</text>
                <input class="checkout-addr-input" placeholder="{{t.checkoutPhonePh}}" value="{{checkoutPhone}}" bindinput="handleCheckoutFieldInput" data-field="checkoutPhone" type="number" />
              </view>
              <view class="checkout-addr-row checkout-addr-row-tall">
                <text class="checkout-addr-label">{{t.checkoutAddress}}</text>
                <textarea class="checkout-addr-textarea" placeholder="{{t.checkoutAddressPh}}" value="{{checkoutAddress}}" bindinput="handleCheckoutFieldInput" data-field="checkoutAddress" auto-height />
              </view>
            </view>
          </scroll-view>
          <view class="cart-sheet-footer">
            <text class="cart-total-text">{{t.storeCartTotal}}  {{cartTotal}}</text>
            <view wx:if="{{cart.length > 0}}" class="cart-checkout-btn" bindtap="handleCheckout">
              <text class="cart-checkout-text">{{t.storeCartCheckout}}</text>
            </view>
          </view>
        </view>
      </view>

    </view>
    <!-- end STORE -->

    <!-- ════ LEARN (Academy + Wellness) ════ -->
    <view class="learn-tab{{tab !== 'learn' ? ' tab-hidden' : ''}}"
          bindtouchstart="onTabTouchStart"
          bindtouchmove="onTabTouchMove"
          bindtouchend="onTabTouchEnd"
          bindtouchcancel="onTabTouchEnd">

      <view class="inner-tab-bar">
        <view class="inner-tab {{learnSubTab==='academy'?'inner-tab-active':''}}" bindtap="switchLearnSubTab" data-tab="academy">
          <text class="inner-tab-text">{{t.learnAcademyTab}}</text>
        </view>
        <view class="inner-tab {{learnSubTab==='wellness'?'inner-tab-active':''}}" bindtap="switchLearnSubTab" data-tab="wellness">
          <text class="inner-tab-text">{{t.learnBoxTab}}</text>
        </view>
      </view>

      <scroll-view wx:if="{{learnSubTab==='academy'}}" scroll-y class="academy-subtab-scroll">
      <view class="training-tab">

        <view wx:if="{{trainingLoading}}" class="loading-row">
          <text class="loading-text">{{t.loading}}</text>
        </view>

        <block wx:elif="{{trainingView === 'list'}}">

          <view wx:if="{{trainingDashboard}}" class="academy-status-card">
            <view class="academy-card-glow-tl"></view>
            <view class="academy-card-glow-br"></view>

            <view class="academy-card-header">
              <text class="academy-card-header-label">{{lang === 'zh' ? '学院状态' : 'ACADEMY STATUS'}}</text>
              <view class="academy-card-tier-badge">
                <text class="academy-card-tier-text">{{trainingDashboard.tier}}</text>
              </view>
            </view>

            <view class="academy-card-hero">
              <text class="academy-card-credits-num">{{trainingDashboard.total_credits}}</text>
              <text class="academy-card-credits-label">{{lang === 'zh' ? '学分' : 'CREDITS'}}</text>
            </view>

            <view class="academy-card-divider"></view>

            <view class="academy-card-stats">
              <view class="academy-card-stat">
                <text class="academy-card-stat-num">{{trainingDashboard.completed_lessons}}</text>
                <text class="academy-card-stat-label">{{lang === 'zh' ? '完成课程' : 'LESSONS'}}</text>
              </view>
              <view class="academy-card-stat-sep"></view>
              <view class="academy-card-stat">
                <text class="academy-card-stat-num">{{trainingDashboard.certifications_count}}</text>
                <text class="academy-card-stat-label">{{lang === 'zh' ? '证书' : 'CERTS'}}</text>
              </view>
            </view>
          </view>

          <view wx:if="{{trainingPaths.length > 0}}" class="training-section-header" style="margin-top: 24rpx;">
            <text class="training-section-title">{{lang === 'zh' ? '学习路径' : 'Learning Paths'}}</text>
          </view>
          <view wx:for="{{trainingPaths}}" wx:key="id" class="training-path-card" bindtap="trainingOpenCourse" data-course="{{item}}">
            <view class="training-path-header">
              <text class="training-path-title">{{item.title}}</text>
              <text class="training-path-tier">{{item.tier}}</text>
            </view>
            <view wx:if="{{item.description}}" class="training-path-desc"><text>{{item.description}}</text></view>
            <view class="training-path-progress-bar">
              <view class="training-path-progress-fill" style="width: {{item._total > 0 ? (item._done / item._total * 100) : 0}}%;" />
            </view>
            <text class="training-path-progress-label">{{item._done}}/{{item._total}} {{lang === 'zh' ? '课程' : 'courses'}}</text>
          </view>

          <view class="training-section-header" style="margin-top: 28rpx;">
            <text class="training-section-title">{{t.training.courses}}</text>
          </view>
          <view wx:if="{{trainingCourses.length === 0}}" class="empty-state">
            <text class="empty-text">{{t.training.noTraining}}</text>
          </view>
          <view wx:for="{{trainingCourses}}" wx:key="id" class="training-course-card{{item._locked ? ' training-course-card-locked' : ''}}" bindtap="trainingOpenCourse" data-course="{{item}}">
            <view class="training-course-cover">
              <text class="training-course-cover-text">{{item.title}}</text>
              <view class="training-lesson-badge">
                <text class="training-lesson-badge-text">{{item._lessonCountLabel}}</text>
              </view>
              <view wx:if="{{item._locked}}" class="training-course-lock-badge">
                <text class="training-course-lock-icon">🔒</text>
              </view>
            </view>
            <view class="training-course-body">
              <view class="training-course-meta">
                <text class="training-course-title">{{item.title}}</text>
                <text wx:if="{{item.description}}" class="training-course-desc">{{item.description}}</text>
                <view class="training-course-meta-row">
                  <text class="training-course-level">{{item.level}}</text>
                  <text class="training-course-credits">+{{item.credit_value}} {{lang === 'zh' ? '学分' : 'cr'}}</text>
                </view>
                <text wx:if="{{item._locked && item.prerequisite_title}}" class="training-course-prereq-hint">
                  {{lang === 'zh' ? '前置：' : 'Requires: '}}{{item.prerequisite_title}}
                </text>
              </view>
            </view>
          </view>

          <view wx:if="{{trainingCertifications.length > 0}}" class="training-section-header" style="margin-top: 28rpx;">
            <text class="training-section-title">{{lang === 'zh' ? '我的证书' : 'My Certifications'}}</text>
          </view>
          <view wx:for="{{trainingCertifications}}" wx:key="id" class="training-cert-card" bindtap="showCertDetail" data-cert="{{item}}">
            <text class="training-cert-icon">🏅</text>
            <view class="training-cert-info">
              <text class="training-cert-title">{{item.title}}</text>
              <text wx:if="{{item.tier}}" class="training-cert-tier">{{item.tier}}</text>
            </view>
            <text class="training-cert-chevron">›</text>
          </view>

          <!-- Certificate detail overlay -->
          <view wx:if="{{showCertDetail}}" class="cert-overlay" catchtap="hideCertDetail">
            <view class="cert-detail-card" catchtap="noop">
              <view class="cert-detail-header">
                <view class="cert-status-badge">
                  <text class="cert-status-check">✓</text>
                  <text class="cert-status-text">{{lang === 'zh' ? '证书有效' : 'Certificate Valid'}}</text>
                </view>
                <view class="cert-close-btn" bindtap="hideCertDetail">✕</view>
              </view>

              <view wx:if="{{certDetailItem.templateImageUrl}}" class="cert-bg-wrap">
                <image src="{{certDetailItem.templateImageUrl}}" class="cert-bg-preview" mode="widthFix" />
              </view>

              <view class="cert-field-list">
                <view class="cert-field">
                  <text class="cert-label">{{lang === 'zh' ? '姓名' : 'Name'}}</text>
                  <text class="cert-value">{{certDetailItem._userName || user.nickname || '—'}}</text>
                </view>
                <view class="cert-field">
                  <text class="cert-label">{{lang === 'zh' ? '学员编号' : 'Student ID'}}</text>
                  <text class="cert-value cert-mono">{{certDetailItem.user_id || '—'}}</text>
                </view>
                <view wx:if="{{certDetailItem.course_display_name}}" class="cert-field">
                  <text class="cert-label">{{lang === 'zh' ? '课程名称' : 'Course'}}</text>
                  <text class="cert-value">{{certDetailItem.course_display_name}}</text>
                </view>
                <view class="cert-field">
                  <text class="cert-label">{{lang === 'zh' ? '证书名称' : 'Certificate'}}</text>
                  <text class="cert-value">{{certDetailItem.title}}</text>
                </view>
                <view wx:if="{{certDetailItem.certificate_number}}" class="cert-field">
                  <text class="cert-label">{{lang === 'zh' ? '证书编号' : 'Cert No.'}}</text>
                  <text class="cert-value cert-mono cert-number">{{certDetailItem.certificate_number}}</text>
                </view>
                <view wx:if="{{certDetailItem.assessment_period}}" class="cert-field">
                  <text class="cert-label">{{lang === 'zh' ? '考核时间' : 'Assessment'}}</text>
                  <text class="cert-value">{{certDetailItem.assessment_period}}</text>
                </view>
                <view wx:if="{{certDetailItem.score != null}}" class="cert-field">
                  <text class="cert-label">{{lang === 'zh' ? '考试分数' : 'Score'}}</text>
                  <text class="cert-value">{{certDetailItem.score}}</text>
                </view>
                <view class="cert-field">
                  <text class="cert-label">{{lang === 'zh' ? '证书状态' : 'Status'}}</text>
                  <text class="cert-value cert-valid">{{lang === 'zh' ? '有效' : 'Valid'}}</text>
                </view>
                <view wx:if="{{certDetailItem.issuing_org}}" class="cert-field">
                  <text class="cert-label">{{lang === 'zh' ? '颁发机构' : 'Issuing Org'}}</text>
                  <text class="cert-value">{{certDetailItem.issuing_org}}</text>
                </view>
                <view wx:if="{{certDetailItem.school_org}}" class="cert-field">
                  <text class="cert-label">{{lang === 'zh' ? '办学机构' : 'Institute'}}</text>
                  <text class="cert-value">{{certDetailItem.school_org}}</text>
                </view>
                <view wx:if="{{certDetailItem.issueDateDisplay}}" class="cert-field">
                  <text class="cert-label">{{lang === 'zh' ? '颁发时间' : 'Issue Date'}}</text>
                  <text class="cert-value">{{certDetailItem.issueDateDisplay}}</text>
                </view>
                <view wx:if="{{certDetailItem.expiryDateDisplay}}" class="cert-field">
                  <text class="cert-label">{{lang === 'zh' ? '有效期至' : 'Expires'}}</text>
                  <text class="cert-value">{{certDetailItem.expiryDateDisplay}}</text>
                </view>
              </view>

              <view wx:if="{{certDetailItem.cert_oss_key}}" class="cert-download-btn" bindtap="downloadCert" data-key="{{certDetailItem.cert_oss_key}}">
                <text>↓ {{lang === 'zh' ? '下载电子证书' : 'Download Certificate'}}</text>
              </view>
            </view>
          </view>

          <view class="training-section-header" style="margin-top: 28rpx;">
            <text class="training-section-title">{{t.training.library}}</text>
          </view>
          <view wx:if="{{trainingLibrary.length === 0}}" class="empty-state">
            <text class="empty-text">{{t.training.noLibrary}}</text>
          </view>
          <view wx:for="{{trainingLibrary}}" wx:key="id" class="training-library-row" bindtap="trainingOpenLibraryItem" data-item="{{item}}">
            <text class="training-library-icon">📄</text>
            <text class="training-library-title">{{item.title}}</text>
            <text class="training-library-chevron">›</text>
          </view>
        </block>

        <block wx:elif="{{trainingView === 'lessons'}}">
          <view class="training-back-row" bindtap="trainingBackToList">
            <text class="training-back-text">{{t.training.backToCourses}}</text>
          </view>
          <view class="training-course-header">
            <text class="training-course-header-title">{{trainingCurrentCourse.title}}</text>
            <text wx:if="{{trainingCurrentCourse.description}}" class="training-course-header-desc">{{trainingCurrentCourse.description}}</text>
            <view class="training-course-meta-row" style="margin-top: 8rpx;">
              <text class="training-course-level">{{trainingCurrentCourse.level}}</text>
              <text class="training-course-credits">+{{trainingCurrentCourse.credit_value}} {{lang === 'zh' ? '学分' : 'cr'}}</text>
            </view>
          </view>
          <view wx:if="{{trainingLessons.length === 0}}" class="empty-state" style="margin-top: 40rpx;">
            <text class="empty-text">{{t.training.noLessons}}</text>
          </view>
          <view wx:for="{{trainingLessons}}" wx:key="id" class="training-lesson-row" bindtap="trainingOpenLesson" data-lesson="{{item}}">
            <view class="training-lesson-num">
              <text class="training-lesson-num-text">{{index + 1}}</text>
            </view>
            <view class="training-lesson-info">
              <text class="training-lesson-title">{{item.title}}</text>
              <text wx:if="{{item.description}}" class="training-lesson-desc">{{item.description}}</text>
              <view class="training-lesson-meta-row">
                <text class="training-lesson-type-badge">{{item.content_type === 'video' ? '🎬' : item.content_type === 'text' ? '📄' : '🧩'}}</text>
                <text class="training-lesson-credits-label">+{{item.credit_value}} {{lang === 'zh' ? '学分' : 'cr'}}</text>
                <text wx:if="{{item.has_quiz}}" class="training-lesson-quiz-badge">📝 {{lang === 'zh' ? '含测验' : 'Quiz'}}</text>
              </view>
            </view>
            <view wx:if="{{trainingCompletedIds.indexOf(item.id) !== -1}}" class="training-lesson-done">
              <text class="training-lesson-done-text">✓</text>
            </view>
            <text wx:else class="training-lesson-chevron">›</text>
          </view>
        </block>

        <block wx:elif="{{trainingView === 'player'}}">
          <view class="training-back-row" bindtap="trainingBackToLessons">
            <text class="training-back-text">{{t.training.backToLessons}}</text>
          </view>

          <block wx:if="{{trainingCurrentLesson.content_type === 'video' || !trainingCurrentLesson.content_type}}">
            <view class="training-video-container">
              <video wx:if="{{trainingVideoUrl}}" class="training-video" src="{{trainingVideoUrl}}"
                controls show-fullscreen-btn enable-progress-gesture object-fit="contain" />
              <view wx:else class="training-video-loading">
                <text class="training-video-loading-text">{{t.loading}}</text>
              </view>
            </view>
          </block>

          <block wx:elif="{{trainingCurrentLesson.content_type === 'text' || trainingCurrentLesson.content_type === 'interactive'}}">
            <view class="training-text-content">
              <text class="training-text-body">{{trainingTextContent || t.loading}}</text>
            </view>
          </block>

          <view class="training-lesson-detail">
            <text class="training-lesson-detail-title">{{trainingCurrentLesson.title}}</text>
            <text wx:if="{{trainingCurrentLesson.description}}" class="training-lesson-detail-desc">{{trainingCurrentLesson.description}}</text>

            <view wx:if="{{trainingQuizQuestions.length > 0}}" class="training-quiz-section">
              <text class="training-quiz-title">{{lang === 'zh' ? '📝 课后测验' : '📝 Quiz'}}</text>

              <view wx:if="{{trainingQuizResult}}" class="training-quiz-result {{trainingQuizResult.passed ? 'training-quiz-passed' : 'training-quiz-failed'}}">
                <text class="training-quiz-result-score">{{trainingQuizResult.score}}%</text>
                <text class="training-quiz-result-label">{{trainingQuizResult.passed ? (lang === 'zh' ? '通过！' : 'Passed!') : (lang === 'zh' ? '未通过，请重试' : 'Not passed, try again')}}</text>
                <text wx:if="{{trainingQuizResult.credits_earned > 0}}" class="training-quiz-result-credits">+{{trainingQuizResult.credits_earned}} {{lang === 'zh' ? '学分' : 'credits'}}</text>
                <view wx:if="{{trainingQuizReview.length > 0}}" class="training-quiz-review">
                  <view wx:for="{{trainingQuizReview}}" wx:key="index" class="training-quiz-review-item{{item.is_correct ? ' training-quiz-review-correct' : ' training-quiz-review-wrong'}}">
                    <text class="training-quiz-review-icon">{{item.is_correct ? '✓' : '✗'}}</text>
                    <view class="training-quiz-review-body">
                      <text class="training-quiz-review-q">{{item.question}}</text>
                      <text wx:if="{{!item.is_correct}}" class="training-quiz-review-your-ans">{{lang === 'zh' ? '你的答案：' : 'Your answer: '}}{{item.user_answer}}</text>
                      <text class="training-quiz-review-correct-ans">{{lang === 'zh' ? '正确答案：' : 'Correct: '}}{{item.correct_answer}}</text>
                      <text wx:if="{{item.explanation}}" class="training-quiz-review-explanation">{{item.explanation}}</text>
                    </view>
                  </view>
                </view>
              </view>

              <block wx:if="{{!trainingQuizResult || !trainingQuizResult.passed}}">
                <view wx:for="{{trainingQuizQuestions}}" wx:key="id" class="training-quiz-question">
                  <text wx:if="{{item.scenario}}" class="training-quiz-scenario">{{item.scenario}}</text>
                  <text class="training-quiz-q-text">{{index + 1}}. {{item.question}}</text>
                  <view wx:for="{{item.options}}" wx:for-item="opt" wx:for-index="oi" wx:key="oi"
                    class="training-quiz-option {{trainingQuizAnswers[item.id] === oi ? 'training-quiz-option-selected' : ''}}"
                    bindtap="trainingSelectAnswer" data-question-id="{{item.id}}" data-option-index="{{oi}}">
                    <view class="training-quiz-option-radio {{trainingQuizAnswers[item.id] === oi ? 'training-quiz-option-radio-checked' : ''}}" />
                    <text class="training-quiz-option-text">{{opt.text}}</text>
                  </view>
                </view>
                <view class="training-quiz-submit-btn {{trainingQuizSubmitting ? 'training-mark-btn-busy' : ''}}" bindtap="trainingSubmitQuiz">
                  <text class="training-mark-btn-text">{{trainingQuizSubmitting ? t.loading : (lang === 'zh' ? '提交答案' : 'Submit Answers')}}</text>
                </view>
              </block>
            </view>

            <view wx:if="{{trainingCompletedIds.indexOf(trainingCurrentLesson.id) !== -1}}" class="training-completed-badge">
              <text class="training-completed-badge-text">{{t.training.markedComplete}}</text>
            </view>
            <view wx:elif="{{trainingQuizQuestions.length === 0}}"
              class="training-mark-btn {{trainingMarkingComplete ? 'training-mark-btn-busy' : ''}}"
              bindtap="trainingMarkComplete">
              <text class="training-mark-btn-text">{{trainingMarkingComplete ? t.loading : t.training.markComplete}}</text>
            </view>
            <view wx:elif="{{trainingQuizResult && trainingQuizResult.passed}}"
              class="training-mark-btn {{trainingMarkingComplete ? 'training-mark-btn-busy' : ''}}"
              bindtap="trainingMarkComplete">
              <text class="training-mark-btn-text">{{trainingMarkingComplete ? t.loading : t.training.markComplete}}</text>
            </view>
          </view>
        </block>

        <block wx:elif="{{trainingView === 'library-viewer'}}">
          <view class="training-back-row" bindtap="trainingBackToList">
            <text class="training-back-text">{{t.training.backToCourses}}</text>
          </view>
          <view class="training-library-header">
            <text class="training-library-header-title">{{trainingCurrentLibraryItem.title}}</text>
          </view>
          <view class="training-library-content-scroll">
            <text class="training-library-content-text">{{trainingLibraryContent || t.loading}}</text>
          </view>
        </block>

      </view>
      </scroll-view>
      <scroll-view wx:elif="{{learnSubTab==='wellness'}}" scroll-y class="wellness-subtab-scroll">
        <view wx:if="{{wellnessLoading}}" class="wellness-loading">
          <view class="pulse-dot"></view><view class="pulse-dot"></view><view class="pulse-dot"></view>
        </view>

        <view wx:if="{{!wellnessLoading}}">

          <view wx:if="{{wellnessAssets.length === 0 && !deviceApkUrl}}" class="wellness-empty" style="padding:60rpx 28rpx;">
            <text class="wellness-empty-text">{{t.wellnessEmpty}}</text>
          </view>

          <view wx:for="{{wellnessAssets}}" wx:key="id" class="wellness-section" style="padding-bottom:0;">
            <view wx:if="{{item.mediaType === 'audio'}}" class="sleep-track-card" bindtap="playAudioAsset" data-track="{{item}}">
              <view class="sleep-track-icon">
                <text class="sleep-icon-glyph">{{sleepCurrentTrack.id === item.id && sleepPlaying ? '⏸' : '▶'}}</text>
              </view>
              <view class="sleep-track-info">
                <text class="sleep-track-name">{{item.title_zh || item.title}}</text>
                <text wx:if="{{item.duration_seconds}}" class="sleep-track-dur">{{item.duration_seconds >= 60 ? (item.duration_seconds / 60 | 0) + ' 分钟' : item.duration_seconds + ' 秒'}}</text>
              </view>
              <view wx:if="{{sleepCurrentTrack.id === item.id}}" class="sleep-track-active-dot"></view>
            </view>
            <view wx:elif="{{item.mediaType === 'video'}}" class="media-asset-card" bindtap="openMediaAsset" data-asset="{{item}}">
              <view class="media-asset-icon media-asset-icon--video">
                <text class="media-asset-glyph">▶</text>
              </view>
              <view class="media-asset-info">
                <text class="media-asset-name">{{item.title_zh || item.title}}</text>
                <text wx:if="{{item.duration_seconds}}" class="media-asset-sub">{{item.duration_seconds >= 60 ? (item.duration_seconds / 60 | 0) + ' 分钟' : item.duration_seconds + ' 秒'}}</text>
              </view>
              <view class="media-asset-btn">
                <text class="media-asset-btn-text">{{t.wellnessOpenLink}}</text>
              </view>
            </view>
            <view wx:else class="media-asset-card" bindtap="openMediaAsset" data-asset="{{item}}">
              <view class="media-asset-icon media-asset-icon--doc">
                <text class="media-asset-glyph">↓</text>
              </view>
              <view class="media-asset-info">
                <text class="media-asset-name">{{item.title_zh || item.title}}</text>
              </view>
              <view class="media-asset-btn">
                <text class="media-asset-btn-text">{{t.wellnessOpenLink}}</text>
              </view>
            </view>
          </view>

          <view wx:if="{{sleepCurrentTrack}}" class="sleep-now-playing" style="margin:16rpx 28rpx 0;">
            <view class="sleep-np-info">
              <text class="sleep-np-label">{{t.nowPlaying}}</text>
              <text class="sleep-np-title">{{sleepCurrentTrack.title_zh || sleepCurrentTrack.title}}</text>
            </view>
            <view class="sleep-np-controls">
              <view class="sleep-np-btn" bindtap="stopAudioAsset">
                <text class="sleep-np-btn-icon">⏹</text>
              </view>
            </view>
          </view>

        </view>
      </scroll-view>

    </view>
    <!-- Floating back button for library-viewer — fixed so it stays visible while scrolling -->
    <view wx:if="{{tab === 'learn' && learnSubTab === 'academy' && trainingView === 'library-viewer'}}" class="library-float-back" bindtap="trainingBackToList">
      <text class="library-float-back-arrow">‹</text>
      <text class="library-float-back-label">{{t.training.backToCourses}}</text>
    </view>
    <!-- end LEARN -->

  </view>
  <!-- end tab-content -->

  <!-- ── Cartridge Sim Overlay ── -->
  <view wx:if="{{simCartOpen}}" class="csim-overlay" bindtap="closeCartSim">
    <view class="csim-sheet" catchtap="noop">
      <view class="csim-handle"></view>
      <text class="csim-title">{{t.simCartTitle}}</text>
      <text class="csim-subtitle">{{t.simCartSubtitle}}</text>

      <view class="csim-sets">
        <view
          wx:for="{{simCartSets}}"
          wx:key="key"
          class="csim-set-card"
          style="border-color: {{item.color}}22;"
          bindtap="{{simCartLoading ? '' : 'handleSelectCartSet'}}"
          data-dots-raw="{{item.dots_raw}}"
        >
          <view class="csim-set-accent" style="background: {{item.color}};"></view>
          <view class="csim-set-body">
            <text class="csim-set-name">{{item.name}}</text>
            <text class="csim-set-desc">{{item.desc}}</text>
            <view class="csim-dot-badges">
              <view
                wx:for="{{item.dotItems}}"
                wx:key="displayKey"
                wx:for-item="di"
                class="csim-dot-badge"
              >
                <text class="csim-badge-key" style="color:{{item.color}};">{{di.displayKey}}</text>
                <text class="csim-badge-name">{{di.dotName}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{simCartLoading}}" class="csim-loading">
        <view class="pulse-dot"></view><view class="pulse-dot"></view><view class="pulse-dot"></view>
      </view>

      <view class="csim-cancel" bindtap="closeCartSim">
        <text>{{t.simCartCancel}}</text>
      </view>
    </view>
  </view>

  <!-- ── Kino Passcode Overlay ── -->
  <view wx:if="{{kinoPassOpen}}" class="kpass-overlay">
    <view class="kpass-box" style="margin-top: {{statusBarHeight + 44}}px;">

      <view class="kpass-logo">⬡</view>
      <text class="kpass-title">{{t.kinoSimPassTitle}}</text>

      <!-- 4-dot indicator -->
      <view class="kpass-dots">
        <view class="kpass-dot {{kinoPassInput.length > 0 ? 'kpass-dot-filled' : ''}} {{kinoPassError ? 'kpass-dot-error' : ''}}"></view>
        <view class="kpass-dot {{kinoPassInput.length > 1 ? 'kpass-dot-filled' : ''}} {{kinoPassError ? 'kpass-dot-error' : ''}}"></view>
        <view class="kpass-dot {{kinoPassInput.length > 2 ? 'kpass-dot-filled' : ''}} {{kinoPassError ? 'kpass-dot-error' : ''}}"></view>
        <view class="kpass-dot {{kinoPassInput.length > 3 ? 'kpass-dot-filled' : ''}} {{kinoPassError ? 'kpass-dot-error' : ''}}"></view>
      </view>

      <text wx:if="{{kinoPassError}}" class="kpass-error">{{t.kinoSimPassError}}</text>
      <view wx:else style="height: 36rpx;"></view>

      <!-- Numpad -->
      <view class="kpass-numpad">
        <view wx:for="{{[1,2,3,4,5,6,7,8,9]}}" wx:key="*this"
          class="kpass-key" bindtap="handlePassKey" data-digit="{{item}}">
          <text>{{item}}</text>
        </view>
        <view class="kpass-key kpass-key-empty"></view>
        <view class="kpass-key" bindtap="handlePassKey" data-digit="0"><text>0</text></view>
        <view class="kpass-key kpass-key-del" bindtap="handlePassDelete">
          <text class="kpass-del-icon">⌫</text>
        </view>
      </view>

      <view class="kpass-cancel" bindtap="closeKinoPass">
        <text>{{t.logout}}</text>
      </view>

    </view>
  </view>

  <!-- ── Kino Simulator Overlay ── -->
  <view wx:if="{{kinoSimOpen}}" class="ksm-overlay">
    <view class="ksm-container">

      <view class="ksm-header" style="padding-top: {{statusBarHeight}}px;">
        <view>
          <text class="ksm-title">{{t.kinoSimTitle}}</text>
          <text class="ksm-serial">S/N: KNA2-00000</text>
        </view>
        <view class="ksm-close" bindtap="closeKinoSim">✕</view>
      </view>

      <scroll-view class="ksm-body" scroll-y="true">
      <view class="ksm-body-inner">

        <!-- Device ring -->
        <view class="ksm-ring-row">
        <view class="ksm-device-wrap ksm-state-{{kinoSimStatus}}">
          <view class="ksm-ring-track"></view>
          <view class="ksm-ring-face">
            <view wx:if="{{kinoSimStatus === 'complete' && kinoSimBmList.length > 0}}"
              class="ksm-face-slide {{kinoSimSlideVisible ? 'ksm-slide-visible' : ''}}">
              <text class="ksm-slide-index">{{kinoSimSlideIndex + 1}} / {{kinoSimBmList.length}}</text>
              <text class="ksm-slide-label">{{kinoSimBmList[kinoSimSlideIndex].label}}</text>
              <text class="ksm-slide-val">{{kinoSimBmList[kinoSimSlideIndex].value !== null ? kinoSimBmList[kinoSimSlideIndex].value : '—'}}</text>
              <text class="ksm-slide-unit">{{kinoSimBmList[kinoSimSlideIndex].unit}}</text>
            </view>
            <view wx:else class="ksm-face-static">
              <text class="ksm-face-label">STATUS</text>
              <text class="ksm-face-status ksm-face-status-{{kinoSimStatus}}">
                {{kinoSimStatus === 'ready' ? t.kinoSimStatusReady : kinoSimStatus === 'analyzing' ? t.kinoSimStatusAnalyzing : kinoSimStatus === 'complete' ? t.kinoSimStatusComplete : t.kinoSimStatusFailed}}
              </text>
              <text wx:if="{{kinoSimScannedUserName}}" class="ksm-face-patient-label">{{t.kinoSimPatientLabel}}</text>
              <text class="ksm-face-user">{{kinoSimScannedUserName || '—'}}</text>
            </view>
          </view>
        </view>
        </view>

        <!-- Results panel -->
        <view wx:if="{{kinoSimStatus === 'complete' && kinoSimBmList.length > 0}}" class="ksm-results">
          <view class="ksm-tabs">
            <view class="ksm-tab {{kinoSimActiveTab === 'bioage' ? 'ksm-tab-active' : ''}}"
              bindtap="onKinoSimTabChange" data-tab="bioage">
              <text>{{t.kinoSimTabBioAge}}</text>
            </view>
            <view class="ksm-tab {{kinoSimActiveTab === 'biomarkers' ? 'ksm-tab-active' : ''}}"
              bindtap="onKinoSimTabChange" data-tab="biomarkers">
              <text>{{t.kinoSimTabBm}}</text>
            </view>
          </view>

          <view wx:if="{{kinoSimActiveTab === 'bioage'}}" class="ksm-tab-content">
            <view class="ksm-bioage-row">
              <view class="ksm-bioage-chip">
                <text class="ksm-bioage-num" style="color: {{kinoSimBioAgeColor}}">{{kinoSimBioAge}}</text>
                <text class="ksm-bioage-chip-label">{{t.kinoSimBioAgeLabel}}</text>
              </view>
              <view class="ksm-bioage-chip ksm-bioage-chip-dim">
                <text class="ksm-bioage-num" style="color: #A6C4E5">{{kinoSimChronoAge}}</text>
                <text class="ksm-bioage-chip-label">{{t.kinoSimChronoLabel}}</text>
              </view>
            </view>
            <view wx:for="{{kinoSimSubAgeList}}" wx:key="key" class="ksm-sub-row">
              <view class="ksm-sub-dot" style="background: {{item.color}}"></view>
              <text class="ksm-sub-label">{{item.label}}</text>
              <text class="ksm-sub-val" style="color: {{item.color}}">{{item.value}}</text>
            </view>
          </view>

          <view wx:if="{{kinoSimActiveTab === 'biomarkers'}}" class="ksm-tab-content">
            <view wx:for="{{kinoSimBmList}}" wx:key="key" class="ksm-bm-row">
              <text class="ksm-bm-label">{{item.label}}</text>
              <text class="ksm-bm-val">{{item.value !== null ? item.value : '—'}}<text class="ksm-bm-unit"> {{item.unit}}</text></text>
            </view>
          </view>
        </view>

        <!-- Action button -->
        <view class="ksm-btn ksm-btn-{{kinoSimStatus}}" bindtap="handleKinoSimStart">
          <view wx:if="{{kinoSimStatus === 'analyzing'}}" class="ksm-dots-row">
            <view class="ksm-dot"></view>
            <view class="ksm-dot"></view>
            <view class="ksm-dot"></view>
          </view>
          <text wx:elif="{{kinoSimStatus === 'complete'}}">{{t.kinoSimBtnRunAnother}}</text>
          <text wx:else>{{t.kinoSimBtnStart}}</text>
        </view>

        <view class="ksm-quit-btn" bindtap="closeKinoSim">
          <text>✕  {{t.kinoSimQuit}}</text>
        </view>

        <view class="ksm-debug-toggle" bindtap="toggleKinoSimDebug">
          <text class="ksm-debug-toggle-text">{{kinoSimDebug ? '▲ DEBUG' : '▼ DEBUG'}}</text>
        </view>

        <view wx:if="{{kinoSimDebug && kinoSimError}}" class="ksm-debug-box">
          <text class="ksm-debug-label">ERROR</text>
          <text class="ksm-debug-msg" user-select="true">{{kinoSimError}}</text>
        </view>
        <view wx:elif="{{kinoSimDebug}}" class="ksm-debug-box">
          <text class="ksm-debug-msg">No errors.</text>
        </view>

        <view style="height: 48rpx;"></view>
      </view>
      </scroll-view>

    </view>
  </view>

  <!-- ── Bottom Tab Bar ── -->
  <view class="tab-bar">
    <view class="tab-btn {{tab === 'chat' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="chat">
      <view wx:if="{{tab === 'chat'}}" class="tab-line"></view>
      <image class="tab-icon-img" src="/assets/icons/chat.svg" mode="aspectFit" />
      <text class="tab-label">{{t.tabChat}}</text>
    </view>
    <view class="tab-btn {{tab === 'health' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="health">
      <view wx:if="{{tab === 'health'}}" class="tab-line"></view>
      <image class="tab-icon-img" src="/assets/icons/health.svg" mode="aspectFit" />
      <text class="tab-label">{{t.tabHealth}}</text>
    </view>
    <view class="tab-btn {{tab === 'plans' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="plans">
      <view wx:if="{{tab === 'plans'}}" class="tab-line"></view>
      <image class="tab-icon-img" src="/assets/icons/plans.svg" mode="aspectFit" />
      <text class="tab-label">{{t.tabPlans}}</text>
    </view>
    <view wx:if="{{!isGuest}}" class="tab-btn {{tab === 'learn' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="learn">
      <view wx:if="{{tab === 'learn'}}" class="tab-line"></view>
      <image class="tab-icon-img" src="/assets/icons/training.svg" mode="aspectFit" />
      <text class="tab-label">{{t.tabLearn}}</text>
    </view>
    <view wx:if="{{!isGuest}}" class="tab-btn {{tab === 'store' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="store">
      <view wx:if="{{tab === 'store'}}" class="tab-line"></view>
      <image class="tab-icon-img" src="/assets/icons/store.svg" mode="aspectFit" />
      <text class="tab-label">{{t.tabStore}}</text>
    </view>
  </view>

  <!-- ── Guest Join Sheet ── -->
  <view wx:if="{{guestSheetOpen}}" class="guest-sheet-mask" bindtap="closeGuestSheet">
    <view class="guest-sheet" catchtap="noop" style="{{guestKeyboardHeight > 0 ? 'padding-bottom:' + guestKeyboardHeight + 'px;' : ''}}">
      <view class="guest-sheet-handle"></view>

      <text class="guest-sheet-title">{{t.guestJoinTitle}}</text>
      <text class="guest-sheet-desc">{{t.guestJoinDesc}}</text>
      <view class="pin-field">
        <view class="pin-boxes">
          <view
            wx:for="{{guestInviteDigits}}"
            wx:key="index"
            class="pin-box {{item ? 'pin-filled' : ''}} {{!item && index === guestInviteCode.length ? 'pin-active' : ''}}"
          >
            <text class="pin-digit">{{item}}</text>
          </view>
        </view>
        <input
          class="pin-capture"
          type="number"
          value="{{guestInviteCode}}"
          bindinput="onGuestInviteInput"
          bindkeyboardheightchange="onGuestKeyboardHeightChange"
          focus="{{guestSheetOpen}}"
          adjust-position="{{false}}"
          maxlength="6"
        />
      </view>
      <view wx:if="{{guestInviteError}}" class="guest-sheet-error">
        <text>{{guestInviteError}}</text>
      </view>
      <view class="guest-sheet-btn {{guestInviteBusy ? 'guest-sheet-btn-disabled' : ''}}" bindtap="submitGuestInvite">
        <text>{{guestInviteBusy ? t.guestActivating : t.guestJoinBtn}}</text>
      </view>
    </view>
  </view>

  <!-- ── Viva Subscription Redeem Sheet ── -->
  <view wx:if="{{vivaRedeemSheetOpen}}" class="guest-sheet-mask" bindtap="closeVivaRedeemSheet">
    <view class="guest-sheet" catchtap="noop">
      <view class="guest-sheet-handle"></view>
      <text class="guest-sheet-title">{{t.vivaRedeemTitle}}</text>
      <text class="guest-sheet-desc">
        {{vivaSubscriptionExpiresAtDisplay && !vivaSubscriptionExpired
          ? (lang === 'zh' ? '当前订阅至 ' + vivaSubscriptionExpiresAtDisplay : 'Currently active until ' + vivaSubscriptionExpiresAtDisplay)
          : (lang === 'zh' ? '当前无有效订阅' : 'No active subscription')}}
      </text>
      <input
        class="viva-redeem-input"
        type="text"
        value="{{vivaRedeemCode}}"
        placeholder="{{t.vivaRedeemPlaceholder}}"
        bindinput="onVivaRedeemInput"
        focus="{{vivaRedeemSheetOpen}}"
        adjust-position="{{true}}"
      />
      <view wx:if="{{vivaRedeemError}}" class="guest-sheet-error">
        <text>{{vivaRedeemError}}</text>
      </view>
      <view class="guest-sheet-btn {{vivaRedeemBusy ? 'guest-sheet-btn-disabled' : ''}}" bindtap="submitVivaRedeem">
        <text>{{vivaRedeemBusy ? '…' : t.vivaRedeemBtn}}</text>
      </view>
    </view>
  </view>

  <!-- Page-level privacy modal — outside all tab containers so it is visible
       regardless of which tab is active (health tab uses display:none). -->
  <view wx:if="{{showPrivacyModal}}" class="page-privacy-mask" catchtap="noop">
    <view class="page-privacy-box">
      <text class="page-privacy-title">{{lang === 'en' ? 'Privacy Notice' : '隐私保护提示'}}</text>
      <text class="page-privacy-body">{{lang === 'en' ? 'To upload images and use health features, this app needs access to your photo album and camera. Please agree to our privacy policy to continue.' : '为上传图片及使用健康功能，本应用需要访问您的相册和摄像头。请阅读并同意我们的隐私保护指引后继续。'}}</text>
      <button class="page-privacy-agree-btn"
              id="privacy-agree-btn"
              open-type="agreePrivacyAuthorization"
              bindagreeprivacyauthorization="onPrivacyAgree">
        {{lang === 'en' ? 'Agree & Continue' : '同意并继续'}}
      </button>
      <view class="page-privacy-cancel-btn" bindtap="onPrivacyCancel">
        <text>{{lang === 'en' ? 'Decline' : '拒绝'}}</text>
      </view>
    </view>
  </view>

</view>
