.theme-light .csim-handle     { background: rgba(201, 149, 106, 0.25); }
.theme-light .csim-title      { color: var(--text); }
.theme-light .csim-subtitle   { color: var(--text-muted); }
.theme-light .csim-set-card   { background: rgba(0, 0, 0, 0.03); }
.theme-light .csim-set-name   { color: var(--text); }
.theme-light .csim-set-desc   { color: var(--text-muted); }
.theme-light .csim-dot-badge  { background: rgba(0, 0, 0, 0.04); }
