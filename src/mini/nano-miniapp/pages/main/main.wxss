  color: var(--text);
}
/* ── Chat input area ── */
.theme-light .tool-item {
  background: rgba(201, 149, 106, 0.08);
  border-color: rgba(201, 149, 106, 0.25);
}
.theme-light .tool-item-label  { color: var(--text); }
.theme-light .tool-item-icon   { color: var(--blue); }
.theme-light .input-area {
  background: var(--bg-input);
  border-top-color: var(--navy-border);
}
.theme-light .chat-textarea {
  background: var(--navy-lift);
  border-color: rgba(201, 149, 106, 0.22);
  color: var(--text);
}
.theme-light .textarea-ph { color: var(--text-muted); }
.theme-light .plus-btn {
  background: rgba(201, 149, 106, 0.1);
  border-color: rgba(201, 149, 106, 0.25);
}
.theme-light .plus-icon          { color: var(--text-sub); }
.theme-light .plus-btn-open      { background: rgba(201, 149, 106, 0.25); border-color: var(--blue); }
.theme-light .plus-btn-open .plus-icon { color: var(--blue); }
.theme-light .mic-btn {
