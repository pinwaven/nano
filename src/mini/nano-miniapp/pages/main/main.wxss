/* ── Learning Paths ───────────────────────────────────────────────────────── */
.training-path-card {
  background: var(--navy-lift); border-radius: 16rpx; padding: 20rpx 20rpx 16rpx; margin-bottom: 16rpx;
  border: 1rpx solid var(--navy-border);
}
.training-path-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8rpx; }
.training-path-title { font-size: 28rpx; font-weight: 600; color: var(--text); flex: 1; }
.training-path-tier { font-size: 20rpx; color: var(--info); background: rgba(99,101,241,0.15); padding: 3rpx 12rpx; border-radius: 20rpx; text-transform: capitalize; }
.training-path-desc { font-size: 24rpx; color: var(--text-muted); margin-bottom: 12rpx; }
.training-path-progress-bar { height: 8rpx; background: rgba(255,255,255,0.1); border-radius: 4rpx; margin-bottom: 8rpx; overflow: hidden; }
.training-path-progress-fill { height: 100%; background: linear-gradient(90deg,#6375EC,#8B9FFF); border-radius: 4rpx; }
.training-path-progress-label { font-size: 22rpx; color: var(--text-muted); }

/* ── Course meta row ──────────────────────────────────────────────────────── */
.training-course-meta-row { display: flex; align-items: center; gap: 12rpx; margin-top: 6rpx; flex-wrap: wrap; }
.training-course-level { font-size: 20rpx; color: var(--info); background: rgba(99,101,241,0.15); padding: 2rpx 10rpx; border-radius: 20rpx; text-transform: capitalize; }
.training-course-credits { font-size: 20rpx; color: var(--success-deep); }

/* ── Lesson meta row ──────────────────────────────────────────────────────── */
.training-lesson-meta-row { display: flex; align-items: center; gap: 10rpx; margin-top: 6rpx; flex-wrap: wrap; }
.training-lesson-type-badge { font-size: 22rpx; }
.training-lesson-credits-label { font-size: 20rpx; color: var(--success-deep); }
.training-lesson-quiz-badge { font-size: 20rpx; color: var(--warn); background: rgba(245,158,11,0.15); padding: 2rpx 10rpx; border-radius: 20rpx; }

/* ── Text content view ────────────────────────────────────────────────────── */
.training-text-content { padding: 24rpx; background: var(--navy-lift); border-radius: 16rpx; margin-bottom: 16rpx; max-height: 600rpx; overflow-y: auto; }
.training-text-body { font-size: 27rpx; color: #A6C4E5; line-height: 1.8; white-space: pre-wrap; }

/* ── Quiz section ─────────────────────────────────────────────────────────── */
.training-quiz-section { margin-top: 32rpx; padding-top: 24rpx; border-top: 1rpx solid var(--navy-border); }
.training-quiz-title { display: block; font-size: 28rpx; font-weight: 700; color: var(--text); margin-bottom: 20rpx; }
.training-quiz-question { background: var(--navy-lift); border-radius: 14rpx; padding: 20rpx; margin-bottom: 20rpx; }
.training-quiz-scenario { display: block; font-size: 24rpx; color: #A6C4E5; line-height: 1.7; margin-bottom: 12rpx; padding-bottom: 12rpx; border-bottom: 1rpx solid var(--navy-border); font-style: italic; }
.training-quiz-q-text { display: block; font-size: 27rpx; font-weight: 600; color: var(--text); margin-bottom: 16rpx; line-height: 1.5; }
.training-quiz-option { display: flex; align-items: center; gap: 16rpx; padding: 16rpx; border-radius: 10rpx; margin-bottom: 10rpx; background: rgba(255,255,255,0.04); border: 1rpx solid transparent; }
.training-quiz-option-selected { background: rgba(99,101,241,0.18); border-color: rgba(99,101,241,0.5); }
.training-quiz-option-radio { width: 32rpx; height: 32rpx; border-radius: 50%; border: 2rpx solid #7A9ABF; flex-shrink: 0; }
.training-quiz-option-radio-checked { border-color: #6375EC; background: #6375EC; }
.training-quiz-option-text { font-size: 26rpx; color: var(--text); flex: 1; line-height: 1.5; }
.training-quiz-submit-btn { margin-top: 24rpx; padding: 28rpx; background: linear-gradient(90deg,#6375EC,#8B9FFF); border-radius: 16rpx; text-align: center; }
.training-quiz-result { border-radius: 14rpx; padding: 24rpx; text-align: center; margin-bottom: 20rpx; }
.training-quiz-passed { background: rgba(16,185,129,0.15); border: 1rpx solid rgba(16,185,129,0.4); }
.training-quiz-failed { background: rgba(239,68,68,0.1); border: 1rpx solid rgba(239,68,68,0.3); }
.training-quiz-result-score { display: block; font-size: 52rpx; font-weight: 800; color: var(--text); }
.training-quiz-result-label { display: block; font-size: 26rpx; color: var(--text-muted); margin-top: 6rpx; }
.training-quiz-result-credits { display: block; font-size: 26rpx; color: var(--success-deep); font-weight: 600; margin-top: 8rpx; }

/* ── Quiz answer review ───────────────────────────────────────────────────── */
.training-quiz-review { margin-top: 20rpx; text-align: left; border-top: 1rpx solid rgba(255,255,255,0.08); padding-top: 16rpx; }
.training-quiz-review-item { display: flex; gap: 16rpx; padding: 16rpx 0; border-bottom: 1rpx solid rgba(255,255,255,0.05); }
.training-quiz-review-correct .training-quiz-review-icon { color: var(--success-deep); }
.training-quiz-review-wrong .training-quiz-review-icon { color: var(--danger); }
.training-quiz-review-icon { font-size: 28rpx; flex-shrink: 0; font-weight: 700; margin-top: 2rpx; }
.training-quiz-review-body { flex: 1; min-width: 0; }
.training-quiz-review-q { display: block; font-size: 24rpx; font-weight: 600; color: #E8F0F8; line-height: 1.5; margin-bottom: 8rpx; }
.training-quiz-review-your-ans { display: block; font-size: 22rpx; color: var(--danger); margin-bottom: 4rpx; }
.training-quiz-review-correct-ans { display: block; font-size: 22rpx; color: var(--success-deep); margin-bottom: 4rpx; }
.training-quiz-review-explanation { display: block; font-size: 22rpx; color: #A6C4E5; line-height: 1.6; font-style: italic; margin-top: 6rpx; }

/* ── Certifications ───────────────────────────────────────────────────────── */
.training-cert-card { display: flex; align-items: center; gap: 20rpx; background: var(--navy-lift); border-radius: 14rpx; padding: 20rpx; margin-bottom: 12rpx; border: 1rpx solid rgba(245,158,11,0.2); }
.training-cert-icon { font-size: 44rpx; flex-shrink: 0; }
.training-cert-info { flex: 1; }
.training-cert-title { display: block; font-size: 27rpx; font-weight: 600; color: var(--text); }
.training-cert-tier { display: block; font-size: 22rpx; color: var(--warn); margin-top: 4rpx; text-transform: capitalize; }
.training-cert-chevron { font-size: 36rpx; color: var(--text-muted); flex-shrink: 0; }

/* ── Certificate detail overlay ───────────────────────────────────────────── */
.cert-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.65); z-index: 2000; display: flex; align-items: flex-end; justify-content: center; }
.cert-detail-card { background: var(--navy-card); border-radius: 28rpx 28rpx 0 0; width: 100%; max-height: 90vh; overflow-y: auto; padding: 32rpx 32rpx 60rpx; box-sizing: border-box; }
.cert-detail-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.cert-status-badge { display: flex; align-items: center; gap: 10rpx; background: rgba(16,185,129,0.15); border: 1rpx solid #10b981; border-radius: 32rpx; padding: 8rpx 22rpx; }
.cert-status-check { font-size: 28rpx; color: var(--success-deep); font-weight: 700; }
.cert-status-text { font-size: 26rpx; color: var(--success-deep); font-weight: 600; }
.cert-close-btn { font-size: 36rpx; color: var(--text-muted); padding: 8rpx 16rpx; }
.cert-bg-wrap { margin-bottom: 24rpx; border-radius: 16rpx; overflow: hidden; }
.cert-bg-preview { width: 100%; border-radius: 16rpx; }
.cert-field-list { display: flex; flex-direction: column; gap: 0; }
.cert-field { display: flex; align-items: flex-start; padding: 16rpx 0; border-bottom: 1rpx solid rgba(255,255,255,0.06); }
.cert-label { font-size: 24rpx; color: var(--text-muted); min-width: 180rpx; flex-shrink: 0; padding-top: 2rpx; }
.cert-value { font-size: 26rpx; color: var(--text); flex: 1; line-height: 1.5; }
.cert-valid { color: var(--success-deep) !important; font-weight: 600; }
.cert-number { color: #6366f1 !important; }
.cert-mono { font-family: monospace; font-size: 23rpx !important; }
.cert-download-btn { margin-top: 32rpx; background: rgba(99,102,241,0.15); border: 1rpx solid #6366f1; border-radius: 16rpx; padding: 24rpx; text-align: center; }
.cert-download-btn text { font-size: 28rpx; color: #6366f1; font-weight: 600; }

/* ── Wellness tab ─────────────────────────────────────────────────────────── */
.wellness-loading { display: flex; gap: 16rpx; justify-content: center; align-items: center; padding: 80rpx 0; }
.wellness-section { padding: 32rpx 28rpx 8rpx; }
.wellness-section-title { display: block; font-size: 30rpx; font-weight: 700; color: var(--text); margin-bottom: 20rpx; letter-spacing: 0.5rpx; }
.wellness-empty { padding: 24rpx 0 32rpx; }
.wellness-empty-text { font-size: 26rpx; color: var(--text-muted); }

/* Sleep track cards */
.sleep-track-card { display: flex; align-items: center; gap: 20rpx; background: var(--navy-lift); border-radius: 18rpx; padding: 24rpx 20rpx; margin-bottom: 16rpx; border: 1rpx solid rgba(166,196,229,0.1); }
.sleep-track-icon { width: 68rpx; height: 68rpx; border-radius: 50%; background: rgba(99,117,236,0.18); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.sleep-icon-glyph { font-size: 28rpx; color: #6375EC; }
.sleep-track-info { flex: 1; min-width: 0; }
.sleep-track-name { display: block; font-size: 28rpx; font-weight: 600; color: var(--text); }
.sleep-track-dur { display: block; font-size: 22rpx; color: var(--text-muted); margin-top: 6rpx; }
.sleep-track-active-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #6375EC; flex-shrink: 0; }

/* Now-playing bar */
.sleep-now-playing { display: flex; align-items: center; justify-content: space-between; background: rgba(99,117,236,0.15); border-radius: 14rpx; padding: 18rpx 20rpx; margin-top: 8rpx; border: 1rpx solid rgba(99,117,236,0.3); }
.sleep-np-info { flex: 1; min-width: 0; }
.sleep-np-label { display: block; font-size: 20rpx; color: #6375EC; font-weight: 600; margin-bottom: 4rpx; }
.sleep-np-title { display: block; font-size: 26rpx; color: var(--text); font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sleep-np-controls { display: flex; gap: 16rpx; margin-left: 20rpx; }
.sleep-np-btn { width: 56rpx; height: 56rpx; border-radius: 50%; background: rgba(99,117,236,0.2); display: flex; align-items: center; justify-content: center; }
.sleep-np-btn-icon { font-size: 24rpx; color: #6375EC; }

/* Video / document asset cards */
.media-asset-card { display: flex; align-items: center; gap: 20rpx; background: var(--navy-lift); border-radius: 18rpx; padding: 24rpx 20rpx; margin-bottom: 16rpx; border: 1rpx solid rgba(166,196,229,0.1); }
.media-asset-icon { width: 68rpx; height: 68rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.media-asset-icon--video { background: rgba(239,68,68,0.15); }
.media-asset-icon--doc { background: rgba(245,158,11,0.15); }
.media-asset-glyph { font-size: 26rpx; color: #fff; }
.media-asset-icon--video .media-asset-glyph { color: var(--danger); }
.media-asset-icon--doc .media-asset-glyph { color: var(--warn); }
.media-asset-info { flex: 1; min-width: 0; }
.media-asset-name { display: block; font-size: 28rpx; font-weight: 600; color: var(--text); }
.media-asset-sub { display: block; font-size: 22rpx; color: var(--text-muted); margin-top: 6rpx; }
.media-asset-btn { padding: 12rpx 20rpx; background: rgba(166,196,229,0.1); border-radius: 20rpx; border: 1rpx solid rgba(166,196,229,0.2); flex-shrink: 0; }
.media-asset-btn-text { font-size: 22rpx; color: var(--text-sub); font-weight: 600; }

/* Smart Ring APK card */
.device-apk-card { display: flex; align-items: center; gap: 20rpx; background: var(--navy-lift); border-radius: 18rpx; padding: 24rpx 20rpx; border: 1rpx solid rgba(166,196,229,0.1); }
.device-apk-icon { width: 68rpx; height: 68rpx; border-radius: 14rpx; background: rgba(16,185,129,0.15); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.device-apk-img { width: 40rpx; height: 40rpx; }
.device-apk-info { flex: 1; min-width: 0; }
.device-apk-name { display: block; font-size: 28rpx; font-weight: 600; color: var(--text); }
.device-apk-version { display: block; font-size: 22rpx; color: var(--text-muted); margin-top: 4rpx; }
.device-apk-btn { padding: 14rpx 24rpx; background: rgba(16,185,129,0.18); border-radius: 24rpx; border: 1rpx solid rgba(16,185,129,0.35); flex-shrink: 0; }
.device-apk-btn-text { font-size: 22rpx; color: var(--success-deep); font-weight: 600; }

/* Page-level privacy authorization modal */
.page-privacy-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.page-privacy-box {
  background: #132236;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 36rpx;
  margin: 0 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}
.page-privacy-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #e2eaf4;
  text-align: center;
}
.page-privacy-body {
  font-size: 26rpx;
  color: rgba(166, 196, 229, 0.8);
  text-align: center;
  line-height: 1.6;
}
.page-privacy-agree-btn {
  width: 100%;
  background: #3b82f6;
  color: #fff;
  border-radius: 100rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 0;
  margin-top: 8rpx;
  border: none;
}
.page-privacy-cancel-btn {
  padding: 8rpx 0;
}
.page-privacy-cancel-btn text {
  font-size: 26rpx;
  color: rgba(166, 196, 229, 0.5);
}

