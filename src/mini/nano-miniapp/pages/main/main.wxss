/* ── Chat card accents ───────────────────────────────────────────────────────
   The global --success/--warn/--danger/--info/--blue tokens are audited against the PAGE
   background (--navy), but the status pills and chip labels sit on a blue/brown-tinted surface
   layered on top of the message bubble, which is a different (and lighter) ground. Reusing the
   global values there measured 2.86:1 to 4.26:1 — the same failure mode as the light-theme
   incident in commit c8aa1d6. These are the same hues re-solved against the actual composited
   pill/chip backgrounds; every pair below clears 5.1:1 in both themes.
   --chat-accent is #A0B4FF in dark, matching .msg-action-label, which already solved
   "blue-family text on a blue-tinted dark surface" in this same file. */
page {
  --chat-accent:  #A0B4FF;
  --chat-good:    #6EE7B7;
  --chat-warn:    #FBBF24;
  --chat-high:    #FFB3B3;
  --chat-low:     #A5B4FC;
  --chat-pill-fg: #C3D6EE;
  --chat-sep-fg:  #7F97B5;
}

.theme-light {
  --chat-accent:  #7A4A28;
  --chat-good:    #0B5C3E;
  --chat-warn:    #6E4805;
  --chat-high:    #A32A1E;
  --chat-low:     #3730A3;
  --chat-pill-fg: #5A4630;
  --chat-sep-fg:  #6B5947;
}

/* ── Layout ── */

.main {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: radial-gradient(ellipse at 50% 0%, #142847 0%, #0B1C2E 70%);
  overflow: hidden;
}

.tab-hidden { display: none !important; }

/* ── App Header ── */

.status-bar-spacer {
  flex-shrink: 0;
  background: rgba(11, 28, 46, 0.85);
  position: relative;
}

.coach-back-pill {
  position: absolute;
  left: 24rpx;
  bottom: 8rpx;
  font-size: 20rpx;
  color: rgba(99, 117, 236, 0.6);
  letter-spacing: 1rpx;
  pointer-events: none;
}

.app-header {
  background: rgba(11, 28, 46, 0.85);
  border-bottom: 1rpx solid rgba(99, 117, 236, 0.18);
  padding: 16rpx 36rpx 28rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.sandbox-banner {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 14rpx 28rpx;
  background: rgba(245, 158, 11, 0.16);
  border-bottom: 1rpx solid rgba(245, 158, 11, 0.4);
}

.sandbox-banner-text {
  flex: 1;
  font-size: 22rpx;
  color: var(--warn);
  font-weight: 500;
}

.sandbox-banner-exit {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--warn);
  text-decoration: underline;
}

.theme-light .sandbox-banner { background: rgba(245, 158, 11, 0.12); border-bottom-color: rgba(245, 158, 11, 0.35); }

.viva-expired-banner {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 14rpx 28rpx;
  background: rgba(99, 117, 236, 0.16);
  border-bottom: 1rpx solid rgba(99, 117, 236, 0.4);
}
.viva-expired-banner-text {
  flex: 1;
  font-size: 22rpx;
  color: var(--info-pale);
  font-weight: 500;
}
.viva-expired-banner-btn {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--info-pale);
  text-decoration: underline;
}
.theme-light .viva-expired-banner { background: rgba(99, 117, 236, 0.1); border-bottom-color: rgba(99, 117, 236, 0.3); }

.header-logo-img {
  width: 56rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.header-title {
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: #EEF2FF;
  flex-shrink: 0;
}

.header-divider {
  width: 1rpx;
  height: 32rpx;
  background: rgba(99, 117, 236, 0.25);
  flex-shrink: 0;
}

.header-user {
  font-size: 28rpx;
  color: #A6C4E5;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}

.header-version {
  font-size: 18rpx;
  color: rgba(99, 117, 236, 0.7);
  background: rgba(99, 117, 236, 0.12);
  border: 1rpx solid rgba(99, 117, 236, 0.25);
  border-radius: 8rpx;
  padding: 4rpx 10rpx;
  flex-shrink: 0;
}

.header-logo-btn {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

/* ── Logo menu ── */

.menu-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 100;
}

.menu-dropdown {
  position: absolute;
  left: 24rpx;
  background: #0F2540;
  border: 1rpx solid rgba(99, 117, 236, 0.25);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.5);
  min-width: 240rpx;
}

.menu-divider {
  height: 1rpx;
  background: rgba(99, 117, 236, 0.15);
  margin: 0 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 32rpx;
}

.menu-item-icon {
  font-size: 28rpx;
  color: #A6C4E5;
}

.menu-item-label {
  font-size: 28rpx;
  color: #EEF2FF;
  font-weight: 500;
}

.menu-credit-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: rgba(99, 117, 236, 0.08);
}

.menu-credit-label {
  font-size: 22rpx;
  color: rgba(166, 196, 229, 0.7);
  letter-spacing: 1rpx;
}

.menu-credit-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #6375EC;
}

.theme-light .menu-credit-row { background: rgba(99, 117, 236, 0.06); }
.theme-light .menu-credit-value { color: #4f5fcc; }

/* ── Tab content container ── */

.tab-content {
  flex: 1;
  position: relative;
  overflow: hidden;
  min-height: 0;
}

.chat-tab,
.health-tab,
.store-tab,
.learn-tab,
.plans-tab {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex;
  flex-direction: column;
}

.academy-subtab-scroll,
.wellness-subtab-scroll,
.dots-subtab-scroll { flex: 1; overflow: hidden; }

.inner-tab-bar { display: flex; border-bottom: 1rpx solid #1E3A5F; background: #0A1F36; flex-shrink: 0; }
.inner-tab { flex: 1; padding: 20rpx 0; display: flex; align-items: center; justify-content: center; }
.inner-tab-text { font-size: 26rpx; color: var(--steel); font-weight: 500; }
.inner-tab-active .inner-tab-text { color: #A0B4FF; font-weight: 700; }

/* ── Tab bar ── */

.tab-bar {
  flex-shrink: 0;
  display: flex;
  background: rgba(8, 18, 32, 0.92);
  border-top: 1rpx solid rgba(99, 117, 236, 0.18);
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 20rpx 0 24rpx;
  position: relative;
}

.tab-line {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 64rpx;
  height: 4rpx;
  background: linear-gradient(90deg, #6375EC, #8B9FFF);
  border-radius: 0 0 6rpx 6rpx;
}

.tab-icon-img {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.35;
}
.tab-active .tab-icon-img { opacity: 1; }

.tab-label {
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: rgba(166, 196, 229, 0.4);
}

.tab-active .tab-label { color: #6375EC; }

/* ── Chat messages ── */

.chat-messages {
  flex: 1;
  height: 0;
}

.chat-inner {
  /* Generous bottom padding is a deliberate safety margin, not decorative — real WeChat
     clients (unlike the DevTools simulator) sometimes don't fully repaint a newly-appended
     LAST message into the scroll-view's content box until something forces a relayout, which
     an actual overflowing scroll does but a short message that fits within the viewport never
     triggers. scrollTop/scroll-into-view are no-ops when there's nothing to scroll, so they
     can't compensate for this — found 2026-07-29 via a real-device screenshot showing a short
     reply clipped almost entirely, while long (overflowing, actively-scrolled) messages
     rendered fine. Padding this much larger than the disclaimer+input bar's own height gives
     enough buffer that the last line of any message clears the clipping edge regardless.
     Do not shrink this back down without confirming the underlying repaint bug is fixed. */
  padding: 24rpx 28rpx 200rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* ── chat history banner ──────────────────────────────────────────────────── */
.chat-history-load {
  display: flex; align-items: center; justify-content: center;
  padding: 14rpx 0 6rpx;
}
.chat-history-spinner-row { display: flex; align-items: center; gap: 10rpx; }
.chat-history-text { font-size: 22rpx; color: rgba(160,180,220,0.6); letter-spacing: 0.02em; }
.chat-history-loading .chat-history-text { color: rgba(160,180,220,0.85); }
.chat-history-spinner {
  width: 28rpx; height: 28rpx; border-radius: 50%;
  border: 3rpx solid rgba(160,180,220,0.2);
  border-top-color: rgba(160,180,220,0.85);
  animation: chat-spin 0.8s linear infinite;
}
@keyframes chat-spin { to { transform: rotate(360deg); } }
.chat-history-start { display: flex; justify-content: center; padding: 14rpx 0 6rpx; }
.chat-history-start-text { font-size: 21rpx; color: rgba(160,180,220,0.35); letter-spacing: 0.03em; }

/* pull-to-load custom refresher slot */
.chat-refresher { display: flex; align-items: center; justify-content: center; height: 60rpx; }
.chat-refresher-spinner {
  width: 32rpx; height: 32rpx; border-radius: 50%;
  border: 3rpx solid rgba(160,180,220,0.2);
  border-top-color: rgba(160,180,220,0.85);
  animation: chat-spin 0.8s linear infinite;
}

.msg-row { display: flex; }
.msg-row-user { justify-content: flex-end; }
.msg-row-ai   { justify-content: flex-start; }

.message-bubble {
  max-width: 90%;
  padding: 18rpx 24rpx;
  border-radius: 28rpx;
}

.message-user {
  /* Split from .message-bubble's shared 90%: a chat one-liner reads better narrow, but a
     long-form AI reply with cards needs the width (and makes .mcard-tile's two-up row fit). */
  max-width: 84%;
  background: linear-gradient(135deg, #6375EC 0%, #7B8FFF 100%);
  color: #fff;
  border-bottom-right-radius: 6rpx;
  box-shadow: 0 4rpx 24rpx rgba(99, 117, 236, 0.45);
}

.message-ai {
  max-width: 100%;
  padding: 22rpx 26rpx;
  background: #162E4A;
  color: #EEF2FF;
  border: 1rpx solid rgba(99, 117, 236, 0.18);
  border-bottom-left-radius: 6rpx;
}

.message-coach {
  background: rgba(16, 185, 129, 0.12);
  color: #EEF2FF;
  border: 1rpx solid rgba(16, 185, 129, 0.3);
  border-bottom-left-radius: 6rpx;
}

.msg-coach-label {
  font-size: 20rpx;
  color: var(--success-deep);
  font-weight: 600;
  display: block;
  margin-bottom: 4rpx;
}

/* Viva AG attribution — mirrors .msg-coach-label's shape, in the accent used for AG elsewhere
   in the app (the panel's badge and chips) so the two surfaces read as the same feature. */
.msg-ag-label {
  font-size: 20rpx;
  color: #A0B4FF;
  font-weight: 600;
  letter-spacing: 1rpx;
  display: block;
  margin-bottom: 4rpx;
}

.msg-bubble-image {
  padding: 0;
  overflow: hidden;
}

.msg-image {
  width: 480rpx;
  border-radius: 16rpx;
  display: block;
}

.msg-text {
  font-size: 28rpx;
  line-height: 1.55;
  word-break: break-word;
  white-space: pre-wrap;
}

/* ── AI markdown prose ───────────────────────────────────────────────────────
   <mp-html> is a Component with no options.styleIsolation, so it defaults to `isolated`:
   selectors in this file CANNOT reach the tags it renders. Only INHERITED properties cross the
   boundary via this host element — which is why font-size/line-height live here and everything
   else lives in MD_TAG_STYLE (utils/markdown.js), applied by mp-html's parser as per-tag inline
   style. Do not add non-inherited rules here expecting them to affect the rendered markdown.

   `color` is deliberately absent: it inherits from .message-ai, so .theme-light recolours the
   prose for free. That matters because mp-html only re-parses when `content` changes — a
   theme-driven tag-style swap would never reach messages that are already on screen. */
.msg-html {
  display: block;
  font-size: 28rpx;   /* was WeChat's 32rpx page default — AI text ran visibly larger than the
                         user's own 28rpx bubbles, with no line-height at all */
  line-height: 1.62;
}

.msg-seg { display: block; }
.msg-seg + .msg-seg { margin-top: 4rpx; }

/* --- in markdown. Not an <hr>: that tag is absent from rich-text's whitelist, so mp-html
   renders nothing for it (a silent no-op in the previous implementation). */
.msg-rule {
  height: 1rpx;
  margin: 24rpx 0;
  background: rgba(127, 127, 127, 0.30);
}

/* An image sharing a bubble with text keeps the bubble padding, so it needs its own gap. */
.msg-image-inset { margin-bottom: 14rpx; }

/* Time separator between messages more than 30 min apart (see MSG_SEPARATOR_GAP_MS). */
.msg-daysep {
  display: flex;
  justify-content: center;
  padding: 12rpx 0 4rpx;
}
.msg-daysep-text {
  font-size: 22rpx;
  color: var(--chat-sep-fg);
  letter-spacing: 0.04em;
}

/* ── AI message cards ────────────────────────────────────────────────────────
   Native page-scope views precisely BECAUSE mp-html is style-isolated and its tag-style is a
   flat per-tag inline-style map: no descendant selectors, no pseudo-elements, no .theme-light
   cascade. Designed chrome cannot live in there. Every colour below is a token, so the light
   theme mostly falls out for free — see the .theme-light overrides near the end of this file. */

.mcard {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 14rpx 0 18rpx;
}
.mcard-tile {
  flex: 1 1 44%;
  min-width: 200rpx;
  padding: 16rpx 18rpx;
  background: rgba(var(--blue-rgb), 0.08);
  border: 1rpx solid rgba(var(--blue-rgb), 0.20);
  border-left-width: 6rpx;
  border-left-color: var(--steel);
  border-radius: 16rpx;
}
.mcard-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-sub);
  letter-spacing: 0.02em;
}
.mcard-valrow {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  margin-top: 4rpx;
}
.mcard-val {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.15;
}
.mcard-unit {
  font-size: 22rpx;
  color: var(--text-sub);
}
.mcard-footrow {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 8rpx;
}
.mcard-pill {
  display: inline-block;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  border-radius: 20rpx;
  background: rgba(127, 127, 127, 0.14);
  color: var(--chat-pill-fg);
}
/* border-left-color is a 6rpx decorative bar, so it keeps the global semantic token; only the
   pill TEXT needs the re-solved value. */
.mcard-good { border-left-color: var(--success); }
.mcard-good .mcard-pill { color: var(--chat-good); }
.mcard-normal { border-left-color: var(--steel); }
.mcard-watch { border-left-color: var(--warn); }
.mcard-watch .mcard-pill { color: var(--chat-warn); }
.mcard-high { border-left-color: var(--danger); }
.mcard-high .mcard-pill { color: var(--chat-high); }
.mcard-low { border-left-color: var(--info); }
.mcard-low .mcard-pill { color: var(--chat-low); }
.mcard-none { border-left-color: rgba(127, 127, 127, 0.35); }

/* Sparkline: the last few measurements of THIS biomarker, drawn as bars rather than a canvas
   polyline. A <canvas type="2d"> inside a long scroll-view needs a per-instance SelectorQuery
   to resolve its node, manual dpr scaling, and an imperative redraw on every theme toggle and
   history append; bars are declarative, follow the theme via currentColor for free, and at this
   size read more clearly than an 8-point line would. The series comes from the user's own
   biomarker history (utils/biomarker-series.js), never from the model. */
.spark {
  display: flex;
  align-items: flex-end;
  align-self: flex-end;
  gap: 4rpx;
  height: 36rpx;
  margin-left: auto;
  padding-bottom: 2rpx;
}
.spark-bar {
  width: 10rpx;
  border-radius: 3rpx;
  /* currentColor = the bubble's own text colour, so the bars invert with the theme without a
     .theme-light override and without a token that would need its own audit. 0.55 measures
     4.55:1 (dark) / 3.18:1 (light) against the tile — both clear the 3:1 non-text bar; 0.40
     measured 1.8:1 and was not usable. Requires the WebView renderer, which this page uses
     (no "renderer": "skyline" in app.json or main.json). */
  background: currentColor;
  opacity: 0.55;
}
/* The newest reading is the one the tile's own value states — full strength, and tinted by
   whether the trend is an improvement. Bars are decorative shapes, so they answer to the 3:1
   non-text threshold rather than the 4.5:1 text one; the delta label below is real text and
   reuses the pill's already-audited --chat-good/--chat-high. */
.spark-bar-last { opacity: 1; }
.spark-t-good .spark-bar-last { background: var(--chat-good); }
.spark-t-bad .spark-bar-last { background: var(--chat-high); }
/* No base colour on purpose: buildSpark only emits a delta string for an up/down trend, so one
   of the two tone classes below is always present. Inheriting the bubble text colour is the
   correct fallback if that ever changes — --chat-sep-fg measured 4.18:1 here (it is audited
   against the PAGE background, not the tile) and would have been a silent failure. */
.spark-delta {
  font-size: 20rpx;
  letter-spacing: 0.02em;
}
.spark-d-good { color: var(--chat-good); }
.spark-d-bad { color: var(--chat-high); }

.tcard {
  margin: 14rpx 0 18rpx;
  padding: 18rpx 22rpx;
  background: rgba(var(--blue-rgb), 0.10);
  border: 1rpx solid rgba(var(--blue-rgb), 0.28);
  border-left: 6rpx solid var(--blue);
  border-radius: 16rpx;
}
.tcard-title {
  display: block;
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: 0.06em;
  color: var(--chat-accent);
  margin-bottom: 8rpx;
}
.tcard-body {
  font-size: 27rpx;
  line-height: 1.6;
}

.dcard {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 12rpx 0 18rpx;
}
.dcard-chip {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  padding: 10rpx 18rpx;
  border-radius: 30rpx;
  background: rgba(var(--blue-rgb), 0.12);
  border: 1rpx solid rgba(var(--blue-rgb), 0.30);
}
.dcard-id {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--chat-accent);
}
.dcard-name { font-size: 25rpx; }
.dcard-note {
  font-size: 21rpx;
  color: var(--text-sub);
}

/* :::formula — the Formulate-Dots evaluation chart. Two capsule bars segmented per dot in each
   dot's own catalog colour (dots.color_hex), plus a legend. Both bars are scaled against the
   LARGER capsule, so their lengths are comparable to each other rather than each filling the
   track. */
.fcard {
  margin: 14rpx 0 18rpx;
  padding: 24rpx 26rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(var(--blue-rgb), 0.10);
  border: 1rpx solid rgba(var(--blue-rgb), 0.26);
}
.fcard-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 20rpx;
}
.fcard-title {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--chat-accent);
  letter-spacing: 1rpx;
}
.fcard-note {
  font-size: 19rpx;
  color: var(--text-sub);
  text-align: right;
}
.fcard-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 12rpx;
}
.fcard-slot {
  width: 56rpx;
  flex-shrink: 0;
  font-size: 21rpx;
  color: var(--text-sub);
}
.fcard-track {
  flex: 1;
  display: flex;
  height: 26rpx;
  border-radius: 13rpx;
  overflow: hidden;
  background: rgba(127, 127, 127, 0.16);
}
.fcard-seg {
  height: 100%;
}
.fcard-num {
  width: 60rpx;
  flex-shrink: 0;
  text-align: right;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--chat-accent);
}
.fcard-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 18rpx;
  margin-top: 18rpx;
}
.fcard-leg {
  display: flex;
  align-items: center;
  gap: 8rpx;
  max-width: 100%;
}
.fcard-swatch {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}
.fcard-leg-name {
  font-size: 21rpx;
  color: var(--text);
}
.fcard-leg-num {
  font-size: 19rpx;
  color: var(--text-sub);
}
.fcard-foot {
  display: block;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(127, 127, 127, 0.18);
  font-size: 21rpx;
  color: var(--text-sub);
}

.msg-action-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 22rpx 32rpx;
  background: linear-gradient(135deg, rgba(99, 117, 236, 0.18), rgba(99, 117, 236, 0.08));
  border: 1rpx solid rgba(99, 117, 236, 0.45);
  border-radius: 28rpx;
  border-bottom-left-radius: 6rpx;
  max-width: 72%;
}

.msg-action-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #A0B4FF;
  flex: 1;
}

.msg-action-arrow {
  font-size: 40rpx;
  color: #6375EC;
  line-height: 1;
}

/* Typing indicator */

.typing-indicator {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx 26rpx;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #6375EC;
  opacity: 0.6;
  animation: dot-bounce 1.2s infinite ease-in-out;
}

.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }

.typing-status-text {
  font-size: 24rpx;
  opacity: 0.75;
  margin-left: 12rpx;
}

@keyframes dot-bounce {
  0%, 80%, 100% { transform: scale(0.7); opacity: 0.35; }
  40%            { transform: scale(1.2); opacity: 1; }
}

/* ── Onboarding bars ── */

.ob-bar {
  flex-shrink: 0;
  padding: 24rpx 28rpx;
  background: rgba(11, 28, 46, 0.92);
  border-top: 1rpx solid rgba(99, 117, 236, 0.18);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.name-bar {
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.ob-input {
  flex: 1;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(99, 117, 236, 0.3);
  border-radius: 24rpx;
  color: #EEF2FF;
  font-size: 28rpx;
  line-height: 1.5;
  min-height: 80rpx;
  padding: 20rpx 28rpx;
  box-sizing: border-box;
}

.ob-ph { color: rgba(166, 196, 229, 0.4); }

.ob-confirm {
  background: #6375EC;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 36rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 20rpx rgba(99, 117, 236, 0.45);
}

.ob-confirm-off { opacity: 0.35; box-shadow: none; }

.conditions-bar { gap: 20rpx; }

.cond-other-input { width: 100%; box-sizing: border-box; }

.cond-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.cond-chip {
  padding: 16rpx 28rpx;
  border-radius: 40rpx;
  border: 1rpx solid rgba(99, 117, 236, 0.3);
  background: rgba(99, 117, 236, 0.08);
  color: rgba(166, 196, 229, 0.7);
  font-size: 26rpx;
  font-weight: 500;
}

.cond-chip-on {
  border-color: #6375EC;
  background: rgba(99, 117, 236, 0.28);
  color: #EEF2FF;
}

.gender-bar {
  flex-direction: row;
  gap: 20rpx;
}

.quick-btn {
  flex: 1;
  padding: 22rpx 0;
  border-radius: 24rpx;
  border: 1rpx solid rgba(99, 117, 236, 0.35);
  background: rgba(99, 117, 236, 0.12);
  color: #EEF2FF;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.birthday-bar { gap: 16rpx; }

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #162E4A;
  border: 1rpx solid rgba(99, 117, 236, 0.28);
  border-radius: 24rpx;
  padding: 22rpx 28rpx;
}

.picker-val  { font-size: 28rpx; color: #EEF2FF; }
.picker-arrow { font-size: 36rpx; color: rgba(166, 196, 229, 0.4); }

.body-bar { gap: 24rpx; }

.slider-row { display: flex; flex-direction: column; gap: 12rpx; }

.slider-labels {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.slider-key {
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: rgba(166, 196, 229, 0.4);
}

.slider-val {
  font-size: 32rpx;
  font-weight: 700;
  color: #EEF2FF;
}

.slider-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: rgba(166, 196, 229, 0.4);
}

.slider-value-wrap {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.slider-val-input {
  font-size: 32rpx;
  font-weight: 700;
  color: #EEF2FF;
  text-align: right;
  min-width: 70rpx;
}

.slider-control-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.slider-input { flex: 1; }

.slider-step-btn {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(99, 117, 236, 0.16);
  border: 1rpx solid rgba(99, 117, 236, 0.4);
  color: #6375EC;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.slider-step-btn:active { background: rgba(99, 117, 236, 0.32); }

/* ── Chat input area ── */

.ai-disclaimer {
  flex-shrink: 0;
  text-align: center;
  padding: 8rpx 24rpx 4rpx;
}

.ai-disclaimer-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.3);
  letter-spacing: 0.5rpx;
}

.input-container {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
}

.toolbox-panel {
  background: rgba(11, 28, 46, 0.96);
  border-top: 1rpx solid rgba(99, 117, 236, 0.18);
  padding: 20rpx 24rpx 16rpx;
}

.toolbox-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  background: rgba(99, 117, 236, 0.1);
  border: 1rpx solid rgba(99, 117, 236, 0.28);
  border-radius: 20rpx;
  padding: 18rpx 28rpx;
  min-width: 148rpx;
}

.tool-item-icon {
  font-size: 30rpx;
  color: #6375EC;
  line-height: 1;
}

.tool-item-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #EEF2FF;
  text-align: center;
}

.plus-btn {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  background: rgba(99, 117, 236, 0.12);
  border: 1rpx solid rgba(99, 117, 236, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.plus-btn-open {
  background: rgba(99, 117, 236, 0.3);
  border-color: #6375EC;
}

.plus-icon {
  font-size: 40rpx;
  color: #A6C4E5;
  line-height: 1;
}

.plus-btn-open .plus-icon {
  color: var(--info-pale);
}

.input-area {
  flex-shrink: 0;
  background: rgba(11, 28, 46, 0.92);
  border-top: 1rpx solid rgba(99, 117, 236, 0.18);
  padding: 20rpx 24rpx;
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}

.chat-textarea {
  flex: 1;
  background: #162E4A;
  border: 1rpx solid rgba(99, 117, 236, 0.22);
  border-radius: 24rpx;
  font-size: 28rpx;
  padding: 18rpx 24rpx;
  color: #EEF2FF;
  min-height: 80rpx;
  max-height: 200rpx;
  line-height: 1.45;
}

.textarea-ph { color: rgba(166, 196, 229, 0.4); }

.send-btn {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  background: rgba(99, 117, 236, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.send-active {
  background: linear-gradient(135deg, #6375EC 0%, #8B9FFF 100%);
  box-shadow: 0 4rpx 20rpx rgba(99, 117, 236, 0.45);
}

.send-icon {
  font-size: 36rpx;
  color: #fff;
}

.mic-btn {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  background: rgba(99, 117, 236, 0.12);
  border: 1rpx solid rgba(99, 117, 236, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mic-btn-active {
  background: linear-gradient(135deg, #E25858 0%, #FF7A7A 100%);
  border-color: transparent;
  box-shadow: 0 4rpx 20rpx rgba(226, 88, 88, 0.45);
}

.mic-btn-disabled {
  opacity: 0.4;
}

.mic-icon {
  width: 36rpx;
  height: 36rpx;
}

.mic-recording-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(226, 88, 88, 0.12);
  border-top: 1rpx solid rgba(226, 88, 88, 0.3);
  padding: 14rpx 24rpx;
}

.mic-recording-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #E25858;
}

.mic-recording-text {
  font-size: 24rpx;
  color: var(--danger-pale);
}

/* ── Loading states (used across tabs) ── */

.center-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 80rpx 0;
}

.pulse-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #6375EC;
  animation: pulse-dot 1.2s ease-in-out infinite;
}

.pulse-dot:nth-child(2) { animation-delay: 0.2s; }
.pulse-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes pulse-dot { 0%, 80%, 100% { opacity: 0.2; } 40% { opacity: 1; } }

/* ── Dots tab ── */

/* Cartridge panel */
.cart-section {
  flex-shrink: 0;
  padding: 18rpx 32rpx 0;
}

.cart-section-hdr {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.cart-section-title {
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 1.5rpx;
  text-transform: uppercase;
  color: rgba(166, 196, 229, 0.4);
}

.cart-sim-btn {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(99, 117, 236, 0.15);
  border: 1rpx solid rgba(99, 117, 236, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cart-sim-btn-icon {
  font-size: 22rpx;
  font-weight: 300;
  color: #6375EC;
  line-height: 1;
  margin-top: -2rpx;
}

.cart-loading {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  align-items: center;
  height: 64rpx;
}

/* 9 slots per row, 2 rows.
   Usable width = 750 - 64 (padding) = 686rpx.
   8 gaps × 4rpx = 32rpx  →  slot = (686-32)/9 ≈ 72rpx, capped smaller below for a compact card. */
.cart-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 4rpx;
}

.cart-slot {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  width: 46rpx;
}

.cart-slot-empty {
  opacity: 0.35;
}

.ink-bar-wrap {
  width: 28rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.10);
  border-radius: 6rpx;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
}

.ink-bar-fill {
  width: 100%;
  border-radius: 5rpx;
  min-height: 3rpx;
  transition: height 0.4s ease;
}

.cart-key {
  font-size: 13rpx;
  font-weight: 700;
  color: #A6C4E5;
  letter-spacing: 0.3rpx;
}

.cart-remaining {
  font-size: 11rpx;
  color: rgba(166, 196, 229, 0.4);
}

.cart-empty {
  font-size: 18rpx;
  color: rgba(166, 196, 229, 0.35);
  padding: 8rpx 0 4rpx;
  line-height: 1.5;
}

.dots-header {
  flex-shrink: 0;
  padding: 28rpx 36rpx 20rpx;
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.dots-week-label {
  font-size: 22rpx;
  color: rgba(166, 196, 229, 0.5);
  font-weight: 500;
}

.dots-week-nav {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.dots-week-arrow {
  font-size: 40rpx;
  font-weight: 700;
  color: rgba(166, 196, 229, 0.7);
  min-width: 64rpx;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dots-week-arrow-disabled {
  color: rgba(166, 196, 229, 0.2);
}

.order-dots-card {
  margin: 24rpx 36rpx 20rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: rgba(245, 197, 106, 0.08);
  border: 2rpx solid rgba(245, 197, 106, 0.3);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 10rpx;
}
.order-dots-title {
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(245, 197, 106, 0.95);
  line-height: 1.5;
}
.order-dots-detail {
  font-size: 22rpx;
  color: rgba(245, 197, 106, 0.6);
}
.order-dots-btn {
  margin-top: 14rpx;
  height: 68rpx;
  padding: 0 40rpx;
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(245, 197, 106, 0.18);
  border: 2rpx solid rgba(245, 197, 106, 0.5);
}
.order-dots-btn-text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--gold);
  letter-spacing: 1rpx;
}

.dots-title {
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: rgba(166, 196, 229, 0.4);
}

.dots-scroll {
  /* scroll-view (scroll-x) doesn't auto-size to its flex-row content's intrinsic height in
     this environment — without an explicit height it silently collapses to ~10rpx, clipping
     every day-card. Sized generously (all ~18 formulary dots active in one slot, 4 chips/row)
     rather than to any single day's actual content, so a busier day never clips. */
  flex-shrink: 0;
  padding: 0 0 20rpx;
  height: 640rpx;
}

.dots-days {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  padding: 0 28rpx;
}

.day-card {
  flex-shrink: 0;
  width: 70vw;
  background: #0F2540;
  border: 1rpx solid rgba(99, 117, 236, 0.18);
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
}

.day-today {
  border-color: rgba(99, 117, 236, 0.55);
  background: rgba(99, 117, 236, 0.08);
}

.day-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #A6C4E5;
  margin-bottom: 20rpx;
  display: block;
}

.day-today .day-label { color: #6375EC; }

.meal-slot { margin-bottom: 16rpx; }
.meal-slot:last-child { margin-bottom: 0; }
.meal-slot-active {
  background: rgba(99, 117, 236, 0.1);
  border: 1rpx solid rgba(99, 117, 236, 0.35);
  border-radius: 16rpx;
  padding: 12rpx 14rpx;
  margin-left: -14rpx;
  margin-right: -14rpx;
}

.meal-name {
  font-size: 20rpx;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  color: rgba(166, 196, 229, 0.4);
  display: block;
  margin-bottom: 10rpx;
}

.dot-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.dot-chip {
  flex: 0 0 100rpx;
  display: flex;
  align-items: center;
  gap: 5rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 14rpx;
  padding: 5rpx 8rpx;
}

.dot-swatch {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.dot-key   { font-size: 18rpx; font-weight: 700; color: #EEF2FF; letter-spacing: 0.3rpx; }
.dot-count { font-size: 18rpx; color: rgba(166, 196, 229, 0.4); }

.dots-empty {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 64rpx 56rpx;
  font-size: 26rpx;
  color: rgba(166, 196, 229, 0.4);
  line-height: 1.6;
  text-align: center;
}

/* ── Dispense section ──────────────────────────────────────────────────── */
.dispense-section {
  display: flex;
  justify-content: center;
  padding: 40rpx 28rpx 16rpx;
}
.dispense-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #7B8FF5 0%, #5A6AE8 50%, #4352D1 100%);
  box-shadow: 0 8rpx 32rpx rgba(99, 117, 236, 0.45), 0 2rpx 8rpx rgba(0, 0, 0, 0.25);
  position: relative;
  overflow: hidden;
}
.dispense-btn-gloss {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 48rpx;
  background: linear-gradient(180deg, rgba(255,255,255,0.12) 0%, rgba(255,255,255,0) 100%);
  border-radius: 24rpx 24rpx 0 0;
}
.dispense-btn-loading {
  opacity: 0.55;
  box-shadow: none;
}
.dispense-btn-done {
  background: linear-gradient(135deg, #4CD98A 0%, #27AE60 100%);
  box-shadow: 0 8rpx 32rpx rgba(46, 204, 113, 0.4), 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}
.dispense-btn-error {
  background: linear-gradient(135deg, #F06060 0%, #C0392B 100%);
  box-shadow: 0 8rpx 32rpx rgba(231, 76, 60, 0.4), 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}
.dispense-btn-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
  line-height: 1;
  position: relative;
  z-index: 1;
}

/* ── Store tab ── */

.store-header {
  display: flex;
  flex-shrink: 0;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  padding: 28rpx 36rpx 20rpx;
}

.store-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #EEF2FF;
}

.store-header-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.store-credit-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 18rpx;
  position: relative;
  overflow: hidden;
  padding: 18rpx 28rpx 18rpx 22rpx;
  background: linear-gradient(150deg, #1D3565 0%, #162E4A 100%);
  border: 1rpx solid rgba(139, 159, 255, 0.45);
  border-radius: 26rpx;
  box-shadow: 0 8rpx 32rpx rgba(99, 117, 236, 0.35), inset 0 1rpx 0 rgba(255, 255, 255, 0.07);
}

.store-credit-card-glow {
  position: absolute;
  top: -28rpx;
  right: -28rpx;
  width: 110rpx;
  height: 110rpx;
  background: radial-gradient(circle, rgba(139, 159, 255, 0.22) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.store-credit-card-icon {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  filter: drop-shadow(0 2rpx 8rpx rgba(99, 117, 236, 0.5));
}

.store-credit-card-body {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.store-credit-card-amount-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.store-credit-card-num {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1;
  color: #ffffff;
  letter-spacing: -1rpx;
}

.store-credit-card-unit {
  font-size: 18rpx;
  font-weight: 600;
  color: rgba(160, 180, 255, 0.65);
  margin-bottom: 4rpx;
}

.store-credit-card-label {
  font-size: 13rpx;
  font-weight: 700;
  letter-spacing: 2.5rpx;
  color: rgba(139, 159, 255, 0.55);
  margin-top: 6rpx;
}

.theme-light .store-credit-card {
  background: linear-gradient(150deg, rgba(99, 117, 236, 0.12) 0%, rgba(99, 117, 236, 0.04) 100%);
  border-color: rgba(99, 117, 236, 0.3);
  box-shadow: 0 4rpx 20rpx rgba(99, 117, 236, 0.12);
}

.theme-light .store-credit-card-num { color: #1e2c8a; }
.theme-light .store-credit-card-unit { color: #4A58C8; }
.theme-light .store-credit-card-label { color: #5B67C9; }

.store-scroll {
  flex: 1;
  height: 0;
}

.store-list {
  padding: 8rpx 28rpx 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.store-card {
  background: #0F2540;
  border: 1rpx solid rgba(99, 117, 236, 0.18);
  border-radius: 28rpx;
  padding: 32rpx 28rpx 28rpx;
  position: relative;
  overflow: hidden;
}

.store-tag {
  position: absolute;
  top: 0;
  right: 0;
  background: linear-gradient(135deg, #6375EC, #8B9FFF);
  border-bottom-left-radius: 16rpx;
  padding: 8rpx 20rpx;
}

.store-tag-text {
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #fff;
}

.store-card-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #EEF2FF;
  display: block;
  margin-bottom: 12rpx;
  padding-right: 100rpx;
}

.store-card-desc {
  font-size: 24rpx;
  color: rgba(166, 196, 229, 0.55);
  line-height: 1.5;
  display: block;
  margin-bottom: 32rpx;
}

.store-card-desc-rich {
  width: 100%;
  word-break: break-word;
}

.store-variants {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.store-variant-pill {
  border: 1rpx solid rgba(99, 117, 236, 0.35);
  border-radius: 40rpx;
  padding: 10rpx 28rpx;
  background: rgba(99, 117, 236, 0.06);
}

.store-variant-pill-active {
  border-color: #6375EC;
  background: rgba(99, 117, 236, 0.22);
}

.store-variant-label {
  font-size: 24rpx;
  color: #a5b4fc;
  font-weight: 600;
}

.store-variant-pill-active .store-variant-label {
  color: #eef2ff;
}

.store-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.store-price-wrap {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.store-price {
  font-size: 44rpx;
  font-weight: 800;
  color: #EEF2FF;
  line-height: 1;
}

.store-unit {
  font-size: 22rpx;
  color: rgba(166, 196, 229, 0.4);
}

.store-price-wrap-partner {
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
}

.store-partner-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.store-partner-badge {
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(99, 117, 236, 0.22);
  align-self: center;
}

.store-partner-badge-text {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--info-pale);
}

.store-price-partner {
  color: var(--info-pale);
}

.store-price-regular {
  font-size: 24rpx;
  color: rgba(166, 196, 229, 0.4);
  text-decoration: line-through;
}

.store-buy-btn {
  background: linear-gradient(135deg, #6375EC 0%, #8B9FFF 100%);
  border-radius: 24rpx;
  padding: 22rpx 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(99, 117, 236, 0.45);
}

.store-buy-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 0.5rpx;
}

/* ── Store subtabs ── */

.store-subtab-row {
  flex-shrink: 0;
  display: flex;
  gap: 12rpx;
  padding: 0 28rpx 20rpx;
}

.store-subtab-btn {
  padding: 14rpx 32rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(99, 117, 236, 0.3);
  background: rgba(99, 117, 236, 0.06);
  color: rgba(166, 196, 229, 0.5);
  font-size: 24rpx;
  font-weight: 600;
}

.store-subtab-active {
  background: linear-gradient(135deg, #6375EC 0%, #8B9FFF 100%);
  border-color: transparent;
  color: #fff;
}

/* ── Order cards ── */

.order-card {
  background: #0F2540;
  border: 1rpx solid rgba(99, 117, 236, 0.18);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.order-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.order-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #EEF2FF;
  flex: 1;
}

.order-status {
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.order-status-pending   { background: rgba(245,158,11,0.15); color: var(--warn); }
.order-status-confirmed { background: rgba(59,130,246,0.15); color: #60a5fa; }
.order-status-shipped   { background: rgba(139,92,246,0.15); color: #a78bfa; }
.order-status-delivered { background: rgba(16,185,129,0.15); color: var(--success); }
.order-status-cancelled { background: rgba(100,116,139,0.12); color: #94a3b8; }

.order-card-mid {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.order-price {
  font-size: 32rpx;
  font-weight: 800;
  color: #EEF2FF;
}

.order-meta {
  font-size: 22rpx;
  color: rgba(166, 196, 229, 0.4);
}

.order-date {
  font-size: 20rpx;
  color: rgba(166, 196, 229, 0.3);
}

.order-date-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-delivery-info {
  background: rgba(99, 117, 236, 0.05);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-top: 10rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.delivery-row {
  display: flex;
  font-size: 22rpx;
  line-height: 32rpx;
}

.delivery-label {
  color: rgba(166, 196, 229, 0.5);
  width: 120rpx;
  flex-shrink: 0;
}

.delivery-val {
  color: #EEF2FF;
  flex: 1;
  word-break: break-all;
}

.tracking-section {
  border-top: 1rpx solid rgba(99, 117, 236, 0.1);
  padding-top: 8rpx;
  margin-top: 4rpx;
}

.tracking-val-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.copy-badge {
  background: rgba(99, 117, 236, 0.18);
  color: #8fa0f8;
  font-size: 18rpx;
  font-weight: 700;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  line-height: 24rpx;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
}

.cancel-order-btn {
  border: 1rpx solid rgba(239, 68, 68, 0.35);
  border-radius: 12rpx;
  padding: 8rpx 24rpx;
  background: rgba(239, 68, 68, 0.05);
}

.cancel-order-btn text {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--danger);
}

/* ── Cart ── */

.store-cart-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.store-cart-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 40rpx;
  height: 40rpx;
  padding: 0 10rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #6375EC, #8B9FFF);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
}

.cart-stepper {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.stepper-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 26rpx;
  border: 1rpx solid rgba(99, 117, 236, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(99, 117, 236, 0.08);
}

.stepper-sym {
  font-size: 26rpx;
  font-weight: 700;
  color: #8fa0f8;
  line-height: 1;
}

.stepper-qty {
  font-size: 30rpx;
  font-weight: 700;
  color: #EEF2FF;
  min-width: 32rpx;
  text-align: center;
}

.cart-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #0a1c34;
  border-top: 1rpx solid rgba(99, 117, 236, 0.2);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
  z-index: 10;
}

.cart-bar-label {
  font-size: 24rpx;
  color: rgba(166, 196, 229, 0.6);
}

.cart-bar-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
}

.cart-bar-total {
  font-size: 32rpx;
  font-weight: 700;
  color: #EEF2FF;
}

.cart-bar-btn {
  background: linear-gradient(135deg, #6375EC, #8B9FFF);
  border-radius: 20rpx;
  padding: 14rpx 36rpx;
}

.cart-bar-btn-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
}

.cart-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(5, 15, 30, 0.75);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  z-index: 200;
}

.cart-sheet {
  background: #0d2040;
  border-top-left-radius: 36rpx;
  border-top-right-radius: 36rpx;
  border: 1rpx solid rgba(99, 117, 236, 0.2);
  display: flex;
  flex-direction: column;
  max-height: 70vh;
}

.cart-sheet-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 20rpx;
  border-bottom: 1rpx solid rgba(99, 117, 236, 0.12);
}

.cart-sheet-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #EEF2FF;
}

.cart-close-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cart-close-sym {
  font-size: 28rpx;
  color: rgba(166, 196, 229, 0.5);
}

.cart-sheet-scroll {
  flex: 1;
}

.cart-empty-row {
  padding: 48rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cart-empty-text {
  font-size: 26rpx;
  color: rgba(166, 196, 229, 0.4);
}

.cart-item-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid rgba(99, 117, 236, 0.08);
}

.cart-item-info {
  flex: 1;
  margin-right: 20rpx;
}

.cart-item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #EEF2FF;
  display: block;
  margin-bottom: 6rpx;
}

.cart-item-price {
  font-size: 24rpx;
  color: rgba(166, 196, 229, 0.55);
}

.cart-stepper-sm .stepper-btn {
  width: 48rpx;
  height: 48rpx;
}

.cart-sheet-footer {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid rgba(99, 117, 236, 0.12);
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.cart-total-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #EEF2FF;
}

.cart-checkout-btn {
  background: linear-gradient(135deg, #6375EC, #8B9FFF);
  border-radius: 20rpx;
  padding: 16rpx 44rpx;
  box-shadow: 0 4rpx 20rpx rgba(99, 117, 236, 0.35);
}

.cart-checkout-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}

/* ── Checkout address form ── */

.checkout-addr-form {
  padding: 24rpx 32rpx 16rpx;
  border-top: 1rpx solid rgba(99, 117, 236, 0.12);
  margin-top: 8rpx;
}

.checkout-addr-hdr {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.checkout-addr-title {
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(166, 196, 229, 0.7);
  letter-spacing: 0.5rpx;
}

.checkout-wx-addr-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: rgba(99, 117, 236, 0.15);
  border: 1rpx solid rgba(99, 117, 236, 0.35);
  border-radius: 24rpx;
  padding: 8rpx 20rpx;
}

.checkout-wx-addr-icon {
  font-size: 22rpx;
  margin-right: 6rpx;
}

.checkout-wx-addr-text {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--info-pale);
}

.checkout-addr-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 16rpx;
}

.checkout-addr-row-tall {
  align-items: flex-start;
}

.checkout-addr-label {
  font-size: 24rpx;
  color: rgba(166, 196, 229, 0.6);
  width: 140rpx;
  flex-shrink: 0;
}

.checkout-addr-input {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.4;
  min-height: 72rpx;
  box-sizing: border-box;
  color: #EEF2FF;
  background: rgba(99, 117, 236, 0.08);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid rgba(99, 117, 236, 0.18);
}

.checkout-addr-textarea {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.4;
  min-height: 96rpx;
  box-sizing: border-box;
  color: #EEF2FF;
  background: rgba(99, 117, 236, 0.08);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid rgba(99, 117, 236, 0.18);
}

/* ── Kino chip scan ── */

.kino-scan-bar {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  position: relative;
}

.kino-scan-close {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.5);
  font-size: 32rpx;
}

.kino-scan-btn {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #6375EC;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 56rpx;
  border-radius: 48rpx;
  box-shadow: 0 4rpx 24rpx rgba(99, 117, 236, 0.5);
}

.kino-scan-icon {
  font-size: 36rpx;
}

.kino-scan-label {
  font-size: 30rpx;
  font-weight: 600;
}

/* ── Cartridge Sim Overlay ── */

.csim-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 100;
  background: rgba(6, 15, 25, 0.75);
  display: flex;
  align-items: flex-end;
}

.csim-sheet {
  width: 100%;
  background: #0D1E35;
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  padding: 20rpx 36rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.csim-handle {
  width: 64rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: rgba(166, 196, 229, 0.2);
  margin-bottom: 32rpx;
}

.csim-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #EEF2FF;
  margin-bottom: 8rpx;
}

.csim-subtitle {
  font-size: 20rpx;
  color: rgba(166, 196, 229, 0.4);
  margin-bottom: 36rpx;
  letter-spacing: 0.5rpx;
}

.csim-sets {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.csim-set-card {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid transparent;
  border-radius: 20rpx;
  overflow: hidden;
}

.csim-set-accent {
  width: 8rpx;
  flex-shrink: 0;
}

.csim-set-body {
  flex: 1;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.csim-set-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #EEF2FF;
}

.csim-set-desc {
  font-size: 20rpx;
  color: rgba(166, 196, 229, 0.5);
}

.csim-dot-badges {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.csim-dot-badge {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 8rpx;
  padding: 5rpx 12rpx 5rpx 10rpx;
}

.csim-badge-key {
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 0.5rpx;
}

.csim-badge-name {
  font-size: 17rpx;
  color: rgba(166, 196, 229, 0.55);
  letter-spacing: 0.5rpx;
}

.csim-loading {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  align-items: center;
  margin-bottom: 20rpx;
}

.csim-cancel {
  margin-top: 4rpx;
  padding: 16rpx 48rpx;
  font-size: 26rpx;
  color: rgba(166, 196, 229, 0.4);
}

/* ── Kino Passcode Overlay ── */

.kpass-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 101;
  background: rgba(6, 15, 25, 0.96);
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* Opened on top of the guest-sheet-mask (z-index: 300), unlike the Kino passcode
   overlay which only ever opens while the guest sheet is closed. */
.guest-pass-overlay { z-index: 400; }

.kpass-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding: 0 80rpx;
}

.kpass-logo {
  font-size: 72rpx;
  color: #6375EC;
  margin-bottom: 20rpx;
}

.kpass-title {
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  color: #A6C4E5;
  margin-bottom: 48rpx;
}

.kpass-dots {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.kpass-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(99, 117, 236, 0.5);
  background: transparent;
  margin: 0 18rpx;
  transition: background 0.15s;
}

.kpass-dot-filled {
  background: #6375EC;
  border-color: #6375EC;
}

.kpass-dot-error {
  background: #E86060;
  border-color: #E86060;
  animation: kpass-shake 0.4s ease;
}

.kpass-error {
  font-size: 24rpx;
  color: var(--danger-muted);
  height: 36rpx;
  line-height: 36rpx;
}

.kpass-numpad {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  width: 100%;
  margin-top: 16rpx;
  margin-bottom: 40rpx;
}

.kpass-key {
  width: 160rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 8rpx 12rpx;
  border-radius: 20rpx;
  background: rgba(99, 117, 236, 0.1);
  border: 1rpx solid rgba(99, 117, 236, 0.2);
  font-size: 40rpx;
  font-weight: 500;
  color: #EEF2FF;
}

.kpass-key-empty {
  background: transparent;
  border-color: transparent;
}

.kpass-key-del {
  background: rgba(99, 117, 236, 0.06);
}

.kpass-del-icon {
  font-size: 36rpx;
  color: #A6C4E5;
}

.kpass-cancel {
  font-size: 26rpx;
  color: rgba(166, 196, 229, 0.4);
  padding: 16rpx 40rpx;
}

@keyframes kpass-shake {
  0%, 100% { transform: translateX(0); }
  20%       { transform: translateX(-8rpx); }
  60%       { transform: translateX(8rpx); }
}

/* ── Kino Simulator Overlay ── */

.ksm-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 100;
  background: radial-gradient(ellipse at 50% 0%, #1a3155 0%, #0B1C2E 65%);
  display: flex;
  flex-direction: column;
}

.ksm-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.ksm-header {
  background: rgba(11, 28, 46, 0.7);
  border-bottom: 1rpx solid rgba(99, 117, 236, 0.18);
  padding: 20rpx 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}

.ksm-title {
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: #EEF2FF;
}

.ksm-serial {
  display: block;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: #4a5568;
  margin-top: 4rpx;
}

.ksm-close {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  border: 1rpx solid rgba(99, 117, 236, 0.3);
  background: rgba(99, 117, 236, 0.1);
  color: #A6C4E5;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* scroll-view must not have flex/gap — use an inner wrapper instead */
.ksm-body {
  flex: 1;
}

.ksm-body-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 44rpx 48rpx;
}

/* ── Device ring ── */

.ksm-ring-row {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-bottom: 36rpx;
}

.ksm-device-wrap {
  position: relative;
  width: 340rpx;
  height: 340rpx;
  flex-shrink: 0;
}

.ksm-ring-track {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border-radius: 50%;
  background: conic-gradient(
    #6375EC 0deg,
    #A6C4E5 90deg,
    rgba(15, 37, 64, 0.6) 180deg,
    #6375EC 360deg
  );
  animation: ksm-ring-spin 10s linear infinite;
}

.ksm-state-analyzing .ksm-ring-track {
  animation-duration: 1.8s;
  background: conic-gradient(
    #6375EC 0deg,
    #c0caff 60deg,
    #6375EC 120deg,
    rgba(15, 37, 64, 0.3) 200deg,
    #6375EC 360deg
  );
}

.ksm-state-complete .ksm-ring-track {
  animation-duration: 5s;
  background: conic-gradient(
    #1A8A6A 0deg,
    #6FDFB8 80deg,
    rgba(15, 37, 64, 0.5) 180deg,
    #1A8A6A 360deg
  );
}

.ksm-state-failed .ksm-ring-track {
  animation: none;
  background: conic-gradient(
    #E86060 0deg,
    #FFB3B3 60deg,
    rgba(15, 37, 64, 0.5) 160deg,
    #E86060 360deg
  );
}

.ksm-ring-face {
  position: absolute;
  top: 16rpx; left: 16rpx; right: 16rpx; bottom: 16rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 4rpx 24rpx rgba(99, 117, 236, 0.06),
              0 8rpx 48rpx rgba(99, 117, 236, 0.18);
}

.ksm-state-analyzing .ksm-ring-face {
  animation: ksm-face-pulse 1.8s ease-in-out infinite;
}

.ksm-face-static,
.ksm-face-slide {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ksm-face-slide {
  opacity: 0;
  transition: opacity 0.3s ease;
}

.ksm-slide-visible { opacity: 1; }

.ksm-face-label {
  font-size: 16rpx;
  letter-spacing: 6rpx;
  color: rgba(26, 62, 95, 0.4);
  margin-bottom: 4rpx;
}

.ksm-face-status {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A3E5F;
}

.ksm-face-status-analyzing { color: #6375EC; animation: ksm-text-pulse 1.8s ease-in-out infinite; }
.ksm-face-status-complete  { color: #1A8A6A; }
.ksm-face-status-failed    { color: var(--danger-muted); }

.ksm-debug-toggle {
  margin: 16rpx 32rpx 0;
  padding: 12rpx 0;
  text-align: center;
}
.ksm-debug-toggle-text {
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: rgba(26, 62, 95, 0.3);
}

.ksm-debug-box {
  margin: 8rpx 32rpx 0;
  background: rgba(0, 0, 0, 0.55);
  border: 1rpx solid rgba(232, 96, 96, 0.4);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}
.ksm-debug-label {
  display: block;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--danger-muted);
  margin-bottom: 12rpx;
}
.ksm-debug-msg {
  display: block;
  font-size: 20rpx;
  color: var(--danger-pale);
  font-family: monospace;
  word-break: break-all;
  white-space: pre-wrap;
  line-height: 1.5;
}

.ksm-face-patient-label {
  font-size: 14rpx;
  letter-spacing: 4rpx;
  color: rgba(26, 62, 95, 0.35);
  margin-top: 10rpx;
  margin-bottom: 2rpx;
}

.ksm-face-user {
  font-size: 22rpx;
  color: #6375EC;
  font-weight: 500;
  margin-top: 10rpx;
}

.ksm-slide-index {
  font-size: 16rpx;
  letter-spacing: 2rpx;
  color: rgba(26, 62, 95, 0.35);
  margin-bottom: 6rpx;
}

.ksm-slide-label {
  font-size: 18rpx;
  letter-spacing: 3rpx;
  color: rgba(26, 62, 95, 0.5);
  text-transform: uppercase;
  margin-bottom: 4rpx;
}

.ksm-slide-val {
  font-size: 48rpx;
  font-weight: 700;
  color: #1A8A6A;
  line-height: 1;
}

.ksm-slide-unit {
  font-size: 18rpx;
  color: rgba(26, 62, 95, 0.4);
  margin-top: 4rpx;
}

/* ── Results panel ── */

.ksm-results {
  width: 100%;
  background: #0F2540;
  border: 1rpx solid rgba(99, 117, 236, 0.18);
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
}

.ksm-tabs {
  display: flex;
  border-bottom: 1rpx solid rgba(99, 117, 236, 0.18);
}

.ksm-tab {
  flex: 1;
  padding: 22rpx 0;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(166, 196, 229, 0.4);
}

.ksm-tab-active {
  color: #6375EC;
  background: rgba(99, 117, 236, 0.06);
  border-bottom: 4rpx solid #6375EC;
}

.ksm-tab-content {
  padding: 24rpx 28rpx;
}

.ksm-bioage-row {
  display: flex;
  margin-bottom: 20rpx;
}

.ksm-bioage-chip {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #162E4A;
  border: 1rpx solid rgba(99, 117, 236, 0.18);
  border-radius: 18rpx;
  padding: 20rpx 8rpx 16rpx;
  margin-right: 14rpx;
}

.ksm-bioage-chip:last-child { margin-right: 0; }

.ksm-bioage-chip-dim { background: rgba(11, 28, 46, 0.5); }

.ksm-bioage-num {
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1;
}

.ksm-bioage-chip-label {
  font-size: 14rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: rgba(166, 196, 229, 0.4);
  margin-top: 10rpx;
}

.ksm-sub-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(99, 117, 236, 0.08);
}

.ksm-sub-row:last-child { border-bottom: none; }

.ksm-sub-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 14rpx;
}

.ksm-sub-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #A6C4E5;
  flex: 1;
}

.ksm-sub-val {
  font-size: 26rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.ksm-bm-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(99, 117, 236, 0.08);
}

.ksm-bm-row:last-child { border-bottom: none; }

.ksm-bm-label {
  font-size: 24rpx;
  color: #A6C4E5;
  flex: 1;
}

.ksm-bm-val {
  font-size: 26rpx;
  font-weight: 600;
  color: #EEF2FF;
}

.ksm-bm-unit {
  font-size: 20rpx;
  font-weight: 400;
  color: rgba(166, 196, 229, 0.4);
}

/* ── Action button ── */

.ksm-btn {
  width: 100%;
  padding: 28rpx 0;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #6375EC 0%, #7B8FFF 100%);
  box-shadow: 0 8rpx 40rpx rgba(99, 117, 236, 0.45);
}

.ksm-btn-complete {
  background: linear-gradient(135deg, #1A8A6A 0%, #2DBF8A 100%);
  box-shadow: 0 8rpx 40rpx rgba(26, 138, 106, 0.45);
}

.ksm-btn-failed {
  background: linear-gradient(135deg, #C03030 0%, #E86060 100%);
  box-shadow: 0 8rpx 40rpx rgba(232, 96, 96, 0.45);
}

.ksm-btn-analyzing { opacity: 0.7; }

.ksm-quit-btn {
  margin-top: 24rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  color: rgba(166, 196, 229, 0.5);
}

.ksm-dots-row {
  display: flex;
  align-items: center;
}

.ksm-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  animation: ksm-dot-bounce 1.2s ease-in-out infinite;
  margin-right: 10rpx;
}

.ksm-dot:last-child { margin-right: 0; }
.ksm-dot:nth-child(2) { animation-delay: 0.2s; }
.ksm-dot:nth-child(3) { animation-delay: 0.4s; }

/* ── Animations ── */

@keyframes ksm-ring-spin {
  to { transform: rotate(360deg); }
}

@keyframes ksm-face-pulse {
  0%, 100% { box-shadow: inset 0 4rpx 24rpx rgba(99,117,236,0.08), 0 8rpx 64rpx rgba(99,117,236,0.35); }
  50%       { box-shadow: inset 0 4rpx 24rpx rgba(99,117,236,0.08), 0 8rpx 100rpx rgba(99,117,236,0.35); }
}

@keyframes ksm-text-pulse {
  0%, 100% { opacity: 1; }
  50%       { opacity: 0.45; }
}

@keyframes ksm-dot-bounce {
  0%, 80%, 100% { transform: scale(0.7); opacity: 0.4; }
  40%            { transform: scale(1.2); opacity: 1; }
}

/* ════════════════════════════════════════════════════════
   LIGHT THEME OVERRIDES
   Applied when .main has class "theme-light"
   ════════════════════════════════════════════════════════ */

/* ── Layout ── */
.theme-light.main {
  background: var(--bg-gradient);
}

/* ── Header ── */
.theme-light .status-bar-spacer {
  background: var(--bg-surface);
}
.theme-light .app-header {
  background: var(--bg-surface);
  border-bottom-color: var(--navy-border);
}
.theme-light .header-title  { color: var(--text); }
.theme-light .header-user   { color: var(--text-sub); }
.theme-light .header-divider { background: rgba(201, 149, 106, 0.25); }

/* ── Menu ── */
.theme-light .menu-dropdown {
  background: var(--navy-card);
  border-color: rgba(201, 149, 106, 0.25);
  box-shadow: 0 8rpx 40rpx rgba(44, 44, 44, 0.12);
}
.theme-light .menu-divider    { background: rgba(201, 149, 106, 0.15); }
.theme-light .menu-item-icon  { color: var(--text-sub); }
.theme-light .menu-item-label { color: var(--text); }

/* ── Tab bar ── */
.theme-light .tab-bar {
  background: var(--bg-tabbar);
  border-top-color: var(--navy-border);
}
.theme-light .tab-label              { color: var(--text-muted); }
.theme-light .tab-active .tab-label  { color: var(--blue); }
.theme-light .tab-icon-img           { filter: brightness(0); opacity: 0.3; }
.theme-light .tab-active .tab-icon-img { filter: brightness(0); opacity: 0.75; }

/* ── Chat messages ── */
.theme-light .message-ai {
  background: var(--navy-lift);
  color: var(--text);
  border-color: rgba(201, 149, 106, 0.2);
}
.theme-light .message-coach {
  background: rgba(16, 185, 129, 0.08);
  color: var(--text);
  border-color: rgba(16, 185, 129, 0.25);
}
.theme-light .chat-history-text       { color: #667188; }
.theme-light .chat-history-start-text { color: #697183; }
.theme-light .chat-history-spinner,
.theme-light .chat-refresher-spinner  { border-color: rgba(60,80,120,0.15); border-top-color: rgba(60,80,120,0.55); }
.theme-light .msg-coach-label { color: #076646; }
.theme-light .msg-ag-label { color: #2942E5; }
.theme-light .msg-action-card {
