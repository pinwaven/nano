  background: rgba(201, 149, 106, 0.12);
  border-color: rgba(201, 149, 106, 0.35);
}
.theme-light .checkout-wx-addr-text { color: var(--blue); }
.theme-light .checkout-addr-label   { color: var(--text-muted); }
.theme-light .checkout-addr-input,
.theme-light .checkout-addr-textarea {
  color: var(--text);
  background: rgba(201, 149, 106, 0.06);
  border-color: rgba(201, 149, 106, 0.18);
