  background: rgba(var(--blue-rgb), 0.06);
  border-color: rgba(201, 149, 106, 0.28);
}
.theme-light .mcard-pill  { background: rgba(0, 0, 0, 0.05); }
.theme-light .tcard {
  background: rgba(var(--blue-rgb), 0.07);
  border-color: rgba(201, 149, 106, 0.32);
  border-left-color: var(--blue);
}
.theme-light .fcard {
  background: rgba(var(--blue-rgb), 0.07);
  border-color: rgba(201, 149, 106, 0.32);
}

.theme-light .dcard-chip {
  background: rgba(var(--blue-rgb), 0.08);
  border-color: rgba(201, 149, 106, 0.32);
}
.theme-light .msg-rule { background: rgba(0, 0, 0, 0.12); }

