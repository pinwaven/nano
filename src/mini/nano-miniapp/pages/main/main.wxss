.theme-light .academy-card-tier-text { color: var(--blue); }
.theme-light .academy-card-credits-num,
.theme-light .academy-card-stat-num  { color: var(--text); }
.theme-light .academy-card-divider   { background: linear-gradient(90deg, transparent, rgba(var(--blue-rgb), 0.3), transparent); }
.theme-light .academy-card-stat-sep  { background: rgba(var(--blue-rgb), 0.18); }

/* ── Learning paths / quiz / certifications ── */
.theme-light .training-path-tier,
.theme-light .training-course-level  { color: #4f46e5; background: rgba(79, 70, 229, 0.12); }
.theme-light .training-path-progress-bar { background: rgba(0, 0, 0, 0.06); }
.theme-light .training-course-credits    { color: #036748; }
.theme-light .training-lesson-credits-label { color: #036748; }
.theme-light .training-text-body     { color: var(--text-sub); }
.theme-light .training-quiz-scenario { color: var(--text-sub); }
.theme-light .training-quiz-option   { background: rgba(0, 0, 0, 0.03); }
.theme-light .training-quiz-option-radio { border-color: var(--text-muted); }
.theme-light .training-quiz-option-radio-checked { border-color: var(--blue); background: var(--blue); }
.theme-light .training-quiz-result-credits { color: #036748; }
.theme-light .training-quiz-review        { border-top-color: rgba(0, 0, 0, 0.08); }
.theme-light .training-quiz-review-item   { border-bottom-color: rgba(0, 0, 0, 0.06); }
.theme-light .training-quiz-review-correct .training-quiz-review-icon { color: #036748; }
.theme-light .training-quiz-review-q          { color: var(--text); }
.theme-light .training-quiz-review-correct-ans { color: #036748; }
.theme-light .training-quiz-review-explanation { color: var(--text-sub); }
.theme-light .cert-status-check { color: #036748; }
.theme-light .cert-status-text  { color: #036748; }
.theme-light .cert-valid  { color: #059669 !important; }
.theme-light .cert-number { color: #4338ca !important; }
.theme-light .cert-download-btn text { color: #4338ca; }

/* ── Wellness tab ── */
.theme-light .sleep-track-card,
.theme-light .media-asset-card,
.theme-light .device-apk-card { border-color: rgba(var(--wave-rgb), 0.1); }
.theme-light .sleep-track-icon      { background: rgba(var(--blue-rgb), 0.18); }
.theme-light .sleep-icon-glyph      { color: var(--blue); }
.theme-light .sleep-track-active-dot { background: var(--blue); }
.theme-light .sleep-now-playing {
  background: rgba(var(--blue-rgb), 0.15);
  border-color: rgba(var(--blue-rgb), 0.3);
}
.theme-light .sleep-np-label   { color: var(--blue); }
.theme-light .sleep-np-btn     { background: rgba(var(--blue-rgb), 0.2); }
.theme-light .sleep-np-btn-icon { color: var(--blue); }
