/* ════════════════════════════════════════════════════════
   Light theme — muted-text contrast fixes (generated)
   The base rules above use low-alpha rgba() tuned for a bright color on dark
   navy. On the cream light surface that same alpha washes out to 1.4-2.1:1,
   and no alpha <= 0.6 can reach 4.5:1 on cream regardless of base color — so
   light theme needs opaque values. Ramp preserves the faint->strong hierarchy.
   ════════════════════════════════════════════════════════ */
.theme-light .chat-history-loading .chat-history-text { color: #5D4C32; }
.theme-light .slider-step-btn { color: #5D4C32; }
.theme-light .order-dots-title { color: var(--gold); }
.theme-light .order-dots-detail { color: var(--gold); }

/* ── Scan-to-activate card (Dots subtab) ──────────────────────────────────────────────
   The box a user receives is compounded for them alone, and scanning it is what starts
   the 28-day cycle — so this sits above the day strip rather than buried in a menu.
   Uses --wave (the same family the Dots surfaces already use) rather than the --gold of
   the order card just above it, so "activate what you have" reads differently from
   "buy something". */
.scan-box-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 24rpx 36rpx 20rpx;
  padding: 28rpx 32rpx;
  border-radius: 24rpx;
  background: rgba(var(--wave-rgb), 0.08);
  border: 2rpx solid rgba(var(--wave-rgb), 0.28);
}
.scan-box-main { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.scan-box-title { font-size: 26rpx; font-weight: 600; color: var(--text); line-height: 1.5; }
.scan-box-detail { font-size: 22rpx; color: var(--text-muted); line-height: 1.5; }
.scan-box-icon { font-size: 40rpx; color: var(--wave); opacity: 0.9; }
.theme-light .scan-box-card {
  background: rgba(var(--wave-rgb), 0.06);
  border-color: rgba(var(--wave-rgb), 0.22);
}

/* :::product — store recommendations Viva appended to a reply. Rows are written by the SERVER
   from the catalog snapshot the turn was built on (handlers/dots.js's _buildProductCardBlock),
   so the price rendered here is the real one by construction. Each row is tappable and opens the
   GCN storefront deep-linked to that sku (handleProductCardTap) — a miniapp cannot open an
   external link from chat prose, so the row itself has to be the affordance. */
.pcard {
  margin: 14rpx 0 18rpx;
  padding: 20rpx 22rpx 12rpx;
  border-radius: 20rpx;
  background: rgba(var(--blue-rgb), 0.10);
  border: 1rpx solid rgba(var(--blue-rgb), 0.26);
}
.pcard-title {
  display: block;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--chat-accent);
  letter-spacing: 1rpx;
  margin-bottom: 14rpx;
}
.pcard-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid rgba(var(--blue-rgb), 0.18);
}
.pcard-row:first-of-type { border-top: none; }
.pcard-main {
  flex: 1;
  min-width: 0;
}
.pcard-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
}
.pcard-reason {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--text-sub);
}
.pcard-price {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--chat-accent);
  white-space: nowrap;
}
.pcard-arrow {
  font-size: 30rpx;
  color: var(--text-sub);
  line-height: 1;
}
