.theme-light .kino-scan-bar {
  background: var(--bg-input);
  border-top-color: var(--navy-border);
}

.theme-light .pulse-dot           { background: var(--blue); }
.theme-light .typing-dot          { background: var(--blue); }

/* Card chrome in the light theme. The semantic border-left-color set by each .mcard-<status>
   rule is deliberately NOT overridden — --success/--warn/--danger/--info/--steel already carry
   the light values audited to >= 4.5:1 in commit c8aa1d6. Only the fills and the neutral
   borders, which were tuned against the dark navy bubble, need adjusting for cream. */
