.theme-light .csim-cancel     { color: var(--text-muted); }

/* ── Kino Passcode overlay ── */
.theme-light .kpass-overlay  { background: var(--bg-gradient); }
.theme-light .kpass-title    { color: var(--text-sub); }
.theme-light .kpass-dot      { border-color: rgba(201, 149, 106, 0.5); }
.theme-light .kpass-key {
  background: rgba(201, 149, 106, 0.08);
  border-color: rgba(201, 149, 106, 0.22);
  color: var(--text);
}
.theme-light .kpass-key-del  { background: rgba(201, 149, 106, 0.05); }
.theme-light .kpass-del-icon { color: var(--text-sub); }
.theme-light .kpass-cancel   { color: var(--text-muted); }

/* ── Kino Simulator overlay ── */
.theme-light .ksm-overlay  { background: var(--bg-gradient); }
.theme-light .ksm-header   { background: var(--bg-surface); border-bottom-color: var(--navy-border); }
.theme-light .ksm-title    { color: var(--text); }
.theme-light .ksm-serial   { color: var(--text-muted); }
.theme-light .ksm-close {
  border-color: rgba(201, 149, 106, 0.3);
  background: rgba(201, 149, 106, 0.1);
  color: var(--text-sub);
}
.theme-light .ksm-results  { background: var(--navy-card); border-color: rgba(201, 149, 106, 0.18); }
.theme-light .ksm-tabs     { border-bottom-color: rgba(201, 149, 106, 0.18); }
.theme-light .ksm-tab      { color: var(--text-muted); }
.theme-light .ksm-tab-active {
  color: var(--blue);
  background: rgba(201, 149, 106, 0.08);
  border-bottom-color: var(--blue);
}
.theme-light .ksm-bioage-chip     { background: var(--navy-lift); border-color: rgba(201, 149, 106, 0.18); }
.theme-light .ksm-bioage-chip-dim { background: rgba(250, 247, 242, 0.5); }
.theme-light .ksm-bioage-chip-label { color: var(--text-muted); }
.theme-light .ksm-sub-row,
.theme-light .ksm-bm-row   { border-bottom-color: rgba(201, 149, 106, 0.08); }
.theme-light .ksm-sub-label,
.theme-light .ksm-bm-label { color: var(--text-sub); }
.theme-light .ksm-bm-val   { color: var(--text); }
.theme-light .ksm-bm-unit  { color: var(--text-muted); }
.theme-light .ksm-quit-btn { color: var(--text-muted); }

/* ── Certificate modal ── */
.theme-light .cert-field { border-bottom-color: rgba(201, 149, 106, 0.1); }

/* ── Page-level privacy modal ── */
.theme-light .page-privacy-box   { background: var(--navy-card); }
.theme-light .page-privacy-title { color: var(--text); }
.theme-light .page-privacy-body  { color: var(--text-muted); }
.theme-light .page-privacy-cancel-btn text { color: var(--text-muted); }

/* ── Guest UI ── */

.guest-signup-btn {
  width: auto;
  padding: 0 28rpx;
  background: linear-gradient(135deg, #6375EC 0%, #8B9FFF 100%);
  border: none;
  box-shadow: 0 4rpx 20rpx rgba(99, 117, 236, 0.45);
}
.guest-signup-btn-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  white-space: nowrap;
}

.guest-lock-card {
  margin: 64rpx 32rpx 32rpx;
  padding: 64rpx 48rpx;
  background: rgba(15, 37, 64, 0.5);
  border: 1rpx solid rgba(99, 117, 236, 0.15);
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 28rpx;
}
.guest-lock-icon { font-size: 72rpx; }
.guest-lock-title {
  font-size: 28rpx;
  color: rgba(166, 196, 229, 0.7);
  line-height: 1.7;
  padding: 0 16rpx;
}
.guest-lock-btn {
  margin-top: 12rpx;
  background: linear-gradient(135deg, #6375EC 0%, #8B9FFF 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx 72rpx;
  border-radius: 100rpx;
  box-shadow: 0 8rpx 40rpx rgba(99, 117, 236, 0.4);
}

/* Neo-bind prompt (dots subtab, unbound state) — most users don't own a Neo
   dispenser, so this reuses .guest-lock-card's look but at a fraction of the
   size; the full-size card is reserved for actual guest/signup gates. */
.neo-bind-card {
  margin: 20rpx 32rpx 12rpx;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  gap: 12rpx;
}
.neo-bind-card .guest-lock-icon { font-size: 32rpx; }
.neo-bind-card .guest-lock-title {
  font-size: 22rpx;
  line-height: 1.5;
  padding: 0;
}
.neo-bind-card .guest-lock-btn {
  margin-top: 2rpx;
  font-size: 22rpx;
  padding: 14rpx 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(99, 117, 236, 0.35);
}

/* Avatar picker (shared between login and guest sheet) */
.avatar-pick-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.avatar-pick-btn {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  padding: 0;
  margin: 0;
  background: rgba(99, 117, 236, 0.12);
  border: 2rpx dashed rgba(99, 117, 236, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

button.avatar-pick-btn { line-height: 1; }
button.avatar-pick-btn::after { border: none; }

.avatar-pick-img {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
}

.avatar-pick-default {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-pick-icon {
  font-size: 48rpx;
  color: rgba(99, 117, 236, 0.7);
  font-weight: 300;
  line-height: 1;
}

.avatar-pick-hint {
  font-size: 22rpx;
  color: rgba(166, 196, 229, 0.4);
  letter-spacing: 1rpx;
}

.guest-sheet-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  z-index: 300;
  display: flex;
  align-items: flex-end;
}
.guest-sheet {
  width: 100%;
  background: #0F2540;
  border-top: 1rpx solid rgba(99, 117, 236, 0.2);
  border-radius: 40rpx 40rpx 0 0;
  padding: 28rpx 48rpx calc(env(safe-area-inset-bottom) + 56rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
  box-sizing: border-box;
}
.guest-sheet-handle {
  width: 80rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 4rpx;
  margin-bottom: 4rpx;
}
.guest-sheet-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #EEF2FF;
  letter-spacing: 1rpx;
  text-align: center;
}
.guest-sheet-desc {
  font-size: 26rpx;
  color: rgba(166, 196, 229, 0.6);
  text-align: center;
  line-height: 1.7;
}
.guest-sheet-error {
  font-size: 24rpx;
  color: #fca5a5;
  text-align: center;
  margin-top: -8rpx;
}
.viva-redeem-input {
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  color: #EEF2FF;
  font-size: 30rpx;
  letter-spacing: 1rpx;
}
.theme-light .viva-redeem-input {
  background: rgba(0, 0, 0, 0.04);
  border-color: rgba(0, 0, 0, 0.1);
  color: var(--text-main);
}
.guest-sheet-btn {
  width: 100%;
  padding: 36rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #6375EC 0%, #8B9FFF 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  box-shadow: 0 8rpx 40rpx rgba(99, 117, 236, 0.45);
  box-sizing: border-box;
}
.guest-sheet-btn-disabled { opacity: 0.35; box-shadow: none; }

button.guest-sheet-btn { line-height: 1.4; border: none; }
button.guest-sheet-btn::after { border: none; }

.guest-sheet-skip {
  text-align: center;
  padding: 16rpx;
  font-size: 26rpx;
  color: rgba(166, 196, 229, 0.5);
}

/* Consent checkbox rows (guest sheet phone step) */
.consent-row {
  width: 100%;
  padding: 28rpx 32rpx;
  border-radius: 24rpx;
  background: rgba(99, 117, 236, 0.07);
  border: 1rpx solid rgba(99, 117, 236, 0.2);
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  box-sizing: border-box;
  text-align: left;
}
.consent-row-done {
  background: rgba(99, 117, 236, 0.14);
  border-color: rgba(99, 117, 236, 0.45);
}
button.consent-row { line-height: 1.4; border: none; margin: 0; }
button.consent-row::after { border: none; }
.consent-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  border: 2rpx solid rgba(99, 117, 236, 0.35);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.consent-check-done {
  background: #6375EC;
  border-color: #6375EC;
}
.consent-check-icon {
  font-size: 26rpx;
  color: #fff;
  font-weight: 700;
  line-height: 1;
}
.consent-label {
  font-size: 28rpx;
  color: rgba(166, 196, 229, 0.85);
  flex: 1;
}
.consent-label-optional {
  font-size: 24rpx;
  opacity: 0.55;
}
.consent-avatar-wrap {
  position: relative;
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
}
.consent-avatar-preview {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
}
.avatar-saving-ring {
  position: absolute;
  top: -6rpx;
  left: -6rpx;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
  border-top-color: #6375EC;
  border-right-color: #6375EC;
  box-sizing: border-box;
  animation: avatar-spin 0.8s linear infinite;
}
@keyframes avatar-spin {
  to { transform: rotate(360deg); }
}

/* Pin input (used in guest sheet) */
.pin-field {
  position: relative;
  width: 100%;
}
.pin-boxes {
  display: flex;
  justify-content: center;
  gap: 16rpx;
}
.pin-box {
  width: 80rpx;
  height: 96rpx;
  border-radius: 16rpx;
  border: 2rpx solid rgba(99, 117, 236, 0.25);
  background: #162E4A;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pin-active {
  border-color: #6375EC;
  box-shadow: 0 0 0 4rpx rgba(99, 117, 236, 0.15);
}
.pin-filled { border-color: rgba(99, 117, 236, 0.5); }
.pin-digit {
  font-size: 36rpx;
  font-weight: 700;
  color: #EEF2FF;
}
.pin-capture {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  opacity: 0;
  font-size: 1rpx;
  color: transparent;
  background: transparent;
}

/* Phone bind button — reset <button> defaults to match msg-action-card */
.msg-phone-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 22rpx 32rpx;
  background: linear-gradient(135deg, rgba(99, 117, 236, 0.18), rgba(99, 117, 236, 0.08));
  border: 1rpx solid rgba(99, 117, 236, 0.45) !important;
  border-radius: 28rpx;
  border-bottom-left-radius: 6rpx;
  max-width: 72%;
  text-align: left;
  color: #A0B4FF;
  font-size: 28rpx;
  line-height: normal;
  margin: 0;
  box-sizing: border-box;
}
.msg-phone-btn::after { border: none; }

/* ════ PLANS TAB ════ */
.plans-tab { overflow: hidden; }
.plans-loading { flex: 1; display: flex; justify-content: center; align-items: center; }
.plans-scroll  { flex: 1; }

.plans-header { display: flex; justify-content: space-between; align-items: center; padding: 36rpx 32rpx 16rpx; }
.plans-title  { font-size: 34rpx; font-weight: 700; color: #EEF2FF; }
.plans-browse-btn { padding: 12rpx 24rpx; background: rgba(99,117,236,0.15); border: 1rpx solid rgba(99,117,236,0.4); border-radius: 20rpx; }
.plans-browse-btn-text { font-size: 24rpx; color: var(--info-pale); font-weight: 500; }

.plans-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 80rpx 40rpx; gap: 24rpx; }
.plans-empty-text { font-size: 26rpx; color: #6B8CAE; text-align: center; }
.plans-browse-cta { padding: 20rpx 48rpx; background: linear-gradient(90deg, #6375EC, #8B9FFF); border-radius: 48rpx; }
.plans-browse-cta-text { font-size: 28rpx; font-weight: 600; color: #fff; }

/* Plan card */
.plan-card { margin: 0 24rpx 24rpx; padding: 28rpx; background: rgba(255,255,255,0.04); border: 1rpx solid rgba(255,255,255,0.07); border-radius: 20rpx; }
.plan-card-header { display: flex; flex-direction: column; gap: 10rpx; margin-bottom: 20rpx; }
.plan-type-badge { display: inline-flex; align-self: flex-start; padding: 4rpx 18rpx; border-radius: 20rpx; }
.plan-type-primary   { background: rgba(99,117,236,0.2); }
.plan-type-secondary { background: rgba(16,185,129,0.15); }
.plan-type-text { font-size: 20rpx; font-weight: 600; }
.plan-type-primary   .plan-type-text { color: var(--info-pale); }
.plan-type-secondary .plan-type-text { color: var(--success); }
.plan-card-name { font-size: 28rpx; font-weight: 600; color: #EEF2FF; }

.plan-progress-bar-track { height: 8rpx; background: rgba(255,255,255,0.08); border-radius: 8rpx; margin-bottom: 16rpx; overflow: hidden; }
.plan-progress-bar-fill  { height: 100%; background: linear-gradient(90deg, #6375EC, #8B9FFF); border-radius: 8rpx; transition: width 0.4s; }

.plan-card-meta-row { display: flex; justify-content: space-between; margin-bottom: 20rpx; }
.plan-meta-item { font-size: 22rpx; color: #6B8CAE; }

.plan-checkin-btn { padding: 18rpx; background: linear-gradient(90deg, #6375EC, #8B9FFF); border-radius: 16rpx; text-align: center; }
.plan-checkin-btn.plan-checkin-done { background: rgba(52,211,153,0.15); border: 1rpx solid rgba(52,211,153,0.3); }
.plan-checkin-text { font-size: 26rpx; font-weight: 600; color: #fff; }
.plan-checkin-done .plan-checkin-text { color: var(--success); }

/* Plan / Browse overlay sheets */
.overlay-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.6);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.overlay-panel {
  width: 100%;
  height: 82vh;
  background: #0F2540;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.overlay-header {
  display: flex;
  align-items: center;
  padding: 32rpx 40rpx;
  border-bottom: 1rpx solid #1E3A5F;
  flex-shrink: 0;
}
.overlay-title { flex: 1; font-size: 32rpx; font-weight: 600; color: #E8F0F8; }
.overlay-close { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; }
.close-x { font-size: 32rpx; color: var(--steel); }
.overlay-scroll { flex: 1; overflow: hidden; }

/* Plan detail inner tabs */
.detail-tabs { display: flex; border-bottom: 1rpx solid #1E3A5F; background: #0A1F36; flex-shrink: 0; }
.detail-tab { flex: 1; padding: 20rpx 0; display: flex; align-items: center; justify-content: center; }
.detail-tab-text { font-size: 26rpx; color: var(--steel); font-weight: 500; }
.detail-tab-active .detail-tab-text { color: #A0B4FF; font-weight: 700; }

/* Plan detail overlay */
.plan-detail-section { padding: 24rpx 32rpx; border-bottom: 1rpx solid rgba(255,255,255,0.06); }
.plan-detail-label   { display: block; font-size: 22rpx; color: #6B8CAE; margin-bottom: 8rpx; }
.plan-detail-value   { display: block; font-size: 26rpx; color: #EEF2FF; line-height: 1.5; }

.plan-chips-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 8rpx; }
.plan-chip { padding: 6rpx 18rpx; background: rgba(99,117,236,0.15); border-radius: 20rpx; }
.plan-chip-dot { background: rgba(16,185,129,0.12); }
.plan-chip-text { font-size: 22rpx; color: var(--info-pale); }
.plan-chip-dot .plan-chip-text { color: var(--success); }

.plan-actions-row { display: flex; gap: 16rpx; padding: 24rpx 32rpx; }
.plan-action-btn { flex: 1; padding: 20rpx; border-radius: 16rpx; text-align: center; }
.plan-action-btn text { font-size: 24rpx; font-weight: 500; }
.plan-action-switch  { background: rgba(99,117,236,0.15); border: 1rpx solid rgba(99,117,236,0.3); }
.plan-action-switch  text { color: var(--info-pale); }
.plan-action-abandon { background: rgba(239,68,68,0.1); border: 1rpx solid rgba(239,68,68,0.25); }
.plan-action-abandon text { color: var(--danger-soft); }
.plan-action-buy {
  margin: 8rpx 0 0;
  padding: 20rpx;
  border-radius: 16rpx;
  text-align: center;
  background: rgba(245, 197, 106, 0.18);
  border: 2rpx solid rgba(245, 197, 106, 0.5);
}
.plan-action-buy text { font-size: 26rpx; font-weight: 600; color: var(--gold); }

/* Plan browse sheet */
.browse-tpl-card { padding: 28rpx 32rpx; border-bottom: 1rpx solid rgba(255,255,255,0.07); }
.browse-tpl-name { display: block; font-size: 28rpx; font-weight: 600; color: #EEF2FF; margin-bottom: 6rpx; }
.browse-tpl-goal { display: block; font-size: 24rpx; color: #A6C4E5; margin-bottom: 6rpx; line-height: 1.4; }
.browse-tpl-meta { display: block; font-size: 22rpx; color: #6B8CAE; margin-bottom: 20rpx; }
.browse-tpl-actions { display: flex; gap: 16rpx; align-items: center; }
.browse-enrolled-badge { padding: 10rpx 24rpx; background: rgba(99,117,236,0.15); border: 1rpx solid rgba(99,117,236,0.4); border-radius: 20rpx; font-size: 22rpx; color: var(--info-pale); }
.browse-join-disabled { opacity: 0.35; }
.browse-join-btn { flex: 1; padding: 18rpx; background: linear-gradient(90deg, #6375EC, #8B9FFF); border-radius: 16rpx; text-align: center; }
.browse-join-btn text { font-size: 24rpx; font-weight: 600; color: #fff; }
.browse-join-secondary { background: rgba(99,117,236,0.15); border: 1rpx solid rgba(99,117,236,0.35); }
.browse-join-secondary text { color: var(--info-pale); }

/* Light theme overrides */
.theme-light .overlay-panel { background: #ffffff; }
.theme-light .overlay-header { border-bottom-color: #e2e8f0; }
.theme-light .overlay-title { color: #1a2744; }
.theme-light .close-x { color: #607090; }
.theme-light .detail-tabs { background: #f0f4ff; border-bottom-color: #dde5f5; }
.theme-light .detail-tab-text { color: #607090; }
.theme-light .detail-tab-active .detail-tab-text { color: #2942E5; }
.theme-light .inner-tab-bar { background: #f0f4ff; border-bottom-color: #dde5f5; }
.theme-light .inner-tab-text { color: #607090; }
.theme-light .inner-tab-active .inner-tab-text { color: #2942E5; }
.theme-light .plans-title   { color: #1a2744; }
.theme-light .plan-card     { background: rgba(255,255,255,0.7); border-color: rgba(99,117,236,0.12); }
.theme-light .plan-card-name { color: #1a2744; }
.theme-light .plan-meta-item { color: #607090; }
.theme-light .plan-detail-value { color: #1a2744; }
.theme-light .plan-detail-label { color: #607090; }
.theme-light .browse-tpl-name   { color: #1a2744; }
.theme-light .browse-tpl-goal   { color: #4a6080; }

/* ── Plan Reminders (inside plan detail sheet) ── */
.plan-section-label { text-transform: uppercase; letter-spacing: 2rpx; }
.plan-reminder-row { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid rgba(255,255,255,0.05); }
.plan-reminder-info { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.plan-reminder-time { font-size: 28rpx; font-weight: 600; color: #E8F0F8; }
.plan-reminder-content { font-size: 22rpx; color: #A8C0D8; line-height: 1.4; }
.plan-reminder-toggle { padding: 10rpx 28rpx; border-radius: 24rpx; font-size: 22rpx; flex-shrink: 0; }
.reminder-active { background: rgba(99,117,236,0.15); border: 1rpx solid rgba(99,117,236,0.4); }
.reminder-active text { color: var(--info-pale); }
.reminder-paused { background: rgba(120,120,120,0.12); border: 1rpx solid rgba(120,120,120,0.25); }
.reminder-paused text { color: var(--steel); }
.plan-empty-hint { padding: 12rpx 0; }
.plan-empty-hint text { font-size: 24rpx; color: #4A6A8F; }

/* Light theme overrides for plan reminders */
.theme-light .plan-reminder-time { color: #1a2744; }
.theme-light .plan-reminder-content { color: #607090; }
.theme-light .plan-reminder-row { border-bottom-color: rgba(0,0,0,0.06); }

/* ── Reminders Section ── */
.reminders-section { margin: 0 24rpx 16rpx; }
.reminders-section-title {
  font-size: 26rpx; font-weight: 600; color: #6B8CAE;
  letter-spacing: 2rpx; text-transform: uppercase;
  display: block; margin-bottom: 16rpx; padding-top: 8rpx;
}
.reminder-card {
  padding: 24rpx 28rpx;
  background: rgba(255,255,255,0.03);
  border: 1rpx solid rgba(99,117,236,0.15);
  border-left: 4rpx solid rgba(99,117,236,0.5);
  border-radius: 16rpx; margin-bottom: 16rpx;
}
.reminder-card-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 16rpx; margin-bottom: 14rpx; }
.reminder-content { font-size: 26rpx; color: #EEF2FF; flex: 1; line-height: 1.5; }
.reminder-source-badge { flex-shrink: 0; padding: 4rpx 14rpx; border-radius: 20rpx; align-self: flex-start; }
.reminder-source-coach { background: rgba(52,211,153,0.12); border: 1rpx solid rgba(52,211,153,0.3); }
.reminder-source-ai    { background: rgba(99,117,236,0.12);  border: 1rpx solid rgba(99,117,236,0.3); }
.reminder-source-text  { font-size: 20rpx; font-weight: 500; }
.reminder-source-coach .reminder-source-text { color: var(--success); }
.reminder-source-ai    .reminder-source-text { color: var(--info-pale); }
.reminder-card-bottom { display: flex; align-items: center; gap: 16rpx; }
.reminder-date { font-size: 22rpx; color: #6B8CAE; }
.reminder-recur-badge { padding: 2rpx 12rpx; background: rgba(245,158,11,0.12); border: 1rpx solid rgba(245,158,11,0.3); border-radius: 12rpx; }
.reminder-recur-text  { font-size: 20rpx; color: var(--warn); }
.reminders-empty { padding: 12rpx 0 8rpx; }
.theme-light .reminder-card    { background: rgba(255,255,255,0.6); border-color: rgba(99,117,236,0.12); border-left-color: rgba(99,117,236,0.4); }
.theme-light .reminder-content { color: #1a2744; }
.theme-light .reminder-date    { color: #607090; }
.theme-light .browse-tpl-meta   { color: #607090; }

/* ── Daily Task Row ─────────────────────────────────────────────────────────── */
.plan-daily-section { margin-top: 20rpx; }
.plan-daily-tasks { display: flex; flex-direction: row; gap: 12rpx; margin-bottom: 14rpx; }
.plan-task-chip {
  flex: 1; display: flex; flex-direction: row; align-items: center;
  justify-content: space-between; padding: 12rpx 14rpx;
  border-radius: 14rpx; border: 1rpx solid rgba(255,255,255,0.10);
  background: rgba(255,255,255,0.04);
}
.plan-task-chip.plan-task-done {
  border-color: rgba(52,211,153,0.35);
  background: rgba(52,211,153,0.07);
}
.plan-task-label { font-size: 21rpx; color: rgba(255,255,255,0.6); }
.plan-task-chip.plan-task-done .plan-task-label { color: var(--success); }
.plan-task-check { font-size: 21rpx; color: rgba(255,255,255,0.25); margin-left: 6rpx; }
.plan-task-chip.plan-task-done .plan-task-check { color: var(--success); }
.plan-daily-bar-row { display: flex; align-items: center; gap: 16rpx; }
.plan-daily-bar-track { flex: 1; height: 6rpx; background: rgba(255,255,255,0.07); border-radius: 6rpx; overflow: hidden; }
.plan-daily-bar-fill { height: 100%; background: linear-gradient(90deg, #6375EC, #8B9FFF); border-radius: 6rpx; transition: width 0.3s; }
.plan-daily-bar-fill.plan-daily-complete { background: linear-gradient(90deg, #10b981, #34d399); }
.plan-daily-count { font-size: 20rpx; color: rgba(255,255,255,0.35); white-space: nowrap; }

/* ── Daily Task Modals ──────────────────────────────────────────────────────── */
.modal-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.55);
  display: flex; align-items: flex-end; justify-content: center;
  z-index: 999;
}
.modal-sheet {
  width: 100%; background: #1a1a2e;
  border-radius: 32rpx 32rpx 0 0;
  padding: 56rpx 40rpx 64rpx;
  box-sizing: border-box;
}
.modal-title { display: block; font-size: 32rpx; font-weight: 600; color: #fff; margin-bottom: 32rpx; }
.modal-input {
  display: block; width: 100%; background: rgba(255,255,255,0.06);
  border: 1rpx solid rgba(255,255,255,0.12); border-radius: 16rpx;
  padding: 0 24rpx; height: 96rpx; line-height: 96rpx;
  font-size: 30rpx; color: #fff;
  margin-bottom: 32rpx; box-sizing: border-box;
}
.modal-actions { display: flex; gap: 20rpx; margin-top: 20rpx; }
.modal-btn { flex: 1; padding: 24rpx; border-radius: 20rpx; text-align: center; font-size: 28rpx; }
.modal-btn-cancel { background: rgba(255,255,255,0.07); color: rgba(255,255,255,0.55); }
.modal-btn-confirm { background: linear-gradient(90deg, #6375EC, #8B9FFF); color: #fff; font-weight: 600; }
.q-row { margin-bottom: 28rpx; }
.q-label { display: block; font-size: 26rpx; color: rgba(255,255,255,0.65); margin-bottom: 8rpx; }

/* light theme overrides */
.theme-light .plan-task-chip { border-color: rgba(0,0,0,0.08); background: rgba(0,0,0,0.03); }
.theme-light .plan-task-chip.plan-task-done { border-color: rgba(16,185,129,0.3); background: rgba(16,185,129,0.06); }
.theme-light .plan-task-label { color: rgba(0,0,0,0.6); }
.theme-light .plan-task-chip.plan-task-done .plan-task-label { color: #036748; }
.theme-light .plan-task-check { color: #747068; }
.theme-light .plan-task-chip.plan-task-done .plan-task-check { color: #036748; }
.theme-light .plan-daily-bar-track { background: rgba(0,0,0,0.06); }
.theme-light .plan-daily-count { color: #72706C; }
.theme-light .modal-sheet { background: #f8f9ff; }
.theme-light .modal-title { color: #1a2744; }
.theme-light .modal-input { background: rgba(0,0,0,0.04); border-color: rgba(0,0,0,0.1); color: #1a2744; }
.theme-light .modal-btn-cancel { background: rgba(0,0,0,0.06); color: #656462; }
.theme-light .q-label { color: rgba(0,0,0,0.6); }

/* ── Events (线下活动) ─────────────────────────────────────────────────────── */
.events-list { padding: 16rpx 0; }
.event-card { padding: 28rpx 32rpx; border-bottom: 1rpx solid rgba(255,255,255,0.07); }
.event-card-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.event-title { font-size: 28rpx; font-weight: 600; color: #EEF2FF; flex: 1; }
.event-badge-signed { padding: 6rpx 18rpx; background: rgba(52,211,153,0.15); border: 1rpx solid rgba(52,211,153,0.4); border-radius: 20rpx; }
.event-badge-signed text { font-size: 20rpx; color: var(--success); }
.event-meta { display: block; font-size: 24rpx; color: #A6C4E5; margin-bottom: 6rpx; }
.event-desc { display: block; font-size: 24rpx; color: #7A96B8; margin-bottom: 8rpx; line-height: 1.5; }
.event-card-actions { margin-top: 20rpx; }
.event-btn { padding: 16rpx 0; border-radius: 16rpx; text-align: center; }
.event-btn text { font-size: 24rpx; font-weight: 600; }
.event-btn-signup { background: linear-gradient(90deg, #6375EC, #8B9FFF); }
.event-btn-signup text { color: #fff; }
.event-btn-cancel { background: rgba(99,117,236,0.15); border: 1rpx solid rgba(99,117,236,0.35); }
.event-btn-cancel text { color: var(--info-pale); }
.event-btn-disabled { background: rgba(255,255,255,0.06); }
.event-btn-disabled text { color: rgba(255,255,255,0.3); }
.theme-light .event-card { border-bottom-color: #e2e8f0; }
.theme-light .event-title { color: #1a2744; }
.theme-light .event-meta { color: #607090; }
.theme-light .event-desc { color: #495A77; }
.theme-light .event-btn-disabled { background: rgba(0,0,0,0.06); }
.theme-light .event-btn-disabled text { color: #736F69; }

