@import "../referral/referral.wxss";

.emails-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #0B1C2E;
  color: #E8F0F8;
  overflow: hidden;
}

.emails-page.theme-light {
  background: #F4F6FA;
  color: #1A2B3C;
}

.emails-content {
  flex: 1;
  overflow-y: auto;
  padding: 32rpx 28rpx;
  box-sizing: border-box;
}

.email-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(var(--blue-rgb), 0.1);
}

.email-row:last-child { border-bottom: none; }

.email-row-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.email-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #E8F0F8;
}

.theme-light .email-value { color: #1A2B3C; }

.email-badge {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 600;
  background: rgba(var(--blue-rgb), 0.2);
  color: var(--blue);
}

/* An admin-added address nobody has proved yet (user_emails.verified_at IS NULL). */
.email-badge-muted {
  background: rgba(166, 196, 229, 0.12);
  color: rgba(166, 196, 229, 0.7);
}

/* An address can be long; let it wrap rather than push the actions off-screen. */
.email-value {
  word-break: break-all;
}

.email-row-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex-shrink: 0;
}

.email-action {
  font-size: 24rpx;
  color: var(--blue);
}

.email-action-danger {
  color: #E87070;
}

.theme-light .email-action-danger { color: #DC2626; }

.add-email-btn {
  margin-top: 24rpx;
  width: 100%;
}

.email-step-desc {
  font-size: 24rpx;
  color: rgba(232, 240, 248, 0.55);
  display: block;
  margin: 12rpx 0 20rpx;
}

.theme-light .email-step-desc { color: #5E656B; }

.emails-links {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.emails-link {
  font-size: 24rpx;
  color: var(--blue);
}

/* ════════════════════════════════════════════════════════
   Light theme — muted-text contrast fixes (generated)
   The base rules above use low-alpha rgba() tuned for a bright color on dark
   navy. On the cream light surface that same alpha washes out to 1.4-2.1:1,
   and no alpha <= 0.6 can reach 4.5:1 on cream regardless of base color — so
   light theme needs opaque values. Ramp preserves the faint->strong hierarchy.
   ════════════════════════════════════════════════════════ */
.theme-light .email-badge { color: #5D4C32; }
.theme-light .email-action { color: #5D4C32; }
.theme-light .emails-link { color: #5D4C32; }
