@import "../appview/appview.wxss";

.payqr-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #0B1C2E;
  color: #E8F0F8;
  overflow: hidden;
}

.payqr-page.theme-light {
  background: #F4F6FA;
  color: #1A2B3C;
}

.payqr-page .back-icon {
  font-size: 52rpx;
  line-height: 1;
  margin-top: -6rpx;
}

.payqr-content {
  flex: 1;
  padding: 32rpx 28rpx 60rpx;
  box-sizing: border-box;
}

.payqr-card {
  background: rgba(var(--blue-rgb), 0.08);
  border: 1rpx solid rgba(var(--blue-rgb), 0.18);
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.theme-light .payqr-card {
  background: #FFFFFF;
  border-color: rgba(var(--blue-rgb), 0.15);
}

.payqr-method {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  color: var(--blue);
}

.payqr-image-wrap {
  width: 480rpx;
  height: 480rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

.payqr-image {
  width: 100%;
  height: 100%;
}

.payqr-error {
  padding: 60rpx 20rpx;
  font-size: 26rpx;
  color: var(--danger-soft);
  text-align: center;
}

.payqr-meta {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-top: 24rpx;
}

.payqr-meta-label {
  font-size: 24rpx;
  color: var(--text-muted);
}

.theme-light .payqr-meta-label { color: rgba(26, 43, 60, 0.5); }

.payqr-amount {
  font-size: 40rpx;
  font-weight: 700;
}

.payqr-payee {
  font-size: 28rpx;
  font-weight: 600;
}

.payqr-hint {
  margin-top: 28rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-sub);
  text-align: center;
}

.theme-light .payqr-hint { color: rgba(26, 43, 60, 0.65); }

.payqr-actions {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.payqr-btn {
  width: 100%;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 22rpx 0;
  line-height: 1.4;
}

.payqr-btn::after { border: none; }

.payqr-btn.primary {
  background: var(--blue);
  color: #FFFFFF;
}

.payqr-btn.secondary {
  background: rgba(var(--blue-rgb), 0.12);
  color: var(--blue);
}

.payqr-btn[disabled] { opacity: 0.6; }

.payqr-after {
  margin-top: 32rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--text-muted);
  text-align: center;
}

.theme-light .payqr-after { color: rgba(26, 43, 60, 0.5); }
