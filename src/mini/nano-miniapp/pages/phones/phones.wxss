@import "../referral/referral.wxss";

.phones-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #0B1C2E;
  color: #E8F0F8;
  overflow: hidden;
}

.phones-page.theme-light {
  background: #F4F6FA;
  color: #1A2B3C;
}

.phones-content {
  flex: 1;
  overflow-y: auto;
  padding: 32rpx 28rpx;
  box-sizing: border-box;
}

.phone-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(var(--blue-rgb), 0.1);
}

.phone-row:last-child { border-bottom: none; }

.phone-row-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.phone-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #E8F0F8;
}

.theme-light .phone-value { color: #1A2B3C; }

.phone-badge {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 600;
  background: rgba(var(--blue-rgb), 0.2);
  color: var(--blue);
}

.phone-row-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex-shrink: 0;
}

.phone-action {
  font-size: 24rpx;
  color: var(--blue);
}

.phone-action-danger {
  color: #E87070;
}

.theme-light .phone-action-danger { color: #DC2626; }

.add-phone-btn {
  margin-top: 24rpx;
  width: 100%;
}

.phone-step-desc {
  font-size: 24rpx;
  color: rgba(232, 240, 248, 0.55);
  display: block;
  margin: 12rpx 0 20rpx;
}

.theme-light .phone-step-desc { color: rgba(26, 43, 60, 0.55); }

.phones-links {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.phones-link {
  font-size: 24rpx;
  color: var(--blue);
}
