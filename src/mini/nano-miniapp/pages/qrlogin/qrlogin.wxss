.page {
  min-height: 100vh;
  background: #0B1C2E;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}
.card {
  background: #132236;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  width: 100%;
  max-width: 600rpx;
  text-align: center;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.4);
}
.card--success { border: 2rpx solid #22c55e; }
.card--error   { border: 2rpx solid #ef4444; }
.logo-wrap { margin-bottom: 32rpx; }
.logo { width: 80rpx; height: 80rpx; }
.title { font-size: 36rpx; font-weight: 700; color: #e2e8f0; margin-bottom: 12rpx; }
.subtitle { font-size: 26rpx; color: #94a3b8; margin-bottom: 40rpx; line-height: 1.6; }
.user-info {
  display: flex; flex-direction: column; align-items: center;
  margin: 30rpx 0 40rpx; gap: 16rpx;
}
.avatar {
  width: 120rpx; height: 120rpx;
  border-radius: 50%; border: 3rpx solid #3a5a7a;
}
.uname { font-size: 32rpx; color: #cbd5e1; font-weight: 600; }
.loading-row {
  display: flex; flex-direction: column; align-items: center;
  gap: 20rpx; color: #94a3b8; font-size: 28rpx; margin: 20rpx 0;
}
.dot-pulse { display: flex; gap: 10rpx; }
.dot-pulse view {
  width: 14rpx; height: 14rpx; border-radius: 50%;
  background: #4f8ef7; animation: pulse 1s ease-in-out infinite;
}
.dot-pulse view:nth-child(2) { animation-delay: 0.2s; }
.dot-pulse view:nth-child(3) { animation-delay: 0.4s; }
@keyframes pulse { 0%,100% { opacity: 0.3; } 50% { opacity: 1; } }
.actions { display: flex; flex-direction: column; gap: 24rpx; margin-top: 20rpx; }
.btn-confirm {
  background: #4f8ef7; color: #fff; border-radius: 50rpx;
  font-size: 32rpx; font-weight: 600; padding: 26rpx 0;
  border: none; width: 100%;
}
.btn-cancel {
  background: transparent; color: #64748b; border: 2rpx solid #2a3e55;
  border-radius: 50rpx; font-size: 30rpx; padding: 24rpx 0; width: 100%;
}
.success-icon { font-size: 80rpx; color: #22c55e; margin-bottom: 20rpx; }
.error-icon   { font-size: 80rpx; color: #ef4444; margin-bottom: 20rpx; }
