<view class="login-screen">
  <view class="login-glow" />

  <view class="login-brand">
    <image class="login-logo-img" src="{{channel.logo_url || '/assets/waven-logo-icon.png'}}" mode="aspectFit" />
    <text class="login-title">{{channel.name || 'NANO'}}</text>
    <text class="login-subtitle">您的精准健康伴侣</text>
    <text wx:if="{{version}}" class="login-version">v{{version}}</text>
  </view>

  <!-- Checking / auto-login -->
  <view wx:if="{{step === 'checking'}}" class="status-wrap">
    <view class="spinner" />
    <text class="status-text">正在登录…</text>
  </view>

  <view wx:elif="{{step === 'code'}}" class="login-card">
    <text class="login-card-label">输入邀请码</text>
    <text class="login-card-hint">请输入好友分享的6位邀请码</text>
    <input class="code-input" value="{{codeInput}}" bindinput="onCodeInput"
      placeholder="6位邀请码" maxlength="6" type="number" />
    <view class="login-btn {{codeLoading ? 'disabled' : ''}}" bindtap="submitCode">
      <text>{{codeLoading ? '验证中…' : '确认加入'}}</text>
    </view>
  </view>

  <view wx:elif="{{step === 'error'}}" class="status-wrap">
    <text class="error-text">{{error}}</text>
    <view class="retry-btn" bindtap="retry">
      <text>重试</text>
    </view>
  </view>

  <view wx:elif="{{step === 'loggedOut'}}" class="login-card">
    <text class="login-card-label">欢迎回来</text>
    <view class="login-btn" bindtap="continueAsPrevious">
      <text>{{maskedPhone ? ('继续使用 ' + maskedPhone) : '继续使用当前账号'}}</text>
    </view>
    <view class="login-link" bindtap="useOtherNumber">
      <text>使用其他手机号登录</text>
    </view>
  </view>

  <view wx:elif="{{step === 'phoneEntry'}}" class="login-card">
    <block wx:if="{{phoneStep === 'phone'}}">
      <text class="login-card-label">手机号登录</text>
      <view class="phone-input-row">
        <picker mode="selector" range="{{countryOptions}}" range-key="label" value="{{countryIndex}}" bindchange="onCountryChange">
          <view class="country-code-select">
            <text>{{countryOptions[countryIndex].code}}</text>
            <text class="country-code-arrow">▾</text>
          </view>
        </picker>
        <input class="login-input phone-input" value="{{phone}}" bindinput="onPhoneInput"
          placeholder="请输入手机号" placeholder-style="line-height: 96rpx; color: rgba(166, 196, 229, 0.4);"
          maxlength="{{countryOptions[countryIndex].otpSupported ? 11 : 15}}" type="number" />
      </view>
      <text wx:if="{{!countryOptions[countryIndex].otpSupported}}" class="login-card-hint">暂不支持该国家/地区的手机号登录</text>
      <text wx:if="{{phoneError}}" class="error-text">{{phoneError}}</text>
      <view wx:if="{{countryOptions[countryIndex].otpSupported}}" class="login-btn {{phoneLoading ? 'disabled' : ''}}" bindtap="sendLoginCode">
        <text>{{phoneLoading ? '发送中…' : '获取验证码'}}</text>
      </view>
    </block>
    <block wx:else>
      <text class="login-card-label">输入验证码</text>
      <text class="login-card-hint">验证码已发送至 {{phone}}</text>
      <input class="code-input" value="{{code}}" bindinput="onLoginCodeInput"
        placeholder="6位验证码" maxlength="6" type="number" />
      <text wx:if="{{phoneError}}" class="error-text">{{phoneError}}</text>
      <view class="login-btn {{resendCooldown > 0 ? 'disabled' : ''}}" bindtap="sendLoginCode">
        <text>{{resendCooldown > 0 ? '重新发送(' + resendCooldown + 's)' : '重新发送'}}</text>
      </view>
    </block>
    <view class="login-link" bindtap="backToLoggedOut">
      <text>返回</text>
    </view>
  </view>

  <view class="login-footer">
    <text>哈佛大学创新实验室</text>
    <text class="login-footer-dot">·</text>
    <text>成员企业</text>
  </view>
</view>
