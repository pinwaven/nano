.address-page {
  min-height: 100vh;
  background: #0B1C2E;
  color: #EEF2FF;
  display: flex;
  flex-direction: column;
}
.status-bar { flex-shrink: 0; }
.address-nav {
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  border-bottom: 1rpx solid rgba(99, 117, 236, 0.12);
}
.nav-back, .nav-spacer {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-back {
  font-size: 56rpx;
  color: rgba(166, 196, 229, 0.8);
}
.nav-title {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
}
.address-scroll {
  flex: 1;
  height: 0;
}
.address-list {
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.empty-card, .address-card {
  background: #0F2540;
  border: 1rpx solid rgba(99, 117, 236, 0.18);
  border-radius: 24rpx;
  padding: 28rpx;
}
.empty-card {
  color: rgba(166, 196, 229, 0.55);
  text-align: center;
}
.address-card-default {
  border-color: rgba(99, 117, 236, 0.55);
}
.address-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 14rpx;
}
.address-name {
  font-size: 30rpx;
  font-weight: 700;
}
.address-phone {
  font-size: 26rpx;
  color: rgba(166, 196, 229, 0.65);
}
.address-default {
  margin-left: auto;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(99, 117, 236, 0.18);
  color: #A6C4E5;
  font-size: 20rpx;
  font-weight: 700;
}
.address-line {
  display: block;
  color: rgba(238, 242, 255, 0.78);
  font-size: 25rpx;
  line-height: 1.5;
}
.address-actions {
  display: flex;
  gap: 28rpx;
  margin-top: 22rpx;
}
.address-action {
  font-size: 24rpx;
  color: #8B9FFF;
}
.address-action.danger {
  color: #f87171;
}
.address-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx 48rpx;
  background: linear-gradient(180deg, rgba(11,28,46,0), #0B1C2E 28%);
}
.primary-btn, .secondary-btn {
  min-height: 88rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}
.primary-btn {
  background: linear-gradient(135deg, #6375EC, #8B9FFF);
  color: #fff;
  box-shadow: 0 8rpx 28rpx rgba(99,117,236,0.32);
}
.secondary-btn {
  background: rgba(255,255,255,0.07);
  color: rgba(238,242,255,0.7);
}
.btn-disabled { opacity: 0.55; }
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.58);
  display: flex;
  align-items: flex-end;
  z-index: 20;
}
.form-sheet {
  width: 100%;
  background: #101F35;
  border-radius: 32rpx 32rpx 0 0;
  padding: 44rpx 36rpx 56rpx;
  box-sizing: border-box;
}
.form-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  margin-bottom: 28rpx;
}
.form-input, .form-picker {
  width: 100%;
  min-height: 88rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  border: 1rpx solid rgba(99,117,236,0.18);
  background: rgba(255,255,255,0.05);
  color: #EEF2FF;
  font-size: 28rpx;
  padding: 0 24rpx;
  margin-bottom: 18rpx;
}
.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: rgba(238,242,255,0.82);
}
.default-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: rgba(238,242,255,0.76);
  font-size: 26rpx;
  padding: 8rpx 0 24rpx;
}
.check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 10rpx;
  border: 1rpx solid rgba(99,117,236,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
}
.check-on {
  background: #6375EC;
  border-color: #6375EC;
}
.form-actions {
  display: flex;
  gap: 18rpx;
}
.form-actions .secondary-btn,
.form-actions .primary-btn {
  flex: 1;
}
.theme-light {
  background: #f5f7fb;
  color: #1a2744;
}
.theme-light .address-nav { border-bottom-color: rgba(0,0,0,0.08); }
.theme-light .empty-card,
.theme-light .address-card,
.theme-light .form-sheet {
  background: #fff;
  border-color: rgba(99,117,236,0.14);
}
.theme-light .address-line,
.theme-light .form-title { color: #1a2744; }
.theme-light .form-input,
.theme-light .form-picker {
  background: rgba(0,0,0,0.04);
  color: #1a2744;
}
