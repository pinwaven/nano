<view class="login-screen">
  <view class="login-glow" />

  <view class="login-brand">
    <text class="login-title">验证手机号</text>
    <text class="login-subtitle">为保障账号安全，请验证您的手机号</text>
  </view>

  <view wx:if="{{step === 'phone'}}" class="login-card">
    <text class="login-card-label">手机号</text>
    <input class="login-input" value="{{phone}}" bindinput="onPhoneInput"
      placeholder="请输入手机号" maxlength="11" type="number" />

    <button
      class="login-btn"
      open-type="getPhoneNumber"
      bindgetphonenumber="handleGetPhone"
      disabled="{{loading}}"
    ><text>📱 使用微信手机号</text></button>

    <text wx:if="{{error}}" class="error-text">{{error}}</text>

    <view class="login-btn {{loading ? 'disabled' : ''}}" bindtap="sendCode">
      <text>{{loading ? '发送中…' : '发送验证码'}}</text>
    </view>
  </view>

  <view wx:elif="{{step === 'code'}}" class="login-card">
    <text class="login-card-label">输入验证码</text>
    <text class="phone-step-desc">验证码已发送至 {{phone}}</text>
    <input class="login-input" value="{{code}}" bindinput="onCodeInput"
      placeholder="6位验证码" maxlength="6" type="number" />

    <text wx:if="{{error}}" class="error-text">{{error}}</text>

    <view class="login-btn {{loading ? 'disabled' : ''}}" bindtap="verifyCode">
      <text>{{loading ? '验证中…' : '验证'}}</text>
    </view>

    <view class="verify-phone-links">
      <text wx:if="{{resendCooldown > 0}}" class="verify-phone-link-dim">{{resendCooldown}}秒后可重新发送</text>
      <text wx:else class="verify-phone-link" bindtap="sendCode">重新发送验证码</text>
      <text class="login-footer-dot">·</text>
      <text class="verify-phone-link" bindtap="changeNumber">更换手机号</text>
    </view>
  </view>

  <view class="login-footer">
    <text>哈佛大学创新实验室</text>
    <text class="login-footer-dot">·</text>
    <text>成员企业</text>
  </view>
</view>
