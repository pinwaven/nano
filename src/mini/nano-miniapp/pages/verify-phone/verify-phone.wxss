@import "../login/login.wxss";

.verify-phone-links {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 24rpx;
}

.verify-phone-link {
  color: #6375EC;
}

.verify-phone-link-dim {
  color: rgba(166, 196, 229, 0.4);
}

.phone-input-row {
  display: flex;
  gap: 16rpx;
  align-items: stretch;
}

.country-code-select {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 96rpx;
  padding: 0 20rpx;
  border-radius: 26rpx;
  border: 1rpx solid rgba(99, 117, 236, 0.28);
  background: #162E4A;
  color: #EEF2FF;
  font-size: 32rpx;
  font-weight: 600;
}

.country-code-arrow {
  font-size: 20rpx;
  color: rgba(166, 196, 229, 0.5);
}

.phone-input {
  flex: 1;
  width: auto;
}

/* Secondary CTA — recedes visually behind the primary "发送验证码" action once
   a phone number is entered; still the only visible action beforehand. */
.login-btn-secondary {
  width: 100%;
  padding: 22rpx;
  border-radius: 22rpx;
  background: rgba(99, 117, 236, 0.12);
  border: 1rpx solid rgba(99, 117, 236, 0.28);
  color: #A6C4E5;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

button.login-btn-secondary { line-height: 1.4; }
button.login-btn-secondary::after { border: none; }
