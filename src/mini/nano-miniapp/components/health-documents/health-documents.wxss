/* Ported from viva-ag-panel.wxss's document block, .ag-* renamed .hd-*.
 *
 * The section chrome needs no host variant: .ag-section and .health-section are byte-identical
 * (same padding, same bottom rule), and .ag-section-title differs from user-health's
 * .section-title only by 24 vs 28rpx of bottom margin. So one set of rules reads as native in
 * both hosts.
 *
 * --fs-*, --blue-rgb, --wave-rgb, --wave and --steel are declared in app.wxss and inherit
 * through the component boundary, so text scaling and theming need no plumbing here. The
 * .theme-light class does NOT inherit — component style isolation blocks the host's selector —
 * which is why this file carries its own root theme hook.
 */
.hd-root { display: block; }

.hd-section {
  padding: 32rpx 36rpx;
  border-bottom: 1rpx solid rgba(var(--blue-rgb), 0.08);
}

.hd-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.hd-section-title {
  font-size: var(--fs-20, 20rpx);
  font-weight: 700;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: rgba(var(--wave-rgb), 0.4);
}

.hd-section-count {
  font-size: var(--fs-22, 22rpx);
  color: rgba(var(--wave-rgb), 0.4);
}

.hd-muted {
  font-size: var(--fs-24, 24rpx);
  color: rgba(var(--wave-rgb), 0.45);
  padding: 12rpx 0;
}

.hd-upload-btn {
  padding: 22rpx 0;
  border-radius: 14rpx;
  border: 1rpx dashed rgba(var(--blue-rgb), 0.35);
  text-align: center;
  font-size: var(--fs-25, 25rpx);
  color: #A0B4FF;
  margin-bottom: 22rpx;
}

/* The button keeps its own margin when idle; while busy the bar below carries it, so the two
 * sit as one unit rather than 22rpx apart. */
.hd-btn-busy { opacity: 0.55; margin-bottom: 10rpx; }

/* INDETERMINATE on purpose, and not for lack of trying: wx.request exposes no upload progress
 * events, and wx.uploadFile — the only Mini Program API that does — sends multipart/form-data,
 * which breaks the OSS presigned PUT's signature (it signs the raw body plus Content-Type). A
 * true percentage needs an OSS POST-policy upload and a different presign shape server-side.
 * Until then: motion says "still working" without claiming a number nothing can measure. */
.hd-progress {
  height: 4rpx;
  border-radius: 4rpx;
  background: rgba(var(--blue-rgb), 0.12);
  overflow: hidden;
  margin-bottom: 22rpx;
}

.hd-progress-bar {
  width: 40%;
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, rgba(var(--blue-rgb), 0.15), #A0B4FF, rgba(var(--blue-rgb), 0.15));
  animation: hd-indeterminate 1.15s ease-in-out infinite;
}

/* translateX is a share of the BAR's own width, so -100% parks it fully off the left edge and
 * 250% (2.5 x 40% = 100% of the track) carries it fully off the right. */
@keyframes hd-indeterminate {
  0%   { transform: translateX(-100%); }
  100% { transform: translateX(250%); }
}

.hd-empty { padding: 20rpx 4rpx; }

.hd-empty-title {
  display: block;
  font-size: var(--fs-25, 25rpx);
  color: var(--steel);
  margin-bottom: 10rpx;
}

.hd-empty-hint {
  display: block;
  font-size: var(--fs-22, 22rpx);
  line-height: 1.6;
  color: rgba(var(--wave-rgb), 0.45);
}

/* The wrapper owns the row separator, because a document now spans two rows: the file itself and
 * an optional actions strip. Putting the border on .hd-doc would draw a line between them. */
.hd-doc-wrap {
  border-bottom: 1rpx solid rgba(var(--blue-rgb), 0.06);
}

.hd-doc-wrap:last-child { border-bottom: none; }

.hd-doc {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

/* What the extraction found, in one line. */
.hd-doc-ext {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-22, 22rpx);
  color: #7FBF9F;
}

.hd-doc-ext-busy { color: rgba(var(--wave-rgb), 0.45); }

.hd-doc-summary {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-22, 22rpx);
  line-height: 1.55;
  color: rgba(var(--wave-rgb), 0.5);
}

.hd-doc-actions {
  display: flex;
  gap: 28rpx;
  padding: 0 0 18rpx;
}

.hd-doc-action {
  font-size: var(--fs-22, 22rpx);
  color: #A0B4FF;
}

.hd-doc-action-warn { color: #E05C5C; }

.hd-doc-main { flex: 1; min-width: 0; }

.hd-doc-name {
  display: block;
  font-size: var(--fs-26, 26rpx);
  color: var(--wave, #A6C4E5);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hd-doc-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.hd-doc-badge {
  font-size: var(--fs-20, 20rpx);
  padding: 3rpx 12rpx;
  border-radius: 6rpx;
  background: rgba(var(--blue-rgb), 0.14);
  color: #A0B4FF;
}

.hd-doc-sub {
  font-size: var(--fs-21, 21rpx);
  color: rgba(var(--wave-rgb), 0.4);
}

.hd-doc-del {
  font-size: var(--fs-23, 23rpx);
  color: #E05C5C;
  padding: 10rpx 0 10rpx 24rpx;
}

/* Matches user-health's .fact-footnote, the same "what this data is for" note one section up. */
.hd-footnote {
  display: block;
  margin-top: 16rpx;
  font-size: var(--fs-20, 20rpx);
  line-height: 1.6;
  color: rgba(var(--wave-rgb), 0.35);
}

/* The owner's type control. Same chrome as the badge, plus the affordance the chevron gives. */
.hd-doc-badge-tap { padding-right: 10rpx; }

/* Missing-date fix strip: hint plus the picker's tap target. */
.hd-doc-fix {
  padding: 0 0 14rpx;
}

.hd-doc-fix-hint {
  display: block;
  font-size: var(--fs-21, 21rpx);
  line-height: 1.55;
  color: #E0A05C;
  margin-bottom: 8rpx;
}

/* The structured block: a key/value tree indented by depth. Generic by design. */
.hd-struct {
  margin: 0 0 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: rgba(var(--blue-rgb), 0.06);
}

.hd-struct-row {
  display: flex;
  gap: 16rpx;
  padding: 4rpx 0;
  font-size: var(--fs-22, 22rpx);
  line-height: 1.5;
}

.hd-struct-head { margin-top: 6rpx; }
.hd-struct-head .hd-struct-key {
  color: rgba(var(--wave-rgb), 0.75);
  font-weight: 600;
}

.hd-struct-key {
  flex: 0 1 44%;
  min-width: 0;
  color: rgba(var(--wave-rgb), 0.5);
  word-break: break-all;
}

.hd-struct-val {
  flex: 1;
  min-width: 0;
  color: var(--wave, #A6C4E5);
  word-break: break-all;
}

/* ── Light theme ── */

.theme-light .hd-doc-badge,
.theme-light .hd-upload-btn { color: #2942E5; }
.theme-light .hd-progress { background: rgba(41, 66, 229, 0.10); }
.theme-light .hd-progress-bar {
  background: linear-gradient(90deg, rgba(41, 66, 229, 0.12), #2942E5, rgba(41, 66, 229, 0.12));
}
.theme-light .hd-empty-title { color: #607090; }
.theme-light .hd-doc-name { color: #14243D; }
.theme-light .hd-doc-ext { color: #2E8B57; }
.theme-light .hd-doc-summary { color: #607090; }
.theme-light .hd-doc-action { color: #2942E5; }
/* Version-2 tables: a real grid, horizontally scrollable when a 体检 table is wider than the phone. */
.hd-table-wrap { width: 100%; margin: 6rpx 0 10rpx; }
.hd-table { display: inline-block; min-width: 100%; }
.hd-table-row { display: flex; }
.hd-table-header .hd-table-cell {
  color: rgba(var(--wave-rgb), 0.75);
  font-weight: 600;
  border-bottom: 1rpx solid rgba(var(--wave-rgb), 0.18);
}
.hd-table-cell {
  flex: 0 0 auto;
  min-width: 120rpx;
  max-width: 320rpx;
  padding: 4rpx 12rpx 4rpx 0;
  font-size: var(--fs-22, 22rpx);
  line-height: 1.5;
  color: var(--wave, #A6C4E5);
  word-break: break-all;
}

/* Tags: what the document states about the person. A fact is solid, a descriptor is outlined. */
.hd-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin: 0 0 14rpx; }
.hd-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: var(--fs-20, 20rpx);
  line-height: 1.4;
  border: 1rpx solid rgba(var(--wave-rgb), 0.25);
  color: var(--wave, #A6C4E5);
}
.hd-tag-fact { background: rgba(var(--blue-rgb), 0.16); border-color: rgba(var(--blue-rgb), 0.35); }
.hd-tag-desc { background: transparent; color: rgba(var(--wave-rgb), 0.65); }
.hd-tag-inactive { opacity: 0.55; text-decoration: line-through; }
.hd-tag-cat { color: rgba(var(--wave-rgb), 0.5); }
.hd-tag-label { font-weight: 600; }
.hd-tag-status { color: rgba(var(--wave-rgb), 0.5); }

.theme-light .hd-struct { background: rgba(41, 66, 229, 0.05); }
.theme-light .hd-table-cell { color: #14243D; }
.theme-light .hd-table-header .hd-table-cell { color: #14243D; border-bottom-color: rgba(20, 36, 61, 0.15); }
.theme-light .hd-tag { color: #14243D; border-color: rgba(20, 36, 61, 0.2); }
.theme-light .hd-tag-fact { background: rgba(41, 66, 229, 0.1); border-color: rgba(41, 66, 229, 0.3); }
.theme-light .hd-tag-desc { color: #607090; }
.theme-light .hd-tag-cat, .theme-light .hd-tag-status { color: #607090; }
.theme-light .hd-struct-key { color: #607090; }
.theme-light .hd-struct-head .hd-struct-key { color: #14243D; }
.theme-light .hd-struct-val { color: #14243D; }
.theme-light .hd-doc-fix-hint { color: #B8741E; }
