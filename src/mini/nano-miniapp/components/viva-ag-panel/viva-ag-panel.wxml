<view class="ag-root {{theme === 'light' ? 'theme-light' : ''}}">
  <scroll-view class="ag-scroll" scroll-y="true">

    <!-- Entitlement header -->
    <view class="ag-hero">
      <view class="ag-hero-badge"><text>VIVA AG</text></view>
      <text class="ag-hero-desc">{{t.heroDesc}}</text>
      <text wx:if="{{expiryDisplay}}" class="ag-hero-expiry">{{t.validUntil}} {{expiryDisplay}}</text>
    </view>

    <!-- ── Needs your input ──
         The agent parked its job to ask a clarifying question. Placed above everything else
         because nothing on this panel will move until the user answers. The form itself lives
         in the chat tab (the existing questionnaire renderer); this only hands off to it. -->
    <view wx:if="{{awaitingJob}}" class="ag-section">
      <view class="ag-ask">
        <text class="ag-ask-title">{{t.askTitle}}</text>
        <text class="ag-ask-body">{{t.askBody}}</text>
        <text wx:if="{{awaitingJob.deadlineText}}" class="ag-ask-deadline">{{awaitingJob.deadlineText}}</text>
        <view class="ag-ask-cta" bindtap="goAnswer">{{t.askCta}}</view>
      </view>
    </view>

    <!-- ── Documents ── the same component the 数字孪生 subtab hosts, so the two surfaces
         can never drift apart against one backend. -->
    <health-documents user-id="{{userId}}" lang="{{lang}}" theme="{{theme}}" />

    <!-- ── Formulation progress ──
         A dots_formulation result keeps moving after the job says "completed": expert review,
         compounding, delivery, then the box scan that actually starts the plan. Without this the
         panel would go quiet for days. -->
    <view wx:if="{{formulation}}" class="ag-section">
      <text class="ag-section-title">{{t.fmTitle}}</text>
      <view class="ag-fm ag-fm-{{formulation.status}}">
        <view class="ag-fm-head">
          <text class="ag-fm-status">{{formulation.statusLabel}}</text>
          <text wx:if="{{formulation.total_dots}}" class="ag-fm-dots">{{formulation.total_dots}}</text>
        </view>
        <text class="ag-fm-hint">{{formulation.statusHint}}</text>
        <text wx:if="{{formulation.rationale}}" class="ag-fm-rationale">{{formulation.rationale}}</text>
      </view>
    </view>

    <!-- ── Command ── -->
    <view class="ag-section">
      <text class="ag-section-title">{{t.newAnalysis}}</text>

      <view class="ag-chips">
        <view wx:for="{{presets}}" wx:key="key"
              class="ag-chip {{commandKey === item.key ? 'ag-chip-on' : ''}}"
              bindtap="selectPreset" data-key="{{item.key}}">
          <text>{{item.label}}</text>
        </view>
      </view>

      <textarea class="ag-input" value="{{commandText}}" bindinput="onCommandInput"
                placeholder="{{t.commandPlaceholder}}" placeholder-class="ag-input-ph"
                maxlength="2000" auto-height show-confirm-bar="{{false}}"
                adjust-position="{{true}}" />

      <view class="ag-submit {{canSubmit ? '' : 'ag-submit-off'}}" bindtap="submitJob">
        <text>{{submitting ? t.submitting : t.submit}}</text>
      </view>
      <text wx:if="{{hasActive}}" class="ag-note">{{t.oneAtATime}}</text>
      <text wx:elif="{{dailyLimitReached}}" class="ag-note">{{t.quotaUsedUp}}</text>
      <text wx:elif="{{!commandKey && !commandText}}" class="ag-note">{{t.pickSomething}}</text>
      <text wx:else class="ag-note">{{quotaLeftText}}</text>
    </view>

    <!-- ── Jobs ── -->
    <view class="ag-section">
      <text class="ag-section-title">{{t.history}}</text>

      <view wx:if="{{jobsLoading}}" class="ag-muted">{{t.loading}}</view>
      <view wx:elif="{{jobs.length === 0}}" class="ag-muted">{{t.noJobs}}</view>

      <view wx:else>
        <view wx:for="{{jobs}}" wx:key="job_uid" class="ag-job" bindtap="openJob" data-uid="{{item.job_uid}}">
          <view class="ag-job-head">
            <text class="ag-pill ag-pill-{{item.status}}">{{item.statusLabel}}</text>
            <text class="ag-job-date">{{item.created_at}}</text>
          </view>
          <text class="ag-job-cmd">{{item.command}}</text>
          <text wx:if="{{item.progress_note}}" class="ag-job-note">{{item.progress_note}}</text>
          <text wx:elif="{{item.result_summary}}" class="ag-job-note">{{item.summaryPreview}}</text>

          <view wx:if="{{item.files.length}}" class="ag-file-chips">
            <!-- Report artifacts the external agent attached. Surfaced on the card itself, not
                 only inside the detail sheet, so a finished report is one tap away. -->
            <view wx:for="{{item.files}}" wx:for-item="f" wx:key="index" class="ag-file-chip"
                  catchtap="openResultFile" data-uid="{{item.job_uid}}" data-index="{{f.index}}">
              <text class="ag-file-ext">{{f.extLabel}}</text>
              <text class="ag-file-name">{{f.filename}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view style="height: 200rpx;"></view>
  </scroll-view>

  <!-- Job detail sheet -->
  <view wx:if="{{detailJob}}" class="ag-sheet-mask" bindtap="closeJob">
    <view class="ag-sheet" catchtap="noop">
      <view class="ag-sheet-head">
        <text class="ag-pill ag-pill-{{detailJob.status}}">{{detailJob.statusLabel}}</text>
        <text class="ag-sheet-close" bindtap="closeJob">✕</text>
      </view>
      <text class="ag-sheet-date">{{detailJob.created_at}}</text>
      <text class="ag-sheet-cmd">{{detailJob.command}}</text>

      <text wx:if="{{detailJob.result_summary}}" class="ag-sheet-body">{{detailJob.result_summary}}</text>
      <text wx:elif="{{detailJob.error_reason}}" class="ag-sheet-body ag-sheet-err">{{t.failed}}</text>
      <text wx:elif="{{detailJob.progress_note}}" class="ag-sheet-body">{{detailJob.progress_note}}</text>
      <text wx:else class="ag-sheet-body ag-muted">{{t.inProgress}}</text>

      <view wx:if="{{detailJob.files.length}}" class="ag-filelist">
        <text class="ag-filelist-title">{{t.reports}}</text>
        <view wx:for="{{detailJob.files}}" wx:for-item="f" wx:key="index" class="ag-file-row"
              bindtap="openResultFile" data-uid="{{detailJob.job_uid}}" data-index="{{f.index}}">
          <text class="ag-file-ext">{{f.extLabel}}</text>
          <view class="ag-file-row-main">
            <text class="ag-file-row-name">{{f.filename}}</text>
            <text wx:if="{{f.sizeLabel}}" class="ag-file-row-size">{{f.sizeLabel}}</text>
          </view>
          <text class="ag-file-row-go">{{downloadingResult ? t.opening : t.openReport}}</text>
        </view>
      </view>
      <view wx:if="{{detailJob.status === 'queued'}}" class="ag-sheet-btn ag-sheet-btn-ghost" bindtap="cancelJob">
        <text>{{t.cancel}}</text>
      </view>
    </view>
  </view>
  <view wx:if="{{reportHtml}}" class="ag-viewer">
    <!-- In-app viewer for .md/.txt artifacts — wx.openDocument supports neither. -->
    <view class="ag-viewer-head">
      <text class="ag-viewer-title">{{reportTitle}}</text>
      <text class="ag-viewer-close" bindtap="closeReport">✕</text>
    </view>
    <scroll-view class="ag-viewer-body" scroll-y="true">
      <mp-html content="{{reportHtml}}" tag-style="{{mdTagStyle}}" />
      <text wx:if="{{reportTruncated}}" class="ag-viewer-trunc">{{t.reportTruncated}}</text>
      <view style="height: 120rpx;"></view>
    </scroll-view>
  </view>
</view>
