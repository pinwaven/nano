/* === Digital Twin Body Figure === */
/* ── Digital Twin Hero Card ── */
.dt-hero-card {
  margin: 0 24rpx 28rpx;
  background: rgba(10, 15, 30, 0.88);
  border: 1rpx solid rgba(99, 117, 236, 0.14);
  border-radius: 28rpx;
  padding: 28rpx 24rpx 20rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.35);
}

.dt-body-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 24rpx;
}

.dt-fig-col {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* CSS body figure — scaled up 1.6× */
.dt-body-fig {
  width: 200rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.dt-fig-head {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  border: 1.5rpx solid;
  flex-shrink: 0;
}

.dt-fig-neck {
  width: 28rpx;
  height: 20rpx;
  border-radius: 6rpx;
  opacity: 0.6;
  flex-shrink: 0;
}

.dt-fig-mid-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 6rpx;
  flex-shrink: 0;
}

.dt-fig-arm {
  width: 30rpx;
  height: 150rpx;
  border-radius: 15rpx;
}

.dt-fig-chest {
  width: 116rpx;
  height: 116rpx;
  border-radius: 22rpx;
  border: 1.5rpx solid;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dt-fig-heart {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  opacity: 0.85;
}

.dt-fig-abdomen {
  width: 110rpx;
  height: 84rpx;
  border-radius: 16rpx;
  border: 1.5rpx solid;
  flex-shrink: 0;
}

.dt-fig-hips {
  width: 116rpx;
  height: 24rpx;
  border-radius: 10rpx;
  opacity: 0.6;
  flex-shrink: 0;
}

.dt-fig-leg-row {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  flex-shrink: 0;
}

.dt-fig-leg {
  width: 52rpx;
  height: 96rpx;
  border-radius: 16rpx;
}

/* Right column: age chips + sub-age rows — fixed to ~half screen */
.dt-sa-col {
  width: 330rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  min-width: 0;
}

.dt-age-chips {
  display: flex;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.dt-age-chips .bio-chip-primary,
.dt-age-chips .bio-chip-dim {
  flex: 1;
}

.dt-age-chips .bio-num-primary,
.dt-age-chips .bio-num-chrono {
  font-size: 52rpx;
  font-weight: 800;
}

.dt-sa-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.dt-sa-accent {
  width: 6rpx;
  min-height: 44rpx;
  border-radius: 3rpx;
  flex-shrink: 0;
}

.dt-sa-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.dt-sa-top {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
}

.dt-sa-label {
  font-size: 22rpx;
  color: rgba(166, 196, 229, 0.65);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dt-sa-val {
  font-size: 28rpx;
  font-weight: 700;
}

.dt-sa-bar {
  height: 5rpx;
  background: rgba(255, 255, 255, 0.07);
  border-radius: 3rpx;
  overflow: hidden;
}

.dt-sa-bar-fill {
  height: 100%;
  border-radius: 3rpx;
  opacity: 0.75;
}

@keyframes dt-sa-flash-anim {
  0%, 100% { opacity: 1; }
  50%       { opacity: 0.1; }
}
.dt-sa-row-flash .dt-sa-bar-fill {
  animation: dt-sa-flash-anim 0.42s ease-in-out 3;
  opacity: 1;
}
.dt-sa-row-flash .dt-sa-accent {
  animation: dt-sa-flash-anim 0.42s ease-in-out 3;
}

/* BioAge expanded chip — border/glow drawn on canvas, not CSS (canvas is native layer) */
.dt-bioage-open {
  border-radius: 22rpx;
  box-shadow: 0 0 40rpx rgba(99, 117, 236, 0.35);
}

.dt-bioage-chart-title {
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  text-transform: uppercase;
  color: rgba(166, 196, 229, 0.45);
}

.dt-bioage-canvas {
  display: block;
  background: #0a1228;
  border-radius: 20rpx;
}

/* Tags strip */
.dt-metrics-strip {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 16rpx;
  padding: 18rpx 8rpx 4rpx;
  border-top: 1rpx solid rgba(99, 117, 236, 0.15);
}
.dt-metric {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.dt-metric-val-row {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  gap: 3rpx;
}
.dt-metric-val {
  font-size: 32rpx;
  font-weight: 700;
  color: rgba(214, 230, 255, 0.92);
  line-height: 1.1;
}
.dt-metric-unit {
  font-size: 20rpx;
  color: rgba(166, 196, 229, 0.5);
  margin-left: 2rpx;
  align-self: flex-end;
  margin-bottom: 4rpx;
}
.dt-metric-label {
  font-size: 20rpx;
  color: rgba(166, 196, 229, 0.45);
  letter-spacing: 0.02em;
}
.dt-metric-tappable {
  position: relative;
}
.dt-metric-trend-hint {
  font-size: 18rpx;
  color: rgba(99, 117, 236, 0.55);
  line-height: 1;
}
.dt-metrics-strip-secondary {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--blue-dim);
}
.bp-chart-legend {
  display: flex;
  flex-direction: row;
  gap: 24rpx;
  padding: 0 20rpx 12rpx;
}
.bp-legend-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
}
.bp-legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}
.bp-legend-sys { background: #ef4444; }
.bp-legend-dia { background: var(--blue); }
.bp-legend-label {
  font-size: 20rpx;
  color: rgba(166, 196, 229, 0.6);
}
.dt-metric-divider {
  width: 1rpx;
  height: 44rpx;
  background: var(--navy-border);
  flex-shrink: 0;
}

.dt-tags-strip {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(99, 117, 236, 0.1);
}

.dt-htag {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  border: 1.5rpx solid;
  border-radius: 20rpx;
  padding: 8rpx 14rpx;
  background: rgba(255, 255, 255, 0.03);
}

.dt-htag-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.dt-htag-label {
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.2;
}

.dt-htag-empty {
  border-color: rgba(166, 196, 229, 0.15);
  color: rgba(166, 196, 229, 0.35);
}

@keyframes dt-fig-pulse-anim {
  0%, 100% { opacity: 0.6; }
  50%       { opacity: 1; }
}

.dt-fig-pulse {
  animation: dt-fig-pulse-anim 2s ease-in-out infinite;
}

/* ── Health Reports ── */

.rpt-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.rpt-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--navy-card);
  border: 1rpx solid var(--navy-border);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
}

.rpt-thumb {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: var(--navy-bg, #0b1a2e);
  border: 1rpx solid var(--navy-border);
}

.rpt-photo {
  width: 100%;
  border-radius: 16rpx;
  border: 1rpx solid var(--navy-border);
}

.rpt-card-left {
  flex: 1;
  min-width: 0;
  border-left: 4rpx solid;
  padding-left: 20rpx;
}

.rpt-institution {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #E8F4FF;
  margin-bottom: 6rpx;
}

.rpt-date {
  display: block;
  font-size: 22rpx;
  color: rgba(166, 196, 229, 0.5);
}

.rpt-type-badge {
  flex-shrink: 0;
  border: 1rpx solid;
  border-radius: 14rpx;
  padding: 6rpx 18rpx;
}

.rpt-type-text {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.rpt-arrow {
  font-size: 36rpx;
  color: rgba(166, 196, 229, 0.3);
  flex-shrink: 0;
}

/* ── Report Detail Bottom Sheet ── */

.rpt-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(5, 14, 28, 0.72);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.rpt-sheet {
  width: 100%;
  max-height: 80vh;
  background: var(--navy);
  border-radius: 36rpx 36rpx 0 0;
  border-top: 1rpx solid rgba(99, 117, 236, 0.2);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.rpt-sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(166, 196, 229, 0.18);
  margin: 20rpx auto 0;
  flex-shrink: 0;
}

.rpt-sheet-header {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 28rpx 36rpx 24rpx;
  border-bottom: 1rpx solid rgba(99, 117, 236, 0.1);
  flex-shrink: 0;
}

.rpt-sheet-title-group {
  flex: 1;
  min-width: 0;
}

.rpt-sheet-institution {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #E8F4FF;
  margin-bottom: 4rpx;
}

.rpt-sheet-date {
  display: block;
  font-size: 22rpx;
  color: rgba(166, 196, 229, 0.45);
}

.rpt-sheet-type-badge {
  flex-shrink: 0;
  border: 1rpx solid;
  border-radius: 14rpx;
  padding: 6rpx 18rpx;
}

.rpt-close-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(99, 117, 236, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.rpt-close-x {
  font-size: 26rpx;
  color: rgba(166, 196, 229, 0.6);
}

.rpt-events-scroll {
  flex: 1;
  height: 0;
}

.rpt-events-list {
  padding: 8rpx 36rpx 40rpx;
}

.rpt-ev-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(99, 117, 236, 0.07);
}

.rpt-ev-row:last-child { border-bottom: none; }

.rpt-ev-left {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.rpt-ev-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 8rpx;
}

.rpt-ev-info {
  flex: 1;
  min-width: 0;
}

.rpt-ev-name {
  display: block;
  font-size: 27rpx;
  font-weight: 700;
  color: var(--wave);
}

.rpt-ev-ref {
  display: block;
  font-size: 20rpx;
  color: rgba(166, 196, 229, 0.35);
  margin-top: 4rpx;
}

.rpt-ev-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.rpt-ev-val {
  font-size: 32rpx;
  font-weight: 800;
  color: #E8F4FF;
}

.rpt-ev-unit {
  font-size: 20rpx;
  color: rgba(166, 196, 229, 0.4);
  min-width: 60rpx;
}

.rpt-ev-status {
  border: 1rpx solid;
  border-radius: 12rpx;
  padding: 4rpx 14rpx;
}

/* ── Report detail sections (diagnostics / advice / markers) ── */

.rpt-section {
  padding: 28rpx 36rpx 0;
}

.rpt-section:last-child { padding-bottom: 40rpx; }

.rpt-section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(99, 117, 236, 0.1);
}

.rpt-section-icon { font-size: 28rpx; }

.rpt-section-title {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  text-transform: uppercase;
  color: rgba(166, 196, 229, 0.45);
}

/* Diagnostics */

.rpt-diag-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.rpt-diag-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.rpt-diag-bullet {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #ef4444;
  flex-shrink: 0;
  margin-top: 10rpx;
}

.rpt-diag-text {
  font-size: 26rpx;
  color: #C8DCF0;
  line-height: 1.65;
  flex: 1;
}

/* Doctor's Advice */

.rpt-advice-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.rpt-advice-item {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.rpt-advice-num {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(99, 117, 236, 0.15);
  border: 1rpx solid rgba(99, 117, 236, 0.3);
  color: #8B9FFF;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  text-align: center;
  line-height: 36rpx;
}

.rpt-advice-text {
  font-size: 26rpx;
  color: #C8DCF0;
  line-height: 1.65;
  flex: 1;
  padding-top: 4rpx;
}

/* ── Doctor Notes Format ── */

.rpt-dn-meta {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  background: rgba(99,117,236,0.08);
  border-radius: 16rpx;
}
.rpt-dn-key {
  font-size: 22rpx;
  color: rgba(166,196,229,0.55);
  flex-shrink: 0;
}
.rpt-dn-val {
  font-size: 26rpx;
  color: var(--wave);
  flex: 1;
}
.rpt-vitals-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.rpt-vital-item {
  background: rgba(15,37,64,0.7);
  border: 1rpx solid rgba(99,117,236,0.2);
  border-radius: 14rpx;
  padding: 12rpx 18rpx;
  min-width: 140rpx;
}
.rpt-vital-key {
  font-size: 20rpx;
  color: rgba(166,196,229,0.5);
  display: block;
  margin-bottom: 4rpx;
}
.rpt-vital-val {
  font-size: 26rpx;
  color: #C8DCF0;
  font-weight: 600;
  display: block;
}
.rpt-clinical {
  margin-bottom: 20rpx;
}
.rpt-clinical-label {
  font-size: 22rpx;
  color: rgba(166,196,229,0.5);
  display: block;
  margin-bottom: 8rpx;
}
.rpt-clinical-text {
  font-size: 26rpx;
  color: var(--wave);
  line-height: 1.7;
  display: block;
}
.rpt-dn-subsection {
  margin-top: 8rpx;
}
.rpt-followup {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: rgba(16,185,129,0.07);
  border-left: 4rpx solid rgba(16,185,129,0.4);
  border-radius: 0 14rpx 14rpx 0;
}
.rpt-followup-label {
  font-size: 22rpx;
  color: rgba(16,185,129,0.7);
  display: block;
  margin-bottom: 6rpx;
}
.rpt-followup-text {
  font-size: 26rpx;
  color: var(--wave);
  line-height: 1.6;
  display: block;
}

/* ── Digital Twin — Lab Snapshot ── */

.ht-lab-card {
  margin: 0 0 24rpx;
  background: rgba(15, 37, 64, 0.7);
  border: 1rpx solid var(--navy-border);
  border-radius: 28rpx;
  padding: 28rpx 28rpx 20rpx;
  overflow: hidden;
}

.ht-lab-header {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

.ht-lab-title {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  text-transform: uppercase;
  color: rgba(166, 196, 229, 0.45);
}

.ht-lab-snapshot-wrap {
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(99, 117, 236, 0.1);
}
.ht-lab-snapshot-header {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 16rpx;
}
.ht-lab-snapshot-title {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: rgba(166, 196, 229, 0.45);
}

.ht-lab-date {
  font-size: 22rpx;
  color: rgba(166, 196, 229, 0.45);
  flex: 1;
}

.ht-lab-alert {
  background: rgba(239, 68, 68, 0.12);
  border: 1rpx solid rgba(239, 68, 68, 0.3);
  border-radius: 14rpx;
  padding: 4rpx 16rpx;
}

.ht-lab-alert-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #ef4444;
}

.ht-lab-ok {
  background: rgba(16, 185, 129, 0.1);
  border: 1rpx solid rgba(16, 185, 129, 0.25);
  border-radius: 14rpx;
  padding: 4rpx 16rpx;
}

.ht-lab-ok-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #10b981;
}

.ht-lab-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 14rpx;
}

.ht-lab-item {
  background: rgba(99, 117, 236, 0.06);
  border: 1rpx solid rgba(99, 117, 236, 0.1);
  border-radius: 18rpx;
  padding: 16rpx 14rpx 14rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.ht-lab-item-abn {
  background: rgba(239, 68, 68, 0.06);
}

.ht-lab-name {
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  display: block;
}

.ht-lab-val {
  font-size: 30rpx;
  font-weight: 800;
  display: block;
  line-height: 1.1;
}

.ht-lab-unit {
  font-size: 17rpx;
  color: rgba(166, 196, 229, 0.35);
  display: block;
}

/* ═══ Wearable Device ═══ */

.wd-inner {
  margin-bottom: 24rpx;
}

.wd-empty-card {
  display: flex;
  align-items: center;
  background: rgba(15, 37, 64, 0.4);
  border: 1rpx solid var(--navy-border);
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  gap: 20rpx;
  cursor: pointer;
  transition: opacity 0.15s;
}

.wd-empty-card:active { opacity: 0.7; }

.wd-ring-icon {
  font-size: 48rpx;
  color: rgba(99, 117, 236, 0.7);
  flex-shrink: 0;
}

.wd-empty-text-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.wd-bind-label {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text);
}

.wd-bind-sub {
  font-size: 20rpx;
  color: rgba(166, 196, 229, 0.5);
}

.wd-chevron {
  font-size: 36rpx;
  color: rgba(99, 117, 236, 0.5);
  flex-shrink: 0;
}

.wd-card {
  background: rgba(15, 37, 64, 0.5);
  border: 1rpx solid var(--navy-border);
  border-radius: 24rpx;
  padding: 18rpx 20rpx;
}

.wd-card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.wd-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
}

.wd-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.wd-device-name {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text);
}

.wd-battery-inline {
  font-size: 20rpx;
  font-weight: 600;
  color: #10b981;
}

.wd-status-text {
  font-size: 20rpx;
  color: rgba(166, 196, 229, 0.5);
}

.wd-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(166, 196, 229, 0.3);
  flex-shrink: 0;
}

.wd-dot-on {
  background: #10b981;
  box-shadow: 0 0 6rpx #10b981;
  animation: wd-pulse 1.4s ease-in-out infinite;
}

@keyframes wd-pulse {
  0%, 100% { opacity: 1; }
  50%       { opacity: 0.4; }
}

.wd-card-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.wd-sync-btn {
  padding: 10rpx 22rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text);
  background: rgba(99, 117, 236, 0.2);
  border: 1rpx solid rgba(99, 117, 236, 0.35);
  border-radius: 40rpx;
}

.wd-sync-btn-text {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text);
}

.wd-sync-btn:active { opacity: 0.6; }

.wd-gear-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(99, 117, 236, 0.08);
  border: 1rpx solid rgba(99, 117, 236, 0.15);
}

.wd-gear-btn-active {
  background: rgba(99, 117, 236, 0.22);
  border-color: rgba(99, 117, 236, 0.4);
}

.wd-gear-glyph {
  font-size: 28rpx;
  color: rgba(166, 196, 229, 0.6);
}

.wd-settings-panel {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--blue-dim);
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.wd-settings-footer {
  display: flex;
  justify-content: flex-end;
}

.wd-interval-section {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.wd-ring-time-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 4rpx;
  border-bottom: 1rpx solid rgba(99, 117, 236, 0.12);
  margin-bottom: 4rpx;
}

.wd-ring-time-label {
  font-size: 20rpx;
  color: rgba(166, 196, 229, 0.55);
}

.wd-ring-time-val {
  font-size: 22rpx;
  font-weight: 600;
  color: rgba(166, 196, 229, 0.85);
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.5px;
}

.wd-interval-title {
  font-size: 20rpx;
  color: rgba(99, 117, 236, 0.7);
  letter-spacing: 0.5px;
  text-transform: uppercase;
}

.wd-interval-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.wd-interval-label-col {
  width: 90rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.wd-interval-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
}

.wd-wm-badge {
  font-size: 17rpx;
  font-weight: 600;
  letter-spacing: 0.3px;
  padding: 1rpx 8rpx;
  border-radius: 20rpx;
  align-self: flex-start;
  cursor: pointer;
}

.wd-wm-badge:active {
  opacity: 0.6;
}

.wd-wm-on {
  color: rgba(52, 211, 153, 0.9);
  background: rgba(52, 211, 153, 0.12);
  border: 1rpx solid rgba(52, 211, 153, 0.25);
}

.wd-wm-off {
  color: rgba(239, 68, 68, 0.75);
  background: rgba(239, 68, 68, 0.08);
  border: 1rpx solid rgba(239, 68, 68, 0.2);
}

.wd-interval-opts {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.wd-int-btn {
  padding: 4rpx 16rpx;
  border-radius: 30rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.45);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.04);
}

.wd-int-btn-on {
  color: rgba(99, 117, 236, 0.95);
  border-color: var(--blue-glow);
  background: rgba(99, 117, 236, 0.1);
}

.wd-settings-loading-row {
  padding: 12rpx 0;
}

.wd-settings-loading-txt {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.35);
}

.wd-save-btn {
  padding: 8rpx 24rpx;
  border-radius: 40rpx;
  border: 1rpx solid var(--blue-glow);
  background: var(--blue-dim);
}

.wd-save-txt {
  font-size: 22rpx;
  color: rgba(99, 117, 236, 0.95);
}

.wd-unbind-btn {
  padding: 8rpx 24rpx;
  border-radius: 40rpx;
  border: 1rpx solid rgba(239, 68, 68, 0.3);
  background: rgba(239, 68, 68, 0.08);
}

.wd-unbind-txt {
  font-size: 22rpx;
  color: rgba(239, 68, 68, 0.75);
}

.wd-btn-disabled {
  opacity: 0.4;
  pointer-events: none;
}

.wd-sync-spinner {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(99, 117, 236, 0.2);
  border-top-color: rgba(99, 117, 236, 0.85);
  animation: wd-spin 0.8s linear infinite;
  margin: 0 16rpx;
  flex-shrink: 0;
}

@keyframes wd-spin {
  to { transform: rotate(360deg); }
}

.wd-measuring-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
}

.wd-measuring-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--blue);
  animation: wd-pulse 1.2s ease-in-out infinite;
  flex-shrink: 0;
}

@keyframes wd-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.25; }
}

.wd-measuring-txt {
  font-size: 22rpx;
  color: rgba(99, 117, 236, 0.8);
}

/* ── Ring sync summary card ── */

.ring-summary-card {
  background: rgba(15, 37, 64, 0.35);
  border: 1rpx solid rgba(99, 117, 236, 0.14);
  border-radius: 20rpx;
  padding: 24rpx 20rpx 18rpx;
  margin-bottom: 20rpx;
}

.ring-sum-metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 0;
  margin-bottom: 14rpx;
}

.ring-sum-item {
  flex: 0 0 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5rpx;
  padding: 0 4rpx;
}

.ring-sum-val-row {
  display: flex;
  align-items: baseline;
  gap: 3rpx;
}

.ring-sum-val {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1;
}

.ring-sum-na {
  font-size: 30rpx;
  font-weight: 600;
  color: rgba(166, 196, 229, 0.35);
  line-height: 1;
}

.ring-sum-unit {
  font-size: 17rpx;
  color: rgba(166, 196, 229, 0.55);
}

.ring-sum-sub {
  font-size: 19rpx;
  color: rgba(166, 196, 229, 0.45);
}

.ring-sum-bar {
  width: 100%;
  height: 6rpx;
  background: var(--blue-dim);
  border-radius: 3rpx;
  margin-top: 6rpx;
  overflow: hidden;
}

.ring-sum-bar-fill {
  height: 100%;
  border-radius: 3rpx;
  transition: width 0.4s ease;
}

.ring-steps-fill { background: #0ea5e9; }
.ring-hr-fill    { background: #f97316; }

.ring-sleep-segs {
  display: flex;
  flex-direction: row;
  background: rgba(99, 117, 236, 0.08);
}

.ring-sum-bar-seg { height: 100%; }
.ring-deep-seg    { background: var(--blue); }
.ring-rem-seg     { background: #a855f7; }
.ring-light-seg   { background: #0ea5e9; }
.ring-awake-seg   { background: rgba(166, 196, 229, 0.18); }

.ring-sum-stress-label {
  font-size: 17rpx;
  font-weight: 600;
  margin-top: 2rpx;
}

.ring-sum-footer {
  display: block;
  font-size: 18rpx;
  color: rgba(166, 196, 229, 0.3);
  text-align: right;
}

/* ── Ring slot detail charts ── */

.ring-detail-card {
  background: rgba(15, 37, 64, 0.3);
  border: 1rpx solid var(--blue-dim);
  border-radius: 20rpx;
  padding: 24rpx 20rpx 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.ring-chart-block {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ring-chart-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ring-chart-label {
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: rgba(166, 196, 229, 0.4);
}

.ring-chart-time {
  font-size: 19rpx;
  color: rgba(99, 117, 236, 0.65);
  font-weight: 600;
}

/* Bar chart: 24 columns side-by-side, bars grow upward */
.ring-chart-bars {
  display: flex;
  align-items: flex-end;
  height: 80rpx;
  gap: 3rpx;
}

.ring-chart-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
  gap: 4rpx;
}

.ring-chart-bar {
  width: 100%;
  border-radius: 3rpx 3rpx 0 0;
  min-height: 3rpx;
  transition: height 0.3s ease;
}

.ring-chart-bar-empty {
  opacity: 0.35;
}

.ring-chart-hlabel {
  font-size: 14rpx;
  color: rgba(166, 196, 229, 0.3);
  line-height: 1;
  min-height: 16rpx;
}

/* Daily trend bar column (HRV / SpO₂ multi-day charts) */
.ring-chart-day-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
  gap: 4rpx;
}

.ring-chart-day-avg {
  font-size: 16rpx;
  font-weight: 600;
  color: rgba(166, 196, 229, 0.55);
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.ring-chart-day-label {
  font-size: 15rpx;
  color: rgba(166, 196, 229, 0.35);
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

/* Date section header in grouped readings list */
.ring-reading-date-header {
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  color: rgba(166, 196, 229, 0.35);
  padding: 14rpx 4rpx 6rpx;
}

/* Realtime readings list */

.ring-readings-list {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.ring-reading-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 16rpx;
  background: rgba(99, 117, 236, 0.05);
  border-radius: 14rpx;
}

.ring-reading-time-col {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  width: 80rpx;
  flex-shrink: 0;
}

.ring-reading-date {
  font-size: 18rpx;
  color: rgba(166, 196, 229, 0.3);
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
}

.ring-reading-time {
  font-size: 22rpx;
  font-weight: 700;
  color: rgba(166, 196, 229, 0.45);
  font-variant-numeric: tabular-nums;
}

.ring-reading-metrics {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.ring-reading-metric {
  display: flex;
  align-items: baseline;
  gap: 5rpx;
}

.ring-reading-val {
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
}

.ring-reading-unit {
  font-size: 17rpx;
  color: rgba(166, 196, 229, 0.35);
}

/* Dense bar charts used for HRV / SpO₂ / Stress history (replaces SVG which doesn't support data binding) */
.ring-lc-bars {
  display: flex;
  align-items: flex-end;
  height: 72rpx;
  gap: 3rpx;
  margin: 0 2rpx;
}

.ring-lc-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.ring-lc-bar {
  width: 100%;
  border-radius: 2rpx 2rpx 0 0;
  min-height: 4rpx;
}

/* Line charts (HRV / SpO₂ / Stress history) */
.ring-linechart-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.ring-linechart-latest-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.ring-linechart-latest {
  font-size: 34rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  line-height: 1;
}

.ring-linechart-unit {
  font-size: 18rpx;
  color: rgba(166, 196, 229, 0.45);
}

.ring-linechart-range {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.ring-linechart-bound {
  font-size: 18rpx;
  color: rgba(166, 196, 229, 0.35);
  font-variant-numeric: tabular-nums;
}

.ring-linechart-count {
  font-size: 18rpx;
  color: rgba(166, 196, 229, 0.25);
}

/* Sleep timeline */
.ring-sleep-timeline {
  height: 24rpx;
  border-radius: 12rpx;
  overflow: hidden;
  display: flex;
  background: rgba(99, 117, 236, 0.08);
}

.ring-sleep-tl-seg {
  height: 100%;
  min-width: 2rpx;
}

.ring-sleep-legend {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.ring-sleep-leg-item {
  display: flex;
  align-items: center;
  gap: 7rpx;
}

.ring-sleep-leg-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.ring-sleep-leg-txt {
  font-size: 19rpx;
  color: rgba(166, 196, 229, 0.5);
  font-weight: 500;
}

/* Privacy consent popup */
.privacy-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.privacy-box {
  background: #132236;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 36rpx;
  margin: 0 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.privacy-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #e2eaf4;
  text-align: center;
}

.privacy-body {
  font-size: 26rpx;
  color: rgba(166, 196, 229, 0.8);
  text-align: center;
  line-height: 1.6;
}

.privacy-agree-btn {
  width: 100%;
  background: #3b82f6;
  color: #fff;
  border-radius: 100rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 0;
  margin-top: 8rpx;
  border: none;
}

.privacy-cancel-btn {
  padding: 8rpx 0;
}

.privacy-cancel-btn text {
  font-size: 26rpx;
  color: rgba(166, 196, 229, 0.5);
}
