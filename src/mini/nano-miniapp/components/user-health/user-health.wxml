<view class="uh-root {{theme === 'light' ? 'theme-light' : ''}}">
  <scroll-view class="health-scroll" scroll-y="true">

    <!-- Guest lock -->
    <view wx:if="{{isGuest}}" class="guest-lock-card" bindtap="onGuestTap">
      <text class="guest-lock-icon">🔬</text>
      <text class="guest-lock-title">{{t.guestHealthCta}}</text>
      <view class="guest-lock-btn"><text>{{t.guestJoinBtn}}</text></view>
    </view>

    <view wx:elif="{{bioLoading}}" class="center-wrap">
      <view class="pulse-dot"></view>
      <view class="pulse-dot"></view>
      <view class="pulse-dot"></view>
    </view>

    <block wx:else>

      <!-- Hero -->
      <view class="health-hero">
        <view class="health-hero-bg"></view>

        <!-- Avatar with side pills -->
        <view class="avatar-area">
          <button wx:if="{{mode === 'self' && !editing}}"
                  class="avatar-side-pill {{avatarPillsVisible ? 'avatar-pill-show' : ''}}"
                  open-type="chooseAvatar"
                  disabled="{{!avatarPillsVisible}}"
                  bindchooseavatar="onChooseAvatar">
            <text class="avatar-pill-text">{{t.changeAvatar}}</text>
          </button>
          <view class="health-avatar-container" bindtap="onAvatarTap">
            <view class="health-avatar-wrap">
              <image wx:if="{{user.avatar_url}}" class="health-avatar-img" src="{{user.avatar_url}}" mode="aspectFill" />
              <view wx:else class="health-avatar-placeholder">
                <text class="health-avatar-letter">{{avatarLetter}}</text>
              </view>
            </view>
            <view wx:if="{{avatarUpdating}}" class="health-avatar-ring"></view>
          </view>
          <view wx:if="{{mode === 'self' && !editing}}"
                class="avatar-side-pill {{avatarPillsVisible ? 'avatar-pill-show' : ''}}"
                catchtap="onEditProfilePill">
            <text class="avatar-pill-text">✎  {{t.editProfile}}</text>
          </view>
        </view>

      </view>

      <!-- Edit form (appears right below avatar, pushes DT card down) -->
      <view wx:if="{{(mode === 'self' || mode === 'coach') && editing}}" class="health-section">
        <view class="edit-form">
          <view class="edit-row">
            <text class="edit-label">{{t.name}}</text>
            <input class="edit-input" value="{{editForm.nickname}}" bindinput="onEditField" data-field="nickname" placeholder="—" />
          </view>
          <view class="edit-row">
            <text class="edit-label">{{t.gender}}</text>
            <view class="gender-btns">
              <view class="gender-btn {{editForm.gender === 'male' ? 'gender-btn-active' : ''}}" bindtap="onGenderSelect" data-value="male">
                <text>{{t.genderMap.male}}</text>
              </view>
              <view class="gender-btn {{editForm.gender === 'female' ? 'gender-btn-active' : ''}}" bindtap="onGenderSelect" data-value="female">
                <text>{{t.genderMap.female}}</text>
              </view>
            </view>
          </view>
          <view class="edit-row">
            <text class="edit-label">{{t.born}}</text>
            <picker mode="date" value="{{editForm.birth_date}}" bindchange="onBirthDateChange">
              <view class="edit-picker">
                <text class="edit-picker-val">{{editForm.birth_date || '—'}}</text>
                <text class="edit-picker-arrow">›</text>
              </view>
            </picker>
          </view>
          <view class="edit-row">
            <text class="edit-label">{{t.height}}</text>
            <view class="edit-input-unit">
              <input class="edit-input" type="digit" value="{{editForm.height}}" bindinput="onEditField" data-field="height" placeholder="—" />
              <text class="edit-unit-text">cm</text>
            </view>
          </view>
          <view class="edit-row">
            <text class="edit-label">{{t.weight}}</text>
            <view class="edit-input-unit">
              <input class="edit-input" type="digit" value="{{editForm.weight}}" bindinput="onEditField" data-field="weight" placeholder="—" />
              <text class="edit-unit-text">kg</text>
            </view>
          </view>
          <text class="edit-section-label">{{t.healthConditions}}</text>
          <view class="edit-cond-list">
            <view wx:for="{{editConditionOptions}}" wx:key="key"
                  class="edit-cond-item"
                  bindtap="onConditionToggle"
                  data-key="{{item.key}}">
              <view class="edit-cond-box {{item.checked ? 'edit-cond-box-checked' : ''}}">
                <text wx:if="{{item.checked}}" class="edit-cond-tick">✓</text>
              </view>
              <text class="edit-cond-text">{{item.label}}</text>
            </view>
          </view>
          <view wx:if="{{editOtherSelected}}" class="edit-other-row">
            <input class="edit-input" value="{{editForm.health_conditions_other}}" bindinput="onEditField" data-field="health_conditions_other" placeholder="{{t.otherPlaceholder}}" />
          </view>
          <view class="edit-actions">
            <view class="edit-cancel-btn" bindtap="cancelEdit"><text>{{t.cancel}}</text></view>
            <view class="edit-save-btn" bindtap="saveEdit">
              <text>{{editSaving ? '…' : t.save}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- Digital Twin Hero Card -->
      <view wx:if="{{subAgeList.length > 0}}" class="dt-hero-card" bindtap="closeBioAgeTrend">
        <view class="dt-body-row">
          <!-- Left: enlarged body figure -->
          <view class="dt-fig-col">
            <view class="dt-body-fig">
              <view class="dt-fig-head {{subAgeZ.ResilienceAge.pulse ? 'dt-fig-pulse' : ''}}"
                style="background:{{subAgeZ.ResilienceAge.fill}};box-shadow:0 0 {{subAgeZ.ResilienceAge.glow}}rpx {{subAgeZ.ResilienceAge.color}};border-color:{{subAgeZ.ResilienceAge.color}}88;"
                catchtap="onZoneTap" data-key="ResilienceAge"></view>
              <view class="dt-fig-neck" style="background:{{subAgeZ.ResilienceAge.fill}};"></view>
              <view class="dt-fig-mid-row">
                <view class="dt-fig-arm {{subAgeZ.MicroVascularAge.pulse ? 'dt-fig-pulse' : ''}}"
                  style="background:{{subAgeZ.MicroVascularAge.fill}};box-shadow:0 0 {{subAgeZ.MicroVascularAge.glow}}rpx {{subAgeZ.MicroVascularAge.color}};"
                  catchtap="onZoneTap" data-key="MicroVascularAge"></view>
                <view class="dt-fig-chest {{subAgeZ.CellularAge.pulse ? 'dt-fig-pulse' : ''}}"
                  style="background:{{subAgeZ.CellularAge.fill}};box-shadow:0 0 {{subAgeZ.CellularAge.glow}}rpx {{subAgeZ.CellularAge.color}};border-color:{{subAgeZ.CellularAge.color}}88;"
                  catchtap="onZoneTap" data-key="CellularAge">
                  <view class="dt-fig-heart" style="background:{{subAgeZ.CellularAge.color}};box-shadow:0 0 8rpx {{subAgeZ.CellularAge.color}};"></view>
                </view>
                <view class="dt-fig-arm {{subAgeZ.MicroVascularAge.pulse ? 'dt-fig-pulse' : ''}}"
                  style="background:{{subAgeZ.MicroVascularAge.fill}};box-shadow:0 0 {{subAgeZ.MicroVascularAge.glow}}rpx {{subAgeZ.MicroVascularAge.color}};"
                  catchtap="onZoneTap" data-key="MicroVascularAge"></view>
              </view>
              <view class="dt-fig-abdomen {{subAgeZ.MetabolicAge.pulse ? 'dt-fig-pulse' : ''}}"
                style="background:{{subAgeZ.MetabolicAge.fill}};box-shadow:0 0 {{subAgeZ.MetabolicAge.glow}}rpx {{subAgeZ.MetabolicAge.color}};border-color:{{subAgeZ.MetabolicAge.color}}88;"
                catchtap="onZoneTap" data-key="MetabolicAge"></view>
              <view class="dt-fig-hips" style="background:{{subAgeZ.MetabolicAge.fill}};"></view>
              <view class="dt-fig-leg-row">
                <view class="dt-fig-leg {{subAgeZ.MicroVascularAge.pulse ? 'dt-fig-pulse' : ''}}"
                  style="background:{{subAgeZ.MicroVascularAge.fill}};box-shadow:0 0 {{subAgeZ.MicroVascularAge.glow}}rpx {{subAgeZ.MicroVascularAge.color}};"
                  catchtap="onZoneTap" data-key="MicroVascularAge"></view>
                <view class="dt-fig-leg {{subAgeZ.MicroVascularAge.pulse ? 'dt-fig-pulse' : ''}}"
                  style="background:{{subAgeZ.MicroVascularAge.fill}};box-shadow:0 0 {{subAgeZ.MicroVascularAge.glow}}rpx {{subAgeZ.MicroVascularAge.color}};"
                  catchtap="onZoneTap" data-key="MicroVascularAge"></view>
              </view>
            </view>
          </view>
          <!-- Right: BioAge + sub-ages -->
          <view class="dt-sa-col">
            <view wx:if="{{bAge || cAge}}">
              <!-- Collapsed: side-by-side chips, tap BioAge to expand -->
              <view wx:if="{{!bioAgeTrendOpen}}" class="dt-age-chips">
                <view class="bio-chip bio-chip-dim">
                  <text class="bio-num bio-num-chrono">{{cAge || '—'}}</text>
                  <text class="bio-unit">{{t.chronoAge}}</text>
                </view>
                <view class="bio-chip bio-chip-primary" catchtap="toggleBioAgeTrend">
                  <text class="bio-num bio-num-primary" style="color:{{bAgeColor}}">{{bAge || '—'}}</text>
                  <text class="bio-unit">{{t.bioAge}}</text>
                </view>
              </view>
              <!-- Expanded: canvas fills the entire chip -->
              <view wx:if="{{bioAgeTrendOpen}}" class="dt-bioage-open" catchtap="toggleBioAgeTrend">
                <canvas canvas-id="dt-bioage-chart" class="dt-bioage-canvas"
                  style="width:{{bioAgeChartW}}px;height:200px;"></canvas>
              </view>
            </view>
            <view wx:for="{{subAgeList}}" wx:key="key" wx:if="{{!bioAgeTrendOpen}}" class="dt-sa-row {{flashSubAge === item.key ? 'dt-sa-row-flash' : ''}}">
              <view class="dt-sa-accent {{subAgeZ[item.key].pulse ? 'dt-fig-pulse' : ''}}"
                style="background:{{item.color}};box-shadow:0 0 6rpx {{item.color}};"></view>
              <view class="dt-sa-info">
                <view class="dt-sa-top">
                  <text class="dt-sa-label">{{item.label}}</text>
                  <text class="dt-sa-val" style="color:{{item.color}}">{{item.value}}</text>
                </view>
                <view class="dt-sa-bar">
                  <view class="dt-sa-bar-fill" style="width:{{item.score}}%;background:{{item.color}};"></view>
                </view>
              </view>
            </view>
          </view>
        </view>
        <!-- Tags strip -->
        <view class="dt-tags-strip">
          <view wx:for="{{healthTags}}" wx:key="index" class="dt-htag"
                style="border-color:{{item.color}}55;color:{{item.color}};">
            <view class="dt-htag-dot" style="background:{{item.color}};"></view>
            <text class="dt-htag-label">{{item.label}}</text>
          </view>
          <view wx:if="{{healthTags.length === 0}}" class="dt-htag dt-htag-empty">
            <text class="dt-htag-label">{{t.noHealthSignals}}</text>
          </view>
        </view>

        <!-- Metric strip: weight / BMI / steps / HRV / stress -->
        <view class="dt-metrics-strip">
          <view class="dt-metric {{weightHistory.length > 1 ? 'dt-metric-tappable' : ''}}"
                bindtap="{{weightHistory.length > 1 ? 'openWeightChart' : ''}}">
            <view class="dt-metric-val-row">
              <text class="dt-metric-val">{{rawWeight != null ? rawWeight : '—'}}</text>
              <text wx:if="{{rawWeight != null}}" class="dt-metric-unit">kg</text>
            </view>
            <text class="dt-metric-label">{{t.weight}}</text>
            <text wx:if="{{weightHistory.length > 1}}" class="dt-metric-trend-hint">›</text>
          </view>
          <view class="dt-metric-divider"></view>
          <view class="dt-metric {{bmiHistory.length > 1 ? 'dt-metric-tappable' : ''}}"
                bindtap="{{bmiHistory.length > 1 ? 'openBmiChart' : ''}}">
            <text class="dt-metric-val">{{rawBmi != null ? rawBmi : '—'}}</text>
            <text class="dt-metric-label">BMI</text>
            <text wx:if="{{bmiHistory.length > 1}}" class="dt-metric-trend-hint">›</text>
          </view>
          <view class="dt-metric-divider"></view>
          <view class="dt-metric {{stepsHistory.length > 1 ? 'dt-metric-tappable' : ''}}"
                bindtap="{{stepsHistory.length > 1 ? 'openStepsChart' : ''}}">
            <text class="dt-metric-val">{{ringData && ringData.hasSteps ? ringData.stepsStr : '—'}}</text>
            <text class="dt-metric-label">{{t.ringSteps}}</text>
            <text wx:if="{{stepsHistory.length > 1}}" class="dt-metric-trend-hint">›</text>
          </view>
          <view class="dt-metric-divider"></view>
          <view class="dt-metric {{hrvHistory.length > 1 ? 'dt-metric-tappable' : ''}}"
                bindtap="{{hrvHistory.length > 1 ? 'openHrvChart' : ''}}">
            <view class="dt-metric-val-row">
              <text class="dt-metric-val" style="{{ringData && ringData.hasHrv ? 'color:' + ringData.hrvColor : ''}}">{{ringData && ringData.hasHrv ? ringData.hrv : '—'}}</text>
              <text wx:if="{{ringData && ringData.hasHrv}}" class="dt-metric-unit">ms</text>
            </view>
            <text class="dt-metric-label">{{t.ringHrv}}</text>
            <text wx:if="{{hrvHistory.length > 1}}" class="dt-metric-trend-hint">›</text>
          </view>
          <view class="dt-metric-divider"></view>
          <view class="dt-metric {{stressHistory.length > 1 ? 'dt-metric-tappable' : ''}}"
                bindtap="{{stressHistory.length > 1 ? 'openStressChart' : ''}}">
            <text class="dt-metric-val" style="{{ringData && ringData.hasStress ? 'color:' + ringData.stressColor : ''}}">{{ringData && ringData.hasStress ? ringData.stress : '—'}}</text>
            <text class="dt-metric-label">{{t.ringStress}}</text>
            <text wx:if="{{stressHistory.length > 1}}" class="dt-metric-trend-hint">›</text>
          </view>
        </view>

        <!-- BP / Glucose row — only shown when photo data is available -->
        <view wx:if="{{latestBp || latestGlucose}}" class="dt-metrics-strip dt-metrics-strip-secondary">
          <view wx:if="{{latestBp}}"
                class="dt-metric {{bpHistory.length > 1 ? 'dt-metric-tappable' : ''}}"
                bindtap="{{bpHistory.length > 1 ? 'openBpChart' : ''}}">
            <view class="dt-metric-val-row">
              <text class="dt-metric-val">{{latestBp.systolic}}/{{latestBp.diastolic}}</text>
              <text class="dt-metric-unit">mmHg</text>
            </view>
            <text class="dt-metric-label">{{t.metricBp}}</text>
            <text wx:if="{{bpHistory.length > 1}}" class="dt-metric-trend-hint">›</text>
          </view>
          <view wx:if="{{latestBp && latestGlucose}}" class="dt-metric-divider"></view>
          <view wx:if="{{latestGlucose}}"
                class="dt-metric {{glucoseHistory.length > 1 ? 'dt-metric-tappable' : ''}}"
                bindtap="{{glucoseHistory.length > 1 ? 'openGlucoseChart' : ''}}">
            <view class="dt-metric-val-row">
              <text class="dt-metric-val">{{latestGlucose.glucose}}</text>
              <text class="dt-metric-unit">mmol/L</text>
            </view>
            <text class="dt-metric-label">{{t.metricGlucose}}</text>
            <text wx:if="{{glucoseHistory.length > 1}}" class="dt-metric-trend-hint">›</text>
          </view>
        </view>
      </view>

      <!-- Health Monitoring -->
      <view class="health-section">
        <text class="section-title">{{t.dtMonitoring}}</text>

        <!-- Wearable Device (always visible — ring is the data source) -->
        <view class="wd-inner">
          <view wx:if="{{!wearableId}}" class="wd-empty-card" bindtap="handleBindWearable">
            <view class="wd-ring-icon">◉</view>
            <view class="wd-empty-text-wrap">
              <text class="wd-bind-label">{{t.bindSmartRing}}</text>
              <text wx:if="{{wearableServerHint}}" class="wd-server-hint">{{t.wearableAlreadyBound}} {{wearableServerHint.name || wearableServerHint.brand}}</text>
            </view>
            <text class="wd-chevron">›</text>
          </view>
          <view wx:else class="wd-card">
            <view class="wd-card-row">
              <view class="wd-info">
                <view class="wd-name-row">
                  <view class="wd-dot{{wearableConnected ? ' wd-dot-on' : ''}}"></view>
                  <text class="wd-device-name">{{wearableName}}</text>
                  <text wx:if="{{wearableBattery > 0}}" class="wd-battery-inline">{{wearableBattery}}%</text>
                </view>
                <text class="wd-status-text">{{wearableConnected ? t.wearableConnected : t.wearableDisconnected}}</text>
              </view>
              <view class="wd-card-actions">
                <view wx:if="{{wearableBusy}}" class="wd-sync-spinner"></view>
                <view wx:else class="wd-sync-btn" bindtap="handleSyncWearable">
                  <text class="wd-sync-btn-text">{{t.wearableSyncNow}}</text>
                </view>
                <view class="wd-gear-btn {{ringSettingsOpen ? 'wd-gear-btn-active' : ''}}" catchtap="toggleRingSettings">
                  <text class="wd-gear-glyph">⚙</text>
                </view>
              </view>
            </view>
            <view wx:if="{{ringSettingsOpen}}" class="wd-settings-panel">
              <view wx:if="{{wearableBrand === 'halo'}}" class="wd-interval-section">
                <view wx:if="{{ringSettingsBusy}}" class="wd-settings-loading-row">
                  <text class="wd-settings-loading-txt">{{t.haloIntervalLoading}}</text>
                </view>
                <block wx:else>
                  <view class="wd-ring-time-row">
                    <text class="wd-ring-time-label">{{t.haloRingTimeLabel}}</text>
                    <text class="wd-ring-time-val">{{haloRingTime || '—'}}</text>
                  </view>
                  <text class="wd-interval-title">{{t.haloIntervalTitle}}</text>
                  <view class="wd-interval-row">
                    <view class="wd-interval-label-col">
                      <text class="wd-interval-label">{{t.metricHr}}</text>
                      <text class="wd-wm-badge {{haloWorkModes.hr === 0 ? 'wd-wm-off' : 'wd-wm-on'}}" bindtap="handleWorkModeChange" data-type="hr">{{haloWorkModes.hr === 0 ? t.haloWorkModeOff : haloWorkModes.hr === 2 ? t.haloWorkModeSched : t.haloWorkModeAuto}}</text>
                    </view>
                    <view class="wd-interval-opts">
                      <view wx:for="{{haloIntervalOpts.hr}}" wx:key="index" bindtap="handleIntervalChange" data-type="hr" data-min="{{item}}" class="wd-int-btn {{haloIntervals.hr === item ? 'wd-int-btn-on' : ''}}">{{item}}{{t.haloIntervalUnit}}</view>
                    </view>
                  </view>
                  <view class="wd-interval-row">
                    <view class="wd-interval-label-col">
                      <text class="wd-interval-label">{{t.metricSpo2}}</text>
                      <text class="wd-wm-badge {{haloWorkModes.spo2 === 0 ? 'wd-wm-off' : 'wd-wm-on'}}" bindtap="handleWorkModeChange" data-type="spo2">{{haloWorkModes.spo2 === 0 ? t.haloWorkModeOff : haloWorkModes.spo2 === 2 ? t.haloWorkModeSched : t.haloWorkModeAuto}}</text>
                    </view>
                    <view class="wd-interval-opts">
                      <view wx:for="{{haloIntervalOpts.spo2}}" wx:key="index" bindtap="handleIntervalChange" data-type="spo2" data-min="{{item}}" class="wd-int-btn {{haloIntervals.spo2 === item ? 'wd-int-btn-on' : ''}}">{{item}}{{t.haloIntervalUnit}}</view>
                    </view>
                  </view>
                  <view class="wd-interval-row">
                    <view class="wd-interval-label-col">
                      <text class="wd-interval-label">{{t.metricTemp}}</text>
                      <text class="wd-wm-badge {{haloWorkModes.temp === 0 ? 'wd-wm-off' : 'wd-wm-on'}}" bindtap="handleWorkModeChange" data-type="temp">{{haloWorkModes.temp === 0 ? t.haloWorkModeOff : haloWorkModes.temp === 2 ? t.haloWorkModeSched : t.haloWorkModeAuto}}</text>
                    </view>
                    <view class="wd-interval-opts">
                      <view wx:for="{{haloIntervalOpts.temp}}" wx:key="index" bindtap="handleIntervalChange" data-type="temp" data-min="{{item}}" class="wd-int-btn {{haloIntervals.temp === item ? 'wd-int-btn-on' : ''}}">{{item}}{{t.haloIntervalUnit}}</view>
                    </view>
                  </view>
                  <view class="wd-interval-row">
                    <view class="wd-interval-label-col">
                      <text class="wd-interval-label">{{t.metricHrv}}</text>
                      <text class="wd-wm-badge {{haloWorkModes.hrv === 0 ? 'wd-wm-off' : 'wd-wm-on'}}" bindtap="handleWorkModeChange" data-type="hrv">{{haloWorkModes.hrv === 0 ? t.haloWorkModeOff : haloWorkModes.hrv === 2 ? t.haloWorkModeSched : t.haloWorkModeAuto}}</text>
                    </view>
                    <view class="wd-interval-opts">
                      <view wx:for="{{haloIntervalOpts.hrv}}" wx:key="index" bindtap="handleIntervalChange" data-type="hrv" data-min="{{item}}" class="wd-int-btn {{haloIntervals.hrv === item ? 'wd-int-btn-on' : ''}}">{{item}}{{t.haloIntervalUnit}}</view>
                    </view>
                  </view>
                </block>
              </view>
              <view class="wd-settings-footer">
                <view wx:if="{{haloIntervalsChanged}}" class="wd-save-btn {{ringSettingsBusy ? 'wd-btn-disabled' : ''}}" bindtap="saveRingIntervals">
                  <text class="wd-save-txt">{{t.haloSaveIntervals}}</text>
                </view>
                <view class="wd-unbind-btn" bindtap="handleUnbindWearable">
                  <text class="wd-unbind-txt">{{t.wearableUnbind}}</text>
                </view>
              </view>
            </view>
            <view wx:if="{{ringMeasuring}}" class="wd-measuring-row">
              <view class="wd-measuring-dot"></view>
              <text class="wd-measuring-txt">{{t.wearableMeasuringBg}}</text>
            </view>
          </view>
        </view>

        <!-- Ring sync summary (shown after first sync) -->
        <view wx:if="{{wearableId && ringData}}" class="ring-summary-card">
          <view class="ring-sum-metrics">
            <view class="ring-sum-item">
              <view wx:if="{{ringData.hasSteps}}" class="ring-sum-val-row">
                <text class="ring-sum-val">{{ringData.stepsStr}}</text>
              </view>
              <text wx:else class="ring-sum-na">—</text>
              <text class="ring-sum-sub">{{t.ringSteps}}</text>
              <view wx:if="{{ringData.hasSteps}}" class="ring-sum-bar">
                <view class="ring-sum-bar-fill ring-steps-fill" style="width: {{ringData.stepsPct}}%;"></view>
              </view>
            </view>
            <view class="ring-sum-item">
              <view wx:if="{{ringData.hasSleep}}" class="ring-sum-val-row">
                <text class="ring-sum-val">{{ringData.sleepStr}}</text>
              </view>
              <text wx:else class="ring-sum-na">—</text>
              <text class="ring-sum-sub">{{t.ringSleep}}</text>
              <view wx:if="{{ringData.hasSleep}}" class="ring-sum-bar ring-sleep-segs">
                <view class="ring-sum-bar-seg ring-deep-seg" style="width: {{ringData.sleepDeepPct}}%;"></view>
                <view class="ring-sum-bar-seg ring-rem-seg" style="width: {{ringData.sleepRemPct}}%;"></view>
                <view class="ring-sum-bar-seg ring-light-seg" style="width: {{ringData.sleepLightPct}}%;"></view>
                <view class="ring-sum-bar-seg ring-awake-seg" style="width: {{ringData.sleepAwakePct}}%;"></view>
              </view>
            </view>
            <view class="ring-sum-item">
              <view wx:if="{{ringData.hasHr}}" class="ring-sum-val-row">
                <text class="ring-sum-val">{{ringData.restingHr}}</text>
                <text class="ring-sum-unit">bpm</text>
              </view>
              <text wx:else class="ring-sum-na">—</text>
              <text class="ring-sum-sub">{{t.ringHr}}</text>
              <view wx:if="{{ringData.hasHr}}" class="ring-sum-bar">
                <view class="ring-sum-bar-fill ring-hr-fill" style="width: {{ringData.restingHr < 65 ? 90 : ringData.restingHr < 80 ? 65 : 40}}%;"></view>
              </view>
            </view>
            <view class="ring-sum-item">
              <view wx:if="{{ringData.hasHrv}}" class="ring-sum-val-row">
                <text class="ring-sum-val" style="color: {{ringData.hrvColor}}">{{ringData.hrv}}</text>
                <text class="ring-sum-unit">ms</text>
              </view>
              <text wx:else class="ring-sum-na">—</text>
              <text class="ring-sum-sub">{{t.ringHrv}}</text>
              <view wx:if="{{ringData.hasHrv}}" class="ring-sum-bar">
                <view class="ring-sum-bar-fill" style="width: {{ringData.hrvPct}}%; background: {{ringData.hrvColor}};"></view>
              </view>
            </view>
            <view class="ring-sum-item">
              <view wx:if="{{ringData.hasStress}}" class="ring-sum-val-row">
                <text class="ring-sum-val" style="color: {{ringData.stressColor}}">{{ringData.stress}}</text>
              </view>
              <text wx:else class="ring-sum-na">—</text>
              <text class="ring-sum-sub">{{t.ringStress}}</text>
              <view wx:if="{{ringData.hasStress}}" class="ring-sum-bar">
                <view class="ring-sum-bar-fill" style="width: {{ringData.stress}}%; background: {{ringData.stressColor}};"></view>
              </view>
              <text wx:if="{{ringData.hasStress}}" class="ring-sum-stress-label" style="color: {{ringData.stressColor}}">{{ringData.stressLabel}}</text>
            </view>
            <view class="ring-sum-item">
              <view wx:if="{{ringData.hasSpo2}}" class="ring-sum-val-row">
                <text class="ring-sum-val" style="color: {{ringData.spo2Color}}">{{ringData.spo2}}</text>
                <text class="ring-sum-unit">%</text>
              </view>
              <text wx:else class="ring-sum-na">—</text>
              <text class="ring-sum-sub">SpO₂</text>
              <view wx:if="{{ringData.hasSpo2}}" class="ring-sum-bar">
                <view class="ring-sum-bar-fill" style="width: {{ringData.spo2Pct}}%; background: {{ringData.spo2Color}};"></view>
              </view>
            </view>
            <view wx:if="{{ringData.hasBodyTemp}}" class="ring-sum-item">
              <view class="ring-sum-val-row">
                <text class="ring-sum-val" style="color: {{ringData.tempColor}}">{{ringData.bodyTempC}}</text>
                <text class="ring-sum-unit">°C</text>
              </view>
              <text class="ring-sum-sub">{{t.ringBodyTemp}}</text>
              <view class="ring-sum-bar">
                <view class="ring-sum-bar-fill" style="width: {{ringData.tempPct}}%; background: {{ringData.tempColor}};"></view>
              </view>
            </view>
          </view>
          <text class="ring-sum-footer">{{ringData.syncLabel}}</text>
        </view>

        <!-- Slot detail charts (steps / HR / sleep) -->
        <view wx:if="{{wearableId && ringData && ringData.hasSlotCharts}}" class="ring-detail-card">

          <!-- Steps hourly bar chart -->
          <view wx:if="{{ringData.stepsBars}}" class="ring-chart-block">
            <text class="ring-chart-label">{{t.ringStepsChart}}</text>
            <view class="ring-chart-bars">
              <view wx:for="{{ringData.stepsBars}}" wx:key="index" class="ring-chart-col">
                <view class="ring-chart-bar {{item.active ? '' : 'ring-chart-bar-empty'}}"
                      style="height:{{item.heightRpx > 0 ? item.heightRpx : 3}}rpx; background:{{item.active ? '#0ea5e9' : 'rgba(99,117,236,0.1)'}};">
                </view>
                <text class="ring-chart-hlabel">{{item.h}}</text>
              </view>
            </view>
          </view>

          <!-- HR hourly bar chart -->
          <view wx:if="{{ringData.hrBars}}" class="ring-chart-block">
            <text class="ring-chart-label">{{t.ringHrChart}}</text>
            <view class="ring-chart-bars">
              <view wx:for="{{ringData.hrBars}}" wx:key="index" class="ring-chart-col">
                <view class="ring-chart-bar"
                      style="height:{{item.heightRpx}}rpx; background:{{item.color}};">
                </view>
                <text class="ring-chart-hlabel">{{item.h}}</text>
              </view>
            </view>
          </view>

          <!-- HRV daily trend (last 7 days) -->
          <view wx:if="{{ringData.hrvDayBars}}" class="ring-chart-block">
            <text class="ring-chart-label">{{t.ringHrvTrend}}</text>
            <view class="ring-chart-bars">
              <view wx:for="{{ringData.hrvDayBars}}" wx:key="label" class="ring-chart-day-col">
                <text class="ring-chart-day-avg">{{item.avg}}</text>
                <view class="ring-chart-bar"
                      style="height:{{item.heightRpx}}rpx; background:{{item.color}};"></view>
                <text class="ring-chart-day-label">{{item.label}}</text>
              </view>
            </view>
          </view>

          <!-- SpO₂ daily trend (last 7 days) -->
          <view wx:if="{{ringData.spo2DayBars}}" class="ring-chart-block">
            <text class="ring-chart-label">{{t.ringSpo2Trend}}</text>
            <view class="ring-chart-bars">
              <view wx:for="{{ringData.spo2DayBars}}" wx:key="label" class="ring-chart-day-col">
                <text class="ring-chart-day-avg">{{item.avg}}%</text>
                <view class="ring-chart-bar"
                      style="height:{{item.heightRpx}}rpx; background:{{item.color}};"></view>
                <text class="ring-chart-day-label">{{item.label}}</text>
              </view>
            </view>
          </view>

          <!-- Weekly sleep timeline: every night + nap as a distinct block, -->
          <!-- positioned on a noon-to-noon 24h axis so overnight sleep isn't split by midnight -->
          <view wx:if="{{ringData.sleepWeek}}" class="ring-chart-block">
            <text class="ring-chart-label">{{t.ringSleepWeek}}</text>
            <view class="ring-sleepweek-wrap">
              <view class="ring-sleepweek-axis" style="height:{{ringData.sleepAxisHeightRpx}}rpx;">
                <text class="ring-sleepweek-axis-lbl">12</text>
                <text class="ring-sleepweek-axis-lbl">18</text>
                <text class="ring-sleepweek-axis-lbl">24</text>
                <text class="ring-sleepweek-axis-lbl">06</text>
                <text class="ring-sleepweek-axis-lbl">12</text>
              </view>
              <view class="ring-sleepweek-days">
                <view wx:for="{{ringData.sleepWeek}}" wx:for-item="day" wx:key="date" class="ring-sleepweek-daycol">
                  <view class="ring-sleepweek-track" style="height:{{ringData.sleepAxisHeightRpx}}rpx;">
                    <view class="ring-sleepweek-gridline" style="top:0%;"></view>
                    <view class="ring-sleepweek-gridline" style="top:25%;"></view>
                    <view class="ring-sleepweek-gridline" style="top:50%;"></view>
                    <view class="ring-sleepweek-gridline" style="top:75%;"></view>
                    <view wx:for="{{day.blocks}}" wx:for-item="blk" wx:key="key"
                          class="ring-sleepweek-block {{blk.isNap ? 'ring-sleepweek-block-nap' : ''}}"
                          style="top:{{blk.topRpx}}rpx; height:{{blk.heightRpx}}rpx; background:{{blk.color}};">
                    </view>
                  </view>
                  <text class="ring-sleepweek-total">{{day.totalLabel}}</text>
                  <text class="ring-sleepweek-daylabel">{{day.label}}</text>
                </view>
              </view>
            </view>
            <view class="ring-sleep-legend">
              <view class="ring-sleep-leg-item">
                <view class="ring-sleep-leg-dot" style="background:#10b981;"></view>
                <text class="ring-sleep-leg-txt">{{t.ringNightSleep}}</text>
              </view>
              <view class="ring-sleep-leg-item">
                <view class="ring-sleep-leg-dot" style="background:#f59e0b;"></view>
                <text class="ring-sleep-leg-txt">{{t.ringNap}}</text>
              </view>
            </view>
          </view>

          <!-- HRV line chart -->
          <view wx:if="{{ringData.hrvChart.hasData}}" class="ring-chart-block">
            <view class="ring-linechart-header">
              <text class="ring-chart-label">{{t.ringHrv}}</text>
              <view class="ring-linechart-latest-row">
                <text class="ring-linechart-latest" style="color:{{ringData.hrvChart.latestColor}}">{{ringData.hrvChart.latestVal}}</text>
                <text class="ring-linechart-unit">ms</text>
              </view>
            </view>
            <view class="ring-lc-bars">
              <view wx:for="{{ringData.hrvChart.bars}}" wx:key="index" class="ring-lc-col">
                <view class="ring-lc-bar" style="height:{{item.heightRpx}}rpx; background:{{item.color}};"></view>
              </view>
            </view>
            <view class="ring-linechart-range">
              <text class="ring-linechart-bound">{{ringData.hrvChart.minVal}} ms</text>
              <text class="ring-linechart-count">{{ringData.hrvChart.count}} 次</text>
              <text class="ring-linechart-bound">{{ringData.hrvChart.maxVal}} ms</text>
            </view>
          </view>

          <!-- SpO₂ line chart -->
          <view wx:if="{{ringData.spo2Chart.hasData}}" class="ring-chart-block">
            <view class="ring-linechart-header">
              <text class="ring-chart-label">SpO₂</text>
              <view class="ring-linechart-latest-row">
                <text class="ring-linechart-latest" style="color:{{ringData.spo2Chart.latestColor}}">{{ringData.spo2Chart.latestVal}}</text>
                <text class="ring-linechart-unit">%</text>
              </view>
            </view>
            <view class="ring-lc-bars">
              <view wx:for="{{ringData.spo2Chart.bars}}" wx:key="index" class="ring-lc-col">
                <view class="ring-lc-bar" style="height:{{item.heightRpx}}rpx; background:{{item.color}};"></view>
              </view>
            </view>
            <view class="ring-linechart-range">
              <text class="ring-linechart-bound">{{ringData.spo2Chart.minVal}}%</text>
              <text class="ring-linechart-count">{{ringData.spo2Chart.count}} 次</text>
              <text class="ring-linechart-bound">{{ringData.spo2Chart.maxVal}}%</text>
            </view>
          </view>

          <!-- Stress line chart -->
          <view wx:if="{{ringData.stressChart.hasData}}" class="ring-chart-block">
            <view class="ring-linechart-header">
              <text class="ring-chart-label">{{t.ringStress}}</text>
              <view class="ring-linechart-latest-row">
                <text class="ring-linechart-latest" style="color:{{ringData.stressChart.latestColor}}">{{ringData.stressChart.latestVal}}</text>
              </view>
            </view>
            <view class="ring-lc-bars">
              <view wx:for="{{ringData.stressChart.bars}}" wx:key="index" class="ring-lc-col">
                <view class="ring-lc-bar" style="height:{{item.heightRpx}}rpx; background:{{item.color}};"></view>
              </view>
            </view>
            <view class="ring-linechart-range">
              <text class="ring-linechart-bound">{{ringData.stressChart.minVal}}</text>
              <text class="ring-linechart-count">{{ringData.stressChart.count}} 次</text>
              <text class="ring-linechart-bound">{{ringData.stressChart.maxVal}}</text>
            </view>
          </view>

          <!-- Sleep stage timeline (most recent night, detailed) -->
          <view wx:if="{{ringData.sleepSegs}}" class="ring-chart-block">
            <view class="ring-chart-header">
              <text class="ring-chart-label">{{t.ringSleepChart}}</text>
              <view class="ring-chart-header-right">
                <text wx:if="{{ringData.sleepDateLabel}}" class="ring-chart-date">{{ringData.sleepDateLabel}}</text>
                <text wx:if="{{ringData.sleepTimeRange}}" class="ring-chart-time">{{ringData.sleepTimeRange}}</text>
              </view>
            </view>
            <view class="ring-sleep-timeline">
              <view wx:for="{{ringData.sleepSegs}}" wx:key="index"
                    class="ring-sleep-tl-seg"
                    style="width:{{item.widthPct}}%; background:{{item.color}};">
              </view>
            </view>
            <view class="ring-sleep-legend">
              <view class="ring-sleep-leg-item">
                <view class="ring-sleep-leg-dot" style="background:#6375EC;"></view>
                <text class="ring-sleep-leg-txt">{{t.ringDeep}} {{ringData.sleepDeep}}m</text>
              </view>
              <view class="ring-sleep-leg-item">
                <view class="ring-sleep-leg-dot" style="background:#a855f7;"></view>
                <text class="ring-sleep-leg-txt">{{t.ringRem}} {{ringData.sleepRem}}m</text>
              </view>
              <view class="ring-sleep-leg-item">
                <view class="ring-sleep-leg-dot" style="background:#0ea5e9;"></view>
                <text class="ring-sleep-leg-txt">{{t.ringLight}} {{ringData.sleepLight}}m</text>
              </view>
              <view class="ring-sleep-leg-item">
                <view class="ring-sleep-leg-dot" style="background:rgba(166,196,229,0.4);"></view>
                <text class="ring-sleep-leg-txt">{{t.ringAwake}} {{ringData.sleepAwake}}m</text>
              </view>
            </view>
          </view>

        </view>

        <block wx:if="{{hasTwinData}}">

          <!-- Body Composition -->
          <view wx:if="{{twinBodyBar}}" class="ht-body-card">
            <view class="ht-body-header">
              <text class="ht-body-title">{{t.dtBody}}</text>
              <text wx:if="{{twinBody}}" class="ht-body-vals">{{twinBody}}</text>
            </view>
            <view class="ht-body-bar">
              <view class="ht-body-lean" style="width: {{twinBodyBar.leanPct}}%;"></view>
              <view class="ht-body-fat-fill" style="width: {{twinBodyBar.fatPct}}%;"></view>
            </view>
            <view class="ht-body-legend">
              <view class="ht-body-legend-item">
                <view class="ht-body-dot ht-lean-dot"></view>
                <text class="ht-body-lbl">{{t.dtLean}}  {{twinBodyBar.leanPct}}%</text>
              </view>
              <view class="ht-body-legend-item">
                <view class="ht-body-dot ht-fat-dot"></view>
                <text class="ht-body-lbl">{{t.dtFat}}  {{twinBodyBar.fatPct}}%</text>
              </view>
            </view>
          </view>

        </block>
        <text wx:elif="{{!twinLoading}}" class="health-empty">{{t.noTwinData}}</text>
      </view>

      <!-- Kino Trends -->
      <view class="health-section">
        <view class="section-title-row">
          <text class="section-title">{{t.trends}}</text>
          <view wx:if="{{recordCount > 0}}" class="section-badge">
            <text>{{recordCount}} {{t.tests}}</text>
          </view>
        </view>
        <view wx:if="{{recordCount > 0}}" class="trend-grid">
          <view wx:for="{{trendList}}" wx:key="key" class="trend-card">
            <text class="trend-label">{{item.label}}</text>
            <view class="trend-val-row">
              <text class="trend-val" style="color: {{item.color}}">{{item.lastVal !== null ? item.lastVal : '—'}}</text>
              <text class="trend-unit">{{item.unit}}</text>
            </view>
            <view wx:if="{{item.sparkBars.length > 1}}" class="spark-row">
              <view
                wx:for="{{item.sparkBars}}"
                wx:for-item="bar"
                wx:key="index"
                class="spark-bar {{bar.empty ? 'spark-bar-empty' : ''}}"
                style="height: {{bar.h}}rpx; background: {{bar.color}};"
              ></view>
            </view>
          </view>
        </view>
        <text wx:else class="health-empty">{{t.noHistory}}</text>
      </view>

      <!-- Lab (snapshot + reports combined) -->
      <view class="health-section">
        <view class="section-title-row">
          <text class="section-title">{{t.healthReports}}</text>
          <view wx:if="{{labPanelAbnormal > 0}}" class="ht-lab-alert">
            <text class="ht-lab-alert-text">{{labPanelAbnormal}} {{t.dtLabAbnormal}}</text>
          </view>
          <view wx:elif="{{labPanelAbnormal === 0 && labPanel.length > 0}}" class="ht-lab-ok">
            <text class="ht-lab-ok-text">{{t.dtLabAllNormal}}</text>
          </view>
        </view>
        <view wx:if="{{labPanel.length > 0}}" class="ht-lab-snapshot-wrap">
          <view class="ht-lab-snapshot-header">
            <text class="ht-lab-snapshot-title">{{t.dtLabPanel}}</text>
            <text class="ht-lab-date">{{labPanelDate}}</text>
          </view>
          <view class="ht-lab-grid">
            <view wx:for="{{labPanel}}" wx:key="key" class="ht-lab-item {{item.status !== 'normal' ? 'ht-lab-item-abn' : ''}}" style="border-color: {{item.statusColor}}22;">
              <text class="ht-lab-name" style="color: {{item.status !== 'normal' ? item.statusColor : 'rgba(166,196,229,0.55)'}}">{{item.displayName}}</text>
              <text class="ht-lab-val" style="color: {{item.statusColor}};">{{item.value}}</text>
              <text class="ht-lab-unit">{{item.unit}}</text>
            </view>
          </view>
        </view>
        <view wx:if="{{reportsLoading}}" class="center-wrap" style="padding:32rpx 0;">
          <view class="pulse-dot"></view>
          <view class="pulse-dot"></view>
          <view class="pulse-dot"></view>
        </view>
        <view wx:elif="{{healthReports.length > 0}}" class="rpt-list">
          <view wx:for="{{healthReports}}" wx:key="id"
                class="rpt-card"
                bindtap="onReportTap"
                data-id="{{item.id}}">
            <image wx:if="{{item.image_url}}"
                   class="rpt-thumb"
                   src="{{item.image_url}}"
                   mode="aspectFill"
                   catchtap="previewReportImage"
                   data-url="{{item.image_url}}" />
            <view class="rpt-card-left" style="border-left-color: {{item.type_color}};">
              <text class="rpt-institution">{{item.institution}}</text>
              <text class="rpt-date">{{item.report_date}}</text>
            </view>
            <view class="rpt-type-badge" style="background: {{item.type_color}}18; border-color: {{item.type_color}}44;">
              <text class="rpt-type-text" style="color: {{item.type_color}};">{{item.report_type}}</text>
            </view>
            <text class="rpt-arrow">›</text>
          </view>
        </view>
        <text wx:elif="{{!reportsLoading && labPanel.length === 0}}" class="health-empty">{{t.noReports}}</text>
      </view>

      <view style="height: 32px;"></view>
    </block>

  </scroll-view>

  <!-- Health Report Detail Sheet -->
  <view wx:if="{{activeReport}}" class="rpt-overlay" bindtap="onCloseReport">
    <view class="rpt-sheet" catchtap="noop">
      <view class="rpt-sheet-handle"></view>
      <view class="rpt-sheet-header">
        <view class="rpt-sheet-title-group">
          <text class="rpt-sheet-institution">{{activeReport.institution}}</text>
          <text class="rpt-sheet-date">{{activeReport.report_date}}</text>
        </view>
        <view class="rpt-sheet-type-badge" style="background: {{activeReport.type_color}}18; border-color: {{activeReport.type_color}}44;">
          <text style="color: {{activeReport.type_color}}; font-size: 20rpx; font-weight: 700;">{{activeReport.report_type}}</text>
        </view>
        <view class="rpt-close-btn" bindtap="onCloseReport"><text class="rpt-close-x">✕</text></view>
      </view>

      <scroll-view class="rpt-events-scroll" scroll-y="true">
        <view wx:if="{{reportDetailLoading}}" class="center-wrap" style="padding:60rpx 0;">
          <view class="pulse-dot"></view>
          <view class="pulse-dot"></view>
          <view class="pulse-dot"></view>
        </view>
        <block wx:else>

          <!-- Uploaded report photo -->
          <view wx:if="{{activeReport.image_url}}" class="rpt-section">
            <image class="rpt-photo"
                   src="{{activeReport.image_url}}"
                   mode="widthFix"
                   bindtap="previewReportImage"
                   data-url="{{activeReport.image_url}}" />
          </view>

          <!-- Doctor Notes (admin panel / liangkang format) -->
          <view wx:if="{{activeReport.hasDoctorNotes}}" class="rpt-section">
            <view class="rpt-section-header">
              <text class="rpt-section-icon">🩺</text>
              <text class="rpt-section-title">{{t.rptDoctorTitle}}</text>
            </view>
            <view wx:if="{{activeReportDoctorNotes.physician}}" class="rpt-dn-meta">
              <text class="rpt-dn-key">{{t.rptPhysician}}</text>
              <text class="rpt-dn-val">{{activeReportDoctorNotes.physician}}{{activeReportDoctorNotes.department ? ' · ' + activeReportDoctorNotes.department : ''}}</text>
            </view>
            <view wx:if="{{activeReportDoctorNotes.vitals.length > 0}}" class="rpt-vitals-grid">
              <view wx:for="{{activeReportDoctorNotes.vitals}}" wx:key="key" class="rpt-vital-item">
                <text class="rpt-vital-key">{{item.key}}</text>
                <text class="rpt-vital-val">{{item.value}}</text>
              </view>
            </view>
            <view wx:if="{{activeReportDoctorNotes.clinical_summary}}" class="rpt-clinical">
              <text class="rpt-clinical-label">{{t.rptClinicalSummary}}</text>
              <text class="rpt-clinical-text">{{activeReportDoctorNotes.clinical_summary}}</text>
            </view>
            <view wx:if="{{activeReportDoctorNotes.recommendations.length > 0}}" class="rpt-dn-subsection">
              <view class="rpt-section-header rpt-advice-header" style="padding-left:0;">
                <text class="rpt-section-icon">💊</text>
                <text class="rpt-section-title">{{t.rptRecommendations}}</text>
              </view>
              <view class="rpt-advice-list">
                <view wx:for="{{activeReportDoctorNotes.recommendations}}" wx:key="index" class="rpt-advice-item">
                  <text class="rpt-advice-num">{{index + 1}}</text>
                  <text class="rpt-advice-text">{{item}}</text>
                </view>
              </view>
            </view>
            <view wx:if="{{activeReportDoctorNotes.follow_up}}" class="rpt-followup">
              <text class="rpt-followup-label">{{t.rptFollowUp}}</text>
              <text class="rpt-followup-text">{{activeReportDoctorNotes.follow_up}}</text>
            </view>
          </view>

          <!-- Diagnostics -->
          <view wx:if="{{activeReport.hasDiag}}" class="rpt-section">
            <view class="rpt-section-header rpt-diag-header">
              <text class="rpt-section-icon">🔬</text>
              <text class="rpt-section-title">{{t.rptDiagTitle}}</text>
            </view>
            <view class="rpt-diag-list">
              <view wx:for="{{activeReportDiag}}" wx:key="index" class="rpt-diag-item">
                <view class="rpt-diag-bullet"></view>
                <text class="rpt-diag-text">{{item}}</text>
              </view>
            </view>
          </view>

          <!-- Doctor's Advice -->
          <view wx:if="{{activeReport.hasAdvice}}" class="rpt-section">
            <view class="rpt-section-header rpt-advice-header">
              <text class="rpt-section-icon">💊</text>
              <text class="rpt-section-title">{{t.rptAdviceTitle}}</text>
            </view>
            <view class="rpt-advice-list">
              <view wx:for="{{activeReportAdvice}}" wx:key="index" class="rpt-advice-item">
                <text class="rpt-advice-num">{{index + 1}}</text>
                <text class="rpt-advice-text">{{item}}</text>
              </view>
            </view>
          </view>

          <!-- Lab Markers -->
          <view wx:if="{{activeReportEvents.length > 0}}" class="rpt-section">
            <view wx:if="{{activeReport.hasDiag || activeReport.hasAdvice}}" class="rpt-section-header">
              <text class="rpt-section-icon">📊</text>
              <text class="rpt-section-title">{{t.rptMarkersTitle}}</text>
            </view>
            <view class="rpt-events-list">
              <view wx:for="{{activeReportEvents}}" wx:key="index" class="rpt-ev-row">
                <view class="rpt-ev-left">
                  <view class="rpt-ev-dot" style="background: {{item.statusColor}};"></view>
                  <view class="rpt-ev-info">
                    <text class="rpt-ev-name">{{item.key_name}}</text>
                    <text wx:if="{{item.refText}}" class="rpt-ev-ref">{{t.rptRefRange}}  {{item.refText}}</text>
                  </view>
                </view>
                <view class="rpt-ev-right">
                  <text class="rpt-ev-val">{{item.value}}</text>
                  <text class="rpt-ev-unit"> {{item.unit}}</text>
                  <view class="rpt-ev-status" style="background: {{item.statusColor}}18; border-color: {{item.statusColor}}44;">
                    <text style="color: {{item.statusColor}}; font-size: 18rpx; font-weight: 700;">{{item.statusLabel}}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>

        </block>
      </scroll-view>
    </view>
  </view>

  <!-- Weight Chart Modal (self mode only) -->
  <view wx:if="{{weightChartOpen && mode === 'self'}}" class="wchart-overlay" bindtap="closeWeightChart">
    <view class="wchart-sheet" catchtap="noop">
      <view class="wchart-handle"></view>
      <view class="wchart-header">
        <text class="wchart-title">{{t.weightTrend}}</text>
        <view class="wchart-close" bindtap="closeWeightChart"><text>✕</text></view>
      </view>
      <canvas canvas-id="uh-weight-chart-full" class="weight-chart-full" style="width:{{weightChartW}}px;height:200px;"></canvas>
    </view>
  </view>

  <!-- BMI Chart Modal -->
  <view wx:if="{{bmiChartOpen}}" class="wchart-overlay" bindtap="closeBmiChart">
    <view class="wchart-sheet" catchtap="noop">
      <view class="wchart-handle"></view>
      <view class="wchart-header">
        <text class="wchart-title">BMI</text>
        <view class="wchart-close" bindtap="closeBmiChart"><text>✕</text></view>
      </view>
      <canvas canvas-id="uh-bmi-chart" class="weight-chart-full" style="width:{{bmiChartW}}px;height:200px;"></canvas>
    </view>
  </view>

  <!-- Steps Chart Modal -->
  <view wx:if="{{stepsChartOpen}}" class="wchart-overlay" bindtap="closeStepsChart">
    <view class="wchart-sheet" catchtap="noop">
      <view class="wchart-handle"></view>
      <view class="wchart-header">
        <text class="wchart-title">{{t.ringSteps}}</text>
        <view class="wchart-close" bindtap="closeStepsChart"><text>✕</text></view>
      </view>
      <canvas canvas-id="uh-steps-chart" class="weight-chart-full" style="width:{{stepsChartW}}px;height:200px;"></canvas>
    </view>
  </view>

  <!-- HRV Chart Modal -->
  <view wx:if="{{hrvChartOpen}}" class="wchart-overlay" bindtap="closeHrvChart">
    <view class="wchart-sheet" catchtap="noop">
      <view class="wchart-handle"></view>
      <view class="wchart-header">
        <text class="wchart-title">HRV</text>
        <view class="wchart-close" bindtap="closeHrvChart"><text>✕</text></view>
      </view>
      <canvas canvas-id="uh-hrv-chart" class="weight-chart-full" style="width:{{hrvChartW}}px;height:200px;"></canvas>
    </view>
  </view>

  <!-- Stress Chart Modal -->
  <view wx:if="{{stressChartOpen}}" class="wchart-overlay" bindtap="closeStressChart">
    <view class="wchart-sheet" catchtap="noop">
      <view class="wchart-handle"></view>
      <view class="wchart-header">
        <text class="wchart-title">{{t.ringStress}}</text>
        <view class="wchart-close" bindtap="closeStressChart"><text>✕</text></view>
      </view>
      <canvas canvas-id="uh-stress-chart" class="weight-chart-full" style="width:{{stressChartW}}px;height:200px;"></canvas>
    </view>
  </view>

  <!-- Blood Pressure Chart Modal -->
  <view wx:if="{{bpChartOpen}}" class="wchart-overlay" bindtap="closeBpChart">
    <view class="wchart-sheet" catchtap="noop">
      <view class="wchart-handle"></view>
      <view class="wchart-header">
        <text class="wchart-title">{{t.metricBp}}</text>
        <view class="wchart-close" bindtap="closeBpChart"><text>✕</text></view>
      </view>
      <view class="bp-chart-legend">
        <view class="bp-legend-item"><view class="bp-legend-dot bp-legend-sys"></view><text class="bp-legend-label">SYS</text></view>
        <view class="bp-legend-item"><view class="bp-legend-dot bp-legend-dia"></view><text class="bp-legend-label">DIA</text></view>
      </view>
      <canvas canvas-id="uh-bp-chart" class="weight-chart-full" style="width:{{bpChartW}}px;height:200px;"></canvas>
    </view>
  </view>

  <!-- Blood Glucose Chart Modal -->
  <view wx:if="{{glucoseChartOpen}}" class="wchart-overlay" bindtap="closeGlucoseChart">
    <view class="wchart-sheet" catchtap="noop">
      <view class="wchart-handle"></view>
      <view class="wchart-header">
        <text class="wchart-title">{{t.metricGlucose}}</text>
        <view class="wchart-close" bindtap="closeGlucoseChart"><text>✕</text></view>
      </view>
      <canvas canvas-id="uh-glucose-chart" class="weight-chart-full" style="width:{{glucoseChartW}}px;height:200px;"></canvas>
    </view>
  </view>

  <!-- Privacy consent popup — shown when WeChat triggers onNeedPrivacyAuthorization -->
  <view wx:if="{{showPrivacyPopup}}" class="privacy-mask" catchtap="noop">
    <view class="privacy-box">
      <text class="privacy-title">{{isZh ? '隐私保护提示' : 'Privacy Notice'}}</text>
      <text class="privacy-body">{{isZh ? '为连接您的健康戒指并读取健康数据，需要使用蓝牙权限。请阅读并同意我们的隐私保护指引后继续。' : 'To connect your smart ring and read health data, we need Bluetooth access. Please agree to our privacy policy to continue.'}}</text>
      <button class="privacy-agree-btn"
              id="privacy-agree-btn"
              open-type="agreePrivacyAuthorization"
              bindagreeprivacyauthorization="onPrivacyAgree">
        {{isZh ? '同意并继续' : 'Agree & Continue'}}
      </button>
      <view class="privacy-cancel-btn" bindtap="onPrivacyCancel">
        <text>{{isZh ? '拒绝' : 'Decline'}}</text>
      </view>
    </view>
  </view>

</view>
