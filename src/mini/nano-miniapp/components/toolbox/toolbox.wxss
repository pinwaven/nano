.toolbox-panel {
  background: var(--bg-input);
  border-top: 1rpx solid var(--navy-border);
  padding: 20rpx 24rpx 16rpx;
}

.toolbox-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  background: var(--blue-dim);
  border: 1rpx solid var(--navy-border);
  border-radius: 20rpx;
  padding: 18rpx 28rpx;
  min-width: 148rpx;
}

.tool-item-icon {
  font-size: 30rpx;
  color: var(--blue);
  line-height: 1;
}

.tool-item-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text);
  text-align: center;
}

.tool-item-disabled {
  opacity: 0.35;
}
