/* 心电节律记录 overlay — dark by default like the health tab; .theme-light is applied on the
   component's own root because the host page's theme class does not cross the boundary. */
.strip-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 900; background: rgba(4, 12, 24, 0.82); display: flex; align-items: flex-end; justify-content: center; }
.strip-sheet { width: 100%; max-height: 92vh; overflow-y: auto; background: #0f2540; border-radius: 32rpx 32rpx 0 0; padding: 28rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); box-sizing: border-box; color: #eaf2ff; }
.theme-light .strip-sheet { background: #ffffff; color: #12233a; }
.strip-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.strip-title { font-size: 32rpx; font-weight: 700; }
.strip-close { width: 56rpx; height: 56rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.08); font-size: 26rpx; }
.theme-light .strip-close { background: rgba(18,35,58,0.06); }
.strip-guide { display: flex; flex-direction: column; align-items: center; gap: 12rpx; padding: 24rpx 12rpx 32rpx; text-align: center; }
.strip-guide-glyph { font-size: 72rpx; line-height: 1; margin-bottom: 8rpx; }
.strip-guide-line { font-size: 28rpx; line-height: 1.5; }
.strip-guide-muted { font-size: 24rpx; opacity: 0.6; }
.strip-btn { margin-top: 16rpx; padding: 22rpx; border-radius: 48rpx; text-align: center; font-size: 28rpx; font-weight: 600; }
.strip-btn-primary { background: #1fb7a6; color: #04141a; }
.strip-btn-ghost { background: transparent; border: 1rpx solid rgba(255,255,255,0.22); color: inherit; font-weight: 500; }
.theme-light .strip-btn-ghost { border-color: rgba(18,35,58,0.2); }
.strip-footnote { display: block; margin-top: 18rpx; font-size: 22rpx; line-height: 1.5; opacity: 0.55; text-align: center; }
.strip-status-row { display: flex; align-items: baseline; justify-content: space-between; margin: 8rpx 0 16rpx; }
.strip-status { font-size: 28rpx; font-weight: 600; }
.strip-countdown { font-size: 36rpx; font-weight: 700; font-variant-numeric: tabular-nums; color: #1fb7a6; }
.strip-canvas-wrap { width: 100%; height: 320rpx; border-radius: 16rpx; overflow: hidden; background: #fbf5f4; }
.strip-canvas { width: 100%; height: 320rpx; }
.strip-meta-row { display: flex; gap: 32rpx; margin-top: 12rpx; }
.strip-meta { font-size: 22rpx; opacity: 0.65; font-variant-numeric: tabular-nums; }
.strip-result-hero { display: flex; align-items: baseline; justify-content: center; gap: 10rpx; margin: 8rpx 0 20rpx; }
.strip-bpm { font-size: 96rpx; font-weight: 700; line-height: 1; color: #1fb7a6; font-variant-numeric: tabular-nums; }
.strip-bpm-unit { font-size: 26rpx; opacity: 0.7; }
.strip-result-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx; margin-bottom: 20rpx; }
.strip-cell { display: flex; flex-direction: column; align-items: center; gap: 4rpx; padding: 14rpx 6rpx; border-radius: 14rpx; background: rgba(255,255,255,0.06); }
.theme-light .strip-cell { background: rgba(18,35,58,0.05); }
.strip-cell-v { font-size: 30rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.strip-cell-k { font-size: 20rpx; opacity: 0.6; }

.strip-when { display: block; font-size: 24rpx; opacity: 0.6; text-align: center; font-variant-numeric: tabular-nums; }
.strip-btn-danger { color: #e0565b; border-color: rgba(224,86,91,0.45); }
.theme-light .strip-btn-danger { border-color: rgba(224,86,91,0.45); }
